/* zepos-menu - das Auswahlfenster
 * Generated by ZepOS - DO NOT EDIT DIRECTLY!
 * To customise: copy the template to $XDG_CONFIG_HOME/zepos/styles/zepos-menu-style.template
 *
 * DAS IST DAS ERSTE AUSSEHEN DIESES FENSTERS, NICHT DAS ZWEITE
 *     Der Vorgaenger wofi-style.template hatte hier gestanden, und was
 *     davon je auf einem Bildschirm ankam, war nichts: die Datei setzte
 *     ihre Farben ueber CSS-Variablen, die GTK3 nicht kennt - 39
 *     Parserfehler, jede betroffene Regel verworfen, der Starter seit
 *     jeher in GTKs Standardgrau. Gemessen am 11.08.2026.
 *
 *     Es gibt hier also nichts nachzubauen. tests/menu/
 *     test_menu_headless.py laedt DIESE Datei in ein echtes GTK4 und
 *     faellt bei einem einzigen Parserfehler.
 *
 * WARUM TROTZDEM KEINE CSS-VARIABLEN, OBWOHL GTK4 SIE KANN
 *     Gemessen am 11.08.2026 gegen die ausgelieferte Fassung, GTK
 *     4.22.4 - dieselbe, die im angehefteten Schnappschuss 2026/08/04
 *     steht:
 *
 *         Gtk.CssProvider().load_from_data(
 *             b':root { --zep-bg: #08262c; } window { background-color: var(--zep-bg); }')
 *         -> 0 Parserfehler
 *
 *     Der Grund gegen sie ist also nicht mehr, dass GTK sie nicht
 *     versteht, sondern dass sie hier nichts einbringen: die Werte
 *     kommen aus src/brand.py und werden beim Erzeugen eingesetzt, also
 *     waere eine Variable eine zweite Indirektion vor derselben Zahl.
 *     tests/src/test_brand.py verbietet die Schreibweise fuer alle
 *     Stylesheets dieses Projekts, weil die anderen neunzehn GTK3 sind.
 *
 * DIE KNOTENNAMEN SIND NICHT WOFIS
 *     wofi hiess seine Knoten #input, #inner-box, #outer-box. Das Fenster
 *     hier ist ein anderes Programm mit einem anderen Widgetbaum, und
 *     die Namen sind die, die menu/zepos_menu/window.py setzt. Eine
 *     Regel fuer einen Knoten, den es nicht gibt, ist kein Fehler, den
 *     GTK meldet - sie tut einfach nichts.
 */

/* Das ganze Fenster. Kein Rahmen ums Fenster selbst, sondern um den
 * Kasten darin: eine Layer-Shell-Flaeche hat keine Ecken, die der
 * Compositor rundet, und ein border-radius auf `window` schneidet in
 * GTK4 nur den Hintergrund an, nicht den Rahmen. */
window {
    background-color: transparent;
    font-family: {{STYLE_FONT_FAMILY_TEXT}};
    font-size: {{STYLE_FONT_BODY}};
}

/* Der Kasten, der die Flaeche traegt.
 *
 * DAS GLAS, SEIT DEM 12.08.2026
 *     window.py meldet dieses Fenster unter "zepos-menu" an
 *     (LayerShell.set_namespace), und es stand trotzdem nicht in
 *     GLASS_LAYERS - dieselbe Luecke wie beim Starter und beim
 *     Zwischenablage-Verlauf: die Pruefung las nur die AGS-Vorlagen und
 *     war fuer Python und C++ blind.
 *
 *     Deckkraft abgeleitet, siehe src/brand.py bei glass_solo_alpha().
 *     Das Glas gehoert auf DIESEN Kasten und nicht auf `window`: eine
 *     Layer-Shell-Flaeche hat keine Ecken, die der Compositor rundet,
 *     also traegt der Kasten Rahmen, Rundung und Grund gemeinsam - und
 *     die layerrule ignore_alpha schneidet die Unschaerfe genau an
 *     seiner Kante ab. */
#outer-box {
    margin: 0px;
    padding: {{STYLE_MODULE_SPACING}};
    border: 2px solid {{STYLE_COLOR_LAUNCHER_ACCENT}};
    border-radius: {{STYLE_RADIUS_PANEL}};
    background-color: {{STYLE_GLASS_SOLO}};
}

/* Die Eingabezeile. Sie ist das einzige Bedienelement, das immer da ist,
 * also traegt sie die Aufmerksamkeit: groesser gesetzt als die Liste und
 * mit dem Akzent umrandet, sobald sie den Fokus hat - was sie beim
 * Oeffnen sofort tut. */
#search {
    margin-bottom: {{STYLE_MODULE_SPACING}};
    padding: {{STYLE_SPACE_8}} {{STYLE_SPACE_20}};
    border: 1px solid {{STYLE_OVERLAY_BORDER_COLOR}};
    border-radius: {{STYLE_RADIUS_CARD}};
    background-color: {{STYLE_COLOR_OVERLAY_SURFACE}};
    background-image: none;
    box-shadow: none;
    color: {{STYLE_COLOR_OVERLAY_TEXT}};
    caret-color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
    font-size: {{STYLE_FONT_LEAD}};
    font-weight: bold;
    transition: border-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};
}

#search:focus, #search:focus-within {
    border-color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
    outline: none;
}

/* Der Platzhaltertext im leeren Feld - in GTK4 ein eigener Knoten
 * `text > placeholder`, kein Pseudoelement. Gedaempft, weil er eine
 * Aufforderung ist und keine Eingabe. */
#search > text > placeholder {
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
    font-weight: normal;
}

/* "Keine Treffer". Nur sichtbar, wenn es etwas zu finden GAB - siehe
 * MenuWindow._update_message(). */
#message {
    padding: {{STYLE_SPACE_20}};
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
    font-style: italic;
}

#scroll {
    border: 1px solid {{STYLE_OVERLAY_BORDER_COLOR}};
    border-radius: {{STYLE_RADIUS_CARD}};
    background-color: {{STYLE_COLOR_OVERLAY_SURFACE}};
}

#list {
    background-color: transparent;
    padding: {{STYLE_SPACE_4}};
}

/* Eine Zeile. `row` ist GTK4s eigener Knotenname fuer das, was die
 * Fabrik in die Liste haengt - der Kasten mit dem Namen #entry sitzt
 * DARIN, und ein Hintergrund auf ihm liesse den Rand der Auswahl
 * daneben stehen. */
#list > row {
    margin: {{STYLE_SPACE_2}};
    padding: {{STYLE_SPACE_8}};
    border-radius: {{STYLE_RADIUS_CARD}};
    background-color: transparent;
    transition: background-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};
}

#list > row:hover {
    background-color: {{STYLE_COLOR_OVERLAY_ITEM_HOVER}};
}

/* Die gewaehlte Zeile ist der Akzent in voller Staerke - also ist die
 * Schrift darauf der dunkle Grund und nicht die Textfarbe. */
#list > row:selected {
    background-image: linear-gradient(90deg,
        {{STYLE_COLOR_OVERLAY_ACCENT_DIM}} 0%,
        {{STYLE_COLOR_LAUNCHER_ACCENT}} 100%);
    box-shadow: 0 0 10px rgba({{STYLE_COLOR_LAUNCHER_ACCENT_RGB}}, 0.5);
}

#list > row:selected #text {
    color: {{STYLE_COLOR_OVERLAY_BG}};
    font-weight: bold;
}

#text {
    padding: {{STYLE_PADDING_BUTTON}};
    color: {{STYLE_COLOR_OVERLAY_TEXT}};
    font-size: {{STYLE_FONT_BODY}};
}

/* Die Taste rechts in der Zeile - `--show all` setzt sie, sonst ist das
 * Widget unsichtbar.
 *
 * Gedaempft und in der Schreibschrift des Terminals: sie ist keine
 * Beschriftung, sondern eine Angabe, die man abschreibt, und eine
 * Festbreitenschrift ist das, worin "SUPER + SHIFT + H" untereinander
 * ausgerichtet steht. Ihre Farbe ist die der Nebentexte dieses Fensters,
 * damit sie den Namen daneben nicht ueberstimmt. */
#hint {
    margin-left: {{STYLE_MODULE_SPACING}};
    padding: {{STYLE_PADDING_BUTTON}};
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
    font-family: {{STYLE_FONT_FAMILY}};
    font-size: {{STYLE_FONT_CAPTION}};
}

/* Auf der gewaehlten Zeile ist der Grund der Akzent in voller Staerke -
 * die gedaempfte Farbe von oben waere darauf nicht mehr zu lesen. */
#list > row:selected #hint {
    color: {{STYLE_COLOR_OVERLAY_BG}};
}

/* Das Anwendungssymbol im Starter. Bei --dmenu gibt es keins und das
 * Widget ist unsichtbar, also kostet der Abstand dort nichts. */
#img {
    margin-right: {{STYLE_MODULE_SPACING}};
}

/* Ein schmaler Balken statt GTK4s Ueberlagerungsleiste: die
 * Ueberlagerung blendet sich nach kurzer Zeit aus, und in einer Liste,
 * durch die man mit den Pfeilen geht, ist genau dann keine Maus
 * unterwegs, die sie wieder hervorholt. */
scrollbar {
    background-color: transparent;
    border: none;
}

scrollbar slider {
    min-width: 5px;
    border-radius: {{STYLE_RADIUS_CONTROL}};
    background-color: {{STYLE_COLOR_OVERLAY_ACCENT_DIM}};
}

scrollbar slider:hover {
    background-color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
}
