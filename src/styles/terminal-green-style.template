{
    // Generated by ZepOS - DO NOT EDIT DIRECTLY!
    // To customise: copy the template to
    // $XDG_CONFIG_HOME/zepos/styles/terminal-green-style.template
    //
    // The one thing ZepOS ships that is deliberately NOT on the brand.
    // It dresses a DOCUMENT rather than the desktop, it is a theme a
    // person chooses by name out of the editor's own preferences, and a
    // theme called Terminal Green has to be green. The eleven values it
    // used to carry as literals are in src/brand.py under THE CODE
    // PALETTE now, with the contrast of each one measured - including
    // the two that were under WCAG AA in roles that are text.
    "name": "Terminal Green",
    "author": "ZepOS",
    "variables": {
        "black": "{{STYLE_CODE_BG}}",
        "black2": "{{STYLE_CODE_BG_RAISED}}",
        "green": "{{STYLE_CODE_GREEN}}",
        "green_dark": "{{STYLE_CODE_GREEN_DIM}}",
        "green_light": "{{STYLE_CODE_GREEN_BRIGHT}}",
        "white": "{{STYLE_CODE_TEXT}}",
        "gray": "{{STYLE_CODE_COMMENT}}",
        "gray_dark": "{{STYLE_CODE_GUIDE}}",
        "red": "{{STYLE_CODE_RED}}",
        "yellow": "{{STYLE_CODE_YELLOW}}",
        "blue": "{{STYLE_CODE_BLUE}}"
    },
    "globals": {
        "foreground": "var(green)",
        "background": "var(black)",
        "caret": "var(green_light)",
        "line_highlight": "var(black2)",
        "selection": "var(gray_dark)",
        "selection_border": "var(green_dark)",
        "inactive_selection": "{{STYLE_CODE_SELECTION_DIM}}",
        "find_highlight": "var(green_light)",
        "find_highlight_foreground": "var(black)",
        "brackets_options": "bold",
        "brackets_foreground": "var(green_light)",
        "bracket_contents_options": "underline",
        "bracket_contents_foreground": "var(green_light)",
        "guide": "var(gray_dark)",
        "active_guide": "var(green_dark)",
        "stack_guide": "var(gray_dark)"
    },
    "rules": [
        {
            "scope": "comment",
            "foreground": "var(gray)",
            "font_style": "italic"
        },
        {
            "scope": "string",
            "foreground": "var(green_light)"
        },
        {
            "scope": "constant.numeric",
            "foreground": "var(green_light)"
        },
        {
            "scope": "constant.language",
            "foreground": "var(green)",
            "font_style": "bold"
        },
        {
            "scope": "keyword",
            "foreground": "var(green)",
            "font_style": "bold"
        },
        {
            "scope": "storage",
            "foreground": "var(green)",
            "font_style": "bold"
        },
        {
            "scope": "storage.type",
            "foreground": "var(green_dark)"
        },
        {
            "scope": "entity.name.function",
            "foreground": "var(green_light)"
        },
        {
            "scope": "entity.name.class, entity.name.type",
            "foreground": "var(green)",
            "font_style": "bold"
        },
        {
            "scope": "variable",
            "foreground": "var(white)"
        },
        {
            "scope": "variable.parameter",
            "foreground": "var(green_light)"
        },
        {
            "scope": "support.function",
            "foreground": "var(green_dark)"
        },
        {
            "scope": "support.class, support.type",
            "foreground": "var(green)"
        },
        {
            "scope": "invalid",
            "foreground": "var(white)",
            "background": "var(red)"
        },
        {
            "scope": "invalid.deprecated",
            "foreground": "var(white)",
            "background": "var(yellow)"
        },
        {
            "scope": "markup.heading",
            "foreground": "var(green)",
            "font_style": "bold"
        },
        {
            "scope": "markup.bold",
            "font_style": "bold"
        },
        {
            "scope": "markup.italic",
            "font_style": "italic"
        },
        {
            "scope": "markup.underline",
            "font_style": "underline"
        },
        {
            "scope": "markup.quote",
            "foreground": "var(gray)",
            "font_style": "italic"
        },
        {
            "scope": "markup.raw",
            "foreground": "var(green_light)"
        },
        {
            "scope": "markup.link",
            "foreground": "var(blue)"
        },
        {
            "scope": "diff.inserted",
            "foreground": "var(green_light)"
        },
        {
            "scope": "diff.deleted",
            "foreground": "var(red)"
        }
    ]
}
