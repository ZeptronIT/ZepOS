/* hyprclipx - der Zwischenablage-Verlauf auf SUPER+SHIFT+V
 * Generated by ZepOS - DO NOT EDIT DIRECTLY!
 * To customise: copy the template to $XDG_CONFIG_HOME/zepos/styles/hyprclipx-style.template
 *
 * WOHER DIESE DATEI KOMMT
 *     Aus plugins/hyprclipx/src/ClipboardRenderer.cpp, wo sie bis zum
 *     11.08.2026 als `static const char* CLIPBOARD_CSS` im
 *     uebersetzten Objekt stand: 168 Zeilen und 37 Farbliterale in
 *     EINUNDZWANZIG Toenen. Einundzwanzig sind mehr Toene, als
 *     src/brand.py fuer den ganzen Schreibtisch fuehrt - dieses eine
 *     Fenster hatte also seine eigene, groessere Palette.
 *
 *     Hier sind es die Toene der Marke, und es sind weniger: dieselben
 *     Rollen wie im Starter daneben, damit die beiden Fenster
 *     erkennbar zu einem System gehoeren.
 *
 * DIE KNOTENNAMEN SIND DIE, DIE DAS PROGRAMM SETZT
 *     gtk_widget_add_css_class(btn, "cm-item") und so fort. Eine Regel
 *     fuer eine Klasse, die es nicht gibt, meldet GTK nicht - sie tut
 *     nichts.
 *
 * WAS ABSICHTLICH EINE ZAHL BLEIBT
 *     min-width, min-height und die Rahmenstaerken; die Begruendung
 *     steht wortgleich im Kopf von hyprlaunch-style.template und
 *     stammt aus tests/src/test_spacing.py.
 *
 * DIE BEWEGUNG, SEIT DEM 12.08.2026
 *     Die Messung und die Begruendung stehen im Kopf von
 *     hyprlaunch-style.template; sie gelten hier unveraendert. Vier
 *     Regeln statt drei, weil dieses Fenster einen Zustandswechsel
 *     mehr hat als der Starter: die Reiter der Leiste links wechseln
 *     ausser Grund und Rahmen auch die SCHRIFTFARBE, wenn einer aktiv
 *     wird. Sie steht deshalb in der Liste der Eigenschaften mit
 *     drin - eine Bewegung, die zwei von drei Aenderungen mitnimmt und
 *     die dritte springen laesst, sieht kaputter aus als gar keine.
 */

.ClipboardManager {
    background: transparent;
    font-family: {{STYLE_FONT_FAMILY}};
}

/* ClipboardRenderer::buildUI(), root.
 *
 * DAS GLAS, SEIT DEM 12.08.2026, UND DER NAME, DEN MAN NICHT RATEN DARF
 *     Dieses Fenster meldet sich NICHT als "hyprclipx" an, sondern als
 *     "clipboard-manager" - ClipboardRenderer.cpp,
 *     gtk_layer_set_namespace(). Der Namensraum ist das, was Hyprlands
 *     `layerrule` anspricht; wer ihn vom Programmnamen ableitet,
 *     schreibt eine Regel, die lautlos nie greift. Er steht deshalb in
 *     GLASS_LAYERS so, wie er in der C++-Zeile steht, und
 *     tests/src/test_glass.py liest ihn seit dem 12.08.2026 aus ebender
 *     Zeile statt aus einer zweiten Liste.
 *
 *     Deckkraft abgeleitet, siehe src/brand.py bei glass_solo_alpha(). */
/* DER RADIUS HAT HIER GEFEHLT, nicht bloss an einem Kind.
 *
 * GEMELDET am 18.08.2026: "die externen plugins ... sind nicht wirklich
 * abgerundet das fenster ist nicht rund". Bei hyprlaunch war es ein
 * Kind, das ueber die Ecke malt; hier war die Wurzel selbst eckig -
 * Grund und Rahmen ja, Radius nie.
 *
 * Die vier Ecken gehoeren dabei nicht diesem Kasten, sondern seinen
 * Kindern, denn GTK4 beschneidet sie NICHT. Aus ClipboardRenderer::
 * buildUI() abgelesen, nicht geraten:
 *
 *     cm-root (senkrecht)
 *       cm-sidebar-header | cm-search    <- oben links | oben rechts
 *       cm-sidebar-body   | cm-scroll    <- Mitte, keine Ecke
 *       cm-hints                         <- volle Breite, BEIDE unten
 *
 * cm-sidebar-body steht zwischen Kopf und Hinweiszeile und beruehrt
 * deshalb keine Ecke - es bekommt bewusst keinen Radius. */
.cm-root {
    background-color: {{STYLE_GLASS_SOLO}};
    border: 2px solid {{STYLE_COLOR_LAUNCHER_ACCENT}};
    border-radius: {{STYLE_RADIUS_PANEL}};
}

/* ── Die Leiste links ────────────────────────────────────────────── */

.cm-sidebar-header {
    background-color: {{STYLE_COLOR_OVERLAY_SURFACE}};
    border-radius: {{STYLE_RADIUS_PANEL}} 0 0 0;
    border-right: 1px solid {{STYLE_OVERLAY_BORDER_COLOR}};
    border-bottom: 1px solid {{STYLE_OVERLAY_BORDER_COLOR}};
    padding: {{STYLE_SPACE_2}};
    min-width: 36px;
}

.cm-sidebar-body {
    background-color: {{STYLE_COLOR_OVERLAY_SURFACE}};
    border-right: 1px solid {{STYLE_OVERLAY_BORDER_COLOR}};
    padding: {{STYLE_SPACE_2}};
    min-width: 36px;
}

/* Die vier Filterschaltflaechen und der Papierkorb. Sie tragen ein
 * Zeichen und keinen Text, sind also so breit wie hoch - deshalb
 * Pixel und keine Sprosse. */
.cm-sidebar-icon {
    min-width: 32px;
    min-height: 28px;
    padding: {{STYLE_SPACE_2}};
    border-radius: {{STYLE_RADIUS_PANEL}};
    border: 1px solid transparent;
    background: transparent;
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
    font-size: {{STYLE_FONT_BODY}};
    transition: background-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}},
                border-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}},
                color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};
}

.cm-sidebar-icon:hover {
    background-color: {{STYLE_COLOR_OVERLAY_ITEM_HOVER}};
    border-color: {{STYLE_COLOR_OVERLAY_ACCENT_DIM}};
    color: {{STYLE_COLOR_OVERLAY_TEXT}};
}

.cm-sidebar-icon.active {
    background-color: rgba({{STYLE_COLOR_LAUNCHER_ACCENT_RGB}}, 0.20);
    border-color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
    color: {{STYLE_COLOR_OVERLAY_ACCENT_HOVER}};
}

/* Der Trennstrich. Ein Haar hoch, also eine Zahl; der Abstand darum
 * herum steht auf der Leiter. */
.cm-sidebar-sep {
    background-color: {{STYLE_OVERLAY_BORDER_COLOR}};
    min-height: 1px;
    margin: {{STYLE_SPACE_4}} {{STYLE_SPACE_4}};
}

.cm-count {
    font-size: {{STYLE_FONT_MICRO}};
    font-family: {{STYLE_FONT_FAMILY}};
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
    padding: {{STYLE_SPACE_2}};
}

/* ── Die Suchzeile ───────────────────────────────────────────────── */

.cm-search {
    background-color: {{STYLE_COLOR_OVERLAY_SURFACE}};
    border-radius: 0 {{STYLE_RADIUS_PANEL}} 0 0;
    border-bottom: 1px solid {{STYLE_OVERLAY_BORDER_COLOR}};
    padding: {{STYLE_SPACE_4}} {{STYLE_SPACE_8}};
}

.cm-search label {
    color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
    font-size: {{STYLE_FONT_CAPTION}};
}

.cm-search-input {
    background: transparent;
    border: none;
    color: {{STYLE_COLOR_OVERLAY_TEXT}};
    font-family: {{STYLE_FONT_FAMILY}};
    font-size: {{STYLE_FONT_CAPTION}};
    caret-color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
}

.cm-search-input:focus {
    outline: none;
}

/* ── Die Liste ───────────────────────────────────────────────────── */

/* Die Mindesthoehe bleibt eine Zahl und folgt dem Faktor NICHT: sie ist
 * ein Boden fuer den Fall, dass der Verlauf leer ist, und die Hoehe des
 * Fensters kommt aus window_height in ~/.config/hyprclipx/config, das
 * dem Faktor sehr wohl folgt. Bei jedem Faktor ueber 1 liegt das
 * Fenster ohnehin ueber diesem Boden. */
.cm-scroll {
    min-height: 120px;
}

.cm-list {
    padding: {{STYLE_SPACE_2}} {{STYLE_SPACE_4}};
}

.cm-item {
    padding: {{STYLE_SPACE_4}} {{STYLE_SPACE_8}};
    border-radius: {{STYLE_RADIUS_PANEL}};
    border: 1px solid transparent;
    background: transparent;
    transition: background-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}},
                border-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}},
                color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};
}

.cm-item:hover {
    background-color: {{STYLE_COLOR_OVERLAY_ITEM_HOVER}};
    border-color: {{STYLE_COLOR_OVERLAY_ACCENT_DIM}};
}

/* Dieselbe Deckkraft wie im Starter, und aus demselben Grund: die
 * Liste wird mit den Pfeiltasten durchlaufen, und ein voller Akzent
 * unter jedem Schritt flimmert. */
.cm-item.selected {
    background-color: rgba({{STYLE_COLOR_LAUNCHER_ACCENT_RGB}}, 0.30);
    border-color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
}

.cm-item.selected:hover {
    background-color: rgba({{STYLE_COLOR_LAUNCHER_ACCENT_RGB}}, 0.35);
}

/* Das Dreieck vor der gewaehlten Zeile. */
.cm-triangle {
    font-size: {{STYLE_ICON_MICRO}};
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
    min-width: 10px;
}

.cm-item.selected .cm-triangle {
    color: {{STYLE_COLOR_OVERLAY_ACCENT_HOVER}};
}

.cm-preview {
    font-family: {{STYLE_FONT_FAMILY}};
    font-size: {{STYLE_FONT_CAPTION}};
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
}

.cm-item.selected .cm-preview {
    color: {{STYLE_COLOR_OVERLAY_TEXT}};
}

/* ── Die Sternspalte rechts ──────────────────────────────────────── */

.cm-fav-column {
    border-left: 1px solid {{STYLE_OVERLAY_BORDER_COLOR}};
    min-width: 26px;
    padding: {{STYLE_SPACE_2}} 0;
}

.cm-fav-indicator {
    font-size: {{STYLE_ICON_MICRO}};
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
    min-width: 26px;
    padding: {{STYLE_SPACE_4}} 0;
    border: 1px solid transparent;
    border-radius: {{STYLE_RADIUS_PANEL}};
    background: transparent;
    transition: background-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}},
                border-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}},
                color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};
}

.cm-fav-indicator:hover {
    background: transparent;
    border-color: transparent;
}

/* Der gesetzte Stern. Die Warnfarbe der Marke, weil sie die einzige
 * ist, die neben dem Akzent noch als eigenes Signal gelesen wird -
 * der Akzent selbst ist hier schon die Auswahl. Dieselbe Wahl wie fuer
 * die Marke "zuletzt benutzt" im Starter. */
.cm-fav-indicator.starred {
    color: {{STYLE_COLOR_WARNING}};
}

.cm-img-indicator {
    font-size: {{STYLE_ICON_MICRO}};
    color: {{STYLE_COLOR_OVERLAY_ACCENT_DIM}};
    margin-right: {{STYLE_SPACE_4}};
}

/* ── Die Hinweiszeile unten ──────────────────────────────────────── */

.cm-hints {
    background-color: {{STYLE_COLOR_OVERLAY_BG}};
    border-radius: 0 0 {{STYLE_RADIUS_PANEL}} {{STYLE_RADIUS_PANEL}};
    border-top: 1px solid {{STYLE_OVERLAY_BORDER_COLOR}};
    padding: {{STYLE_SPACE_2}} {{STYLE_SPACE_8}};
}

.cm-hint {
    font-size: {{STYLE_FONT_MICRO}};
    font-family: {{STYLE_FONT_FAMILY}};
    color: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
}

/* ── Die Versatzanzeige ──────────────────────────────────────────── */
/* Sie erscheint nur, waehrend der Nutzer das Fenster gegenueber der
 * Schreibmarke verschiebt. Voller Akzent mit dunkler Schrift darauf,
 * weil sie eine Momentanzeige ist und nicht mit der Liste darunter
 * verwechselt werden darf. */
.cm-offset-overlay {
    background-color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
    color: {{STYLE_COLOR_OVERLAY_BG}};
    font-size: {{STYLE_FONT_MICRO}};
    font-family: {{STYLE_FONT_FAMILY}};
    padding: {{STYLE_SPACE_2}} {{STYLE_SPACE_8}};
    border: 1px solid {{STYLE_COLOR_OVERLAY_ACCENT_HOVER}};
    margin: {{STYLE_SPACE_4}};
}

/* Wie im Starter und in zepos-menu: ein schmaler Balken statt der
 * Ueberlagerungsleiste, die sich ausblendet. */
scrollbar {
    background: transparent;
    border: none;
}

scrollbar slider {
    min-width: 5px;
    border-radius: {{STYLE_RADIUS_CONTROL}};
    background-color: {{STYLE_COLOR_OVERLAY_ACCENT_DIM}};
    transition: background-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};
}

scrollbar slider:hover {
    background-color: {{STYLE_COLOR_LAUNCHER_ACCENT}};
}
