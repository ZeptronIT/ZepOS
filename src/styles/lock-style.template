/* zepos-lock Style - der Sperrbildschirm
 * Generated by ZepOS - DO NOT EDIT DIRECTLY!
 * To customise: copy the template to $XDG_CONFIG_HOME/zepos/styles/lock-style.template
 *
 * DIE EINZIGE ERZEUGTE DATEI, DIE DIESER BILDSCHIRM LIEST
 *   Und er sperrt auch ohne sie. Das ist keine Nachlaessigkeit, sondern
 *   die Bauart: lock/zepos-lock.c liest dieses Stylesheet VOR dem
 *   Sperren und sagt auf stderr Bescheid, wenn es fehlt. Alles, was
 *   fehlschlagen kann, muss vor dem Sperren passieren - danach gibt es
 *   keinen Weg mehr aus dem Programm heraus ausser einem Passwort, das
 *   PAM angenommen hat, und ein Programm, das mit einer Sperre in der
 *   Hand stirbt, laesst die Sitzung nach dem Protokoll GESPERRT zurueck.
 *
 * DIE FORM, UND WOHER SIE KOMMT
 *   GEMELDET am 12.08.2026: "sorge dafuer das der login auch wirklich
 *   modern aussieht vgl. apple os login ja ?".
 *
 *   Was daran die Form ausmacht, in dieser Reihenfolge:
 *
 *     WENIG      Ein Feld, ein Name, eine Uhr. Keine Beschriftungen
 *                neben den Feldern - das ist der Unterschied zwischen
 *                einem Bildschirm und einem Formular.
 *     MITTE      Alles auf einer senkrechten Achse. Die Uhr oben, weil
 *                sie dem Bildschirm gehoert; die Anmeldung in der
 *                Mitte, weil sie dem Menschen gehoert.
 *     RUND       Ein Kreis fuer das Benutzerbild, eine Pille fuer das
 *                Passwortfeld.
 *     DER GRUND  Das Bild traegt. Keine Kachel darauf.
 *
 *   Hier stand bis dahin eine Kachel aus brand.INK mit einem
 *   1px-Rand - uebernommen aus der Anmeldemaske, wo sie richtig ist,
 *   weil regreet seine Widgets in einen Rahmen setzt. Auf einem
 *   Sperrbildschirm war sie das Auffaelligste im Bild.
 *
 * WARUM HIER TROTZDEM KEIN GLAS STEHT
 *   Die Leiste hat seit dem 11.08.2026 einen Glaseffekt. Glas laesst
 *   sehen, was DAHINTER ist, und dahinter ist hier der Schreibtisch,
 *   den dieser Bildschirm verbergen soll. `layerrule` koennte diese
 *   Flaeche ohnehin nicht erreichen: eine ext_session_lock_surface_v1
 *   hat keinen Layer-Shell-Namensraum.
 *
 *   Was es stattdessen gibt, ist ein SCHLEIER - eine deckende Schicht
 *   ueber dem Bild, nicht unter dem Schreibtisch. Sie hat denselben
 *   Zweck wie die Glasalphas (Text lesbar halten) und die umgekehrte
 *   Richtung. brand.LOCK_SCRIM_ALPHA fuehrt die Messung.
 */

/* Das Bild, der Schleier darueber, die Farbe darunter.
 *
 * DREI SCHICHTEN, UND JEDE HAT EINEN GRUND
 *   background-color   bleibt stehen, wenn das Bild fehlt. Eine Sperre
 *                      ohne Tapete ist eine Sperre.
 *   url(...)           dasselbe zepos-backdrop.png, das der Assistent
 *                      und die Anmeldung zeigen. Der Weg kommt aus
 *                      {{ZEPOS_SYSTEM_ROOT}}, damit in dieser Datei kein
 *                      Systempfad steht.
 *   linear-gradient    der Schleier. Als Verlauf von derselben Farbe
 *                      nach derselben Farbe, weil GTK4-CSS keine
 *                      einfarbige Schicht ueber einem Bild kennt - eine
 *                      zweite background-color gibt es nicht.
 *
 * In GTK4 liegt die ERSTE Schicht von background-image oben. Der
 * Schleier steht deshalb vor der url().
 */
window#lock {
    background-color: {{STYLE_LOCK_BACKDROP}};
    background-image: linear-gradient({{STYLE_LOCK_SCRIM}}, {{STYLE_LOCK_SCRIM}}),
                      url("{{ZEPOS_SYSTEM_ROOT}}/branding/{{STYLE_LOCK_BACKDROP_IMAGE}}");
    background-size: cover, cover;
    background-position: center, center;
    font-family: {{STYLE_FONT_FAMILY_TEXT}};
}

/* Die Uhr, oben am Rand. Sie wird aus einigen Metern gelesen, und das
 * ist der Grund fuer die oberste Sprosse der Schriftleiter - nicht
 * Geschmack. Leicht statt fett: eine grosse Zahl in Normalstaerke ist
 * ruhig, dieselbe Zahl fett ist eine Ansage. */
label#clock {
    color: {{STYLE_LOCK_CLOCK_COLOR}};
    font-size: {{STYLE_FONT_HERO}};
    font-weight: 300;
    margin-top: {{STYLE_SPACE_24}};
}

label#date {
    color: {{STYLE_LOCK_DATE_COLOR}};
    font-size: {{STYLE_FONT_LEAD}};
}

/* Das Benutzerbild: ein Kreis mit dem ersten Buchstaben des Namens.
 *
 * 50 % und nicht die halbe Pixelgroesse, damit der Kreis ein Kreis
 * bleibt, wenn jemand STYLE_LOCK_AVATAR_SIZE aendert. min-width UND
 * min-height, weil ein Label sonst nur so breit ist wie sein Buchstabe -
 * ein "I" ergaebe eine Ellipse. */
label#avatar {
    background-color: {{STYLE_LOCK_AVATAR_BG}};
    color: {{STYLE_LOCK_AVATAR_FG}};
    min-width: {{STYLE_LOCK_AVATAR_SIZE}};
    min-height: {{STYLE_LOCK_AVATAR_SIZE}};
    border-radius: {{STYLE_RADIUS_FULL}};
    font-size: {{STYLE_FONT_DISPLAY}};
    margin-bottom: {{STYLE_SPACE_12}};
}

/* Der Name, und nichts weiter. Kein "Benutzer:" davor - das Wort weiss
 * jeder, der davorsitzt. */
label#user {
    color: {{STYLE_LOCK_USER_COLOR}};
    font-size: {{STYLE_FONT_TITLE}};
    margin-bottom: {{STYLE_SPACE_16}};
}

/* Die Pille. Der Innenabstand ist links und rechts die groesste Sprosse
 * der Leiter, damit der Text nicht in der Rundung klebt. */
entry#password {
    background-color: {{STYLE_LOCK_FIELD_BG}};
    background-image: none;
    color: {{STYLE_LOCK_FIELD_TEXT}};
    border: 1px solid {{STYLE_LOCK_FIELD_BORDER}};
    border-radius: {{STYLE_RADIUS_PILL}};
    padding: {{STYLE_SPACE_8}} {{STYLE_SPACE_24}};
    font-size: {{STYLE_FONT_LEAD}};
    transition: border-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};
}

entry#password:focus {
    border-color: {{STYLE_LOCK_FIELD_BORDER_FOCUS}};
}

/* Waehrend PAM antwortet. Das Feld ist in dieser Zeit unempfindlich -
 * ohne ein sichtbares Zeichen dafuer sieht ein Nutzer, dessen Tasten
 * nichts bewirken, eine haengende Maschine. */
entry#password.checking {
    border-color: {{STYLE_LOCK_FIELD_BORDER_BUSY}};
}

/* Und es darf dabei nicht ausgrauen. GTKs Vorgabe fuer :disabled nimmt
 * Farbe und Grund zurueck; auf einem Bildschirm, der eine Sekunde lang
 * wartet, saehe das aus wie ein Feld, das nie wieder etwas annimmt. */
entry#password:disabled {
    background-color: {{STYLE_LOCK_FIELD_BG}};
    color: {{STYLE_LOCK_FIELD_TEXT}};
}

/* Nach einer Ablehnung, bis zur naechsten Eingabe. Der Rand geht mit der
 * Meldung, damit die Antwort dort steht, wo der Blick ohnehin ist - und
 * nicht nur eine Zeile darunter. */
entry#password.failure {
    border-color: {{STYLE_LOCK_FAILURE_BORDER}};
}

label#capslock {
    color: {{STYLE_LOCK_CAPSLOCK_COLOR}};
    font-size: {{STYLE_FONT_CAPTION}};
    margin-top: {{STYLE_SPACE_8}};
}

label#message {
    color: {{STYLE_LOCK_MESSAGE_COLOR}};
    font-size: {{STYLE_FONT_BODY}};
    margin-top: {{STYLE_SPACE_8}};
}

/* Was PAM geantwortet hat, wenn es nein war. Der Text kommt aus
 * PAM_ERROR_MSG und ist deshalb NICHT immer "falsches Passwort" -
 * pam_faillock sagt hier, dass und wie lange das Konto gesperrt ist.
 * Es ist zugleich die Farbe, an der der Schleier oben haengt: auf der
 * hellsten Stelle des Bildes ist sie die einzige, die ohne ihn unter
 * 4.5:1 faellt. */
label#message.failure {
    color: {{STYLE_LOCK_FAILURE_COLOR}};
}
