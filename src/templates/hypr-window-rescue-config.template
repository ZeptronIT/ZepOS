#!/bin/bash
# =========================================
# HYPRLAND WINDOW RESCUE (one-shot helper)
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hypr-window-rescue-config.template
# =========================================
#
# Run via SUPER+SHIFT+H (Helper Scripts) after (re)connecting a monitor.
#
# Problem this solves:
#   When an external monitor is unplugged and re-plugged, Hyprland does NOT
#   restore the global position of the floating windows that lived on its
#   workspaces. They keep coordinates relative to origin 0, so on a monitor
#   that sits at a global X offset they end up completely off-screen. The
#   window still exists (the dock lists it) but is not visible.
#
# What this helper does (ONE shot, then exits):
#   Re-snaps every FLOATING window that is fully outside all monitors back
#   onto its assigned monitor, by adding that monitor's origin offset and
#   clamping into the monitor bounds. App-agnostic.
#
# Safety:
#   - Only touches windows that are fully off EVERY monitor (never moves a
#     window that is already at least partially visible)
#   - Clamps so the window always lands fully inside the monitor
#   - Touches ONLY live window positions, never any config file
# =========================================

rescued=$(python3 - <<'PYEOF'
import json, subprocess

mons    = json.loads(subprocess.check_output(['hyprctl', 'monitors', '-j']))
clients = json.loads(subprocess.check_output(['hyprctl', 'clients',  '-j']))
mon_by_id = {m['id']: m for m in mons}

def on_screen(x, y, w, h):
    cx, cy = x + w / 2, y + h / 2
    return any(m['x'] <= cx < m['x'] + m['width'] and m['y'] <= cy < m['y'] + m['height']
               for m in mons)

count = 0
for c in clients:
    if not c.get('floating') or c.get('fullscreen'):
        continue
    x, y = c['at']
    w, h = c['size']
    if w <= 0 or h <= 0:
        continue
    if on_screen(x, y, w, h):
        continue  # already (at least partially) visible — leave it alone

    m = mon_by_id.get(c.get('monitor'))
    if not m:
        continue  # unknown target monitor — do not guess

    # Shift by the monitor's origin (restores the reconnect offset), then
    # clamp so the window is guaranteed fully inside that monitor.
    nx = max(m['x'], min(x + m['x'], m['x'] + m['width']  - w))
    ny = max(m['y'], min(y + m['y'], m['y'] + m['height'] - h))

    subprocess.run(
        ['hyprctl', 'dispatch', 'movewindowpixel',
         f'exact {nx} {ny},address:{c["address"]}'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    count += 1

print(count)
PYEOF
)

if [ "${rescued:-0}" -gt 0 ] 2>/dev/null; then
    notify-send "{{ICON_MONITOR}} Window Rescue" "${rescued} Fenster zurück auf den Monitor geholt"
else
    notify-send "{{ICON_MONITOR}} Window Rescue" "Kein Fenster off-screen — nichts zu tun"
fi
