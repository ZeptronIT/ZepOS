# =========================================
# HYPRLAUNCH - Anwendungsstarter
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hyprlaunch-config.template
# =========================================
#
# Gelesen von plugins/hyprlaunch/src/ConfigParser.cpp, von BEIDEN
# Haelften: das Plugin im Compositor liest daraus seine Tastenkombination,
# das Fenster liest die Masse. Format ist Schluessel = Wert, Zeilen mit #
# und [Abschnitt] werden uebersprungen.
#
# WARUM DIESE DATEI UEBERHAUPT ERZEUGT WIRD
#     Weil ihre Zahlen sonst im uebersetzten Objekt staenden, und dort
#     kann der Regler aus src/sizes.py sie nicht erreichen. Upstream
#     hatte genau das: `static constexpr int ITEM_HEIGHT = 45;`. Eine
#     Zeilenhoehe umschliesst Text, also MUSS sie der Schrift folgen -
#     src/sizes.py schreibt die Regel fuer die Leistenhoehe schon auf
#     ("50 px trugen 13 px Text, und 24 px Text in einer 50 px hohen
#     Leiste werden oben und unten beschnitten"), und fuer eine
#     Trefferzeile gilt sie unveraendert.
#
# WARUM KEIN "px" AN DEN MASSEN, ABER EINES AN DEN SPROSSEN
#     Weil es nicht am Wert haengt, sondern am Leser. Die Masse hier
#     kommen aus Eintraegen, die src/sizes.py mit BARE fuehrt; die
#     Sprossen der Abstandsleiter kommen aus Eintraegen mit PX, weil
#     ihr Hauptleser das Stylesheet ist. Der Parser nimmt beides -
#     seine Begruendung steht bei parseInt() in ConfigParser.cpp - und
#     das ist billiger als ein zweiter Satz Platzhalter fuer dieselbe
#     Sprosse.

[window]
window_width = {{STYLE_LAUNCHER_WIDTH}}

# Die Hoehe einer Trefferzeile, und die Mindesthoehe, die das
# Stylesheet derselben Zeile gibt, muessen zusammenpassen: upstream
# rechnet 45 = 32 + 5+5 Innenabstand + 2 Rahmen + 1 Rand. Beide folgen
# demselben Faktor, also bleibt die Rechnung bei jeder Einstellung
# richtig - src/sizes.py fuehrt das bei STYLE_LAUNCHER_ROW_MIN_HEIGHT
# aus.
item_height = {{STYLE_LAUNCHER_ROW_HEIGHT}}
search_height = {{STYLE_LAUNCHER_SEARCH_HEIGHT}}

# Listenrand 4+4 plus Rahmen 1+1 minus 1. Eine Konstante der
# Fensterrechnung und keine Groesse, die jemand einstellt: sie folgt
# aus den Rahmenstaerken des Stylesheets, und die sind 1 px bei jedem
# Faktor.
chrome = 9

# Wieviele Treffer das Fenster hoechstens zeigt.
#
# EINE OBERGRENZE UND KEINE VORGABE, und das ist seit dem 11.08.2026
# noetig: mit dem ausgelieferten Faktor 1.85 ergaeben zwanzig Zeilen
# 96 + 20*83 + 9 = 1765 Pixel, also anderthalb Bildschirmhoehen auf
# einem 1080er Schirm. LauncherRenderer::fittingHeight() deckelt die
# Zeilenzahl deshalb auf das, was der hoechste angeschlossene Monitor
# hergibt. Hier steht der Wunsch, dort die Wirklichkeit.
visible_items = 20

# Das Anwendungssymbol in einer Zeile. Ein BILD, also folgt es dem
# Faktor nicht - dieselbe Grenze, die src/sizes.py zwischen den
# Dock-Symbolen und der Leistenschrift zieht.
icon_size = {{STYLE_LAUNCHER_ICON_SIZE}}

# Wie lang die Beschreibung einer Anwendung hoechstens wird, IN ZEICHEN.
# Dieselbe Grenze wie im Zwischenablage-Verlauf und in der Leiste;
# src/sizes.py nennt die Quelle. In Zeichen und nicht in Pixeln, damit
# die Spalte mit der Schrift waechst und die Zeile trotzdem 66 Zeichen
# lang bleibt.
description_chars = {{STYLE_MEASURE_PROSE}}

[general]
# Die Taste steht in src/templates/hyprland-plugins-config.template, wo
# Hyprland sie liest. Hier steht sie, weil das Fenster sie in seiner
# Hilfszeile anzeigt - ein Programm, das eine andere Taste nennt als
# die, die es oeffnet, ist schlimmer als eins, das keine nennt.
hotkey = "SUPER SPACE"

# Woher der Helfer-Modus seine Skripte liest.
#
# `hyprctl hyprlaunch:helpers` oeffnet den Starter mit einer Liste der
# eigenen Shell-Skripte statt der Anwendungen; die Leiste und das
# Kontrollzentrum bieten es an. Gelesen wird jede *.sh darin, und die
# erste sinnvolle Kommentarzeile wird ihre Beschreibung.
#
# WARUM DER PFAD UNTER ~ LIEGT UND DAS HIER RICHTIG IST
#     Es sind die eigenen Skripte des Nutzers. Der Unterschied zum
#     Schreibmarken-Helfer von hyprclipx, der bis zum 12.08.2026
#     ebenfalls unter ~ gesucht wurde: JENER musste aus einem Paket
#     kommen und konnte es dort nie. Dieser darf gar nicht aus einem
#     Paket kommen.
#
#     Was bis zum 12.08.2026 falsch war, ist nur, dass der Pfad im
#     uebersetzten Objekt stand - wer seine Skripte woanders hat,
#     konnte es dem Starter nicht sagen.
#
# Kein Platzhalter: ~/.local/bin/helpers ist keine Groesse und keine
# Farbe, sondern ein Ort. src/paths.py fuehrt keine Wurzel fuer die
# eigenen Skripte des Nutzers, und eine dafuer einzufuehren hiesse,
# einen Namen zu erfinden, den ausser dieser Zeile niemand liest.
helpers_dir = "~/.local/bin/helpers"

# Die drei Zeichen des Rechtsklick-Menues, seit dem 21.08.2026.
#
# WAS BESTELLT WURDE
#     "was das menue angeht bei rechtsklick will ich das wir das am
#     besten auslagern auf das aktuelle". Ein Rechtsklick auf eine
#     Trefferzeile heftet die Anwendung an den Fuss - oder nimmt sie
#     wieder ab, wenn sie schon dort steht.
#
# WARUM SIE DURCH DIESE DATEI GEHEN
#     Weil der Fuss denselben Menuepunkt mit demselben Zeichen
#     zeichnet (src/templates/ags-dock.template, PIN_ICON und
#     UNPIN_ICON). Zwei Reissnaegel in zwei Schriftarten waeren zwei
#     Reissnaegel, und fuer den einen von beiden waere der Symbol-SSOT
#     nicht zustaendig.
#
#     Es ist ausserdem der Weg, den diese Datei fuer die Masse schon
#     geht: was der Nutzer sieht, gehoert nicht ins uebersetzte Objekt.
#
# WAS DAMIT NICHT BEHOBEN IST, UND ES IST GEZAEHLT
#     hyprlaunch traegt seine VIER vorhandenen Zeichen weiterhin als
#     Emoji-Literale im Quelltext - Lupe, Abakus, Paket und Uhr, in
#     src/LauncherRenderer.cpp als `static const char* ICON_SEARCH =
#     "\xf0\x9f\x94\x8d"` und so fort. GEZAEHLT am 20.08.2026: kein
#     einziger Symbol-Platzhalter im ganzen uebernommenen Baum.
#
#     Das ist ein eigener Befund und wird gesondert gemeldet. Er wird
#     hier NICHT nebenbei mit aufgeraeumt: vier Zeichen zu ersetzen,
#     waehrend ein Menue gebaut wird, mischt zwei Aenderungen in einem
#     Patch, den ohnehin schon niemand gern liest.
pin_icon = "{{ICON_PIN}}"
unpin_icon = "{{ICON_MINUS}}"

# Das dritte, seit dem 21.08.2026: der Schreibtisch, fuer BEIDE
# Richtungen des Home-Punktes.
#
# WARUM EIN ZEICHEN FUER ZWEI PUNKTE
#     "Zum Home hinzufuegen" und "Vom Home entfernen" stehen nie
#     zusammen in einem Menue - der Punkt schlaegt um, je nachdem, ob
#     das Programm schon dort liegt. Das Zeichen nennt deshalb das ZIEL
#     und der Text die Richtung. Ein zweites Minus daneben waeren zwei
#     gleiche Zeichen mit zwei Wirkungen in EINEM Menue, und genau das
#     verbietet der Kopf von src/templates/ags-dock.template fuer sein
#     Kreuz schon einmal.
home_icon = "{{ICON_COMPUTER}}"

# Wo settings.py liegt, seit dem 21.08.2026.
#
# WOFUER
#     Der Rechtsklick heftet an den Fuss und legt aufs Home - beides
#     ueber `python3 <dieser Pfad> dock|home add|remove <name>`,
#     denselben Unterbefehl, den der Fuss und das Home rufen
#     (src/templates/ags-user-settings.template). Bis zum 21.08.2026
#     lief das ueber `zepos-settings-gui --json get|set`; der Kopf von
#     AppDiscovery.cpp im Patch fuehrt aus, warum es das nicht mehr tut.
#
# WARUM ER DURCH DIESE DATEI GEHT
#     Weil ein uebersetztes Programm nicht wissen kann, aus welchem
#     Paket es stammt - genau die Frage, die
#     src/template_processor.py mit {{ZEPOS_SYSTEM_ROOT}} beantwortet.
#     Ein Bau aus einem Checkout bekommt den Checkout, ein Paket das
#     Paket. Der Grundwert im uebersetzten Objekt ist SYSTEM_ROOT aus
#     src/paths.py, also der ausgelieferte Ort - damit ein Starter ohne
#     diese Datei nicht verstummt. Er steht dort und ausdruecklich
#     NICHT hier: eine erzeugte Datei, die den Ort raet, hat die
#     Ersetzung nie bekommen, und genau darauf sieht
#     tests/src/test_naming.py nach.
settings_script = "{{ZEPOS_SYSTEM_ROOT}}/settings.py"

[spacing]
# Die Abstandsleiter aus src/sizes.py, Sprosse fuer Sprosse.
#
# WARUM SIE HIER STEHT UND NICHT IM STYLESHEET
#     GtkBox nimmt den Abstand zwischen ihren Kindern als
#     Konstruktorargument, nicht als CSS-Eigenschaft, und GTK4 hat
#     dafuer keinen Selektor. plugins/hyprlaunch/include/hyprlaunch/
#     Config.hpp fuehrt das aus. Es sind dieselben Sprossen mit
#     denselben Werten, die das Stylesheet daneben bekommt - ein Wert,
#     zwei Leser.
#
#     Alle sieben, obwohl der Starter heute nur 4, 8 und 12 benutzt:
#     eine Leiter, von der die Haelfte fehlt, laedt dazu ein, beim
#     naechsten Kasten wieder eine Zahl hinzuschreiben.
space_2 = {{STYLE_SPACE_2}}
space_4 = {{STYLE_SPACE_4}}
space_8 = {{STYLE_SPACE_8}}
space_12 = {{STYLE_SPACE_12}}
space_16 = {{STYLE_SPACE_16}}
space_20 = {{STYLE_SPACE_20}}
space_24 = {{STYLE_SPACE_24}}
