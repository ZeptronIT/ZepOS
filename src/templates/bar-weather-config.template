#!/bin/bash
# =========================================
# WETTER FÜR DIE LEISTE
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/bar-weather-config.template
# =========================================
#
# Ersetzt die beiden ortsgebundenen Skripte des Ursprungs, die je eine
# Stadt fest in der Adresse stehen hatten. Der Ort kommt jetzt aus den
# Nutzereinstellungen (weather.location), zu setzen mit:
#
#   user_settings.py set-weather-location --value "Berlin"
#
# DATENSCHUTZ, ausdrücklich und nicht zwischen den Zeilen:
# dieses Modul schickt den eingestellten Ort bei jeder Aktualisierung an
# wttr.in, einen fremden Dienst. Der sieht damit den Ort und die
# IP-Adresse dieses Rechners. Das gehört zur Funktion und ist kein Grund,
# sie wegzulassen - aber es ist ein Grund, sie nicht ungefragt
# einzuschalten. Deshalb ist ein leerer Ort kein Fehler, sondern der
# Auslieferungszustand: ohne Ort wird nichts abgefragt, nichts gesendet,
# und das Modul bleibt leer. Wer das Wetter will, trägt den Ort selbst
# ein; niemand sonst tut es für ihn.
#
# Die Antwort wird zwischengespeichert. Ein Leistenmodul läuft im
# Intervall - ohne Puffer fragt es einen kostenlosen Dienst alle paar
# Sekunden, was zu Recht mit einer Sperre beantwortet wird. Eine Sperre
# (HTTP 429) und ein fehlendes Netz sind hier gewöhnliche Zustände, keine
# Fehler: dann steht der letzte bekannte Wert da, und der Tooltip sagt,
# dass er von vorhin ist.

set -u

LOCATION="{{STYLE_WEATHER_LOCATION}}"

# ${HOME:-...} und nicht $HOME: mit set -u bricht ein unbelegtes $HOME das
# Skript an dieser Zeile ab, und ein Leistenmodul, das nichts ausgibt,
# ist ein Modul, das nicht da ist - ohne eine Zeile Erklärung irgendwo.
# Ohne brauchbares Heimatverzeichnis scheitert unten nur das Anlegen des
# Puffers; angezeigt wird trotzdem etwas.
CACHE_DIR="${XDG_CACHE_HOME:-${HOME:-/nonexistent}/.cache}/zepos"
CACHE_FILE="$CACHE_DIR/weather.json"
CACHE_TTL=900       # Sekunden; ein Wetterwert ist keine Viertelstunde später falsch
TIMEOUT=8           # Sekunden; länger blockiert das Modul die Leiste

UNBEKANNT="{{ICON_WEATHER_UNKNOWN}}"

# Die Leiste liest eine JSON-Zeile je Aufruf.
#
# Gebaut mit jq und nicht mit printf: die Beschreibung stammt aus einer
# fremden HTTP-Antwort. Ein Anführungszeichen oder ein Backslash darin
# schliesst bei printf die JSON-Zeichenkette zu früh - Die Leiste bekommt
# kaputtes JSON, zeigt gar nichts an und schreibt nirgends hin, warum.
# jq maskiert, was hineingegeben wird.
ausgeben() {
    jq -cn --arg text "$1" --arg tooltip "$2" --arg class "$3" \
        '{text: $text, tooltip: $tooltip, class: $class}'
}

# Die Wettercodes, die wttr.in liefert (WWO-Schema), auf die Icons der
# SSOT. Ein Code, den diese Tabelle nicht kennt, ist kein Grund, nichts
# anzuzeigen - dafür gibt es das letzte Zeichen.
icon_fuer_code() {
    case "$1" in
        113) printf '%s' "{{ICON_WEATHER_SUNNY}}" ;;
        116) printf '%s' "{{ICON_WEATHER_PARTLY_CLOUDY}}" ;;
        119|122) printf '%s' "{{ICON_WEATHER_CLOUDY}}" ;;
        143|248|260) printf '%s' "{{ICON_WEATHER_FOG}}" ;;
        200|386|389|392|395) printf '%s' "{{ICON_WEATHER_LIGHTNING}}" ;;
        179|182|227|230|323|326|329|332|335|338|368|371)
            printf '%s' "{{ICON_WEATHER_SNOWY}}" ;;
        185|281|284|311|314|317|350|362|365|374|377)
            printf '%s' "{{ICON_WEATHER_HAIL}}" ;;
        299|302|305|308|356|359) printf '%s' "{{ICON_WEATHER_POURING}}" ;;
        176|263|266|293|296|353) printf '%s' "{{ICON_WEATHER_RAINY}}" ;;
        *) printf '%s' "$UNBEKANNT" ;;
    esac
}

# Aus einer Antwort eine Leistenzeile machen. Rückgabe 1 heisst: das war
# keine Antwort, aus der sich etwas anzeigen liesse.
darstellen() {
    local antwort="$1" zusatz="$2" klasse="$3"
    local temperatur beschreibung code

    temperatur=$(printf '%s' "$antwort" | jq -er '.current_condition[0].temp_C' 2>/dev/null) || return 1
    beschreibung=$(printf '%s' "$antwort" | jq -er '.current_condition[0].weatherDesc[0].value' 2>/dev/null) || return 1
    code=$(printf '%s' "$antwort" | jq -er '.current_condition[0].weatherCode' 2>/dev/null) || return 1

    # Die Temperatur wird angezeigt, also wird sie geprüft. jq schützt das
    # JSON, aber nicht davor, dass Unfug in der Leiste steht: gültiges
    # JSON mit einem fehlenden Feld liefert "null", und "null°C" ist
    # schlimmer als ein ehrliches "nicht verfügbar".
    case "$temperatur" in
        ''|*[!0-9-]*) return 1 ;;
    esac

    ausgeben "$(icon_fuer_code "$code") ${temperatur}°C" \
             "$LOCATION: $beschreibung$zusatz" "$klasse"
}

if [ -z "$LOCATION" ]; then
    # Kein Ort, keine Abfrage. Die Leiste blendet ein Modul mit leerem Text
    # aus, das Modul ist also nicht bloss stumm, sondern unsichtbar.
    ausgeben "" "Kein Ort eingestellt - es wird nichts abgefragt und nichts gesendet." \
             "weather-unconfigured"
    exit 0
fi

# EPOCHSECONDS gibt es seit Bash 5 und es kostet keinen Prozess je
# Intervall. Auf einer älteren Bash kostet es einen Aufruf von date -
# besser als ein Puffer, der sich für uralt hält und deshalb nie greift.
now=${EPOCHSECONDS:-}
[ -n "$now" ] || now=$(date +%s 2>/dev/null || printf '0')

gepuffert=""
gepuffert_am=0
if [ -f "$CACHE_FILE" ]; then
    # $(< datei) statt cat: ein Modul, das im Intervall läuft, soll dafür
    # keinen Prozess starten.
    roh=$(< "$CACHE_FILE")
    gepuffert_am=${roh%%$'\n'*}
    gepuffert=${roh#*$'\n'}
    case "$gepuffert_am" in
        ''|*[!0-9]*) gepuffert_am=0 ;;
    esac
fi

if [ "$now" -gt 0 ] && [ "$gepuffert_am" -gt 0 ] \
   && [ "$((now - gepuffert_am))" -lt "$CACHE_TTL" ]; then
    darstellen "$gepuffert" "" "weather-ok" && exit 0
fi

# Ein Fehlschlag ist kein Fehlerzustand, solange ein letzter bekannter
# Wert vorliegt: alt und als alt beschriftet ist besser als leer. Die
# Klasse bleibt die des Fehlschlags, damit die Leiste den Unterschied
# einfärben kann.
rueckfall() {
    local klasse="$1" grund="$2"
    if [ -n "$gepuffert" ] \
       && darstellen "$gepuffert" " (Stand von vorhin, $grund)" "$klasse"; then
        exit 0
    fi
    ausgeben "$UNBEKANNT" "Wetter nicht verfügbar: $grund" "$klasse"
    exit 0
}

# Leerzeichen im Ortsnamen: wttr.in nimmt "+" als Trenner.
adresse="https://wttr.in/${LOCATION// /+}?format=j1"

# -w hängt den HTTP-Status hinter den Rumpf, durch einen Zeilenumbruch
# getrennt. Ohne ihn sind "der Dienst sperrt uns aus", "den Ort gibt es
# nicht" und "der Dienst ist kaputt" ununterscheidbar, und alle drei
# sähen aus wie ein Netzausfall.
roh=$(curl -s --max-time "$TIMEOUT" -w '\n%{http_code}' "$adresse" 2>/dev/null)
curl_status=$?
status_code=${roh##*$'\n'}
rumpf=${roh%$'\n'*}

if [ "$curl_status" -ne 0 ]; then
    rueckfall "weather-offline" "kein Netz oder Zeitüberschreitung"
elif [ "$status_code" = "429" ]; then
    rueckfall "weather-throttled" "der Dienst begrenzt die Abfragen"
elif [ "$status_code" = "404" ]; then
    ausgeben "$UNBEKANNT" "Ort nicht gefunden: $LOCATION" "weather-unknown-location"
    exit 0
elif [ "$status_code" != "200" ]; then
    rueckfall "weather-error" "der Dienst antwortet mit $status_code"
fi

if darstellen "$rumpf" "" "weather-ok"; then
    # Erst anzeigen, dann puffern - und nur, was sich anzeigen liess.
    # Eine unlesbare Antwort in den Puffer zu schreiben hiesse, den
    # letzten brauchbaren Wert dafür wegzuwerfen.
    if mkdir -p "$CACHE_DIR" 2>/dev/null; then
        printf '%s\n%s\n' "$now" "$rumpf" > "$CACHE_FILE" 2>/dev/null || true
    fi
    exit 0
fi

rueckfall "weather-error" "die Antwort war nicht lesbar"
