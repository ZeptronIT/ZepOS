#!/bin/bash
# Wallpaper Manager - Backend Script for Wallpaper Selector
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/wallpaper-manager-config.template
# HARDENED VERSION: Production-ready with rate-limiting and zombie prevention

# ============================================================================
# CONFIGURATION
# ============================================================================
WALLPAPER_DIR="$HOME/.config/hypr/wallpapers"
LANDSCAPE_DIR="$WALLPAPER_DIR/landscape"
PORTRAIT_DIR="$WALLPAPER_DIR/portrait"
THUMBNAIL_DIR="$HOME/.cache/wallpaper-thumbnails"
CURRENT_FILE="$HOME/.cache/current-wallpaper"

# The wallpaper a machine has when nobody has chosen one, installed by
# the zepos-config package.
#
# Until this existed a freshly installed ZepOS came up BLACK. The
# generated hyprland.conf has exactly one wallpaper line - `exec-once =
# sleep 2 && wallpaper-manager restore` - and restore reads $CURRENT_FILE,
# which no fresh account has. It found nothing, returned, and never
# started swaybg at all. Nothing failed and nothing said anything; the
# desktop was simply the compositor's default colour, on every first boot
# ZepOS has ever had.
#
# The path is substituted by the generator rather than written out here,
# because an artifact cannot know whether it came from the package root
# or from somebody's checkout - and a guess is a black desktop again.
DEFAULT_WALLPAPER="{{ZEPOS_SYSTEM_ROOT}}/branding/zepos-wallpaper.png"

THUMBNAIL_WIDTH="160"
THUMBNAIL_HEIGHT="90"

# Rate limiting configuration
#
# TMPDIR wird beachtet: grid-wallpaper-toggle.sh legt seine Marker
# ebenfalls dort ab, und ein fest verdrahtetes /tmp laesst die beiden
# Skripte an verschiedenen Orten nachsehen.
RATE_LIMIT_DIR="${TMPDIR:-/tmp}/wallpaper-manager-ratelimit"
RATE_LIMIT_MS=300  # Minimum ms between same actions

# ============================================================================
# RATE LIMITING - Prevent rapid-fire actions
# ============================================================================
rate_limit_check() {
    local action="$1"
    local rate_file="$RATE_LIMIT_DIR/$action"

    mkdir -p "$RATE_LIMIT_DIR" 2>/dev/null

    if [ -f "$rate_file" ]; then
        local last_call=$(cat "$rate_file" 2>/dev/null || echo 0)
        local now=$(date +%s%3N 2>/dev/null || echo 0)
        local diff=$((now - last_call))
        if [ "$diff" -lt "$RATE_LIMIT_MS" ] 2>/dev/null; then
            return 1  # Rate limited
        fi
    fi

    date +%s%3N > "$rate_file" 2>/dev/null
    return 0  # OK to proceed
}

# Ensure directories exist
mkdir -p "$LANDSCAPE_DIR" "$PORTRAIT_DIR" "$THUMBNAIL_DIR"

# Generate thumbnail for a wallpaper (uses ffmpeg, fallback to convert)
generate_thumbnail() {
    local wallpaper="$1"
    local filename=$(basename "$wallpaper")
    local thumbnail="$THUMBNAIL_DIR/${filename%.*}.jpg"

    if [ ! -f "$thumbnail" ] || [ "$wallpaper" -nt "$thumbnail" ]; then
        if command -v ffmpeg &>/dev/null; then
            ffmpeg -y -i "$wallpaper" -vf "scale=${THUMBNAIL_WIDTH}:${THUMBNAIL_HEIGHT}:force_original_aspect_ratio=increase,crop=${THUMBNAIL_WIDTH}:${THUMBNAIL_HEIGHT}" -q:v 5 "$thumbnail" 2>/dev/null
        elif command -v convert &>/dev/null; then
            convert "$wallpaper" -thumbnail "${THUMBNAIL_WIDTH}x${THUMBNAIL_HEIGHT}^" \
                -gravity center -extent "${THUMBNAIL_WIDTH}x${THUMBNAIL_HEIGHT}" \
                -quality 80 "$thumbnail" 2>/dev/null
        fi
    fi

    echo "$thumbnail"
}

# List all wallpapers with thumbnails (JSON output)
list_wallpapers() {
    local type="$1"  # landscape, portrait, or all

    echo "{"

    # Landscape wallpapers
    if [ "$type" = "landscape" ] || [ "$type" = "all" ]; then
        echo '  "landscape": ['
        local first=true
        while IFS= read -r wallpaper; do
            [ -f "$wallpaper" ] || continue
            local thumbnail=$(generate_thumbnail "$wallpaper")
            local filename=$(basename "$wallpaper")
            [ "$first" = true ] || echo ","
            first=false
            printf '    {"path": "%s", "thumbnail": "%s", "name": "%s"}' "$wallpaper" "$thumbnail" "$filename"
        done < <(find "$LANDSCAPE_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | sort)
        echo ""
        echo "  ]"
        [ "$type" = "all" ] && echo ","
    fi

    # Portrait wallpapers
    if [ "$type" = "portrait" ] || [ "$type" = "all" ]; then
        echo '  "portrait": ['
        local first=true
        while IFS= read -r wallpaper; do
            [ -f "$wallpaper" ] || continue
            local thumbnail=$(generate_thumbnail "$wallpaper")
            local filename=$(basename "$wallpaper")
            [ "$first" = true ] || echo ","
            first=false
            printf '    {"path": "%s", "thumbnail": "%s", "name": "%s"}' "$wallpaper" "$thumbnail" "$filename"
        done < <(find "$PORTRAIT_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | sort)
        echo ""
        echo "  ]"
    fi

    echo "}"
}

# Count wallpapers
count_wallpapers() {
    local landscape_count=$(find "$LANDSCAPE_DIR" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | wc -l)
    local portrait_count=$(find "$PORTRAIT_DIR" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | wc -l)
    echo "$landscape_count $portrait_count"
}

# Get list of landscape wallpapers as JSON array (JSON)
list_landscape() {
    local files=$(find "$LANDSCAPE_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" -o -name "*.JPG" -o -name "*.PNG" \) 2>/dev/null | sort)
    if [ -z "$files" ]; then
        echo "[]"
    else
        echo "$files" | jq -R -s -c 'split("\n") | map(select(length > 0))'
    fi
}

# Get list of portrait wallpapers as JSON array (JSON)
list_portrait() {
    local files=$(find "$PORTRAIT_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" -o -name "*.JPG" -o -name "*.PNG" \) 2>/dev/null | sort)
    if [ -z "$files" ]; then
        echo "[]"
    else
        echo "$files" | jq -R -s -c 'split("\n") | map(select(length > 0))'
    fi
}

# Get list of ALL wallpapers as JSON array (JSON)
list_all() {
    local files=$(find "$LANDSCAPE_DIR" "$PORTRAIT_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" -o -name "*.JPG" -o -name "*.PNG" \) 2>/dev/null | sort)
    if [ -z "$files" ]; then
        echo "[]"
    else
        echo "$files" | jq -R -s -c 'split("\n") | map(select(length > 0))'
    fi
}

# Get list of ALL wallpapers grouped in rows with thumbnails (for grid layout)
# Format: [[{"path":"/full/1.jpg","thumb":"/cache/1.jpg"}, ...], ...]
# Uses cached thumbnails for performance instead of loading 4K originals
# Automatically generates missing thumbnails on first call
list_all_rows() {
    local cols=${1:-3}
    local items=()

    while IFS= read -r wallpaper; do
        [ -z "$wallpaper" ] && continue
        local filename=$(basename "$wallpaper")
        local thumbnail="$THUMBNAIL_DIR/${filename%.*}.jpg"

        # Auto-generate thumbnail if missing
        if [ ! -f "$thumbnail" ]; then
            generate_thumbnail "$wallpaper" >/dev/null 2>&1
        fi

        items+=("{\"path\":\"$wallpaper\",\"thumb\":\"$thumbnail\"}")
    done < <(find "$LANDSCAPE_DIR" "$PORTRAIT_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" -o -name "*.JPG" -o -name "*.PNG" \) 2>/dev/null | sort)

    # Convert to JSON array grouped in rows
    if [ ${#items[@]} -eq 0 ]; then
        echo "[]"
    else
        printf '%s\n' "${items[@]}" | jq -s -c --argjson cols "$cols" '[range(0; length; $cols) as $i | .[($i):($i + $cols)]]'
    fi
}

# Get list of ALL wallpapers with their thumbnails as JSON array (with thumbnails)
# Format: [{"path": "/full/path.png", "thumb": "/cache/thumb.jpg"}, ...]
list_with_thumbnails() {
    local result="["
    local first=true

    while IFS= read -r wallpaper; do
        [ -z "$wallpaper" ] && continue
        local filename=$(basename "$wallpaper")
        local thumbnail="$THUMBNAIL_DIR/${filename%.*}.jpg"

        # Generate thumbnail if missing
        if [ ! -f "$thumbnail" ]; then
            generate_thumbnail "$wallpaper" >/dev/null
        fi

        [ "$first" = true ] || result+=","
        first=false
        result+="{\"path\":\"$wallpaper\",\"thumb\":\"$thumbnail\"}"
    done < <(find "$LANDSCAPE_DIR" "$PORTRAIT_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" -o -name "*.JPG" -o -name "*.PNG" \) 2>/dev/null | sort)

    result+="]"
    echo "$result"
}

# Get thumbnail path for a wallpaper
get_thumbnail() {
    local wallpaper="$1"
    generate_thumbnail "$wallpaper"
}

# The shipped wallpaper, on every screen, with none of the bookkeeping.
#
# Deliberately not apply_wallpaper(). That one does three things a
# DEFAULT must not do:
#
#   * it writes $CURRENT_FILE, which records the wallpaper as a choice -
#     and a choice is what stops the next one from arriving, so a package
#     update carrying a new wallpaper would never reach anybody who had
#     merely booted;
#   * it sends a notification, and a toast naming a file the user did not
#     pick, on every single login, is noise;
#   * it applies only to monitors whose orientation matches the image,
#     which on a portrait-only machine is none of them. A default has to
#     cover every screen or it is not a default.
apply_default_wallpaper() {
    local wallpaper="$1"
    [ -f "$wallpaper" ] || return 1

    timeout 2 pkill -9 -f swaybg 2>/dev/null || true
    sleep 0.2

    hyprctl monitors -j | jq -r '.[].name' | while read -r name; do
        [ -n "$name" ] || continue
        swaybg -o "$name" -m fill -i "$wallpaper" &
        disown
    done
}

# Apply wallpaper to a specific monitor (or all matching if no monitor specified)
# Usage: apply_wallpaper <path> [monitor_id]
apply_wallpaper() {
    local wallpaper="$1"
    local target_monitor="$2"  # Optional: specific monitor ID (0, 1, 2, ...)

    # Rate limiting - prevent rapid-fire clicks
    if ! rate_limit_check "apply_${target_monitor:-all}"; then
        return 0  # Silently ignore rate-limited calls
    fi

    if [ ! -f "$wallpaper" ]; then
        notify-send -u critical "{{ICON_ERROR}} Wallpaper" "Datei nicht gefunden: $wallpaper"
        return 1
    fi

    # Check if Grid Mode is active
    local grid_toggle_file="$HOME/.config/hypr/.grid_mode_active"
    if [ -f "$grid_toggle_file" ]; then
        notify-send "{{ICON_WARNING}} Wallpaper" "Grid Mode ist aktiv!\nDeaktiviere Grid Mode zuerst."
        return 1
    fi

    # Get target monitor name if ID specified
    # Resolve by Hyprland id (json key), not array position — they don't match
    local target_monitor_name=""
    if [ -n "$target_monitor" ]; then
        target_monitor_name=$(hyprctl monitors -j | jq -r --argjson id "$target_monitor" '.[] | select(.id==$id) | .name')
    fi

    # Kill existing swaybg for target monitor only, or all if no target
    if [ -n "$target_monitor_name" ]; then
        # Use timeout and suppress errors to prevent hangs
        timeout 2 pkill -f "swaybg -o $target_monitor_name" 2>/dev/null || true
        sleep 0.15
        swaybg -o "$target_monitor_name" -m fill -i "$wallpaper" &
        disown  # Prevent zombie processes

        # Save per-monitor wallpaper AND update global file for polling compatibility
        echo "$wallpaper" > "${CURRENT_FILE}_${target_monitor}"
        echo "$wallpaper" > "$CURRENT_FILE"
        notify-send -t 2000 "{{ICON_WALLPAPER}} Wallpaper" "$(basename "$wallpaper")\nMonitor: $target_monitor_name"
    else
        # Legacy: apply to all matching monitors
        local img_width=$(identify -format "%w" "$wallpaper" 2>/dev/null)
        local img_height=$(identify -format "%h" "$wallpaper" 2>/dev/null)
        local is_portrait=false

        if [ "$img_height" -gt "$img_width" ]; then
            is_portrait=true
        fi

        timeout 2 pkill -9 -f swaybg 2>/dev/null || true
        sleep 0.2

        hyprctl monitors -j | jq -r '.[] | "\(.name) \(.width) \(.height) \(.transform)"' | while read -r name width height transform; do
            local monitor_portrait=false

            if [ "$transform" = "1" ] || [ "$transform" = "3" ]; then
                monitor_portrait=true
            elif [ "$height" -gt "$width" ]; then
                monitor_portrait=true
            fi

            if [ "$is_portrait" = "$monitor_portrait" ]; then
                swaybg -o "$name" -m fill -i "$wallpaper" &
                disown  # Prevent zombie processes
            fi
        done

        echo "$wallpaper" > "$CURRENT_FILE"
        notify-send -t 2000 "{{ICON_WALLPAPER}} Wallpaper" "$(basename "$wallpaper")"
    fi
}

# List connected monitors as JSON array
# Returns: [{"id":0,"name":"DP-1","width":3440,"height":1440,"portrait":false}, ...]
list_monitors() {
    hyprctl monitors -j | jq -c '[.[] | {
        id: .id,
        name: .name,
        width: .width,
        height: .height,
        portrait: ((.transform == 1 or .transform == 3) or (.height > .width))
    }]'
}

# Check if a monitor is portrait orientation
is_monitor_portrait() {
    local monitor_id="$1"
    # Resolve by Hyprland id (json key), not array position
    local monitor_json=$(hyprctl monitors -j | jq --argjson id "$monitor_id" '.[] | select(.id==$id)')
    local transform=$(echo "$monitor_json" | jq -r ".transform // 0")
    local width=$(echo "$monitor_json" | jq -r ".width // 1920")
    local height=$(echo "$monitor_json" | jq -r ".height // 1080")

    if [ "$transform" = "1" ] || [ "$transform" = "3" ] || [ "$height" -gt "$width" ]; then
        echo "true"
    else
        echo "false"
    fi
}

# List wallpapers for a specific monitor (based on orientation)
# Returns JSON with thumbnail paths for performance: [[{"path":"/full.jpg","thumb":"/cache/thumb.jpg"}, ...], ...]
list_for_monitor() {
    local monitor_id="${1:-0}"
    local cols="${2:-3}"

    local is_portrait=$(is_monitor_portrait "$monitor_id")
    local search_dir="$LANDSCAPE_DIR"

    if [ "$is_portrait" = "true" ]; then
        search_dir="$PORTRAIT_DIR"
    fi

    local items=()
    while IFS= read -r wallpaper; do
        [ -z "$wallpaper" ] && continue
        local filename=$(basename "$wallpaper")
        local thumbnail="$THUMBNAIL_DIR/${filename%.*}.jpg"

        # Auto-generate thumbnail if missing (silent, in background for first load)
        if [ ! -f "$thumbnail" ]; then
            generate_thumbnail "$wallpaper" >/dev/null 2>&1
        fi

        items+=("{\"path\":\"$wallpaper\",\"thumb\":\"$thumbnail\"}")
    done < <(find "$search_dir" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" -o -name "*.JPG" -o -name "*.PNG" \) 2>/dev/null | sort)

    if [ ${#items[@]} -eq 0 ]; then
        echo "[]"
    else
        printf '%s\n' "${items[@]}" | jq -s -c --argjson cols "$cols" '[range(0; length; $cols) as $i | .[($i):($i + $cols)]]'
    fi
}

# Apply random wallpaper - for specific monitor or all if no monitor specified
apply_random() {
    local target_monitor="$1"  # Optional: specific monitor ID

    # Rate limiting
    if ! rate_limit_check "random_${target_monitor:-all}"; then
        return 0
    fi

    # Determine which wallpapers to use based on monitor orientation
    local search_dir="$LANDSCAPE_DIR"
    if [ -n "$target_monitor" ]; then
        local is_portrait=$(is_monitor_portrait "$target_monitor")
        if [ "$is_portrait" = "true" ]; then
            search_dir="$PORTRAIT_DIR"
        fi
    fi

    # Get wallpapers from appropriate directory
    #
    # Read line by line, the way list_all_rows, list_with_thumbnails and
    # list_for_monitor above already do. An unquoted $(find ...) inside
    # an array assignment is split on every space, so a wallpaper called
    # "Sunset Beach.jpg" became the two entries "Sunset" and "Beach.jpg":
    # the random index was drawn from a count that is not the number of
    # files, and apply_wallpaper was handed a path that does not exist -
    # measured, with one such file present, as "Datei nicht gefunden:
    # Beach.jpg" every single time.
    local wallpapers=()
    local candidate
    while IFS= read -r candidate; do
        [ -n "$candidate" ] && wallpapers+=("$candidate")
    done < <(find "$search_dir" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" -o -name "*.JPG" -o -name "*.PNG" \) 2>/dev/null)

    if [ ${#wallpapers[@]} -eq 0 ]; then
        notify-send -u critical "{{ICON_ERROR}} Wallpaper" "Keine Wallpapers gefunden!"
        return 1
    fi

    # Pick a random wallpaper
    local random_index=$((RANDOM % ${#wallpapers[@]}))
    local selected="${wallpapers[$random_index]}"

    # Apply it to the specified monitor or all
    apply_wallpaper "$selected" "$target_monitor"
}

# Import wallpaper via file dialog
import_wallpaper() {
    local target_type="$1"  # landscape or portrait

    # Rate limiting - prevent double-click opening multiple dialogs
    if ! rate_limit_check "import"; then
        return 0
    fi

    # Use yad file selection (fallback to zenity if available)
    local selected=""
    if command -v yad &> /dev/null; then
        selected=$(yad --file \
            --title="Wallpaper importieren (${target_type})" \
            --file-filter="Bilder | *.jpg *.jpeg *.png *.webp *.JPG *.JPEG *.PNG *.WEBP" \
            --file-filter="Alle Dateien | *" \
            --width=800 --height=600 \
            2>/dev/null)
    elif command -v zenity &> /dev/null; then
        selected=$(zenity --file-selection \
            --title="Wallpaper importieren (${target_type})" \
            --file-filter="Bilder | *.jpg *.jpeg *.png *.webp" \
            --file-filter="Alle Dateien | *" \
            2>/dev/null)
    else
        notify-send -u critical "{{ICON_ERROR}} Import" "Kein Datei-Dialog verfügbar!\nInstalliere yad oder zenity."
        return 1
    fi

    if [ -z "$selected" ]; then
        return 1
    fi

    if [ ! -f "$selected" ]; then
        notify-send -u critical "{{ICON_ERROR}} Import" "Datei nicht gefunden!"
        return 1
    fi

    # Determine target directory
    local target_dir="$LANDSCAPE_DIR"
    if [ "$target_type" = "portrait" ]; then
        target_dir="$PORTRAIT_DIR"
    fi

    # Copy file
    local filename=$(basename "$selected")
    local target_path="$target_dir/$filename"

    # Handle duplicate names
    if [ -f "$target_path" ]; then
        local base="${filename%.*}"
        local ext="${filename##*.}"
        local counter=1
        while [ -f "$target_dir/${base}_${counter}.${ext}" ]; do
            ((counter++))
        done
        target_path="$target_dir/${base}_${counter}.${ext}"
        filename="${base}_${counter}.${ext}"
    fi

    cp "$selected" "$target_path"

    if [ $? -eq 0 ]; then
        # Generate thumbnail
        generate_thumbnail "$target_path" > /dev/null
        notify-send -t 3000 "{{ICON_SUCCESS}} Import" "Wallpaper importiert:\n$filename\n\nKlicke auf das Thumbnail um es anzuwenden."
    else
        notify-send -u critical "{{ICON_ERROR}} Import" "Fehler beim Kopieren!"
        return 1
    fi
}

# Delete wallpaper
delete_wallpaper() {
    local wallpaper="$1"

    # Rate limiting - prevent accidental double-clicks
    if ! rate_limit_check "delete"; then
        return 0
    fi

    if [ ! -f "$wallpaper" ]; then
        notify-send -u critical "{{ICON_ERROR}} Löschen" "Datei nicht gefunden!"
        return 1
    fi

    local filename=$(basename "$wallpaper")

    # Confirm deletion using yad or zenity
    local confirmed=false
    if command -v yad &> /dev/null; then
        yad --question --title="Wallpaper löschen?" \
            --text="Möchtest du dieses Wallpaper wirklich löschen?\n\n$filename" \
            --width=400 2>/dev/null && confirmed=true
    elif command -v zenity &> /dev/null; then
        zenity --question --title="Wallpaper löschen?" \
            --text="Möchtest du dieses Wallpaper wirklich löschen?\n\n$filename" \
            --width=300 2>/dev/null && confirmed=true
    else
        # No dialog available, just delete
        confirmed=true
    fi

    if [ "$confirmed" = true ]; then
        # Remove wallpaper and thumbnail
        rm -f "$wallpaper"
        rm -f "$THUMBNAIL_DIR/${filename%.*}.jpg"

        notify-send -t 2000 "{{ICON_TRASH}} Gelöscht" "$filename"
    fi
}

# Get current wallpaper (checks per-monitor files first, falls back to global)
get_current() {
    local monitor="${1:-0}"
    local per_monitor_file="${CURRENT_FILE}_${monitor}"

    # Try per-monitor file first
    if [ -f "$per_monitor_file" ]; then
        cat "$per_monitor_file"
    # Fall back to global file
    elif [ -f "$CURRENT_FILE" ]; then
        cat "$CURRENT_FILE"
    else
        echo ""
    fi
}

# Regenerate all thumbnails
regenerate_thumbnails() {
    # Rate limiting - this is an expensive operation
    if ! rate_limit_check "regenerate"; then
        notify-send "{{ICON_INFO}} Thumbnails" "Bereits in Bearbeitung..."
        return 0
    fi

    notify-send "{{ICON_REFRESH}} Thumbnails" "Regeneriere... Bitte warten."

    rm -rf "$THUMBNAIL_DIR"
    mkdir -p "$THUMBNAIL_DIR"

    local count=0
    while IFS= read -r wallpaper; do
        [ -f "$wallpaper" ] || continue
        generate_thumbnail "$wallpaper" > /dev/null
        ((count++))
    done < <(find "$LANDSCAPE_DIR" "$PORTRAIT_DIR" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null)

    notify-send -t 2000 "{{ICON_REFRESH}} Thumbnails" "$count Thumbnails generiert"
}

# Toggle grid wallpaper
toggle_grid() {
    if [ -f "$HOME/.config/hypr/grid-wallpaper-toggle.sh" ]; then
        "$HOME/.config/hypr/grid-wallpaper-toggle.sh" toggle
    else
        notify-send -u critical "{{ICON_ERROR}} Grid" "grid-wallpaper-toggle.sh nicht gefunden!"
    fi
}

# Check if grid mode is active
#
# Zwei Fehler steckten hier drin, und beide liessen die Funktion immer
# "false" melden - der Grid-Modus war also fuer jeden Aufrufer
# unsichtbar:
#
#   * Im Pfad "/tmp/..." stand ein echter Zeilenumbruch mitten im Wort,
#     gesucht wurde also nach einer Datei namens "/t\n    mp/...".
#   * "[ -f "$prefix"* ]" prueft bei keinem Treffer die Zeichenkette
#     selbst und ist bei mehreren Treffern ein Syntaxfehler - ein
#     Platzhalter gehoert nicht in ein einzelnes -f.
#
# grid-wallpaper-toggle.sh legt die Datei unter "${TMPDIR:-/tmp}" ab,
# nicht fest unter /tmp: wer TMPDIR gesetzt hat, bekam den Grid-Modus
# auch nach dem Zeilenumbruch nicht zu sehen.
is_grid_active() {
    if [ -f "$HOME/.config/hypr/.grid_mode_active" ]; then
        echo "true"
        return
    fi

    local tmp_dir="${TMPDIR:-/tmp}"
    local marker
    for marker in "$tmp_dir"/grid-wallpaper-active-*; do
        if [ -f "$marker" ]; then
            echo "true"
            return
        fi
    done

    echo "false"
}

# Restore saved wallpapers on startup (per-monitor)
restore_wallpaper() {
    sleep 1  # Ensure Hyprland is ready

    local restored=false

    # Get number of monitors
    local monitor_count=$(hyprctl monitors -j | jq 'length')

    # Restore per-monitor wallpapers
    for ((i=0; i<monitor_count; i++)); do
        local per_monitor_file="${CURRENT_FILE}_${i}"
        if [ -f "$per_monitor_file" ]; then
            local saved_wallpaper=$(cat "$per_monitor_file")
            if [ -f "$saved_wallpaper" ]; then
                apply_wallpaper "$saved_wallpaper" "$i"
                restored=true
            fi
        fi
    done

    # Fallback: restore global wallpaper if no per-monitor wallpapers found
    if [ "$restored" = false ] && [ -f "$CURRENT_FILE" ]; then
        local saved_wallpaper=$(cat "$CURRENT_FILE")
        if [ -f "$saved_wallpaper" ]; then
            apply_wallpaper "$saved_wallpaper"
            restored=true
        fi
    fi

    # And the shipped one, for an account that has never chosen. This is
    # the branch that makes a first boot show a desktop instead of the
    # compositor's black - see DEFAULT_WALLPAPER at the top.
    if [ "$restored" = false ]; then
        apply_default_wallpaper "$DEFAULT_WALLPAPER"
    fi
}

# Main
case "$1" in
    list)
        list_wallpapers "${2:-all}"
        ;;
    list-landscape)
        list_landscape
        ;;
    list-portrait)
        list_portrait
        ;;
    list-all)
        list_all
        ;;
    list-all-rows)
        list_all_rows "${2:-3}"
        ;;
    list-with-thumbnails)
        list_with_thumbnails
        ;;
    count)
        count_wallpapers
        ;;
    thumbnail)
        get_thumbnail "$2"
        ;;
    apply)
        apply_wallpaper "$2" "$3"
        ;;
    list-for-monitor)
        list_for_monitor "${2:-0}" "${3:-3}"
        ;;
    is-portrait)
        is_monitor_portrait "${2:-0}"
        ;;
    list-monitors)
        list_monitors
        ;;
    random)
        apply_random
        ;;
    import)
        import_wallpaper "${2:-landscape}"
        ;;
    delete)
        delete_wallpaper "$2"
        ;;
    current)
        get_current "${2:-0}"
        ;;
    regenerate)
        regenerate_thumbnails
        ;;
    grid-toggle)
        toggle_grid
        ;;
    grid-active)
        is_grid_active
        ;;
    restore)
        restore_wallpaper
        ;;
    *)
        echo "Wallpaper Manager"
        echo ""
        echo "Usage: $0 <command> [args]"
        echo ""
        echo "Commands:"
        echo "  list [type]       - List wallpapers (landscape/portrait/all)"
        echo "  list-landscape    - List landscape wallpapers (one per line)"
        echo "  list-portrait     - List portrait wallpapers (one per line)"
        echo "  count             - Count wallpapers (landscape portrait)"
        echo "  thumbnail <path>  - Get/generate thumbnail for wallpaper"
        echo "  apply <path>      - Apply wallpaper to monitors"
        echo "  random            - Apply random wallpaper"
        echo "  import [type]     - Import wallpaper via file dialog"
        echo "  delete <path>     - Delete wallpaper"
        echo "  current           - Get current wallpaper path"
        echo "  regenerate        - Regenerate all thumbnails"
        echo "  grid-toggle       - Toggle grid wallpaper mode"
        echo "  list-monitors     - List connected monitors (JSON)"
        echo "  grid-active       - Check if grid mode is active"
        ;;
esac
