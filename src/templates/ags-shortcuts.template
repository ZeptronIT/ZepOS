import { Gtk } from "ags/gtk4"
import { execAsync } from "ags/process"
import GLib from "gi://GLib"
import { createOverlayWindow, OverlayWidget } from "../utils/overlay"
import { _ } from "../utils/i18n"
import { zepButton } from "../utils/kit"

const HOME = GLib.get_home_dir()
// The keybind editor opens the USER template: editing the packaged one
// would either fail on a read-only /usr or be discarded by the next
// package update.
//
// The user root is resolved at run time because it follows
// XDG_CONFIG_HOME, which this process can read for itself. The system
// root cannot be worked out that way - the widget runs from
// ~/.config/ags and does not know which package produced it - so it is
// substituted while generating.
const CONFIG_HOME = GLib.getenv("XDG_CONFIG_HOME") || `${HOME}/.config`
const ZEPOS_USER_ROOT = GLib.getenv("ZEPOS_USER_ROOT") || `${CONFIG_HOME}/zepos`
const ZEPOS_SYSTEM_ROOT = "{{ZEPOS_SYSTEM_ROOT}}"
const KEYBIND_TEMPLATE = "hyprland-universal-config.template"

// Der eine Leser. Kein zweiter Auswerter in dieser Datei.
const KEYBIND_READER = `${ZEPOS_SYSTEM_ROOT}/keybinds.py`

// Womit die Vorlage bearbeitet wird.
//
// Hier stand `subl` - Sublime Text aus dem AUR. Kein Paket dieses
// Projekts installiert es (Spec §4.3), der Knopf lief also auf jeder
// ZepOS-Installation ins Leere, und zwar lautlos: execAsync startet eine
// Shell, die Shell findet nichts, und niemand erfaehrt es. Genau der
// stumme Fehler aus §7.4, in dem Fenster, das ihn erklaeren soll.
// gnome-text-editor ist der Editor aus packaging/zepos-apps, derselbe,
// den SUPER+T oeffnet.
const EDITOR = "gnome-text-editor"

// DIE BREITE IST EINE ADDITION, UND SIE WIRD AUF 1920 TROTZDEM NICHT
// ERREICHT
//
//     Hier stand 1020, und `.shortcuts-container` traegt
//     `min-width: 1000px`. Wie bei jedem anderen Aufklappfenster muss
//     das Fenster neben dem Inhalt auch den Kasten bezahlen, in dem er
//     sitzt - die lange Fassung steht in ags-calendar.template.
//
//     GEMESSEN am 17.08.2026 im verschachtelten Compositor, Schirm
//     1920x1080, in beiden Sprachen dieselbe Zahl:
//
//         .shortcuts-container { min-width: 1000px }  1000
//         dessen padding {{STYLE_SPACE_16}}, zweimal   +50
//                                                     ----
//         Inhalt, gemessen                            1050
//         .overlay-outer, Rahmen 1px, zweimal           +2
//         senkrechte Bildlaufleiste (immer reserviert) +24
//                                                     ----
//                                                     1076
//
//     DIESES FENSTER IST DER EINE FALL, IN DEM DIE ZAHL NICHT REICHT,
//     UND DAS IST KEIN FEHLER
//         MEASURE_MODAL_SHARE (src/sizes.py) deckelt ein Fenster, das
//         sich vor die Arbeit stellt, auf die Haelfte des Schirms. Auf
//         1920 sind das 960 - einhundertsechzehn weniger als die 1076,
//         die der Inhalt braucht. GEMESSEN am selben Tag stand das
//         Fenster 960 breit da und trug unten eine waagerechte
//         Bildlaufleiste; sein Sichtfenster war 934 breit bei 1050
//         Inhalt.
//
//         Das ist eine ENTWURFSREGEL und keine zu klein angemeldete
//         Zahl; sie wird hier nicht umgangen. Was diese 1076 bewirken,
//         ist deshalb genau eines: ab 2152 Punkten Schirmbreite
//         (zweimal 1076) steht das Fenster vollstaendig da statt auf
//         1020 gedeckelt. Auf 1920 aendern sie nichts.
const WIN_WIDTH = 1076
const WIN_HEIGHT = 680

// Wieviele Spalten die Gruppen fuellen. Die Gruppen selbst kommen aus
// der Konfiguration und werden hier nur verteilt - eine feste Zuordnung
// "welche Gruppe in welche Spalte" waere wieder eine Liste, die jemand
// nachtragen muesste.
const COLUMNS = 3

// Icons
const ICONS = {
  keyboard: "{{ICON_KEYBOARD}}",
  edit: "{{ICON_EDIT}}",
  warning: "{{ICON_WARNING}}",
}

// Die Datei, aus der die Notfalltasten kommen. Woran sonst sollte man
// sie erkennen? An ihrem Gruppennamen - dann stuende der deutsche Text
// "Notfall" hier UND in der Vorlage, und wer ihn dort umbenennt, faerbt
// diesen Abschnitt still nicht mehr ein. Die Datei ist die Angabe, die
// beide Seiten ohnehin schon kennen: keybinds.OVERVIEW_CONFIGS nennt
// sie, und tests/src/test_keybinds.py haelt beide zusammen.
const FAILSAFE_SOURCE = "hyprland-failsafe.conf"

interface Shortcut {
  chord: string
  description: string
  run: string
  source: string
}

interface Group {
  group: string
  bindings: Shortcut[]
}


// Die Tastenbelegung dieser Sitzung, aus der einen Quelle.
//
// Ein Fehlschlag kostet den Inhalt und nicht das Fenster: der Kopf mit
// dem Schliessknopf steht schon, und ein leeres Fenster, das sich nicht
// mehr schliessen laesst, ist schlimmer als eines, das sagt, dass es
// nichts lesen konnte.
function loadGroups(): Promise<Group[]> {
  return execAsync(["python3", KEYBIND_READER, "--json"])
    .then((output) => JSON.parse(output) as Group[])
    .catch(() => [])
}

// Create a shortcut row
function createShortcutRow(shortcut: Shortcut): Gtk.Box {
  const row = new Gtk.Box({ spacing: 8 })
  row.add_css_class("sc-row")

  const keyLabel = new Gtk.Label({ label: shortcut.chord, xalign: 0 })
  keyLabel.add_css_class("sc-key")
  keyLabel.set_size_request(160, -1)

  const descLabel = new Gtk.Label({
    label: shortcut.description, xalign: 0, hexpand: true,
  })
  descLabel.add_css_class("sc-desc")

  row.append(keyLabel)
  row.append(descLabel)

  return row
}

// Create a category section
//
// Ob eine Gruppe die Warnfarbe traegt, entscheidet ihr NAME und keine
// Eigenschaft daneben: die Gruppen kommen aus der Konfiguration, also
// gibt es dort kein Feld, in das jemand "isEmergency" schreiben koennte.
// Die Notfalltasten heissen dort "Notfall", und das ist die Angabe.
function createCategory(group: Group): Gtk.Box {
  const emergency = group.bindings.some((b) => b.source === FAILSAFE_SOURCE)

  const catBox = new Gtk.Box({
    orientation: Gtk.Orientation.VERTICAL,
    spacing: 2,
  })
  catBox.add_css_class("sc-category")
  if (emergency) {
    catBox.add_css_class("sc-emergency")
  }

  const titleLabel = new Gtk.Label({
    label: emergency ? `${ICONS.warning} ${group.group}` : group.group,
    xalign: 0,
  })
  titleLabel.add_css_class("sc-title")
  if (emergency) {
    titleLabel.add_css_class("sc-title-warn")
  }

  catBox.append(titleLabel)

  const grid = new Gtk.Box({
    orientation: Gtk.Orientation.VERTICAL,
    spacing: 1,
  })
  grid.add_css_class("sc-grid")

  for (const shortcut of group.bindings) {
    grid.append(createShortcutRow(shortcut))
  }

  catBox.append(grid)

  return catBox
}

// Die Gruppen auf die Spalten verteilen, nach ZEILEN und nicht nach
// Anzahl: eine Spalte mit "Arbeitsflaechen" (20 Zeilen) neben einer mit
// "Maus" (4) ist derselbe Fehler wie eine feste Zuordnung, nur
// unabsichtlich. Gefuellt wird der Reihe nach, damit die Reihenfolge der
// Konfiguration lesbar bleibt.
function intoColumns(groups: Group[]): Group[][] {
  const columns: Group[][] = []
  for (let index = 0; index < COLUMNS; index++) columns.push([])
  if (groups.length === 0) return columns

  const rows = groups.reduce((sum, g) => sum + g.bindings.length + 1, 0)
  const budget = Math.ceil(rows / COLUMNS)

  let column = 0
  let used = 0
  for (const group of groups) {
    const needs = group.bindings.length + 1
    if (used && used + needs > budget && column < COLUMNS - 1) {
      column += 1
      used = 0
    }
    columns[column].push(group)
    used += needs
  }
  return columns
}

// Open keybinds editor
function openEditor(closeWindow: () => void) {
  // Seeded from the package on first use. On a fresh install the user
  // template does not exist yet, and opening it straight away hands the
  // editor an empty buffer. Saving that would create an override which
  // WINS over the packaged template - the next generation would then
  // write a nearly empty hyprland.conf and take the session with it.
  //
  // cp -n never overwrites, so a template the user has already edited is
  // left alone. The copy and the editor share one shell invocation
  // because they have to happen in that order.
  const userTemplate = `${ZEPOS_USER_ROOT}/templates/${KEYBIND_TEMPLATE}`
  const systemTemplate = `${ZEPOS_SYSTEM_ROOT}/templates/${KEYBIND_TEMPLATE}`
  execAsync([
    "sh", "-c",
    `mkdir -p "${ZEPOS_USER_ROOT}/templates" && ` +
    `cp -n "${systemTemplate}" "${userTemplate}" 2>/dev/null; ` +
    `exec ${EDITOR} "${userTemplate}"`,
  ])
  closeWindow()
}

export default function Shortcuts(): OverlayWidget {
  // Die Spaltenleiste liegt ausserhalb von buildContent, weil onShow sie
  // wieder erreichen muss. Ohne das waere die Liste die vom ersten
  // Oeffnen, fuer den Rest der Sitzung.
  const columnsBox = new Gtk.Box({ spacing: 12, homogeneous: true })
  columnsBox.add_css_class("shortcuts-columns")

  function refill() {
    let child = columnsBox.get_first_child()
    while (child) {
      const next = child.get_next_sibling()
      columnsBox.remove(child)
      child = next
    }
    loadGroups().then((groups) => {
      for (const column of intoColumns(groups)) {
        const box = new Gtk.Box({
          orientation: Gtk.Orientation.VERTICAL,
          spacing: 8,
        })
        box.add_css_class("shortcuts-col")
        for (const group of column) box.append(createCategory(group))
        columnsBox.append(box)
      }
    })
  }

  return createOverlayWindow({
    name: "shortcuts",
    width: WIN_WIDTH,
    height: WIN_HEIGHT,
    cssClass: "Shortcuts",
    headerIcon: ICONS.keyboard,
    headerTitle: _("Keyboard shortcuts"),
    accentCssClass: "shortcuts-accent",
    onShow: refill,
    buildContent: (_win, closeWindow) => {
      const mainBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 6,
      })
      mainBox.add_css_class("shortcuts-container")

      // ===== SCROLLABLE CONTENT =====
      const scroll = new Gtk.ScrolledWindow({
        hscrollbar_policy: Gtk.PolicyType.NEVER,
        vscrollbar_policy: Gtk.PolicyType.AUTOMATIC,
        vexpand: true,
      })
      scroll.add_css_class("shortcuts-scroll")
      scroll.set_child(columnsBox)

      // ===== FOOTER =====
      const footerBox = new Gtk.Box({ spacing: 8 })
      footerBox.add_css_class("sc-footer")

      const footerSpacer = new Gtk.Box({ hexpand: true })

      // zepButton, Rolle "voll" (Task A, 18.08.2026): der einzige Knopf
      // dieses Fensters ist damit per Definition seine Hauptsache.
      const editBtn = zepButton("", "voll", () => openEditor(closeWindow))

      const editBtnBox = new Gtk.Box({ spacing: 6 })
      const editIcon = new Gtk.Label({ label: ICONS.edit })
      editIcon.add_css_class("sc-edit-icon")
      const editLabel = new Gtk.Label({ label: _("Edit keybinds") })
      editLabel.add_css_class("sc-edit-label")

      editBtnBox.append(editIcon)
      editBtnBox.append(editLabel)
      editBtn.set_child(editBtnBox)

      footerBox.append(footerSpacer)
      footerBox.append(editBtn)

      // ===== ASSEMBLE =====
      mainBox.append(scroll)
      mainBox.append(footerBox)

      // Beim Bauen schon einmal fuellen. onShow kommt erst beim
      // Oeffnen, und createOverlayWindow baut den Inhalt vorher.
      refill()

      return mainBox
    },
  })
}
