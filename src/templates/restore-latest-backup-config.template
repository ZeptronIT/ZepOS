#!/bin/bash
# =========================================
# RESTORE LATEST BACKUP SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/restore-latest-backup-config.template
# =========================================
#
# This script finds and restores the latest backup of a config file
# =========================================

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Where the generator put the files this tool undoes.
#
# The same rule generate_config.sh uses for ZEPOS_OUTPUT_ROOT, spelled
# the same way: hypr, ags and kitty read their configuration from
# XDG_CONFIG_HOME and the generator writes it there, so a restore tool
# that looked anywhere else would offer to restore a file nobody reads.
#
# It used to be the author's own home directory, written out three times
# in the usage text and three more in the case below. On every other
# machine the tool answered "Config file not found" and exited 1 - with
# a perfectly good backup sitting next to the file it had named.
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

HYPRLAND_CONFIG="$CONFIG_HOME/hypr/hyprland.conf"
BAR_CONFIG="$CONFIG_HOME/ags/bar.css"
KITTY_CONFIG="$CONFIG_HOME/kitty/kitty.conf"

# Function to show usage
show_usage() {
    echo "Usage: $0 <config-name>"
    echo ""
    echo "Available configs:"
    echo "  hyprland    - Restore $HYPRLAND_CONFIG"
    echo "  bar         - Restore $BAR_CONFIG"
    echo "  kitty       - Restore $KITTY_CONFIG"
    echo ""
    echo "Example: $0 hyprland"
}

# Check if argument provided
if [ $# -eq 0 ]; then
    show_usage
    exit 1
fi

# Determine config path based on argument
case "$1" in
    hyprland)
        CONFIG_PATH="$HYPRLAND_CONFIG"
        ;;
    bar)
        CONFIG_PATH="$BAR_CONFIG"
        ;;
    kitty)
        CONFIG_PATH="$KITTY_CONFIG"
        ;;
    *)
        echo -e "${RED}{{ICON_ERROR}} Unknown config: $1${NC}"
        show_usage
        exit 1
        ;;
esac

# Check if config file exists
if [ ! -f "$CONFIG_PATH" ]; then
    echo -e "${RED}{{ICON_ERROR}} Config file not found: $CONFIG_PATH${NC}"
    exit 1
fi

# Find latest backup
BACKUP_DIR=$(dirname "$CONFIG_PATH")
CONFIG_NAME=$(basename "$CONFIG_PATH")
LATEST_BACKUP=$(ls -t "$BACKUP_DIR"/"$CONFIG_NAME".backup.* 2>/dev/null | head -1)

if [ -z "$LATEST_BACKUP" ]; then
    echo -e "${RED}{{ICON_ERROR}} No backups found for $CONFIG_NAME${NC}"
    exit 1
fi

echo -e "${YELLOW}{{ICON_INFO}} Found latest backup:${NC}"
echo "  $LATEST_BACKUP"
echo "  Created: $(stat -c '%y' "$LATEST_BACKUP" | cut -d'.' -f1)"
echo ""

# Show diff
echo -e "${YELLOW}{{ICON_SEARCH}} Differences between current and backup:${NC}"
diff --color=always -u "$CONFIG_PATH" "$LATEST_BACKUP" | head -50
echo ""

# Ask for confirmation
read -p "$(echo -e "${YELLOW}{{ICON_QUESTION}} Restore this backup? [y/N]:${NC} ")" -n 1 -r
echo ""

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}{{ICON_CANCEL}} Restore cancelled${NC}"
    exit 0
fi

# Create backup of current file
TIMESTAMP=$(date +"%Y-%m-%d-%H%M%S")
SAFETY_BACKUP="${CONFIG_PATH}.before-restore.${TIMESTAMP}"
cp "$CONFIG_PATH" "$SAFETY_BACKUP"
echo -e "${GREEN}{{ICON_CHECK}} Created safety backup: $SAFETY_BACKUP${NC}"

# Restore the backup
cp "$LATEST_BACKUP" "$CONFIG_PATH"
echo -e "${GREEN}{{ICON_CHECK}} Restored: $LATEST_BACKUP → $CONFIG_PATH${NC}"

# Reload services if needed
case "$1" in
    hyprland)
        echo -e "${YELLOW}{{ICON_RELOAD}} Reloading Hyprland...${NC}"
        hyprctl reload
        ;;
    bar)
        # Kein Neustart, sondern ein Nachladen des Stylesheets im
        # laufenden Prozess.
        #
        # Hier stand `pkill waybar; nohup waybar`. Die Leiste ist jetzt
        # Teil von AGS, und AGS traegt ausserdem die elf
        # Ueberlagerungsfenster und den Benachrichtigungsdienst - ein
        # pkill darauf, um eine Farbe zurueckzunehmen, naehme dem Nutzer
        # den halben Schreibtisch mit. `ags request` erreicht denselben
        # Prozess ueber seinen Socket und laesst ihn selbst nachladen.
        echo -e "${YELLOW}{{ICON_RELOAD}} Leistenstil neu laden...${NC}"
        if ags request reload-bar-style >/dev/null 2>&1; then
            echo -e "${GREEN}{{ICON_CHECK}} Leistenstil neu geladen${NC}"
        else
            echo -e "${YELLOW}{{ICON_INFO}} AGS laeuft nicht - der Stil gilt ab dem naechsten Start${NC}"
        fi
        ;;
esac

echo -e "${GREEN}{{ICON_CHECK}} Restore complete!${NC}"