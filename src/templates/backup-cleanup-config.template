#!/bin/bash
# Backup Cleanup Script
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/backup-cleanup-config.template
#
# WHAT THIS CLEANS UP, AND WHY IT IS NOT THE WHOLE MACHINE
#
# The backups this tool exists for are made by one program:
# validate_output.py copies a file to "<file>.backup.<date>" beside
# itself every time the generator replaces it, and restore-latest-backup
# reads the newest of those back. So the files are always next to a
# config ZepOS wrote, and there is one series of them PER FILE.
#
# This script used to search from "/" by default and keep the single
# newest backup on the entire machine. Both halves were wrong:
#
#   * "/" is every filesystem the account can read. "*.backup.*" is not a
#     name ZepOS owns - editors, package managers and other people's
#     scripts write it too - and this offered to delete all of them,
#     while walking mounted disks and network shares to find them.
#   * keeping ONE backup total means the newest file wins and every other
#     config loses the only copy it had. The tool that reads these takes
#     the newest backup OF THE FILE it is restoring; after a run of the
#     old version, restore-latest-backup could answer "no backups found"
#     for every config but one.
#
# So: the search roots are the places the generator publishes into, and
# the newest backup of EVERY file is kept. What is deleted is the older
# generations of a file that already has a newer one - the copies nothing
# can reach any more.
#
# A directory given as an argument is still searched instead, whole and
# without a depth limit. That is an explicit instruction and stays one.

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
ZEPOS_USER_ROOT="${ZEPOS_USER_ROOT:-$CONFIG_HOME/zepos}"

# Where to look, as "<maxdepth>|<directory>" - 0 meaning no limit.
#
# The depth is part of the entry because $HOME itself carries generated
# files (~/.zshrc, and so a ~/.zshrc.backup.<date> beside it) while
# everything BELOW $HOME is the user's own. Searching $HOME whole would
# be the systemwide sweep again with one directory shaved off it.
SEARCH_ROOTS=()
if [ $# -gt 0 ]; then
    for ARGUMENT in "$@"; do
        SEARCH_ROOTS+=("0|$ARGUMENT")
    done
else
    SEARCH_ROOTS+=("1|$HOME")
    SEARCH_ROOTS+=("0|$CONFIG_HOME")
    SEARCH_ROOTS+=("0|$ZEPOS_USER_ROOT")
    SEARCH_ROOTS+=("0|$HOME/.local/bin")
    SEARCH_ROOTS+=("0|$HOME/.local/share/applications")
    SEARCH_ROOTS+=("0|$HOME/.local/share/color-schemes")
fi

echo -e "${YELLOW}{{ICON_TRASH}} === Backup Cleanup Script ===${NC}"
echo -e "Searching in:"
for ENTRY in "${SEARCH_ROOTS[@]}"; do
    DEPTH="${ENTRY%%|*}"
    DIRECTORY="${ENTRY#*|}"
    if [ "$DEPTH" = "1" ]; then
        echo -e "  ${GREEN}$DIRECTORY${NC} (only this directory)"
    else
        echo -e "  ${GREEN}$DIRECTORY${NC}"
    fi
done
echo ""

# Find and sort backups, newest first (permission errors to /dev/null).
#
# Separated by a NUL byte rather than a newline, and collected into an
# array rather than into one string. A file name may contain a space -
# and every stage of the previous pipeline split on one. Measured on
# "dir one/My Config.conf.backup.20260101": `cut -d' ' -f2- | xargs rm -f`
# handed `rm` three fragments, none of which is a file, so the backup was
# STILL THERE while the script printed "Done! Deleted 1 backups." The
# fragments were relative paths too, and with the search starting at /
# they were resolved against whatever directory the user happened to
# stand in - `rm -f` aimed at names nobody chose.
find_backups() {
    local entry depth directory
    for entry in "${SEARCH_ROOTS[@]}"; do
        depth="${entry%%|*}"
        directory="${entry#*|}"
        [ -d "$directory" ] || continue
        if [ "$depth" = "0" ]; then
            find "$directory" -name "*.backup.*" -type f \
                 -printf '%T@\t%p\0' 2>/dev/null
        else
            find "$directory" -maxdepth "$depth" -name "*.backup.*" -type f \
                 -printf '%T@\t%p\0' 2>/dev/null
        fi
    done
}

# The newest backup of each file, and every older one.
#
# The key is the path with the ".backup.<date>" cut off, which is the
# file the backup was taken FROM - the same thing restore-latest-backup
# globs for when it looks for "<file>.backup.*". Shortest-suffix removal,
# so a backup of a backup belongs to the backup it was taken from.
declare -A SEEN_PATH=()
declare -A NEWEST_OF=()
KEEP=()
DELETE=()

while IFS= read -r -d '' ENTRY; do
    # %T@ carries no tab, so cutting at the FIRST one leaves the path
    # whole however many tabs or spaces it contains itself.
    BACKUP="${ENTRY#*$'\t'}"
    # Two search roots may contain one another - ZEPOS_USER_ROOT normally
    # sits inside CONFIG_HOME - so the same file arrives twice. Counted
    # once, or the second copy would be "an older generation of itself"
    # and get deleted.
    [ -n "${SEEN_PATH[$BACKUP]+set}" ] && continue
    SEEN_PATH[$BACKUP]=1

    ORIGINAL="${BACKUP%.backup.*}"
    if [ -z "${NEWEST_OF[$ORIGINAL]+set}" ]; then
        NEWEST_OF[$ORIGINAL]=$BACKUP
        KEEP+=("$BACKUP")
    else
        DELETE+=("$BACKUP")
    fi
done < <(find_backups | sort -z -nr)

TOTAL=$(( ${#KEEP[@]} + ${#DELETE[@]} ))

if [ "$TOTAL" -eq 0 ]; then
    echo -e "${RED}{{ICON_ALERT}} No backup files found.${NC}"
    exit 0
fi

echo -e "${GREEN}{{ICON_FILE}} Found $TOTAL backup files${NC}\n"

# Group by directory
echo -e "${YELLOW}{{ICON_FOLDER}} Backups by directory:${NC}"
for BACKUP in "${KEEP[@]}" "${DELETE[@]}"; do
    DIRECTORY="${BACKUP%/*}"
    # A file directly below / has nothing left once its name is cut off.
    [ -n "$DIRECTORY" ] || DIRECTORY="/"
    printf '%s\n' "$DIRECTORY"
done | sort | uniq -c

# Show what is kept
echo -e "\n${GREEN}{{ICON_SAVE}} [KEEP]${NC} Newest backup of each file (${#KEEP[@]}):"
for BACKUP in "${KEEP[@]}"; do
    printf '  %s\n' "$BACKUP"
done

# Show old ones
if [ ${#DELETE[@]} -gt 0 ]; then
    echo -e "\n${RED}{{ICON_DELETE}} ${#DELETE[@]} older backups will be deleted${NC}"
    for BACKUP in "${DELETE[@]}"; do
        printf '  %s\n' "$BACKUP"
    done

    echo -e "\n${YELLOW}{{ICON_QUESTION}} Delete these ${#DELETE[@]} older backups? [y/N]${NC}"
    read -r CONFIRM

    if [[ "$CONFIRM" =~ ^[yY]$ ]]; then
        echo -e "\n${YELLOW}{{ICON_SPINNER}} Deleting...${NC}"
        # Counted, not assumed. `rm -f` reports success for a file that
        # was never there, so the only honest count is the one taken
        # afterwards: a cleanup tool that names a number it did not
        # reach is how the previous defect stayed invisible.
        DELETED=0
        for BACKUP in "${DELETE[@]}"; do
            rm -f -- "$BACKUP"
            if [ -e "$BACKUP" ]; then
                echo -e "${RED}{{ICON_ALERT}} Could not delete: $BACKUP${NC}" >&2
            else
                DELETED=$((DELETED + 1))
            fi
        done
        echo -e "${GREEN}{{ICON_CHECK}} Done! Deleted $DELETED backups.${NC}"
    else
        echo -e "${YELLOW}{{ICON_CANCEL}} Cancelled.${NC}"
    fi
else
    echo -e "${GREEN}{{ICON_INFO}} Every file has exactly one backup. Nothing to delete.${NC}"
fi
