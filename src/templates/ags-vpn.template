// the user root is resolved here. GLib.getenv returns null when unset,
// which || turns into the documented default.
const CONFIG_HOME = GLib.getenv("XDG_CONFIG_HOME") || `${HOME}/.config`
const ZEPOS_USER_ROOT = GLib.getenv("ZEPOS_USER_ROOT") || `${CONFIG_HOME}/zepos`

const ICONS = {
  vpn: "{{ICON_VPN_CONNECTED}}",
  vpnOff: "{{ICON_VPN_DISCONNECTED}}",
  vpnError: "{{ICON_VPN_ERROR}}",
  eye: "{{ICON_EYE}}",
  eyeSlash: "{{ICON_EYE_SLASH}}",
  settings: "{{ICON_SETTINGS}}",
  close: "{{ICON_CLOSE}}",
  check: "{{ICON_CHECK}}",
  server: "{{ICON_SERVER}}",
  user: "{{ICON_USER}}",
  key: "{{ICON_VPNKEY}}",
}

const SCRIPTS = {
  vpnControl: `${HOME}/.config/ags/scripts/vpn-control.sh`,
  vpnConnect: `${HOME}/.config/ags/scripts/vpn-connect.sh`,
  pskFile: `${HOME}/.config/strongswan/psk`,
  lastUserFile: `${HOME}/.config/strongswan/last_user`,
}

// Ob der Tunnel steht und welche Adresse er hat, beantwortet vpn.py -
// aus dem Bericht von strongSwan bzw. aus dem, was das Verbindungsskript
// von dort notiert hat. Dieselbe Auskunft, die auch die Leiste und
// vpn-control.sh benutzen.
//
// Der Pfad wird beim Erzeugen eingesetzt: ein Widget kann nicht wissen,
// wohin das Paket installiert wurde. Als fertige Argumentliste, damit
// genau das, was hier steht, auch ausgefuehrt und geprueft werden kann.
const VPN_STATUS_QUERY = ["python3", "{{ZEPOS_SYSTEM_ROOT}}/vpn.py", "--status"]

// Settings file path
const SETTINGS_FILE = `${ZEPOS_USER_ROOT}/user-settings.json`

// Load VPN settings dynamically from user-settings.json
function loadVpnSettings() {
  try {
    const [ok, contents] = GLib.file_get_contents(SETTINGS_FILE)
    if (ok && contents) {
      const data = JSON.parse(new TextDecoder().decode(contents))
      if (data.vpn) {
        return {
          server: data.vpn.server || "{{STYLE_VPN_SERVER}}",
          username: data.vpn.username || "{{STYLE_VPN_USERNAME}}",
          connection_name: data.vpn.connection_name || "{{STYLE_VPN_CONNECTION_NAME}}",
          debug: data.vpn.debug === true
        }
      }
    }
  } catch (e) {
    console.error("Failed to load VPN settings:", e)
  }
  // Fallback to defaults
  return {
    server: "{{STYLE_VPN_SERVER}}",
    username: "{{STYLE_VPN_USERNAME}}",
    connection_name: "{{STYLE_VPN_CONNECTION_NAME}}",
    debug: false
  }
}

// Dynamic settings (loaded on window open)
let vpnSettings = loadVpnSettings()

interface VpnStatus {
  status: "connected" | "disconnected" | "connecting" | "error" | "stale"
  ip: string | null
  connectionName?: string
  installedChildren?: number
}

// State file written by vpn-connect.sh on a *real* successful connect
// (IKE_SA + at least one CHILD_SA INSTALLED). Disconnect removes it.
// XDG_RUNTIME_DIR is a per-user tmpfs that the session manager wipes,
// so stale state across reboots is impossible.
const VPN_STATE_FILE = `${GLib.get_user_runtime_dir()}/vpn-active`

interface VpnState {
  status?: string
  connection_name?: string
  server?: string
  virtual_ip?: string
  installed_children?: number
  connected_at?: string
}

function readVpnState(): VpnState | null {
  try {
    const [ok, contents] = GLib.file_get_contents(VPN_STATE_FILE)
    if (!ok || !contents) return null
    return JSON.parse(new TextDecoder().decode(contents).trim())
  } catch {
    return null
  }
}

let currentStatus: VpnStatus = { status: "disconnected", ip: null }
let updateTimer: any = null

// UI element references - Connected view
let connectedView: Gtk.Box
let connectedIcon: Gtk.Label
let connectedIpLabel: Gtk.Label
let connectedServerLabel: Gtk.Label
let connectedNameLabel: Gtk.Label
let disconnectBtn: Gtk.Button

// UI element references - Disconnected view (form)
let formView: Gtk.Box
let disconnectedIcon: Gtk.Label
let disconnectedLabel: Gtk.Label
let usernameEntry: Gtk.Entry
let passwordEntry: Gtk.Entry
let tokenEntry: Gtk.Entry
let rememberCheckbox: Gtk.CheckButton
let errorLabel: Gtk.Label
let connectBtn: Gtk.Button

// State
let rememberUsername = true
let isDisconnecting = false

// Load last username
function loadLastUsername(): string {
  try {
    const [ok, contents] = GLib.file_get_contents(SCRIPTS.lastUserFile)
    if (ok && contents) {
      return new TextDecoder().decode(contents).trim()
    }
  } catch (e) {
    // File might not exist yet
  }
  return vpnSettings.username
}

// Save last username
function saveLastUsername(username: string) {
  try {
    GLib.file_set_contents(SCRIPTS.lastUserFile, username)
  } catch (e) {
    console.error("Failed to save last username:", e)
  }
}

// Load PSK from user config file.
//
// Read in this process rather than through `cat`: the file belongs to
// the user, so there is nothing to spawn for, and a home directory whose
// path contains a space would have arrived at cat as two arguments -
// execAsync(string) splits with GLib.shell_parse_argv and starts no
// shell.
function loadPsk(): string {
  try {
    const [ok, contents] = GLib.file_get_contents(SCRIPTS.pskFile)
    if (!ok || !contents) return ""
    return new TextDecoder().decode(contents).trim()
  } catch (e) {
    console.error("Failed to load PSK:", e)
    return ""
  }
}

// Check VPN status.
// Three-state result, decided in vpn.py so that this widget, the bar and
// vpn-control.sh cannot disagree about the same tunnel:
//   - connected: we have a record of this connection, charon still holds it,
//     and the address strongSwan assigned is still on an interface. A tunnel
//     the gateway assigned no address to counts as well — there is then
//     nothing to verify.
//   - stale:     the record without the rest of it. CHILD_SAs collapsed, or an
//     unclean shutdown. UI must surface this instead of falsely showing green.
//   - disconnected: no record.
//
// Dieses Widget suchte hier selbst nach einer Adresse aus dem Pool eines
// bestimmten Gateways. Wer eine andere zugewiesen bekam, sah auf einem
// gesunden Tunnel dauerhaft das rote "VPN unvollständig".
async function getVpnStatus(): Promise<VpnStatus> {
  try {
    const state = readVpnState()

    const answer = await execAsync(VPN_STATUS_QUERY).catch(() => "")
    const [reported, address] = answer.trim().split(/\s+/)

    if (reported === "connected") {
      return {
        status: "connected",
        ip: address ?? state?.virtual_ip ?? null,
        connectionName: state?.connection_name,
        installedChildren: state?.installed_children,
      }
    }
    if (reported === "stale") {
      return {
        status: "stale",
        ip: address ?? state?.virtual_ip ?? null,
        connectionName: state?.connection_name,
        installedChildren: state?.installed_children,
      }
    }
    // Auch das, was ein leerer oder unlesbarer Bericht heisst: ohne
    // Auskunft wird nichts behauptet.
    return { status: "disconnected", ip: null }
  } catch {
    return { status: "disconnected", ip: null }
  }
}

// Update status display - toggles between connected view and form view
async function updateStatusDisplay() {
  currentStatus = await getVpnStatus()

  if (currentStatus.status === "connected") {
    // Show centered connected view, hide form
    connectedIcon.set_text(ICONS.vpn)
    connectedIcon.remove_css_class("disconnected")
    connectedIcon.remove_css_class("connecting")
    connectedIcon.remove_css_class("error")
    connectedIcon.add_css_class("connected")
    // Aus Template-Literalen zu format() geworden: xgettext liest eine
    // Zeichenkette mit ${...} gar nicht aus, diese drei Zeilen bekaemen
    // also keinen Katalogeintrag und blieben still deutsch. Benannte
    // Platzhalter erlauben der Uebersetzung ausserdem eine andere
    // Reihenfolge. 17.08.2026
    connectedIpLabel.set_text(format(_("IP: {ip}"), { ip: String(currentStatus.ip) }))
    connectedServerLabel.set_text(format(_("Server: {server}"), { server: vpnSettings.server }))
    connectedNameLabel.set_text(format(_("Connection: {connection}"), { connection: currentStatus.connectionName ?? vpnSettings.connection_name }))
    if (!isDisconnecting) {
      disconnectBtn.set_child(new Gtk.Label({ label: _("Disconnect") }))
      disconnectBtn.set_sensitive(true)
    }
    connectedView.set_visible(true)
    formView.set_visible(false)
  } else if (currentStatus.status === "stale") {
    // Tunnel half-up: charon may be running but CHILD_SAs are down OR state
    // file says connected while charon/IP have vanished. Show the connect
    // form so the user can reconnect — but mark the icon as "error" so this
    // isn't mistaken for a normal disconnected state.
    disconnectedIcon.set_text(ICONS.vpnOff)
    disconnectedIcon.remove_css_class("connected")
    disconnectedIcon.remove_css_class("connecting")
    disconnectedIcon.remove_css_class("disconnected")
    disconnectedIcon.add_css_class("error")
    disconnectedLabel.set_text(_("VPN incomplete – please reconnect"))
    connectBtn.set_sensitive(true)
    connectedView.set_visible(false)
    formView.set_visible(true)
  } else {
    // Show form view, hide connected view
    disconnectedIcon.set_text(ICONS.vpnOff)
    disconnectedIcon.remove_css_class("connected")
    disconnectedIcon.remove_css_class("connecting")
    disconnectedIcon.remove_css_class("error")
    disconnectedIcon.add_css_class("disconnected")
    disconnectedLabel.set_text(_("Not connected"))
    connectBtn.set_sensitive(true)
    connectedView.set_visible(false)
    formView.set_visible(true)
  }
}

// Toggle password visibility
function togglePasswordVisibility(entry: Gtk.Entry, btn: Gtk.Button, isPassword: boolean) {
  const visible = entry.get_visibility()
  entry.set_visibility(!visible)
  btn.set_child(new Gtk.Label({ label: visible ? ICONS.eye : ICONS.eyeSlash }))
}

// ============================================================================
// MAIN WIDGET
// ============================================================================
export default function VpnManager(): OverlayWidget {
  let closeFn: (() => void) | null = null

  // Connect to VPN
  async function connectVpn() {
    const username = usernameEntry.get_text()
    const password = passwordEntry.get_text()
    const token = tokenEntry.get_text()

    // Validation
    if (!username) {
      errorLabel.set_text(_("Username required"))
      return
    }
    if (!password) {
      errorLabel.set_text(_("Password required"))
      return
    }
    // 2FA Token ist optional - wenn leer, wird nur Passwort verwendet

    // Load PSK from user config file
    const psk = loadPsk()
    if (!psk) {
      errorLabel.set_text(_("PSK not found! Please save it in the VPN settings."))
      // Open settings
      openVpnSettings()
      return
    }

    errorLabel.set_text("")

    // Save username if checkbox is checked
    if (rememberUsername) {
      saveLastUsername(username)
    }

    // Update status to connecting
    disconnectedIcon.set_text(ICONS.vpn)
    disconnectedIcon.remove_css_class("connected")
    disconnectedIcon.remove_css_class("disconnected")
    disconnectedIcon.remove_css_class("error")
    disconnectedIcon.add_css_class("connecting")
    disconnectedLabel.set_text(_("Connecting ..."))
    connectBtn.set_sensitive(false)

    // Das Protokoll liegt auf dem tmpfs des Benutzers, nicht in /tmp -
    // an derselben Stelle, an die vpn-control.sh seines schreibt. Es
    // trägt den Benutzernamen, sein Name war aus dem Datum vorhersagbar,
    // und /tmp kann jedes Konto der Maschine lesen. Das Verzeichnis
    // gehört nur dem Benutzer und wird beim Abmelden geleert.
    const runtimeDir = `${GLib.get_user_runtime_dir()}/zepos-vpn`
    GLib.mkdir_with_parents(runtimeDir, 0o700)
    const stamp = new Date().toISOString().slice(0, 10).replace(/-/g, "")
    const logFile = `${runtimeDir}/vpn-control-${stamp}.log`

    // Jeder Wert als eigenes Argument, nie in einen Befehlstext gesetzt.
    //
    // execAsync(string) zerlegt mit GLib.shell_parse_argv und startet
    // KEINE Shell - hier stand aber ein von Hand zusammengesetztes
    // `bash -c '...'`, und darin war jedes eingesetzte Zeichen Programm.
    // Ein Passwort wie `p"; id > /tmp/pwned; #` lief als Befehl, in
    // genau dem Ablauf, der die Zugangsdaten in der Hand hat.
    //
    // Der dritte Platz bleibt leer: dort stand das Sudo-Passwort, das
    // vpn-connect.sh nicht mehr liest. vpn-control.sh übergibt ihn
    // ebenso leer.
    const connectArgv = [
      SCRIPTS.vpnConnect, username, password, "", token, psk,
      vpnSettings.connection_name, logFile,
    ]

    try {
      if (vpnSettings.debug) {
        // Debug mode: open terminal with connect script output
        await execAsync([
          "kitty", "--class=vpn-connection",
          "--title=VPN Connection Progress",
          "-o", "remember_window_size=no",
          "-o", "initial_window_width=120",
          "-o", "initial_window_height=40",
          "--hold",
          "-e", ...connectArgv,
        ])
      } else {
        // Silent mode: run connect script in background.
        //
        // Die einzige Stelle, die eine Shell braucht - für die
        // Umleitung. Ihr Programmtext ist eine Konstante; alles
        // Veränderliche steht als Argument dahinter. `umask 077`, weil
        // die Umleitung die Datei anlegt, bevor vpn-connect.sh sein
        // eigenes umask setzen kann, und sie den Benutzernamen trägt.
        await execAsync([
          "bash", "-c",
          'umask 077; detail="$1"; shift; exec "$@" >> "$detail" 2>&1',
          "zepos-vpn-connect", `${logFile}.detail`, ...connectArgv,
        ])
      }

      // Clear sensitive fields
      passwordEntry.set_text("")
      tokenEntry.set_text("")

      // Hide overlay
      closeFn?.()

      // Check status after a delay
      setTimeout(async () => {
        await updateStatusDisplay()
      }, 5000)
    } catch (e) {
      console.error("Failed to connect:", e)
      errorLabel.set_text(_("Connection failed"))
      disconnectedIcon.add_css_class("error")
      disconnectedIcon.remove_css_class("connecting")
      connectBtn.set_sensitive(true)
    }
  }

  // Disconnect VPN
  async function disconnectVpn() {
    if (isDisconnecting) return
    isDisconnecting = true

    // Show spinner in disconnect button
    const spinnerBox = new Gtk.Box({ spacing: 8, halign: Gtk.Align.CENTER })
    const spinner = new Gtk.Spinner({ spinning: true })
    spinner.set_size_request(16, 16)
    const spinnerLabel = new Gtk.Label({ label: _("Disconnecting ...") })
    spinnerBox.append(spinner)
    spinnerBox.append(spinnerLabel)
    disconnectBtn.set_child(spinnerBox)
    disconnectBtn.set_sensitive(false)

    connectedIcon.remove_css_class("connected")
    connectedIcon.add_css_class("connecting")

    // Pause status timer during disconnect to prevent race conditions
    if (updateTimer) {
      clearInterval(updateTimer)
      updateTimer = null
    }

    try {
      // As an argument list: execAsync(string) splits with
      // GLib.shell_parse_argv, so a home directory whose path contains a
      // space would arrive as two arguments.
      await execAsync([SCRIPTS.vpnControl, "disconnect"])
      await updateStatusDisplay()
    } catch (e) {
      console.error("Failed to disconnect:", e)
      connectedIcon.remove_css_class("connecting")
      connectedIcon.add_css_class("error")
      // Restore button label
      disconnectBtn.set_child(new Gtk.Label({ label: _("Disconnect") }))
      disconnectBtn.set_sensitive(true)
    } finally {
      isDisconnecting = false
      // Restart status timer
      if (!updateTimer) {
        updateTimer = setInterval(updateStatusDisplay, UPDATE_INTERVAL)
      }
    }
  }

  // Open VPN Settings
  function openVpnSettings() {
    execAsync("ags request vpn-settings")
    closeFn?.()
  }

  return createOverlayWindow({
    name: "vpn",
    width: WIN_WIDTH,
    height: 520,
    cssClass: "VpnManager",
    headerIcon: ICONS.vpn,
    headerTitle: _("VPN connection"),
    accentCssClass: "vpn-accent",
    onShow: () => {
      // ALWAYS reset button sensitivity on show (in case of Ctrl+C etc.)
      connectBtn.set_sensitive(true)
      disconnectBtn.set_sensitive(true)

      // Reload settings from file
      vpnSettings = loadVpnSettings()

      // Update status display (toggles between connected/disconnected view)
      updateStatusDisplay()

      // Pre-fill username for disconnected form
      const lastUser = loadLastUsername()
      usernameEntry.set_text(lastUser || vpnSettings.username)

      // Focus password field if username is pre-filled (only matters when form is visible)
      if (lastUser) {
        passwordEntry.grab_focus()
      } else {
        usernameEntry.grab_focus()
      }

      // Start update timer
      if (updateTimer) clearInterval(updateTimer)
      updateTimer = setInterval(updateStatusDisplay, UPDATE_INTERVAL)
    },
    onHide: () => {
      if (updateTimer) {
        clearInterval(updateTimer)
        updateTimer = null
      }
    },
    buildContent: (_win, closeWindow) => {
      closeFn = closeWindow

      // Main container
      const mainBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
      mainBox.add_css_class("vpn-container")

      // ================================================================
      // CONNECTED VIEW - Centered status display
      // ================================================================
      connectedView = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 16,
        halign: Gtk.Align.CENTER,
        valign: Gtk.Align.CENTER,
        vexpand: true,
        visible: false,
      })
      connectedView.add_css_class("vpn-connected-view")

      // Large centered icon
      connectedIcon = new Gtk.Label({ label: ICONS.vpn })
      connectedIcon.add_css_class("vpn-connected-icon")
      connectedIcon.add_css_class("connected")

      // Status text "Verbunden"
      const connectedStatusLabel = new Gtk.Label({ label: _("Connected") })
      connectedStatusLabel.add_css_class("vpn-connected-status")

      // Info group
      const connectedInfoBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4, halign: Gtk.Align.CENTER })
      connectedInfoBox.add_css_class("vpn-connected-info")

      // Derselbe msgid wie in updateStatusDisplay(), nur mit dem Strich
      // als Wert: ein eigener Eintrag "IP: --" waere derselbe Satz ein
      // zweites Mal im Katalog. 17.08.2026
      connectedIpLabel = new Gtk.Label({ label: format(_("IP: {ip}"), { ip: "--" }) })
      connectedIpLabel.add_css_class("vpn-connected-detail")

      connectedServerLabel = new Gtk.Label({ label: format(_("Server: {server}"), { server: vpnSettings.server }) })
      connectedServerLabel.add_css_class("vpn-connected-detail")

      connectedNameLabel = new Gtk.Label({ label: format(_("Connection: {connection}"), { connection: vpnSettings.connection_name }) })
      connectedNameLabel.add_css_class("vpn-connected-detail")

      connectedInfoBox.append(connectedIpLabel)
      connectedInfoBox.append(connectedServerLabel)
      connectedInfoBox.append(connectedNameLabel)

      // Disconnect button (full width). Rolle kritisch: Trennen ist
      // zerstoerend (dieselbe Einordnung wie net-disconnect-btn, Task C).
      disconnectBtn = zepButton(_("Disconnect"), "kritisch", disconnectVpn)
      disconnectBtn.add_css_class("vpn-disconnect-full")

      // Settings button. Rolle still: oeffnet ein anderes Fenster, reine
      // Navigation (dieselbe Einordnung wie netBtn/vpnBtn, Task D).
      const connectedSettingsBtn = zepButton(ICONS.settings, "still", openVpnSettings)

      connectedView.append(connectedIcon)
      connectedView.append(connectedStatusLabel)
      connectedView.append(connectedInfoBox)
      connectedView.append(disconnectBtn)
      connectedView.append(connectedSettingsBtn)

      // ================================================================
      // DISCONNECTED VIEW - Form for connecting
      // ================================================================
      formView = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })

      // Small status indicator
      const statusBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
      statusBox.add_css_class("vpn-status")

      const statusRow = new Gtk.Box({ spacing: 12 })
      statusRow.add_css_class("vpn-status-row")

      disconnectedIcon = new Gtk.Label({ label: ICONS.vpnOff })
      disconnectedIcon.add_css_class("vpn-status-icon")
      disconnectedIcon.add_css_class("disconnected")

      disconnectedLabel = new Gtk.Label({ label: _("Not connected"), xalign: 0 })
      disconnectedLabel.add_css_class("vpn-status-label")

      const formSettingsBtn = zepButton(ICONS.settings, "still", openVpnSettings)

      statusRow.append(disconnectedIcon)
      statusRow.append(disconnectedLabel)
      statusRow.append(new Gtk.Box({ hexpand: true }))
      statusRow.append(formSettingsBtn)
      statusBox.append(statusRow)

      // Form section
      const formBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
      formBox.add_css_class("vpn-form")

      // Username field
      const usernameField = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
      usernameField.add_css_class("vpn-field")

      const usernameLabel = new Gtk.Label({ label: _("Username"), xalign: 0 })
      usernameLabel.add_css_class("vpn-field-label")

      const usernameRow = new Gtk.Box({ spacing: 0 })
      usernameRow.add_css_class("vpn-entry-row")

      usernameEntry = new Gtk.Entry({ hexpand: true, placeholder_text: _("Username ...") })
      usernameEntry.add_css_class("vpn-entry")

      usernameRow.append(usernameEntry)
      usernameField.append(usernameLabel)
      usernameField.append(usernameRow)

      // Password field
      const passwordField = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
      passwordField.add_css_class("vpn-field")

      const passwordLabel = new Gtk.Label({ label: _("Password"), xalign: 0 })
      passwordLabel.add_css_class("vpn-field-label")

      const passwordRow = new Gtk.Box({ spacing: 0 })
      passwordRow.add_css_class("vpn-entry-row")

      passwordEntry = new Gtk.Entry({ hexpand: true, visibility: false, placeholder_text: _("Password ...") })
      passwordEntry.add_css_class("vpn-entry")

      // Rolle still: ein Zeichen-Knopf am Rand der Eingabezeile, kein
      // Hauptweg (dieselbe Einordnung wie se-edit-btn/notif-close-btn) -
      // GEPRUEFT (18.08.2026): .vpn-entry-row hat keine eigene Hoehe, sie
      // haengt am groessten Kind. .vpn-entry traegt STYLE_SPACE_12 oben/
      // unten (18px, aufgeloest mit dem ausgelieferten Faktor 1.85) plus
      // Textzeile (STYLE_FONT_BODY 20px, Zeilenhoehe 1.2 ~ 24px) ~ 60px
      // Grundhoehe - groesser als zep-btns min-height (STYLE_CONTROL_HEIGHT,
      // 49px). Die Zeile bleibt also von .vpn-entry bestimmt, nicht vom
      // Knopf; anders als bei overlay-close-btn keine harte Massvorgabe,
      // die zep-btn unterlaeuft.
      const passwordVisBtn = zepButton(ICONS.eye, "still",
        () => togglePasswordVisibility(passwordEntry, passwordVisBtn, true))

      passwordRow.append(passwordEntry)
      passwordRow.append(passwordVisBtn)
      passwordField.append(passwordLabel)
      passwordField.append(passwordRow)

      // There is no sudo password field, and there must not be one
      // again. Nothing reads it: the privileged commands are granted by
      // /etc/sudoers.d/zepos, so `sudo -n` runs them without a password
      // - which is also the only thing that works for the watcher, which
      // has no terminal to ask at. Collecting it anyway meant handing a
      // login password to the connect script as an argument, and
      // /proc/<pid>/cmdline is world-readable for as long as the
      // connection takes. vpn-control.sh stopped asking for it first;
      // this is the other caller.

      // Token field
      const tokenField = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
      tokenField.add_css_class("vpn-field")

      const tokenLabel = new Gtk.Label({ label: _("2FA token (optional)"), xalign: 0 })
      tokenLabel.add_css_class("vpn-field-label")

      const tokenRow = new Gtk.Box({ spacing: 0 })
      tokenRow.add_css_class("vpn-entry-row")

      tokenEntry = new Gtk.Entry({ hexpand: true, placeholder_text: _("6-digit code ..."), max_length: 8 })
      tokenEntry.add_css_class("vpn-entry")
      tokenEntry.connect("activate", connectVpn)

      tokenRow.append(tokenEntry)
      tokenField.append(tokenLabel)
      tokenField.append(tokenRow)

      // Remember checkbox
      const rememberRow = new Gtk.Box({ spacing: 8 })
      rememberRow.add_css_class("vpn-remember-row")

      rememberCheckbox = new Gtk.CheckButton({ label: _("Remember username"), active: true })
      rememberCheckbox.add_css_class("vpn-checkbox")
      rememberCheckbox.connect("toggled", () => {
        rememberUsername = rememberCheckbox.get_active()
      })

      rememberRow.append(rememberCheckbox)

      // Error label
      errorLabel = new Gtk.Label({ label: "", xalign: 0 })
      errorLabel.add_css_class("vpn-error-message")

      formBox.append(usernameField)
      formBox.append(passwordField)
      formBox.append(tokenField)
      formBox.append(rememberRow)
      formBox.append(errorLabel)

      // Connect button. Rolle voll: die Hauptsache der Formularansicht,
      // genau EIN voll in dieser Ansicht (die verbundene Ansicht hat
      // keins, siehe disconnectBtn oben).
      connectBtn = zepButton(_("Connect"), "voll", connectVpn)

      const connectActions = new Gtk.Box({ spacing: 12, halign: Gtk.Align.END })
      connectActions.add_css_class("vpn-actions")
      connectActions.append(connectBtn)

      formView.append(statusBox)
      formView.append(formBox)
      formView.append(connectActions)

      // ================================================================
      // ASSEMBLE
      // ================================================================
      mainBox.append(connectedView)
      mainBox.append(formView)

      return mainBox
    },
  })
}
