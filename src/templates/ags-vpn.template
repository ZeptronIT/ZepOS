// Settings file path
const SETTINGS_FILE = `${ZEPOS_USER_ROOT}/user-settings.json`

// DER VPN-ABSCHNITT TRAEGT SEIT DEM 22.08.2026 EINE LISTE
//
//     "ich will, dass ich in der liste das auswaehlen kann per toggle,
//      welche vpn aktiv sein soll - bei wireguard, weil ich dort
//      mehrere vpns habe und alle darueber verwaltbar sein muessen.
//      das gleiche gilt uebrigens fuer die anderen vpn verbindungen
//      auch!!!"
//
//     `vpn.connections` ist die Liste, `vpn.active` die Kennung der
//     gewaehlten. Ein Abschnitt OHNE `connections` ist genau eine
//     Verbindung - dieselbe Regel wie src/vpn.py::connection(), und aus
//     demselben Grund: eine Einstellungsdatei, die settings.load() noch
//     nicht gewandert hat, muss hier weiter lesbar sein, sonst steht
//     der Nutzer nach einer Aktualisierung vor einer leeren Seite.
interface VpnEintrag {
  id: string
  name: string
  kind: string
  ziel: string
  ovpnAuth: string
}

function vpnSection(data: any): any {
  return (data && typeof data.vpn === "object" && data.vpn) || {}
}

// Die Bauart, wie src/vpn.py::vpn_kind() sie liest: ein unbekannter
// Wert wird zu "ipsec" und nicht durchgereicht. Eine vertippte Bauart
// darf nicht in eine Verbindung fuehren, die niemand gemeint hat.
function vpnKind(entry: any): string {
  const k = entry?.kind
  return (k === "wireguard" || k === "openvpn") ? k : "ipsec"
}

// Wohin die Verbindung geht - EINE Zeile fuer drei Bauarten. IPsec
// nennt es `server`, WireGuard den `endpoint` seiner ersten
// Gegenstelle, OpenVPN `remote`. Drei Zeilen, von denen bei jeder
// Verbindung zwei leer blieben, waeren dieselbe Auskunft dreimal.
function vpnZiel(entry: any): string {
  const kind = vpnKind(entry)
  if (kind === "openvpn") return entry?.openvpn?.remote || ""
  if (kind === "wireguard") {
    const peers = entry?.wireguard?.peers ?? []
    return peers.length ? (peers[0].endpoint || "") : ""
  }
  return entry?.server || ""
}

function vpnConnections(data: any): VpnEintrag[] {
  const section = vpnSection(data)
  const roh = Array.isArray(section.connections)
    ? section.connections
    // Der alte Abschnitt IST eine Verbindung - siehe oben. Ein LEERER
    // ist dagegen keine: eine frische Installation hat nichts
    // eingestellt, und ihr eine leere Verbindung vorzuspiegeln waere
    // schlimmer als eine leere Liste.
    : (Object.keys(section).length ? [section] : [])
  return roh.filter((e: any) => e && typeof e === "object").map((e: any, i: number) => ({
    // EINE KENNUNG, DIE ES IMMER GIBT - NACHGETRAGEN am 01.09.2026
    //
    //     Hier stand `String(e.id ?? "")`. Ein Eintrag ohne `id` wurde
    //     damit zur LEEREN Zeichenkette - und zwei Eintraege ohne `id`
    //     zu zwei GLEICHEN Kennungen. Alles, was danach `find(e.id ===
    //     ...)` fragt, bekam dann den ersten Eintrag, egal welche Zeile
    //     angeklickt war. Der Nutzer hat genau das gemeldet: "ich komme
    //     in die einstellung nicht mehr rein" - er kam hinein, nur
    //     immer in dieselbe.
    //
    //     Eintraege ohne `id` sind kein Sonderfall: die Vorlagen lesen
    //     user-settings.json ROH (GLib.file_get_contents + JSON.parse)
    //     und laufen nie durch settings.py::migrate_vpn(), das die
    //     Kennung "c1" nachtraegt. Wer die Datei von Hand bearbeitet
    //     oder `settings.py merge` von der Kommandozeile ruft, hat
    //     keine.
    //
    //     "#0", "#1", ... aus der POSITION und nicht aus dem Namen:
    //     zwei Verbindungen duerfen gleich heissen, zwei Positionen
    //     koennen es nicht. Und aus derselben Regel wie in
    //     ags-vpn-settings.template::verbindungAus() - beide Fenster
    //     lesen dieselbe Datei, also muessen sie zur selben Zeile
    //     dieselbe Kennung sagen, sonst zeigt das eine, worauf im
    //     anderen nicht geklickt wurde.
    id: String(e.id || `#${i}`),
    name: String(e.connection_name || "work"),
    kind: vpnKind(e),
    ziel: vpnZiel(e),
    ovpnAuth: ["password", "password-tls"].includes(e?.openvpn?.connection_type)
      ? e.openvpn.connection_type : "tls",
  }))
}

// DIE GEWAEHLTE VERBINDUNG - dieselbe Auswahl wie src/vpn.py.
function vpnActive(data: any): any {
  const section = vpnSection(data)
  if (!Array.isArray(section.connections)) return section
  const eintraege = section.connections.filter(
    (e: any) => e && typeof e === "object")
  if (!eintraege.length) return {}
  return eintraege.find((e: any) => e.id === section.active) || eintraege[0]
}

