const VPN_STATUS_QUERY = ["python3", "{{ZEPOS_SYSTEM_ROOT}}/vpn.py", "--status"]

// SEIT DEM 21.08.2026 ANTWORTET vpn.py FUER BEIDE BAUARTEN, UND DIESE
// SEITE MERKT DAVON NICHTS
//     `--status` entscheidet dort selbst anhand von `vpn.kind`, ob es
