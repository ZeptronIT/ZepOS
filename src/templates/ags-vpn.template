// Load PSK from user config file.
//
// Read in this process rather than through `cat`: the file belongs to
// the user, so there is nothing to spawn for, and a home directory whose
// path contains a space would have arrived at cat as two arguments -
// execAsync(string) splits with GLib.shell_parse_argv and starts no
// shell.
function loadPsk(): string {
  try {
    const [ok, contents] = GLib.file_get_contents(SCRIPTS.pskFile)
    if (!ok || !contents) return ""
    return new TextDecoder().decode(contents).trim()
  } catch (e) {
    console.error("Failed to load PSK:", e)
    return ""
  }
}

// Check VPN status.
// Three-state result, decided in vpn.py so that this widget, the bar and
// vpn-control.sh cannot disagree about the same tunnel:
//   - connected: we have a record of this connection, charon still holds it,
//     and the address strongSwan assigned is still on an interface. A tunnel
//     the gateway assigned no address to counts as well — there is then
//     nothing to verify.
//   - stale:     the record without the rest of it. CHILD_SAs collapsed, or an
//     unclean shutdown. UI must surface this instead of falsely showing green.
//   - disconnected: no record.
//
// Dieses Widget suchte hier selbst nach einer Adresse aus dem Pool eines
// bestimmten Gateways. Wer eine andere zugewiesen bekam, sah auf einem
// gesunden Tunnel dauerhaft das rote "VPN unvollständig".
async function getVpnStatus(): Promise<VpnStatus> {
  try {
    const state = readVpnState()

    const answer = await execAsync(VPN_STATUS_QUERY).catch(() => "")
    const [reported, address] = answer.trim().split(/\s+/)

    if (reported === "connected") {
      return {
        status: "connected",
        ip: address ?? state?.virtual_ip ?? null,
        connectionName: state?.connection_name,
        installedChildren: state?.installed_children,
      }
    }
    if (reported === "stale") {
      return {
        status: "stale",
        ip: address ?? state?.virtual_ip ?? null,
        connectionName: state?.connection_name,
        installedChildren: state?.installed_children,
      }
    }
    // "disconnected" IST eine Auskunft, und nur sie darf so heissen.
    //
    //     `vpn.py --status` sagt dieses Wort, wenn es NACHGESEHEN hat
    //     und nichts stand (rc=10, "die Verbindung gibt es nicht").
    //     Das ist etwas anderes als "es liess sich nicht nachsehen".
    if (reported === "disconnected") {
      return { status: "disconnected", ip: null }
    }

    // ALLES UEBRIGE IST `unknown`, UND DAS IST DER GANZE PUNKT DIESES
    // ZWEIGES - NACHGETRAGEN am 02.09.2026.
    //
    //     Hier stand bis heute `return { status: "disconnected" }`, mit
    //     dem Kommentar "ohne Auskunft wird nichts behauptet". Genau
    //     das tat die Zeile aber: "nicht verbunden" IST eine Behauptung,
    //     und es ist die gefaehrliche Richtung. Wer "getrennt" liest,
    //     verhaelt sich, als sei er ungeschuetzt - unangenehm, aber
    //     harmlos. Wer in Wahrheit ungeschuetzt ist und "geschuetzt"
    //     liest, verliert Daten. Die Zeile hat in der harmlosen
    //     Richtung geirrt und trotzdem geirrt.
    //
    //     Hierher faellt zweierlei:
    //       * `reported === "unknown"` - vpn.py hat selbst gesagt, dass
    //         es nichts weiss (NetworkManager laeuft nicht, nmcli fehlt,
    //         Zeitablauf).
    //       * ein leerer oder unbekannter Bericht - `execAsync` ist in
    //         sein `.catch(() => "")` gelaufen, oder der Vertrag
    //         (vpn.STATUS_WORDS) hat ein fuenftes Wort bekommen, das
    //         diese Datei nicht kennt. In beiden Faellen ist die
    //         ehrliche Antwort dieselbe: wir wissen es nicht.
    return { status: "unknown", ip: null }
  } catch {
    // Auch ein Fehler beim Lesen der Zustandsdatei ist kein Beleg
    // dafuer, dass nichts steht.
    return { status: "unknown", ip: null }
  }
}

// Update status display - toggles between connected view and form view
async function updateStatusDisplay() {
  currentStatus = await getVpnStatus()
  // Welche Zeile ihren Schalter auf "an" zeigt - siehe `laufendeId`.
  laufendeId = currentStatus.status === "connected" ? gewaehlteId : ""
  listeNeuZeichnen()

  if (currentStatus.status === "connected") {
    // Show centered connected view, hide form
    connectedIcon.set_text(ICONS.vpn)
    connectedIcon.remove_css_class("disconnected")
    connectedIcon.remove_css_class("connecting")
    connectedIcon.remove_css_class("error")
    connectedIcon.add_css_class("connected")
    // Aus Template-Literalen zu format() geworden: xgettext liest eine
    // Zeichenkette mit ${...} gar nicht aus, diese drei Zeilen bekaemen
    // also keinen Katalogeintrag und blieben still deutsch. Benannte
    // Platzhalter erlauben der Uebersetzung ausserdem eine andere
    // Reihenfolge. 17.08.2026
    connectedIpLabel.set_text(format(_("IP: {ip}"), { ip: String(currentStatus.ip) }))
    // Ein WireGuard-Tunnel hat kein Gateway, er hat eine Gegenstelle.
    // Dieselbe Zeile, ein anderer Begriff - und NICHT eine zweite Zeile
    // darunter, die bei IPsec leer bliebe.
    connectedServerLabel.set_text(vpnSettings.kind === "ipsec"
      ? format(_("Server: {server}"), { server: vpnSettings.server })
      : format(_("Peer: {endpoint}"), { endpoint: vpnSettings.endpoint || "--" }))
    connectedNameLabel.set_text(format(_("Connection: {connection}"), { connection: currentStatus.connectionName ?? vpnSettings.connection_name }))
    if (!isDisconnecting) {
      disconnectBtn.set_child(new Gtk.Label({ label: _("Disconnect") }))
      disconnectBtn.set_sensitive(true)
    }
    connectedView.set_visible(true)
    formView.set_visible(false)
  } else if (currentStatus.status === "stale") {
    // Tunnel half-up: charon may be running but CHILD_SAs are down OR state
    // file says connected while charon/IP have vanished. Show the connect
    // form so the user can reconnect — but mark the icon as "error" so this
    // isn't mistaken for a normal disconnected state.
    disconnectedIcon.set_text(ICONS.vpnOff)
    disconnectedIcon.remove_css_class("connected")
    disconnectedIcon.remove_css_class("connecting")
    disconnectedIcon.remove_css_class("disconnected")
    disconnectedIcon.remove_css_class("unknown")
    disconnectedIcon.add_css_class("error")
    disconnectedLabel.set_text(_("VPN incomplete – please reconnect"))
    connectBtn.set_sensitive(true)
    connectedView.set_visible(false)
    formView.set_visible(true)
  } else if (currentStatus.status === "unknown") {
    // NIEMAND WEISS ES - und der Text muss das AUSSPRECHEN, nicht nur
    // die Farbe. NACHGETRAGEN am 02.09.2026.
    //
    //     "NetworkManager antwortet nicht" allein liesse den Leser
    //     selbst schliessen, was das fuer seinen Verkehr heisst - und
    //     der naheliegende Schluss ("dann laeuft wohl nichts") ist genau
    //     der falsche. Also steht beides da: was passiert ist, und was
    //     daraus folgt.
    //
    //     WOERTLICH DIESELBEN ZWEI SAETZE WIE IN DER LEISTE
    //     (bar-vpn-config.template, Zweig `vpn.UNKNOWN`). Fenster und
    //     Leiste beschreiben denselben Zustand; sagten sie es
    //     verschieden, muesste der Leser raten, ob er dasselbe meint.
    //
    //     Zeichen und Farbe ebenso aus der Leiste geborgt: ICON_QUESTION
    //     und die Warnfarbe. Keine neue Farbe - STYLE_COLOR_WARNING ist
    //     die einzige Zustandsfarbe der Leiste, die in BEIDEN Themen
    //     ueber 4.5:1 liegt (6.78 bzw. 5.14 im schlechtesten Fall).
    disconnectedIcon.set_text(ICONS.question)
    disconnectedIcon.remove_css_class("connected")
    disconnectedIcon.remove_css_class("connecting")
    disconnectedIcon.remove_css_class("disconnected")
    disconnectedIcon.remove_css_class("error")
    disconnectedIcon.add_css_class("unknown")
    //     ZWEI msgids UND KEINER MIT `\n` DARIN, und das ist gemessen:
    //     gettext schreibt einen msgid mit eingebettetem Zeilenumbruch
    //     immer in der MEHRZEILIGEN Form (`msgid ""` plus
    //     Fortsetzungszeilen), auch mit --no-wrap. Im ganzen Katalog
    //     gibt es davon sonst KEINEN einzigen ausser dem Kopfeintrag,
    //     und tests/src/test_ags_i18n.py sucht die einzeilige Form
    //     woertlich. Ein Satz mit `\n` waere hier also nicht
    //     uebersetzbar gewesen, ohne den Test umzuschreiben - und der
    //     Test hat recht, denn er bildet die Gewohnheit des Katalogs ab.
    //
    //     Zusammengesetzt wird darum erst NACH dem Uebersetzen - so,
    //     wie die Leiste ihren Kurzhinweis ebenfalls aus Teilen baut.
    disconnectedLabel.set_text(
      _("VPN status unknown – NetworkManager is not responding.")
      + "\n" + _("Nobody knows whether your traffic is protected."))
    connectBtn.set_sensitive(true)
    connectedView.set_visible(false)
    formView.set_visible(true)
  } else {
    // Show form view, hide connected view
    disconnectedIcon.set_text(ICONS.vpnOff)
    disconnectedIcon.remove_css_class("connected")
    disconnectedIcon.remove_css_class("connecting")
    disconnectedIcon.remove_css_class("error")
    // `unknown` mit abraeumen: die Klassen bleiben sonst am Label
    // haengen, und ein spaeteres "nicht verbunden" traege die Warnfarbe
    // des Zustands davor weiter.
    disconnectedIcon.remove_css_class("unknown")
    disconnectedIcon.add_css_class("disconnected")
    disconnectedLabel.set_text(_("Not connected"))
    connectBtn.set_sensitive(true)
    connectedView.set_visible(false)
    formView.set_visible(true)
  }
}

