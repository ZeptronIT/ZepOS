// ============================================================================
// DIE VPN-SEITE
// ============================================================================

/** Die VPN-Seite der Schale, unter VERBINDUNGEN.
 *
 * `gruppe` traegt denselben englischen msgid wie `gruppeVerbindungen` in
 * ags-control-center.template ("CONNECTIONS") - siehe die Begruendung in
 * ags-bluetooth.template (Aufgabe 7) an derselben Stelle.
 */
export const vpnSeite: ShellSeite = {
  id: "vpn",
  titel: _("VPN"),
  symbol: ICONS.vpn,
  gruppe: _("CONNECTIONS"),

  bauen: (win, schliessen, istAktiv) => {
    // Connect to VPN
    // WIREGUARD VERBINDEN - EIN BEFEHL, KEIN FORMULAR
    //
    //     Kein Nutzername, kein Passwort, kein Einmal-Token: WireGuard
    //     weist sich mit Schluesseln aus. Das Profil steht schon im
    //     NetworkManager (das Einstellungsfenster hat es beim Speichern
    //     ueber `vpn.py --wg-apply` hingelegt), hier wird es nur noch
    //     hochgefahren.
    //
    //     `nmcli connection up` faellt unter die polkit-Aktion
    //     network-control, und die steht in der ausgelieferten
    //     Regeldatei auf `allow_active=yes` - GEMESSEN am 21.08.2026
    //     mit pkcheck, siehe den Kopf des WireGuard-Teils in
    //     src/vpn.py. Kein sudo, kein Passwortdialog, keine neue Zeile
    //     in /etc/sudoers.d/zepos.
    async function connectWireguard() {
      errorLabel.set_text("")
      disconnectedIcon.set_text(ICONS.vpn)
      disconnectedIcon.remove_css_class("connected")
      disconnectedIcon.remove_css_class("disconnected")
      disconnectedIcon.remove_css_class("error")
      disconnectedIcon.remove_css_class("unknown")
      disconnectedIcon.add_css_class("connecting")
      disconnectedLabel.set_text(_("Connecting ..."))
      connectBtn.set_sensitive(false)

      try {
        await execAsync([...VPN_TOOL, "--wg-up"])
        schliessen()
        // Kuerzer als die fuenf Sekunden der IPsec-Seite: dort wartet
        // ein ganzer IKE-Austausch mit zwei Phasen, hier bringt der
        // NetworkManager eine Schnittstelle hoch.
        setTimeout(async () => { await updateStatusDisplay() }, 2000)
      } catch (e) {
        console.error("Failed to bring up the WireGuard connection:", e)
        errorLabel.set_text(_("Connection failed"))
        disconnectedIcon.add_css_class("error")
        disconnectedIcon.remove_css_class("connecting")
        connectBtn.set_sensitive(true)
      }
    }

    // OPENVPN VERBINDEN - DAS PASSWORT GEHT UEBER DIE STANDARDEINGABE
    //
    //     Die IPsec-Seite unten reicht Nutzername, Passwort und
    //     Einmal-Kennwort bis heute als ARGUMENTE an vpn-connect.sh
    //     ($1, $2, $4). /proc/<pid>/cmdline ist fuer jedes Konto der
    //     Maschine lesbar - hier wird das nicht wiederholt.
    //
    //     execAsync kann keine Eingabe reichen, deshalb Gio.Subprocess
    //     mit STDIN_PIPE. `vpn.py --ovpn-up` liest dort ein
    //     JSON-Objekt, schreibt daraus eine 0600-Datei ins
    //     Laufzeitverzeichnis, gibt sie `nmcli ... passwd-file` und
    //     loescht sie im `finally` wieder - auch wenn nmcli scheitert.
    //
    //     Bei reinen Zertifikatsverbindungen bleibt das Objekt leer.
    //     Dann braucht die Verbindung ueberhaupt kein Geheimnis, und
    //     genau das ist der Fall, in dem sie nach einem Netzwechsel
    //     von selbst zurueckkommt (GEMESSEN, siehe der Hinweis im
    //     Einstellungsfenster).
    async function connectOpenvpn() {
      const needsLogin = vpnSettings.ovpnAuth !== "tls"
      const username = usernameEntry.get_text()
      const password = passwordEntry.get_text()
      const token = tokenEntry.get_text()

      if (needsLogin && !username) {
        errorLabel.set_text(_("Username required"))
        return
      }
      if (needsLogin && !password) {
        errorLabel.set_text(_("Password required"))
        return
      }

      errorLabel.set_text("")
      disconnectedIcon.set_text(ICONS.vpn)
      disconnectedIcon.remove_css_class("connected")
      disconnectedIcon.remove_css_class("disconnected")
      disconnectedIcon.remove_css_class("error")
      disconnectedIcon.remove_css_class("unknown")
      disconnectedIcon.add_css_class("connecting")
      disconnectedLabel.set_text(_("Connecting ..."))
      connectBtn.set_sensitive(false)

      if (rememberUsername && username) saveLastUsername(username)

      try {
        const child = Gio.Subprocess.new(
          [...VPN_TOOL, "--ovpn-up"],
          Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
        // Nur was wirklich gebraucht wird. Ein leeres Objekt bei einer
        // Zertifikatsverbindung ist kein Sonderfall, sondern der
        // Normalfall dieser Bauart.
        const payload = needsLogin
          ? JSON.stringify({ password, token })
          : "{}"
        const [, stderr] = child.communicate_utf8(payload, null)
        if (!child.get_successful()) {
          throw new Error(String(stderr ?? "").trim() || _("Connection failed"))
        }
        schliessen()
        setTimeout(async () => { await updateStatusDisplay() }, 3000)
      } catch (e) {
        console.error("Failed to bring up the OpenVPN connection:", e)
        errorLabel.set_text(_("Connection failed"))
        disconnectedIcon.add_css_class("error")
        disconnectedIcon.remove_css_class("connecting")
        connectBtn.set_sensitive(true)
      }
    }

    async function connectVpn() {
      if (vpnSettings.kind === "wireguard") {
        await connectWireguard()
        return
      }
      if (vpnSettings.kind === "openvpn") {
        await connectOpenvpn()
        return
      }

      const username = usernameEntry.get_text()
      const password = passwordEntry.get_text()
      const token = tokenEntry.get_text()

      // Validation
      if (!username) {
        errorLabel.set_text(_("Username required"))
        return
      }
      if (!password) {
        errorLabel.set_text(_("Password required"))
        return
      }
      // 2FA Token ist optional - wenn leer, wird nur Passwort verwendet

      // Load PSK from user config file
      const psk = loadPsk()
      if (!psk) {
        errorLabel.set_text(_("PSK not found! Please save it in the VPN settings."))
        // Open settings - und zwar die DIESER Verbindung: der fehlende
        // PSK gehoert zu ihr, nicht zu irgendeiner aus der Liste
        // (01.09.2026).
        openVpnSettings(gewaehlteId)
        return
      }

      errorLabel.set_text("")

      // Save username if checkbox is checked
      if (rememberUsername) {
        saveLastUsername(username)
      }

      // Update status to connecting
      disconnectedIcon.set_text(ICONS.vpn)
      disconnectedIcon.remove_css_class("connected")
      disconnectedIcon.remove_css_class("disconnected")
      disconnectedIcon.remove_css_class("error")
      disconnectedIcon.remove_css_class("unknown")
      disconnectedIcon.add_css_class("connecting")
      disconnectedLabel.set_text(_("Connecting ..."))
      connectBtn.set_sensitive(false)

      // Das Protokoll liegt auf dem tmpfs des Benutzers, nicht in /tmp -
      // an derselben Stelle, an die vpn-control.sh seines schreibt. Es
      // trägt den Benutzernamen, sein Name war aus dem Datum vorhersagbar,
      // und /tmp kann jedes Konto der Maschine lesen. Das Verzeichnis
      // gehört nur dem Benutzer und wird beim Abmelden geleert.
      const runtimeDir = `${GLib.get_user_runtime_dir()}/zepos-vpn`
      GLib.mkdir_with_parents(runtimeDir, 0o700)
      const stamp = new Date().toISOString().slice(0, 10).replace(/-/g, "")
      const logFile = `${runtimeDir}/vpn-control-${stamp}.log`

      // Jeder Wert als eigenes Argument, nie in einen Befehlstext gesetzt.
      //
      // execAsync(string) zerlegt mit GLib.shell_parse_argv und startet
      // KEINE Shell - hier stand aber ein von Hand zusammengesetztes
      // `bash -c '...'`, und darin war jedes eingesetzte Zeichen Programm.
      // Ein Passwort wie `p"; id > /tmp/pwned; #` lief als Befehl, in
      // genau dem Ablauf, der die Zugangsdaten in der Hand hat.
      //
      // Der dritte Platz bleibt leer: dort stand das Sudo-Passwort, das
      // vpn-connect.sh nicht mehr liest. vpn-control.sh übergibt ihn
      // ebenso leer.
      const connectArgv = [
        SCRIPTS.vpnConnect, username, password, "", token, psk,
        vpnSettings.connection_name, logFile,
      ]

      try {
        if (vpnSettings.debug) {
          // Debug mode: open terminal with connect script output
          await execAsync([
            "kitty", "--class=vpn-connection",
            "--title=VPN Connection Progress",
            "-o", "remember_window_size=no",
            "-o", "initial_window_width=120",
            "-o", "initial_window_height=40",
            "--hold",
            "-e", ...connectArgv,
          ])
        } else {
          // Silent mode: run connect script in background.
          //
          // Die einzige Stelle, die eine Shell braucht - für die
          // Umleitung. Ihr Programmtext ist eine Konstante; alles
          // Veränderliche steht als Argument dahinter. `umask 077`, weil
          // die Umleitung die Datei anlegt, bevor vpn-connect.sh sein
          // eigenes umask setzen kann, und sie den Benutzernamen trägt.
          await execAsync([
            "bash", "-c",
            'umask 077; detail="$1"; shift; exec "$@" >> "$detail" 2>&1',
            "zepos-vpn-connect", `${logFile}.detail`, ...connectArgv,
          ])
        }

        // Clear sensitive fields
        passwordEntry.set_text("")
        tokenEntry.set_text("")

        // Hide the shell - dieselbe Ansage wie vorher (closeFn?.()), nur
        // seit Aufgabe 9 mit dem Rueckruf, den bauen() von der Schale
        // bekommt. Schliesst die GANZE Schale, nicht nur die VPN-Seite.
        schliessen()

        // Check status after a delay
        setTimeout(async () => {
          await updateStatusDisplay()
        }, 5000)
      } catch (e) {
        console.error("Failed to connect:", e)
        errorLabel.set_text(_("Connection failed"))
        disconnectedIcon.add_css_class("error")
        disconnectedIcon.remove_css_class("connecting")
        connectBtn.set_sensitive(true)
      }
    }

    // Disconnect VPN
    async function disconnectVpn() {
      if (isDisconnecting) return
      isDisconnecting = true

      // Show spinner in disconnect button
      const spinnerBox = new Gtk.Box({ spacing: 8, halign: Gtk.Align.CENTER })
      const spinner = new Gtk.Spinner({ spinning: true })
      spinner.set_size_request(16, 16)
      const spinnerLabel = new Gtk.Label({ label: _("Disconnecting ...") })
      spinnerBox.append(spinner)
      spinnerBox.append(spinnerLabel)
      disconnectBtn.set_child(spinnerBox)
      disconnectBtn.set_sensitive(false)

      connectedIcon.remove_css_class("connected")
      connectedIcon.add_css_class("connecting")

      // Pause status timer during disconnect to prevent race conditions
      if (updateTimer) {
        clearInterval(updateTimer)
        updateTimer = null
      }

      try {
        // As an argument list: execAsync(string) splits with
        // GLib.shell_parse_argv, so a home directory whose path contains a
        // space would arrive as two arguments.
        // Dieselbe Weiche wie beim Verbinden. vpn-control.sh ist die
        // IPsec-Seite - es raeumt swanctl-Kinder, Routen, xfrm-Policies
        // und resolv.conf ab; nichts davon gibt es bei einem
        // NetworkManager-Profil, das eine Schnittstelle wieder abbaut.
        if (vpnSettings.kind === "wireguard") {
          await execAsync([...VPN_TOOL, "--wg-down"])
        } else if (vpnSettings.kind === "openvpn") {
          await execAsync([...VPN_TOOL, "--ovpn-down"])
        } else {
          await execAsync([SCRIPTS.vpnControl, "disconnect"])
        }
        await updateStatusDisplay()
      } catch (e) {
        console.error("Failed to disconnect:", e)
        connectedIcon.remove_css_class("connecting")
        connectedIcon.add_css_class("error")
        // Restore button label
        disconnectBtn.set_child(new Gtk.Label({ label: _("Disconnect") }))
        disconnectBtn.set_sensitive(true)
      } finally {
        isDisconnecting = false
        // Restart status timer - mit demselben win.visible-Waechter wie
        // beim ersten Start weiter unten (Aufgabe 9).
        if (!updateTimer) {
          updateTimer = setInterval(() => { if (win.visible) updateStatusDisplay() },
                                    UPDATE_INTERVAL)
        }
      }
    }

    // Open VPN Settings - bleibt ein eigenes Fenster (Aufgabenblatt 9,
    // Schritt 2: "Die VPN-Einstellungen bleiben ein eigenes Fenster ...
    // das Zahnrad auf der VPN-Seite oeffnet sie weiterhin"). Der Weg
    // bleibt woertlich derselbe: ein zweiter `ags`-Prozess reicht die
    // Anfrage "vpn-settings" ueber den Astal-Socket an DIESEN Prozess
    // weiter, dessen requestHandler (ags-config.template) unveraendert
    // `toggleWidget(widgets.vpnSettings)` ruft - widgets.vpnSettings
    // existiert weiterhin, unabhaengig davon, dass VPN selbst jetzt eine
    // Seite ist.
    //
    // MIT DER KENNUNG DER GEMEINTEN VERBINDUNG - NACHGETRAGEN am
    // 01.09.2026
    //
    //     GEMELDET, woertlich: "ich muss mich voll komisch durchklicken
    //     sobald ich auf eine vpn gehe dann auf icon einstellung will
    //     ich direkt dort landen". Hier stand `ags request vpn-settings`
    //     ohne jede Angabe. Das Einstellungsfenster fing daraufhin immer
    //     auf seiner LISTE an und waehlte `vpn.active` aus der Datei -
    //     also die zuletzt gespeicherte Verbindung, nie die angeklickte.
    //     Wer auf einer Zeile das Zahnrad drueckte, landete eine Stufe
    //     zu hoch und musste dieselbe Zeile dort noch einmal suchen.
    //
    //     Der Doppelpunkt ist dasselbe Trennzeichen wie bei
    //     "settings:<seite>"; zerlegt wird er im requestHandler von
    //     ags-config.template, die Kennung landet dort ueber
    //     oeffneVerbindung() im Einstellungsfenster.
    //
    //     OHNE Kennung bleibt alles, wie es war, und das ist der Fall
    //     des Knopfes "Neue Verbindung" unten: dort ist keine Verbindung
    //     gemeint, also gehoert die Liste ans Ziel.
    function openVpnSettings(kennung?: string) {
      execAsync(kennung ? `ags request vpn-settings:${kennung}`
                        : "ags request vpn-settings")
      schliessen()
    }

    // ================================================================
    // CONNECTED VIEW - Centered status display
    // ================================================================
    connectedView = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL,
      spacing: 16,
      halign: Gtk.Align.CENTER,
      valign: Gtk.Align.CENTER,
      vexpand: true,
      visible: false,
    })
    connectedView.add_css_class("vpn-connected-view")

    // Large centered icon
    connectedIcon = new Gtk.Label({ label: ICONS.vpn })
    connectedIcon.add_css_class("vpn-connected-icon")
    connectedIcon.add_css_class("connected")

    // Status text "Verbunden"
    const connectedStatusLabel = new Gtk.Label({ label: _("Connected") })
    connectedStatusLabel.add_css_class("vpn-connected-status")

    // Info group
    const connectedInfoBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4, halign: Gtk.Align.CENTER })
    connectedInfoBox.add_css_class("vpn-connected-info")

    // Derselbe msgid wie in updateStatusDisplay(), nur mit dem Strich
    // als Wert: ein eigener Eintrag "IP: --" waere derselbe Satz ein
    // zweites Mal im Katalog. 17.08.2026
    connectedIpLabel = new Gtk.Label({ label: format(_("IP: {ip}"), { ip: "--" }) })
    connectedIpLabel.add_css_class("vpn-connected-detail")

    connectedServerLabel = new Gtk.Label({ label: format(_("Server: {server}"), { server: vpnSettings.server }) })
    connectedServerLabel.add_css_class("vpn-connected-detail")

    connectedNameLabel = new Gtk.Label({ label: format(_("Connection: {connection}"), { connection: vpnSettings.connection_name }) })
    connectedNameLabel.add_css_class("vpn-connected-detail")

    connectedInfoBox.append(connectedIpLabel)
    connectedInfoBox.append(connectedServerLabel)
    connectedInfoBox.append(connectedNameLabel)

    // Disconnect button (full width). Rolle kritisch: Trennen ist
    // zerstoerend (dieselbe Einordnung wie net-disconnect-btn, Task C).
    disconnectBtn = zepButton(_("Disconnect"), "kritisch", disconnectVpn)
    disconnectBtn.add_css_class("vpn-disconnect-full")

    // Settings button. Rolle still: oeffnet ein anderes Fenster, reine
    // Navigation (dieselbe Einordnung wie netBtn/vpnBtn, Task D).
    //
    // BLEIBT, OBWOHL SEIT DEM 02.09.2026 JEDE LISTENZEILE EIN ZAHNRAD
    // TRAEGT - und das ist geprueft, nicht uebersehen.
    //
    //     Zwei Wege zum selben Fenster sind in Ordnung, drei sind
    //     Unordnung. Drei sind es hier nicht: GEZAEHLT ueber alle
    //     Zuweisungen an `connectedView.set_visible` und
    //     `formView.set_visible` - vier Paare, und JEDES setzt die
    //     beiden gegensaetzlich. Die zwei Ansichten sind nie zugleich
    //     sichtbar, dieser Knopf und `formSettingsBtn` also nie
    //     zugleich da.
    //
    //     Es sind damit nicht zwei Wege, sondern EINER, der zweimal
    //     gezeichnet werden muss, weil die Einzelheit zwei einander
    //     ausschliessende Gesichter hat. Je Ort genau ein Weg: aus der
    //     Liste das Zahnrad der Zeile, aus der Einzelheit dieses hier.
    //
    //     Und ersetzbar ist er nicht: wer nach dem Verbinden in der
    //     Einzelheit steht, muesste sonst erst zurueck in die Liste -
    //     also genau der Umweg, ueber den der Nutzer geklagt hat, nur
    //     in der anderen Richtung.
    const connectedSettingsBtn = zepButton(ICONS.settings, "still",
      // Die Einzelheiten DIESER Verbindung, nicht die Liste - siehe
      // openVpnSettings() oben (01.09.2026).
      //
      // `gewaehlteId` ist HIER richtig und in der Liste falsch: in der
      // Einzelheit gibt es genau eine gemeinte Verbindung, und das ist
      // die gewaehlte. In der Liste ist die gemeinte die der Zeile.
      () => openVpnSettings(gewaehlteId))

    connectedView.append(connectedIcon)
    connectedView.append(connectedStatusLabel)
    connectedView.append(connectedInfoBox)
    connectedView.append(disconnectBtn)
    connectedView.append(connectedSettingsBtn)

    // ================================================================
    // DIE LISTE DER VERBINDUNGEN - seit dem 22.08.2026
    // ================================================================
    //
    // "in der liste das auswaehlen ... per toggle". Hier, auf der
    // Schalenseite, und nicht nur im Einstellungsfenster: das ist der
    // Ort, an dem im Alltag umgeschaltet wird.
    //
    // AUS ZEPROW UND ZEPTOGGLE, KEIN NEUES BAUTEIL
    //     zepRow traegt `ende` (fuer den Schalter), `ausgewaehlt` und
    //     `aktion` seit dem 19.08.2026; zepSidebar und die
    //     Netzwerkseite bauen ihre Zeilen genau so. Eine eigene
    //     Zeilenform hier waere die Doppelung, die Aufgabe 15/16 fuer
    //     Knoepfe gerade abgeraeumt hat.
    //
    // WAS DER SCHALTER BEDEUTET: "DIESER TUNNEL STEHT"
    //     Nicht "diese Konfiguration ist gewaehlt". Der Nutzer liest
    //     einen Schalter so, und alles andere waere eine Anzeige, die
    //     etwas anderes behauptet als die Maschine tut. Seine Stellung
    //     kommt darum aus `vpn.py --status` und nie aus der
    //     Einstellungsdatei.
    //
    //     Braucht die Verbindung eine Anmeldung (IPsec immer, OpenVPN
    //     je nach `connection_type`), kann der Schalter nicht blind
    //     verbinden. Er WAEHLT die Zeile dann aus und zeigt ihr
    //     Formular; der Tunnel steht erst, wenn "Verbinden" gedrueckt
    //     wurde, und bis dahin steht der Schalter auf aus. Ein
    //     Schalter, der "an" zeigt, waehrend nichts steht, waere
    //     schlimmer als gar keiner.
    //
    // NUR EINE ZUR ZEIT
    //     Einschalten trennt die bisherige zuerst, sichtbar und
    //     benannt. Die Begruendung steht in src/settings.py bei
    //     `vpn.active`; die kuerzeste davon ist die Zustandsdatei
    //     $XDG_RUNTIME_DIR/vpn-active - EINE Datei mit EINEM
    //     Verbindungsnamen, an der vier rechtelose Leser haengen.
    listenBox = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL, spacing: 0,
    })
    listenBox.add_css_class("vpn-connection-list")

    // Was in der Nebenzeile steht: Bauart und Ziel. Die Bauart, weil
    // genau sie der Grund fuer die Liste ist (WireGuard UND IPsec
    // nebeneinander), das Ziel, weil zwei Verbindungen zum selben
    // Arbeitgeber sonst nicht auseinanderzuhalten waeren.
    function eintragUnterzeile(eintrag: VpnEintrag): string {
      const bauart = eintrag.kind === "wireguard" ? "WireGuard"
        : eintrag.kind === "openvpn" ? "OpenVPN" : "IPsec"
      return eintrag.ziel ? `${bauart} · ${eintrag.ziel}` : bauart
    }

    async function schalte(eintrag: VpnEintrag, an: boolean) {
      if (!an) {
        await disconnectVpn()
        return
      }
      // Steht schon eine andere, wird sie zuerst getrennt - und der
      // Nutzer erfaehrt es, statt es zu erraten.
      const stehende = vpnListe.find(
        (e) => e.id === laufendeId && e.id !== eintrag.id)
      if (stehende) {
        errorLabel.set_text(format(
          _("Only one VPN can be connected at a time - {name} is being disconnected."),
          { name: stehende.name }))
        await disconnectVpn()
      }
      gewaehlteId = eintrag.id
      vpnSettings = loadVpnSettings()
      applyVpnKind()
      const brauchtAnmeldung = eintrag.kind === "ipsec"
        || (eintrag.kind === "openvpn" && eintrag.ovpnAuth !== "tls")
      if (brauchtAnmeldung) {
        // Auswaehlen und das Formular zeigen - nicht verbinden. Siehe
        // die Begruendung oben.
        //
        // SEIT DEM 01.09.2026 blaettert das auch wirklich HIN: das
        // Formular steht seither in der Einzelheit und nicht mehr unter
        // der Liste. Ein `grab_focus()` auf ein Feld, das gerade nicht
        // abgebildet ist, tut in GTK4 nichts (siehe die Begruendung bei
        // `notify::visible` weiter unten) - der Schalter haette den
        // Nutzer also vor eine Liste gestellt, die sich nicht ruehrt.
        zeichneListe()
        zeigeDetail()
        usernameEntry.grab_focus()
        return
      }
      await connectVpn()
    }

    function zeichneListe() {
      let kind = listenBox.get_first_child()
      while (kind) {
        const naechstes = kind.get_next_sibling()
        listenBox.remove(kind)
        kind = naechstes
      }
      if (!vpnListe.length) {
        const leer = new Gtk.Label({
          label: _("No connection configured yet - add one."),
          xalign: 0, wrap: true,
        })
        leer.add_css_class("vpn-field-label")
        listenBox.append(leer)
        return
      }
      listenBox.append(zepSectionLabel(_("VPN connections")))
      for (const eintrag of vpnListe) {
        const steht = eintrag.id === laufendeId
          && currentStatus.status === "connected"

        // DAS ZAHNRAD IN DER ZEILE - NACHGETRAGEN am 02.09.2026
        //
        //     Nutzermeldung, woertlich: "ich kann uebrigens in der liste
        //     kein einstellung icon pro vpn sehen um direkt zur vpn zu
        //     gelangen stattdessen muss ich es aktivieren und dann komme
        //     ich auf die vpn bzw einstellungen statt direkt dort
        //     hinzugelangen", und praezisiert: "ich will neben dem
        //     toggle auch ein icon fuer einstellung haben das zahnrad".
        //
        //     Das Zahnrad gab es ZWEIMAL, und beide sassen in der
        //     EINZELHEIT: connectedSettingsBtn in `connectedView`,
        //     formSettingsBtn in `formView`. Aus der Liste fuehrte
        //     darum kein Weg dorthin, der nicht ueber die Einzelheit
        //     ging - Zeile klicken, Zahnrad suchen, klicken. Drei
        //     Schritte fuer eine Absicht, und welches der zwei Zahnraeder
        //     erschien, hing am Zustand der Verbindung.
        //
        //     `eintrag.id` UND NICHT `gewaehlteId`, und das ist der
        //     ganze Unterschied: `gewaehlteId` ist die Verbindung, die
        //     die Einzelheit gerade ZEIGT. Aus der Liste heraus ist das
        //     eine andere als die, deren Zahnrad man drueckt - genau der
        //     Fehler, den `1499455` fuer die zwei Zahnraeder in der
        //     Einzelheit schon einmal behoben hat.
        const zahnrad = zepButton(ICONS.settings, "still",
          () => openVpnSettings(eintrag.id))
        zahnrad.add_css_class("vpn-row-settings")
        // Ein Zeichen ohne Wort braucht einen Namen, und der Name muss
        // die Verbindung NENNEN: in einer Liste stehen mehrere gleich
        // aussehende Zahnraeder untereinander, und "Einstellungen"
        // allein sagt nicht, wessen.
        zahnrad.set_tooltip_text(format(_("Settings for {name}"),
                                        { name: eintrag.name }))

        // EINE Gtk.Box ALS `ende`, UND NICHT `ende` ALS LISTE
        //
        //     `ende` nimmt EIN Widget. Eine Box IST eines - damit
        //     bleibt ags-kit.template unangetastet und die fuenfzehn
        //     anderen zepRow-Aufrufer Zeichen fuer Zeichen dieselben.
        //     Ein zweiter Weg (`ende?: Gtk.Widget | Gtk.Widget[]`) haette
        //     eine Verzweigung IM geteilten Bauteil gebraucht, fuer
        //     genau einen Aufrufer, und dieselbe Baumform ergeben.
        //
        //     Und die Form ist genau die, die hier gebraucht wird:
        //     `endeBedienbar` haengt das GANZE `ende` neben die
        //     klickbare Huelle statt hinein (Herleitung dort). Beide
        //     Bedienelemente liegen damit ausserhalb des Gtk.Button -
        //     die Eigenschaft, an der die Leertaste am 01.09.2026
        //     geklemmt hat, gilt fuer das Zahnrad ohne Zutun mit.
        //
        //     Reihenfolge Zahnrad, dann Schalter: der Schalter ist das,
        //     was oft gedrueckt wird, und er bleibt an der Kante, wo er
        //     schon war - wer ihn blind trifft, soll ihn weiter blind
        //     treffen.
        const zeilenEnde = new Gtk.Box({ spacing: 8, valign: Gtk.Align.CENTER })
        zeilenEnde.add_css_class("vpn-row-ende")
        zeilenEnde.append(zahnrad)
        // BEI `unknown` NIMMT DER SCHALTER KEINE EINGABE AN -
        // NACHGETRAGEN am 02.09.2026.
        //
        //     `steht` ist dann `false`, und "aus" waere genau die
        //     falsche Behauptung, die der vierte Zustand eine Etage
        //     hoeher gerade abstellt: das Fenster sagte "niemand
        //     weiss es" und zeigte daneben "aus". Ein unbedienbarer
        //     Schalter behauptet nichts. Die Herleitung steht bei
        //     `bedienbar` in ags-kit.template.
        //
        //     DAS ZAHNRAD BLEIBT BEDIENBAR. Es behauptet nichts ueber
        //     den Zustand der Verbindung - es fuehrt zu ihren
        //     Einstellungen, und die sind auch dann zu lesen und zu
        //     aendern, wenn niemand weiss, ob der Tunnel steht.
        zeilenEnde.append(zepToggle(steht, (an) => { void schalte(eintrag, an) },
                                    currentStatus.status !== "unknown"))

        listenBox.append(zepRow({
          symbol: steht ? ICONS.vpn : ICONS.vpnOff,
          titel: eintrag.name,
          unterzeile: eintragUnterzeile(eintrag),
          ausgewaehlt: eintrag.id === gewaehlteId,
          aktion: () => {
            gewaehlteId = eintrag.id
            vpnSettings = loadVpnSettings()
            applyVpnKind()
            zeichneListe()
            // "bei klick auf das item einer vpn ... will ich auf die
            // details kommen" (01.09.2026). Der Klick waehlte bis dahin
            // nur aus; die Einzelheit stand ohnehin schon unter der
            // Liste, und genau das war der Platzmangel.
            zeigeDetail()
          },
          // Zahnrad UND Schalter, beide in einer Box - die Herleitung
          // steht oben bei `zeilenEnde`.
          ende: zeilenEnde,
          // DAS ENDE GEHOERT NEBEN DIE KLICKBARE HUELLE, NICHT
          // HINEIN - NACHGETRAGEN am 01.09.2026
          //
          //     Diese Zeile ist die EINZIGE im ganzen Baum, die zepRow
          //     mit `aktion` UND `ende` zugleich ruft (gezaehlt in
          //     tests/src/test_zeprow_zaehlung.py). Damit steckte
          //     hier - und nur hier - ein bedienbares Kind in einem
          //     Gtk.Button.
          //
          //     GEMESSEN am abgebildeten Fenster mit echten Tasten
          //     (tests/render/test_zeprow_verschachtelung.py). Die
          //     Zahlen sind die der GEGENPROBE - sie entstehen neu,
          //     sobald man `endeBedienbar` unten ausbaut:
          //
          //         4000ms --fokus-gelesen-- fokus=GtkSwitch[zep-toggle]
          //         4448ms KNOPF-clicked     fokus=GtkSwitch[zep-toggle]
          //
          //     Der Fokus lag auf dem SCHALTER, gefeuert hat die ZEILE,
          //     und `notify::active` kam kein einziges Mal. Wer die Maus
          //     nicht benutzen kann, konnte diese Verbindung damit
          //     ueberhaupt nicht schalten.
          //
          //     Die Herleitung der Betriebsart steht bei `endeBedienbar`
          //     in ags-kit.template. Sichtbar aendert sich nichts:
          //     `.zep-row` bleibt der gezeichnete Kasten, und die Zeile
          //     bleibt als Ganzes klickbar.
          endeBedienbar: true,
        }))
      }
    }

    // ================================================================
    // DISCONNECTED VIEW - Form for connecting
    // ================================================================
    formView = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })

    // Small status indicator
    const statusBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
    statusBox.add_css_class("vpn-status")

    const statusRow = new Gtk.Box({ spacing: 12 })
    statusRow.add_css_class("vpn-status-row")

    disconnectedIcon = new Gtk.Label({ label: ICONS.vpnOff })
    disconnectedIcon.add_css_class("vpn-status-icon")
    disconnectedIcon.add_css_class("disconnected")

    disconnectedLabel = new Gtk.Label({ label: _("Not connected"), xalign: 0 })
    disconnectedLabel.add_css_class("vpn-status-label")

    // Das zweite Gesicht desselben Weges - die Herleitung, warum es
    // neben dem Zahnrad der Listenzeile bleibt, steht bei
    // `connectedSettingsBtn`. Kurz: dieser hier und der dort sind nie
    // zugleich sichtbar, also nicht zwei Wege, sondern einer.
    const formSettingsBtn = zepButton(ICONS.settings, "still",
      () => openVpnSettings(gewaehlteId))

    statusRow.append(disconnectedIcon)
    statusRow.append(disconnectedLabel)
    statusRow.append(new Gtk.Box({ hexpand: true }))
    statusRow.append(formSettingsBtn)
    statusBox.append(statusRow)

    // Form section
    const formBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
    formBox.add_css_class("vpn-form")

    // Username field
    const usernameField = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
    usernameField.add_css_class("vpn-field")

    const usernameLabel = new Gtk.Label({ label: _("Username"), xalign: 0 })
    usernameLabel.add_css_class("vpn-field-label")

    const usernameRow = new Gtk.Box({ spacing: 0 })
    usernameRow.add_css_class("vpn-entry-row")

    usernameEntry = new Gtk.Entry({ hexpand: true, placeholder_text: _("Username ...") })
    usernameEntry.add_css_class("vpn-entry")

    usernameRow.append(usernameEntry)
    usernameField.append(usernameLabel)
    usernameField.append(usernameRow)

    // Password field
    const passwordField = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
    passwordField.add_css_class("vpn-field")

    const passwordLabel = new Gtk.Label({ label: _("Password"), xalign: 0 })
    passwordLabel.add_css_class("vpn-field-label")

    const passwordRow = new Gtk.Box({ spacing: 0 })
    passwordRow.add_css_class("vpn-entry-row")

    passwordEntry = new Gtk.Entry({ hexpand: true, visibility: false, placeholder_text: _("Password ...") })
    passwordEntry.add_css_class("vpn-entry")

    // Rolle still: ein Zeichen-Knopf am Rand der Eingabezeile, kein
    // Hauptweg (dieselbe Einordnung wie se-edit-btn/notif-close-btn) -
    // GEPRUEFT (18.08.2026): .vpn-entry-row hat keine eigene Hoehe, sie
    // haengt am groessten Kind. .vpn-entry traegt STYLE_SPACE_12 oben/
    // unten (18px, aufgeloest mit dem ausgelieferten Faktor 1.85) plus
    // Textzeile (STYLE_FONT_BODY 20px, Zeilenhoehe 1.2 ~ 24px) ~ 60px
    // Grundhoehe - groesser als zep-btns min-height (STYLE_CONTROL_HEIGHT,
    // 49px). Die Zeile bleibt also von .vpn-entry bestimmt, nicht vom
    // Knopf; anders als bei overlay-close-btn keine harte Massvorgabe,
    // die zep-btn unterlaeuft.
    const passwordVisBtn = zepButton(ICONS.eye, "still",
      () => togglePasswordVisibility(passwordEntry, passwordVisBtn, true))

    passwordRow.append(passwordEntry)
    passwordRow.append(passwordVisBtn)
    passwordField.append(passwordLabel)
    passwordField.append(passwordRow)

    // There is no sudo password field, and there must not be one
    // again. Nothing reads it: the privileged commands are granted by
    // /etc/sudoers.d/zepos, so `sudo -n` runs them without a password
    // - which is also the only thing that works for the watcher, which
    // has no terminal to ask at. Collecting it anyway meant handing a
    // login password to the connect script as an argument, and
    // /proc/<pid>/cmdline is world-readable for as long as the
    // connection takes. vpn-control.sh stopped asking for it first;
    // this is the other caller.

    // Token field
    const tokenField = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
    tokenField.add_css_class("vpn-field")

    const tokenLabel = new Gtk.Label({ label: _("2FA token (optional)"), xalign: 0 })
    tokenLabel.add_css_class("vpn-field-label")

    const tokenRow = new Gtk.Box({ spacing: 0 })
    tokenRow.add_css_class("vpn-entry-row")

    tokenEntry = new Gtk.Entry({ hexpand: true, placeholder_text: _("6-digit code ..."), max_length: 8 })
    tokenEntry.add_css_class("vpn-entry")
    tokenEntry.connect("activate", connectVpn)

    tokenRow.append(tokenEntry)
    tokenField.append(tokenLabel)
    tokenField.append(tokenRow)

    // Remember checkbox
    const rememberRow = new Gtk.Box({ spacing: 8 })
    rememberRow.add_css_class("vpn-remember-row")

    rememberCheckbox = new Gtk.CheckButton({ label: _("Remember username"), active: true })
    rememberCheckbox.add_css_class("vpn-checkbox")
    rememberCheckbox.connect("toggled", () => {
      rememberUsername = rememberCheckbox.get_active()
    })

    rememberRow.append(rememberCheckbox)

    // Error label
    errorLabel = new Gtk.Label({ label: "", xalign: 0 })
    errorLabel.add_css_class("vpn-error-message")

    // ZWEI FORMULARHAELFTEN IN EINER ANSICHT, NIE BEIDE SICHTBAR
    //
    //     Die drei Felder oben (Nutzername, Passwort, Einmal-Token)
    //     sind IPsec mit XAuth. WireGuard hat nichts davon - es weist
    //     sich mit Schluesseln aus, und ein Passwortfeld, in das nichts
    //     gehoert, ist schlimmer als keins: es fragt nach etwas, das es
    //     nicht gibt.
    //
    //     KEINE DRITTE ANSICHT, sondern eine Haelfte innerhalb der
    //     bestehenden Formularansicht. `connectedView` (Symbol, drei
    //     Zeilen, Trennen-Knopf) ist transportneutral und bleibt
    //     unveraendert; Statuszeile, Fehlerzeile und der
    //     Verbinden-Knopf gelten fuer beide Bauarten. Getauscht wird
    //     genau das, was sich unterscheidet.
    credentialsBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
    credentialsBox.append(usernameField)
    credentialsBox.append(passwordField)
    credentialsBox.append(tokenField)
    credentialsBox.append(rememberRow)

    wgNoteBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
    wgNoteBox.add_css_class("vpn-field")
    // Der Text wird in applyVpnKind() gesetzt, weil er von der Bauart
    // abhaengt - hier steht die WireGuard-Fassung als Anfangswert, damit
    // das Etikett nie leer gebaut wird.
    wgNote = new Gtk.Label({
      label: _("WireGuard identifies itself with keys - there is nothing to type here."),
      xalign: 0, wrap: true,
    })
    wgNote.add_css_class("vpn-field-label")
    // Damit auf der Seite steht, WOHIN verbunden wird. Ohne das waere
    // die WireGuard-Ansicht ein Knopf ueber einer leeren Flaeche, und
    // niemand koennte sehen, ob die richtige Gegenstelle eingestellt
    // ist.
    wgPeerLabel = new Gtk.Label({ label: "", xalign: 0, wrap: true })
    wgPeerLabel.add_css_class("vpn-psk-status")
    wgNoteBox.append(wgNote)
    wgNoteBox.append(wgPeerLabel)

    formBox.append(credentialsBox)
    formBox.append(wgNoteBox)
    formBox.append(errorLabel)

    // Connect button. Rolle voll: die Hauptsache der Formularansicht,
    // genau EIN voll in dieser Ansicht (die verbundene Ansicht hat
    // keins, siehe disconnectBtn oben).
    connectBtn = zepButton(_("Connect"), "voll", connectVpn)

    const connectActions = new Gtk.Box({ spacing: 12, halign: Gtk.Align.END })
    connectActions.add_css_class("vpn-actions")
    connectActions.append(connectBtn)

    // Welche Haelfte zu sehen ist. Gerufen beim Bau und bei jedem
    // Sichtbarwerden der Schale, weil die Bauart im
    // Einstellungsfenster geaendert werden kann, waehrend diese Seite
    // schon gebaut ist.
    //
    // ERWEITERT am 22.08.2026 um OpenVPN, und die Weiche ist NICHT
    // "welche Bauart", sondern "verlangt sie eine Anmeldung":
    //
    //     WireGuard verlangt nie eine (Schluessel), IPsec immer
    //     (XAuth), OpenVPN je nach `connection_type` - eine reine
    //     Zertifikatsverbindung hat genauso wenig zu tippen wie
    //     WireGuard. Nach der Bauart zu fragen haette bei OpenVPN in
    //     der Haelfte der Faelle nach einem Passwort gefragt, das es
    //     nicht gibt.
    //
    //     Die Notizhaelfte bekommt deshalb auch ihren Text von der
    //     Bauart und nicht mehr nur von WireGuard.
    function applyVpnKind() {
      const asksForLogin = vpnSettings.kind === "ipsec"
        || (vpnSettings.kind === "openvpn" && vpnSettings.ovpnAuth !== "tls")
      credentialsBox.set_visible(asksForLogin)
      wgNoteBox.set_visible(!asksForLogin)
      if (!asksForLogin) {
        wgNote.set_text(vpnSettings.kind === "openvpn"
          ? _("This OpenVPN connection identifies itself with certificates - there is nothing to type here.")
          : _("WireGuard identifies itself with keys - there is nothing to type here."))
        wgPeerLabel.set_text(vpnSettings.endpoint
          ? format(_("Peer: {endpoint}"), { endpoint: vpnSettings.endpoint })
          : _("No peer configured yet - open the settings."))
      }
    }
    applyVpnKind()

    formView.append(statusBox)
    formView.append(formBox)
    formView.append(connectActions)

    // ================================================================
    // ASSEMBLE
    // ================================================================
    const mainBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
    mainBox.add_css_class("vpn-container")
    // KEIN Mindestbreiten-Boden mehr an dieser Seite - GEAENDERT am
    // 20.08.2026.
    //
    //     Hier stand der Verweis auf `.zep-shell-page` (min-width:
    //     672px) und darunter, am `return`, eine polsterlose Huelle, die
    //     ihn trug. Beides ist weg: der Boden einer Schalenseite wird
    //     seit dem 20.08.2026 von der Schale selbst gesetzt und dabei
    //     GEMESSEN statt geschrieben (`config.fuelltDieSprosse` in
    //     ags-overlay-utils.template). Er sitzt dort auf dem ganzen
    //     Rumpf - kein Polster einer einzelnen Seite kann sich mehr
    //     darauf draufrechnen, und damit entfaellt auch der Grund fuer
    //     die Huelle.
    //
    //     GEMESSEN am 20.08.2026: der Inhalt dieser Seite
    //     (`.vpn-container`) misst 496 und ist damit die breiteste der
    //     sechs Schalenseiten - immer noch weit unter dem, was die
    //     Schale ihr laesst (645 auf 1920x1080).
    // ZWEI ANSICHTEN NACHEINANDER STATT DREI KAESTEN UEBEREINANDER -
    // GEAENDERT am 01.09.2026 (siehe die Begruendung oben bei
    // `zeigeDetail`).
    //
    //     Hier standen `listenBox`, `connectedView` und `formView`
    //     direkt untereinander in derselben Box. Zwei davon waren immer
    //     zugleich zu sehen, und beide teilten sich die Hoehe der
    //     Schalenseite.
    //
    //     Jetzt: `listenAnsicht` ODER `detailAnsicht`, nie beide.
    //     Innerhalb der Einzelheit entscheidet weiterhin
    //     updateStatusDisplay(), ob die verbundene Ansicht oder das
    //     Formular dasteht - das bleibt unveraendert, es ist dieselbe
    //     Frage wie bisher, nur eine Ebene tiefer.
    listeNeuZeichnen = zeichneListe

    listenAnsicht = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL, spacing: 0, vexpand: true,
    })
    listenAnsicht.append(listenBox)
    // Der Weg zu den Einstellungen bleibt in der Liste erreichbar.
    // Bisher stand das Zahnrad NUR in den beiden Einzelheiten
    // (statusRow und connectedView) - stuende es weiterhin nur dort,
    // waere aus der Liste heraus keine Verbindung mehr einzurichten,
    // und der leere Zustand ("No connection configured yet - add one.")
    // haette nichts, worauf sein "add one" zeigt.
    const listenAktionen = new Gtk.Box({ spacing: 12, halign: Gtk.Align.END })
    listenAktionen.add_css_class("vpn-actions")
    listenAktionen.append(
      // `() => openVpnSettings()` und NICHT `openVpnSettings`: zepButton
      // haengt die Funktion an "clicked", und GTK reicht dort den Knopf
      // selbst als erstes Argument herein - der waere seit dem
      // 01.09.2026 die "Kennung". Hier ist ausserdem keine bestehende
      // Verbindung gemeint, also gehoert die Liste ans Ziel.
      zepButton(`${ICONS.settings} ${_("New connection")}`, "umrandet",
                () => openVpnSettings()))
    listenAnsicht.append(listenAktionen)

    detailAnsicht = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL, spacing: 0, vexpand: true,
      visible: false,
    })
    // Der Weg zurueck, in derselben Form wie in ags-network.template
    // (dort `detailBackBtn`): Zeichen plus Wort, Rolle still, ganz oben.
    const zurueckZeile = new Gtk.Box({ spacing: 0, halign: Gtk.Align.START })
    zurueckZeile.add_css_class("vpn-detail-back")
    zurueckZeile.append(
      zepButton(`${ICONS.back} ${_("All connections")}`, "still", zeigeListe))
    detailAnsicht.append(zurueckZeile)
    detailAnsicht.append(connectedView)
    detailAnsicht.append(formView)

    mainBox.append(listenAnsicht)
    mainBox.append(detailAnsicht)
    zeichneListe()

    // ESC blaettert aus der Einzelheit zurueck und schliesst erst dann
    // die Schale. Angehaengt an `mainBox` - das Widget, das bauen()
    // zurueckgibt - und NICHT an `win`: nur so laeuft dieser Controller
    // (Bubble-Phase, GTK4-Standard) VOR dem der Fabrik, die ihren
    // eigenen an `win` selbst haengt. Wortgleich zu escController in
    // ags-network.template, und aus derselben Begruendung.
    const escController = new Gtk.EventControllerKey()
    escController.connect("key-pressed",
      (_controller: Gtk.EventControllerKey, keyval: number) => {
        if (keyval !== Gdk.KEY_Escape) return false
        if (seitenAnsicht === "liste") return false
        zeigeListe()
        return true
      })
    mainBox.add_controller(escController)

    // DER TAKT LAEUFT FUER DIE LEBENSDAUER DER SCHALE (Aufgabe 9,
    // 18.08.2026) - siehe die ausfuehrliche Begruendung am Kopf dieser
    // Datei, Abschnitt "DER TAKT". Roh `setInterval`/`clearInterval`
    // statt `interval()` aus "ags/time", weil `disconnectVpn()` ihn
    // gezielt anhalten und neu anstossen muss (Racebedingung waehrend
    // einer laufenden Trennung).
    updateTimer = setInterval(
      () => { if (win.visible && istAktiv()) updateStatusDisplay() },
      UPDATE_INTERVAL)

    // UND DER ERSATZ FUER onShow (siehe Kopf der Datei): bei jedem
    // Sichtbarwerden der Schale werden Knopf-Sensitivitaet, Einstellungen
    // und Formular zurueckgesetzt/vorbefuellt - dieselbe Ansage wie das
    // alte `onShow`, nur auf Schalenebene statt Fensterebene. Der Takt
    // selbst wird HIER NICHT neu gestartet (anders als im alten
    // `onShow`) - er laeuft seit dem Bau der Seite ohnehin durch (siehe
    // oben), ein zweiter Start waere ein zweiter Takt.
    //
    // NUR WENN VPN AUCH DIE AKTIVE SEITE IST - REPARIERT 19.08.2026
    // (Bericht Aufgabe 15/16, Fund 1.3)
    //     Der Kommentar oben ("harmlos: das Formular ist nur sichtbar,
    //     wenn man tatsaechlich zur VPN-Seite wechselt; grab_focus() auf
    //     einem Feld, das gerade nicht angezeigt wird, ist in GTK4 ein
    //     wirkungsloser Aufruf und kein Fehler") stimmt fuer grab_focus()
    //     - GEPRUEFT gegen die GTK4-Dokumentation zu
    //     gtk_widget_grab_focus() (liefert FALSE und tut nichts auf
    //     einem nicht abgebildeten Widget) UND NACHGEMESSEN: sieben
    //     saubere Laeufe dieser Seite (und der anderen drei) im
    //     verschachtelten Compositor zeigten dabei keinen einzigen
    //     verzoegerten oder ausbleibenden Aufbau der Flaeche 'control'.
    //     Der Verdacht aus dem Bericht dieser Aufgabe ist damit NICHT
    //     bestaetigt.
    //
    //     Repariert wird hier trotzdem, aus einem eigenen, unabhaengig
    //     davon gueltigen Grund: der Rueckruf tat bisher IMMER etwas,
    //     auch wenn VPN gar nicht die gezeigte Seite war - las
    //     user-settings.json neu, fragte den VPN-Status ab (ein eigener
    //     Unterprozess), setzte zwei Knoepfe auf sensitiv und griff
    //     unbedingt nach der Tastatur (usernameEntry/passwordEntry). Das
    //     ist unnoetige Arbeit bei JEDEM Oeffnen der Schale, unabhaengig
    //     von der Seite - und das Fokusgreifen auf ein Feld einer nicht
    //     gezeigten Seite ist falsch, selbst wenn es folgenlos bleibt.
    //     `istAktiv()` (ags-overlay-utils.template) macht daraus das,
    //     was der Name onShow immer versprochen hat: etwas, das nur
    //     laeuft, wenn DIESE Seite auch erscheint.
    win.connect("notify::visible", () => {
      if (!win.visible || !istAktiv()) return
      // IMMER AUF DER LISTE ANFANGEN (01.09.2026) - "ich will eine reine
      // liste bei vpn sehen". Ohne diese Zeile stuende die Seite beim
      // naechsten Oeffnen dort, wo sie zuletzt verlassen wurde, und der
      // Ueberblick waere eine Erinnerungsfrage. Dasselbe tut
      // ags-network.template mit `showMain()` an genau dieser Stelle.
      zeigeListe()
      connectBtn.set_sensitive(true)
      disconnectBtn.set_sensitive(true)
      vpnSettings = loadVpnSettings()
      applyVpnKind()
      updateStatusDisplay()
      // NUR WO ES DIE FELDER GIBT. Unter WireGuard - und unter einer
      // reinen Zertifikatsverbindung von OpenVPN - stehen sie nicht da,
      // und nach der Tastatur zu greifen, wo kein Feld ist, ist genau
      // der Fehler, den der Absatz darueber am 19.08.2026 fuer die
      // falsche Seite behoben hat, nur eine Ebene tiefer. Dieselbe
      // Bedingung wie in applyVpnKind(), damit es nicht zwei geben kann.
      //
      // SEIT DEM 01.09.2026 ist das Fokusgreifen hier absichtlich
      // folgenlos: die Seite steht in diesem Moment auf der Liste, das
      // Feld ist nicht abgebildet, und gtk_widget_grab_focus() tut auf
      // einem nicht abgebildeten Widget nichts. Was bleibt, ist das
      // VORBEFUELLEN - der letzte Benutzername soll dastehen, wenn der
      // Nutzer gleich in die Einzelheit blaettert. Gegriffen wird der
      // Fokus dort, wo das Feld auch sichtbar wird: in schalte().
      if (vpnSettings.kind === "ipsec"
          || (vpnSettings.kind === "openvpn" && vpnSettings.ovpnAuth !== "tls")) {
        const lastUser = loadLastUsername()
        usernameEntry.set_text(lastUser || vpnSettings.username)
        if (lastUser) {
          passwordEntry.grab_focus()
        } else {
          usernameEntry.grab_focus()
        }
      }
    })

    return mainBox
  },
}
