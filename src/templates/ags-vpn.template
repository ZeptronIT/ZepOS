// Load VPN settings dynamically from user-settings.json
function loadVpnSettings() {
  try {
    const [ok, contents] = GLib.file_get_contents(SETTINGS_FILE)
    if (ok && contents) {
      const data = JSON.parse(new TextDecoder().decode(contents))
      // Die Liste bei jedem Lesen mitnehmen, damit Zeilen und
      // Formular nie ueber verschiedene Staende reden.
      vpnListe = vpnConnections(data)
      if (!vpnListe.some((e) => e.id === gewaehlteId)) {
        gewaehlteId = vpnListe.length
          ? (vpnSection(data).active || vpnListe[0].id) : ""
      }
      // Die AUSGEWAEHLTE Verbindung fuellt die beiden Ansichten unten -
      // nicht mehr "der" vpn-Abschnitt, den es seit dem 22.08.2026
      // nicht mehr gibt.
      const gewaehlt = vpnListe.length
        ? (vpnListe.find((e) => e.id === gewaehlteId) || vpnListe[0]) : null
      // UEBER DIE POSITION UND NICHT UEBER DIE ROHE KENNUNG -
      // BERICHTIGT am 01.09.2026
      //
      //     Hier stand `alle.find(e => e.id === gewaehlt.id)`. `alle`
      //     sind die ROHEN Eintraege aus der Datei; `gewaehlt.id` kommt
      //     aus vpnConnections() oben und ist bei einem Eintrag ohne
      //     `id` seit heute "#0". Roh und aufbereitet konnten sich also
      //     nie treffen, find() schlug fehl, und der Ruecksturz
      //     vpnActive() lieferte den ERSTEN Eintrag - fuer jede Zeile
      //     denselben. Genau der stille Fehlgriff, ueber den der Nutzer
      //     geklagt hat.
      //
      //     vpnConnections() filtert in derselben Reihenfolge wie diese
      //     Zeile (`e && typeof e === "object"`), die Position ist also
      //     dieselbe - und sie ist die einzige Auskunft, die BEIDE
      //     Listen sicher teilen.
      const alle = Array.isArray(vpnSection(data).connections)
        ? vpnSection(data).connections.filter(
            (e: any) => e && typeof e === "object")
        : null
      const stelle = gewaehlt ? vpnListe.indexOf(gewaehlt) : -1
      data.vpn = alle
        ? (stelle >= 0 && stelle < alle.length ? alle[stelle] : vpnActive(data))
        : data.vpn
      if (data.vpn) {
        const peers = data.vpn.wireguard?.peers ?? []
        return {
          // Ein unbekannter Wert wird zu "ipsec" und nicht
          // durchgereicht - dieselbe Zurueckhaltung wie
          // src/vpn.py::vpn_kind(). Eine vertippte Bauart darf nicht in
          // eine Verbindung fuehren, die niemand gemeint hat.
          kind: (data.vpn.kind === "wireguard" || data.vpn.kind === "openvpn")
            ? data.vpn.kind : "ipsec",
          server: data.vpn.server || "{{STYLE_VPN_SERVER}}",
          // Was in der verbundenen Ansicht als Gegenstelle steht, wenn
          // es kein IPsec-Gateway gibt. OpenVPN nennt seinen Endpunkt
          // `remote` - dieselbe Zeile, ein dritter Begriff, und nicht
          // eine dritte Zeile, die bei zweien leer bliebe.
          endpoint: data.vpn.kind === "openvpn"
            ? (data.vpn.openvpn?.remote || "")
            : (peers.length ? (peers[0].endpoint || "") : ""),
          // Wie OpenVPN sich ausweist. "tls" heisst: nur Zertifikate,
          // also KEINE Anmeldefelder - genau wie bei WireGuard. Ein
          // unbekannter Wert wird zu "tls" und nicht durchgereicht.
          ovpnAuth: ["password", "password-tls"].includes(
            data.vpn.openvpn?.connection_type) ? data.vpn.openvpn.connection_type : "tls",
          username: (data.vpn.kind === "openvpn"
            ? data.vpn.openvpn?.username : data.vpn.username)
            || "{{STYLE_VPN_USERNAME}}",
          connection_name: data.vpn.connection_name || "{{STYLE_VPN_CONNECTION_NAME}}",
          debug: data.vpn.debug === true
        }
      }
    }
  } catch (e) {
    console.error("Failed to load VPN settings:", e)
  }
  // Fallback to defaults
  return {
    kind: ("{{STYLE_VPN_KIND}}" === "wireguard" || "{{STYLE_VPN_KIND}}" === "openvpn")
      ? "{{STYLE_VPN_KIND}}" : "ipsec",
    server: "{{STYLE_VPN_SERVER}}",
    endpoint: "",
    ovpnAuth: "tls",
    username: "{{STYLE_VPN_USERNAME}}",
    connection_name: "{{STYLE_VPN_CONNECTION_NAME}}",
    debug: false
  }
}

// Dynamic settings (loaded on window open)
