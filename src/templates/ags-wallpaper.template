// Wallpaper Selector Widget for AGS v3 (GTK4)
// Generated by ZepOS
// Features: Per-monitor selection, Portrait/Landscape detection, Import, Delete
// Clean minimal design — Astal.Window overlay

import { Gtk } from "ags/gtk4"
import { execAsync } from "ags/process"
import GLib from "gi://GLib"
import { createOverlayWindow, OverlayWidget } from "../utils/overlay"
import { _, format, pgettext } from "../utils/i18n"
import { zepButton } from "../utils/kit"

const WINDOW_NAME = "wallpaper"

// DIE BREITE IST EINE ADDITION UND KEINE GEGRIFFENE ZAHL
//
//     Unten stand `width: 520` als getippte Zahl in der Fabrik, und
//     `.wp-container` trug `min-width: 500px`. Das Fenster muss neben
//     dem Inhalt auch den Kasten bezahlen, in dem er sitzt - derselbe
//     Fehler wie beim Kalender, die lange Fassung steht in
//     ags-calendar.template.
//
//     GEMESSEN am 17.08.2026 im verschachtelten Compositor, Schirm
//     1920x1080, in beiden Sprachen dieselbe Zahl - der Anspruch dieses
//     Fensters haengt an Bildchen und an keiner Beschriftung:
//
//         .wp-container { min-width: 540px }           540
//         dessen padding {{STYLE_SPACE_16}}, zweimal   +50
//                                                     ----
//         Inhalt, gemessen                             590
//         .overlay-outer, Rahmen 1px, zweimal           +2
//         senkrechte Bildlaufleiste (immer reserviert) +24
//                                                     ----
//                                                      616
//
//     WOHER DIE 540 KOMMEN, steht bei der Regel selbst in
//     ags-style.template: es ist die Breite EINER REIHE aus THUMB_COLS
//     Bildchen. Sie stehen dort und nicht hier, weil die Fabrik den
//     Inhalt misst, BEVOR onShow die Bildchen holt - eine Zahl hier ist
//     ein Deckel ueber einer schon gemessenen Breite und kann sie nicht
//     anheben. Mit min-width 500 stand dieses Fenster 576 breit da -
//     56 Punkte mehr als die 520 vorher - und trug trotzdem noch eine
//     waagerechte Bildlaufleiste: der Inhalt mass mit den Bildchen 588,
//     das Sichtfenster 550.
//
//     SEIT DEM 18.08.2026 nennt dieses Fenster nicht mehr seine eigene
//     Rechnung, sondern die Sprosse darueber: die gemessenen 616
//     passen in M (siehe MODAL_WIDTHS in sizes.py). Die Rechnung
//     bleibt hier stehen, weil sie begruendet, WARUM diese Sprosse und
//     nicht die kleinere.
const WIN_WIDTH = {{STYLE_MODAL_WIDTH_M}}

const HOME = GLib.get_home_dir()
const WALLPAPER_MANAGER = `${HOME}/.local/bin/wallpaper-manager`
const THUMB_COLS = 4 // Thumbnails per row

// Icons
const ICONS = {
  wallpaper: "{{ICON_WALLPAPER}}",
  portrait: "{{ICON_PORTRAIT}}",
  shuffle: "{{ICON_SHUFFLE}}",
  refresh: "{{ICON_REFRESH}}",
  import: "{{ICON_IMPORT}}",
  folder: "{{ICON_FOLDER}}",
  close: "{{ICON_CLOSE}}",
  delete: "{{ICON_TRASH}}",
  monitor: "{{ICON_MONITOR}}",
}

interface WallpaperEntry {
  path: string
  thumb: string
}

interface MonitorInfo {
  id: string
  name: string
  isPortrait: boolean
}

// ============================================================================
// STATE
// ============================================================================
let currentMonitor = "0"
let isPortrait = false
let currentWallpaper = ""
let wallpapers: WallpaperEntry[][] = [] // Rows of wallpapers

// Helper to remove all children from a box (GTK4 doesn't have get_children)
function removeAllChildren(box: Gtk.Box) {
  let child = box.get_first_child()
  while (child) {
    const next = child.get_next_sibling()
    box.remove(child)
    child = next
  }
}

// ============================================================================
// WALLPAPER MANAGER FUNCTIONS
// ============================================================================

// Get wallpapers for a specific monitor (filtered by orientation)
async function getWallpapersForMonitor(monitorId: string, colsPerRow: number): Promise<WallpaperEntry[][]> {
  try {
    const output = await execAsync(`${WALLPAPER_MANAGER} list-for-monitor ${monitorId} ${colsPerRow}`)
    const parsed = JSON.parse(output.trim())
    // Returns array of rows, each row is array of {path, thumb}
    return parsed || []
  } catch (e) {
    console.error("Failed to get wallpapers:", e)
    return []
  }
}

// Check if monitor is portrait
async function getIsPortrait(monitorId: string): Promise<boolean> {
  try {
    const output = await execAsync(`${WALLPAPER_MANAGER} is-portrait ${monitorId}`)
    return output.trim() === "true"
  } catch {
    return false
  }
}

// Get current wallpaper path
async function getCurrentWallpaper(): Promise<string> {
  try {
    // Read from cache file (wallpaper-manager saves current wallpaper here)
    const output = await execAsync("cat ~/.cache/current-wallpaper 2>/dev/null")
    return output.trim() || ""
  } catch {
    return ""
  }
}

// Apply wallpaper to monitor (synchronous spawn for reliability)
function applyWallpaper(path: string, monitorId: string) {
  try {
    const cmd = `${WALLPAPER_MANAGER} apply "${path}" "${monitorId}"`
    console.log(`Applying wallpaper: ${cmd}`)
    GLib.spawn_command_line_async(cmd)
  } catch (e) {
    console.error("Failed to apply wallpaper:", e)
  }
}

// Delete wallpaper
function deleteWallpaper(path: string) {
  try {
    GLib.spawn_command_line_async(`${WALLPAPER_MANAGER} delete "${path}"`)
  } catch (e) {
    console.error("Failed to delete wallpaper:", e)
  }
}

// Set random wallpaper for monitor
function setRandomWallpaper(monitorId: string) {
  try {
    GLib.spawn_command_line_async(`${WALLPAPER_MANAGER} random "${monitorId}"`)
  } catch (e) {
    console.error("Failed to set random wallpaper:", e)
  }
}

// Regenerate thumbnails
function regenerateThumbnails() {
  try {
    GLib.spawn_command_line_async(`${WALLPAPER_MANAGER} regenerate`)
  } catch (e) {
    console.error("Failed to regenerate thumbnails:", e)
  }
}

// Import wallpaper
function importWallpaper(orientation: "portrait" | "landscape") {
  try {
    GLib.spawn_command_line_async(`${WALLPAPER_MANAGER} import ${orientation}`)
  } catch (e) {
    console.error("Failed to import wallpaper:", e)
  }
}

// Get connected monitors dynamically via hyprctl
async function getMonitors(): Promise<MonitorInfo[]> {
  try {
    const output = await execAsync(`${WALLPAPER_MANAGER} list-monitors`)
    const parsed = JSON.parse(output.trim())
    return parsed.map((m: any) => ({
      id: m.id.toString(),
      name: m.name,
      isPortrait: m.portrait,
    }))
  } catch (e) {
    console.error("Failed to get monitors:", e)
    return [{ id: "0", name: _("Unknown"), isPortrait: false }]
  }
}

// ============================================================================
// MAIN WIDGET
// ============================================================================
export default function WallpaperSelector(): OverlayWidget {
  let closeFn: (() => void) | null = null

  // UI elements
  let headerTitle: Gtk.Label
  let sectionIcon: Gtk.Label
  let sectionTitle: Gtk.Label
  let monitorSelector: Gtk.Box
  let monitorButtons: Map<string, Gtk.Button> = new Map()
  let wallpaperGrid: Gtk.Box
  let wallpaperScrollContent: Gtk.Box

  // ============================================================================
  // LOESCHBESTAETIGUNG - UNTERANSICHT STATT EIGENEM FENSTER
  // ============================================================================
  //
  // GEFUNDEN am 18.08.2026 (Aufgabe 10): dieser Dialog baute sich bis
  // heute sein eigenes Fenster direkt aus der GTK-Fensterklasse (statt
  // aus Astal.Window, der Layer-Shell-Klasse der Fabrik). Auf Wayland
  // ist das ein xdg-toplevel und keine Layer-Shell-Flaeche - er bekam Hyprlands
  // Fensterregeln statt der Glasregeln, stand nicht ueber der Leiste,
  // und die Rundung dieses Vorhabens ging an ihm vorbei. Dazu trug er
  // fuenf CSS-Klassen (wp-confirm-dialog/-content/-title/-detail/-btn,
  // destructive), zu denen es in ags-style.template keine einzige Regel
  // gab (GEMESSEN: `grep -c "wp-confirm" ags-style.template` = 0) - ein
  // Knopf in blankem GTK-Standard mitten im ZepOS-Desktop.
  //
  // Die Fensterfrage ist ueber ags-network.template entschieden: dessen
  // Passwortabfrage ist derselbe Fall (eine Rueckfrage in einem schon
  // offenen Fenster) und loest ihn ohne zweites Fenster, ueber eine
  // Unteransicht, `currentView` und `onEscape` (siehe dort, showPassword/
  // showMain). Dieser Weg traegt hier genauso: mainContent und
  // confirmBox liegen als zwei Kinder desselben Astal.Window
  // uebereinander, immer genau eines sichtbar - der Dialog verschwindet
  // damit als eigenes Fenster ganz.
  let currentView: "main" | "confirm" = "main"
  let pendingDeletePath = ""
  let pendingDeleteRefresh: (() => void) | null = null
  let mainContent: Gtk.Box
  let confirmBox: Gtk.Box
  let confirmDetailLabel: Gtk.Label
  let confirmNoBtn: Gtk.Button

  const showMain = () => {
    currentView = "main"
    confirmBox.set_visible(false)
    mainContent.set_visible(true)
  }

  const showDeleteConfirmation = (filename: string, path: string, refreshFn: () => void) => {
    pendingDeletePath = path
    pendingDeleteRefresh = refreshFn
    currentView = "confirm"

    // Kein Template-Literal (uebernommen vom 17.08.2026, dieselbe
    // Stelle): xgettext liest eine Zeichenkette mit ${...} nicht aus,
    // sie bekaeme keinen Katalogeintrag. Der Dateiname kommt als
    // benannter Platzhalter herein.
    confirmDetailLabel.set_text(format(_("Really delete \"{name}\"?"), { name: filename }))

    mainContent.set_visible(false)
    confirmBox.set_visible(true)

    // SICHERUNG GEGEN VERSEHENTLICHES BESTAETIGEN (Aufgabe 10,
    // 18.08.2026): der alte Dialog setzte `can_focus: false` auf BEIDEN
    // Knoepfen - keiner von beiden war je per Tastatur erreichbar, nur
    // per Klick. zepButton() (ags-kit.template) setzt dagegen immer
    // `can_focus: true`, und GtkButton traegt `receives-default: true`
    // als eigenen GTK-Standard (GEPRUEFT per PyGObject-Introspektion,
    // 18.08.2026: `Gtk.Button().get_receives_default()` -> True). Die
    // amtliche Beschreibung dieser Eigenschaft (Gtk-4.0.gir,
    // GtkWidget::receives-default): "Whether the widget will receive
    // the default action when it is focused" - das FOKUSSIERTE Widget
    // bekommt also die Eingabetaste, unabhaengig von einem gesetzten
    // Standardknopf des Fensters (den createOverlayWindow() nirgends
    // setzt). Ohne Gegenmassnahme wuerde die Eingabetaste den Knopf
    // treffen, der zufaellig zuletzt den Fokus hielt.
    //
    // Die Gegenmassnahme ist dieselbe wie in ags-network.template,
    // showPassword(): explizit fokussieren, hier auf "Nein" statt auf
    // ein Eingabefeld. Eingabetaste UND Leertaste treffen damit
    // deterministisch den sicheren Knopf, nicht "Ja".
    confirmNoBtn.grab_focus()
  }

  // ============================================================================
  // CREATE THUMBNAIL
  // ============================================================================
  const createThumbnail = (entry: WallpaperEntry, refreshFn: () => void): Gtk.Button => {
    const btn = new Gtk.Button({ can_focus: false })
    btn.add_css_class("wp-thumb")
    if (entry.path === currentWallpaper) {
      btn.add_css_class("active")
    }

    const filename = entry.path.split("/").pop() || ""
    btn.set_tooltip_text(filename)

    // Try to load thumbnail image (GTK4: use Gtk.Picture for scaling)
    if (entry.thumb && GLib.file_test(entry.thumb, GLib.FileTest.EXISTS)) {
      const picture = new Gtk.Picture()
      picture.set_filename(entry.thumb)
      picture.set_content_fit(Gtk.ContentFit.COVER)
      picture.set_size_request(110, 70)
      picture.add_css_class("wp-thumb-image")
      btn.set_child(picture)
    } else {
      // Placeholder
      const placeholder = new Gtk.Label({ label: ICONS.wallpaper })
      placeholder.add_css_class("wp-placeholder")
      btn.set_child(placeholder)
    }

    // Left click: apply wallpaper
    btn.connect("clicked", () => {
      // Visual feedback that click was received
      //
      // Keine Kommandozeile mehr (17.08.2026): sobald der Text aus dem
      // Katalog kommt, kann ein Anfuehrungszeichen darin stehen - im
      // Englischen jeder Apostroph -, und die Shell zerlegt die Zeile
      // daran und startet notify-send mit den Bruchstuecken. Eine
      // Argumentliste wird von keiner Shell gelesen, also gibt es
      // nichts zu zerlegen; dieselbe Begruendung steht in
      // ags-battery.template. Der Fehlschlag wird verschluckt, weil
      // eine Meldung, die nicht ankommt, das Setzen des Hintergrunds
      // nicht ruecknehmen darf - es hat schon stattgefunden.
      execAsync(["notify-send", _("Wallpaper"),
                 format(_("Setting: {name}"), { name: filename })]).catch(() => {})
      applyWallpaper(entry.path, currentMonitor)
      currentWallpaper = entry.path
      // Refresh after a short delay to let wallpaper apply
      GLib.timeout_add(GLib.PRIORITY_DEFAULT, 500, () => {
        refreshFn()
        return GLib.SOURCE_REMOVE
      })
    })

    // Right click: delete wallpaper (GTK4 GestureClick)
    const rightClick = new Gtk.GestureClick()
    rightClick.set_button(3) // Right mouse button
    rightClick.connect("released", () => {
      showDeleteConfirmation(filename, entry.path, refreshFn)
    })
    btn.add_controller(rightClick)

    return btn
  }

  // ============================================================================
  // REFRESH WALLPAPERS
  // ============================================================================
  const refreshWallpapers = async () => {
    // Get current wallpaper
    currentWallpaper = await getCurrentWallpaper()

    // Get orientation for current monitor
    isPortrait = await getIsPortrait(currentMonitor)

    // Update section header
    sectionIcon.set_text(isPortrait ? ICONS.portrait : ICONS.wallpaper)
    sectionTitle.set_text(isPortrait ? _("PORTRAIT") : _("LANDSCAPE"))

    // Get wallpapers
    wallpapers = await getWallpapersForMonitor(currentMonitor, THUMB_COLS)

    // Rebuild grid
    removeAllChildren(wallpaperScrollContent)

    for (const row of wallpapers) {
      const rowBox = new Gtk.Box({ spacing: 6, halign: Gtk.Align.START })
      rowBox.add_css_class("wp-row")

      for (const entry of row) {
        if (entry.path) {
          rowBox.append(createThumbnail(entry, refreshWallpapers))
        }
      }

      wallpaperScrollContent.append(rowBox)
    }
  }

  // ============================================================================
  // SWITCH MONITOR
  // ============================================================================
  const switchMonitor = async (monitorId: string) => {
    currentMonitor = monitorId

    // Update button states
    monitorButtons.forEach((btn, id) => {
      if (id === monitorId) {
        btn.add_css_class("active")
      } else {
        btn.remove_css_class("active")
      }
    })

    // Update header
    headerTitle.set_text(isPortrait ? _("Portrait Wallpapers") : _("Landscape Wallpapers"))

    await refreshWallpapers()
  }

  // ============================================================================
  // BUILD MONITOR SELECTOR
  // ============================================================================
  const buildMonitorSelector = async () => {
    const monitors = await getMonitors()

    removeAllChildren(monitorSelector)
    monitorButtons.clear()

    if (monitors.length <= 1) {
      // Single monitor - no selector needed
      monitorSelector.set_visible(false)
      return
    }

    monitorSelector.set_visible(true)

    // Das Symbol steht als Platzhalter IM msgid und nicht davor: eine
    // Uebersetzung darf die Reihenfolge aendern duerfen (17.08.2026).
    const label = new Gtk.Label({ label: format(_("{icon} Monitor:"), { icon: ICONS.monitor }) })
    label.add_css_class("wp-monitor-label")
    monitorSelector.append(label)

    for (const mon of monitors) {
      // Ein Buchstabe auf dem Knopf, und im Deutschen ein anderer:
      // Hochformat und Querformat fangen nicht mit P und L an. Der
      // Zusatz ist die Frage, die ein Uebersetzer sonst stellen
      // muesste - siehe pgettext() in utils/i18n.ts (17.08.2026).
      const orientLabel = mon.isPortrait
        ? pgettext("monitor orientation, portrait", "P")
        : pgettext("monitor orientation, landscape", "L")
      // zepButton, Rolle "umrandet" (Task B, 18.08.2026): die Monitore
      // sind gleichrangige Auswahlmoeglichkeiten, keine Hauptsache -
      // dieselbe Einordnung wie battery-profile-btn (Task A). Welcher
      // Monitor GERADE gilt, zeigt weiterhin die Klasse "active" unten
      // (siehe .wp-monitor-selector .zep-btn.active im Stylesheet) und
      // nicht die Rolle.
      const btn = zepButton(`${mon.name} [${orientLabel}]`, "umrandet",
                             () => switchMonitor(mon.id))
      if (mon.id === currentMonitor) {
        btn.add_css_class("active")
      }

      btn.set_tooltip_text(format(_("{monitor} ({orientation})"),
                                  { monitor: mon.name,
                                    orientation: mon.isPortrait ? _("Portrait") : _("Landscape") }))

      monitorButtons.set(mon.id, btn)
      monitorSelector.append(btn)
    }
  }

  // ============================================================================
  // UPDATE DISPLAY (called on show)
  // ============================================================================
  const updateDisplay = async () => {
    await buildMonitorSelector()
    await refreshWallpapers()
  }

  return createOverlayWindow({
    name: WINDOW_NAME,
    width: WIN_WIDTH,
    height: 580,
    cssClass: "WallpaperSelector",
    headerIcon: ICONS.wallpaper,
    headerTitle: _("Wallpapers"),
    accentCssClass: "wallpaper-accent",
    // ESC geht aus der Loeschbestaetigung ZURUECK und nicht ZU -
    // dieselben vier Zeilen wie in ags-network.template (dort: showMain
    // aus der Passwort-/Detailansicht). Ohne sie muesste dieses Fenster
    // sich wieder ein eigenes Astal.Window bauen, um ESC selbst
    // abzufangen - genau der Umweg, den die Fabrik seit dem 12.08.2026
    // ueber `onEscape` erspart.
    onEscape: () => {
      if (currentView === "main") return false
      showMain()
      return true
    },
    // showMain() zuerst (18.08.2026, Aufgabe 10): ein Fenster, das ueber
    // das Schliesskreuz waehrend offener Loeschbestaetigung zugeht,
    // darf beim naechsten Aufgehen nicht wieder in der Unteransicht
    // stehen.
    onShow: () => { showMain(); updateDisplay() },
    buildContent: (_win, closeWindow) => {
      closeFn = closeWindow

      // ============================================================================
      // BUILD UI
      // ============================================================================
      mainContent = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 8,
      })
      mainContent.add_css_class("wp-container")

      // ===== MONITOR SELECTOR =====
      monitorSelector = new Gtk.Box({ spacing: 8, halign: Gtk.Align.CENTER })
      monitorSelector.add_css_class("wp-monitor-selector")

      // ===== WALLPAPERS SECTION =====
      const wallpaperSection = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 8,
      })
      wallpaperSection.add_css_class("wp-section")

      // Section header with orientation and import button
      const sectionHeader = new Gtk.Box({ spacing: 10 })

      sectionIcon = new Gtk.Label({ label: ICONS.wallpaper })
      sectionIcon.add_css_class("wp-section-icon")

      sectionTitle = new Gtk.Label({ label: _("LANDSCAPE") })
      sectionTitle.add_css_class("wp-section-title")

      // Keep headerTitle for switchMonitor updates (not displayed in header anymore)
      headerTitle = new Gtk.Label({ label: _("Landscape Wallpapers") })

      const headerSpacer = new Gtk.Box({ hexpand: true })

      // zepButton, Rolle "still" (Task B, 18.08.2026): ein einzelner
      // Symbol-Knopf am Rand der Abschnittskopfzeile, kein Hauptweg -
      // dieselbe Einordnung wie se-edit-btn (Bearbeiten-Stift je Zeile).
      const importBtn = zepButton(ICONS.import, "still", () => {
        importWallpaper(isPortrait ? "portrait" : "landscape")
        GLib.timeout_add(GLib.PRIORITY_DEFAULT, 1000, () => {
          refreshWallpapers()
          return GLib.SOURCE_REMOVE
        })
      })
      importBtn.set_tooltip_text(_("Import wallpaper"))

      sectionHeader.append(sectionIcon)
      sectionHeader.append(sectionTitle)
      sectionHeader.append(headerSpacer)
      sectionHeader.append(importBtn)

      // Scrollable wallpaper grid
      const wallpaperScroll = new Gtk.ScrolledWindow({
        hscrollbar_policy: Gtk.PolicyType.NEVER,
        vscrollbar_policy: Gtk.PolicyType.AUTOMATIC,
        vexpand: true,
      })
      wallpaperScroll.add_css_class("wp-scroll")

      wallpaperScrollContent = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 6,
      })
      wallpaperScrollContent.add_css_class("wp-grid")

      wallpaperScroll.set_child(wallpaperScrollContent)

      wallpaperSection.append(sectionHeader)
      wallpaperSection.append(wallpaperScroll)

      // ===== DIVIDER =====
      const divider2 = new Gtk.Separator({ orientation: Gtk.Orientation.HORIZONTAL })
      divider2.add_css_class("wp-divider")

      // ===== ACTION BUTTONS =====
      const actionsBox = new Gtk.Box({ spacing: 10, homogeneous: true })
      actionsBox.add_css_class("wp-actions")

      // Random button. zepButton, Rolle "umrandet" (Task B, 18.08.2026):
      // Zufall und Neuaufbau sind zwei gleichrangige Nebenwege - die
      // Hauptsache dieses Fensters ist der Klick auf ein Miniaturbild
      // (wp-thumb, ausserhalb dieses Auftrags), darum kein "voll" hier.
      // Dieselbe Einordnung wie disk-action-btn/calendar-action-btn
      // (Task A, ebenfalls ohne "voll").
      const randomBtn = zepButton("", "umrandet", () => {
        setRandomWallpaper(currentMonitor)
        GLib.timeout_add(GLib.PRIORITY_DEFAULT, 500, () => {
          refreshWallpapers()
          return GLib.SOURCE_REMOVE
        })
      })
      randomBtn.set_tooltip_text(_("Random wallpaper for this monitor"))
      const randomBtnBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 4,
        halign: Gtk.Align.CENTER,
      })
      const randomIcon = new Gtk.Label({ label: ICONS.shuffle })
      randomIcon.add_css_class("wp-action-icon")
      const randomLabel = new Gtk.Label({ label: _("Random") })
      randomLabel.add_css_class("wp-action-label")
      randomBtnBox.append(randomIcon)
      randomBtnBox.append(randomLabel)
      randomBtn.set_child(randomBtnBox)

      // Refresh button, Rolle "umrandet" wie oben.
      const refreshBtn = zepButton("", "umrandet", () => {
        regenerateThumbnails()
        GLib.timeout_add(GLib.PRIORITY_DEFAULT, 2000, () => {
          refreshWallpapers()
          return GLib.SOURCE_REMOVE
        })
      })
      refreshBtn.set_tooltip_text(_("Regenerate thumbnails"))
      const refreshBtnBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 4,
        halign: Gtk.Align.CENTER,
      })
      const refreshIcon = new Gtk.Label({ label: ICONS.refresh })
      refreshIcon.add_css_class("wp-action-icon")
      const refreshLabel = new Gtk.Label({ label: _("Refresh") })
      refreshLabel.add_css_class("wp-action-label")
      refreshBtnBox.append(refreshIcon)
      refreshBtnBox.append(refreshLabel)
      refreshBtn.set_child(refreshBtnBox)

      actionsBox.append(randomBtn)
      actionsBox.append(refreshBtn)

      // ===== ASSEMBLE =====
      mainContent.append(monitorSelector)
      mainContent.append(wallpaperSection)
      mainContent.append(divider2)
      mainContent.append(actionsBox)

      // ===== LOESCHBESTAETIGUNG (Unteransicht, siehe Begruendung bei
      // showDeleteConfirmation() oben) =====
      // AUFGABE 19 (19.08.2026): margin_top/margin_bottom standen hier
      // als nackte 24 - dieselbe Zahl wie STYLE_SPACE_24, aber nie durch
      // die Leiter gelaufen und darum nicht skaliert (GEMESSEN am
      // 19.08.2026: `grep -n "margin_top\|margin_bottom" src/templates/
      // *.template` findet ausserhalb dieser Datei keine weitere
      // Fundstelle). {{STYLE_SPACE_24}} traegt selbst ein "px" (fuer CSS
      // gedacht) und waere hier ein Syntaxfehler im erzeugten
      // TypeScript (dieselbe Falle wie bei WIN_WIDTH, Bericht Aufgabe 3
      // dieses Plans) - parseInt() liest nur die fuehrenden Ziffern und
      // ist damit hier die richtige Bruecke von "px"-Zeichenkette zu
      // nackter Zahl.
      confirmBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 16,
        halign: Gtk.Align.CENTER,
        margin_top: parseInt("{{STYLE_SPACE_24}}"),
        margin_bottom: parseInt("{{STYLE_SPACE_24}}"),
      })
      confirmBox.set_visible(false)

      // Keine eigene CSS-Klasse fuer die beiden Beschriftungen dieser
      // Unteransicht (18.08.2026): dieser Auftrag darf nur
      // ags-wallpaper.template, tests/src/test_schale.py und
      // tests/src/test_button_kit.py aendern, nicht ags-style.template -
      // eine neue Klasse ohne Regel waere genau der Fehler, den dieser
      // Auftrag beseitigt (siehe der Fund zu wp-confirm-btn oben). Das
      // ist keine Verschlechterung gegenueber vorher: `grep -c
      // "wp-confirm" ags-style.template` war schon vorher 0 - auch die
      // alten Klassen (wp-confirm-title/-detail) trugen nie eine Regel.
      const questionLabel = new Gtk.Label({
        label: _("Delete wallpaper?"), halign: Gtk.Align.CENTER,
      })

      // Text kommt bei jedem Aufruf von showDeleteConfirmation() frisch.
      confirmDetailLabel = new Gtk.Label({
        label: "", halign: Gtk.Align.CENTER, wrap: true,
      })

      const confirmButtonBox = new Gtk.Box({ spacing: 10, halign: Gtk.Align.CENTER })

      // "Nein" zuerst, Rolle "still": der sichere Nebenweg, und der
      // Knopf, auf den showDeleteConfirmation() den Tastaturfokus legt
      // (siehe dort).
      confirmNoBtn = zepButton(_("No"), "still", () => showMain())

      // "Ja" in der Rolle "kritisch" - dieselbe Rolle wie disconnectBtn
      // in ags-network.template fuer eine zerstoerende Handlung. Nach
      // Regel 14 wurden die frueheren Klassen "wp-confirm-btn" und
      // "destructive" vollstaendig entfernt statt umbenannt - zepButton
      // traegt die Rolle jetzt selbst (zep-btn-kritisch).
      const confirmYesBtn = zepButton(_("Yes"), "kritisch", () => {
        deleteWallpaper(pendingDeletePath)
        const refresh = pendingDeleteRefresh
        showMain()
        GLib.timeout_add(GLib.PRIORITY_DEFAULT, 500, () => {
          refresh?.()
          return GLib.SOURCE_REMOVE
        })
      })

      confirmButtonBox.append(confirmNoBtn)
      confirmButtonBox.append(confirmYesBtn)

      confirmBox.append(questionLabel)
      confirmBox.append(confirmDetailLabel)
      confirmBox.append(confirmButtonBox)

      // ----- Zwei Ansichten uebereinander, immer genau eine sichtbar -----
      // Derselbe Aufbau wie der `container` in ags-network.template
      // (passwordBox/detailBox/mainContent als direkte Kinder, ueber
      // set_visible() umgeschaltet).
      const container = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
      container.append(mainContent)
      container.append(confirmBox)

      return container
    },
  })
}
