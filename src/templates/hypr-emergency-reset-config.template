#!/bin/bash
# =========================================
# HYPRLAND EMERGENCY RESET SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hypr-emergency-reset-config.template
# =========================================
#
# This script can be run from TTY to recover from a bad configuration
# It will reset Hyprland to a known safe state
# =========================================

# Colors (work in TTY)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Directories
# Settings, profiles and generated helpers belong to the user. A
# generated script runs standalone and cannot import paths.py, so the
# default is spelled out here; an unset variable would expand to nothing
# and turn every path below into one starting at the filesystem root.
ZEPOS_USER_ROOT="${ZEPOS_USER_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/zepos}"

PROFILE_DIR="$ZEPOS_USER_ROOT/profiles"
HYPR_DIR="$HOME/.config/hypr"
# Substituted while generating, not defaulted at run time: this script
# ends up far from the package and cannot work out where that package
# is. A hard-coded installation path would be a guess, and a wrong
# guess aborts here with nothing but "no such file or directory".
ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"

# Log file
LOG_FILE="/tmp/hypr-emergency-reset-$(date +%Y%m%d-%H%M%S).log"

echo -e "${RED}{{ICON_WARNING}} HYPRLAND EMERGENCY RESET${NC}"
echo "====================================="
echo "This script will reset Hyprland to a safe configuration"
echo ""

# Function to log messages
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
    echo "$1"
}

# Function to load a profile
load_profile() {
    local profile=$1

    if [ ! -d "$PROFILE_DIR/$profile" ]; then
        log "{{ICON_ERROR}} Profile '$profile' not found!"
        return 1
    fi

    log "{{ICON_INFO}} Loading profile: $profile"

    # Copy profile files
    cp "$PROFILE_DIR/$profile/monitors.conf" "$HYPR_DIR/monitors.conf" 2>/dev/null
    cp "$PROFILE_DIR/$profile/workspaces.conf" "$HYPR_DIR/workspaces.conf" 2>/dev/null
    cp "$PROFILE_DIR/$profile/profile-env.conf" "$HYPR_DIR/profile-env.conf" 2>/dev/null
    cp "$PROFILE_DIR/$profile/profile-autostart.conf" "$HYPR_DIR/profile-autostart.conf" 2>/dev/null
    cp "$PROFILE_DIR/$profile/profile-keybinds.conf" "$HYPR_DIR/profile-keybinds.conf" 2>/dev/null

    # Generate universal config
    cd "$ZEPOS_SYSTEM_ROOT" || return 1
    ./generate_config.sh -hyprland-universal-config

    # Set current profile
    echo "$profile" > "$HYPR_DIR/current-profile"

    log "{{ICON_SUCCESS}} Profile '$profile' loaded"
    return 0
}

# Check if running from TTY
if [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; then
    log "{{ICON_CHECK}} Running from TTY - Good!"
else
    echo -e "${YELLOW}{{ICON_WARNING}} Warning: Running from graphical session${NC}"
    echo "This script is designed to run from TTY (Ctrl+Alt+F2)"
    read -p "Continue anyway? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# Create backup directory
BACKUP_DIR="$HOME/.config/hypr/emergency-backups/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP_DIR"
log "{{ICON_BACKUP}} Created backup directory: $BACKUP_DIR"

# Backup current configuration
for file in hyprland.conf monitors.conf workspaces.conf profile-env.conf profile-autostart.conf profile-keybinds.conf; do
    if [ -f "$HYPR_DIR/$file" ]; then
        cp "$HYPR_DIR/$file" "$BACKUP_DIR/$file.backup"
        log "{{ICON_BACKUP}} Backed up $file"
    fi
done

# Show recovery options
echo ""
echo "Recovery Options:"
echo "1) Load failsafe configuration (recommended)"
echo "2) Restore last working configuration"
echo "3) Load a saved profile"
echo "4) Exit without changes"
echo ""
read -p "Select option [1-4]: " option

case $option in
    1)
        log "{{ICON_INFO}} Loading failsafe configuration..."

        # Check if failsafe exists
        if [ -f "$HYPR_DIR/hyprland-failsafe.conf" ]; then
            cp "$HYPR_DIR/hyprland-failsafe.conf" "$HYPR_DIR/hyprland.conf"
            log "{{ICON_SUCCESS}} Failsafe configuration loaded"
        else
            log "{{ICON_ERROR}} Failsafe configuration not found!"
            log "{{ICON_INFO}} Creating minimal configuration..."

            # Create minimal config
            cat > "$HYPR_DIR/hyprland.conf" << 'EOF'
# EMERGENCY MINIMAL CONFIGURATION
monitor=,preferred,auto,1
input {
    kb_layout = de
}
general {
    gaps_in = 5
    gaps_out = 10
    border_size = 2
    layout = dwindle
}
# --directory ~ wie in jeder anderen Terminalbindung dieses Systems:
# ein Terminal erbt sonst das Arbeitsverzeichnis des Compositors, und
# das ist in der Notfallkonfiguration am wenigsten vorhersagbar.
bind = SUPER, Q, exec, kitty --directory ~
bind = SUPER, X, killactive
bind = SUPER CTRL ALT, E, exit
bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4
bind = SUPER, 5, workspace, 5
EOF
            log "{{ICON_SUCCESS}} Minimal configuration created"
        fi
        ;;

    2)
        log "{{ICON_INFO}} Looking for last working configuration..."

        # Find most recent backup that's not from today
        LAST_GOOD=$(find "$HOME/.config/hypr/emergency-backups" -name "hyprland.conf.backup" -type f -mtime +0 | sort -r | head -1)

        if [ -n "$LAST_GOOD" ]; then
            cp "$LAST_GOOD" "$HYPR_DIR/hyprland.conf"
            log "{{ICON_SUCCESS}} Restored configuration from: $LAST_GOOD"
        else
            log "{{ICON_ERROR}} No previous backup found"
            exit 1
        fi
        ;;

    3)
        log "{{ICON_INFO}} Available profiles:"

        # List available profiles
        i=1
        declare -a profiles
        for dir in "$PROFILE_DIR"/*/; do
            if [ -d "$dir" ]; then
                name=$(basename "$dir")
                profiles+=("$name")
                echo "  $i) $name"
                ((i++))
            fi
        done

        if [ ${#profiles[@]} -eq 0 ]; then
            log "{{ICON_ERROR}} No profiles found!"
            exit 1
        fi

        echo ""
        read -p "Select profile [1-${#profiles[@]}]: " profile_choice

        if [ "$profile_choice" -ge 1 ] && [ "$profile_choice" -le ${#profiles[@]} ]; then
            selected_profile="${profiles[$((profile_choice-1))]}"
            load_profile "$selected_profile"
        else
            log "{{ICON_ERROR}} Invalid choice"
            exit 1
        fi
        ;;

    4)
        log "{{ICON_INFO}} Exiting without changes"
        exit 0
        ;;

    *)
        log "{{ICON_ERROR}} Invalid option"
        exit 1
        ;;
esac

# Kill any running Hyprland processes
if pgrep -x "Hyprland" > /dev/null; then
    echo -e "${YELLOW}{{ICON_WARNING}} Hyprland is running${NC}"
    read -p "Kill Hyprland process? [y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        pkill -9 Hyprland
        sleep 2
        log "{{ICON_INFO}} Killed Hyprland process"
    fi
fi

echo ""
echo -e "${GREEN}{{ICON_SUCCESS}} Reset complete!${NC}"
echo ""
echo "Next steps:"
echo "1. If in TTY: list-profiles           - the profiles on this machine"
echo "2. Then:      start-hyprland <profile>"
echo ""
echo "Log saved to: $LOG_FILE"
echo ""
echo -e "${BLUE}{{ICON_INFO}} Emergency shortcuts in Hyprland:${NC}"
echo "- SUPER+CTRL+ALT+E: Exit Hyprland"
echo ""
