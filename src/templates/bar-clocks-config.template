#!/bin/bash
# =========================================
# ZUSATZUHREN FÜR DIE LEISTE
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/bar-clocks-config.template
# =========================================
#
# Ersetzt die beiden ortsgebundenen Uhren des Ursprungs. Jede von ihnen
# war eine Zeile mit einer Zeitzone, einer Flagge und einer
# Sprachumgebung eines einzelnen Landes darin, und beide standen
# unbedingt auf der Leiste - zwei Länder eines einzelnen Menschen auf dem
# Bildschirm jedes Nutzers. Wer an einem Ort lebt, wollte keine davon;
# wer Kollegen in drei Zeitzonen hat, konnte keine dritte bekommen, denn
# dafür brauchte es eine dritte Vorlage, einen dritten Erzeugerpfad, ein
# drittes Leistenmodul und eine dritte Stilregel.
#
# Die Zonen kommen jetzt aus den Nutzereinstellungen:
#
#   zepos-settings set clocks.zones '["Europe/Lisbon"]'
#   zepos-settings set clocks.zones '["Asia/Tokyo", "America/New_York"]'
#   zepos-settings set clocks.zones '[{"zone": "Asia/Tokyo", "label": "🇯🇵"}]'
#   zepos-settings set clocks.format '%H:%M:%S'
#
# Ohne eingestellte Zone gibt dieses Modul einen leeren Text aus. Die Leiste
# blendet ein Modul mit leerem Text aus - es ist also nicht bloss stumm,
# sondern unsichtbar, und das ist der Auslieferungszustand. Wer eine
# zweite Uhr will, trägt die Zone ein; niemand sonst tut es für ihn.
#
# WAS EINE ZONE IDENTIFIZIERT
# Der IANA-Name, sonst nichts. Flagge und Sprachumgebung des Ursprungs
# waren aus einem LAND abgeleitet, und von einer Zeitzone gibt es keinen
# verlässlichen Weg zurück zu einem: Europe/Zurich gilt für drei Länder,
# Etc/GMT-3 für keines. Dieses Programm erfindet deshalb keine Abbildung.
# Die Beschriftung ist der letzte Bestandteil des Zonennamens, mit
# Unterstrichen als Leerzeichen ("America/New_York" wird zu "New York") -
# der Name, der sich selbst nennt. Wer eine Flagge will, schreibt sie
# selbst hin, und dann ist sie eine Tatsache über seine Einstellungen und
# keine Behauptung dieses Programms über seine Zeitzone.
#
# WARUM HIER KEIN LANG STEHT
# Der Ursprung setzte LANG=de_DE.UTF-8 vor jeden date-Aufruf. Für %H:%M
# ändert das nichts. Und ist die Sprachumgebung auf dem Rechner nicht
# erzeugt, ändert es auch sonst nichts: date fällt wortlos auf C zurück -
# gemessen mit einer Sprachumgebung, die es nicht gibt: Rückgabewert 0,
# leere Fehlerausgabe, englische Wochentagsnamen. Eine erzwungene
# Sprachumgebung kann also nur zweierlei tun, nichts oder etwas anderes
# als angekündigt. Ohne sie erbt date die Sprachumgebung der Sitzung, und
# die hat der Nutzer selbst gewählt und auf seinem Rechner auch erzeugt.
# Was er wirklich bestimmen will, ist das FORMAT, und das steht unten.
#
# WARUM DAS MODUL IM SEKUNDENTAKT LÄUFT
# Das Leistenmodul in Bar.tsx ruft dieses Skript jede
# Sekunde auf, wie schon die beiden Vorgänger. config.jsonc ist JSON und
# kann keinen Kommentar tragen, deshalb steht die Begründung hier: eine
# Minute springt nicht zu einem Vielfachen des Intervalls, also hinkt
# eine Uhr mit grösserem Intervall bis zu einem Intervall hinterher - und
# eine Uhr, die um eine halbe Minute falsch geht, ist eine falsche Uhr.
# Im Auslieferungszustand kostet das eine kurzlebige Shell, die eine
# feste Zeile druckt und endet; siehe die printf-Zeile weiter unten.

set -u

# Von den Einstellungen gebaut, nicht eingesetzt - siehe src/clocks.py.
# ZONES und LABELS sind gleich lang; der Index verbindet sie.
{{STYLE_CLOCK_ZONES}}

FORMAT={{STYLE_CLOCK_FORMAT}}

# Zeichen zwischen zwei Uhren. Ein Modul, mehrere Zeiten: ohne Trenner
# liest sich "17:00 04:00" wie eine einzige kaputte Angabe.
TRENNER="  ·  "

UHR="{{ICON_CLOCK}}"
UNBEKANNT="{{ICON_QUESTION}}"

# Wo glibc eine Zone nachschlägt. TZDIR ist die Umgebungsvariable, die
# das verschiebt; ohne sie ist es dieses Verzeichnis.
ZEITZONEN="${TZDIR:-/usr/share/zoneinfo}"

# Die Leiste liest eine JSON-Zeile je Aufruf.
#
# Mit jq gebaut und nicht mit printf: die Beschriftung stammt aus einer
# Datei, die ein Mensch von Hand bearbeitet. Ein Anführungszeichen oder
# ein Backslash darin schliesst bei printf die JSON-Zeichenkette zu früh -
# Die Leiste bekommt kaputtes JSON, zeigt gar nichts an und schreibt nirgends
# hin, warum. jq maskiert, was hineingegeben wird.
ausgeben() {
    jq -cn --arg text "$1" --arg tooltip "$2" --arg class "$3" \
        '{text: $text, tooltip: $tooltip, class: $class}'
}

if [ "${#ZONES[@]}" -eq 0 ]; then
    # Hier mit printf und nicht mit jq, als einzige Stelle: alle drei
    # Werte stehen als Literale in dieser Datei, es gibt nichts zu
    # maskieren - und dies ist der Zustand, in dem die grosse Mehrheit
    # der Rechner dieses Modul im Intervall aufruft. Ein jq-Prozess je
    # Sekunde, um dreimal dasselbe Nichts zu drucken, wäre der teuerste
    # Teil eines Moduls, das nichts anzeigt.
    printf '{"text": "", "tooltip": "Keine Zusatzuhr eingestellt (clocks.zones).", "class": "clocks-unconfigured"}\n'
    exit 0
fi

texte=()
zeilen=()
klasse="clocks-ok"

for index in "${!ZONES[@]}"; do
    zone="${ZONES[$index]}"
    beschriftung="${LABELS[$index]}"

    # Erst nachschlagen, dann fragen. date nimmt eine Zone, die es nicht
    # gibt, wortlos an: `TZ=Mars/Olympus_Mons date` liefert Rückgabewert
    # 0 und die UTC-Zeit, mit "Mars" als Kürzel der Zeitzone. Nichts an
    # der Ausgabe sagt, dass sie nicht die erfragte ist - ein Tippfehler
    # in den Einstellungen wird so zu einer Uhr, die still um Stunden
    # falsch geht und geglaubt wird, weil sie wie eine Uhr aussieht.
    if [ ! -f "$ZEITZONEN/$zone" ]; then
        texte+=("$beschriftung $UNBEKANNT")
        zeilen+=("$zone: unbekannte Zeitzone (timedatectl list-timezones zeigt die bekannten)")
        klasse="clocks-unknown-zone"
        continue
    fi

    zeit=$(TZ="$zone" date +"$FORMAT")
    texte+=("$beschriftung $zeit")
    zeilen+=("$zone: $zeit")
done

text=""
for index in "${!texte[@]}"; do
    if [ "$index" -eq 0 ]; then
        text="${texte[$index]}"
    else
        text="$text$TRENNER${texte[$index]}"
    fi
done

tooltip=""
for zeile in "${zeilen[@]}"; do
    if [ -z "$tooltip" ]; then
        tooltip="$zeile"
    else
        tooltip="$tooltip"$'\n'"$zeile"
    fi
done

ausgeben "$UHR  $text" "$tooltip" "$klasse"
