# =========================================
# HYPRLAND PLUGINS
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hyprland-plugins-config.template
# =========================================
#
# hyprland.conf sourced diese Datei. Alles, was ein GELADENES Plugin
# voraussetzt, steht hier und nirgendwo sonst: die plugin=-Zeile selbst,
# der plugin{}-Block mit den Einstellungen und jede Tastenbelegung, deren
# Dispatcher aus einem Plugin kommt. Alle drei sind Konfigurationsfehler,
# sobald das Plugin fehlt - und zwar in der einen Datei, deren Scheitern
# den Nutzer die Sitzung kostet.
#
# Ein Block wird nur geschrieben, wenn das zugehoerige
# /usr/lib/hyprland/plugins/<name>.so in dem Moment vorhanden ist, in dem
# diese Datei erzeugt wird. Fehlt es, steht an seiner Stelle ein
# Kommentar mit Grund, Paketname und dem Befehl zum Nachziehen. Eine
# Datei aus lauter Kommentaren ist eine gueltige Hyprland-Konfiguration:
# der Desktop startet auch dann, wenn kein einziges Plugin da ist.
#
# start-hyprland erzeugt die Datei unmittelbar vor jedem Sitzungsstart
# neu. Warum das der spaetestmoegliche Zeitpunkt ist und was
# zepos-doctor darueber hinaus meldet, steht in src/plugins.py.
#
# Die Marker "# zepos-plugin <name>" ... "# zepos-plugin-end" sind die
# Syntax von src/plugins.py, nicht die von Hyprland.

# =========================================
# HYPRBARS - Fenster-Titelleisten
# =========================================

# WARUM HIER KEINE RUNDUNG STEHT, UND DAS IST GEMESSEN
#     GEMELDET am 17.08.2026: "auch die fenster die erscheinen wie
#     terminal mit dem hyprland header sind nicht so rund wie unsere
#     waybar".
#
#     NACHGEZAEHLT am selben Tag an den addConfigValueV2-Zeilen in
#     hyprbars/main.cpp der ausgelieferten Quelle
#     (packaging/hyprland-plugins/): das Plugin kennt achtzehn Optionen -
#     bar_color, col.text, inactive_button_color, bar_height,
#     bar_text_size, bar_text_weight, bar_title_enabled, bar_blur,
#     bar_text_font, bar_text_align, bar_part_of_window,
#     bar_precedence_over_border, bar_buttons_alignment, bar_padding,
#     bar_button_padding, enabled, icon_on_hover, on_double_click. KEINE
#     davon heisst rounding.
#
#     Es braucht auch keine: barDeco.cpp Zeile 489 rechnet
#
#         const auto ROUNDING = PWINDOW->rounding()
#                             + (PRECEDENCE ? 0 : PWINDOW->getRealBorderSize());
#
#     und rendert die Titelleiste damit (Zeile 537/539, `.round =
#     scaledRounding`). Die beiden OBEREN Ecken folgen also
#     `decoration:rounding` aus hyprland-universal-config.template von
#     selbst - und das ist seit dem 17.08.2026 dieselbe Sprosse wie die
#     Platte der Leiste.
#
#     Das ist ein BEFUND und keine Luecke: eine Rundung, die man hier
#     einstellen koennte, waere eine zweite Zahl neben der des Fensters,
#     und die beiden liefen auseinander.
# zepos-plugin hyprbars
plugin {
    hyprbars {
        bar_height = {{STYLE_HYPRBARS_HEIGHT}}
        bar_color = {{STYLE_HYPRBARS_BG_COLOR}}
        col.text = {{STYLE_HYPRBARS_TEXT_COLOR}}
        bar_text_size = {{STYLE_HYPRBARS_TEXT_SIZE}}
        bar_text_font = {{STYLE_FONT_NAME_TEXT}}
        bar_padding = 6
        bar_button_padding = 6

        # Close Button (rechts)
        hyprbars-button = {{STYLE_HYPRBARS_BUTTON_CLOSE_COLOR}}, {{STYLE_HYPRBARS_BUTTON_SIZE}}, {{ICON_CLOSE}}, hyprctl dispatch killactive

        # Minimize Button (mitte)
        hyprbars-button = {{STYLE_HYPRBARS_BUTTON_MINIMIZE_COLOR}}, {{STYLE_HYPRBARS_BUTTON_SIZE}}, {{ICON_MINIMIZE}}, hyprctl dispatch movetoworkspacesilent special:minimized

        # Maximize Button (links)
        hyprbars-button = {{STYLE_HYPRBARS_BUTTON_MAXIMIZE_COLOR}}, {{STYLE_HYPRBARS_BUTTON_SIZE}}, {{ICON_MAXIMIZE}}, hyprctl dispatch fullscreen 1
    }
}

# Titelleisten aus- und wieder einblenden. Das Skript setzt
# plugin:hyprbars:bar_height per hyprctl - eine Option, die es ohne das
# geladene Plugin nicht gibt.
# @Fenster: Titelleisten der Fenster ein- und ausblenden (hyprbars-toggle)
bind = $mainMod ALT, B, exec, ~/.local/bin/hyprbars-toggle
# zepos-plugin-end

# =========================================
# BORDERS-PLUS-PLUS - zusaetzliche Fensterrahmen
# =========================================

# zepos-plugin borders-plus-plus
# Keine ZepOS-Vorgaben. Das Plugin zeichnet erst dann etwas, wenn
# plugin:borders-plus-plus:add_borders gesetzt wird; geladen wird es
# hier, damit genau das ohne Neuerzeugung der Konfiguration moeglich ist.
# zepos-plugin-end

# =========================================
# HYPRLAUNCH - Anwendungsstarter
# =========================================

# zepos-plugin hyprlaunch
# @Anwendungen: Anwendungsstarter
bind = $mainMod, SPACE, hyprlaunch:toggle,
# Hier stand `bind = $mainMod SHIFT, H, hyprlaunch:helpers,`.
#
# Die Taste ist nicht weg, sie ist gewandert: sie steht jetzt in
# hyprland-universal-config.template und oeffnet `zepos-menu --show all`.
# Der Grund ist die Beschwerde vom 11.08.2026 - "das Bildschirmfoto-
# Werkzeug fehlt", wo nichts fehlte. Genau die Taste, die ein Nutzer
# drueckt, wenn er etwas SUCHT, war ohne dieses Plugin an nichts
# gebunden, und die Tastenuebersicht bot sie trotzdem an. Eine Suche, die
# es nur auf Maschinen mit geladenem Plugin gibt, ist keine.
# zepos-plugin-end

# zepos-plugin-missing hyprlaunch
# SUPER+SPACE ist der Anwendungsstarter. Ein Desktop, dessen Starter eine
# tote Taste ist, ist einem nicht gestarteten Desktop sehr nahe - also
# uebernimmt zepos-menu, das ohnehin Pflichtpaket ist und eine erzeugte
# Konfiguration mitbringt.
#
# Es haengt ausdruecklich NICHT an hyprlaunch: dieser Block wird genau
# dann geschrieben, wenn hyprlaunch fehlt, und ein Rueckfall, der das
# Fehlende braucht, ist keiner.
#
# `--show all` und nicht mehr `--show drun`: ohne das Plugin ist das hier
# das einzige Fenster, das auf eine getippte Zeichenkette antwortet, und
# es kann seit dem 12.08.2026 mehr als Anwendungen - jede beschriebene
# Bindung dieser Sitzung steht mit ihrer Taste darin. Wer den Starter
# oeffnet, weil er etwas sucht, findet es dann auch, wenn es keine
# Anwendung ist.
# @Anwendungen: Anwendungsstarter und Suche ueber alles (zepos-menu)
bind = $mainMod, SPACE, exec, zepos-menu --show all
# zepos-plugin-end

# =========================================
# HYPRCLIPX - Zwischenablage-Verlauf
# =========================================

# zepos-plugin hyprclipx
# @Zwischenablage: Zwischenablage-Verlauf
bind = $mainMod SHIFT, V, hyprclipx:toggle,
# zepos-plugin-end

# zepos-plugin-missing hyprclipx
# Derselbe Verlauf ueber zepos-menu. `wl-paste --watch cliphist store`
# sammelt ihn seit dem Login unabhaengig vom Plugin ein, das Skript wird
# ohnehin erzeugt und haengt auf SUPER+ALT+V - hier bekommt es
# zusaetzlich die Taste, die der Nutzer dafuer kennt.
# @Zwischenablage: Zwischenablage-Verlauf mit Favoriten (cliphist-menu.sh)
bind = $mainMod SHIFT, V, exec, ~/.config/hypr/cliphist-menu.sh
# zepos-plugin-end

# =========================================
# HYPRZONES - zonenbasiertes Tiling
# =========================================
# Zone-Snapping: SHIFT + Fenster ziehen
# Multi-Zone Auswahl: CTRL + SHIFT + Fenster ziehen

# zepos-plugin hyprzones
# Zone Editor oeffnen
# @Zonen: Zonen-Editor oeffnen (hyprctl)
bind = $mainMod SHIFT, Z, exec, hyprctl dispatch hyprzones:editor

# Zonen-Overlay einblenden und wieder ausblenden.
#
# Zwei Tasten, weil es zwei Dispatcher sind: hyprzones:show und
# hyprzones:hide. Hier stand nur der erste, mit dem Kommentar "toggle
# (anzeigen/verstecken)" darueber - der Dispatcher schaltet aber nicht
# um, und die Shortcut-Uebersicht bot SUPER+ALT+SHIFT+Z zum Ausblenden
# an, ohne dass es die Taste gab. Das Overlay liess sich also einblenden
# und nicht mehr wegbekommen.
# @Zonen: Zonen einblenden (hyprctl)
bind = $mainMod ALT, Z, exec, hyprctl dispatch hyprzones:show
# @Zonen: Zonen wieder ausblenden (hyprctl)
bind = $mainMod ALT SHIFT, Z, exec, hyprctl dispatch hyprzones:hide

# Layout wechseln (naechstes/vorheriges)
# @Zonen: Naechstes Zonen-Layout (hyprctl)
bind = $mainMod CTRL, bracketright, exec, hyprctl dispatch hyprzones:cycle +1
# @Zonen: Vorheriges Zonen-Layout (hyprctl)
bind = $mainMod CTRL, bracketleft, exec, hyprctl dispatch hyprzones:cycle -- -1

# Fenster zu Zone 1-9 bewegen
# @Zonen: Fenster in Zone 1 (hyprctl)
bind = $mainMod CTRL, 1, exec, hyprctl dispatch hyprzones:moveto 1
# @Zonen: Fenster in Zone 2 (hyprctl)
bind = $mainMod CTRL, 2, exec, hyprctl dispatch hyprzones:moveto 2
# @Zonen: Fenster in Zone 3 (hyprctl)
bind = $mainMod CTRL, 3, exec, hyprctl dispatch hyprzones:moveto 3
# @Zonen: Fenster in Zone 4 (hyprctl)
bind = $mainMod CTRL, 4, exec, hyprctl dispatch hyprzones:moveto 4
# @Zonen: Fenster in Zone 5 (hyprctl)
bind = $mainMod CTRL, 5, exec, hyprctl dispatch hyprzones:moveto 5
# @Zonen: Fenster in Zone 6 (hyprctl)
bind = $mainMod CTRL, 6, exec, hyprctl dispatch hyprzones:moveto 6
# @Zonen: Fenster in Zone 7 (hyprctl)
bind = $mainMod CTRL, 7, exec, hyprctl dispatch hyprzones:moveto 7
# @Zonen: Fenster in Zone 8 (hyprctl)
bind = $mainMod CTRL, 8, exec, hyprctl dispatch hyprzones:moveto 8
# @Zonen: Fenster in Zone 9 (hyprctl)
bind = $mainMod CTRL, 9, exec, hyprctl dispatch hyprzones:moveto 9
# zepos-plugin-end
