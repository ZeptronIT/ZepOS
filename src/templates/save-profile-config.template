#!/bin/bash
# =========================================
# SAVE PROFILE SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/save-profile-config.template
# =========================================
#
# Saves the current monitor arrangement as a named profile
# Usage: save-profile <name>
# =========================================

# Settings, profiles and generated helpers belong to the user. A
# generated script runs standalone and cannot import paths.py, so the
# default is spelled out here; an unset variable would expand to nothing
# and turn every path below into one starting at the filesystem root.
ZEPOS_USER_ROOT="${ZEPOS_USER_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/zepos}"

PROFILE_DIR="$ZEPOS_USER_ROOT/profiles"
HYPR_DIR="$HOME/.config/hypr"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

PROFILE_NAME="${1:-}"

if [ -z "$PROFILE_NAME" ]; then
    echo -e "${RED}{{ICON_ERROR}} Error: No profile name specified${NC}"
    echo ""
    echo "Usage: save-profile <name>"
    echo ""
    echo "Example: save-profile laptop"
    echo "         save-profile desktop"
    echo "         save-profile my-setup"
    exit 1
fi

# Check whether there is an arrangement to save at all
if [ ! -f "$HYPR_DIR/monitors.conf" ]; then
    echo -e "${RED}{{ICON_ERROR}} No monitors.conf found!${NC}"
    echo ""
    echo "Please arrange your monitors first:"
    echo "  1. Open Systemeinstellungen (SUPER+SPACE)"
    echo "  2. Page 'Bildschirme': drag the screens into place"
    echo "  3. Press 'Anwenden' and confirm"
    echo "  4. Run: save-profile $PROFILE_NAME"
    exit 1
fi

# Create profile directory if needed
mkdir -p "$PROFILE_DIR/$PROFILE_NAME"

# Check if profile already exists
if [ -f "$PROFILE_DIR/$PROFILE_NAME/monitors.conf" ]; then
    echo -e "${YELLOW}{{ICON_WARNING}} Profile '$PROFILE_NAME' already exists!${NC}"
    read -p "Overwrite? [y/N]: " confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
        echo "{{ICON_CANCEL}} Cancelled."
        exit 0
    fi
fi

echo "{{ICON_SAVE}} Saving profile '$PROFILE_NAME'..."

# Copy the arrangement and the workspace assignments
cp "$HYPR_DIR/monitors.conf" "$PROFILE_DIR/$PROFILE_NAME/"
cp "$HYPR_DIR/workspaces.conf" "$PROFILE_DIR/$PROFILE_NAME/"

echo "{{ICON_CHECK}} Copied monitors.conf"
echo "{{ICON_CHECK}} Copied workspaces.conf"

# Create default profile files if they don't exist
if [ ! -f "$PROFILE_DIR/$PROFILE_NAME/profile-env.conf" ]; then
    echo "{{ICON_NEW}} Creating default profile-env.conf..."
    cat > "$PROFILE_DIR/$PROFILE_NAME/profile-env.conf" << 'EOF'
# =========================================
# PROFILE ENVIRONMENT - Edit as needed
# =========================================

# Border color
general {
    col.active_border = rgb(00ff00)
}

# GPU Settings (uncomment appropriate section)

# === Intel GPU (Laptops) ===
# env = WLR_DRM_DEVICES,/dev/dri/card1
# env = AQ_DRM_DEVICES,/dev/dri/card1
# env = MESA_LOADER_DRIVER_OVERRIDE,iris

# === NVIDIA GPU ===
# env = LIBVA_DRIVER_NAME,nvidia
# env = GBM_BACKEND,nvidia-drm
# env = __GLX_VENDOR_LIBRARY_NAME,nvidia
# env = WLR_NO_HARDWARE_CURSORS,1

# === AMD GPU ===
# env = LIBVA_DRIVER_NAME,radeonsi
EOF
fi

if [ ! -f "$PROFILE_DIR/$PROFILE_NAME/profile-autostart.conf" ]; then
    echo "{{ICON_NEW}} Creating default profile-autostart.conf..."
    cat > "$PROFILE_DIR/$PROFILE_NAME/profile-autostart.conf" << 'EOF'
# =========================================
# PROFILE AUTOSTART - Edit as needed
# =========================================

# Initialize workspaces
exec-once = bash -c 'sleep 0.5; for i in {1..10}; do hyprctl dispatch workspace $i; done; sleep 0.5; hyprctl dispatch workspace 1'
EOF
fi

if [ ! -f "$PROFILE_DIR/$PROFILE_NAME/profile-keybinds.conf" ]; then
    echo "{{ICON_NEW}} Creating default profile-keybinds.conf..."
    cat > "$PROFILE_DIR/$PROFILE_NAME/profile-keybinds.conf" << 'EOF'
# =========================================
# PROFILE KEYBINDINGS - Edit as needed
# =========================================

$mainMod = SUPER

# Volume Control (adjust for your hardware)
bind = , XF86AudioRaiseVolume, exec, pactl set-sink-volume @DEFAULT_SINK@ +5%
bind = , XF86AudioLowerVolume, exec, pactl set-sink-volume @DEFAULT_SINK@ -5%
bind = , XF86AudioMute, exec, pactl set-sink-mute @DEFAULT_SINK@ toggle
EOF
fi

echo ""
echo -e "${GREEN}{{ICON_SUCCESS}} Profile '$PROFILE_NAME' saved!${NC}"
echo ""
echo -e "${CYAN}Files saved to: $PROFILE_DIR/$PROFILE_NAME/${NC}"
echo ""
echo "To use this profile:"
echo "  go-$PROFILE_NAME    (if alias exists)"
echo "  start-hyprland $PROFILE_NAME"
echo ""
echo "To edit profile settings:"
echo "  $PROFILE_DIR/$PROFILE_NAME/profile-env.conf      (GPU, colors)"
echo "  $PROFILE_DIR/$PROFILE_NAME/profile-autostart.conf (startup apps)"
echo "  $PROFILE_DIR/$PROFILE_NAME/profile-keybinds.conf  (keybindings)"
