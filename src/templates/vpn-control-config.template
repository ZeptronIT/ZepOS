#!/bin/bash
# =========================================
# VPN CONTROL SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/vpn-control-config.template
# =========================================
#
# This script manages StrongSwan IPsec VPN connections
# Supports hardware token authentication
# =========================================

# Substituted while generating, not defaulted at run time: this script
# ends up far from the package and cannot work out where that package
# is. A hard-coded installation path would be a guess, and a wrong
# guess aborts here with nothing but "no such file or directory".
ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"
ZEPOS_USER_ROOT="${ZEPOS_USER_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/zepos}"

# Dieses Skript sieht Benutzername, Passwort, Sudo-Passwort und
# Einmal-Token. Alles, was es anlegt, gehoert vom ersten Byte an nur dem
# Benutzer - nicht erst nach einem chmod, das eine Sekunde spaeter laeuft.
# Dieselbe Begruendung steht in installer/core/netprofile.py:161.
umask 077

PSK_FILE="$HOME/.config/strongswan/psk"
# From vpn.connection_name, the same value the AGS widget passes as the
# connect script's sixth argument. This was the origin's own connection
# name, written in by hand, so the two callers disagreed the moment
# anybody renamed their connection - and the disagreement only showed on
# DISCONNECT, where `swanctl --terminate --ike work-ipsec` quietly
# terminated nothing and left the tunnel up.
VPN_CONNECTION="{{STYLE_VPN_CONNECTION_NAME}}"
# The same list the connect script installs its routes from. Disconnect
# used to delete three networks written out by hand, so every network
# beyond those three stayed in the main table and in table 220 after a
# disconnect, pointing through an interface that no longer carried them.
ROUTED_NETWORKS="{{STYLE_VPN_ROUTED_NETWORKS}}"

# Das Protokoll liegt auf dem tmpfs des Benutzers, nicht in /tmp.
#
# Es trug den Benutzernamen und den Einmal-Token im Klartext, unter einem
# aus dem Datum vorhersagbaren Namen, in einem Verzeichnis, das jedes
# Konto der Maschine lesen kann. Der Token steht jetzt nirgends mehr -
# ein Einmal-Token in einer Logdatei ist entweder abgelaufen und nutzlos
# oder gueltig und gefaehrlich - und das Verzeichnis gehoert nur dem
# Benutzer und wird beim Abmelden geleert.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/zepos-vpn"
mkdir -p "$RUNTIME_DIR"
LOG_FILE="$RUNTIME_DIR/vpn-control-$(date +%Y%m%d).log"

# Die vom Generator erzeugte Rechte-Regel und der Hinweis darauf. Ohne
# sie kann nichts, was kein Terminal hat, Root-Rechte bekommen.
POLICY_FILE="$ZEPOS_USER_ROOT/system/zepos"
POLICY_TARGET="/etc/sudoers.d/zepos"
SUDOERS_HINT="Rechte-Regel installieren: $0 install-privileges"

# Function to log messages
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# Function to send notification
notify_send() {
    local urgency=$1
    local title=$2
    local message=$3
    
    if command -v notify-send &> /dev/null; then
        notify-send -u "$urgency" -i network-vpn "$title" "$message"
    fi
}

# Welche Adresse der Tunnel hat und ob er steht, beantwortet vpn.py -
# aus dem Bericht von strongSwan bzw. aus dem, was das Verbindungsskript
# von dort notiert hat. Dieses Skript leitet nichts davon selbst ab.
vpn_query() {
    python3 "$ZEPOS_SYSTEM_ROOT/vpn.py" "$@"
}

# connected | stale | disconnected | unknown, und die notierte Adresse
# dazu.
#
# Hier stand ein `grep` ueber `ip addr show` auf den Adressbereich eines
# bestimmten Gateways. Fuer jedes andere war die Antwort dauerhaft
# "getrennt", und das kostete mehr als eine falsche Anzeige: das Trennen
# stieg gleich zu Beginn mit "Already disconnected" aus, ohne irgendetwas
# abzubauen, und meldete Erfolg.
#
# DIE LEERE ANTWORT HEISST SEIT DEM 01.09.2026 "unknown" UND NICHT MEHR
# "disconnected"
#     Hier stand `${VPN_STATE:-disconnected}`, und das war derselbe
#     Fehler eine Ebene hoeher als der, den src/vpn.py an diesem Tag
#     ablegt: vpn.py gar nicht ausfuehrbar, kein python3, ein Abbruch
#     mitten im Lesen - alles wurde zu "der Tunnel steht nicht". Das
#     Wort dafuer gibt es jetzt, und es zu benutzen kostet nichts:
#     `disconnected` behaelt genau die Faelle, in denen vpn.py es
#     GESCHRIEBEN hat.
read_vpn_state() {
    local line
    line=$(vpn_query --status 2>/dev/null) || line=""
    VPN_STATE="${line%% *}"
    VPN_STATE="${VPN_STATE:-unknown}"
    case "$line" in
        *" "*) VPN_VIP="${line#* }" ;;
        *)     VPN_VIP="" ;;
    esac
}

# Function to check VPN status
check_vpn_status() {
    read_vpn_state
    [ "$VPN_STATE" = "connected" ]
}

# Function to connect VPN
connect_vpn() {
    log_message "Attempting to connect VPN..."
    
    if check_vpn_status; then
        notify_send "normal" "VPN Status" "Already connected"
        return 0
    fi
    
    # Check if PSK file exists
    if [ ! -f "$PSK_FILE" ]; then
        notify_send "critical" "VPN Error" "PSK file not found at $PSK_FILE"
        log_message "ERROR: PSK file not found"
        return 1
    fi
    
    # Read PSK
    PSK=$(cat "$PSK_FILE")
    
    # Load last username if saved
    LAST_USER_FILE="$HOME/.config/strongswan/last_user"
    # Das Verzeichnis existiert, sobald der Benutzer seinen PSK abgelegt
    # hat - aber nur dann. Ohne diese Zeile scheitert das Merken des
    # Benutzernamens weiter unten still, an einer Fehlermeldung, die
    # niemand sieht.
    mkdir -p "$(dirname "$LAST_USER_FILE")"
    if [ -f "$LAST_USER_FILE" ]; then
        LAST_USER=$(cat "$LAST_USER_FILE")
    else
        LAST_USER="{{STYLE_VPN_USERNAME}}"
    fi
    
    # Request credentials via yad forms dialog (better than zenity)
    #
    # Drei Felder, nicht vier: nach dem Sudo-Passwort wird nicht mehr
    # gefragt. Es wurde dem Verbindungsskript als drittes Argument
    # mitgegeben, und ein Argument steht fuer die Dauer des Prozesses in
    # /proc/<pid>/cmdline, das jedes Konto der Maschine lesen kann. Die
    # Befehle, fuer die es gedacht war, stehen jetzt in
    # /etc/sudoers.d/zepos.
    if command -v yad &> /dev/null; then
        # Create a combined form with pre-filled username
        CREDENTIALS=$(yad --form --title="VPN Login" \
            --text="Enter your VPN credentials" \
            --field="Username" "$LAST_USER" \
            --field="Password:H" "" \
            --field="2FA Token" "" \
            --focus-field=2 \
            --separator=$'\n' \
            2>/dev/null)

        if [ -z "$CREDENTIALS" ]; then
            notify_send "normal" "VPN" "Connection cancelled"
            return 1
        fi

        # Parse YAD output
        USERNAME=$(echo "$CREDENTIALS" | sed -n '1p')
        PASSWORD=$(echo "$CREDENTIALS" | sed -n '2p')
        TOKEN=$(echo "$CREDENTIALS" | sed -n '3p')

        # Check all fields are filled
        if [ -z "$USERNAME" ] || [ -z "$PASSWORD" ] || [ -z "$TOKEN" ]; then
            notify_send "critical" "VPN Error" "All fields are required"
            return 1
        fi
        
        # Nur Laengen, kein einziger Wert. Der Ursprung schrieb hier den
        # Benutzernamen und den Einmal-Token im Klartext ins Protokoll.
        log_message "Zugangsdaten erfasst (Passwort ${#PASSWORD} Zeichen, Token ${#TOKEN} Zeichen)"

        # Save username for next time. Kein chmod dahinter: die umask
        # ganz oben legt die Datei mit 0600 an, statt sie erst
        # world-readable zu erzeugen und danach zu verengen.
        echo "$USERNAME" > "$LAST_USER_FILE"
    elif command -v zenity &> /dev/null; then
        # Fallback to zenity if yad not available
        CREDENTIALS=$(zenity --forms --title="VPN Login" \
            --text="Enter your VPN credentials\nLast user: $LAST_USER" \
            --add-entry="Username" \
            --add-password="Password" \
            --add-entry="2FA Token" \
            --separator=$'\n' \
            2>/dev/null)

        if [ -z "$CREDENTIALS" ]; then
            notify_send "normal" "VPN" "Connection cancelled"
            return 1
        fi

        # Parse the credentials - wie oben ohne Sudo-Passwort.
        USERNAME=$(echo "$CREDENTIALS" | sed -n '1p')
        PASSWORD=$(echo "$CREDENTIALS" | sed -n '2p')
        TOKEN=$(echo "$CREDENTIALS" | sed -n '3p')

        # Check all fields are filled
        if [ -z "$USERNAME" ] || [ -z "$PASSWORD" ] || [ -z "$TOKEN" ]; then
            notify_send "critical" "VPN Error" "All fields are required"
            return 1
        fi
        
        # Wie oben: Laengen statt Werte.
        log_message "Zugangsdaten erfasst (Passwort ${#PASSWORD} Zeichen, Token ${#TOKEN} Zeichen)"

        # Save username for next time
        echo "$USERNAME" > "$LAST_USER_FILE"
    else
        notify_send "critical" "VPN Error" "Neither yad nor zenity found - please install one of them"
        return 1
    fi
    
    notify_send "normal" "VPN" "Opening connection terminal..."
    
    # Generate vpn-connect script first if needed
    if [ ! -f "$HOME/.config/ags/scripts/vpn-connect.sh" ]; then
        "$ZEPOS_SYSTEM_ROOT/generate_config.sh" -vpn-connect-script
    fi
    
    # Open terminal and run the connect script
    #
    # Der dritte Platz bleibt leer. Er ist der Sudo-Passwort-Platz der
    # sieben Argumente, die auch das AGS-Widget uebergibt; das
    # Verbindungsskript liest ihn nicht mehr, und was hier stuende, waere
    # fuer jedes Konto der Maschine in /proc/<pid>/cmdline zu lesen. Die
    # Reihenfolge bleibt, damit der zweite Aufrufer weiter passt.
    kitty --class=vpn-connection \
          --title="VPN Connection Progress" \
          -o remember_window_size=no \
          -o initial_window_width=120 \
          -o initial_window_height=40 \
          -o window_padding_width=10 \
          --hold \
          -e "$HOME/.config/ags/scripts/vpn-connect.sh" "$USERNAME" "$PASSWORD" "" "$TOKEN" "$PSK" "$VPN_CONNECTION" "$LOG_FILE"
    
    # Log the action
    log_message "VPN connection attempt completed"
    return 0
}

# Ein privilegierter Befehl - ohne gespeichertes Passwort.
#
# Der Ursprung las hier das Login-Passwort aus
# $XDG_RUNTIME_DIR/vpn-sudo-cache und schob es `sudo -S` unter. Die
# Befehle, die diese Datei braucht, stehen jetzt in /etc/sudoers.d/zepos;
# `sudo -n` fuehrt sie ohne Passwort aus. Ist die Regel nicht
# installiert, bleibt pkexec - der Polkit-Agent der Sitzung fragt dann
# nach, was beim Trennen per Mausklick in Ordnung ist und im Watcher, der
# niemanden fragen kann, ausdruecklich nicht vorkommt.
#
# Die zweite Fassung, run_privileged_bash, ist ersatzlos entfallen: sie
# fuehrte eine beliebige Shell als Root aus, und `bash -c` in einer
# NOPASSWD-Regel ist Root ohne jede Einschraenkung. Ihre beiden Aufrufer
# rufen die einzelnen ip-Befehle jetzt nacheinander auf.
#
# Der Weg wird EINMAL bestimmt und dann behalten. Ein Rueckfall auf
# pkexec bei jedem fehlgeschlagenen Aufruf waere keiner: `ip route del`
# fuer eine Route, die es nicht mehr gibt, scheitert im Normalbetrieb,
# und der Benutzer bekaeme mitten im Trennen einen Berechtigungsdialog
# nach dem anderen fuer Befehle, die laengst laufen durften.
PRIVILEGE_MODE=""

detect_privilege_mode() {
    [ -n "$PRIVILEGE_MODE" ] && return 0
    if sudo -n true 2>/dev/null; then
        PRIVILEGE_MODE="rule"
    elif command -v pkexec >/dev/null 2>&1; then
        PRIVILEGE_MODE="pkexec"
    else
        PRIVILEGE_MODE="none"
    fi
}

run_privileged() {
    detect_privilege_mode
    case "$PRIVILEGE_MODE" in
        rule)   sudo -n "$@" ;;
        pkexec) pkexec "$@" ;;
        *)
            log_message "Keine Root-Rechte fuer: $*"
            log_message "$SUDOERS_HINT"
            return 1
            ;;
    esac
}

# Die Rechte-Regel einmalig installieren.
#
# Der einzige Aufruf von `sudo` in diesem Skript, der nicht durch die
# Regel gedeckt ist - er ist es ja, der sie installiert. Er laeuft nur
# auf ausdrueckliche Anweisung des Benutzers und fragt dabei nach dem
# Passwort, so wie jede andere Systemaenderung auch.
install_privileges() {
    if [ ! -f "$POLICY_FILE" ]; then
        echo "Regeldatei nicht gefunden: $POLICY_FILE"
        echo "Bitte zuerst erzeugen:"
        echo "  $ZEPOS_SYSTEM_ROOT/generate_config.sh -zepos-privileges-config"
        return 1
    fi

    # Eine kaputte Datei in /etc/sudoers.d/ ist kein kleiner Fehler: sudo
    # verweigert dann den gesamten Regelsatz, und das Konto verliert
    # jedes Recht, auch das, den Fehler wieder zu beheben.
    if command -v visudo >/dev/null 2>&1; then
        if ! visudo -c -f "$POLICY_FILE" >/dev/null; then
            echo "Die erzeugte Regeldatei ist fehlerhaft - nichts installiert."
            return 1
        fi
    fi

    echo "Installiere $POLICY_FILE nach $POLICY_TARGET (fragt nach dem Passwort)..."
    if sudo install -m 0440 -o root -g root "$POLICY_FILE" "$POLICY_TARGET"; then
        echo "Rechte-Regel installiert ✓"
        return 0
    fi
    echo "Installation fehlgeschlagen."
    return 1
}

# Function to disconnect VPN
disconnect_vpn() {
    log_message "Disconnecting VPN..."

    read_vpn_state

    # Ohne Aufzeichnung UND ohne laufenden charon gibt es nichts
    # abzubauen. Laeuft charon, ist der Abbau faellig, auch wenn wir
    # nichts notiert haben: dann liegen xfrm-Policies, Routen und
    # womoeglich eine virtuelle Adresse herum, die niemand mehr abraeumt.
    #
    # "unknown" faellt hier ABSICHTLICH nicht unter die Abkuerzung, und
    # zwar in die sichere Richtung: wer `disconnect` tippt, hat sich
    # entschieden, und "wir wissen es nicht" ist kein Grund, ihm
    # "Already disconnected" zu antworten und nichts abzubauen. Genau
    # dieses Vorzeitig-Aussteigen ist der Fehler, den der Absatz
    # darueber schon einmal beschreibt.
    if [ "$VPN_STATE" = "disconnected" ] && ! pgrep -f "charon" > /dev/null 2>&1; then
        notify_send "normal" "VPN Status" "Already disconnected"
        return 0
    fi

    # Der Ursprung brach hier ab, wenn kein zwischengespeichertes
    # Passwort dalag, und schickte den Benutzer zurueck ins Verbinden -
    # eine Trennung, die nur klappte, wenn vorher auf DIESER Sitzung
    # verbunden worden war. Mit der Rechte-Regel braucht es weder
    # Zwischenspeicher noch Terminal.
    detect_privilege_mode
    case "$PRIVILEGE_MODE" in
        rule)
            log_message "Rechte-Regel aktiv - kein Passwort noetig"
            ;;
        pkexec)
            log_message "Keine Rechte-Regel - pkexec fragt fuer jeden Schritt nach"
            log_message "$SUDOERS_HINT"
            ;;
        *)
            log_message "WARNUNG: keine Rechte-Regel und kein pkexec"
            notify_send "critical" "VPN Error" "Keine Rechte fuer das Trennen. Bitte einmalig 'vpn-control.sh install-privileges' ausfuehren."
            return 1
            ;;
    esac

    # Ein Rest aus einer aelteren Fassung: das Login-Passwort im Klartext
    # auf dem tmpfs. Es liest niemand mehr - es liegt aber noch da.
    rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vpn-sudo-cache"

    # Detect active network interface BEFORE stopping StrongSwan (routing may break after)
    ACTIVE_IFACE=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' || \
                   ip link show | grep -E 'state UP' | grep -vE 'lo|virbr|docker' | head -1 | awk -F: '{print $2}' | tr -d ' ')
    log_message "Active interface: ${ACTIVE_IFACE}"

    # Die virtuelle Adresse, ebenfalls BEVOR charon endet: danach kann
    # niemand mehr sagen, welche es war. Notiert hat sie das
    # Verbindungsskript; fehlt die Notiz, wird charon gefragt, solange er
    # noch antwortet.
    if [ -z "$VPN_VIP" ]; then
        VPN_VIP=$(run_privileged swanctl --list-sas 2>/dev/null | \
                  vpn_query --virtual-address 2>/dev/null) || VPN_VIP=""
    fi
    if [ -n "$VPN_VIP" ]; then
        log_message "Virtual address of this tunnel: ${VPN_VIP}"
    else
        log_message "No virtual address recorded for this tunnel"
    fi

    # Stop StrongSwan service completely (not just terminate SA).
    # Just terminating the IKE SA is insufficient because child SAs have
    # start_action=start which causes StrongSwan to re-establish immediately.
    # Stopping the service ensures charon exits and releases the virtual IP.
    log_message "Stopping StrongSwan service..."
    run_privileged systemctl stop strongswan >> "$LOG_FILE" 2>&1
    if [ $? -ne 0 ]; then
        log_message "WARNING: systemctl stop strongswan may have failed - trying terminate fallback"
        run_privileged swanctl --terminate --ike ${VPN_CONNECTION} >> "$LOG_FILE" 2>&1
    fi

    # Wait for charon to fully exit and release virtual IP
    local WAIT_COUNT=0
    while pgrep -f "charon" > /dev/null 2>&1 && [ $WAIT_COUNT -lt 10 ]; do
        sleep 1
        WAIT_COUNT=$((WAIT_COUNT + 1))
        log_message "Waiting for charon to exit... (${WAIT_COUNT}/10)"
    done

    if pgrep -f "charon" > /dev/null 2>&1; then
        log_message "WARNING: charon still running after 10s - force killing"
        run_privileged killall -9 charon >> "$LOG_FILE" 2>&1
        sleep 1
    fi

    # Flush ALL xfrm policies and states (critical for clean disconnect)
    #
    # Einzelne Befehle statt einer Shell-Zeile. Der Ursprung schickte
    # beides als `bash -c` durch sudo; das ist in einer NOPASSWD-Regel
    # nicht einzugrenzen und faellt damit aus.
    log_message "Flushing xfrm policies and states..."
    run_privileged ip xfrm policy flush || true
    run_privileged ip xfrm state flush || true

    # Clean up VPN routes, from the same list they were installed from.
    log_message "Cleaning up VPN routes..."
    for NET in $ROUTED_NETWORKS; do
        run_privileged ip route del "${NET}" dev "${ACTIVE_IFACE}" || true
        run_privileged ip route del "${NET}" table 220 || true
    done
    run_privileged ip route flush cache || true

    # Remove virtual IP from interface if still present.
    #
    # Gesucht wird GENAU die Adresse dieses Tunnels, mit der Praefixlaenge,
    # unter der sie eingetragen ist - `ip addr del` braucht beides. Vorher
    # stand hier ein Muster auf den Adressbereich eines bestimmten
    # Gateways: bei jedem anderen blieb die Adresse liegen, und die
    # naechste Verbindung baute darauf auf.
    local LEFTOVER_VIP=""
    if [ -n "$VPN_VIP" ]; then
        LEFTOVER_VIP=$(vpn_query --address-present "$VPN_VIP" 2>/dev/null) || LEFTOVER_VIP=""
    fi
    if [ -n "$LEFTOVER_VIP" ]; then
        log_message "Removing leftover virtual IP ${LEFTOVER_VIP} from ${ACTIVE_IFACE}"
        run_privileged ip addr del ${LEFTOVER_VIP} dev ${ACTIVE_IFACE} >> "$LOG_FILE" 2>&1 || true
    fi

    # Restore original DNS configuration
    log_message "Restoring DNS configuration..."
    if [ -f /etc/resolv.conf.vpn-backup ]; then
        run_privileged cp /etc/resolv.conf.vpn-backup /etc/resolv.conf 2>/dev/null || true
        run_privileged rm -f /etc/resolv.conf.vpn-backup 2>/dev/null || true
    fi

    # Restart NetworkManager to fully re-apply DHCP DNS
    log_message "Restarting NetworkManager..."
    run_privileged systemctl restart NetworkManager >> "$LOG_FILE" 2>&1 || true
    sleep 2

    # Nachgesehen wird, ob GENAU diese Adresse verschwunden ist - und,
    # wenn es nie eine gab, ob charon beendet ist.
    #
    # Das Muster auf den Adressbereich eines bestimmten Gateways traf bei
    # jedem anderen nie zu, also war jede Trennung ein Erfolg - auch die,
    # bei der charon noch lief und die Adresse noch stand. Der Benutzer
    # bekam "Erfolgreich getrennt" und war weiterhin im fremden Netz.
    DISCONNECT_OK=true
    if [ -n "$VPN_VIP" ] && vpn_query --address-present "$VPN_VIP" > /dev/null 2>&1; then
        DISCONNECT_OK=false
        log_message "Disconnect failed - ${VPN_VIP} is still configured"
    elif pgrep -f "charon" > /dev/null 2>&1; then
        DISCONNECT_OK=false
        log_message "Disconnect failed - charon is still running"
    fi

    if [ "$DISCONNECT_OK" = true ]; then
        # Disconnect successful - clean up the state file
        rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vpn-active" 2>/dev/null
        log_message "VPN state file cleaned up after successful disconnect"

        # Verify internet connectivity
        if curl -s --max-time 5 https://www.google.com -o /dev/null 2>/dev/null; then
            notify_send "normal" "VPN Disconnected" "Erfolgreich getrennt - Internet funktioniert"
            log_message "Successfully disconnected - routes, xfrm, DNS cleaned up - internet OK"
        else
            notify_send "normal" "VPN Disconnected" "Getrennt - Internet wird wiederhergestellt..."
            log_message "Disconnected - internet may need a moment to restore"
        fi
        return 0
    else
        notify_send "critical" "VPN Error" "Trennung fehlgeschlagen - bitte erneut versuchen"
        return 1
    fi
}

# Function to toggle VPN
#
# Ein halb abgestuerzter Tunnel wird getrennt und nicht als "nicht
# verbunden" behandelt: sonst baut das Verbinden auf Resten auf, die
# niemand abgeraeumt hat.
#
# UND EIN UNBEKANNTER ZUSTAND WIRD WEDER DAS EINE NOCH DAS ANDERE -
# SEIT DEM 01.09.2026
#     Ein Umschalter braucht eine Ausgangslage. Bis zu diesem Tag
#     bekam er immer eine, weil ein nicht antwortendes nmcli
#     "disconnected" hiess: der Griff verband dann, sinnlos, aber
#     wenigstens harmlos. Mit dem vierten Wort waere daraus ohne diesen
#     Zweig das Gegenteil geworden - "nicht disconnected" heisst hier
#     unten TRENNEN, und ein Griff, der einen vielleicht stehenden
#     Tunnel abbaut, weil gerade niemand nachsehen kann, ist genau der
#     Schaden, gegen den der Zustand eingefuehrt wurde.
#
#     Also wird nichts getan und gesagt, warum. Wer trotzdem handeln
#     will, hat `connect` und `disconnect` - zwei Befehle, die sagen,
#     was sie meinen, statt es aus einem unbekannten Zustand zu raten.
toggle_vpn() {
    read_vpn_state
    if [ "$VPN_STATE" = "unknown" ]; then
        log_message "VPN-Zustand unbekannt - nicht umgeschaltet"
        notify_send "critical" "VPN Status" \
            "Zustand unbekannt: NetworkManager antwortet nicht. Niemand weiß, ob dein Verkehr geschützt ist."
        return 1
    fi
    if [ "$VPN_STATE" = "disconnected" ]; then
        connect_vpn
    else
        disconnect_vpn
    fi
}

# Main logic
case "${1:-toggle}" in
    connect)
        connect_vpn
        ;;
    disconnect)
        disconnect_vpn
        ;;
    toggle)
        toggle_vpn
        ;;
    status)
        # Alle VIER Zustaende, nicht zwei: "stale" ist der halb
        # abgestuerzte Tunnel, und ihn als "connected" auszugeben war die
        # Auskunft, wegen der niemand neu verbunden hat. "unknown" ist
        # seit dem 01.09.2026 das vierte Wort und geht hier UNVERAENDERT
        # durch - dieses Skript ist eine Durchreiche und keine zweite
        # Meinung; wer das Wort auf drei einebnete, haette den Fall
        # wieder verloren, fuer den es eingefuehrt wurde.
        read_vpn_state
        echo "$VPN_STATE"
        ;;
    install-privileges)
        install_privileges
        ;;
    *)
        echo "Usage: $0 {connect|disconnect|toggle|status|install-privileges}"
        exit 1
        ;;
esac