// Show loading spinner on a button (replaces content with Gtk.Spinner)
function showButtonLoading(btn: Gtk.Button) {
  const spinner = new Gtk.Spinner({ spinning: true })
  spinner.set_size_request(16, 16)
  btn.set_child(spinner)
  btn.set_sensitive(false)
}

async function applyChanges(loadingBtn?: Gtk.Button) {
  if (loadingBtn) showButtonLoading(loadingBtn)
  // Only if the settings actually reached the disk: a regeneration over
  // a failed save rebuilds every config from the settings that are still
  // in the file, which the user reads as their change being discarded
  // without a word.
  if (!await saveSettings(currentSettings)) return
  // Fire and forget — generate_config.sh restarts AGS, which kills this process
  GLib.spawn_command_line_async(`${GENERATE_SCRIPT} --all`)
}

async function resetColors(loadingBtn?: Gtk.Button) {
  if (loadingBtn) showButtonLoading(loadingBtn)
  currentSettings.colors = {}
  if (!await saveSettings(currentSettings)) return
  GLib.spawn_command_line_async(`${GENERATE_SCRIPT} --all`)
}

