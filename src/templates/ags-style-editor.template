// ============================================================================
// SETTINGS MANAGEMENT
// ============================================================================
async function loadSettings(): Promise<StyleSettings> {
  try {
    const [ok, contents] = GLib.file_get_contents(SETTINGS_FILE)
    if (ok && contents) {
      const parsed = JSON.parse(new TextDecoder().decode(contents))
      return {
        colors: parsed.colors || {},
      }
    }
  } catch (e) {
    console.log("Settings file not found, using defaults")
  }
  return { colors: {} }
}

// Returns whether the settings reached the disk. Every caller regenerates
// the whole desktop afterwards, and doing that over a save that failed
// rewrites every config from the settings that are still in the file -
// which looks exactly like the change being silently undone.
async function saveSettings(settings: StyleSettings): Promise<boolean> {
  // Handed to settings.py rather than written here.
  //
  // This section shares one document with the VPN settings, the
  // weather location and the installer's plugin choice - and, bis zum
  // 18.08.2026, teilte es sich diesen Platz mit widget_sizes, der
  // zweiten Sektion, die dieser Dialog einmal besass (siehe die Notiz
  // bei StyleSettings oben). This read the document inside a `catch {}`
  // that fell back to an empty object, then spread that object and
  // wrote the result - so a file it could not parse came back as only
  // the section(s) this dialog knew about, with the VPN configuration
  // gone, from pressing "apply" in a colour picker. It stated no
  // schema_version either, so a file first created here made
  // zepos-settings refuse to run.
  //
  // settings.py keeps what this dialog does not own, states the version,
  // writes at 0600 through a rename instead of truncating the file, and
  // refuses a document it cannot parse rather than replacing it. _meta
  // is no longer written from here at all: it belongs to
  // user_settings.py, and rebuilding it from a document that could not
  // be read is how the rest of it disappeared.
  //
  // widget_sizes ist seit dem 18.08.2026 absichtlich NICHT mehr im
  // Objekt unten: settings.merge() ERSETZT ganze Sektionen (siehe der
  // Kopf von settings.py), statt sie zu verschmelzen. Ein Schluessel
  // widget_sizes hier - und sei es mit einem leeren Objekt - wuerde bei
  // jedem Speichern eine Sektion loeschen, die diesem Dialog nie
  // gehoert hat. Das Weglassen des Schluessels ist das, was ein
  // Bestandsdokument mit einer alten widget_sizes-Sektion unberuehrt
  // laesst.
  try {
    await execAsync([...SETTINGS_WRITER, JSON.stringify({
      colors: settings.colors,
    })])
    return true
  } catch (e) {
    console.error("Failed to save settings:", e)
    try {
      // Kein Template-Literal mehr (17.08.2026): xgettext liest eine
      // Zeichenkette mit ${...} gar nicht aus, sie bekaeme also keinen
      // Katalogeintrag. Der Fehlertext kommt als benannter Platzhalter
      // herein, siehe utils/i18n.ts.
      await execAsync(['notify-send', '-i', 'dialog-error', _("ZepOS Style"),
                       format(_("Not saved: {error}"), { error: String(e) })])
    } catch {}
    return false
  }
}

function getColor(key: string, defaultValue: string): string {
  return currentSettings.colors?.[key] || defaultValue
}

function setColor(key: string, value: string) {
  if (!currentSettings.colors) currentSettings.colors = {}
  currentSettings.colors[key] = value
}

