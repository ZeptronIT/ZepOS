  let pickerSvArea: Gtk.DrawingArea
  let pickerHueBar: Gtk.DrawingArea
  let pickerPreviewArea: Gtk.DrawingArea
  let pickerHexEntry: Gtk.Entry

  const getPickerHex = (): string => {
    const [r, g, b] = hsvToRgb(pickerHue, pickerSat, pickerVal)
    return rgbToHex(r, g, b)
  }

  const redrawPicker = () => {
    pickerSvArea?.queue_draw()
    pickerHueBar?.queue_draw()
    pickerPreviewArea?.queue_draw()
    pickerHexEntry?.set_text(getPickerHex())
  }

  // ============================================================================
  // CREATE COLOR ROW
  // ============================================================================
  const createColorRow = (colorDef: { key: string; label: string }): Gtk.Box => {
    const row = new Gtk.Box({ spacing: 8 })
    row.add_css_class("se-color-row")

    // Color preview
    const preview = new Gtk.Box()
    preview.set_size_request(28, 28)
    preview.add_css_class("se-color-preview")

    const currentColor = getColor(colorDef.key, BRAND_DEFAULTS[colorDef.key])
    const cssProvider = new Gtk.CssProvider()
    cssProvider.load_from_string(`* { background-color: ${currentColor}; border-radius: {{STYLE_RADIUS_CONTROL}}; }`)
    preview.get_style_context().add_provider(cssProvider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    // Label
    const label = new Gtk.Label({ label: colorDef.label, xalign: 0, hexpand: true })
    label.add_css_class("se-color-label")
    label.set_ellipsize(3) // PANGO_ELLIPSIZE_END

    // Hex value
    const hexLabel = new Gtk.Label({ label: currentColor })
    hexLabel.add_css_class("se-color-hex")

    // Edit button. zepButton, Rolle "still" (Task B, 18.08.2026): ein
    // Symbol-Knopf je Farbzeile, kein Hauptweg - dieselbe Einordnung wie
    // notif-close-btn (Task A).
    const editBtn = zepButton(ICONS.edit, "still", () => {
      showInlinePicker(colorDef.key, BRAND_DEFAULTS[colorDef.key])
    })

    colorRows.set(colorDef.key, { preview, hexLabel })

    row.append(preview)
    row.append(label)
    row.append(hexLabel)
    row.append(editBtn)

    return row
  }

  // ============================================================================
  // CREATE COLOR CATEGORY
  // ============================================================================
  const createColorCategory = (category: typeof COLOR_CATEGORIES[0]): Gtk.Box => {
    const section = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL,
      spacing: 4,
    })
    section.add_css_class("se-category")

    const header = new Gtk.Label({ label: category.name, xalign: 0 })
    header.add_css_class("se-category-header")
    section.append(header)

    for (const colorDef of category.colors) {
      section.append(createColorRow(colorDef))
    }

    return section
  }

  // createWidgetSizeRow() stand hier: eine Zeile mit zwei Schiebereglern
  // (B/H) je Fenster, gegen minW/maxW/minH/maxH aus WIDGET_SIZES - der
  // Reiter, der am 18.08.2026 mit der ganzen widget_sizes-Kette fiel
  // (siehe die Notiz bei StyleSettings).

  // ============================================================================
  // UPDATE FUNCTIONS
  // ============================================================================
  const updateColors = () => {
    for (const cat of COLOR_CATEGORIES) {
      for (const colorDef of cat.colors) {
        const row = colorRows.get(colorDef.key)
        if (row) {
          const color = getColor(colorDef.key, BRAND_DEFAULTS[colorDef.key])
          row.hexLabel.set_text(color)
          const newCss = new Gtk.CssProvider()
          newCss.load_from_string(`* { background-color: ${color}; border-radius: {{STYLE_RADIUS_CONTROL}}; }`)
          row.preview.get_style_context().add_provider(newCss, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        }
      }
    }
  }

  // updateWidgetSizes() und updateResolutionButtons() standen hier und
  // fielen mit demselben Reiter.

  const switchTab = (tab: "colors" | "themes") => {
    currentTab = tab

    // Hide all content first
    colorsContent.set_visible(false)
    themesContent.set_visible(false)
    pickerContent?.set_visible(false)

    // Remove active from all tabs
    colorsTab.remove_css_class("active")
    themesTab.remove_css_class("active")

    if (tab === "colors") {
      colorsTab.add_css_class("active")
      colorsContent.set_visible(true)
      resetBtn.set_tooltip_text(_("Reset all colors"))
      resetBtn.set_visible(true)
    } else {
      themesTab.add_css_class("active")
      themesContent.set_visible(true)
      resetBtn.set_visible(false)
    }
  }

  // Apply a theme preset
  const applyTheme = async (theme: ThemePreset, themeBtn?: Gtk.Button) => {
    if (themeBtn) showButtonLoading(themeBtn)
    for (const [key, value] of Object.entries(theme.colors)) {
      currentSettings.colors[key] = value
    }
    if (!await saveSettings(currentSettings)) return
    GLib.spawn_command_line_async(`${GENERATE_SCRIPT} --all`)
  }

  // ============================================================================
  // INLINE COLOR PICKER
  // ============================================================================
  const showInlinePicker = (colorKey: string, defaultColor: string) => {
    pickerColorKey = colorKey
    pickerColorDefault = defaultColor
    const color = getColor(colorKey, defaultColor)
    const [r, g, b] = hexToRgb(color)
    ;[pickerHue, pickerSat, pickerVal] = rgbToHsv(r, g, b)

    colorsContent.set_visible(false)
    themesContent.set_visible(false)
    pickerContent.set_visible(true)

    // Hide tab bar and action buttons while picking
    redrawPicker()
  }

  const hideInlinePicker = (selectedColor: string | null) => {
    if (selectedColor) {
      setColor(pickerColorKey, selectedColor)
      updateColors()
    }
    pickerContent.set_visible(false)
    switchTab("colors")
  }

  return createOverlayWindow({
    name: WINDOW_NAME,
    width: WIN_WIDTH,
    height: 650,
    cssClass: "StyleEditor",
    headerIcon: ICONS.palette,
    headerTitle: _("Style Editor"),
    accentCssClass: "style-accent",
    onShow: async () => {
      currentSettings = await loadSettings()
      updateColors()
    },
    buildContent: (_win, closeWindow) => {
      closeFn = closeWindow

      // ============================================================================
      // BUILD UI
      // ============================================================================
      const mainBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 0,
      })
      mainBox.add_css_class("se-container")

      // ===== TAB BAR =====
      //
      // se-tab-btn BLEIBT STEHEN (Task B, 18.08.2026, gemeldete Ausnahme
      // aus dem Plan): ein Reiter, kein Knopf - eigener ausgewaehlter
      // Zustand, sitzt in einer Leiste. GEPRUEFT: die waagerechte
      // Innenabstand von .se-tab-btn und .zep-btn ist gleich (beide
      // STYLE_SPACE_16 je Seite, siehe ags-style.template), eine
      // Umstellung wuerde die gemessene Breite des breitesten Reiters
      // (122px, siehe die
      // WIN_WIDTH-Rechnung am Dateikopf) also NICHT veraendern - aber
      // genau DIESE Breite ist die einzige Grundlage der Fensterbreite
      // dieses Fensters, und keine andere im Umbau befindliche Klasse
      // traegt eine so direkt daran gekoppelte Messung. Ein Fehler hier
      // waere ein Fehler in der Fensterbreite, und die Breitenleiter ist
      // Stufe 5, nicht dieser Auftrag. Einzelheiten im Gruppenbericht.
      //
      // NACHTRAG Aufgabe 2 (18.08.2026): der Reiter "Größen"/widgetsTab,
      // der hier bis eben als dritter stand, ist geloescht - siehe die
      // Notiz bei WIN_WIDTH am Dateikopf fuer das, was das fuer die
      // 122px-Rechnung oben bedeutet und warum sie NICHT nachgerechnet
      // wurde.
      const tabBar = new Gtk.Box({ spacing: 4, homogeneous: true })
      tabBar.add_css_class("se-tab-bar")

      colorsTab = new Gtk.Button({ can_focus: false })
      colorsTab.add_css_class("se-tab-btn")
      colorsTab.add_css_class("active")
      const colorsTabBox = new Gtk.Box({ spacing: 6, halign: Gtk.Align.CENTER })
      const colorsTabIcon = new Gtk.Label({ label: ICONS.palette })
      const colorsTabLabel = new Gtk.Label({ label: _("Colors") })
      colorsTabBox.append(colorsTabIcon)
      colorsTabBox.append(colorsTabLabel)
      colorsTab.set_child(colorsTabBox)
      colorsTab.connect("clicked", () => switchTab("colors"))

      themesTab = new Gtk.Button({ can_focus: false })
      themesTab.add_css_class("se-tab-btn")
      const themesTabBox = new Gtk.Box({ spacing: 6, halign: Gtk.Align.CENTER })
      const themesTabIcon = new Gtk.Label({ label: ICONS.theme })
      const themesTabLabel = new Gtk.Label({ label: _("Themes") })
      themesTabBox.append(themesTabIcon)
      themesTabBox.append(themesTabLabel)
      themesTab.set_child(themesTabBox)
      themesTab.connect("clicked", () => switchTab("themes"))

      tabBar.append(colorsTab)
      tabBar.append(themesTab)

      // ===== COLORS CONTENT =====
      colorsContent = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 0,
      })

      const colorsScroll = new Gtk.ScrolledWindow({
        hscrollbar_policy: Gtk.PolicyType.NEVER,
        vscrollbar_policy: Gtk.PolicyType.AUTOMATIC,
        vexpand: true,
      })
      colorsScroll.add_css_class("se-scroll")

      const colorsInner = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 0,
      })
      colorsInner.add_css_class("se-content")

      for (const category of COLOR_CATEGORIES) {
        colorsInner.append(createColorCategory(category))
      }

      colorsScroll.set_child(colorsInner)
      colorsContent.append(colorsScroll)

      // ===== INLINE COLOR PICKER CONTENT =====
      const PICKER_SV_SIZE = 220
      const PICKER_HUE_WIDTH = 24
      const PICKER_HUE_HEIGHT = PICKER_SV_SIZE

      pickerContent = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 0,
        vexpand: true,
      })
      pickerContent.add_css_class("se-picker-content")
      pickerContent.set_visible(false)

      // Back button + title
      const pickerHeader = new Gtk.Box({ spacing: 8 })
      pickerHeader.add_css_class("se-picker-header")
      const pickerBackBtn = new Gtk.Button({ label: _("← Back"), can_focus: false })
      pickerBackBtn.add_css_class("se-picker-back")
      pickerBackBtn.connect("clicked", () => hideInlinePicker(null))
      pickerHeader.append(pickerBackBtn)
      pickerContent.append(pickerHeader)

      // SV gradient area
      pickerSvArea = new Gtk.DrawingArea()
      pickerSvArea.set_size_request(PICKER_SV_SIZE, PICKER_SV_SIZE)
      pickerSvArea.add_css_class("cp-sv-area")

      pickerSvArea.set_draw_func((_area: Gtk.DrawingArea, cr: any, w: number, h: number) => {
        for (let y = 0; y < h; y++) {
          const v = 1 - y / h
          for (let x = 0; x < w; x++) {
            const s = x / w
            const [r, g, b] = hsvToRgb(pickerHue, s, v)
            cr.setSourceRGB(r, g, b)
            cr.rectangle(x, y, 1, 1)
            cr.fill()
          }
        }
        const cx = pickerSat * w
        const cy = (1 - pickerVal) * h
        cr.setSourceRGBA(1, 1, 1, 0.9)
        cr.setLineWidth(2)
        cr.arc(cx, cy, 6, 0, 2 * Math.PI)
        cr.stroke()
        cr.setSourceRGBA(0, 0, 0, 0.6)
        cr.setLineWidth(1)
        cr.arc(cx, cy, 7, 0, 2 * Math.PI)
        cr.stroke()
      })

      // SV mouse interaction
      const pSvUpdateFn = (x: number, y: number) => {
        pickerSat = Math.max(0, Math.min(1, x / PICKER_SV_SIZE))
        pickerVal = Math.max(0, Math.min(1, 1 - y / PICKER_SV_SIZE))
        redrawPicker()
      }

      const pSvClick = new Gtk.GestureClick()
      pSvClick.set_button(1)
      pSvClick.connect("pressed", (_g: any, _n: number, x: number, y: number) => {
        pickerSvDragging = true
        pSvUpdateFn(x, y)
      })
      pSvClick.connect("released", () => { pickerSvDragging = false })
      pickerSvArea.add_controller(pSvClick)

      const pSvMotion = new Gtk.EventControllerMotion()
      pSvMotion.connect("motion", (_c: any, x: number, y: number) => {
        if (pickerSvDragging) pSvUpdateFn(x, y)
      })
      pickerSvArea.add_controller(pSvMotion)

      // Hue bar
      pickerHueBar = new Gtk.DrawingArea()
      pickerHueBar.set_size_request(PICKER_HUE_WIDTH, PICKER_HUE_HEIGHT)
      pickerHueBar.add_css_class("cp-hue-bar")

      pickerHueBar.set_draw_func((_area: Gtk.DrawingArea, cr: any, w: number, h: number) => {
        for (let y = 0; y < h; y++) {
          const hVal = (y / h) * 360
          const [r, g, b] = hsvToRgb(hVal, 1, 1)
          cr.setSourceRGB(r, g, b)
          cr.rectangle(0, y, w, 1)
          cr.fill()
        }
        const hy = (pickerHue / 360) * h
        cr.setSourceRGBA(1, 1, 1, 1)
        cr.setLineWidth(2)
        cr.rectangle(0, hy - 2, w, 4)
        cr.stroke()
      })

      // Hue mouse interaction
      const pHueUpdateFn = (y: number) => {
        pickerHue = Math.max(0, Math.min(359.99, (y / PICKER_HUE_HEIGHT) * 360))
        redrawPicker()
      }

      const pHueClick = new Gtk.GestureClick()
      pHueClick.set_button(1)
      pHueClick.connect("pressed", (_g: any, _n: number, _x: number, y: number) => {
        pickerHueDragging = true
        pHueUpdateFn(y)
      })
      pHueClick.connect("released", () => { pickerHueDragging = false })
      pickerHueBar.add_controller(pHueClick)

      const pHueMotion = new Gtk.EventControllerMotion()
      pHueMotion.connect("motion", (_c: any, _x: number, y: number) => {
        if (pickerHueDragging) pHueUpdateFn(y)
      })
      pickerHueBar.add_controller(pHueMotion)

      // Picker top row: SV + Hue bar
      const pickerTopRow = new Gtk.Box({ orientation: Gtk.Orientation.HORIZONTAL, spacing: 12 })
      pickerTopRow.set_halign(Gtk.Align.CENTER)
      pickerTopRow.append(pickerSvArea)
      pickerTopRow.append(pickerHueBar)

      // Preview + hex entry
      pickerPreviewArea = new Gtk.DrawingArea()
      pickerPreviewArea.set_size_request(40, 40)
      pickerPreviewArea.add_css_class("cp-preview")
      pickerPreviewArea.set_draw_func((_area: Gtk.DrawingArea, cr: any, w: number, h: number) => {
        const [r, g, b] = hsvToRgb(pickerHue, pickerSat, pickerVal)
        cr.setSourceRGB(r, g, b)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        cr.setSourceRGBA(1, 1, 1, 0.2)
        cr.setLineWidth(1)
        cr.rectangle(0, 0, w, h)
        cr.stroke()
      })

      pickerHexEntry = new Gtk.Entry({ text: "#000000", max_length: 7, width_chars: 7 })
      pickerHexEntry.set_size_request(-1, 40)
      pickerHexEntry.add_css_class("cp-hex-entry")
      pickerHexEntry.connect("activate", () => {
        const text = pickerHexEntry.get_text().trim()
        if (/^#[0-9a-fA-F]{6}$/.test(text)) {
          const [r, g, b] = hexToRgb(text)
          ;[pickerHue, pickerSat, pickerVal] = rgbToHsv(r, g, b)
          redrawPicker()
        }
      })

      const pickerInfoRow = new Gtk.Box({ orientation: Gtk.Orientation.HORIZONTAL, spacing: 12 })
      pickerInfoRow.set_margin_top(10)
      pickerInfoRow.set_halign(Gtk.Align.CENTER)
      pickerPreviewArea.set_valign(Gtk.Align.CENTER)
      pickerHexEntry.set_valign(Gtk.Align.CENTER)
      pickerInfoRow.append(pickerPreviewArea)
      pickerInfoRow.append(pickerHexEntry)

      // Preset colors
      const pickerPresetsLabel = new Gtk.Label({ label: _("Presets") })
      pickerPresetsLabel.add_css_class("cp-presets-label")
      pickerPresetsLabel.set_halign(Gtk.Align.START)
      pickerPresetsLabel.set_margin_top(10)

      const pickerPresetsFlow = new Gtk.FlowBox({
        max_children_per_line: 8,
        min_children_per_line: 8,
        selection_mode: Gtk.SelectionMode.NONE,
        row_spacing: 4,
        column_spacing: 4,
      })
      pickerPresetsFlow.add_css_class("cp-presets")

      // cp-preset-btn BLEIBT STEHEN (Task B, 18.08.2026, gemeldete
      // Ausnahme aus dem Plan): eine Farbkachel ist kein Knopf mit Text,
      // sie traegt eine 24x24-Zeichenflaeche und sonst nichts. GEMESSEN:
      // .cp-preset-btn hat padding STYLE_SPACE_2 (2px) und
      // min-width/min-height 0; .zep-btn erzwingt padding
      // "0 STYLE_SPACE_16" (16px je Seite) und min-height
      // STYLE_CONTROL_HEIGHT (32px). Acht Kacheln je Zeile
      // (max_children_per_line: 8) in einem Fenster von 474px Breite
      // (WIN_WIDTH oben) wuerden mit der erzwungenen Innenabstand-
      // breite von 8x(24+32)=448px plus 7x4px Reihenabstand die
      // verfuegbare Breite sprengen - heute sind es 8x(24+4)=224px plus
      // Abstand. zepButton passt hier nicht, siehe Gruppenbericht.
      //
      // BERICHTIGT am 18.08.2026 (Aufgabe 12): "474px" und "WIN_WIDTH
      // oben" waren am Tag von Task B richtig. WIN_WIDTH ist seither
      // (noch am selben Tag, NACH Task B) keine 474 mehr - siehe die
      // Anmerkung dort ("UNGEPRUEFTE ABWEICHUNG SEIT 18.08.2026"): der
      // Reiter "Größen" fiel (commit a41acee), und die Zeile darueber
      // nennt seither die Sprosse STYLE_MODAL_WIDTH_S (500) statt eines
      // Pixel-Literals. Ob acht Kacheln bei 500 statt 474 (26 Punkte
      // mehr Spielraum) noch sprengen, ist NICHT nachgerechnet - dieselbe
      // Warnung wie dort: tests/render/ ist fuer diesen Auftrag
      // verboten, vor der naechsten Beruehrung dieses Fensters (Stufe 5,
      // Breitenleiter) neu messen. Die Ausnahme selbst (cp-preset-btn
      // bleibt eine eigene Klasse) ist davon unberuehrt - sie haengt an
      // der Form der Kachel (keine Beschriftung, eigenes Mass), nicht an
      // der konkreten Fensterbreite.
      for (const color of PRESET_COLORS) {
        const swatch = new Gtk.DrawingArea()
        swatch.set_size_request(24, 24)
        swatch.set_draw_func((_a: Gtk.DrawingArea, cr: any, w: number, h: number) => {
          const [r, g, b] = hexToRgb(color)
          cr.setSourceRGB(r, g, b)
          cr.rectangle(0, 0, w, h)
          cr.fill()
        })
        const pbtn = new Gtk.Button({ can_focus: false })
        pbtn.set_child(swatch)
        pbtn.add_css_class("cp-preset-btn")
        pbtn.connect("clicked", () => {
          const [r, g, b] = hexToRgb(color)
          ;[pickerHue, pickerSat, pickerVal] = rgbToHsv(r, g, b)
          redrawPicker()
        })
        pickerPresetsFlow.append(pbtn)
      }

      // Apply / Cancel buttons. zepButton (Task B, 18.08.2026): der
      // Farbwaehler ist eine eigene Ansicht (siehe Gruppenbericht) mit
      // genau einem "voll" - Anwenden ist hier die Hauptsache, Abbrechen
      // der Nebenweg dazu.
      //
      // KONTRASTPRUEFUNG fuer "voll" (WARNUNG aus dem letzten Auftrag):
      // pickerApplyBtn traegt keine eigene Kind-Klasse fuer seine
      // Beschriftung - `label: _("Apply")` erzeugt das GtkLabel intern,
      // ohne dass eine CSS-Regel `color` darauf setzt. Es erbt damit
      // `color: $bg` von .zep-btn-voll, keine Kollision mit $accent
      // moeglich (anders als sc-edit-btn/Task A, wo die Kind-Labels ihre
      // eigene `color` gesetzt hatten).
      const pickerCancelBtn = zepButton(_("Cancel"), "umrandet",
                                         () => hideInlinePicker(null))

      const pickerApplyBtn = zepButton(_("Apply"), "voll",
                                        () => hideInlinePicker(getPickerHex()))

      const pickerBtnRow = new Gtk.Box({ orientation: Gtk.Orientation.HORIZONTAL, spacing: 8 })
      pickerBtnRow.set_halign(Gtk.Align.END)
      pickerBtnRow.set_margin_top(10)
      pickerBtnRow.append(pickerCancelBtn)
      pickerBtnRow.append(pickerApplyBtn)

      // Scrollable picker body
      const pickerInner = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
      pickerInner.add_css_class("se-picker-inner")
      pickerInner.append(pickerTopRow)
      pickerInner.append(pickerInfoRow)
      pickerInner.append(pickerPresetsLabel)
      pickerInner.append(pickerPresetsFlow)
      pickerInner.append(pickerBtnRow)

      pickerContent.append(pickerInner)

      // Die Konstruktion des Reiterinhalts "Größen" stand hier -
      // widgetsContent, resTabsBox (Aufloesungsknoepfe), infoLabel und
      // widgetsInner mit einer createWidgetSizeRow() je Fenster. Sie
      // fielen am 18.08.2026 mit dem Reiter selbst; siehe die Notiz bei
      // StyleSettings weiter oben.

      // ===== THEMES CONTENT =====
      themesContent = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 12,
      })
      themesContent.set_visible(false)

      const themesTitle = new Gtk.Label({ label: _("Predefined themes"), xalign: 0 })
      themesTitle.add_css_class("se-section-title")

      const themesDesc = new Gtk.Label({
        label: _("Choose a theme to change all colors at once"),
        xalign: 0,
        wrap: true,
      })
      themesDesc.add_css_class("se-section-desc")

      const themesScroll = new Gtk.ScrolledWindow({
        hscrollbar_policy: Gtk.PolicyType.NEVER,
        vscrollbar_policy: Gtk.PolicyType.AUTOMATIC,
        vexpand: true,
      })

      const themesList = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 8,
      })
      themesList.add_css_class("se-themes-list")

      // Create theme preview cards
      for (const theme of THEME_PRESETS) {
        const card = new Gtk.Button({ can_focus: false })
        card.add_css_class("se-theme-card")

        const cardBox = new Gtk.Box({
          orientation: Gtk.Orientation.VERTICAL,
          spacing: 8,
        })

        // Theme header with name
        const cardHeaderBox = new Gtk.Box({ spacing: 10 })
        const nameLabel = new Gtk.Label({ label: theme.name, xalign: 0 })
        nameLabel.add_css_class("se-theme-name")
        cardHeaderBox.append(nameLabel)

        // Color preview row
        const colorsPreview = new Gtk.Box({ spacing: 4, halign: Gtk.Align.START })
        colorsPreview.add_css_class("se-theme-colors")

        const previewColors = ["overlay_bg", "overlay_accent", "control_accent", "network_accent", "critical", "success"]
        for (const colorKey of previewColors) {
          const colorBox = new Gtk.Box()
          colorBox.set_size_request(24, 24)
          colorBox.add_css_class("se-theme-color-box")
          const colorProvider = new Gtk.CssProvider()
          colorProvider.load_from_string(`* { background-color: ${theme.colors[colorKey] || "#333"}; }`)
          colorBox.get_style_context().add_provider(colorProvider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
          colorsPreview.append(colorBox)
        }

        // Description
        const descLabel = new Gtk.Label({ label: theme.description, xalign: 0 })
        descLabel.add_css_class("se-theme-desc")

        cardBox.append(cardHeaderBox)
        cardBox.append(colorsPreview)
        cardBox.append(descLabel)
        card.set_child(cardBox)

        card.connect("clicked", () => applyTheme(theme, card))

        themesList.append(card)
      }

      themesScroll.set_child(themesList)

      themesContent.append(themesTitle)
      themesContent.append(themesDesc)
      themesContent.append(themesScroll)

      // ===== ACTIONS =====
      const actionsBox = new Gtk.Box({ spacing: 8, homogeneous: true })
      actionsBox.add_css_class("se-actions")

      // zepButton, Rolle "voll" (Task B, 18.08.2026): Anwenden ist die
      // Hauptsache des Stil-Editors - genau EIN "voll" in dieser Ansicht
      // (der Farbwaehler ist eine eigene Ansicht mit eigenem "voll",
      // siehe cp-apply-btn und der Gruppenbericht).
      //
      // KONTRASTPRUEFUNG (WARNUNG aus dem letzten Auftrag): applyIcon
      // und applyLabel tragen KEINE eigene CSS-Klasse und damit keine
      // eigene `color` - beide erben `color: $bg` von .zep-btn-voll, wie
      // .zep-btn-voll es fuer genau diesen Fall vorsieht. Anders als bei
      // sc-edit-btn (Task A) gibt es hier keine Kind-Regel, die eine
      // Akzentfarbe fest eingetragen haette und mit der deckenden
      // $accent-Flaeche kollidieren koennte.
      const applyBtn = zepButton("", "voll", async () => {
        await applyChanges(applyBtn)
      })
      applyBtn.set_tooltip_text(_("Regenerate all configs"))
      const applyBtnBox = new Gtk.Box({ spacing: 6, halign: Gtk.Align.CENTER })
      const applyIcon = new Gtk.Label({ label: ICONS.apply })
      const applyLabel = new Gtk.Label({ label: _("Apply") })
      applyBtnBox.append(applyIcon)
      applyBtnBox.append(applyLabel)
      applyBtn.set_child(applyBtnBox)

      // zepButton, Rolle "kritisch" (Task B, 18.08.2026): Zuruecksetzen
      // verwirft eigene Aenderungen (Farben) unwiderruflich - dieselbe
      // Einordnung wie vpn-reset-btn (Task E).
      //
      // NACHTRAG Aufgabe 2 (18.08.2026): hier stand eine Fallunterscheidung
      // nach currentTab, weil ein zweiter Reiter ("Größen") einen zweiten
      // Zuruecksetzen-Pfad brauchte. Der Reiter ist geloescht (siehe die
      // Notiz bei StyleSettings), resetBtn ist seither nur noch sichtbar,
      // wenn currentTab "colors" ist (siehe switchTab), also ruft dieser
      // Knopf nur noch den einen Pfad auf.
      resetBtn = zepButton("", "kritisch", async () => {
        await resetColors(resetBtn)
      })
      resetBtn.set_tooltip_text(_("Reset all colors"))
      const resetBtnBox = new Gtk.Box({ spacing: 6, halign: Gtk.Align.CENTER })
      const resetIcon = new Gtk.Label({ label: ICONS.reset })
      const resetLabel = new Gtk.Label({ label: _("Reset") })
      resetBtnBox.append(resetIcon)
      resetBtnBox.append(resetLabel)
      resetBtn.set_child(resetBtnBox)

      actionsBox.append(applyBtn)
      actionsBox.append(resetBtn)

      // ===== ASSEMBLE =====
      mainBox.append(tabBar)
      mainBox.append(colorsContent)
      mainBox.append(pickerContent)
      mainBox.append(themesContent)
      mainBox.append(actionsBox)

      return mainBox
    },
  })
}
