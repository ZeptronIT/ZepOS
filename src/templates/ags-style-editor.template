// ============================================================================
// SETTINGS MANAGEMENT
// ============================================================================
async function loadSettings(): Promise<StyleSettings> {
  try {
    const [ok, contents] = GLib.file_get_contents(SETTINGS_FILE)
    if (ok && contents) {
      const parsed = JSON.parse(new TextDecoder().decode(contents))
      return {
        colors: parsed.colors || {},
        widget_sizes: parsed.widget_sizes || {},
      }
    }
  } catch (e) {
    console.log("Settings file not found, using defaults")
  }
  return { colors: {}, widget_sizes: {} }
}

// Returns whether the settings reached the disk. Every caller regenerates
// the whole desktop afterwards, and doing that over a save that failed
// rewrites every config from the settings that are still in the file -
// which looks exactly like the change being silently undone.
async function saveSettings(settings: StyleSettings): Promise<boolean> {
  // Handed to settings.py rather than written here.
  //
  // These two sections share one document with the VPN settings, the
  // weather location and the installer's plugin choice. This read the
  // document inside a `catch {}` that fell back to an empty object, then
  // spread that object and wrote the result - so a file it could not
  // parse came back as two sections and nothing else, with the VPN
  // configuration gone, from pressing "apply" in a colour picker. It
  // stated no schema_version either, so a file first created here made
  // zepos-settings refuse to run.
  //
  // settings.py keeps what this dialog does not own, states the version,
  // writes at 0600 through a rename instead of truncating the file, and
  // refuses a document it cannot parse rather than replacing it. _meta
  // is no longer written from here at all: it belongs to
  // user_settings.py, and rebuilding it from a document that could not
  // be read is how the rest of it disappeared.
  try {
    await execAsync([...SETTINGS_WRITER, JSON.stringify({
      colors: settings.colors,
      widget_sizes: settings.widget_sizes,
    })])
    return true
  } catch (e) {
    console.error("Failed to save settings:", e)
    try {
      // Kein Template-Literal mehr (17.08.2026): xgettext liest eine
      // Zeichenkette mit ${...} gar nicht aus, sie bekaeme also keinen
      // Katalogeintrag. Der Fehlertext kommt als benannter Platzhalter
      // herein, siehe utils/i18n.ts.
      await execAsync(['notify-send', '-i', 'dialog-error', _("ZepOS Style"),
                       format(_("Not saved: {error}"), { error: String(e) })])
    } catch {}
    return false
  }
}

function getColor(key: string, defaultValue: string): string {
  return currentSettings.colors?.[key] || defaultValue
}

function setColor(key: string, value: string) {
  if (!currentSettings.colors) currentSettings.colors = {}
  currentSettings.colors[key] = value
}

function getWidgetSize(resolution: string, widgetId: string, dimension: "width" | "height"): number {
  const sizes = currentSettings.widget_sizes?.[resolution]?.[widgetId]
  if (sizes) return sizes[dimension]
  return DEFAULT_WIDGET_SIZES[resolution]?.[widgetId]?.[dimension] || 300
}

function setWidgetSize(resolution: string, widgetId: string, dimension: "width" | "height", value: number) {
  if (!currentSettings.widget_sizes) currentSettings.widget_sizes = {}
  if (!currentSettings.widget_sizes[resolution]) currentSettings.widget_sizes[resolution] = {}
  if (!currentSettings.widget_sizes[resolution][widgetId]) {
    currentSettings.widget_sizes[resolution][widgetId] = {
      width: DEFAULT_WIDGET_SIZES[resolution]?.[widgetId]?.width || 300,
      height: DEFAULT_WIDGET_SIZES[resolution]?.[widgetId]?.height || 300,
    }
  }
  currentSettings.widget_sizes[resolution][widgetId][dimension] = value
}

// ============================================================================
// CUSTOM COLOR PICKER (Cairo-based, no GTK color dialog)
// ============================================================================

// --- Color conversion helpers ---
function hsvToRgb(h: number, s: number, v: number): [number, number, number] {
  const c = v * s
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1))
  const m = v - c
  let r = 0, g = 0, b = 0
  if (h < 60)       { r = c; g = x; b = 0 }
  else if (h < 120) { r = x; g = c; b = 0 }
  else if (h < 180) { r = 0; g = c; b = x }
  else if (h < 240) { r = 0; g = x; b = c }
  else if (h < 300) { r = x; g = 0; b = c }
  else              { r = c; g = 0; b = x }
  return [r + m, g + m, b + m]
}

function rgbToHsv(r: number, g: number, b: number): [number, number, number] {
  const max = Math.max(r, g, b)
  const min = Math.min(r, g, b)
  const d = max - min
  let h = 0
  const s = max === 0 ? 0 : d / max
  const v = max
  if (d !== 0) {
    if (max === r)      h = 60 * (((g - b) / d) % 6)
    else if (max === g) h = 60 * (((b - r) / d) + 2)
    else                h = 60 * (((r - g) / d) + 4)
  }
  if (h < 0) h += 360
  return [h, s, v]
}

function hexToRgb(hex: string): [number, number, number] {
  const h = hex.replace("#", "")
  return [
    parseInt(h.substring(0, 2), 16) / 255,
    parseInt(h.substring(2, 4), 16) / 255,
    parseInt(h.substring(4, 6), 16) / 255,
  ]
}

function rgbToHex(r: number, g: number, b: number): string {
  const toHex = (v: number) => Math.round(Math.max(0, Math.min(1, v)) * 255).toString(16).padStart(2, "0")
  return `#${toHex(r)}${toHex(g)}${toHex(b)}`
}

