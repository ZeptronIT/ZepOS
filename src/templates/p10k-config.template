# Powerlevel10k - die Eingabezeile von ZepOS
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/p10k-config.template
#
# =====================================================================
# WARUM ES DIESE DATEI GIBT
# =====================================================================
#
# GEMELDET am 12.08.2026: "es soll irgendwie die moeglichkeit geben
# powerlevel 10k einzurichten das theme fuer ein terminal voll
# automatisch und andere themes auch."
#
# GEMESSEN, und der Befund war der unangenehme: die Einrichtung war
# schon da, das Eingerichtete nicht. zshrc-config.template setzte
# ZSH_THEME="powerlevel10k/powerlevel10k" und sourcete ~/.p10k.zsh -
# waehrend weder oh-my-zsh noch powerlevel10k in irgendeiner Paketliste
# standen und ~/.p10k.zsh auf einer frischen Installation nicht
# existierte. Was eine erste Anmeldung wirklich bekam, gemessen mit
# `zsh -i` in einem leeren Heimatverzeichnis:
#
#     ~/.zshrc:90: no such file or directory: ~/.oh-my-zsh/oh-my-zsh.sh
#     PROMPT=[%m%# ]
#
# Also: eine Fehlermeldung bei JEDER Anmeldung und der nackte
# zsh-Standardprompt. Dieselbe Fehlerklasse wie der
# Zwischenablage-Sammler vom selben Tag, bei dem ein Fenster auf einen
# Socket wartete, den niemand oeffnete.
#
# "VOLL AUTOMATISCH" heisst: nach der Installation ist der Prompt da.
# `p10k configure` stellt ein Dutzend Fragen und schreibt eine
# 1700-Zeilen-Datei; einem Nutzer diesen Fragebogen vorzusetzen, damit
# sein Schreibtisch fertig aussieht, ist keine Distribution. Deshalb
# liegt die Antwort hier - erzeugt, nicht abgeschrieben.
#
#
# =====================================================================
# WOHER DIE FARBEN KOMMEN
# =====================================================================
#
# Aus derselben Mitte wie alles andere: die STYLE_COLOR_PROMPT-Platzhalter
# loest src/style_definition.py aus den sieben Rollen in brand.COLOR_FIELDS
# auf, und die haengen am aktiven Thema (src/theme.py). Ein Wechsel auf
# "tageslicht" schreibt diese Datei mit anderen Farben neu - dieselbe
# Bewegung wie bei der Leiste, dem Sperrbildschirm und der
# Anmeldemaske.
#
# Das ist keine Bequemlichkeit, sondern die einzige Form, in der die
# Forderung "und andere themes auch" ueberhaupt erfuellbar ist. Ein
# Prompt mit eigenen Farbliteralen waere ein drittes Farbsystem neben
# brand.py und den Themen - und traege, sobald jemand das Thema
# wechselt, sichtbar die Farben des anderen.
#
# powerlevel10k nimmt #rrggbb unmittelbar an (internal/p10k.zsh,
# _p9k_translate_color: `[[ $1 == '#'[[:xdigit:]]## ]]`), also braucht
# es keine Umrechnung auf die 256er-Palette. Waere das anders, stuende
# hier eine gerechnete Naeherung und die Marke saehe im Terminal anders
# aus als daneben.
#
# Die SYMBOLE kommen aus src/icon_definition.py, aus demselben Grund
# und mit derselben Abhaengigkeit wie ueberall: es sind
# Nerd-Font-Codepunkte, und ttf-jetbrains-mono-nerd steht deshalb in
# den Abhaengigkeiten von zepos-desktop.
#
#
# =====================================================================
# WARUM GITSTATUS ABGESCHALTET IST
# =====================================================================
#
# powerlevel10k liest den Zustand eines Git-Verzeichnisses am liebsten
# mit gitstatusd, einem C++-Programm, das dem Theme beiliegt - als
# QUELLTEXT. Sein Installationspfad (gitstatus/install) LAEDT beim
# ersten Start eine fertige Binaerdatei aus dem Netz nach. Eine
# Distribution kann das nicht ausliefern: es ist genau das, was Spec
# §4.3 an der AUR abgelehnt hat, nur schlimmer, weil es nicht zur
# Bauzeit passiert, sondern im Heimatverzeichnis des Nutzers.
#
# GEMESSEN am 12.08.2026 gegen den angehefteten Schnappschuss
# 2026/08/04: ein Paket `gitstatus` gibt es in [extra] nicht, und in
# [core] auch nicht.
#
# Ohne gitstatusd faellt powerlevel10k auf zsh-eigenes vcs_info zurueck.
# Das ist langsamer, und POWERLEVEL9K_VCS_MAX_INDEX_SIZE_DIRTY unten
# ist die Antwort darauf: in einem Repository mit mehr als 4096
# Eintraegen im Index wird nicht mehr nach Aenderungen gesucht, sondern
# nur noch der Zweig gezeigt. Ein Prompt, der eine halbe Sekunde
# braucht, ist ein Terminal, das sich kaputt anfuehlt.

'builtin' 'local' '-a' 'p10k_config_opts'
[[ ! -o 'aliases'         ]] || p10k_config_opts+=('aliases')
[[ ! -o 'sh_glob'         ]] || p10k_config_opts+=('sh_glob')
[[ ! -o 'no_brace_expand' ]] || p10k_config_opts+=('no_brace_expand')
'builtin' 'setopt' 'no_aliases' 'no_sh_glob' 'brace_expand'

() {
  emulate -L zsh -o extended_glob

  # Jede Einstellung dieser Datei, und keine von einem frueheren Lauf.
  # Ohne das wirkt ein `source ~/.p10k.zsh` nach einer Neuerzeugung nur
  # zur Haelfte: was hier nicht mehr steht, bliebe gesetzt.
  unset -m '(POWERLEVEL9K_*|DEFAULT_USER)~POWERLEVEL9K_GITSTATUS_DIR'

  # ------------------------------------------------------------------
  # Was in der Zeile steht
  # ------------------------------------------------------------------
  # Zwei Zeilen und nicht eine: der Pfad steht oben, getippt wird
  # unten. Damit faengt jeder Befehl am linken Rand an, egal wie tief
  # das Verzeichnis liegt - der Grund, aus dem p10k diese Form
  # ueberhaupt anbietet.
  typeset -g POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(context dir vcs newline prompt_char)
  typeset -g POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(status command_execution_time background_jobs time)

  # Kein Hintergrund und keine Trennzeichen: die Farbe der Flaeche ist
  # die des Terminals (STYLE_COLOR_TERMINAL_BG in
  # kitty-config.template), und ein Prompt, der seine eigenen
  # Farbbloecke daruebermalt, ist bei einem Themenwechsel die eine
  # Stelle, die stehen bleibt.
  typeset -g POWERLEVEL9K_BACKGROUND=
  typeset -g POWERLEVEL9K_{LEFT,RIGHT}_{LEFT,RIGHT}_WHITESPACE=
  typeset -g POWERLEVEL9K_{LEFT,RIGHT}_SUBSEGMENT_SEPARATOR=' '
  typeset -g POWERLEVEL9K_{LEFT,RIGHT}_SEGMENT_SEPARATOR=
  typeset -g POWERLEVEL9K_VISUAL_IDENTIFIER_EXPANSION=
  typeset -g POWERLEVEL9K_ICON_PADDING=none
  typeset -g POWERLEVEL9K_MODE=nerdfont-complete

  typeset -g POWERLEVEL9K_PROMPT_ADD_NEWLINE=true
  typeset -g POWERLEVEL9K_MULTILINE_FIRST_PROMPT_PREFIX=
  typeset -g POWERLEVEL9K_MULTILINE_NEWLINE_PROMPT_PREFIX=
  typeset -g POWERLEVEL9K_MULTILINE_LAST_PROMPT_PREFIX=

  # ------------------------------------------------------------------
  # Das Zeichen, hinter dem getippt wird
  # ------------------------------------------------------------------
  # Es traegt die einzige Aussage, die man auch dann noch braucht, wenn
  # man gar nicht hinsieht: hat der letzte Befehl geklappt.
  typeset -g POWERLEVEL9K_PROMPT_CHAR_BACKGROUND=
  typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='{{STYLE_COLOR_PROMPT_OK}}'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND='{{STYLE_COLOR_PROMPT_ERROR}}'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIINS_CONTENT_EXPANSION='{{ICON_ARROW_RIGHT}}'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VICMD_CONTENT_EXPANSION='{{ICON_ARROW_LEFT}}'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIVIS_CONTENT_EXPANSION='{{ICON_EXPAND}}'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_{OK,ERROR}_VIOWR_CONTENT_EXPANSION='{{ICON_WRITE}}'
  typeset -g POWERLEVEL9K_PROMPT_CHAR_LEFT_PROMPT_LAST_SEGMENT_END_SYMBOL=' '

  # ------------------------------------------------------------------
  # Wo man ist
  # ------------------------------------------------------------------
  typeset -g POWERLEVEL9K_DIR_FOREGROUND='{{STYLE_COLOR_PROMPT_PATH}}'
  typeset -g POWERLEVEL9K_DIR_VISUAL_IDENTIFIER_EXPANSION='{{ICON_FOLDER}}'
  typeset -g POWERLEVEL9K_SHORTEN_STRATEGY=truncate_to_unique
  typeset -g POWERLEVEL9K_SHORTEN_DELIMITER=
  typeset -g POWERLEVEL9K_DIR_MAX_LENGTH=60
  typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND='{{STYLE_COLOR_PROMPT_CONTEXT}}'
  typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND='{{STYLE_COLOR_PROMPT_PATH}}'
  typeset -g POWERLEVEL9K_DIR_ANCHOR_BOLD=true
  # Ein Verzeichnis, in das nicht geschrieben werden darf, sagt es -
  # das ist die Haelfte aller "warum geht das nicht" im Terminal.
  typeset -g POWERLEVEL9K_DIR_NOT_WRITABLE_VISUAL_IDENTIFIER_EXPANSION='{{ICON_LOCK}}'
  typeset -g POWERLEVEL9K_DIR_NOT_WRITABLE_FOREGROUND='{{STYLE_COLOR_PROMPT_ERROR}}'

  # ------------------------------------------------------------------
  # Was das Repository macht
  # ------------------------------------------------------------------
  typeset -g POWERLEVEL9K_DISABLE_GITSTATUS=true
  # Das Schloss dahinter, und es gehoert einem anderen Programm: legt
  # jemand den Schalter darueber um, sucht gitstatus seinen Daemon, und
  # findet er ihn nicht, LAEDT sein Installationspfad ihn aus dem Netz
  # nach - in das Heimatverzeichnis, an pacman vorbei. Die Null verbietet
  # das. Ohne sie waere die Zeile darueber eine Bitte und keine
  # Zusicherung.
  typeset -g GITSTATUS_AUTO_INSTALL=0
  typeset -g POWERLEVEL9K_VCS_MAX_INDEX_SIZE_DIRTY=4096
  typeset -g POWERLEVEL9K_VCS_BACKENDS=(git)
  typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND='{{STYLE_COLOR_PROMPT_VCS_CLEAN}}'
  typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND='{{STYLE_COLOR_PROMPT_VCS_DIRTY}}'
  typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND='{{STYLE_COLOR_PROMPT_VCS_DIRTY}}'
  typeset -g POWERLEVEL9K_VCS_LOADING_FOREGROUND='{{STYLE_COLOR_PROMPT_CONTEXT}}'
  typeset -g POWERLEVEL9K_VCS_BRANCH_ICON='{{ICON_BRANCH}} '
  typeset -g POWERLEVEL9K_VCS_UNTRACKED_ICON='{{ICON_PLUS}}'
  typeset -g POWERLEVEL9K_VCS_VISUAL_IDENTIFIER_EXPANSION=

  # ------------------------------------------------------------------
  # Wer man ist - und nur dann, wenn es jemand anderes ist
  # ------------------------------------------------------------------
  # Kein "benutzer@rechner" bei jedem Prompt. Es steht da, wenn es
  # etwas bedeutet: als root, oder ueber SSH. Ein Feld, das immer
  # dasselbe sagt, liest niemand mehr - und dann auch nicht an dem Tag,
  # an dem es etwas anderes sagt.
  typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND='{{STYLE_COLOR_PROMPT_ERROR}}'
  typeset -g POWERLEVEL9K_CONTEXT_{REMOTE,REMOTE_SUDO}_FOREGROUND='{{STYLE_COLOR_PROMPT_VCS_DIRTY}}'
  typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND='{{STYLE_COLOR_PROMPT_CONTEXT}}'
  typeset -g POWERLEVEL9K_CONTEXT_ROOT_TEMPLATE='{{ICON_SHIELD}} %n'
  typeset -g POWERLEVEL9K_CONTEXT_{REMOTE,REMOTE_SUDO}_TEMPLATE='%n@%m'
  typeset -g POWERLEVEL9K_CONTEXT_TEMPLATE='%n@%m'
  typeset -g POWERLEVEL9K_CONTEXT_{DEFAULT,SUDO}_{CONTENT,VISUAL_IDENTIFIER}_EXPANSION=

  # ------------------------------------------------------------------
  # Was der letzte Befehl gemacht hat
  # ------------------------------------------------------------------
  # Nur der Fehlerfall wird gezeigt. Ein Haken hinter jedem gelungenen
  # Befehl ist eine Zeile Rauschen pro Befehl.
  typeset -g POWERLEVEL9K_STATUS_OK=false
  typeset -g POWERLEVEL9K_STATUS_ERROR=true
  typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND='{{STYLE_COLOR_PROMPT_ERROR}}'
  typeset -g POWERLEVEL9K_STATUS_ERROR_VISUAL_IDENTIFIER_EXPANSION='{{ICON_ERROR}}'
  typeset -g POWERLEVEL9K_STATUS_VERBOSE_SIGNAME=false
  typeset -g POWERLEVEL9K_STATUS_ERROR_SIGNAL_FOREGROUND='{{STYLE_COLOR_PROMPT_ERROR}}'
  typeset -g POWERLEVEL9K_STATUS_ERROR_PIPE_FOREGROUND='{{STYLE_COLOR_PROMPT_ERROR}}'

  # Wie lange er gebraucht hat, ab drei Sekunden. Darunter ist die Zahl
  # keine Information, sondern eine Zappelei am rechten Rand.
  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_THRESHOLD=3
  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_PRECISION=0
  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND='{{STYLE_COLOR_PROMPT_TIME}}'
  typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_VISUAL_IDENTIFIER_EXPANSION='{{ICON_TIMER}}'

  typeset -g POWERLEVEL9K_BACKGROUND_JOBS_VERBOSE=false
  typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND='{{STYLE_COLOR_PROMPT_VCS_DIRTY}}'
  typeset -g POWERLEVEL9K_BACKGROUND_JOBS_VISUAL_IDENTIFIER_EXPANSION='{{ICON_PAUSE}}'

  # ------------------------------------------------------------------
  # Wie spaet es war, als der Befehl abgeschickt wurde
  # ------------------------------------------------------------------
  typeset -g POWERLEVEL9K_TIME_FORMAT='%D{%H:%M}'
  typeset -g POWERLEVEL9K_TIME_FOREGROUND='{{STYLE_COLOR_PROMPT_TIME}}'
  typeset -g POWERLEVEL9K_TIME_VISUAL_IDENTIFIER_EXPANSION='{{ICON_CLOCK}}'
  typeset -g POWERLEVEL9K_TIME_UPDATE_ON_COMMAND=false

  # ------------------------------------------------------------------
  # Verhalten
  # ------------------------------------------------------------------
  # Der Sofort-Prompt. Sein Gegenstueck steht ganz oben in ~/.zshrc und
  # muss dort ganz oben stehen bleiben - beide Haelften kommen aus
  # zshrc-config.template und p10k-config.template, also aus einer
  # Hand.
  #
  # `quiet` und nicht `verbose`: die laute Fassung schreibt bei jeder
  # Anmeldung eine Warnung, sobald irgendein Drop-in aus ~/.zshrc.d
  # etwas ausgibt - und was in ~/.zshrc.d liegt, entscheidet der
  # Nutzer, nicht diese Datei.
  typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet

  # Kein Nachladen der Konfiguration im laufenden Betrieb: es gibt
  # nichts nachzuladen, das nicht durch zepos-generate ginge, und die
  # Pruefung kostet bei jedem Prompt einen stat-Aufruf.
  typeset -g POWERLEVEL9K_DISABLE_HOT_RELOAD=true

  # Der abgeschickte Befehl behaelt seinen Prompt. Ein Verlauf, in dem
  # jede zweite Zeile zusammengeschrumpft ist, laesst sich nicht mehr
  # kopieren.
  typeset -g POWERLEVEL9K_TRANSIENT_PROMPT=off

  (( ! $+functions[p10k] )) || p10k reload
}

(( ${#p10k_config_opts} )) && setopt ${p10k_config_opts[@]}
'builtin' 'unset' 'p10k_config_opts'
