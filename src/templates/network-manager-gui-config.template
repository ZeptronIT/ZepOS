#!/bin/bash
# Network Manager GUI - Netzwerk-Menue ueber zepos-menu
# Generated by ZepOS - DO NOT EDIT DIRECTLY!

set -o pipefail

# ============================================================================
# ICONS
# ============================================================================
ICON_WIFI="{{ICON_WIFI}}"
ICON_WIFI_1="{{ICON_WIFI_1}}"
ICON_WIFI_2="{{ICON_WIFI_2}}"
ICON_WIFI_3="{{ICON_WIFI_3}}"
ICON_WIFI_4="{{ICON_WIFI_4}}"
ICON_WIFI_LOCK="{{ICON_WIFI_LOCK}}"
ICON_WIFI_OFF="{{ICON_WIFI_OFF}}"
ICON_ETHERNET="{{ICON_ETHERNET}}"
ICON_DISCONNECT="{{ICON_DISCONNECT}}"
ICON_REFRESH="{{ICON_REFRESH}}"
ICON_CHECK="{{ICON_CHECK}}"
ICON_SETTINGS="{{ICON_SETTINGS}}"
ICON_INFO="{{ICON_INFO}}"

# ============================================================================
# KONFIGURATION
# ============================================================================
MENU_WIDTH=500
MENU_HEIGHT=600
NOTIFY_TIMEOUT=5000

# ============================================================================
# HILFSFUNKTIONEN
# ============================================================================

get_signal_icon() {
    local signal=$1
    if (( signal >= 80 )); then
        echo "$ICON_WIFI_4"
    elif (( signal >= 60 )); then
        echo "$ICON_WIFI_3"
    elif (( signal >= 40 )); then
        echo "$ICON_WIFI_2"
    else
        echo "$ICON_WIFI_1"
    fi
}

get_signal_bars() {
    local signal=$1
    if (( signal >= 80 )); then echo "▂▄▆█"
    elif (( signal >= 60 )); then echo "▂▄▆░"
    elif (( signal >= 40 )); then echo "▂▄░░"
    else echo "▂░░░"; fi
}

get_active_wifi_ssid() {
    nmcli -t -f active,ssid dev wifi 2>/dev/null | grep -E "^(ja|yes):" | cut -d: -f2 | head -1
}

get_active_connection_name() {
    nmcli -t -f NAME,TYPE,DEVICE connection show --active 2>/dev/null | \
        grep -E ":(wifi|ethernet|802-11-wireless):" | head -1 | cut -d: -f1
}

get_active_interface() {
    nmcli -t -f NAME,TYPE,DEVICE connection show --active 2>/dev/null | \
        grep -E ":(wifi|ethernet|802-11-wireless):" | head -1 | cut -d: -f3
}

# ============================================================================
# VERBINDUNGSDETAILS
# ============================================================================

show_connection_details() {
    local conn_name="$1"
    local conn_type="$2"
    local interface=$(get_active_interface)
    local details=""

    if [[ "$conn_type" == "wifi" ]]; then
        local wifi_info=$(nmcli -t -f active,ssid,signal,security,freq,chan dev wifi list 2>/dev/null | \
            grep -E "^(ja|yes):" | head -1)
        local ssid=$(echo "$wifi_info" | cut -d: -f2)
        local signal=$(echo "$wifi_info" | cut -d: -f3)
        local security=$(echo "$wifi_info" | cut -d: -f4)
        local freq=$(echo "$wifi_info" | cut -d: -f5)
        local channel=$(echo "$wifi_info" | cut -d: -f6)
        local bars=$(get_signal_bars "$signal")

        details+="$ICON_WIFI  WLAN: $ssid"$'\n'
        details+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"$'\n'
        details+="Signal:      ${signal}% ${bars}"$'\n'
        details+="Sicherheit:  ${security}"$'\n'
        details+="Frequenz:    ${freq}"$'\n'
        details+="Kanal:       ${channel}"$'\n'
    else
        details+="$ICON_ETHERNET  Ethernet: $conn_name"$'\n'
        details+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"$'\n'
    fi

    if [[ -n "$interface" ]]; then
        local ip=$(ip -4 addr show "$interface" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}')
        local gateway=$(ip route | grep "default.*$interface" | awk '{print $3}' | head -1)
        local dns=$(nmcli dev show "$interface" 2>/dev/null | grep "IP4.DNS" | head -1 | awk '{print $2}')
        local mac=$(ip link show "$interface" 2>/dev/null | grep ether | awk '{print $2}')

        details+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"$'\n'
        details+="Interface:   ${interface}"$'\n'
        details+="IP-Adresse:  ${ip:-N/A}"$'\n'
        details+="Gateway:     ${gateway:-N/A}"$'\n'
        details+="DNS:         ${dns:-N/A}"$'\n'
        details+="MAC:         ${mac:-N/A}"$'\n'
    fi

    details+="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"$'\n'
    details+="$ICON_DISCONNECT  Verbindung trennen"$'\n'
    details+="$ICON_REFRESH  Zurück"

    local selection=$(echo -e "$details" | zepos-menu --dmenu \
        --prompt "Details" \
        --width $MENU_WIDTH \
        --height 400 \
        --cache-file /dev/null \
        --sort-order=default)

    case "$selection" in
        *"Verbindung trennen"*) disconnect_network "$conn_name" ;;
        *"Zurück"*) main ;;
    esac
}

# ============================================================================
# NETZWERK-SCAN
# ============================================================================

scan_wifi_networks() {
    # Rescan im Hintergrund - nutzt cached Liste wenn Scan noch läuft
    nmcli device wifi rescan 2>/dev/null &

    local active_ssid=$(get_active_wifi_ssid)
    local tmpfile=$(mktemp)

    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list 2>/dev/null | \
    while IFS=':' read -r ssid signal security; do
        [[ -z "$ssid" ]] && continue
        ssid=$(echo "$ssid" | sed 's/[[:space:]]*$//')
        local signal_num=${signal:-0}
        local icon=$(get_signal_icon "$signal_num")

        local lock=" "
        [[ "$security" != "--" && -n "$security" ]] && lock="$ICON_WIFI_LOCK"

        local check=" "
        [[ "$ssid" == "$active_ssid" ]] && check="$ICON_CHECK"

        # Format: SORTKEY|CHECK|ICON|LOCK|SSID|SIGNAL
        printf "%03d|%s|%s|%s|%s|%d\n" "$signal_num" "$check" "$icon" "$lock" "$ssid" "$signal_num"
    done > "$tmpfile"

    # Sortieren, Duplikate entfernen, formatieren
    sort -t'|' -k1 -rn "$tmpfile" | \
    awk -F'|' '
        !seen[$5]++ {
            printf "%s %s %s  %-28s %3d%%\n", $2, $3, $4, $5, $6
        }
    '

    rm -f "$tmpfile"
}

# ============================================================================
# ETHERNET
# ============================================================================

list_ethernet_profiles() {
    local active_conn=$(get_active_connection_name)
    nmcli -t -f NAME,TYPE connection show 2>/dev/null | grep ":.*ethernet" | cut -d: -f1 | \
    while read -r name; do
        local check=" "
        [[ "$name" == "$active_conn" ]] && check="$ICON_CHECK"
        printf "%s %s  %s\n" "$check" "$ICON_ETHERNET" "$name"
    done
}

# ============================================================================
# AKTIONEN
# ============================================================================

prompt_password() {
    local ssid="$1"
    local password=""

    if command -v yad &> /dev/null; then
        # YAD: Echtes Passwort-Eingabefeld - floating + centered
        password=$(yad --entry \
            --class="yad-wifi-password" \
            --title="WLAN Passwort" \
            --text="$ICON_WIFI_LOCK  Passwort für: $ssid" \
            --hide-text \
            --width=350 \
            --height=120 \
            --center \
            --on-top \
            --undecorated \
            --borders=20 \
            --button="Verbinden:0" \
            --button="Abbrechen:1" \
            2>/dev/null)

        [ $? -ne 0 ] && return 1

    elif command -v zenity &> /dev/null; then
        # Zenity: Fallback
        password=$(zenity --password \
            --title="WLAN Passwort" \
            --text="Passwort für: $ssid" \
            --width=350 \
            2>/dev/null)

        [ $? -ne 0 ] && return 1

    else
        # Letzter Rueckfall: das Auswahlfenster mit --password
        password=$(echo "" | zepos-menu --dmenu \
            --prompt "Passwort für $ssid" \
            --password \
            --width 350 \
            --height 120 \
            --cache-file /dev/null)
    fi

    echo "$password"
}

connect_to_network() {
    local ssid="$1"

    # Prüfen ob bereits bekanntes Netzwerk
    if nmcli -t -f NAME connection show 2>/dev/null | grep -qx "$ssid"; then
        notify-send -t 2000 "Netzwerk" "Verbinde mit $ssid..." -i network-wireless
        if nmcli connection up "$ssid" 2>/dev/null; then
            notify-send -t $NOTIFY_TIMEOUT "Netzwerk" "$ICON_CHECK Verbunden: $ssid" -i network-wireless
        else
            notify-send -t $NOTIFY_TIMEOUT -u critical "Netzwerk" "Verbindung fehlgeschlagen: $ssid" -i network-error
        fi
    else
        # Neues Netzwerk - Passwort abfragen
        local password=$(prompt_password "$ssid")

        # Abbruch wenn kein Passwort
        if [[ -z "$password" ]]; then
            notify-send -t 2000 "Netzwerk" "Abgebrochen" -i network-offline
            return 1
        fi

        notify-send -t 2000 "Netzwerk" "Verbinde mit $ssid..." -i network-wireless

        if nmcli device wifi connect "$ssid" password "$password" 2>/dev/null; then
            notify-send -t $NOTIFY_TIMEOUT "Netzwerk" "$ICON_CHECK Verbunden: $ssid" -i network-wireless
        else
            notify-send -t $NOTIFY_TIMEOUT -u critical "Netzwerk" "Verbindung fehlgeschlagen\nPasswort falsch?" -i network-error
            # Bei Fehler nochmal versuchen? - das Fenster größer
            local retry=$(echo -e "Erneut versuchen\nAbbrechen" | zepos-menu --dmenu \
                --prompt "Verbindung fehlgeschlagen" \
                --width 450 \
                --height 200 \
                --cache-file /dev/null \
                --sort-order=default)

            if [[ "$retry" == "Erneut versuchen" ]]; then
                connect_to_network "$ssid"
            fi
        fi
    fi
}

disconnect_network() {
    local conn_name="${1:-$(get_active_connection_name)}"
    if [[ -n "$conn_name" ]]; then
        nmcli connection down "$conn_name" 2>/dev/null && \
            notify-send -t $NOTIFY_TIMEOUT "Netzwerk" "Getrennt: $conn_name" -i network-offline
    fi
}

# ============================================================================
# HAUPTMENÜ
# ============================================================================

build_menu() {
    local active_conn=$(get_active_connection_name)
    local active_ssid=$(get_active_wifi_ssid)

    # WiFi-Netzwerke
    echo "WLAN"
    scan_wifi_networks

    # Ethernet
    local eth_profiles=$(list_ethernet_profiles)
    if [[ -n "$eth_profiles" ]]; then
        echo "ETHERNET"
        echo "$eth_profiles"
    fi

    # Aktionen
    echo "AKTIONEN"
    [[ -n "$active_conn" ]] && echo "$ICON_INFO  Details: $active_conn"
    [[ -n "$active_conn" ]] && echo "$ICON_DISCONNECT  Trennen: $active_conn"
    echo "$ICON_REFRESH  Neu scannen"
    echo "$ICON_SETTINGS  Einstellungen"
}

# ============================================================================
# AUSWAHL
# ============================================================================

handle_selection() {
    local selection="$1"

    # Überschriften und leere Zeilen ignorieren
    [[ -z "$selection" ]] && return 0
    [[ "$selection" == "WLAN" || "$selection" == "ETHERNET" || "$selection" == "AKTIONEN" ]] && return 0

    case "$selection" in
        *"Details:"*)
            local active_ssid=$(get_active_wifi_ssid)
            local active_conn=$(get_active_connection_name)
            if [[ -n "$active_ssid" ]]; then
                show_connection_details "$active_ssid" "wifi"
            else
                show_connection_details "$active_conn" "ethernet"
            fi
            ;;
        *"Neu scannen"*)
            exec "$0"
            ;;
        *"Trennen:"*)
            disconnect_network
            ;;
        *"Einstellungen"*)
            nm-connection-editor &
            ;;
        *"$ICON_ETHERNET"*)
            local profile=$(echo "$selection" | sed "s/^.*$ICON_ETHERNET  //" | xargs)
            local active_conn=$(get_active_connection_name)
            if [[ "$selection" == *"$ICON_CHECK"* ]]; then
                show_connection_details "$profile" "ethernet"
            else
                nmcli connection up "$profile" 2>/dev/null && \
                    notify-send -t $NOTIFY_TIMEOUT "Netzwerk" "Verbunden: $profile" -i network-wired
            fi
            ;;
        *)
            # WiFi - SSID aus formatierter Zeile extrahieren
            # Format: "CHECK ICON LOCK  SSID                        XX%"
            local ssid=$(echo "$selection" | sed -E 's/^.{6}//' | sed -E 's/[0-9]+%$//' | xargs)

            if [[ -n "$ssid" ]]; then
                local active_ssid=$(get_active_wifi_ssid)
                if [[ "$ssid" == "$active_ssid" ]]; then
                    show_connection_details "$ssid" "wifi"
                else
                    connect_to_network "$ssid"
                fi
            fi
            ;;
    esac
}

# ============================================================================
# MAIN
# ============================================================================

main() {
    # Erst alle Daten sammeln, dann das Fenster starten (verhindert Flackern)
    local menu_content=$(build_menu)

    local selection=$(echo "$menu_content" | zepos-menu --dmenu \
        --prompt "Netzwerk" \
        --width $MENU_WIDTH \
        --height $MENU_HEIGHT \
        --cache-file /dev/null \
        --insensitive \
        --sort-order=default)

    handle_selection "$selection"
}

main "$@"