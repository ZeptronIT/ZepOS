#!/bin/bash
# Random Wallpaper Script - Unified Version
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/random-wallpaper-config.template

WALLPAPER_DIR="$HOME/.config/hypr/wallpapers"
PORTRAIT_DIR="$WALLPAPER_DIR/portrait"
LANDSCAPE_DIR="$WALLPAPER_DIR/landscape"
CURRENT_FILE="$HOME/.cache/current-wallpaper"

# Check if wallpaper directories exist - create them on fresh systems
if [ ! -d "$WALLPAPER_DIR" ]; then
    mkdir -p "$LANDSCAPE_DIR" "$PORTRAIT_DIR"
    echo "Created wallpaper directories at $WALLPAPER_DIR"
    echo "Add your wallpapers to:"
    echo "  - $LANDSCAPE_DIR (for wide monitors)"
    echo "  - $PORTRAIT_DIR (for rotated/portrait monitors)"
    notify-send -t 5000 "{{ICON_INFO}} Wallpaper Setup" "Wallpaper-Verzeichnisse erstellt.\nFüge Bilder hinzu in:\n~/.config/hypr/wallpapers/landscape/\n~/.config/hypr/wallpapers/portrait/"
    exit 0
fi

# Check if any wallpapers exist
wallpaper_count=$(find "$WALLPAPER_DIR" -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.jpeg" \) 2>/dev/null | wc -l)
if [ "$wallpaper_count" -eq 0 ]; then
    echo "No wallpapers found in $WALLPAPER_DIR"
    echo "Add .jpg or .png files to:"
    echo "  - $LANDSCAPE_DIR (for wide monitors)"
    echo "  - $PORTRAIT_DIR (for rotated/portrait monitors)"
    notify-send -t 5000 "{{ICON_INFO}} Wallpaper" "Keine Wallpaper gefunden.\nFüge Bilder hinzu in:\n~/.config/hypr/wallpapers/"
    exit 0
fi

# Grid Mode Toggle File
GRID_TOGGLE_FILE="$HOME/.config/hypr/.grid_mode_active"

# Check if Grid Mode is active - if yes, do nothing!
if [ -f "$GRID_TOGGLE_FILE" ]; then
    echo "Grid Mode is active - skipping wallpaper change"
    exit 0
fi

# Lock file to prevent multiple simultaneous executions
LOCKFILE="/tmp/random-wallpaper.lock"
LOCKDIR="/tmp/random-wallpaper.lockdir"

# Try to create lock directory (atomic operation)
if ! mkdir "$LOCKDIR" 2>/dev/null; then
    echo "Another instance is already running"
    exit 0
fi

# Ensure lock directory is removed on exit
trap 'rm -rf "$LOCKDIR"' EXIT

# Wait a moment to let system stabilize on boot
sleep 2

# Kill ALL vorherige swaybg Instanzen
# -x UND NICHT -f, UND DAS IST GEMESSEN (04.09.2026)
#
#     `pkill -9 -f swaybg` vergleicht die GANZE Befehlszeile - und die
#     seines eigenen Starters enthaelt "swaybg". Es erschiesst sich also
#     selbst, mitten im Aufraeumen.
#
#     GEMESSEN mit einem eigenen Muster, damit nichts Echtes getroffen
#     wird: ein `timeout 2 pkill -9 -f zepprobe-muster-xyz` endete mit
#     137 - SIGKILL, von sich selbst. Im Protokoll eines Laufes stand
#     dieselbe Zeile mit dem echten Muster:
#
#         wallpaper-manager: Zeile 256: 223953 Getoetet
#             timeout 2 pkill -9 -f swaybg
#
#     Die Folge ist keine Fehlermeldung, sondern Zufall: welche swaybg
#     das Aufraeumen noch erreicht, haengt daran, wie weit es kam. Danach
#     wird je Schirm neu gestartet - und ein Schirm, dessen alter Prozess
#     ueberlebt hat, bekommt zwei, ein anderer keinen. Auf dem Schirm
#     heisst das: schwarz.
#
#     `-x` vergleicht den PROZESSNAMEN genau. Der ist bei swaybg
#     "swaybg" und beim Aufraeumer "pkill" - kein Selbsttreffer, und
#     kein Treffer auf irgendeinen Editor, der die Datei offen hat.
pkill -9 -x swaybg

# Warte bis Prozesse sauber beendet sind (0.5s für Sicherheit)
sleep 0.5

# Doppelt sicherstellen dass alle weg sind
while pgrep -x swaybg > /dev/null; do
    pkill -9 -x swaybg
    sleep 0.1
done

# Funktion um Wallpaper für einen Monitor zu setzen
set_monitor_wallpaper() {
    local monitor_name="$1"
    local width="$2"
    local height="$3"
    local transform="$4"

    # Bei transform=1 oder 3 (90° oder 270° gedreht) sind width/height vertauscht
    if [ "$transform" = "1" ] || [ "$transform" = "3" ]; then
        # Monitor ist gedreht - Portrait
        orientation="portrait"
    elif [ "$height" -gt "$width" ]; then
        # Normale Portrait Orientierung
        orientation="portrait"
    else
        # Landscape
        orientation="landscape"
    fi

    # Wähle passendes Wallpaper
    if [ "$orientation" = "portrait" ] && [ -d "$PORTRAIT_DIR" ]; then
        wallpaper=$(find "$PORTRAIT_DIR" -name "*.jpg" -o -name "*.png" | shuf -n 1)
    elif [ "$orientation" = "landscape" ] && [ -d "$LANDSCAPE_DIR" ]; then
        wallpaper=$(find "$LANDSCAPE_DIR" -name "*.jpg" -o -name "*.png" | shuf -n 1)
    else
        wallpaper=$(find "$WALLPAPER_DIR" -name "*.jpg" -o -name "*.png" | shuf -n 1)
    fi

    if [ -n "$wallpaper" ]; then
        echo "[$monitor_name] Setze $orientation Wallpaper: $(basename "$wallpaper")"
        swaybg -o "$monitor_name" -m fill -i "$wallpaper" &

        # Save as current wallpaper (use first/primary monitor's wallpaper)
        if [ "$monitor_name" = "$(hyprctl monitors -j | jq -r '.[0].name' 2>/dev/null || echo "DP-1")" ]; then
            echo "$wallpaper" > "$CURRENT_FILE"
            notify-send -t 2000 "{{ICON_IMAGE}} Wallpaper" "$(basename "$wallpaper")"
        fi
    else
        notify-send -u critical "{{ICON_ERROR}} Wallpaper Error" "Kein $orientation Wallpaper gefunden!"
        echo "FEHLER: Kein $orientation Wallpaper gefunden für $monitor_name"
    fi
}

# Hole Monitor-Informationen und setze für jeden Monitor ein Wallpaper
if command -v jq &> /dev/null; then
    # Mit jq - lade alle Monitore in ein Array (vermeidet Subshell-Probleme)
    mapfile -t monitors < <(hyprctl monitors -j | jq -r '.[] | "\(.name) \(.width) \(.height) \(.transform)"')

    monitor_count=${#monitors[@]}
    echo "Gefundene Monitore: $monitor_count"

    # Iteriere über alle Monitore
    for monitor_info in "${monitors[@]}"; do
        read -r name width height transform <<< "$monitor_info"
        echo "Setze Wallpaper für: $name ($width x $height, transform: $transform)"
        set_monitor_wallpaper "$name" "$width" "$height" "$transform"
        # Kleine Pause zwischen den Monitoren für Stabilität
        sleep 0.3
    done
else
    # Fallback ohne jq - nicht empfohlen
    echo "WARNUNG: jq nicht installiert, Fallback-Modus"
    for monitor_name in $(hyprctl monitors -j 2>/dev/null | grep -oP '"name":\s*"\K[^"]+' || hyprctl monitors | grep "^Monitor" | awk '{print $2}' | tr -d ':'); do
        # Einfacher Fallback: Landscape für alle
        set_monitor_wallpaper "$monitor_name" "1920" "1080" "0"
        sleep 0.3
    done
fi

# Log für Debugging
echo "[$(date)] Wallpaper gesetzt für $(hyprctl monitors | grep -c "^Monitor") Monitore" >> "$HOME/.config/hypr/wallpaper.log"

# Warte kurz damit swaybg Zeit hat zu starten
sleep 0.5

# Prüfe ob swaybg-Prozesse laufen
active_processes=$(pgrep -c swaybg)
if [ "$active_processes" -eq 0 ]; then
    notify-send -u critical "{{ICON_ERROR}} Wallpaper Error" "Keine swaybg Prozesse gestartet!"
    echo "WARNUNG: Keine swaybg Prozesse aktiv!"
else
    echo "Aktive swaybg Prozesse: $active_processes"
fi