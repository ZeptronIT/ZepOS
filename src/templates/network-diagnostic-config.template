#!/bin/bash
# =========================================
# NETWORK DIAGNOSTIC SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/network-diagnostic-config.template
# =========================================
#
# Dieses Script prüft die komplette Netzwerk-Kette wenn Internet ausfällt:
# 1. Lokale Netzwerk-Interfaces
# 2. Gateway-Erreichbarkeit
# 3. Internet-Verbindung
# =========================================

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Konfiguration
#
# Gateway und Probe-Host kommen aus den Watchdog-Einstellungen. Zwei
# verschiedene Ziele wuerden Diagnose und Watchdog uneins darueber
# machen, ob die Maschine online ist. Der Ursprung hatte hier sein
# eigenes Gateway stehen, das auf jeder anderen Maschine unerreichbar
# ist: die Diagnose meldete dann "Gateway NICHT erreichbar" auf einem
# voellig gesunden Netzwerk.
GATEWAY_SETTING="{{STYLE_WATCHDOG_GATEWAY}}"
# Nur die ERSTE Zeile von "ip route show default" wird ausgewertet -
# dieselbe Regel, nach der Watchdog-Dienst und Waybar-Baustein ihre Zeile
# waehlen. Bei zwei Default-Routen nannte eine Suche ueber alle Zeilen
# hier sonst ein anderes Gateway als der Watchdog benutzt, und die
# Diagnose widersprach dem Dienst, den sie diagnostizieren soll.
DEFAULT_ROUTE_LINE="$(ip route show default 2>/dev/null | head -n 1)"
GATEWAY_IP="${GATEWAY_SETTING:-$(printf '%s\n' "$DEFAULT_ROUTE_LINE" | awk '
    {for (i = 1; i < NF; i++) if ($i == "via") {print $(i + 1); exit}}')}"
DNS_TEST="{{STYLE_WATCHDOG_TEST_HOST}}"
# Der Name, an dem die Namensaufloesung UND die Erreichbarkeit gemessen
# werden. Bis zum 17.08.2026 stand hier die deutsche Landesausgabe einer
# Suchmaschine - die sagt jedem Leser, in welchem Land der Rechner steht,
# auf dem diese Vorlage entstanden ist, und sie steht in einer Datei, die
# auf jede Installation ausgeliefert wird. archlinux.org tut dasselbe
# (ein Name, der aufgeloest werden muss, und ein Host, der antwortet),
# gehoert zu der Distribution, auf der ZepOS aufsetzt, und verraet ueber
# den Standort nichts.
INTERNET_TEST="archlinux.org"

# Log-Datei
LOG_FILE="/tmp/network-diagnostic-$(date +%Y%m%d-%H%M%S).log"

# Funktionen
log() {
    echo -e "$1" | tee -a "$LOG_FILE"
}

check_ok() {
    log "${GREEN}{{ICON_SUCCESS}} $1${NC}"
}

check_fail() {
    log "${RED}{{ICON_ERROR}} $1${NC}"
}

check_warn() {
    log "${YELLOW}{{ICON_WARNING}} $1${NC}"
}

separator() {
    log "\n${BLUE}========================================${NC}"
    log "${BLUE}$1${NC}"
    log "${BLUE}========================================${NC}\n"
}

# Start
clear
log "${GREEN}{{ICON_NETWORK}} NETZWERK DIAGNOSE${NC}"
log "Zeitstempel: $(date)"
log "Log-Datei: $LOG_FILE"
log ""

# =========================================
# 1. Lokale Interfaces prüfen
# =========================================
separator "1. LOKALE NETZWERK-INTERFACES"

# IP-Adressen anzeigen
log "{{ICON_INFO}} Aktive Interfaces:"
ip -br addr | while read line; do
    if echo "$line" | grep -q "UP"; then
        log "  ${GREEN}$line${NC}"
    else
        log "  ${YELLOW}$line${NC}"
    fi
done | tee -a "$LOG_FILE"

# Default Route prüfen
#
# Genau die Zeile, aus der oben auch das Gateway stammt. Eine zweite,
# anders formulierte Abfrage konnte hier eine andere Route anzeigen als
# die, die gleich unten geprueft wird - und "ip route | grep default"
# trifft ausserdem jede Zeile, in der das Wort irgendwo vorkommt.
log "\n{{ICON_INFO}} Default Route:"
if [ -n "$DEFAULT_ROUTE_LINE" ]; then
    check_ok "Default Route: $DEFAULT_ROUTE_LINE"
else
    check_fail "KEINE Default Route gefunden!"
fi

# =========================================
# 2. Router/Gateway prüfen
# =========================================
separator "2. ROUTER/GATEWAY"

# Drei Zustaende, nicht zwei: eine Default-Route ueber eine Punkt-zu-
# Punkt-Verbindung lautet "default dev tun0" und hat gar kein "via". Ein
# leeres GATEWAY_IP hiess frueher beides - "keine Route" und "Route ohne
# Gateway" - und meldete auf einer voellig gesunden VPN- oder Mobilfunk-
# Verbindung "keine Default-Route vorhanden".
if [ -z "$DEFAULT_ROUTE_LINE" ] && [ -z "$GATEWAY_SETTING" ]; then
    check_fail "Keine Default-Route vorhanden"
elif [ -z "$GATEWAY_IP" ]; then
    check_warn "Default-Route ohne Gateway ($DEFAULT_ROUTE_LINE) - Punkt-zu-Punkt-Verbindung, nichts zu pruefen"
elif ping -c 2 -W 2 "$GATEWAY_IP" &>/dev/null; then
    check_ok "Gateway $GATEWAY_IP erreichbar"
else
    check_fail "Gateway $GATEWAY_IP NICHT erreichbar!"
    log "  → Netzwerk zwischen diesem Rechner und dem Router ist unterbrochen"
fi

# =========================================
# 3. Internet-Verbindung prüfen
# =========================================
separator "3. INTERNET-VERBINDUNG"

# DNS Test
log "{{ICON_INFO}} Teste DNS..."
if ping -c 2 -W 2 "$DNS_TEST" &>/dev/null; then
    check_ok "DNS Server $DNS_TEST erreichbar"
else
    check_fail "DNS Server $DNS_TEST NICHT erreichbar!"
fi

# Internet Test (via Hostname)
log "\n{{ICON_INFO}} Teste Internet (DNS + Routing)..."
if ping -c 2 -W 3 "$INTERNET_TEST" &>/dev/null; then
    check_ok "Internet erreichbar ($INTERNET_TEST)"
else
    check_fail "Internet NICHT erreichbar!"

    # Detailanalyse
    log "\n{{ICON_INFO}} Traceroute zu $INTERNET_TEST:"
    traceroute -m 10 -w 2 "$INTERNET_TEST" 2>&1 | head -15 | tee -a "$LOG_FILE"
fi

# =========================================
# Zusammenfassung
# =========================================
separator "ZUSAMMENFASSUNG"

log "{{ICON_INFO}} Mögliche Problemursachen:\n"
log "1. ${YELLOW}Gateway nicht erreichbar:${NC}"
log "   → Netzwerkkabel/WLAN-Problem auf diesem Rechner"
log "   → Router-Problem\n"

log "2. ${YELLOW}Internet nicht erreichbar:${NC}"
log "   → ISP Problem"
log "   → Router hat kein Internet\n"

log "${GREEN}Log gespeichert: $LOG_FILE${NC}"
log "\nDrücke ENTER zum Beenden..."
read
