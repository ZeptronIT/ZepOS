// Die Glocke
// ---------------------------------------------------------------------

const NOTIFICATION_ICONS = {
  dnd: "{{ICON_BELL_SLASH}}",
  unseen: "{{ICON_BELL_BADGE}}",
}

/** Was die Leiste von den Meldungen wissen muss - und sonst nichts.
 *
 * WARUM DAS HEREINGEREICHT WIRD UND NICHT IMPORTIERT
 *     Der Zustand liegt in ags/widget/Notifications.tsx, im selben
 *     Prozess. Ein `import { notificationHub } from "./Notifications"`
 *     waere der kuerzere Weg und er war der erste Versuch - er ist
 *     gemessen falsch:
 *
 *     Notifications.tsx haengt an AstalNotifd, und
 *     AstalNotifd.Notifd.get_default() meldet sich am
 *     D-BUS-SITZUNGSBUS an. tests/src/bar_headless_child.tsx baut genau
 *     diese Leiste auf einer HTML5-Anzeige, und sein Kopf sagt, warum
 *     es NICHT `ags run` benutzt: "Auf einer Maschine, auf der der
 *     Nutzer gerade arbeitet, ist das der Socket SEINER Sitzung." Ein
 *     Import haette den Melder ueber die Hintertuer wieder
 *     hereingeholt - jeder Testlauf haette sich um den
 *     Benachrichtigungsdienst des angemeldeten Nutzers beworben.
 *
 *     Mit dieser Schnittstelle haengt die Leiste an drei Funktionen und
 *     an keiner Bibliothek. Das Kind reicht eine Attrappe herein, app.ts
 *     den echten Melder - dieselbe Bauart wie `toggle`, das aus
 *     demselben Grund seit jeher hereingereicht wird.
 */
export interface NotificationView {
  /** Ist "Nicht stoeren" an? */
  dnd: () => boolean
  /** Wie viele Meldungen seit dem letzten Blick ins Zentrum. */
  unseen: () => number
  /** Wird gerufen, sobald sich eines von beidem geaendert hat. */
  onChange: (listener: () => void) => void
}

/** Das einzige Modul, das keinen Prozess startet und trotzdem etwas misst.
 *
 * ES IST BEDINGT, und zwar an genau zwei Zustaenden:
 *
 *   "Nicht stoeren" ist an   Dann MUSS etwas dastehen. Ein Rechner, der
 *                            heimlich nichts mehr einblendet, ist genau
 *                            der Fehler, den Spec §7.4 fuer den
 *                            schlimmsten haelt - nichts meldet ihn,
 *                            ausser dem Nutzer, dem etwas entgangen
 *                            ist.
 *   Es kam etwas herein      Seit das Zentrum zuletzt offen war. Das
 *                            ist die Auskunft, die der Einblendstapel
 *                            nach fuenf Sekunden wegwirft.
 *
 * Sonst nichts. Die Leiste traegt achtzehn Module und laeuft auf
 * 1366x768 ueber; ein Modul, das im Ruhezustand dasteht und dasselbe
 * zeigt wie im Meldezustand, macht das schlimmer und sagt nichts.
 */
function notificationModule(name: string,
                            toggle: (name: string, at?: OverlayAnchor) => void,
                            changed: () => void,
                            notifications: NotificationView,
                            monitorName: string): Gtk.Widget {
  const { box, label } = moduleBox(name)
  box.set_visible(false)
  attachClicks(box, { toggles: "notifications" }, toggle, monitorName)

  const refresh = () => {
    // Hinter dieser Schnittstelle liegt eine Typelib (AstalNotifd), und
    // deren get_default() wirft, wenn sie fehlt. Der Aufruf liegt IN
    // der Leiste, die app.ts in einem EINZIGEN try baut - ohne diesen
    // Fang kostete eine fehlende Typelib nicht die Glocke, sondern die
    // ganze Leiste.
    let dnd = false
    let unseen = 0
    try {
      dnd = notifications.dnd()
      unseen = notifications.unseen()
    } catch (error: unknown) {
      console.error("Leistenmodul", name, error)
      box.set_visible(false)
      return
    }

    if (dnd) {
      label.set_label(NOTIFICATION_ICONS.dnd)
      box.set_tooltip_text(
        _("Do not disturb is on - it is recorded, but nothing is shown"))
      box.set_css_classes(["bar-module", "notifications", "notifications-dnd"])
      box.set_visible(true)
    } else if (unseen > 0) {
      label.set_label(`${NOTIFICATION_ICONS.unseen} ${unseen}`)
      // ngettext und nicht zwei Zeichenketten: wieviele Formen eine
      // Sprache hat, entscheidet die Sprache und nicht diese Datei.
      box.set_tooltip_text(format(
        ngettext("{count} message since you last looked",
                 "{count} messages since you last looked", unseen),
        { count: unseen }))
      box.set_css_classes(
        ["bar-module", "notifications", "notifications-unseen"])
      box.set_visible(true)
    } else {
      // Die Klassen gehen MIT. Ein verborgenes Widget, das noch
      // `notifications-dnd` traegt, ist eine Behauptung ueber einen
      // Zustand, der vorbei ist - und beim naechsten Aufgehen faerbte
      // die alte Klasse den neuen Zustand, bis die richtige Zeile
      // laeuft.
      box.set_css_classes(["bar-module"])
      label.set_label("")
      box.set_visible(false)
    }
    // Das Modul wird sichtbar und unsichtbar, und beides aendert die
    // Breite der Leiste. Ohne diese Zeile bliebe die Rechnung des
    // Einklappers auf dem Stand von vorhin.
    changed()
  }

  try {
    notifications.onChange(refresh)
  } catch (error: unknown) {
    console.error("Leistenmodul", name, error)
  }
  refresh()
  return box
}

// ---------------------------------------------------------------------
// Die Tastaturbelegung
// ---------------------------------------------------------------------
//
// WARUM ES DIESES MODUL SEIT DEM 17.08.2026 GIBT
//     BESTELLT, woertlich: "die tastatur icon fehlt auch noch links
//     neben dem datum".
//
//     Es war nichts verrutscht - GESUCHT am selben Tag ueber den ganzen
//     Baum: zu Belegung, Sprache oder xkb stand in ags-bar.template und
//     src/style_definition.py KEIN Wort. Die Leiste hat nie gesagt, mit
//     welcher Belegung getippt wird.
//
// UND DAS IST BEI DIESEM SYSTEM KEINE ZIERDE
//     Die Belegung entscheidet, wie die Passphrase beim naechsten Start
//     ankommt. Genau dort lag der Fehler vom 15.08.2026: /etc/vconsole
//     .conf fehlte in der Initramfs, libxkbcommon fiel auf "us" zurueck,
//     und die richtige Passphrase wurde abgewiesen. Ein sichtbarer
//     Zustand haette das in einer Sekunde verraten.
//
// WOHER DER WERT KOMMT, UND WARUM ER NICHT IM TAKT GEHOLT WIRD
//     `hyprctl devices -j` nennt unter "keyboards" je Geraet "layout"
//     (die eingerichtete Liste) und "active_keymap" (die geltende
//     Belegung). GEMESSEN am 17.08.2026 auf dieser Maschine:
//
//         name          at-translated-set-2-keyboard   main: true
//         layout        de
//         active_keymap German
//
//     Gefragt wird EINMAL beim Start und danach nur noch, wenn Hyprland
//     "activelayout" meldet - also wenn sich wirklich etwas geaendert
//     hat. Kein Takt, kein zweiter Ereignisstrom: der Leser in
//     utils/hyprland.ts ist derselbe, den die Arbeitsbereiche benutzen,
//     und dieses Ereignis ist dort seit heute in INTERESTING.
//
//     Die Frage traegt `timeout`, wie jeder aeussere Aufruf in
//     bar-status-config.template seit dem 16.08.2026: ein Werkzeug, das
//     nicht antwortet, haelt sonst die ganze Leiste an (siehe
//     test_ein_werkzeug_das_nie_antwortet_haelt_die_leiste_nicht_an).
const KEYBOARD_FRIST = 3

// AUS "German" WIRD "de", UND ZWAR NICHT UEBER EINE GETIPPTE TABELLE
//
//     "active_keymap" ist der KLARNAME, nicht das Kuerzel - gemessen
//     oben. Auf einer Leiste steht kein "German", und eine Liste
//     `{ German: "de", "English (US)": "us", ... }` waere eine zweite,
//     unvollstaendige Fassung einer Tabelle, die auf jeder Installation
//     ohnehin liegt: /usr/share/X11/xkb/rules/base.lst nennt im
//     Abschnitt "! layout" GENAU diese Paare, am 17.08.2026 neunundneunzig
//     Stueck, darunter "us English (US)" und "de German".
//
//     Sie kommt aus xkeyboard-config, und das ist keine neue
//     Abhaengigkeit: libxkbcommon zieht es, und zepos-hyprland nennt
//     libxkbcommon (packaging/zepos-hyprland/PKGBUILD). Ohne die Datei
//     gaebe es keine Belegung, ueber die dieses Modul berichten koennte.
//
//     Gelesen wird sie EINMAL, beim Bauen des Moduls, und ohne
//     Prozessstart.
const XKB_LAYOUT_LIST = "/usr/share/X11/xkb/rules/base.lst"

function layoutCodes(): Map<string, string> {
  const codes = new Map<string, string>()
  try {
    const [ok, bytes] = GLib.file_get_contents(XKB_LAYOUT_LIST)
    if (!ok) return codes
    const text = new TextDecoder().decode(bytes)
    let inSection = false
    for (const line of text.split("\n")) {
      if (line.startsWith("!")) {
        inSection = line.trim() === "! layout"
        continue
      }
      if (!inSection) continue
      const match = line.match(/^\s+(\S+)\s\s+(.+?)\s*$/)
      if (match) codes.set(match[2], match[1])
    }
  } catch (error: unknown) {
    console.error("Die xkb-Belegungsliste liess sich nicht lesen:", error)
  }
  return codes
}

interface KeyboardDevice {
  name: string
  main: boolean
  layout: string
  active_keymap: string
}

/** Das Modul, das sagt, mit welcher Belegung gerade getippt wird. */
function keyboardModule(name: string, changed: () => void): {
  widget: Gtk.Widget
  read: () => void
} {
  const { box, label } = moduleBox(name)
  // Unsichtbar bis zur ersten Antwort - dieselbe Regel wie bei jedem
  // Skriptmodul, aus demselben Grund.
  box.set_visible(false)
  const codes = layoutCodes()

  // Das Geraet, dessen Belegung umgeschaltet wird, und die Liste, die
  // eingerichtet ist. Beide kommen aus derselben Antwort wie der
  // angezeigte Wert, damit der Klick nicht auf einen zweiten Aufruf
  // warten muss.
  let device = ""
  let layouts: string[] = []

  // DER KLICK SCHALTET UM - ABER NUR, WENN ES ETWAS UMZUSCHALTEN GIBT
  //
  //     GEMESSEN am 17.08.2026: src/templates/hyprland-universal-config
  //     .template setzt `kb_layout = de`, also EINE Belegung.
  //     `hyprctl switchxkblayout <geraet> next` haette darauf keine
  //     Wirkung, und ein Knopf ohne Wirkung ist nach Spec §7.4 ein
  //     Fehler und keine Kleinigkeit.
  //
  //     Deshalb entscheidet die gemessene Liste und nicht der Bauplan:
  //     mit MEHREREN Belegungen traegt der Kasten die Klasse
  //     `keyboard-switchable` und bekommt damit einen Zeigergrund
  //     (src/styles/bar-style.template), mit einer traegt er sie nicht
  //     und sieht aus wie das, was er dann ist - eine Anzeige. Eine
  //     zweite Klasse fuer den Ruhefall gibt es NICHT: eine Klasse ohne
  //     Regel ist ein Name, den niemand liest.
  //
  //     GEMESSEN am 17.08.2026 im verschachtelten Compositor, mit
  //     `hyprctl keyword input:kb_layout de,us` zur Laufzeit und
  //     dreimal `switchxkblayout ... next`:
  //
  //         layout='de,us'  active_keymap='German'       -> Leiste "DE"
  //         layout='de,us'  active_keymap='English (US)' -> Leiste "US"
  //         layout='de,us'  active_keymap='German'       -> Leiste "DE"
  //
  //     Auf den drei Bildern der Leiste steht es so. Und der
  //     Ereignisstrom hat es angestossen:
  //     "activelayout>>wl_keyboard,English (US)".
  const gesture = new Gtk.GestureClick({ button: 1 })
  gesture.connect("released", () => {
    if (layouts.length < 2 || !device) return
    // Der Geraetename kommt aus einer fremden Antwort und geht in eine
    // Shell - also wird er auch so behandelt: das ist die uebliche
    // Anfuehrungsregel fuer einfache Hochkommata in sh.
    const sicher = device.replace(/'/g, "'\\''")
    run(`timeout ${KEYBOARD_FRIST} hyprctl switchxkblayout '${sicher}' next`)
  })
  box.add_controller(gesture)

  const read = () => {
    execAsync(["bash", "-c", `timeout ${KEYBOARD_FRIST} hyprctl devices -j`])
      .then((output: string) => {
        const data = JSON.parse(output) as { keyboards?: KeyboardDevice[] }
        const keyboards = data.keyboards ?? []
        // Hyprland nennt genau EINE Tastatur `main`; die uebrigen sind
        // Knoepfe am Gehaeuse und Ereignisquellen ("power-button",
        // "video-bus" - gemessen sieben Eintraege auf dieser Maschine,
        // von denen einer main ist). Ohne eine main-Tastatur nimmt das
        // Modul die erste, die es gibt, statt zu schweigen.
        const main = keyboards.find(entry => entry.main) ?? keyboards[0]
        if (!main) {
          box.set_visible(false)
          changed()
          return
        }
        device = main.name
        layouts = (main.layout ?? "").split(",")
          .map(entry => entry.trim()).filter(Boolean)

        const klarname = (main.active_keymap ?? "").trim()
        // Das Kuerzel, wenn die Tabelle den Klarnamen kennt - sonst der
        // Klarname selbst. Lieber ein langes Wort auf der Leiste als
        // eine Auskunft, die fehlt, weil ein Name nicht in einer Liste
        // stand.
        const kuerzel = codes.get(klarname) ?? klarname
        // EIN Leerzeichen, seit dem 17.08.2026.
        //
        // GEMELDET: „weniger platz fuer keyboard icon sodass mehr platz
        // rechts und links ist“. Hier standen ZWEI - und zwar als
        //
        // TYPOGRAFISCHE ANFUEHRUNGSZEICHEN UND KEINE GERADEN: in dieser
        // Datei beginnt ein gerades Anfuehrungszeichen eine
        // Zeichenkette, und der Scanner von
        // test_keine_deutsche_zeichenkette_bleibt_in_der_oberflaeche
        // liest deshalb ueber das Kommentarzeichen hinweg. Er hat das
        // Zitat am 17.08.2026 als deutschen Oberflaechentext gemeldet -
        // zu Recht, denn an dieser Stelle sah er eine Zeichenkette.
        // einzige Stelle der ganzen Leiste; kein anderes Modul trennt
        // sein Zeichen so von seinem Text. Es war ein Ausreisser, kein
        // Stilmittel, und die linke Haelfte ist seit demselben Tag die
        // engere von beiden.
        label.set_label(`${KEYBOARD_ICON} ${kuerzel.toUpperCase()}`)

        const classes = ["bar-module"]
        if (layouts.length > 1) classes.push("keyboard-switchable")
        box.set_css_classes(classes)
        // Der msgid steht in EINER Zeile, auch wenn sie lang ist:
        // xgettext liest zwei aneinandergehaengte Literale nicht als
        // eines, und ein halber msgid ist ein Eintrag, den der Katalog
        // nie findet.
        box.set_tooltip_text(layouts.length > 1
          ? format(
            _("Keyboard layout: {layout} - click switches to the next of {count}"),
            { layout: klarname, count: layouts.length })
          : format(
            _("Keyboard layout: {layout} - it is the only one configured"),
            { layout: klarname }))
        box.set_visible(true)
        changed()
      })
      .catch((error: unknown) => {
        // Keine Antwort ist eine fehlende AUSKUNFT und kein fehlendes
        // Geraet - dieselbe Unterscheidung wie in
        // bar-status-config.template. Das Modul sagt es mit dem Zeichen,
        // das die Leiste dafuer hat, statt zu verschwinden.
        console.error("Leistenmodul", name, error)
        label.set_label(`${KEYBOARD_ICON} ${STATUS_BROKEN_ICON}`)
        box.set_css_classes(["bar-module", "broken"])
        box.set_tooltip_text(
          _("hyprctl did not name the keyboard layout"))
        box.set_visible(true)
        changed()
      })
  }

  return { widget: box, read }
}

function staticModule(name: string, icon: string, tooltip: string,
                      widget: string,
                      toggle: (name: string, at?: OverlayAnchor) => void,
                      monitorName: string): Gtk.Widget {
  const { box, label } = moduleBox(name)
  label.set_label(icon)
  box.set_tooltip_text(tooltip)
  attachClicks(box, { toggles: widget }, toggle, monitorName)
  return box
}

/** Eine Leiste je Schirm. */
export default function Bar(toggle: (name: string, at?: OverlayAnchor) => void,
                            notifications: NotificationView): BarHandle {
  const display = Gdk.Display.get_default()
  const windows: Astal.Window[] = []
  if (!display) {
    console.error("Keine Anzeige - es gibt keine Leiste")
    return { windows }
  }

  const monitors = display.get_monitors()
  for (let index = 0; index < monitors.get_n_items(); index++) {
    const monitor = monitors.get_item(index) as Gdk.Monitor
    const window = new Astal.Window({
      namespace: "zepos-bar",
      name: `bar-${monitor.connector}`,
      layer: Astal.Layer.TOP,
      // TOP, LEFT und RIGHT zusammen: nur so zieht sich die Flaeche
      // ueber die volle BREITE. Mit TOP allein waere sie so breit wie
      // ihr Inhalt.
      //
      // Das ist zugleich die Stelle, an der die Reservierung von links
      // nach oben zurueckwandert: Astal rechnet die exklusive Zone aus
      // dem Anker und der Groesse. Mit TOP|LEFT|RIGHT und einer Hoehe
      // von BAR_THICKNESS reserviert sie einen Streifen OBEN - der
      // linke Rand des Schirms gehoert damit wieder den Fenstern, statt
      // ein leerer Streifen zu bleiben.
      //
      // Der zweite Streifen ist der des Docks, unten. Was die beiden
      // zusammen kosten, misst
      // test_the_bar_and_the_footer_leave_the_windows_room in
      // tests/src/test_bar_headless.py - eine Zahl, die niemand
      // schaetzen soll.
      anchor: Astal.WindowAnchor.TOP | Astal.WindowAnchor.LEFT
        | Astal.WindowAnchor.RIGHT,
      exclusivity: Astal.Exclusivity.EXCLUSIVE,
      gdkmonitor: monitor,
      visible: false,
    })
    window.add_css_class("bar-window")
    // BAR_THICKNESS + EDGE_GAP, UND DAS EINE IST DER RAND
    //
    //     Die Flaeche traegt oben einen Rand von EDGE_GAP (siehe
    //     bar-style.template, margin-top) und unten keinen. Waere sie
    //     BAR_THICKNESS hoch, LAEGE der Rand also IN der Zahl und die
    //     Platte bemalte BAR_THICKNESS - EDGE_GAP.
    //
    //     Genau das war sie bis zum 12.08.2026, und genau das war der
    //     Unterschied, den der Nutzer gesehen hat: gemessen an einem
    //     Bildschirmabzug malte der Kopf 59 Punkte und der Fuss 83.
    //     Der Fuss liest dieselbe Zahl naemlich als BEMALTE Hoehe und
    //     legt seinen Rand darunter. Zwei Lesarten einer Zahl sind
    //     zwei Zahlen.
    //
    //     Jetzt lesen beide sie gleich: BAR_THICKNESS ist, was man
    //     SIEHT, der Rand kommt obendrauf. Die Flaeche ist deshalb um
    //     genau einen Rand hoeher als das, was sie bemalt.
    //
    //     Die exklusive Zone waechst mit - Astal rechnet sie aus Anker
    //     und Groesse -, der Streifen ist also 107 statt 83 breit. Das
    //     ist kein Nebeneffekt, sondern richtig: unter der Platte
    //     beginnt sofort das Fenstergebiet, und der Abstand, den man
    //     dort sieht, ist der Aussenabstand des Fensters. Mit der
    //     alten Hoehe verlor der Fuss diesen Vergleich, weil sein
    //     Streifen bereits so gerechnet war.
    window.set_default_size(1, BAR_THICKNESS + EDGE_GAP)
    // Die Breite kommt vom Schirm und nicht vom Fenster: die Flaeche
    // ist links UND rechts verankert, also immer so breit wie der
    // Schirm - und wenn ihr Inhalt breiter ist, waechst nicht sie,
    // sondern der Inhalt laeuft ueber ihren Rand hinaus. Nach der
    // eigenen Zuteilung zu fragen hiesse, den Ueberlauf gerade dann
    // nicht zu sehen, wenn es einen gibt.
    const content = BarContent(monitor.connector, toggle,
                               () => monitor.get_geometry().width,
                               notifications)
    window.set_child(content)
    window.visible = true
    windows.push(window)
  }

  return { windows }
}
