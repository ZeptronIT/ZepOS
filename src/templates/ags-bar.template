// ---------------------------------------------------------------------
// Was ein Skriptmodul sagt
// ---------------------------------------------------------------------

// Die Form, die jedes Leistenskript ausgibt. Sie ist unveraendert die
// von waybar - zwoelf Skripte in diesem Baum schreiben sie bereits, und
// eine neue Form haette zwoelf Skripte umgeschrieben, um dasselbe zu
// sagen.
interface Payload {
  text?: string
  tooltip?: string
  class?: string
}

// GEMESSEN am 11.08.2026: kein einziges der Leistenskripte in diesem
// Baum gibt Pango-Auszeichnung aus - `grep -l '<span'` ueber alle
// Modulvorlagen findet nichts. Deshalb wird der Text als Text gesetzt
// und nicht als Markup geparst. Der Unterschied ist nicht Geschmack: ein
// Modul, dessen Text ein "&" oder ein "<" enthaelt - ein SSID-Name
// genuegt -, faerbt mit set_markup() die ganze Leiste mit einer
// GLib-Warnung ein und zeigt nichts an.
function applyPayload(label: ModuleLabel, box: Gtk.Widget, name: string,
                      payload: Payload): void {
  const text = payload.text ?? ""
  label.set_label(text)

  // Leerer Text heisst "nichts zu sagen". Das Modul verschwindet dann,
  // statt als leerer Kasten mit Rahmen und Abstand dazustehen.
  box.set_visible(text !== "")

  const tooltip = payload.tooltip ?? ""
  box.set_has_tooltip(tooltip !== "")
  if (tooltip !== "") box.set_tooltip_text(tooltip)

  // Der Modulname bleibt immer, die gemeldete Klasse kommt dazu. So
  // trifft `#custom-hardware` das Modul und `.hardware-warning` seinen
  // Zustand - dieselbe Aufteilung, auf der die Stilvorlage schon beruht.
  const classes = ["bar-module"]
  if (payload.class) classes.push(...payload.class.split(/\s+/).filter(Boolean))
  box.set_css_classes(classes)
  void name
}

interface ClickSpec {
  onClick?: string
  onClickRight?: string
  onClickMiddle?: string
  onScrollUp?: string
  onScrollDown?: string
  /** Ein Ueberlagerungsfenster dieses Prozesses statt eines Befehls. */
  toggles?: string
  /** Dasselbe fuer die rechte Taste - siehe custom/date. */
  togglesRight?: string
}

/** Was ein Klick tut. Ein Befehl geht in eine Shell, ein Fenster nicht.
 *
 * `bash -c` und nicht der nackte Befehl, und das ist gemessen und nicht
 * vorsichtshalber: Astals execAsync startet KEINE Shell, es zerlegt die
 * Zeichenkette mit GLib.shell_parse_argv und startet argv direkt. Ein
 * "$HOME" darin bliebe ein Dollarzeichen und ein Wort. Die Messung dazu
 * steht im Kopf von tests/src/test_ags_exec.py.
 */
function run(command: string): void {
  execAsync(["bash", "-c", command]).catch((error: unknown) => {
    console.error("Leistenmodul:", command, error)
  })
}

/** WO DIESES MODUL SITZT - die Angabe, die sein Fenster braucht.
 *
 * WARUM SIE NICHT DER MAUSZEIGER IST (17.08.2026)
 *     GEMELDET: "die modale fuer kontroll zentrum erscheint ganz links
 *     im fenster buggy wir brauchen es aber dort der user mit maus
 *     raufklickt".
 *
 *     utils/overlay.ts hat die Lage bis dahin aus `hyprctl cursorpos`
 *     genommen. GEMESSEN am selben Tag auf 1920x1200, dreimal derselbe
 *     Aufruf und nur der Zeiger woanders: Zahnrad (1872) -> Fenster bei
 *     x=1401, Bildmitte (960) -> 713, Datum (120) -> 24. Die letzte Zahl
 *     ist der linke Bildrand aus der Meldung.
 *
 *     Ein Modul WEISS, wo es steht. Diese Funktion fragt es.
 *
 * WARUM DIE WURZEL DER RICHTIGE BEZUGSPUNKT IST
 *     compute_bounds() rechnet gegen ein anderes Widget; die WURZEL ist
 *     das Leistenfenster. Dessen Layer-Shell-Flaeche haengt an
 *     TOP|LEFT|RIGHT ohne Rand, liegt also mit ihrer linken oberen Ecke
 *     genau auf der Ecke ihres Schirms - GEMESSEN im verschachtelten
 *     Compositor: `zepos-bar x=0 y=0 b=1920 h=84`. Was ein Modul in
 *     dieser Flaeche fuer eine Lage hat, IST damit seine Lage auf dem
 *     Schirm. Der Rand der Platte (#bar, margin-left) steckt darin
 *     schon, weil er innerhalb der Flaeche liegt.
 *
 * WARUM ES EIN Schirm-NAME IST UND KEINE COMPOSITOR-KOORDINATE
 *     Gdk und Hyprland zaehlen ihre Schirme nicht gleich, und die
 *     globale Lage eines Ausgangs meldet Gdk auf Wayland nicht
 *     verlaesslich. utils/overlay.ts loest den ANSCHLUSSNAMEN ohnehin
 *     schon gegen `hyprctl monitors -j` auf (findGdkMonitorByName), also
 *     wird hier derselbe Name weitergereicht statt einer Zahl, die erst
 *     stimmen muesste.
 *
 * Ohne Wurzel gibt es keine Antwort - dann bleibt der Zeiger, und das
 * ist genau der Fall des Testkindes, das die Leiste ohne Fenster baut.
 */
function anchorOf(widget: Gtk.Widget,
                  monitorName: string): OverlayAnchor | undefined {
  const root = widget.get_root()
  if (!root) return undefined
  const [ok, bounds] = widget.compute_bounds(root as unknown as Gtk.Widget)
  if (!ok) return undefined
  return {
    monitor: monitorName,
    x: Math.round(bounds.origin.x + bounds.size.width / 2),
  }
}

function attachClicks(widget: Gtk.Widget, spec: ClickSpec,
                      toggle: (name: string, at?: OverlayAnchor) => void,
                      monitorName: string): void {
  // Die Lage wird beim KLICK gerechnet und nicht beim Bauen: ein Modul
  // wandert, sobald ein Nachbar ein- oder ausklappt.
  const open = (name: string) => toggle(name, anchorOf(widget, monitorName))

  const primary = spec.toggles
    ? () => open(spec.toggles as string)
    : spec.onClick ? () => run(spec.onClick as string) : null

  if (primary) {
    const gesture = new Gtk.GestureClick({ button: 1 })
    gesture.connect("released", primary)
    widget.add_controller(gesture)
  }
  const secondary = spec.togglesRight
    ? () => open(spec.togglesRight as string)
    : spec.onClickRight ? () => run(spec.onClickRight as string) : null
  if (secondary) {
    const gesture = new Gtk.GestureClick({ button: 3 })
    gesture.connect("released", secondary)
    widget.add_controller(gesture)
  }
  if (spec.onClickMiddle) {
    const gesture = new Gtk.GestureClick({ button: 2 })
    gesture.connect("released", () => run(spec.onClickMiddle as string))
    widget.add_controller(gesture)
  }
  if (spec.onScrollUp || spec.onScrollDown) {
    const scroll = new Gtk.EventControllerScroll({
      flags: Gtk.EventControllerScrollFlags.VERTICAL,
    })
    scroll.connect("scroll", (_source: Gtk.EventControllerScroll,
                              _dx: number, dy: number) => {
      if (dy < 0 && spec.onScrollUp) run(spec.onScrollUp)
      if (dy > 0 && spec.onScrollDown) run(spec.onScrollDown)
      return true
    })
    widget.add_controller(scroll)
  }
}

/** Ein Kasten mit einer Beschriftung, benannt wie das Modul heisst.
 *
 * Der Name ist der Waybar-Name mit "/" zu "-": aus "custom/date" wird
 * "custom-date". Das ist genau der Selektor, den die Stilvorlagen dieses
 * Projekts seit jeher benutzen - #custom-date, #custom-hardware,
 * #battery -, also bleiben sie gueltig, statt dass 60 Regeln
 * umgeschrieben werden muessten.
 */
function moduleBox(name: string): { box: Gtk.Box; label: ModuleLabel } {
  const label = new ModuleLabel()
  const box = new Gtk.Box({ orientation: Gtk.Orientation.HORIZONTAL })
  box.set_name(name.replace("/", "-"))
  box.add_css_class("bar-module")
  box.append(label.cell)
  box.append(label.value)
  return { box, label }
}

// ---------------------------------------------------------------------
// Das Zeichen bekommt eine Zelle - und die Zelle sitzt auf der Tinte
// ---------------------------------------------------------------------
//
// GEMELDET am 20.08.2026, zum dritten Mal: "wlan symbol immernoch nicht
// zentriert", davor "bluetooth icon oben im header ist nicht zentriert
// auch das wlan icon nicht".
//
// "IMMERNOCH" TRIFFT ZU, UND ZWEI VERSCHIEDENE URSACHEN HALTEN ES AM
// LEBEN. Beide sind am 20.08.2026 mit tests/src/test_bar_headless.py
// gemessen worden, Vorgabegroesse, echte Zeichen, VOR jeder Aenderung:
//
//   1. ZENTRIERT WIRD DER VORSCHUB, GESEHEN WIRD DIE TINTE.
//
//      Die Behebung vom 19.08.2026 haengte die Mindestbreite an die
//      Beschriftung, damit eine Gtk.Label ihren Satz mittig hineinsetzt
//      (xalign 0.5). Eine Gtk.Label zentriert dabei die LOGISCHE
//      Breite - den Vorschub, den die Schrift fuer das Zeichen
//      vorsieht. Was der Nutzer sieht, ist die TINTE.
//
//      Bei den Zeichen dieser Leiste fallen die beiden auseinander,
//      und zwar weit. GEMESSEN mit Pango, "Fira Code, JetBrainsMono
//      Nerd Font", 20 px, Vorschub jeweils 12 px:
//
//          ICON_WIFI_1..4        Tinte 20 px   Versatz +4,0
//          ICON_DISCONNECTED     Tinte 19 px   Versatz +3,5
//          ICON_ALERT            Tinte 19 px   Versatz +3,5
//          ICON_ETHERNET         Tinte 17 px   Versatz +2,5
//          ICON_SETTINGS         Tinte 17 px   Versatz +2,5
//          ICON_BLUETOOTH_CONN.  Tinte 16 px   Versatz +2,0
//          ICON_CALENDAR/CPU/..  Tinte 15 px   Versatz +1,5
//          ICON_BLUETOOTH        Tinte 12 px   Versatz  0,0
//
//      Die Tinte beginnt bei jedem dieser Zeichen am Stift (ink.x = 0)
//      und laeuft nach RECHTS ueber den Vorschub hinaus. Ein Zeichen,
//      dessen Vorschub mittig sitzt, sitzt also um den halben Ueberhang
//      zu weit rechts - beim WLAN-Zeichen um 4 von 36 Punkten. Genau
//      das ist die Meldung, und genau das hat die Messung vom
//      19.08.2026 nicht gesehen: sie las die logischen Ausmasse.
//
//   2. ZENTRIERT WIRD DER GANZE SATZ, GEMEINT IST DAS ZEICHEN.
//
//      Ein Modul, dessen Text aus Zeichen UND Wert besteht, trug beides
//      in EINER Beschriftung. Zentriert wurde damit die Zeichenkette,
//      und das Zeichen steht an ihrem Anfang. GEMESSEN, Lage des
//      Zeichens im Modul, links:rechts:
//
//          bluetooth  "<Zeichen> 2"      8:33
//          pulseaudio "<Zeichen> 100%"   8:70
//          battery    "<Zeichen> 87%"    8:58
//
//      Die Zeile `zentriert` meldete fuer alle drei 8:8 und hat sie
//      damit als "schon symmetrisch" durchgewinkt. Symmetrisch war die
//      POLSTERUNG; das Zeichen sass am Rand.
//
// DIE ANTWORT AUF BEIDE IST DIESELBE UND GILT FUER JEDES MODUL: das
// Zeichen bekommt eine eigene Zelle fester Breite (.bar-symbol,
// STYLE_BAR_SYMBOL_WIDTH), der Wert steht daneben (.bar-value), und in
// der Zelle wird die TINTE zentriert und nicht der Vorschub.
//
// WIE DIE TINTE ZENTRIERT WIRD, OHNE DASS JEMAND DIE ZELLENBREITE KENNT
//     Die Beschriftung haengt mittig in der Zelle (halign CENTER). Ihr
//     Versatz e = Tintenmitte - Vorschubmitte haengt NUR am Zeichen und
//     nicht an der Zelle. Ein Aussenrand von 2e auf der Gegenseite
//     verschiebt eine mittig haengende Beschriftung um genau e zurueck -
//     damit liegt die Tintenmitte auf der Zellenmitte, und zwar bei
//     jeder Zellenbreite. Die Breite steht deshalb weiter allein im
//     Stylesheet, wo die Groessen dieses Hauses stehen.
//
//     KEIN xalign: das braeuchte die ZUGETEILTE Breite der Beschriftung,
//     also eine zweite Fassung von STYLE_BAR_SYMBOL_WIDTH in
//     TypeScript - eine Zahl, die beim naechsten Drehen an der Sprosse
//     stillschweigend falsch waere.
//
// WAS EIN ZEICHEN IST: ein Punkt ab U+E000. Die Nerd-Font-Zeichen
// liegen samt und sonders in den beiden privaten Bereichen (U+E000 bis
// U+F8FF und Ebene 15/16); Buchstaben, Ziffern und Satzzeichen liegen
// darunter. Ein Fenstertitel faengt damit KEIN Zeichen ein und bekommt
// keine Zelle - er ist reiner Wert und sieht aus wie bisher.
const SYMBOL_FIRST_POINT = 0xe000

/** Zeichen und Wert trennen: der fuehrende Zeichenlauf, dann der Rest. */
function splitSymbol(text: string): [string, string] {
  let cut = 0
  for (const character of text) {
    if ((character.codePointAt(0) ?? 0) < SYMBOL_FIRST_POINT) break
    cut += character.length
  }
  // Der Trenner faellt: die Skripte schreiben ein oder zwei Leerzeichen
  // zwischen Zeichen und Wert (date.sh zwei, status.sh eines), und ein
  // Leerzeichen dieser Schrift ist 12 Punkte breit. Der Abstand steht
  // seither EINMAL im Stylesheet (.bar-value) statt ein- oder zweimal
  // in zwoelf Skripten - und die Leiste wird davon schmaler, nicht
  // breiter.
  return [text.slice(0, cut), text.slice(cut).replace(/^\s+/, "")]
}

/** Eine Zelle mit EINEM Zeichen darin, dessen TINTE mittig liegt.
 *
 * SIE IST SEIT DEM 20.08.2026 EXPORTIERT, UND DAS IST EINE MELDUNG
 * (Aufgabe 47)
 *     GEMELDET: "die 6 punkte sind nicht zentriert" - der Starterknopf
 *     unten rechts, also ein Zeichen, das gar nicht auf der Leiste
 *     steht.
 *
 *     Die Behebung vom selben Tag (dea3f0b) hat diese Zelle gebaut und
 *     JEDEM MODUL DER LEISTE gegeben. Die beiden freistehenden Knoepfe
 *     am Dock haben davon nichts abbekommen: sie bauen ihre eigene
 *     Flaeche und trugen ihr Zeichen in einer blanken Gtk.Label. Dass
 *     sie es nicht taten, lag nicht an einer Entscheidung, sondern
 *     daran, dass dieses Bauteil hier eingeschlossen war.
 *
 *     Es ist EIN Bauteil und keine Bauanleitung, die man zweimal
 *     befolgt: ags-power-button.template und ags-starter-button.template
 *     importieren es. Eine zweite Fassung von centreInk() waere eine
 *     zweite, die auseinanderlaufen kann - und diese Rechnung ist an
 *     einem Tag schon dreimal falsch gewesen.
 *
 * KEIN Gtk.Widget und kein GObject: dieses Ding hat keine eigene
 * Darstellung. Ein eigener GTyp waere ein Widget mehr in jedem Modul,
 * das nichts zeichnet.
 */
export class SymbolCell {
  readonly cell: Gtk.CenterBox
  readonly symbol: Gtk.Label

  constructor(text = "") {
    this.symbol = new Gtk.Label({ label: text })
    // EIN Gtk.CenterBox UND KEIN Gtk.Box, und das ist gemessen.
    //
    // Ein Gtk.Box teilt seinem Kind die NATUERLICHE Breite zu und
    // packt es an den Anfang; was die Mindestbreite darueber hinaus
    // fordert, bleibt hinten liegen. GEMESSEN am 20.08.2026 mit genau
    // diesem Aufbau: `zeichen ...=0:8` fuer JEDES Modul - das Zeichen
    // klebte links, die 8 Punkte der Zelle lagen rechts. Es ist
    // dieselbe Eigenschaft, an der schon der Versuch vom 19.08.2026
    // gescheitert ist, nur eine Ebene tiefer.
    //
    // halign CENTER allein hilft nicht: eine Ausrichtung wirkt
    // innerhalb der ZUTEILUNG, und die war die natuerliche Breite. Ein
    // Gtk.CenterBox mittet sein mittleres Kind dagegen in seiner
    // ganzen Zuteilung - ohne hexpand, das sonst durch jeden
    // Elternteil bis zum CenterBox der Leiste hochwanderte.
    //
    // In einem Knopf ist es dieselbe Eigenschaft, nur eine Ebene
    // hoeher: ein Gtk.Button teilt seinem Kind den ganzen Innenraum zu,
    // und das CenterBox mittet das Zeichen darin. Deshalb sitzt die
    // Tinte dort mittig IN DER PLATTE, ohne dass jemand die
    // Plattenbreite kennt.
    this.cell = new Gtk.CenterBox()
    this.cell.add_css_class("bar-symbol")
    this.cell.set_center_widget(this.symbol)
    // NOCH EINMAL BEIM EINBLENDEN, und das ist keine Vorsicht, sondern
    // eine Messung: die Schrift eines Widgets kommt aus dem Stil, und
    // den hat es erst, wenn es an einer Anzeige haengt. Ein
    // PangoLayout, das VORHER gelesen wird, traegt die Vorgabeschrift
    // des GTK-Themas - und damit eine Tinte, die es auf der Leiste nie
    // gibt.
    //
    // Fuer die zwei Knoepfe am Dock ist genau das der ganze Weg: ihr
    // Zeichen steht beim Bauen fest und aendert sich nie, also ist
    // dieses eine Mal beim Einblenden auch das einzige Mal.
    this.symbol.connect("map", () => this.centreInk())
  }

  set_symbol(text: string): void {
    this.symbol.set_label(text)
    if (text !== "") this.centreInk()
  }

  /** Das Zeichen so ruecken, dass seine TINTE mittig in der Zelle liegt. */
  private centreInk(): void {
    const layout = this.symbol.get_layout()
    if (!layout) return
    const [ink, logical] = layout.get_pixel_extents()
    if (logical.width === 0) return
    const versatz = ink.x + ink.width / 2 - logical.width / 2
    this.symbol.set_margin_start(versatz < 0 ? Math.round(-2 * versatz) : 0)
    this.symbol.set_margin_end(versatz > 0 ? Math.round(2 * versatz) : 0)
  }
}

/** Die Beschriftung eines Moduls: ein Zeichen in seiner Zelle, ein Wert
 * daneben.
 *
 * KEIN Gtk.Widget und kein GObject: dieses Ding hat keine eigene
 * Darstellung, es haelt zwei Widgets zusammen und beantwortet die eine
 * Frage, die die Module ihm stellen - `set_label`. Ein eigener GTyp
 * waere ein drittes Widget in jedem Modul, das nichts zeichnet.
 */
class ModuleLabel {
  readonly zelle: SymbolCell
  readonly cell: Gtk.CenterBox
  readonly value: Gtk.Label

  constructor() {
    this.zelle = new SymbolCell()
    this.cell = this.zelle.cell
    this.cell.set_visible(false)
    this.value = new Gtk.Label({ label: "" })
    this.value.add_css_class("bar-value")
    this.value.set_visible(false)
  }

  set_label(text: string): void {
    const [symbol, value] = splitSymbol(text)
    this.zelle.set_symbol(symbol)
    this.cell.set_visible(symbol !== "")
    this.value.set_label(value)
    this.value.set_visible(value !== "")
  }

  /** Nur der Wert ellipsiert - eine Zelle hat genau ein Zeichen drin. */
  set_ellipsize(mode: Pango.EllipsizeMode): void {
    this.value.set_ellipsize(mode)
  }

  set_max_width_chars(chars: number): void {
    this.value.set_max_width_chars(chars)
  }
}

// Was auf der Leiste steht, wenn ein Skript selbst nicht antwortet -
// fuer die fuenf aus status.sh wie fuer jedes einzelne Modul. EIN
// Zeichen fuer einen Zustand, und nicht zwei: die beiden Stellen
// beschreiben denselben Fall, und zwei Zeichen dafuer waeren zwei
// Fehlerbilder, zwischen denen niemand unterscheiden koennte.
const STATUS_BROKEN_ICON = "{{ICON_ALERT}}"

/** Wie ein Leistenskript gestartet wird - und warum nicht einfach `bash`.
 *
 * `env -u LD_PRELOAD` DAVOR, UND DAS IST DIE TEUERSTE ZEILE DER LEISTE
 * GEWESEN
 *
 *     GEMESSEN am 20.08.2026, waehrend der Suche nach dem Verzug der
 *     Lautstaerkeanzeige. Dasselbe status.sh, derselbe Rechner:
 *
 *         aus einer Shell heraus                     87 ms
 *         aus dem AGS-Prozess ueber execAsync       694 ms
 *
 *     Der Unterschied ist EINE Umgebungsvariable. `ags` startet die
 *     Oberflaeche als
 *
 *         LD_PRELOAD="/usr/lib/libgtk4-layer-shell.so" gjs -m ...
 *
 *     (nachgesehen in /usr/bin/ags und, wichtiger, am laufenden Prozess
 *     dieser Sitzung: /proc/<pid>/environ traegt es). LD_PRELOAD wird
 *     VERERBT. Jedes Kind, das die Leiste startet, laedt damit
 *     libgtk4-layer-shell - und mit ihr GTK4 - bevor es seine erste
 *     Zeile ausfuehrt. status.sh startet gut ein Dutzend Prozesse
 *     (bash, jq, wpctl dreimal, nmcli, bluetoothctl, awk, grep, cut),
 *     und JEDER von ihnen zahlte das.
 *
 *     Gemessen an derselben Stelle, mit derselben Schleife:
 *
 *         ["bash", "-c", skript]                      694 ms
 *         ["env", "-u", "LD_PRELOAD", "bash", ...]     107 ms
 *
 *     Keines dieser Kinder ist ein GTK4-Programm, geschweige denn eines
 *     mit einer Layer-Shell-Flaeche. Die Bibliothek gehoert dem
 *     gjs-Prozess, und der hat sie laengst geladen - der Lader liest
 *     LD_PRELOAD beim Start und danach nie wieder. Sie den Kindern
 *     wegzunehmen nimmt ihm also nichts.
 *
 *     WARUM HIER UND NICHT EINMAL PROZESSWEIT: ein GLib.unsetenv beim
 *     Laden dieses Moduls waere kuerzer und wuerde auch fuer jedes
 *     andere Modul der Oberflaeche gelten - genau deshalb steht es
 *     nicht da. Diese Vorlage baut die LEISTE; die Umgebung des ganzen
 *     Prozesses ist nicht ihre, und eine Aenderung daran waere von
 *     ags-network.tsx oder ags-vpn.tsx aus nicht mehr zu sehen.
 *
 * `env` und nicht `/usr/bin/env`: execAsync startet argv[0] ueber PATH,
 * und env ist coreutils - dieselbe Klasse wie `timeout` und `cat`, auf
 * die sich bar-status-config.template schon verlaesst.
 */
const SKRIPT_START = ["env", "-u", "LD_PRELOAD", "bash", "-c"]

interface ScriptSpec extends ClickSpec {
  name: string
  /** Der Befehl, der die JSON-Zeile schreibt. */
  exec: string
  /** Millisekunden. 0 heisst: einmal beim Start, danach nie wieder. */
  intervalMs: number
}

function scriptModule(spec: ScriptSpec,
                      toggle: (name: string, at?: OverlayAnchor) => void,
                      changed: () => void,
                      monitorName: string): Gtk.Widget {
  const { box, label } = moduleBox(spec.name)
  attachClicks(box, spec, toggle, monitorName)

  // Unsichtbar bis zur ersten Antwort. Sonst blitzt beim Anmelden fuer
  // die Dauer des ersten Aufrufs eine Reihe leerer Kaesten auf.
  box.set_visible(false)

  const poll = () => {
    execAsync([...SKRIPT_START, spec.exec])
      .then((output: string) => {
        const line = output.trim()
        if (!line) { applyPayload(label, box, spec.name, {}); changed(); return }
        try {
          applyPayload(label, box, spec.name, JSON.parse(line) as Payload)
        } catch {
          // Kein JSON: das Skript hat etwas anderes geschrieben, meist
          // eine Fehlermeldung. Sie ist der beste Text, den das Modul
          // gerade hat - besser als ein leerer Kasten, ueber den nichts
          // erklaert, warum er leer ist.
          applyPayload(label, box, spec.name, { text: line, class: "broken" })
        }
        changed()
      })
      .catch((error: unknown) => {
        // EIN SKRIPT, DAS GAR NICHT LAEUFT, DARF NICHT STILL SEIN -
        // dieselbe Regel wie in sharedStatus() darunter, und bis zum
        // 13.08.2026 stand hier ihr Gegenteil.
        //
        //     `applyPayload(..., {})` setzt einen leeren Text, und ein
        //     leerer Text blendet das Modul aus. Ein Skript, das FEHLT
        //     oder mit einem Fehler endet, sah damit genauso aus wie
        //     eines, das antwortet und nichts zu sagen hat - der
        //     Unterschied stand allein in einem Protokoll, das niemand
        //     liest.
        //
        //     Das ist derselbe Mangel, den der Nutzer am 13.08.2026 an
        //     der rechten Haelfte gemeldet hat ("rechts ist zu leer"),
        //     nur an der anderen Sorte Modul: dort kamen Netz, Ton und
        //     Akku aus EINEM Aufruf, hier hat jedes Modul seinen
        //     eigenen. Ihn dort zu beheben und hier stehenzulassen
        //     hiesse, die Haelfte einer Regel einzufuehren.
        //
        // LEER BLEIBT LEER: der Zweig oben, in dem das Skript ANTWORTET
        // und nichts sagt, ist unveraendert - das ist eine Auskunft.
        // Nur das Nichtantworten ist jetzt sichtbar.
        console.error("Leistenmodul", spec.name, error)
        applyPayload(label, box, spec.name, {
          text: STATUS_BROKEN_ICON,
          tooltip: format(_("{module} is not answering: {error}"),
                          { module: spec.name, error: String(error) }),
          class: "broken",
        })
        changed()
      })
  }

  poll()
  if (spec.intervalMs > 0) interval(spec.intervalMs, poll)
  return box
}

