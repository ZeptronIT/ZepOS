// { OverlayAnchor }` waere zur Laufzeit die Anforderung eines
// Ausfuhrnamens, den es in der uebersetzten utils/overlay.js gar nicht
// gibt - eine Schnittstelle ist kein Wert.
//
// Die Fabrik selbst wird hier NICHT geholt. tests/src/test_modal_rule.py
// haelt fest, dass nur sie Aufklappfenster baut; die Leiste OEFFNET
// welche, und dafuer genuegt zu wissen, wie man sagt, wo man geklickt
// hat.
import type { OverlayAnchor } from "../utils/overlay"

