interface SharedSink {
  key: string
  box: Gtk.Box
  label: ModuleLabel
}

// ---------------------------------------------------------------------
// Ton und Mikrofon: sagen lassen statt nachfragen
// ---------------------------------------------------------------------
//
// GEMELDET am 20.08.2026: "wenn ich den lautstärke regler herunter und
// hoch mache soll der header die prozent zahl genau so aktualisieren".
//
// Seit dem 19.08.2026 tragen Ton und Mikrofon ihre Prozentzahl auf der
