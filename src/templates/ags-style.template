  // setzt shortcuts_accent auf denselben Farbwert wie overlay_accent
  // (beide CYAN_TEXT, #33C9EE) - das Zeichen waere also GENAUSO farbig
  // wie sein eigener Hintergrund und damit unsichtbar gewesen, und $text
  // (#DCEEF4, fast weiss) auf #33C9EE haette kaum Kontrast getragen.
  // zep-btn-voll setzt fuer genau diesen Fall `color: $bg` - dieselbe
  // Farbe uebernehmen Zeichen und Beschriftung hier, statt sich auf die
  // Vererbung vom Knopf zu verlassen (beide Klassen setzen ihre eigene
  // `color` und ueberschreiben sie damit ohnehin).
  .sc-edit-icon {
    font-size: {{STYLE_ICON_CAPTION}};
    color: $bg;
  }

  .sc-edit-label {
    font-size: {{STYLE_FONT_BODY}};
    color: $bg;
  }
}

