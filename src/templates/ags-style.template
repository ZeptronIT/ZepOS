// AGS Widget Styles
// Generated by ZepOS - Muted Dark Theme (HyprLaunch/HyprClipX)

$bg: {{STYLE_COLOR_OVERLAY_BG}};
$surface: {{STYLE_COLOR_OVERLAY_SURFACE}};
$text: {{STYLE_COLOR_OVERLAY_TEXT}};
$subtext: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
$accent: {{STYLE_COLOR_OVERLAY_ACCENT}};
$accent-hover: {{STYLE_COLOR_OVERLAY_ACCENT_HOVER}};
$accent-dim: {{STYLE_COLOR_OVERLAY_ACCENT_DIM}};
$item-hover: {{STYLE_COLOR_OVERLAY_ITEM_HOVER}};
$border: {{STYLE_OVERLAY_BORDER_COLOR}};
$yellow: {{STYLE_COLOR_WARNING}};
$red: {{STYLE_COLOR_CRITICAL}};
$green: {{STYLE_COLOR_OVERLAY_GREEN}};
$launcher-accent: {{STYLE_COLOR_LAUNCHER_ACCENT}};
$calendar-accent: {{STYLE_COLOR_CALENDAR_ACCENT}};
$shortcuts-accent: {{STYLE_COLOR_SHORTCUTS_ACCENT}};
$battery-accent: {{STYLE_COLOR_BATTERY_ACCENT}};
$disk-accent: {{STYLE_COLOR_DISK_ACCENT}};
$control-accent: {{STYLE_COLOR_CONTROL_ACCENT}};
$network-accent: {{STYLE_COLOR_NETWORK_ACCENT}};
$wallpaper-accent: {{STYLE_COLOR_WALLPAPER_ACCENT}};
$style-accent: {{STYLE_COLOR_STYLE_ACCENT}};
$vpn-accent: {{STYLE_COLOR_VPN_ACCENT}};
$overlay-border: $border;

// ── DIE BAUTEILE ────────────────────────────────────────────────────
//
// Was hier steht, gehoert zu ags-kit.template. Die Regeln darunter mit
// eigenen Praefixen (.cc-, .net-, .vpn- …) sind der Bestand, der nach
// und nach hierher wandert - siehe die Ratsche in
// tests/src/test_button_kit.py.

.zep-btn {
  min-height: {{STYLE_CONTROL_HEIGHT}};
  padding: 0 {{STYLE_SPACE_16}};
  border-radius: {{STYLE_RADIUS_CONTROL}};
  font-size: {{STYLE_FONT_BODY}};
  border: 1px solid transparent;
  transition: background-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}},
              border-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};
}

// Die Hauptsache je Fenster. Genau EINE je Ansicht - zwei volle Knoepfe
// nebeneinander heissen, dass keiner die Hauptsache ist.
.zep-btn-voll {
  background: $accent;
  color: $bg;
  font-weight: 500;

  &:hover { background: $control-accent; }
}

.zep-btn-umrandet {
  background: rgba($surface, 0.55);
  border-color: $border;
  color: $text;

  &:hover { background: rgba($surface, 0.75); }
}

.zep-btn-still {
  background: transparent;
  color: $subtext;

  &:hover { background: rgba($surface, 0.4); color: $text; }
}

.zep-btn-kritisch {
  background: rgba($red, 0.14);
  border-color: rgba($red, 0.5);
  color: $red;

  &:hover { background: rgba($red, 0.24); }
}

.zep-btn:disabled {
  background: rgba($surface, 0.3);
  border-color: rgba($border, 0.5);
  color: $subtext;
}

.zep-row {
  min-height: {{STYLE_ROW_HEIGHT}};
  padding: 0 {{STYLE_SPACE_12}};
  border-radius: {{STYLE_RADIUS_CARD}};
  border-left: 3px solid transparent;

  &:hover { background: $item-hover; }

  // AUSGEWAEHLT, 18.08.2026: task-5 (Bluetooth) ist der erste
  // Verbraucher - das verbundene Geraet muss sich von den uebrigen
  // abheben. Dieselbe Sprache wie .se-tab-btn.active: Farbtoenung im
  // Hintergrund plus ein Randstreifen, aus $accent statt einem
  // fenstereigenen Akzent, weil zepRow ein geteiltes Bauteil ist und
  // keinem Fenster gehoert.
  //
  // BERICHTIGT am 18.08.2026 (Task D): die zwei anderen hier genannten
  // Beispiele, .net-item.active (Task C) und .cc-toggle-btn.active
  // (Task D), sind inzwischen selbst entfernt - der Vergleich zeigt
  // jetzt nur noch das verbliebene .se-tab-btn.active.
  &.active {
    background: rgba($accent, 0.15);
    border-left-color: $accent;
  }

  // NACHGETRAGEN am 19.08.2026 (Aufgabe 19): der Modifikator, den
  // zepSidebar() setzt (`navEintrag`, ags-kit.template) - siehe die
  // Herleitung bei STYLE_NAV_ROW_HEIGHT in sizes.py. `&.zep-row-nav`
  // compiliert zu `.zep-row.zep-row-nav` (Spezifitaet 0,2,0), schlaegt
  // die einfache `.zep-row`-Regel oben (0,1,0) also UNABHAENGIG von der
  // Reihenfolge im Stylesheet - dieselbe Lehre wie bei .cc-container
  // gegen .zep-shell-page (Bericht Aufgabe 17/18): zwei Regeln gleicher
  // Spezifitaet lassen die spaeter geschriebene gewinnen, eine Klassen-
  // Verbindung mit hoeherer Spezifitaet gewinnt unabhaengig davon.
  //
  // NACHGETRAGEN am 19.08.2026 (Aufgabe 27, Musterblatt "Die Schale"):
  // min-height war schon richtig, aber Radius und Polsterung fielen
  // weiter auf die Regel von .zep-row oben zurueck - RADIUS_CARD (12px)
  // und SPACE_12 (18px), die Masse einer Inhaltskarte (Zeile, 74px
  // hoch), nicht die eines einzeiligen Navigationseintrags (49px). Die
  // aeussere Knopfhuelle ist mit 74008b5 schon gefallen, diese Kartenmasse
  // waren der Rest derselben Wurzel. GEMESSEN gegen das Musterblatt
  // (Abschnitt "Die Schale"): Radius 8, Polsterung 0 12px - das ist
  // RADIUS_CONTROL und SPACE_8, dieselbe kleinere Sprosse, die
  // .zep-sidebar unten fuer ihre eigene Polsterung bekommt.
  //
  // Der Abstand Symbol-zu-Text (.zep-row-texts, margin-left) folgt
  // demselben Fund: das Musterblatt zeichnet ihn mit 10px, aber KEINE
  // Sprosse der Abstandsleiter trifft diese Zahl exakt - GEPRUEFT gegen
  // jeden Eintrag von sizes.TABLE bei Vorgabegroesse (Bericht dieser
  // Aufgabe), kein einziger ergibt "10px". SPACE_8 (12px, Abstand 2) ist
  // die naechstliegende Sprosse, klar naeher als SPACE_4 (6px, Abstand
  // 4) - und dieselbe Sprosse, die diese Regel gerade fuer die eigene
  // Polsterung gewaehlt hat: ein Navigationseintrag traegt jetzt EINE
  // Sprosse (SPACE_8) fuer Polsterung UND Symbolabstand, nicht mehr die
  // groessere SPACE_12 der Karte.
  &.zep-row-nav {
    min-height: {{STYLE_NAV_ROW_HEIGHT}};
    border-radius: {{STYLE_RADIUS_CONTROL}};
    padding: 0 {{STYLE_SPACE_8}};

    .zep-row-texts { margin-left: {{STYLE_SPACE_8}}; }
  }
}

.zep-row-icon { font-size: {{STYLE_ICON_CAPTION}}; color: $subtext; }
.zep-row-texts { margin-left: {{STYLE_SPACE_12}}; }
.zep-row-title { font-size: {{STYLE_FONT_BODY}}; color: $text; }
.zep-row-sub { font-size: {{STYLE_FONT_CAPTION}}; color: $subtext; }

// Die Huelle, die zepRow() (ags-kit.template) um sich selbst legt, wenn
// `aktion` gesetzt ist - NACHGETRAGEN am 19.08.2026 (Bericht Aufgabe
// 15/16, Fund "Kasten in Kasten"). Sie ist ein Gtk.Button (fuer Fokus
// und Tastaturbedienung), traegt aber KEINE der vier zepButton-Rollen -
// derselbe Kunstgriff wie .overlay-close-btn (background: transparent;
// border: none), dazu Polsterung UND Mindestmasse auf 0, damit die
// Huelle dem Kind (.zep-row) keine eigene Groesse aufzwingt. GENAU EINE
// Flaeche malt danach noch etwas: .zep-row selbst, mit seinem eigenen
// Zeigergrund und seinem "ausgewaehlt"-Randstreifen - beide bleiben
// unveraendert und wirken unter der durchsichtigen Huelle genauso wie
// vorher direkt auf dem Fenstergrund.
.zep-row-click {
  background: transparent;
  border: none;
  padding: 0;
  min-width: 0;
  min-height: 0;

  &:hover, &:active, &:focus, &:checked {
    background: transparent;
  }

  // GEDRUECKT UND MIT DER TASTATUR AUSGEWAEHLT - NACHGETRAGEN am
  // 20.08.2026 (Aufgabe 50).
  //
  // WARUM DIE ZUSTAENDE AN DER HUELLE STEHEN UND NICHT AN .zep-row
  //     Weil GTK4 sie nicht nach unten weiterreicht. `:hover` bekommt
  //     .zep-row von SELBST - GtkWindow setzt GTK_STATE_FLAG_PRELIGHT
  //     auf jeden Knoten der Kette, in der der Zeiger steht, und die
  //     Zeile fuellt die Huelle ganz aus. `:active` und `:focus` setzt
  //     GTK dagegen an genau EINEM Widget, dem Knopf, und
  //     gtk_widget_propagate_state gibt nach unten nur INSENSITIVE und
  //     BACKDROP weiter. Eine Regel `.zep-row:active` stuende also da
  //     und wirkte nie - dieselbe Sorte toter Zeile wie die
  //     Tastaturumschaltung, die in ags-dock.template beschrieben ist.
  //
  // WARUM ES SIE UEBERHAUPT BRAUCHT
  //     Die vier Zeilen darueber machen die Huelle in JEDEM Zustand
  //     durchsichtig, damit sie keinen zweiten Kasten malt. Das ist
  //     richtig und war zugleich das Ende jeder sichtbaren Reaktion auf
  //     Druck und auf den Tastaturfokus: eine Zeile, die man mit Tab
  //     erreicht, sah aus wie jede andere. Beim Rechtsklick-Menue des
  //     Fusses (Aufgabe 50) ist das keine Feinheit - der Popup bekommt
  //     den Tastaturfokus (`wl_keyboard.enter` auf seine eigene
  //     Flaeche, gemessen am 20.08.2026), Tab ist dort also der zweite
  //     Bedienweg neben der Maus.
  //
  // DIE ZWEI FARBEN SIND KEINE NEUEN
  //     `rgba($surface, 0.75)` ist der Zeigergrund, den .zep-btn-umrandet
  //     weiter oben schon fuehrt - eine Stufe kraeftiger als
  //     $item-hover, und genau das soll "gedrueckt" gegenueber
  //     "ueberfahren" sein. $accent ist der Ring, den .net-pw-entry und
  //     .vpn-entry-row fuer denselben Zweck an ihren Rand legen.
  //
  // GEMESSEN am 20.08.2026, ueber der hellsten denkbaren Tapete unter
  // der Platte aus {{STYLE_GLASS_SOLO}} (dieselbe Rechnung wie in
  // src/brand.py bei glass_solo_alpha):
  //
  //     $text auf dem Zeigergrund      11.28:1
  //     $text auf dem Druckgrund        9.60:1
  //     $accent gegen die Platte        5.27:1   (WCAG 1.4.11: 3:1)
  //
  // `:focus-visible` und nicht `:focus`: ein Mausklick setzt in GTK4
  // ebenfalls den Fokus, und ein Ring, der bei jedem Klick aufblitzt,
  // ist genau das Rauschen, wegen dem GTK die zweite Pseudoklasse
  // ueberhaupt fuehrt.
  &:active > .zep-row {
    background: rgba($surface, 0.75);
  }

  &:focus-visible > .zep-row {
    background: $item-hover;
    outline: 2px solid $accent;
    outline-offset: -2px;
  }
}

// ── DIE FLAECHE EINES AUFKLAPPMENUES ────────────────────────────────
//
// GEMELDET am 20.08.2026, woertlich: "was an dem fenster rechtsklick bei
// der dock falsch ist ist folgendes: es ist komplett weiss und passt
// nicht zum style".
//
// WAS GEMESSEN WURDE, UND WORAN
//     tests/render/, verschachteltes Hyprland 1920x1080, das
//     Rechtsklick-Menue des Fusses aufgeklappt und abgebildet. Der
//     bemalte Kasten war 262 x 136 Punkte, und darin:
//
//         #FFFFFF   83.84 %   der Grund
//         #DCEEF4    3.17 %   die Schrift - $text
//
//     Also die Schrift dieses Schreibtischs auf GTKs weissem Grund:
//     1.19:1 fuer den Text und 1.80:1 fuer das Zeichen ($subtext).
//     WCAG 2.1 verlangt 4.5:1. Das Menue war nicht nur hell, es war
//     unlesbar.
//
// WARUM DAS STYLESHEET DIESES HAUSES DARAN VORBEIGELAUFEN IST
//     Es lief NICHT vorbei: die Zeilen im Menue trugen ihre Farben
//     bereits ($text, $subtext, der Trenner in $border - alle drei auf
//     dem Bild). Was fehlte, ist der GRUND, und den malt in GTK4 nicht
//     der `popover`-Knoten, sondern sein Kind `contents`. Fuer dieses
//     Kind hatte keine Regel dieses Baums je einen Wahlausdruck; also
//     galt die des Themas, und zwar nicht, weil sie staerker waere,
//     sondern weil ihr niemand widersprochen hat.
//
//     GEMESSEN am 20.08.2026, GTKs eingebautes Thema, wortwoertlich aus
//     `gresource extract /usr/lib/libgtk-4.so.1
//     /org/gtk/libgtk/theme/Default/Default-light.css`:
//
//         popover.background { background-color: transparent;
//                              font: initial; }
//         popover.background > arrow, popover.background > contents {
//             background-color: #ffffff;
//             border: 1px solid rgba(0, 0, 0, 0.23);
//             box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3); }
//         popover.background > contents { padding: 8px;
//                                         border-radius: 9px; }
//
//     Die HELLE Fassung, weil dieser Schreibtisch fuer GTK4 kein Thema
//     setzt (`grep gtk-theme-name src/templates/`: nur die GTK3-Route in
//     gtk-theme-fix-config.template) - ohne Namen nimmt GTK sein
//     eingebautes "Default", und dessen Vorgabe ist hell.
//
// UND `font: initial` IST DIE ZWEITE HAELFTE DESSELBEN BEFUNDS
//     Ein Popover ist eine eigene Wayland-Flaeche (siehe den Kopf von
//     ags-dock.template), und diese eine Zeile des Themas nimmt seinem
//     Inhalt zusaetzlich Familie, Groesse UND Schnitt weg. Das ist
//     dieselbe Luecke, die am 19./20.08.2026 dreimal an den beiden
//     freistehenden Knopffenstern zugeschlagen hat (Bericht Aufgabe 47)
//     - nur dass ein Popover sie nicht bloss nicht erbt, sondern
//     ausdruecklich zurueckgesetzt bekommt. Alle drei stehen deshalb
//     unten, und tests/src/test_placement.py bewacht sie fuer JEDES
//     Popover dieses Systems statt fuer dieses eine.
//
// DIESELBE SPRACHE WIE DIE UEBERLAGERUNGEN, UND KEINE ZWEITE
//     Grund, Rahmen und Ecke sind Zeile fuer Zeile die von
//     `.overlay-outer` weiter unten - die Platte, die alle zwoelf
//     Ueberlagerungsfenster tragen. Ein Aufklappmenue ist eine Flaeche
//     dieses Schreibtischs wie sie, und zwei Plattenrezepte waeren zwei
//     Schreibtische.
//
//     GEMESSEN, ueber der hellsten denkbaren Tapete (dieselbe Rechnung
//     wie bei glass_solo_alpha() in src/brand.py; WCAG 2.1 verlangt
//     4.5:1 fuer Fliesstext):
//
//         $text auf der Platte      8.64:1
//         $subtext auf der Platte   5.73:1
//         $accent auf der Platte    5.27:1
//
//     Dieselben drei Zahlen, die .overlay-outer schon nennt - es IST
//     dieselbe Platte.
//
// DER SCHATTEN FAELLT WEG, UND DAS IST EINE ENTSCHEIDUNG
//     Keine Flaeche dieses Schreibtischs traegt einen box-shadow;
//     getrennt wird mit dem Haarstrich in $border, so wie #dock und
//     .overlay-outer es tun. Ein Schlagschatten NUR am Aufklappmenue
//     waere die eine Flaeche, die anders aussieht.
//
// WARUM `popover` UND NICHT `.dock-menu-popover`
//     Weil es zwei gibt: das Rechtsklick-Menue des Fusses und der
//     Ueberlauf der Ablage (ags-bar.template, `overflow.set_popover`).
//     Und weil jede Gtk.Entry dieses Baums (Netzpasswort, VPN,
//     Stil-Editor) auf Rechtsklick ihr eigenes GTK-Menue aufklappt, das
//     dieselbe weisse Platte bekaeme - dort steht die Schrift des
//     THEMAS darauf, und die waere auf unserem dunklen Grund genauso
//     unlesbar, wie unsere auf seinem hellen war. Deshalb steht
//     `modelbutton` gleich mit hier; der Anmeldebildschirm loest genau
//     dieselbe Aufgabe seit dem 13.08.2026 auf genau diesem Weg
//     (src/greeter.py, _menu()).
popover {
  background: transparent;
}

popover > contents {
  background: {{STYLE_GLASS_SOLO}};
  color: $text;
  border: 1px solid $border;
  border-radius: {{STYLE_RADIUS_PANEL}};
  box-shadow: none;
  padding: {{STYLE_SPACE_4}};
  font-family: {{STYLE_FONT_FAMILY}};
  font-size: {{STYLE_FONT_BODY}};
  // `normal` und nicht {{STYLE_FONT_WEIGHT}} - das ist "bold", der
  // Schnitt der LEISTE. Dieselbe zepRow-Zeile steht in den zwoelf
  // Ueberlagerungen mager, weil .overlay-outer keinen Schnitt nennt und
  // GTKs Vorgabe mager ist; ein Menue, das fetter schreibt als dieselbe
  // Zeile im Kontrollzentrum, waere zweierlei Zeile. Die Zeile pinnt
  // also fest, was `font: initial` des Themas gerade ohnehin liefert -
  // GEMESSEN am 20.08.2026: die Tinte ist mit und ohne sie dieselbe.
  // Ohne sie haengt der Schnitt an einer fremden Datei.
  font-weight: normal;
}

// Der Zeiger eines Popovers, der einen fuehrt. Das Menue des Fusses hat
// keinen (`has_arrow: false`), der Ueberlauf der Ablage schon - und ein
// weisses Dreieck an einer petrolfarbenen Platte waere derselbe Fehler
// noch einmal, nur kleiner.
popover > arrow {
  background: {{STYLE_GLASS_SOLO}};
  border: 1px solid $border;
  box-shadow: none;
}

// Die Zeile eines Menues, das GTK SELBST zeichnet - jedes
// Gtk.PopoverMenu aus einem Gio.MenuModel, also die Kontextmenues der
// Eingabefelder. `background-image: none` aus demselben Grund, den
// src/greeter.py nennt: GTKs Thema legt hier ein Bild an, und eine
// Farbe darunter saehe niemand.
//
// Die eigenen Menues dieses Hauses brauchen davon nichts - sie sind aus
// zepRow gebaut (siehe den Kopfabschnitt "DAS RECHTSKLICK-MENUE" in
// ags-dock.template) und tragen die Zeile, die dieser Schreibtisch
// ueberall traegt.
modelbutton {
  background: transparent;
  background-image: none;
  color: $text;
  border-radius: {{STYLE_RADIUS_CONTROL}};
  padding: 0 {{STYLE_SPACE_8}};
  min-height: {{STYLE_NAV_ROW_HEIGHT}};
  font-size: {{STYLE_FONT_BODY}};

  &:hover { background: $item-hover; }
  &:active { background: rgba($surface, 0.75); }
  &:focus-visible {
    outline: 2px solid $accent;
    outline-offset: -2px;
  }
  &:checked, &:selected { background: rgba($accent, 0.15); }
  &:disabled { color: $subtext; }
}

// Die Gruppenueberschrift der Seitenleiste - VERBINDUNGEN, SYSTEM,
// EINSTELLUNGEN.
//
// ZENTRIERT SEIT DEM 19.08.2026, auf Ansage des Nutzers ("sorge auch
// dafuer das die titel in der sidebar zentriert sind"). Hier stand
// keine Ausrichtung, die Ueberschrift erbte also linksbuendig.
//
// GEMEINT SIND DIE UEBERSCHRIFTEN UND NICHT DIE EINTRAEGE: ein Eintrag
// traegt Symbol links und Beschriftung rechts daneben - das ist am
// selben Tag ausdruecklich so bestellt worden ("das icon im navlink
// sollte links sein und rechts davon der text"). Ihn zu zentrieren
// wuerde derselben Ansage widersprechen.
//
// DIE AUSRICHTUNG STEHT NICHT HIER, und das ist keine Nachlaessigkeit:
// in GTK4 ist sie eine Widget-Eigenschaft und keine CSS-Regel. Sie
// steht bei zepSectionLabel in ags-kit.template als `xalign: 0.5`.
// Wer sie hier sucht, sucht am falschen Ort - eine CSS-Regel dafuer
// wuerde GTK4 klaglos annehmen und ignorieren, also sichtbar nichts
// tun.
.zep-section {
  font-size: {{STYLE_FONT_CAPTION}};
  color: $subtext;
  margin: {{STYLE_SPACE_8}} 0 {{STYLE_SPACE_4}} 0;
}

.zep-divider { background: $border; margin: {{STYLE_SPACE_8}} 0; }

// Die Wartezeile (zepBusy, ags-kit.template). NACHGETRAGEN am
// 20.08.2026, Aufgabe 36.
//
// GEDAEMPFT UND NICHT BETONT, und das ist eine Entscheidung: was hier
// steht, ist eine Zwischenmeldung und kein Ergebnis. Dieselbe Farbe wie
// die Nebenzeile einer Zeile ($subtext, siehe .zep-row-sub oben) - sie
// soll lesbar sein und nicht die Aufmerksamkeit von der Liste
// wegziehen, die gleich darunter erscheint.
//
// Der Abstand zwischen Scheibe und Satz steht HIER und nicht als
// `spacing` im Konstruktor: es ist ein Mass des Aussehens, und der
// Groessenregler soll es mitnehmen (STYLE_SPACE_8, dieselbe Sprosse wie
// der Rand von .zep-section darueber).
.zep-busy {
  margin: {{STYLE_SPACE_8}} 0;
}

.zep-busy-spinner {
  color: $subtext;
  margin-right: {{STYLE_SPACE_8}};
}

.zep-busy-text {
  font-size: {{STYLE_FONT_CAPTION}};
  color: $subtext;
}

// Der Schalter. NACHGETRAGEN am 18.08.2026: die Schnittstellenliste von
// task-3 nannte .zep-toggle, der Codeblock des vorigen Auftrags
// (task-1u4) enthielt sie nicht - GEPRUEFT per `grep -rn switch
// src/templates/*.template` am selben Tag: kein Treffer ausser
// JS-Funktionsnamen (switchTab, switchMonitor), also keine bestehende
// switch-Regel, an der sich diese haette orientieren koennen. Gtk.Switch
// bringt seine eigene Groesse und Tastaturbedienung mit - hier nur
// Farbe, Rundung (die Pille, wie fuer jeden Schalter gedacht: siehe
// STYLE_RADIUS_PILL in sizes.py) und dieselbe Bewegung wie .zep-btn.
.zep-toggle {
  border-radius: {{STYLE_RADIUS_PILL}};
  background: rgba($surface, 0.55);
  border: 1px solid $border;
  transition: background-color {{STYLE_MOTION_INSTANT}} {{STYLE_MOTION_CURVE}};

  &:checked {
    background: $accent;
    border-color: $accent;
  }

  slider {
    border-radius: {{STYLE_RADIUS_PILL}};
    background: $text;
  }
}

// NACHGETRAGEN am 18.08.2026, task-4 (die Schale, Stufe 3): Seitenleiste
// und Zustandskopf, aus zepSidebar/zepStateHeader in ags-kit.template.
// Drei Regeln aus dem Aufgabenblatt. Eine vierte (.zep-shell-page) kam
// am 19.08.2026 dazu und ist am 20.08.2026 wieder gefallen - der Boden
// der Schalenseiten wird seither gemessen statt geschrieben, siehe den
// Block weiter unten.

// 208px steht in der Spezifikation, Abschnitt 2.2, GEMESSEN (nicht
// gerechnet) - der einzige Ort, an dem die Zahl stehen darf
// (tests/src/test_schale.py::test_die_seitenleiste_ist_208_breit).
// min-width statt width: derselbe Weg wie jede andere feste Spalte in
// dieser Datei (GEPRUEFT `grep -c "  width:" ags-style.template` = 0,
// nur min-width kommt vor). border-right statt border-left, weil die
// Leiste links vom Inhalt steht - die erste ihrer Art in dieser Datei
// (GEPRUEFT `grep -c border-right` = 0 vor dieser Zeile), kein
// Widerspruch zum Bestand, nur die erste Gelegenheit dafuer.
// POLSTERUNG NACHGETRAGEN am 19.08.2026 (Aufgabe 27, Musterblatt "Die
// Schale"): bis hierher trug diese Regel NUR min-width und
// border-right - die Eintraege klebten damit an der Fensterkante und an
// der Trennlinie. GEMELDET vom Nutzer: "die sidebar hat kein außen
// padding da fehlt so viel". Das Musterblatt zeichnet die Seitenleiste
// mit `padding: 12px`, und das trifft SPACE_8 (12px bei Vorgabegroesse)
// exakt - nicht SPACE_12 (18px, trotz des Namens: eine Sprosse heisst
// nach ihrem UNSKALIERTEN Rohwert, SPACE_12 skaliert auf 18px, waehrend
// SPACE_8 auf die gesuchten 12px skaliert). Dieselbe Sprosse, mit der
// .zep-row-nav unten jetzt seine eigene Polsterung und seinen
// Symbolabstand bekommt - ein Regler fuer die ganze kompakte
// Seitenleiste.
//
// WIRKUNG AUF DEN AKTIVEN EINTRAG, GEPRUEFT VOR DER AENDERUNG: der
// ausgewaehlte Zustand (.zep-row.active oben) malt seinen Grund/Streifen
// auf der Flaeche von .zep-row selbst, die jetzt INNERHALB dieser
// Polsterung liegt statt bis an die Fensterkante zu reichen - GENAU das
// Bild des Musterblatts ("keinen eigenen Kasten"), aber
// tests/render/test_schale_stil.py::test_die_seitenleiste_bemalt_208_punkte
// hat diese Flaeche bisher als Stellvertreter fuer die Sidebar-BREITE
// gemessen (sie reichte vorher randgleich bis 208). Mit der Polsterung
// endet sie fruehzeitiger - der Test ist entsprechend angepasst, siehe
// dort.
//
// 184 STATT 208 ALS MIN-WIDTH, UND DAS IST KEINE ZWEITE ZAHL - GEFUNDEN
// BEIM ERSTEN RENDER-LAUF DIESER AUFGABE, NICHT VORHER GESEHEN: ein
// blosses `min-width: 208px` NEBEN dem neuen `padding` haette die Regel
// in genau die Falle laufen lassen, die diese Datei bei
// `.zep-shell-page` (weiter oben, Aufgabe 23) schon einmal ausgeschrieben
// hat: "GTK rechnet Polster IMMER oben auf eine gesetzte min-width
// drauf" - GEMESSEN (dieser Lauf, vor der Korrektur hier): die Schale
// meldete testKeineSeiteScrollt/notify::upper 51px statt der vorher
// bekannten ~27px Ueberlauf, ein Sprung von genau 24 = zweimal SPACE_8.
// Die Seitenleiste waere damit 232px statt 208 breit geworden - genau
// die 208 plus die neue Polsterung obendrauf, nicht ANSTATT eines
// Teils davon.
//
// Die Rechnung zieht die Polsterung darum VON der geschuetzten 208
// wieder ab: 208px - (2 * SPACE_8) = 184px, per Sass-Arithmetik und
// nicht als zweite Handzahl, damit die Summe bei JEDEM sizes.scale
// wieder 208 ergibt, nicht nur beim ausgelieferten Faktor (GEPRUEFT,
// `sass` direkt: `208px - (2 * 12px)` -> `184px`). 208 bleibt die
// einzige Zahl, die die Spezifikation nennt (siehe der Kommentar
// oben) - hier steht sie unveraendert, nur einmal umgestellt.
.zep-sidebar {
  min-width: 208px - (2 * {{STYLE_SPACE_8}});
  border-right: 1px solid $border;
  padding: {{STYLE_SPACE_8}};
}

// Abstand zwischen zwei Gruppen (VERBINDUNGEN/SYSTEM/EINSTELLUNGEN).
// zepSectionLabel traegt bereits einen eigenen oberen Rand
// ({{STYLE_SPACE_8}}, siehe .zep-section oben) - dieser hier ist der
// Abstand zur VORIGEN Gruppe, nicht zur eigenen Marke, darum eine
// zusaetzliche, groessere Sprosse.
.zep-sidebar-group {
  margin-top: {{STYLE_SPACE_16}};
}

// Der Kopf einer Seite - Polsterung wie .overlay-header (SPACE_12/16,
// siehe dort), Schrift 19 (STYLE_FONT_TITLE, siehe FONT_ROLES in
// sizes.py) fuer den Titel. Der Titel traegt dafuer KEINE eigene
// Klasse: font-size/-weight/color stehen hier auf .zep-state-head
// selbst und vererben sich auf sein einziges unmarkiertes Label -
// GENAU wie .disk-stat-value/.disk-ring-percent (bold, $text, TITLE)
// es fuer ihre eigene grosse Zahl schon tun, nur hier auf dem
// Container statt auf dem Label direkt, weil "nur diese drei Regeln"
// keine vierte Klasse fuer den Titel allein erlaubt. Die Nebenzeile
// bricht das bewusst wieder herunter, indem sie ihre EIGENE Klasse
// traegt (.zep-row-sub, wiederverwendet aus zepRow) - eine direkt am
// Element stehende Regel schlaegt eine geerbte.
.zep-state-head {
  padding: {{STYLE_SPACE_12}} {{STYLE_SPACE_16}};
  font-size: {{STYLE_FONT_TITLE}};
  font-weight: bold;
  color: $text;

  // `ende` ist laut Schnittstelle frei - auch ein zepButton. Dessen
  // .zep-btn setzt font-size und (ueber seine vier Rollen) color schon
  // selbst, aber NICHT font-weight ausser bei der Rolle "voll". Ohne
  // diese Zeile wuerde die fette Titelschrift auf einen umrandeten/
  // stillen/kritischen Knopf als `ende` durchschlagen - GEPRUEFT gegen
  // .zep-btn-voll/-umrandet/-still/-kritisch weiter oben in dieser
  // Datei. Kein neuer Klassenname, nur eine bestehende Klasse
  // (.zep-btn) in einem neuen Kontext, derselbe Kunstgriff wie
  // ".vpn-tab-bar .zep-btn.active" weiter unten.
  .zep-btn { font-weight: normal; }
}

// DIE FLAECHE - DER INHALTSBEREICH NEBEN DER SEITENLEISTE
//
// NACHGETRAGEN am 20.08.2026 (Aufgabe 49). GEMELDET vom Nutzer, zum
// ZWEITEN Mal: "die abstände in dem inner content neben der sidebar, das
// custom ags fenster was wir gemacht haben, sind auch nicht richtig",
// und frueher schon "der außen abstand, das hast du immernoch nicht
// verändert in dem sidebar mit inner content ags fenster".
//
// AM 19.08.2026 (cadb681, Aufgabe 27) BEKAM NUR DIE SEITENLEISTE IHRE
// POLSTERUNG. Der Inhaltsbereich daneben blieb unberuehrt - und auf zwei
// von vier Seiten der Schale trug er UEBERHAUPT KEINE. GEMESSEN am
// 20.08.2026 am Bild (tests/render/, schale-*.png, 1920x1080,
// Vorgabegroesse, Fenster 880x430 bei (520,186)):
//
//     Seite        links vom Trenner    rechts (ohne Rinne)
//     bluetooth                    0                      0
//     network                      0                      0
//     general                     18                     18
//     vpn                         25                     25
//
// Drei verschiedene Antworten auf dieselbe Frage, und zwei davon sind
// "gar keine": auf Bluetooth und Netzwerk stossen Geraetezeile,
// Zahnradknopf und Liste ohne einen Punkt Luft an die Trennlinie der
// Seitenleiste und an die rechte Fensterkante.
//
// DAS MUSTERBLATT ("Die Schale", 19.08.2026, vom Nutzer bestaetigt mit
// "genau so soll das aussehen") zeichnet den Inhalt als ZWEI Bloecke
// untereinander, nicht als einen:
//
//     .zustandskopf { padding: 18px 25px; border-bottom: 1px ... }
//     .flaeche      { padding: 18px 25px; gap: 12px }
//
// Der Kopf traegt seine Polsterung selbst (.zep-state-head oben, 18/25 -
// GEMESSEN am Bild: der Titel steht auf Bluetooth und Netzwerk heute
// schon exakt 25 Punkte rechts der Trennlinie, der Kopf ist also
// RICHTIG), und die TRENNLINIE zwischen beiden Bloecken laeuft im
// Musterblatt von Kante zu Kante durch. Genau deshalb sitzt die
// Polsterung hier auf einer eigenen Flaeche UNTER dem Trenner und nicht
// auf der ganzen Seite: eine Polsterung auf dem Seitenbehaelter wuerde
// den Kopf ein zweites Mal einruecken (25 + 25 = 50) UND den Trenner um
// 25 Punkte von beiden Kanten wegziehen. Beides steht so nicht im Blatt.
//
// 18/25 SIND SPACE_12 UND SPACE_16, NICHT ZWEI GETIPPTE ZAHLEN: die
// Abstandsleiter des Musterblatts (3 · 6 · 12 · 18 · 25) ist Sprosse
// fuer Sprosse die aus src/sizes.py (GEPRUEFT ueber sizes.value_of():
// SPACE_2=3, SPACE_4=6, SPACE_8=12, SPACE_12=18, SPACE_16=25 bei
// scale=20/13). Dieselben beiden Sprossen, die .zep-state-head darueber
// und .overlay-header ganz oben schon tragen - der Inhalt steht damit in
// derselben Spalte wie der Kopf ueber ihm.
//
// KEINE min-width AN DIESER REGEL, UND DAS IST ABSICHT: "GTK rechnet
// Polster IMMER oben auf eine gesetzte min-width drauf" (siehe
// .zep-sidebar oben und der geloeschte .zep-shell-page-Block unten - die
// Falle, in die dieses Fenster dreimal gelaufen ist). Der Boden der
// Schale wird seit dem 20.08.2026 in createOverlayWindow() GEMESSEN und
// auf den RUMPF gesetzt, nicht auf eine Seite; eine Polsterung hier kann
// sich deshalb auf nichts mehr draufrechnen. GEMESSEN nach dieser
// Aenderung: der waagerechte Ueberhang bleibt 0 (tests/render/
// test_schale_stil.py::test_keine_seite_der_schale_scrollt_waagerecht).
.zep-shell-flaeche {
  padding: {{STYLE_SPACE_12}} {{STYLE_SPACE_16}};
}

// DER BODEN DER SCHALENSEITEN STEHT SEIT DEM 20.08.2026 NICHT MEHR HIER
//
// Hier stand `.zep-shell-page { min-width: 672px }` - der Boden, der den
// Verbindungsseiten am 19.08.2026 fehlte ("es fehlt irgendwie mehr
// breite oder so", GEMESSEN damals: Netzwerk 775, Bluetooth 794, VPN 829
// statt 880). Der Boden war richtig, seine ZAHL war es nicht.
//
// 672 = 880 (Sprosse L) minus 208 (Seitenleiste) rechnet mit der
// Sprosse, als waere sie der Platz fuer den Inhalt. Sie ist die Breite
// des FENSTERS; was das Fenster um den Inhalt herum baut, geht davon ab.
//
// GEMESSEN am 20.08.2026 im verschachtelten Compositor, 1920x1080, an
// der stehenden Schale, Breitenbaum je Widget:
//
//     Rumpf (Seitenleiste + Seitenstapel) verlangt   881
//     Sichtfenster gibt ihm                          854
//                                                    ---
//     Ueberhang                                       27
//
//     davon senkrechte Bildlaufleiste                  24
//           .overlay-outer, Rahmen 1px, zweimal         2
//           .zep-sidebar, border-right 1px              1
//
// Der Rand der Seitenleiste ist der Posten, den auch die Rechnung
// "208 + 672 = 880" nie kannte: die Spalte misst sich 209 breit
// (GEMESSEN, alle vier Seiten), weil `border-right` neben `min-width`
// steht - dieselbe Sache, die 19.08.2026 fuer die POLSTERUNG schon
// einmal herausgerechnet werden musste (siehe .zep-sidebar oben).
//
// KEINE KORRIGIERTE ZAHL AN DERSELBEN STELLE, UND DAS IST DER PUNKT
//     645 statt 672 waere richtig - heute, auf diesem Schirm, mit diesem
//     GTK-Thema. Die Rinne der Bildlaufleiste kommt aus dem Thema und
//     folgt dem Groessenregler, der Rahmen aus dem Stylesheet, der Rand
//     der Seitenleiste ebenfalls. Ein Stylesheet kann keinen davon
//     messen; es kann sie nur abschreiben und beim naechsten Mal falsch
//     liegen. Genau das ist hier zweimal passiert.
//
//     Der Boden liegt seither in createOverlayWindow() (show(),
//     `config.fuelltDieSprosse` - ags-overlay-utils.template). Dort
//     werden Rahmen und Rinne bei JEDEM Aufgehen GEMESSEN und von der
//     Sprosse abgezogen, und der Rest ist der Boden fuer den ganzen
//     Rumpf. Eine Zeile, zwei Schalen, keine getippte Zahl.
//
//     `.zep-shell-page` ist damit ohne Regel und ohne Leser und darum
//     geloescht, nicht auskommentiert - samt der polsterlosen Huellen,
//     die es nur gab, damit die Polsterung einer Seite sich nicht auf
//     die 672 draufrechnet (mitSeitenboden() in ags-control-center.
//     template und die Entsprechungen in ags-vpn/ags-settings). Ohne
//     eine Zahl im Stylesheet gibt es nichts mehr, worauf sich etwas
//     draufrechnen koennte.

// EINE LANGE VORGESCHICHTE, IN ZWEI SAETZEN, WEIL SIE ERKLAERT, WARUM
// EIN BODEN IM STYLESHEET HIER DREIMAL SCHIEFGING
//
//     Vom 19.08.2026 (Aufgabe 17) bis zum 20.08.2026 wanderte derselbe
//     Boden dreimal: erst auf `.cc-container`/`.vpn-container` selbst
//     (dort rechnete GTK deren eigenes Polster oben drauf - GEMESSEN
//     Aufgabe 23: general 708 statt 672, VPN 722 statt 672), dann als
//     Verbundregel `.cc-container.zep-shell-page` (loeste nur, welche
//     der beiden min-width gewinnt, nicht die Polsterung), dann auf
//     eine eigene polsterlose Huelle (loeste die Polsterung, nicht die
//     Rinne der Bildlaufleiste).
//
//     Jede dieser drei Stationen hat einen Posten uebersehen, den ein
//     Stylesheet nicht sehen KANN. Seit dem 20.08.2026 wird der Boden
//     gemessen statt geschrieben; siehe den Block darueber.
//
//     `.cc-container` und `.vpn-container` behalten ihre EIGENEN,
//     einfachen `min-width`-Regeln weiter unten (320px/400px) -
//     Notifications braucht die eine weiterhin, die andere hat keinen
//     Leser mehr (siehe der Kommentar dort).

// ===== SHARED OVERLAY STYLES (Muted Dark / HyprLaunch / HyprClipX) =====
//
// DIE PLATTE ALLER ELF UEBERLAGERUNGEN
//
// createOverlayWindow() in ags-overlay-utils.template haengt diese
// Klasse in jedes Fenster, das sie baut - der Kalender, die
// Tastenkuerzel, der Akku, die Platten, das Kontrollzentrum, die
// Tapeten, der Stil-Editor, das Netzwerk und die beiden VPN-Fenster.
// Elf Namensraeume, eine Regel.
//
// SIE WAR BIS ZUM 12.08.2026 DECKEND, UND DAS WAR TEUER
//     Alle elf stehen in GLASS_LAYERS und bekommen vom Compositor eine
//     `layerrule = blur`. `background: $bg` war ein sechsstelliges Hex
//     ohne Alphakanal: die Unschaerfe wurde elfmal gerechnet und
//     keinmal gesehen.
//
// WARUM DIE DICKERE DER DREI DECKKRAEFTE
//     Auf DIESER Platte steht Text - anders als auf der Leiste, deren
//     Text auf den Kacheln darauf sitzt. Eine einschichtige Platte muss
//     deshalb so viel Material tragen wie der zweischichtige Aufbau der
//     Leiste; die Rechnung steht in src/brand.py bei
//     glass_solo_alpha(). Gemessen ueber der schlechtesten denkbaren
//     Tapete: Nebentext 5.42:1, Akzenttext 5.19:1, Fliesstext 8.64:1.
.overlay-outer {
  background: {{STYLE_GLASS_SOLO}};
  border: 1px solid $border;
  border-radius: {{STYLE_RADIUS_PANEL}};
  font-family: {{STYLE_FONT_FAMILY}};
}

// DER KOPF TRAEGT DIE OBEREN ECKEN DER PLATTE MIT, SEIT DEM 17.08.2026
//
//     GEMELDET, woertlich: "diese fenster sind eckig und nicht im zepos
//     border radius".
//
//     GEMESSEN am selben Tag im verschachtelten Compositor, Schirm
//     1920x1200, die 40x40 Bildpunkte jeder Fensterecke mit 900 %
//     vergroessert (tests/render/, `magick ... -crop 40x40+0+0 -resize
//     900%`): die UNTEREN Ecken sind rund, die OBEREN quadratisch - und
//     zwar bei ALLEN Ueberlagerungen, nicht nur bei den beiden neuen.
//     Das Kontrollzentrum ebenso.
//
//     Der Grund ist derselbe wie bei `bar.set_overflow(HIDDEN)` in
//     ags-bar.template, nur ohne dessen Ausweg: ein Widget beschneidet
//     seine Kinder in GTK4 NICHT von selbst. `.overlay-outer` ist rund,
//     dieser Kopf ist ein Rechteck mit eigenem, deckendem Grund, und er
//     sitzt in genau der Ecke, die die Platte rund laesst. `overflow`
//     gibt es in GTKs CSS-Teilmenge nicht, und ein
//     `set_overflow(HIDDEN)` an der Platte waere hier falsch: es
//     beschnitte auch die Bildlaufleiste und den Inhalt, der beim
//     Blaettern gerade oben aus dem Sichtfenster laeuft.
//
//     Die Antwort ist deshalb, dass der Kopf DIESELBE Rundung traegt wie
//     die Platte - oben, wo er ihre Ecke ausfuellt, und nicht unten, wo
//     er an den Inhalt stoesst. Eine Zahl aus derselben Quelle, also
//     folgt sie dem Groessenregler mit.
.overlay-header {
  padding: {{STYLE_SPACE_12}} {{STYLE_SPACE_16}};
  background: $surface;
  border-bottom: 1px solid $border;
  border-radius: {{STYLE_RADIUS_PANEL}} {{STYLE_RADIUS_PANEL}} 0 0;

  .overlay-header-icon { color: $accent; }
}

// UND DIE BILDLAUFLEISTE TRAEGT DIE UNTERE RECHTE MIT
//
//     GEMESSEN am 17.08.2026 an derselben Ecke: unten LINKS rundet die
//     Platte, unten RECHTS nicht. Dort liegt die senkrechte
//     Bildlaufleiste der Fabrik - sie liegt NEBEN dem Inhalt
//     (overlay_scrolling: false, siehe ags-overlay-utils.template),
//     reicht bis an die Unterkante und malt ihren Trog als Rechteck
//     darueber.
//
//     Der Trog wird deshalb durchsichtig. Was er zeigte, war ohnehin
//     nur ein Streifen; dass es etwas zu blaettern gibt, sagt der
//     Schieber darauf - und der ist rund und sitzt mit Abstand zum Rand,
//     also kann er keine Ecke ausfuellen. Der PLATZ bleibt reserviert:
//     die Leiste liegt weiter neben dem Inhalt, und die Fabrik rechnet
//     ihre Breite weiter ein.
.overlay-outer scrollbar {
  background: transparent;
  border: none;
}

.overlay-header-icon {
  font-size: {{STYLE_ICON_CAPTION}};
  color: $accent;
}

.overlay-header-title {
  font-size: {{STYLE_FONT_BODY}};
  font-weight: 600;
  color: $text;
  font-family: {{STYLE_FONT_FAMILY}};
}

.overlay-close-btn {
  background: transparent;
  border: none;
  padding: {{STYLE_SPACE_4}} {{STYLE_SPACE_8}};
  min-width: 28px;
  min-height: 28px;
  color: $subtext;

  &:hover {
    color: $red;
    background: rgba($red, 0.15);
  }
}

// ===== CALENDAR =====
.Calendar {
