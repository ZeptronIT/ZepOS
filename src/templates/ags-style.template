// ===== BLUETOOTH MANAGER =====
//
// Es steht neben dem Netzfenster, weil es dasselbe tut: einen Funk
// einschalten und aus einer Liste ein Gegenueber waehlen. Es liest
// deshalb auch DIESELBE Akzentfarbe - $network-accent heisst in
// src/brand.py "Netzwerk", und Bluetooth ist eines. Ein eigener Regler
// dafuer waere ein siebzigster Eintrag im Style Editor fuer eine
// Unterscheidung, die niemand treffen will.
// OHNE min-width, im Unterschied zum Netzfenster daneben: die Breite
// entscheidet die Fabrik (Wunsch, MODAL_SHARE, gemessene natuerliche
// Breite), und eine vierte Zahl daneben waere eine, die keine der drei
// kennt. GEMESSEN am 17.08.2026 auf 1920x7200: 465 Punkte, also ohnehin
// mehr.
.BluetoothManager {
  background: transparent;
}

.bt-current {
  background: rgba($surface, 0.3);
  border-left: 3px solid $network-accent;
  padding: {{STYLE_SPACE_16}} {{STYLE_SPACE_16}};
  margin: {{STYLE_SPACE_12}} {{STYLE_SPACE_12}};
}

.bt-status-icon {
  font-size: {{STYLE_ICON_DISPLAY}};
  color: $network-accent;
  margin-right: {{STYLE_SPACE_4}};

  // Adapter da, aber aus. DIESELBE Abblendung wie beim Leistenmodul
  // (#bluetooth.bluetooth-off in src/styles/bar-style.template): ein
  // ausgeschaltetes Geraet ist ein Zustand und keine Abwesenheit.
  &.bt-off { color: $subtext; }
  // Und nichts antwortet. Das ist etwas Drittes, und es ist ein Fehler.
  &.bt-broken { color: $red; }
}

.bt-status-label {
  font-size: {{STYLE_FONT_LEAD}};
  font-weight: bold;
  color: $text;
}

.bt-status-detail {
  font-size: {{STYLE_FONT_CAPTION}};
  color: $subtext;
}

// Die Groesse kommt aus Schrift und Innenabstand, also aus der Leiter in
// src/sizes.py, und nicht aus einem min-width daneben. Die drei
// Zahlenpaare, die an den Knoepfen des Netzfensters stehen, sind der
// Grund fuer den Zaehler in tests/src/test_spacing.py - er darf nicht
// wachsen, und hier braucht ihn niemand.
.bt-power-btn, .bt-tool-btn {
  background: rgba($surface, 0.4);
  border: 1px solid transparent;
  border-radius: {{STYLE_RADIUS_CONTROL}};
  padding: {{STYLE_SPACE_8}} {{STYLE_SPACE_12}};
  font-size: {{STYLE_FONT_BODY}};
  color: $network-accent;

  &:hover {
    background: rgba($network-accent, 0.15);
    border-color: rgba($network-accent, 0.3);
  }

  &.active {
    background: rgba($network-accent, 0.3);
    border-color: $network-accent;
  }

  &.inactive {
    opacity: 0.5;
  }

  // Ein Knopf, der gerade nichts tun KANN, sieht danach aus. Ohne diese
  // Zeile waere `set_sensitive(false)` eine Wirkung ohne Anzeige - und
  // ein Knopf, der auf einen Klick nicht reagiert und dabei aussieht wie
  // immer, ist von einem kaputten nicht zu unterscheiden.
  &:disabled {
    opacity: {{STYLE_OPACITY_DISABLED}};
  }
}

.bt-divider {
  background: rgba($surface, 0.5);
  min-height: 1px;
  margin: {{STYLE_SPACE_4}} {{STYLE_SPACE_12}};
}

.bt-section-title {
  font-size: {{STYLE_FONT_CAPTION}};
  font-weight: bold;
  color: $subtext;
  letter-spacing: 1px;
  margin: 0 {{STYLE_SPACE_12}};
}

.bt-list {
  padding: {{STYLE_SPACE_4}} {{STYLE_SPACE_12}};
}

.bt-item {
  background: rgba($surface, 0.2);
  border: none;
  border-left: 3px solid transparent;
  border-radius: {{STYLE_RADIUS_CARD}};
  padding: {{STYLE_SPACE_12}} {{STYLE_SPACE_12}};
  margin-bottom: {{STYLE_SPACE_2}};

  &.active {
    background: rgba($network-accent, 0.15);
    border-left-color: $network-accent;
  }

  &:hover {
    background: rgba($surface, 0.45);
    border-left-color: rgba($network-accent, 0.5);
  }

  &:disabled {
    opacity: {{STYLE_OPACITY_DISABLED}};
  }
}

.bt-device-icon {
  font-size: {{STYLE_ICON_LEAD}};
  color: $subtext;

  &.bt-device-connected { color: $network-accent; }
}

.bt-device-name {
