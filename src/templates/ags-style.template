$surface: {{STYLE_COLOR_OVERLAY_SURFACE}};
$text: {{STYLE_COLOR_OVERLAY_TEXT}};
$subtext: {{STYLE_COLOR_OVERLAY_SUBTEXT}};
$accent: {{STYLE_COLOR_OVERLAY_ACCENT}};
$accent-hover: {{STYLE_COLOR_OVERLAY_ACCENT_HOVER}};
$accent-dim: {{STYLE_COLOR_OVERLAY_ACCENT_DIM}};
$item-hover: {{STYLE_COLOR_OVERLAY_ITEM_HOVER}};
$border: {{STYLE_OVERLAY_BORDER_COLOR}};
$yellow: {{STYLE_COLOR_WARNING}};
$red: {{STYLE_COLOR_CRITICAL}};
$green: {{STYLE_COLOR_OVERLAY_GREEN}};
$launcher-accent: {{STYLE_COLOR_LAUNCHER_ACCENT}};
$calendar-accent: {{STYLE_COLOR_CALENDAR_ACCENT}};
$shortcuts-accent: {{STYLE_COLOR_SHORTCUTS_ACCENT}};
$battery-accent: {{STYLE_COLOR_BATTERY_ACCENT}};
$disk-accent: {{STYLE_COLOR_DISK_ACCENT}};
$control-accent: {{STYLE_COLOR_CONTROL_ACCENT}};
$network-accent: {{STYLE_COLOR_NETWORK_ACCENT}};
