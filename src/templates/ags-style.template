// "vpn-settings-header"' src/templates/ags-vpn-settings.template` auf 0
// fuer alle drei). Derselbe Fall wie battery-header/disk-header (siehe
// dort): ags-vpn-settings.template bekommt seinen Kopf seit
// createOverlayWindow() von der Fabrik.
.vpn-tab-bar {
  padding: {{STYLE_SPACE_8}} 0;
  background: rgba($surface, 0.3);
  margin: {{STYLE_SPACE_12}} 0;

  // Der gewaehlte Reiter, in der Akzentfarbe dieses Fensters (Task E,
  // 18.08.2026): zepButton kennt selbst keinen "aktiv"-Zustand, nur
  // Rollen - dieselbe Sprache wie .battery-profile-buttons .zep-btn.active
  // (Task A) und .wp-monitor-selector .zep-btn.active (Task B). Dieselben
  // Werte, die vorher auf vpn-tab-btn.active standen.
  .zep-btn.active {
    background: rgba($vpn-accent, 0.2);
    border-color: $vpn-accent;
    color: $vpn-accent;
  }
}

// ENTFERNT am 18.08.2026 (Task E, Umbau auf zepButton): vpn-tab-btn
// (Rolle umrandet, plus die vom Kit weiterhin getragene Klasse "active").
// ANDERS als bei se-tab-btn (Task B): die waagerechte Innenabstand war
// nicht nur rechnerisch, sondern woertlich derselbe Platzhalter
// (STYLE_SPACE_16 auf beiden Seiten in vpn-tab-btn UND in zep-btn), und
// WIN_WIDTH von ags-vpn-settings.template haengt (siehe Dateikopf) an den
// vier Fussknoepfen, nicht an dieser Leiste - die Kopplung, die se-tab-btn
// stehen liess, gilt hier nicht. Eine der vierzehn Klassen aus dem
// Auftrag, siehe gruppe-E-report.md.

.vpn-tab-content {
  padding: {{STYLE_SPACE_12}} 0;
  min-height: 400px;
}

.vpn-section-title {
  font-size: {{STYLE_FONT_BODY}};
  font-weight: bold;
  color: $vpn-accent;
  padding: {{STYLE_SPACE_12}} 0 {{STYLE_SPACE_8}} 0;
  border-bottom: 1px solid rgba($surface, 0.3);
}

.vpn-toggle-group {
  padding: {{STYLE_SPACE_8}} 0;

  // Dieselbe Sprache wie .vpn-tab-bar .zep-btn.active oben, mit den
  // Werten, die vorher auf vpn-toggle-btn.active standen (die
