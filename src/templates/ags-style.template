// ===== WALLPAPER SELECTOR =====
.WallpaperSelector {
  background: transparent;
}

// Die 540 sind die Breite EINER REIHE BILDCHEN und keine gegriffene
// Zahl - 17.08.2026.
//
//     Hier standen 500. Das Fenster darum stand damit 576 breit da, und
//     GEMESSEN blieben davon 550 fuer den Inhalt - der aber, sobald die
//     Bildchen da waren, 588 mass. 38 Punkte lagen hinter der rechten
//     Kante, und unter der letzten Reihe stand eine waagerechte
//     Bildlaufleiste.
//
//     GEMESSEN im verschachtelten Compositor, Schirm 1920x1080, mit
//     einem wallpaper-manager, der Bilder meldet:
//
//         .wp-thumb { min-width: 114px }                    114
//         dessen padding {{STYLE_SPACE_2}}, zweimal           +6
//         dessen Rahmen 2px, zweimal                          +4
//                                                           ----
//         ein Bildchen                                       124
//         viermal - THUMB_COLS in ags-wallpaper.template      496
//         spacing 6, dreimal                                 +18
//         .wp-grid padding {{STYLE_SPACE_8}}, zweimal        +24
//                                                           ----
//         eine Reihe                                         538
//
//     WARUM DIESE ZAHL HIER STEHEN MUSS UND NICHT IM WIDGET
//         Die Fabrik misst den Inhalt EINMAL, vor dem Sichtbarwerden
//         (siehe set_default_size in ags-overlay-utils.template). Die
//         Bildchen kommen aber erst in onShow, also DANACH - gemessen
//         am selben Tag: beim Messen ist der Kasten 550 breit, zwei
//         Sekunden spaeter 588. Eine groessere Zahl im Widget aendert
//         daran nichts; sie ist ein DECKEL, und gedeckelt wird eine
//         Breite, die schon gemessen ist. Nur eine min-width steht
//         schon beim Messen da.
.wp-container {
  background: transparent;
  border: none;
  border-radius: {{STYLE_RADIUS_PANEL}};
  padding: {{STYLE_SPACE_16}};
  min-width: 540px;
}

// ENTFERNT am 18.08.2026: wp-header samt der darin verschachtelten
// wp-header-icon/wp-header-title - repo-weit ohne Leser (GEPRUEFT:
// `grep -c '"wp-header' src/templates/ags-wallpaper.template` auf 0).
// Derselbe Fall wie battery-header/disk-header (siehe dort):
// ags-wallpaper.template bekommt seinen Kopf seit createOverlayWindow()
