  padding: {{STYLE_SPACE_4}} {{STYLE_SPACE_12}};
}

// Was dasteht, wenn die Liste leer ist - und WARUM sie leer ist.
.bt-empty {
  font-size: {{STYLE_FONT_CAPTION}};
  color: $subtext;
  padding: {{STYLE_SPACE_4}} {{STYLE_SPACE_12}} {{STYLE_SPACE_12}};
