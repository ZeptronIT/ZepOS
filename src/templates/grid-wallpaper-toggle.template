#!/bin/bash
# Grid Wallpaper Toggle für bessere Floating Window Positionierung
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/grid-wallpaper-toggle.template
#
# Welches Bild ein Schirm bekommt, ergibt sich aus dem Schirm selbst:
# aus seiner Größe, seiner Drehung und seiner Position.
#
# Vorher entschied das der Herstellername aus dem EDID: zwei bestimmte
# Fabrikate bekamen "das linke" und "das rechte" Raster, ein fest
# benannter Notebook-Anschluss ein schwarzes Bild, und hochkant stehende
# Schirme wurden über zwei feste x-Schwellen in links, mitte und rechts
# einsortiert. Das beschreibt genau einen Schreibtisch. Auf jedem anderen
# bekam jeder Schirm ein schwarzes Bild, und die Raster für Hochformat
# wurden aus Variablen berechnet, die es seit dem Löschen der
# firmengebundenen Konfiguration gar nicht mehr gibt.
#
# Die Schirme kommen aus monitors.py - derselben Quelle, aus der Bar und
# Compositor ihre Workspace-Aufteilung beziehen.

# Beim Generieren eingesetzt: ein Skript in ~/.local/bin kann nicht
# wissen, aus welchem Paket es stammt.
ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"

# Bestimme aktuelles Profil aus der aktiven Profil-Status-Datei
# (dieselbe Quelle, die hyprland-status verwendet - kein Hostname-Sniffing)
PROFILE=$(cat ~/.config/hypr/current-profile 2>/dev/null || echo "unknown")

# Source style configuration based on profile
if [[ -f ~/.config/hypr/grid-wallpaper-toggle-${PROFILE}-config.sh ]]; then
    # Profile-specific config exists
    source ~/.config/hypr/grid-wallpaper-toggle-${PROFILE}-config.sh
else
    # Default config
    source ~/.config/hypr/grid-wallpaper-toggle-config.sh
fi

# Profile-spezifische Pfade
GRID_IMAGE="$HOME/.config/hypr/grid-wallpaper-${PROFILE}.png"
TMP_DIR="${TMPDIR:-/tmp}"
TOGGLE_FILE="$TMP_DIR/grid-wallpaper-active-${PROFILE}"
RANDOM_WALLPAPER_SCRIPT="$HOME/.config/hypr/random-wallpaper.sh"
FOOTPRINT_FILE="$TMP_DIR/grid-footprints-${PROFILE}.json" # Profile-spezifische Footprint-Daten

# Die angeschlossenen Schirme, von links nach rechts, eine Zeile je Schirm:
#
#   Anschluss  x  transform  Breite  Höhe  panel|external
#
# Breite und Höhe sind die Maße, wie sie auf dem Glas erscheinen: bei
# einem hochkant stehenden Schirm sind sie vertauscht, denn genau so groß
# muss das Bild sein, das ihn ausfüllen soll.
monitor_list() {
    python3 "$ZEPOS_SYSTEM_ROOT/monitors.py" --list
}

# Jeder Schirm hat sein eigenes Raster - benannt nach seinem Anschluss.
# Ein gemeinsames Bild für "alle linken Schirme" wäre bei Footprints
# falsch: die Fenster des einen erschienen auf dem anderen mit.
grid_file_for() {
    echo "${GRID_IMAGE%.png}-$1.png"
}

# Schwarzer Hintergrund in Bildschirmgröße, für das Notebook-Panel.
black_file_for() {
    local name=$1 width=$2 height=$3
    local file="$TMP_DIR/grid-black-${name}.png"

    # Was convert sagt, geht auf stderr: die Ausgabe dieser Funktion ist
    # ein Dateiname, den der Aufrufer einsammelt - eine Warnung von
    # ImageMagick auf stdout landete sonst mitten im Pfad.
    if [ ! -f "$file" ]; then
        convert -size "${width}x${height}" xc:"$BG_COLOR" "$file" 1>&2
    fi
    echo "$file"
}

# Zeichnet ein Raster in der Größe eines Schirms.
#
# Rand, oberer Abstand und Zellgröße kommen aus der Konfiguration, alles
# andere aus der Auflösung. Auf einem 3840x2160-Schirm ergibt das exakt
# den Rahmen, den die feste Fassung gezeichnet hat.
draw_grid() {
    local output_file=$1 width=$2 height=$3

    local right=$((width - GRID_MARGIN - 1))
    local bottom=$((height - GRID_MARGIN - 2))

    local grid_lines=""
    local y=$GRID_TOP_OFFSET
    while [ "$y" -le "$bottom" ]; do
        grid_lines="$grid_lines line $GRID_MARGIN,$y $right,$y"
        y=$((y + GRID_CELL))
    done
    local x=$GRID_MARGIN
    while [ "$x" -le "$right" ]; do
        grid_lines="$grid_lines line $x,$GRID_TOP_OFFSET $x,$bottom"
        x=$((x + GRID_CELL))
    done

    convert -size "${width}x${height}" xc:"$BG_COLOR" \
        -stroke "$GRID_COLOR" -strokewidth 1 -fill none \
        -draw "$grid_lines" \
        -stroke "$BORDER_COLOR" -strokewidth 1 -fill none \
        -draw "rectangle $GRID_MARGIN,$GRID_TOP_OFFSET $right,$bottom" \
        "$output_file"
}

generate_grid() {
    echo " Generiere Grid Wallpaper für Profil: $PROFILE..."

    local monitors
    if ! monitors=$(monitor_list); then
        echo " Keine Monitore gefunden - Grid kann nicht erzeugt werden" >&2
        return 1
    fi

    local name x transform width height role
    local drawn=0
    while read -r name x transform width height role; do
        # Das Notebook-Panel ist zu klein zum Ausrichten von Fenstern und
        # bekommt weiterhin einen schlichten Hintergrund.
        [ "$role" = "panel" ] && continue
        draw_grid "$(grid_file_for "$name")" "$width" "$height"
        drawn=$((drawn + 1))
    done <<< "$monitors"

    # Gezählt wird, was gezeichnet wurde - nicht, was angeschlossen ist.
    echo " Grid Wallpaper für $drawn Monitor(e) erstellt"
}

# Der Pfad des Rasters eines Schirms - gezeichnet, falls es fehlt.
#
# Ein Schirm, der beim letzten Erzeugen noch nicht angesteckt war, hat
# keines. Ohne diese Prüfung zeigte swaybg auf eine Datei, die es nicht
# gibt, und die Footprint-Funktion sprang ihn stillschweigend über.
ensure_grid() {
    local name=$1 width=$2 height=$3
    local file
    file=$(grid_file_for "$name")
    # 1>&2 aus demselben Grund wie oben: hier kommt ein Pfad zurück.
    [ -f "$file" ] || draw_grid "$file" "$width" "$height" 1>&2
    echo "$file"
}

# Die swaybg-Argumente für alle Schirme, ein Bild je Schirm - ein
# Argument je Zeile.
#
# Ein Pfad kann ein Leerzeichen enthalten, und TMP_DIR ebenso. Vorher
# standen alle vier Argumente eines Schirms in einer Zeile und wurden von
# xargs an jedem Leerzeichen zerlegt.
wallpaper_args() {
    local monitors
    monitors=$(monitor_list) || return 1

    local name x transform width height role file
    while read -r name x transform width height role; do
        if [ "$role" = "panel" ]; then
            file=$(black_file_for "$name" "$width" "$height")
        else
            file=$(ensure_grid "$name" "$width" "$height")
        fi
        printf '%s\n' "-o" "$name" "-m" "fill" "-i" "$file"
    done <<< "$monitors"
}

# Startet swaybg mit den Bildern aller Schirme. Gibt 1 zurück, wenn es
# keine Schirme zu bespielen gab.
#
# Vorher stand hier `wallpaper_args | xargs swaybg`, und xargs verdeckt
# genau den Fall, für den der Aufrufer sich interessiert: bei leerer
# Eingabe führt es den Befehl trotzdem aus und endet mit 0. Gemessen -
# monitor_list schlug fehl, wallpaper_args gab nichts aus und meldete 1,
# und trotzdem startete ein nacktes `swaybg` (das jeden Ausgang mit
# demselben Bild überzieht), während die Meldung "Grid Overlay aktiviert"
# erschien und "Monitore nicht ermittelbar!" nie kam. Der Exit-Status von
# wallpaper_args geht durch eine Pipe ohnehin verloren; hier wird er
# gelesen.
start_wallpapers() {
    local rendered
    rendered=$(wallpaper_args) || return 1
    [ -n "$rendered" ] || return 1

    local args=() argument
    while IFS= read -r argument; do
        args+=("$argument")
    done <<< "$rendered"

    # In den Hintergrund, weil swaybg ein Dienst ist und kein Befehl: es
    # laeuft, solange die Bilder stehen, und endet erst mit dem
    # `pkill -9 -f swaybg` des naechsten Umschaltens.
    #
    # Im Vordergrund kehrte diese Funktion deshalb nie zurueck. Alles,
    # was danach kommt, kam nie: die Meldung "Grid Overlay aktiviert"
    # erschien auf einem laufenden Desktop nicht ein einziges Mal, und
    # `grid-wallpaper-toggle.sh toggle` blockierte bis zum naechsten
    # Umschalten - also auch die Tastenbindung, die es aufruft.
    #
    # disown nimmt den Auftrag aus der Jobtabelle dieser Shell: das Skript
    # endet gleich, und swaybg soll das ueberleben.
    swaybg "${args[@]}" &
    disown
}

# Setzt die Hintergründe neu, wenn der Grid-Modus gerade aktiv ist.
reload_wallpapers() {
    [ -f "$TOGGLE_FILE" ] || return 0

    pkill -9 -f swaybg
    sleep 0.2
    start_wallpapers
}

add_footprints() {
    echo " Füge Footprints für floating Fenster hinzu..."

    # Hole alle floating Fenster
    local floating_windows=$(hyprctl clients -j | jq -c '.[] | select(.floating == true)')

    if [ -z "$floating_windows" ]; then
        notify-send " Keine Footprints" "Keine floating Fenster gefunden!" -t 2000
        return
    fi

    # Speichere Footprint-Daten
    echo "$floating_windows" > "$FOOTPRINT_FILE"

    local monitors
    monitors=$(monitor_list) || return 1

    # Für jeden Monitor
    while read -r monitor_name monitor_x transform monitor_width monitor_height role; do
        # Das Panel hat kein Raster, auf das ein Footprint passen würde.
        [ "$role" = "panel" ] && continue

        local grid_file
        grid_file=$(ensure_grid "$monitor_name" "$monitor_width" "$monitor_height")

        # Backup erstellen
        cp "$grid_file" "${grid_file}.backup"

        # Füge Footprints zum Grid hinzu
        echo "$floating_windows" | while IFS= read -r window; do
            local x=$(echo "$window" | jq -r '.at[0]')
            local y=$(echo "$window" | jq -r '.at[1]')
            local width=$(echo "$window" | jq -r '.size[0]')
            local height=$(echo "$window" | jq -r '.size[1]')
            local class=$(echo "$window" | jq -r '.title')
            local workspace=$(echo "$window" | jq -r '.workspace.id')

            # Prüfe ob Fenster auf diesem Monitor ist (grobe Prüfung über
            # x-Position). Die Breite ist die des Monitors: früher stand
            # hier die feste Zahl 3840, und auf jedem schmaleren Schirm
            # reichte der angenommene Bereich bis weit in den Nachbarn
            # hinein - dessen Fenster wurden dann auf beide Raster
            # gezeichnet. (Fensterkoordinaten sind logische Pixel; bei
            # einer Skalierung ungleich 1 sind sie kleiner als die
            # Bildpunkte, die hier gezeichnet werden.)
            local monitor_start=$monitor_x
            local monitor_end=$((monitor_x + monitor_width))

            if [[ "$x" -ge "$monitor_start" ]] && [[ "$x" -lt "$monitor_end" ]]; then
                # Berechne relative Position zum Monitor
                local rel_x=$((x - monitor_x))
                local rel_y=$((y - HYPRBARS_HEIGHT))  # 25px nach oben für Titelbar

                # Berechne Mitte des Fensters (inkl. Titelbar) für Text
                local text_x=$((rel_x + width/2))
                local text_y=$((rel_y + (height + HYPRBARS_HEIGHT)/2))

                # Footprint mit gefülltem Hintergrund und Rahmen
                convert "$grid_file" \
                    -fill "$FOOTPRINT_BG" \
                    -draw "rectangle $((rel_x - FOOTPRINT_PADDING)),$((rel_y - FOOTPRINT_PADDING)) $((rel_x + width + FOOTPRINT_PADDING)),$((rel_y + height + HYPRBARS_HEIGHT + FOOTPRINT_PADDING))" \
                    -stroke "$FOOTPRINT_COLOR" -strokewidth "$FOOTPRINT_BORDER_WIDTH" \
                    -fill none \
                    -draw "rectangle $((rel_x - FOOTPRINT_PADDING)),$((rel_y - FOOTPRINT_PADDING)) $((rel_x + width + FOOTPRINT_PADDING)),$((rel_y + height + HYPRBARS_HEIGHT + FOOTPRINT_PADDING))" \
                    "$grid_file"

                # Text mit hellgrauer Farbe und kleiner Schrift - zentriert
                # Erstelle Text-Bild und hole dessen Dimensionen
                text_img="$TMP_DIR/footprint_text_$$.png"
                convert -background none -fill "$FOOTPRINT_TEXT_COLOR" \
                    -font "$FOOTPRINT_FONT" \
                    -pointsize "$FOOTPRINT_TEXT_SIZE" \
                    label:"$class" \
                    "$text_img"

                # Hole Text-Dimensionen
                text_width=$(identify -format "%w" "$text_img")
                text_height=$(identify -format "%h" "$text_img")

                # Berechne zentrierte Position
                text_pos_x=$((text_x - text_width/2))
                text_pos_y=$((text_y - text_height/2))

                # Füge Text zum Grid hinzu
                composite -geometry +${text_pos_x}+${text_pos_y} "$text_img" "$grid_file" "$grid_file"
                rm -f "$text_img"
            fi
        done
    done <<< "$monitors"

    reload_wallpapers

    notify-send " Footprints" "$(echo "$floating_windows" | jq -s 'length') Footprints hinzugefügt!" -t 2000
}

clear_footprints() {
    echo " Lösche alle Footprints..."

    # Grid neu generieren ohne Footprints (nur für aktuelles Profil!)
    rm -f ~/.config/hypr/grid-wallpaper-${PROFILE}*.png
    generate_grid

    # Footprint-Daten löschen
    rm -f "$FOOTPRINT_FILE"

    reload_wallpapers

    notify-send " Footprints" "Alle Footprints gelöscht!" -t 2000
}

toggle_wallpaper() {
    if [ -f "$TOGGLE_FILE" ]; then
        # Grid ist aktiv, zurück zum normalen Wallpaper
        rm -f "$TOGGLE_FILE"

        # Kill alle swaybg Prozesse
        pkill -9 -f swaybg
        sleep 0.2

        # Starte random wallpaper script neu
        $RANDOM_WALLPAPER_SCRIPT

        notify-send " Grid Mode" "Normaler Desktop aktiviert" -t 2000
    else
        # Aktiviere Grid
        touch "$TOGGLE_FILE"

        # Kill alle swaybg Prozesse
        pkill -9 -f swaybg
        sleep 0.2

        # Setze auf jedem Schirm das Bild, das zu ihm gehört. Fehlende
        # Raster entstehen dabei - der Aufruf ersetzt die frühere Prüfung
        # auf zwei feste Dateinamen.
        if ! start_wallpapers; then
            # Die Markierung wieder weg: sie ist das Einzige, woran der
            # Rest des Systems den Grid-Modus erkennt - wallpaper-manager
            # verweigert mit ihr das Setzen von Hintergrundbildern, und
            # der nächste Tastendruck würde einen Modus "abschalten", der
            # nie zustande kam. Dieser Zweig war bis eben unerreichbar,
            # weil xargs den Fehlschlag verschluckte.
            rm -f "$TOGGLE_FILE"
            notify-send -u critical " Grid Mode" "Monitore nicht ermittelbar!" -t 3000
            return 1
        fi

        notify-send " Grid Mode" "Grid Overlay aktiviert (Profil: $PROFILE)\nPerfekt für Floating Window Positionierung!" -t 3000
    fi
}

# Hauptfunktion
case "$1" in
    generate)
        generate_grid
        ;;
    toggle)
        toggle_wallpaper
        ;;
    footprint)
        add_footprints
        ;;
    clear-footprints)
        clear_footprints
        ;;
    status)
        echo "Profil: $PROFILE"
        if [ -f "$TOGGLE_FILE" ]; then
            echo "Grid Mode: AKTIV"
            if [ -f "$FOOTPRINT_FILE" ]; then
                echo "Footprints: $(cat "$FOOTPRINT_FILE" | jq -s 'length')"
            fi
        else
            echo "Grid Mode: INAKTIV"
        fi
        ;;
    *)
        echo "Grid Wallpaper Toggle"
        echo "Verwendung:"
        echo "  $0 generate       - Generiert neues Grid Wallpaper"
        echo "  $0 toggle         - Wechselt zwischen Grid und normalem Wallpaper"
        echo "  $0 footprint      - Fügt Footprints für floating Fenster hinzu"
        echo "  $0 clear-footprints - Löscht alle Footprints"
        echo "  $0 status         - Zeigt aktuellen Status"
        ;;
esac
