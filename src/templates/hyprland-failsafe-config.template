# =========================================
# HYPRLAND FAILSAFE CONFIGURATION
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hyprland-failsafe-config.template
# =========================================
#
# This is a minimal safe configuration that should work on ANY system
# - No monitor rotations
# - Basic workspace setup
# - Emergency recovery keybinds
# - Minimal plugins
# =========================================

# =========================================
# MONITOR CONFIGURATION - SAFE DEFAULTS
# =========================================

# Accept any monitor in its default configuration
# NO ROTATIONS, NO SPECIAL SCALING
monitor=,preferred,auto,1

# =========================================
# WORKSPACE ASSIGNMENTS - SIMPLE
# =========================================

# All workspaces on first available monitor
# No complex assignments that could fail
workspace=1,monitor:0
workspace=2,monitor:0
workspace=3,monitor:0
workspace=4,monitor:0
workspace=5,monitor:0
workspace=6,monitor:0
workspace=7,monitor:0
workspace=8,monitor:0
workspace=9,monitor:0
workspace=10,monitor:0

# =========================================
# MINIMAL AUTOSTART
# =========================================

# Only essential services
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = dbus-update-activation-environment --all

# Simple status notification
exec-once = notify-send "{{ICON_WARNING}} Hyprland Failsafe Mode" "Running in safe configuration. Press SUPER+CTRL+ALT+R to reload normal config"

# =========================================
# INPUT CONFIGURATION
# =========================================

input {
    kb_layout = de
    numlock_by_default = true
    follow_mouse = 1
    sensitivity = 0
}

# =========================================
# GENERAL CONFIGURATION - SAFE
# =========================================

general {
    gaps_in = 5
    gaps_out = 10
    border_size = 2
    col.active_border = rgb(ff0000)  # RED border to indicate failsafe mode
    col.inactive_border = rgba(595959aa)
    layout = dwindle  # Most stable layout
}

# =========================================
# MINIMAL DECORATION
# =========================================

decoration {
    rounding = 5
    blur {
        enabled = false  # Disable blur for performance
    }
    shadow {
        enabled = false  # Disable shadows for performance
    }
}

# =========================================
# SIMPLE ANIMATIONS
# =========================================

animations {
    enabled = yes
    animation = windows, 1, 3, default
    animation = fade, 1, 3, default
    animation = workspaces, 1, 3, default
}

# =========================================
# LAYOUT CONFIGURATION
# =========================================

dwindle {
    preserve_split = yes
}

# =========================================
# EMERGENCY KEYBINDINGS
# =========================================
#
# Auch hier traegt jede bind-Zeile ihre `# @Gruppe: Text`-Markierung, und
# hier ist sie am wichtigsten: diese Datei wird geladen, wenn die normale
# Konfiguration schon nicht mehr geht, und ein Nutzer, der in diesem
# Zustand sitzt, weiss von diesen Tasten nichts. Die Uebersicht liest
# hyprland-failsafe.conf mit - siehe keybinds.OVERVIEW_CONFIGS -, also
# steht das, was ihn hier herausbringt, in derselben Liste wie alles
# andere.

$mainMod = SUPER

# Terminal - Always available
#
# `--directory ~` aus demselben Grund wie in
# hyprland-universal-config.template, und hier wiegt er schwerer als
# dort: diese Datei wird geladen, wenn die normale Konfiguration schon
# nicht mehr geht. Wer in diesem Zustand ein Terminal aufmacht, tippt als
# Naechstes einen Befehl auf eine Datei in SEINEM Verzeichnis - und ein
# Terminal, das irgendwo im System steht, macht daraus im besten Fall
# "no such file".
# @Notfall: Terminal oeffnen (kitty)
bind = $mainMod, Return, exec, kitty --directory ~
# @Notfall: Terminal oeffnen (kitty)
bind = $mainMod, Q, exec, kitty --directory ~
# @Notfall: Terminal oeffnen, auch ohne die SUPER-Taste (kitty)
bind = CTRL ALT, T, exec, kitty --directory ~

# Kill window
# @Notfall: Fenster schliessen
bind = $mainMod, X, killactive
# @Notfall: Fenster schliessen, auch ohne die SUPER-Taste
bind = ALT, F4, killactive

# Exit Hyprland
# @Notfall: Hyprland beenden und zurueck zur Anmeldung
bind = $mainMod CTRL ALT, E, exit

# EMERGENCY CONFIG RELOAD
# @Notfall: Normale Konfiguration wieder laden (hyprctl, notify-send)
bind = $mainMod CTRL ALT, R, exec, notify-send "{{ICON_INFO}} Reloading Config" "Attempting to load normal configuration..." && hyprctl reload

# EMERGENCY CONFIG RESET
# @Notfall: Notfallkonfiguration erzwingen (hyprctl, notify-send)
bind = $mainMod CTRL ALT, F, exec, cp ~/.config/hypr/hyprland-failsafe.conf ~/.config/hypr/hyprland.conf && hyprctl reload && notify-send "{{ICON_SUCCESS}} Failsafe Loaded" "Failsafe configuration is now active"

# EMERGENCY MONITOR RESET
# @Notfall: Alle Schirme auf ihre Vorgabe zuruecksetzen (hyprctl, notify-send)
bind = $mainMod CTRL ALT, M, exec, hyprctl keyword monitor ",preferred,auto,1" && notify-send "{{ICON_MONITOR}} Monitors Reset" "All monitors set to default configuration"

# Basic window movement
# @Notfall: Fokus nach links
bind = $mainMod, left, movefocus, l
# @Notfall: Fokus nach rechts
bind = $mainMod, right, movefocus, r
# @Notfall: Fokus nach oben
bind = $mainMod, up, movefocus, u
# @Notfall: Fokus nach unten
bind = $mainMod, down, movefocus, d

# Workspace switching
# @Notfall: Zur Arbeitsflaeche 1
bind = $mainMod, 1, workspace, 1
# @Notfall: Zur Arbeitsflaeche 2
bind = $mainMod, 2, workspace, 2
# @Notfall: Zur Arbeitsflaeche 3
bind = $mainMod, 3, workspace, 3
# @Notfall: Zur Arbeitsflaeche 4
bind = $mainMod, 4, workspace, 4
# @Notfall: Zur Arbeitsflaeche 5
bind = $mainMod, 5, workspace, 5
# @Notfall: Zur Arbeitsflaeche 6
bind = $mainMod, 6, workspace, 6
# @Notfall: Zur Arbeitsflaeche 7
bind = $mainMod, 7, workspace, 7
# @Notfall: Zur Arbeitsflaeche 8
bind = $mainMod, 8, workspace, 8
# @Notfall: Zur Arbeitsflaeche 9
bind = $mainMod, 9, workspace, 9
# @Notfall: Zur Arbeitsflaeche 10
bind = $mainMod, 0, workspace, 10

# Move to workspace
# @Notfall: Fenster auf die Arbeitsflaeche 1
bind = $mainMod SHIFT, 1, movetoworkspace, 1
# @Notfall: Fenster auf die Arbeitsflaeche 2
bind = $mainMod SHIFT, 2, movetoworkspace, 2
# @Notfall: Fenster auf die Arbeitsflaeche 3
bind = $mainMod SHIFT, 3, movetoworkspace, 3
# @Notfall: Fenster auf die Arbeitsflaeche 4
bind = $mainMod SHIFT, 4, movetoworkspace, 4
# @Notfall: Fenster auf die Arbeitsflaeche 5
bind = $mainMod SHIFT, 5, movetoworkspace, 5
# @Notfall: Fenster auf die Arbeitsflaeche 6
bind = $mainMod SHIFT, 6, movetoworkspace, 6
# @Notfall: Fenster auf die Arbeitsflaeche 7
bind = $mainMod SHIFT, 7, movetoworkspace, 7
# @Notfall: Fenster auf die Arbeitsflaeche 8
bind = $mainMod SHIFT, 8, movetoworkspace, 8
# @Notfall: Fenster auf die Arbeitsflaeche 9
bind = $mainMod SHIFT, 9, movetoworkspace, 9
# @Notfall: Fenster auf die Arbeitsflaeche 10
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Toggle floating
# @Notfall: Fenster schweben lassen oder wieder einkacheln
bind = $mainMod, V, togglefloating

# =========================================
# SAFE ENVIRONMENT VARIABLES
# =========================================

env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
env = XDG_CURRENT_DESKTOP,Hyprland

# Disable hardware cursors as they can cause issues
cursor {
    no_hardware_cursors = true
}

# =========================================
# NO PLUGINS IN FAILSAFE MODE
# =========================================
# All plugins are disabled for maximum stability

# =========================================
# RECOVERY INFORMATION
# =========================================
# This configuration is designed to work on any system
# 
# Emergency keys:
# - SUPER+CTRL+ALT+R: Reload normal config
# - SUPER+CTRL+ALT+F: Force failsafe config
# - SUPER+CTRL+ALT+M: Reset all monitors
# - SUPER+CTRL+ALT+E: Exit Hyprland
# - CTRL+ALT+T: Open terminal
#
# If you cannot see anything:
# 1. Press Ctrl+Alt+F2 to switch to TTY2
# 2. Login with your credentials
# 3. Run: ~/.config/hypr/emergency-reset.sh
# =========================================