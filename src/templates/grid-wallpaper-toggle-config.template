#!/bin/bash
# Grid Wallpaper Toggle Style Configuration
# Generated by ZepOS - DO NOT EDIT DIRECTLY!

# Grid Settings
#
# Maße eines Rasters gab es hier früher als feste Größe (3796x2066) - die
# nutzbare Fläche EINES 4K-Schirms. Ein Raster wird jetzt für jeden Schirm
# in dessen eigener Größe gezeichnet, also stehen hier nur noch die
# Abstände, die für jede Auflösung gelten.
export GRID_MARGIN=17        # Rand links, rechts und unten
export GRID_TOP_OFFSET=67    # Oben zusätzlich: Bar und Fensterabstand
export GRID_CELL=100         # Abstand der Rasterlinien
export HYPRBARS_HEIGHT={{STYLE_HYPRBARS_HEIGHT}}

# Colors - Using SSOT from style_definition.py
export GRID_COLOR="{{STYLE_COLOR_GRID}}"             # Sehr dunkles Grau für Grid-Linien
export BORDER_COLOR="{{STYLE_COLOR_GRID_BORDER}}"    # Sehr dunkles Grau für Außenrahmen
export BG_COLOR="{{STYLE_COLOR_GRID_BG}}"            # Reines Schwarz für Grid

# Footprint Settings
export FOOTPRINT_COLOR="{{STYLE_COLOR_FOOTPRINT}}"   # Dunkles Grün für Rahmen
export FOOTPRINT_BG="{{STYLE_COLOR_FOOTPRINT_BG}}"   # Leicht helleres Schwarz
export FOOTPRINT_TEXT_COLOR="{{STYLE_COLOR_FOOTPRINT_TEXT}}"    # Hellgrau für Text
export FOOTPRINT_TEXT_SIZE=14                            # Kleine Schriftgröße
export FOOTPRINT_BORDER_WIDTH=1                          # Rahmenbreite
export FOOTPRINT_PADDING=5                               # Padding um Fenster

# Font Settings
export FOOTPRINT_FONT="/usr/share/fonts/TTF/JetBrainsMonoNerdFontMono-Regular.ttf"