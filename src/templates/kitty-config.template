# Terminal Green Theme für Kitty
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/kitty-config.template

# Font Settings (wie in Sublime)
font_family      {{STYLE_FONT_NAME_CODE}}
# auto rather than a named face: Fira Code ships no italic, and naming
# one that is not installed leaves kitty with nothing to fall back to.
# auto takes the family's own styles and synthesises the rest.
bold_font        auto
italic_font      auto
bold_italic_font auto
# Aus src/sizes.py, also von demselben Regler wie die Leiste und die
# Ueberlagerungen. Hier stand eine 7.0 - bei 96 dpi 9.3 px, waehrend der
# Schreibtisch daneben 24 px zeigte. In Punkt, weil kitty nichts anderes
# annimmt; die Umrechnung steht bei STYLE_TERMINAL_FONT_SIZE.
font_size        {{STYLE_TERMINAL_FONT_SIZE}}

# Font Features
disable_ligatures never
font_features FiraCode +zero +onum

# Cursor (Terminal-Style wie in Sublime)
cursor                  {{STYLE_COLOR_TERMINAL_CURSOR}}
cursor_text_color       #000000
cursor_shape            beam
cursor_beam_thickness   2.0
cursor_blink_interval   -1
cursor_stop_blinking_after 15.0

# Terminal Green Farbschema
# Basierend auf deinem Sublime Theme
# Farben sind im Style Editor anpassbar

# Hauptfarben
foreground              {{STYLE_COLOR_TERMINAL_FG}}
background              {{STYLE_COLOR_TERMINAL_BG}}
background_opacity      0.95
selection_foreground    {{STYLE_COLOR_TERMINAL_BG}}
selection_background    {{STYLE_COLOR_TERMINAL_SELECTION}}

# Terminal Farben (16 color palette)
# Schwarz/Grau
color0                  #0c0c0c
color8                  #404040

# Rot (für Fehler)
color1                  #ff3333
color9                  #ff3333

# Grün (Hauptfarbe) - ANGEPASST AN SUBLIME
color2                  #00cc00
color10                 #33ff33

# Gelb (für Warnungen)
color3                  #cccc00
color11                 #ffff33

# Blau (für Links/Specials)
color4                  #3366ff
color12                 #3366ff

# Magenta (selten genutzt)
color5                  #cc00cc
color13                 #ff00ff

# Cyan (für Infos)
color6                  #00cccc
color14                 #00ffff

# Weiß/Hellgrau
color7                  #808080
color15                 #e6e6e6

# Tab Bar (wie Sublime Tabs)
tab_bar_edge            top
tab_bar_style           powerline
tab_powerline_style     slanted
tab_bar_min_tabs        2
tab_bar_background      #1a1a1a
tab_bar_margin_color    #0c0c0c

# Tab Template mit Icons
tab_title_template      "{{ICON_TERMINAL}} {fmt.fg.red}{bell_symbol}{activity_symbol}{fmt.fg.tab}{title}"
active_tab_title_template "{{ICON_TERMINAL_ACTIVE}} {fmt.fg.red}{bell_symbol}{activity_symbol}{fmt.fg.tab}{title}"

# Aktiver Tab
active_tab_foreground   {{STYLE_COLOR_TERMINAL_ACTIVE_TAB_FG}}
active_tab_background   {{STYLE_COLOR_TERMINAL_ACTIVE_TAB_BG}}
active_tab_font_style   bold

# Inaktiver Tab
inactive_tab_foreground {{STYLE_COLOR_TERMINAL_INACTIVE_TAB_FG}}
inactive_tab_background {{STYLE_COLOR_TERMINAL_INACTIVE_TAB_BG}}
inactive_tab_font_style normal

# Tab Hover
tab_bar_margin_color    #1a1a1a

# Window Layout
window_padding_width    5
window_margin_width     0
single_window_margin_width 0
draw_minimal_borders    yes
window_border_width     1pt
active_border_color     {{STYLE_COLOR_TERMINAL_FG}}
inactive_border_color   {{STYLE_COLOR_TERMINAL_SELECTION}}
bell_border_color       #ff3333

# Scrollback (wie Sublime scroll_past_end)
scrollback_lines        10000
scrollback_pager        less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER
scrollback_fill_enlarged_window yes

# Maus-Support
mouse_hide_wait         3.0
url_color               #3366ff
url_style               curly
copy_on_select          yes
strip_trailing_spaces   smart

# Performance (wie Sublime gpu_window_buffer)
repaint_delay           10
input_delay             3
sync_to_monitor         yes

# Terminal Bell
enable_audio_bell       no
visual_bell_duration    0.1
visual_bell_color       {{STYLE_COLOR_TERMINAL_FG}}

# Advanced
shell_integration       enabled
clone_source_strategies venv,conda,env_var,path
term                    xterm-kitty

# Keyboard shortcuts für Terminal-Feel
map ctrl+shift+c        copy_to_clipboard
map ctrl+shift+v        paste_from_clipboard
map ctrl+shift+up       scroll_line_up
map ctrl+shift+down     scroll_line_down
map ctrl+shift+page_up  scroll_page_up
map ctrl+shift+page_down scroll_page_down
map ctrl+shift+home     scroll_home
map ctrl+shift+end      scroll_end

# Tab Management (wie Sublime)
map ctrl+shift+t        new_tab
map ctrl+shift+w        close_tab
map ctrl+shift+right    next_tab
map ctrl+shift+left     previous_tab
map ctrl+shift+.        move_tab_forward
map ctrl+shift+,        move_tab_backward

# Font size (wie Sublime)
map ctrl+shift+equal    change_font_size all +2.0
map ctrl+shift+minus    change_font_size all -2.0
map ctrl+shift+0        change_font_size all 0

# Layouts
map ctrl+shift+l        next_layout

# Hints (für URLs etc.)
map ctrl+shift+e        open_url_with_hints
open_url_with           default

# Marks (wie Sublime bookmarks)
map ctrl+shift+m        create_marker
map ctrl+shift+n        remove_marker

# Remote control
allow_remote_control    yes
listen_on               unix:/tmp/kitty-$KITTY_PID

# Nerd Fonts Symbol Maps (für die speziellen Symbole)
symbol_map U+E0A0-U+E0A3,U+E0B0-U+E0B3,U+E0B4-U+E0C8,U+E0CC-U+E0D4 {{STYLE_FONT_NAME_ICONS}}
symbol_map U+F000-U+F2E0 {{STYLE_FONT_NAME_ICONS}}
symbol_map U+E200-U+E2A9 {{STYLE_FONT_NAME_ICONS}}
symbol_map U+F500-U+FD46 {{STYLE_FONT_NAME_ICONS}}
symbol_map U+E300-U+E3EB {{STYLE_FONT_NAME_ICONS}}
symbol_map U+E700-U+E7C5 {{STYLE_FONT_NAME_ICONS}}
symbol_map U+EA60-U+EBEB {{STYLE_FONT_NAME_ICONS}}
symbol_map U+F300-U+F32F {{STYLE_FONT_NAME_ICONS}}
symbol_map U+F400-U+F532 {{STYLE_FONT_NAME_ICONS}}
symbol_map U+E000-U+E00A {{STYLE_FONT_NAME_ICONS}}
symbol_map U+F43A {{STYLE_FONT_NAME_CODE}}
symbol_map U+F43A Font Awesome 6 Free

# Wayland specific settings
wayland_titlebar_color system
linux_display_server wayland