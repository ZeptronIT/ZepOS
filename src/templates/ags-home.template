/** Wie viele Zellen nebeneinander und uebereinander auf DIESE Flaeche passen.
 *
 * Aus der heutigen Flaeche und nicht aus einer Zahl: die Flaeche aendert
 * sich im Betrieb (Messung 4 im Kopf). Mindestens eine, damit ein sehr
 * kleiner Schirm kein Gitter ohne Zellen ergibt - ein Home mit null
 * Spalten zeigte gar nichts und saehe wie ein Fehler aus.
 */
function gitter(breite: number, hoehe: number): { spalten: number, zeilen: number } {
  // Der Rand geht ZWEIMAL ab, oben und unten beziehungsweise links und
  // rechts: das Gitter sitzt mittig darin, wie jede andere Flaeche
  // dieses Schreibtischs auch.
  return {
    spalten: Math.max(1, Math.floor((breite - 2 * EDGE_GAP) / CELL)),
    zeilen: Math.max(1, Math.floor((hoehe - 2 * EDGE_GAP) / CELL)),
  }
}

/** Wo jedes Symbol HEUTE liegt.
 *
 * ZWEI DURCHGAENGE, UND DIE REIHENFOLGE IST DIE ENTSCHEIDUNG
 *     Erst bekommen alle ihren Platz, die einen gueltigen und freien
 *     haben - was der Nutzer selbst hingelegt hat, gewinnt. Danach
 *     fuellen die uebrigen die Luecken: die ohne Zelle (neu
 *     ausgeliefert, gerade hinzugefuegt) und die, deren Zelle es auf
 *     DIESEM Schirm nicht gibt.
 *
 *     Andersherum - erst auffuellen, dann die gespeicherten - stuende
 *     ein neu hinzugekommenes Symbol auf dem Platz eines gespeicherten,
 *     und das gespeicherte wanderte. Ein Symbol, das der Nutzer selbst
 *     abgelegt hat, darf nie wegen eines anderen wandern.
 *
 * ZURUECKGESCHRIEBEN WIRD DABEI NICHTS
 *     Das ist die Regel, an der die ganze Frage "was passiert am
 *     kleineren Schirm" haengt. Ein Symbol bei Zelle (14,7) liegt auf
 *     einem schmalen Schirm ersatzweise woanders - in der
 *     Einstellungsdatei steht weiterhin (14,7). Steckt der Nutzer den
 *     grossen Schirm wieder an, liegt es wieder dort, wo er es
 *     hingelegt hat. Die ganze Begruendung steht bei HOME in
 *     src/settings.py.
 *
 * SPALTENWEISE UND NICHT ZEILENWEISE
 *     Die erste freie Zelle ist die naechste UNTEN, nicht die naechste
 *     rechts: ein Schreibtisch fuellt sich am linken Rand nach unten und
 *     erst dann in der naechsten Spalte. Windows macht es so, und es ist
 *     die Richtung, in der ein breiter Schirm nicht sofort eine
 *     Symbolzeile quer ueber das ganze Bild legt.
 */
function lege(icons: HomeIcon[], spalten: number, zeilen: number): Gelegt[] {
  const belegt = new Set<string>()
  const gelegt: Gelegt[] = []
  const offen: HomeIcon[] = []

  const schluessel = (col: number, row: number) => `${col}:${row}`

  for (const icon of icons) {
    const hatZelle = typeof icon.col === "number" && typeof icon.row === "number"
    const passt = hatZelle
      && icon.col! >= 0 && icon.col! < spalten
      && icon.row! >= 0 && icon.row! < zeilen
      && !belegt.has(schluessel(icon.col!, icon.row!))
    if (passt) {
      belegt.add(schluessel(icon.col!, icon.row!))
      gelegt.push({ icon, col: icon.col!, row: icon.row! })
    } else {
      offen.push(icon)
    }
  }

  let naechste = 0
  for (const icon of offen) {
    while (naechste < spalten * zeilen) {
      const col = Math.floor(naechste / zeilen)
      const row = naechste % zeilen
      naechste += 1
      if (belegt.has(schluessel(col, row))) continue
      belegt.add(schluessel(col, row))
      gelegt.push({ icon, col, row })
      break
    }
    if (naechste >= spalten * zeilen) {
      // Kein Absturz und kein stilles Verschwinden: das Symbol bleibt in
      // der Datei, es ist heute nur kein Platz dafuer. Auf einem
      // groesseren Schirm ist es wieder da.
      console.log(
        `Home: fuer "${icon.name}" ist auf dieser Flaeche kein Platz `
        + `(${spalten}x${zeilen} Zellen) - es bleibt gespeichert`)
    }
  }
  return gelegt
}

