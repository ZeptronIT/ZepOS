//
// DIESELBE FORM WIE DAS MENUE DES DOCKS, UND OHNE EIGENE KLASSEN
//     Ein Gtk.Popover mit zepRow-Zeilen, kein Gtk.PopoverMenu - die
//     ganze Begruendung dafuer steht bei zeigeMenue() in
//     ags-dock.template und wird hier nicht abgeschrieben.
//
//     Gestylt wird es von `popover > contents` in ags-style.template,
//     einem ELEMENT-Wahlausdruck. Genau deshalb steht hier keine einzige
//     CSS-Klasse: das Menue des Docks war am 20.08.2026 komplett weiss,
//     weil es zwei eigene Klassen trug, zu denen es keine Regel gab. Ein
//     Menue, das gar keine Klasse traegt, kann diesen Fehler nicht noch
//     einmal machen - es erbt dieselbe Platte wie jedes andere Popover
//     dieses Baums.

interface MenueEintrag {
  symbol: string
  text: string
  tun: () => void
}

/** Das Menue an einem Widget aufklappen.
 *
 * `zeigeAn` ist das Rechteck, an dem es sich ausrichtet - beim Klick auf
 * die freie Flaeche ist das der Zeigerpunkt und nicht das Widget, sonst
 * klappte das Menue immer in der Mitte des Schirms auf.
 */
function zeigeMenue(anker: Gtk.Widget, eintraege: MenueEintrag[],
                    zeigeAn?: Gdk.Rectangle): Gtk.Popover | null {
  if (!eintraege.length) return null

  const liste = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL })
  const menue = new Gtk.Popover({ has_arrow: false })
  menue.set_child(liste)
  menue.set_parent(anker)
  if (zeigeAn) menue.set_pointing_to(zeigeAn)

  eintraege.forEach((eintrag, stelle) => {
    if (stelle) liste.append(zepDivider())
    liste.append(zepRow({
      symbol: eintrag.symbol,
      titel: eintrag.text,
      navEintrag: true,
      // ERST ZU, DANN TUN - dieselbe Reihenfolge wie im Dock: sonst
      // stuende das Menue noch, waehrend darunter schon ein Programm
      // startet oder die Flaeche neu gezeichnet wird.
      aktion: () => {
        menue.popdown()
        eintrag.tun()
      },
    }))
  })

  // ABGENOMMEN IM LEERLAUF UND NICHT IM RUECKRUF: "closed" laeuft mitten
  // im Abbau des Popovers. Die Messung dazu steht in ags-dock.template.
  menue.connect("closed", () => {
    GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
      if (menue.get_parent()) menue.unparent()
      return GLib.SOURCE_REMOVE
    })
  })

  menue.popup()
  return menue
}

// =====================================================================
// DIE FLAECHE
// =====================================================================

export interface HomeHandle {
  windows: Astal.Window[]
}

/** Das Home.
 *
 * `toggleByName` kommt herein und wird nicht importiert - dasselbe
 * Muster wie bei PowerButton(): zwei Menuepunkte oeffnen ein Fenster
 * DIESES Prozesses (die Tapetenauswahl und die Einstellungen), und ein
 * Import haenge das Home an jedes davon.
 */
export default function Home(
  toggleByName: (name: string, at?: any) => void,
): HomeHandle {
  const windows: Astal.Window[] = []

  // Der Zustand: was zuletzt gelesen wurde. Er steht hier und nicht in
  // einem Modul-Feld, damit zwei Homes (falls je zwei entstehen) sich
  // nicht ins Gehege kommen.
  let icons: HomeIcon[] = []

  // Was zuletzt GEZEICHNET wurde, als Text. Ein Text und keine Liste,
  // weil verglichen und nicht gerechnet wird - dieselbe Ueberlegung, aus
  // der `angefordert` in ags-dock.template "BxH" ist und nicht zwei
  // Zahlen. Wozu er da ist, steht bei uebernimm().
  let gezeichnet = ""

  // Was im FUSS steht. Nicht der Zustand dieses Fensters, sondern der
  // des anderen - gebraucht fuer die Richtung des Menuepunkts (siehe
  // dockPunkt()) und frisch gehalten von derselben Ueberwachung.
  let dockNamen: string[] = []

  /** Eine Flaeche: ihr Fenster, ihr Gitter und was darauf zuletzt lag. */
  interface Flaeche {
    window: Astal.Window
    fixed: Gtk.Fixed
    // Je Schirm eigen, weil das Gitter je Schirm eigen ist: ein
    // 1920er Schirm hat mehr Spalten als ein 1366er, dieselbe Zelle
    // liegt also woanders. Eine gemeinsame Liste waere eine Liste, die
    // auf einem der beiden Schirme nicht stimmt.
    gelegt: Gelegt[]
  }
  const flaechen: Flaeche[] = []

  // EINE FLAECHE JE SCHIRM, UND ZWAR AUCH NACH DEM ANSTECKEN
  //
  //     Ueber jeSchirm() aus ../utils/kit, wie die Leiste, das Dock und
  //     die beiden Knoepfe. Bis zum 01.09.2026 stand hier eine eigene
  //     Schleife ueber `get_monitors()`, EINMAL beim Start gelaufen -
  //     ein spaeter angesteckter Schirm bekam kein Home, und ein
  //     abgesteckter liess seine Flaeche mit einem toten Gdk.Monitor
  //     stehen. Die Begruendung steht bei jeSchirm().
  //
  //     Die drei Zeilen, die frueher NACH der Schleife noch einmal ueber
  //     `flaechen` liefen (annahme() und verfolgeGroesse()), stehen jetzt
  //     HIER: ein Schirm, der spaeter dazukommt, braucht sie genauso -
  //     ohne annahme() nimmt seine Flaeche kein gezogenes Symbol an, ohne
  //     verfolgeGroesse() bleibt sie leer.
  jeSchirm("Home", (monitor: Gdk.Monitor) => {
    const window = new Astal.Window({
      namespace: WINDOW_NAME,
      name: `home-${monitor.connector}`,
      // MESSUNG 1 UND 2 IM KOPF. `bottom` ist die Sicherung, die
      // Fenster anklickbar laesst - nicht die Eingaberegion.
      layer: Astal.Layer.BOTTOM,
      // Alle vier Kanten: das Home ist die ganze freie Flaeche.
      anchor: (Astal.WindowAnchor.TOP | Astal.WindowAnchor.BOTTOM
               | Astal.WindowAnchor.LEFT | Astal.WindowAnchor.RIGHT),
      // NORMAL und nicht IGNORE: die Flaeche endet dort, wo Leiste und
      // Dock ihre Zonen reserviert haben. GEMESSEN am 20.08.2026 - mit
      // IGNORE (exclusive_zone -1) laege sie UNTER der Leiste, und die
      // oberste Symbolzeile stuende hinter ihr. Unter Windows liegt
      // auch kein Symbol unter der Taskleiste.
      exclusivity: Astal.Exclusivity.NORMAL,
      // MESSUNG 3 IM KOPF. NIEMALS EXCLUSIVE.
      keymode: Astal.Keymode.NONE,
      gdkmonitor: monitor,
      visible: true,
    })
    window.add_css_class("home-window")

    const fixed = new Gtk.Fixed()
    fixed.add_css_class("home-grid")
    window.set_child(fixed)

    // JEDER SCHIRM TRAEGT DIESELBEN SYMBOLE - UND DAS WAR ANDERS GEPLANT
    //
    //     Der Entwurf zu dieser Aufgabe sah "die Symbole nur auf dem
    //     ersten Schirm" vor, mit Windows als Vorbild (dort liegen sie
    //     auf dem Hauptbildschirm). GEFALLEN ist das am 20.08.2026 an
    //     einer Messung: tests/render/test_home.py fand null gezeichnete
    //     Bildpunkte, weil der verschachtelte Compositor ZWEI Ausgaenge
    //     hat und `get_monitors()` den anderen zuerst nennt als den
    //     abgebildeten.
    //
    //     Das ist kein Fehler des Tests. Es ist die Frage, die die Regel
    //     nie beantwortet hat: WELCHER Schirm ist der erste? Hyprland
    //     kennt keinen Hauptbildschirm, die Reihenfolge von
    //     `get_monitors()` ist die der Anmeldung, und die aendert sich
    //     beim Umstecken. Der Nutzer haette seine Symbole auf einem
    //     Schirm, den er nicht waehlen kann - und nach dem naechsten
    //     Neustart moeglicherweise auf einem anderen.
    //
    //     Also alle. Es gibt EINE Liste und EINE Anordnung; jeder Schirm
    //     rechnet sie in sein eigenes Gitter (ein 1920er hat mehr
    //     Spalten als ein 1366er). Wer auf einem Schirm ein Symbol
    //     zieht, hat es auf allen gezogen - eine Anordnung, kein
    //     Schirmzustand. Und der Wunsch "auf dem hintergrund rechtsklick
    //     drücken" gilt damit ueberall, ohne Sonderfall.
    //
    //     Was es kostet: nichts. 0.00 % im Leerlauf je Flaeche, gemessen
    //     (siehe Kopf).
    const flaeche: Flaeche = { window, fixed, gelegt: [] }
    flaechen.push(flaeche)
    windows.push(window)

    rechtsklickAufDieFlaeche(fixed)
    annahme(flaeche)
    verfolgeGroesse(window)
    return flaeche
  }, (flaeche: Flaeche) => {
    const imGitter = flaechen.indexOf(flaeche)
    if (imGitter >= 0) flaechen.splice(imGitter, 1)
    const imFeld = windows.indexOf(flaeche.window)
    if (imFeld >= 0) windows.splice(imFeld, 1)
    flaeche.window.destroy()
  })

  // ===================================================================
  // ZEICHNEN
  // ===================================================================

  function zeichne(): void {
    for (const flaeche of flaechen) {
      let kind = flaeche.fixed.get_first_child()
      while (kind) {
        const naechstes = kind.get_next_sibling()
        flaeche.fixed.remove(kind)
        kind = naechstes
      }

      const breite = flaeche.window.get_width()
      const hoehe = flaeche.window.get_height()
      // Vor dem Abbilden meldet GTK 0 - dann gibt es noch keine Flaeche,
      // auf die man legen koennte. Der "map"-Rueckruf unten zeichnet
      // erneut, sobald sie steht.
      if (breite <= 0 || hoehe <= 0) {
        flaeche.gelegt = []
        continue
      }

      const { spalten, zeilen } = gitter(breite, hoehe)

      // NEU GELEGT WIRD NUR, WENN ES SEIN MUSS - GEMESSEN am 20.08.2026
      //
      //     Vorher wurde bei JEDER Groessenaenderung neu gelegt, und das
      //     hatte eine Folge, die niemand bestellt hat: SUPER+B faehrt
      //     das Dock ein, die exklusive Zone faellt weg, die Flaeche
      //     wird hoeher (gemessen: 1041 -> 1081), das Gitter bekommt eine
      //     Zeile mehr - und SAEMTLICHE Symbole ruecken. Der Nutzer
      //     drueckt eine Taste, um den Fuss wegzunehmen, und raeumt sich
      //     dabei den Schreibtisch um.
      //
      //     Aufgefallen ist es an zwei fremden Zusicherungen
      //     (tests/render/test_starter.py, test_einfahrt.py), die messen,
      //     dass unten nach SUPER+B alles unveraendert zurueckkommt: 87
      //     Punkte Unterschied und ein um 8 Punkte verschobener Kasten.
      //
      //     Die Regel ist jetzt: WAECHST die Flaeche, bleibt liegen, was
      //     liegt - mehr Platz ist kein Grund, etwas zu bewegen.
      //     SCHRUMPFT sie so weit, dass ein Symbol herausfiele, wird neu
      //     gelegt, denn sonst waere es unerreichbar. Das ist zugleich
      //     das Verhalten, das Windows zeigt, wenn die Taskleiste
      //     automatisch verschwindet.
      //     Geprueft wird ueber die NAMEN und nicht ueber die Anzahl: wer
      //     ein Symbol abnimmt und ein anderes hinzufuegt, hat gleich
      //     viele - und bekaeme sonst das alte Bild mit dem neuen Namen
      //     darunter.
      const passtNoch = flaeche.gelegt.length === icons.length
        && flaeche.gelegt.every((p, stelle) =>
             p.icon.name === icons[stelle].name
             && p.col < spalten && p.row < zeilen)
      if (!passtNoch) flaeche.gelegt = lege(icons, spalten, zeilen)
      for (const platz of flaeche.gelegt) {
        flaeche.fixed.put(symbolKnopf(platz),
                          EDGE_GAP + platz.col * CELL,
                          EDGE_GAP + platz.row * CELL)
      }
    }
  }

  /** Ein Symbol: Bild, Beschriftung, Klick, Rechtsklick, Ziehen. */
  function symbolKnopf(platz: Gelegt): Gtk.Widget {
    const info = eintragFuer(platz.icon.name)

    const knopf = new Gtk.Button({ can_focus: true })
    knopf.add_css_class("home-icon")

    const kasten = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL,
      valign: Gtk.Align.CENTER,
      halign: Gtk.Align.CENTER,
    })

    if (info) {
      const bild = new Gtk.Image({ pixel_size: ICON_SIZE })
      const symbol = info.get_icon()
      if (symbol) bild.set_from_gicon(symbol)
      else bild.set_from_icon_name(platz.icon.name)
      kasten.append(bild)
    } else {
      // Kein Eintrag auf DIESER Maschine. settings.py hat den Namen
      // eigentlich schon herausgenommen (BAR_GONE); hierher kommt nur,
      // was zwischen dem Lesen und dem Zeichnen deinstalliert wurde.
      // Ein Zeichen aus der eigenen Quelle statt eines fremden
      // Ersatzbildes - dieselbe Entscheidung wie im Dock: ein Zahnrad
      // hiesse "Einstellungen" und nicht "unbekannt".
      //
      // AUF SYMBOLHOEHE GEZWUNGEN, UND DAS IST GEMESSEN
      //     Am Bild vom 20.08.2026 standen die Beschriftungen zweier
      //     Spalten 13 Punkte gegeneinander versetzt: ein Nerd-Font-
      //     Zeichen ist SCHRIFT und damit niedriger als ein 48 Punkte
      //     hohes Bild. Die Zelle blieb gleich gross, der Inhalt darin
      //     rutschte hoch, und ein Gitter mit versetzten Zeilen sieht
      //     nicht nach Gitter aus.
      //
      //     Dieselbe Ueberlegung, aus der ags-dock.template seinem
      //     Ersatzzeichen die Groesse der Symbole gibt ("damit der Knopf
      //     gleich gross bleibt") - hier auf beiden Achsen, weil eine
      //     Zelle beides festhaelt.
      const ersatz = new Gtk.Label({
        label: ICONS.unknown,
        valign: Gtk.Align.CENTER,
        halign: Gtk.Align.CENTER,
      })
      ersatz.set_size_request(ICON_SIZE, ICON_SIZE)
      kasten.append(ersatz)
    }

    const beschriftung = new Gtk.Label({
      label: benennung(platz.icon.name, info),
      justify: Gtk.Justification.CENTER,
    })
    // Kuerzen UND die natuerliche Breite deckeln - beides, aus dem
    // Grund, den zepRow in ags-kit.template ausfuehrlich nennt:
    // `ellipsize` senkt bei GTK nur die MINDESTbreite, nicht die
    // natuerliche. Ein Gtk.Fixed deckelt gar nichts, also liefe ein
    // langer Anwendungsname hier quer ueber seine Nachbarn.
    //
    // Die Grenze ist AUSGERECHNET und nicht getippt: Zellbreite geteilt
    // durch den gemessenen Zeichenvorschub dieser Schrift, siehe
    // home_label_chars() in src/sizes.py. Beide Groessen folgen dem
    // Faktor des Nutzers, die Zahl also auch.
    beschriftung.set_ellipsize(3)  // Pango.EllipsizeMode.END
    beschriftung.set_max_width_chars({{STYLE_HOME_LABEL_CHARS}})
    beschriftung.add_css_class("home-label")
    beschriftung.set_size_request(CELL, -1)
    kasten.append(beschriftung)

    knopf.set_child(kasten)
    // Der Kurzhinweis traegt den VOLLEN Namen. Die Beschriftung darunter
    // kuerzt auf eine Zellbreite (siehe dort), und ein gekuerzter Name
    // ohne einen Weg zum vollen ist genau der Knopf, bei dem man raten
    // muss, was er oeffnet.
    knopf.set_tooltip_text(benennung(platz.icon.name, info))

    knopf.connect("clicked", () => {
      if (info) starte(info)
      else console.error(
        `Home: "${platz.icon.name}" hat auf dieser Maschine keinen `
        + `Anwendungseintrag - es startet nichts`)
    })

    rechtsklickAufEinSymbol(knopf, platz, info)
    ziehbar(knopf, platz)
    return knopf
  }

  // ===================================================================
  // DIE ZWEI MENUES
  // ===================================================================

  function rechtsklickAufEinSymbol(knopf: Gtk.Widget, platz: Gelegt,
                                   info: GioUnix.DesktopAppInfo | null): void {
    // Knopf 3 ist die rechte Taste. `new Gtk.GestureClick({button: 3})`
    // und nicht button 0 mit einer Abfrage: eine Geste, die nur eine
    // Taste annimmt, kann eine andere nicht versehentlich schlucken -
    // und der Linksklick soll beim Knopf bleiben.
    const geste = new Gtk.GestureClick({ button: 3 })
    geste.connect("pressed", () => {
      const eintraege: MenueEintrag[] = []
      if (info) {
        eintraege.push({
          symbol: ICONS.open,
          text: _("Open"),
          tun: () => starte(info),
        })
      }
      // DER PUNKT, DER SEIT DEM 21.08.2026 HIER STEHT
      //
      //     BESTELLT, woertlich: "rechtsklick auf ags home icons 'zum
      //     dock hinzufügen' und 'entfernen von home'. das gleiche muss
      //     bei der dock auch funktionieren, weil ich nicht jedes icon
      //     auf der dock oder auf dem home haben will."
      //
      //     Der letzte Halbsatz ist die Begruendung: Fuss und Home sind
      //     zwei getrennte Auswahlen. Ohne diesen Punkt liesse sich ein
      //     Symbol nur in EINE Richtung bewegen.
      //
      //     Der Auftrag zum Home hat ihn am 20.08.2026 weggelassen, weil
      //     er "die dritte Abschrift von bruecke()" gebraucht haette.
      //     Er braucht sie nicht mehr: `settings.py dock add|remove`
      //     macht Lesen, Rechnen und Schreiben in einem Prozess, und
      //     dieses Fenster ruft es ueber dasselbe Modul wie alles
      //     andere.
      eintraege.push(dockPunkt(platz.icon.name))
      eintraege.push({
        // Der Schreibtisch und nicht mehr das Minus - siehe die Regel
        // bei ICONS: eine Zeile darueber kann jetzt "Vom Dock
        // entfernen" stehen, und zwei Minus mit zwei Wirkungen sind
        // genau der Bedienfehler, den ags-dock.template fuer sein
        // Kreuz schon einmal aufgeschrieben hat.
        symbol: ICONS.home,
        text: _("Remove from Home"),
        // OHNE EIGENES NEUZEICHNEN, seit dem 21.08.2026: die Aenderung
        // kommt ueber die Ueberwachung der Einstellungsdatei zurueck,
        // genau wie eine Aenderung aus dem Fuss oder aus dem Starter.
        // Ein Aufruf hier waere ein ZWEITER Weg zum selben Neuzeichnen -
        // und der eine, den nur der eigene Schreibvorgang nimmt, waere
        // der einzige, der je gepflegt wuerde.
        tun: () => void homeRemove(platz.icon.name),
      })
      zeigeMenue(knopf, eintraege)
    })
    knopf.add_controller(geste)
  }

  /** Der Punkt, der dieses Programm an den Fuss heftet - oder abnimmt.
   *
   * ER SCHLAEGT UM UND WIRD NICHT AUSGEGRAUT
   *     Drei Antworten waren moeglich auf "was, wenn es schon im Fuss
   *     steht": den Punkt trotzdem zeigen (er taete nichts - Spec §7.4
   *     verbietet genau das), ihn ausblenden (ein Rechtsklick, der mal
   *     einen Punkt hat und mal nicht), oder die Gegenrichtung
   *     anbieten.
   *
   *     Die dritte ist die einzige, die immer etwas sagt, und sie ist
   *     nicht erfunden: der Starter traegt seit dem 20.08.2026 genau
   *     diesen Umschlag (43b8b25), und der Fuss traegt beide Haelften
   *     unter denselben zwei Namen. Ausgegraut gibt es in diesem Haus
   *     ueberhaupt nicht - der Kopf von ags-dock.template sagt es fuer
   *     seinen Fall: "eine fehlende Anwendung im Fuss bekommt keinen
   *     ausgegrauten Knopf".
   *
   * `dockNamen` ist der Stand, den DIESE Sitzung zuletzt gelesen hat -
   * frisch gehalten von derselben Ueberwachung, die auch die Symbole
   * frisch haelt (beobachteDock()). Ein Lesevorgang beim Aufklappen
   * waere ein Menue, das 40 ms auf sich warten laesst.
   */
  function dockPunkt(name: string): MenueEintrag {
    if (dockNamen.includes(name)) {
      return {
        symbol: ICONS.unpin,
        text: _("Remove from dock"),
        tun: () => void dockRemove(name),
      }
    }
    return {
      symbol: ICONS.pin,
      text: _("Add to dock"),
      tun: () => void dockAdd(name),
    }
  }

  function rechtsklickAufDieFlaeche(fixed: Gtk.Fixed): void {
    // Die Flaeche wird beim Aufruf noch gebaut; welche es ist, steht
    // erst danach in `flaechen`. Nachgeschlagen wird deshalb ERST BEIM
    // KLICK und ueber das Gitter, an dem die Geste haengt - ein
    // Verweis, der beim Bauen festgehalten wuerde, zeigte auf ein
    // halbfertiges Objekt.
    const meine = () => flaechen.find(f => f.fixed === fixed)
    const geste = new Gtk.GestureClick({ button: 3 })
    geste.connect("pressed", (_g: any, _n: number, x: number, y: number) => {
      // Am ZEIGERPUNKT und nicht in der Mitte der Flaeche: die Flaeche
      // ist der ganze Schirm, ein Menue in ihrer Mitte klappte weit weg
      // von der Stelle auf, an der geklickt wurde.
      const punkt = new Gdk.Rectangle()
      punkt.x = Math.round(x)
      punkt.y = Math.round(y)
      punkt.width = 1
      punkt.height = 1

      // VIER PUNKTE, UND JEDER EINZELNE IST GEBAUT
      //
      //     Der Wunsch war "eine app spawnen". Der erste Punkt ist
      //     woertlich das - derselbe Starter, den SUPER+SPACE und der
      //     Knopf unten rechts oeffnen, ueber dieselbe Funktion und
      //     nicht ueber einen zweiten Weg dorthin.
      //
      //     Die drei anderen sind das, was ein Rechtsklick auf den
      //     Schreibtisch sonst noch beantworten koennen muss: die
      //     Symbole aufraeumen, die Tapete wechseln, die Einstellungen
      //     oeffnen. Mehr steht bewusst nicht darin - ein Menuepunkt,
      //     der nichts tut, ist schlechter als keiner.
      zeigeMenue(fixed, [
        {
          symbol: ICONS.starter,
          text: _("Open application launcher"),
          tun: () => oeffneDenStarter(),
        },
        {
          symbol: ICONS.tidy,
          text: _("Tidy up icons"),
          tun: () => {
            const flaeche = meine()
            if (flaeche) raeumeAuf(flaeche)
          },
        },
        {
          symbol: ICONS.wallpaper,
          text: _("Choose wallpaper"),
          tun: () => toggleByName("wallpaper"),
        },
        {
          symbol: ICONS.settings,
          text: _("Settings"),
          tun: () => toggleByName("settings"),
        },
      ], punkt)
    })
    fixed.add_controller(geste)
  }

  /** Alle Symbole von vorn durchzaehlen und die Belegung SPEICHERN.
   *
   * Der einzige Punkt dieses Menues, der die Einstellungsdatei aendert -
   * und er tut es ausdruecklich: "aufraeumen" heisst, dass es danach so
   * bleibt. Ein Aufraeumen, das nur die Anzeige umlegt, waere beim
   * naechsten Anmelden wieder weg.
   */
  function raeumeAuf(flaeche: Flaeche): void {
    const { zeilen } = gitter(
      flaeche.window.get_width(), flaeche.window.get_height())
    if (!flaeche.gelegt.length) return

    // AUF DEM SCHIRM, AUF DEM GEKLICKT WURDE, und das ist die einzige
    // Wahl, die keine Frage offenlaesst: aufgeraeumt wird nach DEM
    // Gitter, das der Nutzer gerade vor sich hat. Bei einem schmaleren
    // zweiten Schirm ordnet sich dieselbe Liste dort in mehr Spalten -
    // das ist dieselbe Anordnung in einem anderen Gitter und kein
    // zweiter Zustand.
    //
    // Von der GEZEICHNETEN Belegung aus und nicht von der gespeicherten:
    // aufgeraeumt wird, was er SIEHT. flaeche.gelegt steht bereits in
    // der Reihenfolge, in der die Symbole liegen (erst die mit eigener
    // Zelle, dann die aufgefuellten), also ist "von vorn durchzaehlen"
    // genau das, was das Wort verspricht.
    const geordnet = flaeche.gelegt.map((platz, stelle) => ({
      name: platz.icon.name,
      col: Math.floor(stelle / zeilen),
      row: stelle % zeilen,
    }))
    // Ohne eigenes Neuzeichnen - die Ueberwachung der Einstellungsdatei
    // bringt die neue Belegung zurueck, genau wie bei jedem anderen
    // Schreiber. Siehe den Punkt "Vom Home entfernen" weiter oben.
    void homeSet(geordnet)
  }

  // ===================================================================
  // DAS ZIEHEN
  // ===================================================================

  /** Ein Symbol an den Zeiger haengen.
   *
   * Gtk.DragSource mit einer Zeichenkette als Fracht - dem NAMEN und
   * nicht der Stelle in der Liste. Eine Stelle waere eine Zahl, die
   * zwischen dem Aufnehmen und dem Ablegen veralten kann (ein zweiter
   * Schreiber, ein Neuzeichnen); ein Name bleibt derselbe Name.
   */
  function ziehbar(knopf: Gtk.Widget, platz: Gelegt): void {
    const quelle = new Gtk.DragSource({ actions: Gdk.DragAction.MOVE })
    quelle.connect("prepare", () =>
      Gdk.ContentProvider.new_for_value(platz.icon.name))
    quelle.connect("drag-begin", () => knopf.add_css_class("dragging"))
    quelle.connect("drag-end", () => knopf.remove_css_class("dragging"))
    knopf.add_controller(quelle)
  }

  /** Die Flaeche nimmt ein gezogenes Symbol an - in DER Zelle, auf der
   * es losgelassen wurde.
   *
   * EINE BELEGTE ZELLE NIMMT NICHTS AN, und das ist eine Entscheidung.
   * Zwei Symbole auf einer Zelle waeren ein Stapel, den man nicht mehr
   * auseinandernehmen kann; ein Tausch waere eine Bewegung, die der
   * Nutzer nicht angefasst hat. Das Symbol bleibt dann, wo es war -
   * sichtbar, und ohne dass etwas geschrieben wird.
   */
  function annahme(flaeche: Flaeche): void {
    // GObject.TYPE_STRING, weil die Quelle oben eine Zeichenkette
    // anbietet (Gdk.ContentProvider.new_for_value mit dem Namen). Quelle
    // und Ziel muessen sich ueber den Typ einig sein - sonst meldet der
    // Compositor beim Ablegen gar nichts, und das Ziehen sieht aus, als
    // waere es abgelehnt worden.
    const ziel = Gtk.DropTarget.new(GObject.TYPE_STRING, Gdk.DragAction.MOVE)
    ziel.connect("drop", (_t: any, wert: any, x: number, y: number) => {
      const name = String(wert)
      const { spalten, zeilen } = gitter(
        flaeche.window.get_width(), flaeche.window.get_height())
      // Der Rand geht ab, bevor durch die Zellbreite geteilt wird -
      // dieselbe Rechnung wie beim Legen, nur rueckwaerts. Ohne ihn
      // laege das Symbol beim Ablegen um eine knappe Zelle zu weit oben
      // links.
      const col = Math.min(spalten - 1,
                           Math.max(0, Math.floor((x - EDGE_GAP) / CELL)))
      const row = Math.min(zeilen - 1,
                           Math.max(0, Math.floor((y - EDGE_GAP) / CELL)))

      const besetzt = flaeche.gelegt.some(
        p => p.col === col && p.row === row && p.icon.name !== name)
      if (besetzt) {
        console.log(
          `Home: Zelle ${col},${row} ist belegt - "${name}" bleibt liegen`)
        return false
      }

      // Die GESAMTE Belegung wird geschrieben und nicht nur das eine
      // Symbol: was heute ersatzweise liegt (weil seine Zelle auf diesem
      // Schirm fehlt), stuende sonst weiter ohne Zelle in der Datei und
      // spraenge beim naechsten Zeichnen woandershin. Wer EIN Symbol
      // ablegt, legt damit die Anordnung fest, die er gerade sieht.
      const neu = flaeche.gelegt.map(p => p.icon.name === name
        ? { name, col, row }
        : { name: p.icon.name, col: p.col, row: p.row })
      void homeSet(neu)
      return true
    })
    flaeche.fixed.add_controller(ziel)
  }

  // Jede Flaeche nimmt ein gezogenes Symbol an - auf jedem Schirm, weil
  // auf jedem Schirm Symbole liegen. GERUFEN WIRD DAS OBEN, beim Bauen
  // der Flaeche: seit dem 01.09.2026 kann eine spaeter dazukommen, und
  // eine Schleife an dieser Stelle liefe fuer sie nie.

  // ===================================================================
  // LESEN UND NEU ZEICHNEN
  // ===================================================================

  /** Was auf dem Home liegt, ist neu gelesen worden. */
  function uebernimm(gelesen: HomeIcon[]): void {
    // NUR NEU ZEICHNEN, WENN ES ETWAS ZU ZEICHNEN GIBT - seit dem
    // 21.08.2026, und das ist der Preis der Ueberwachung: dieser
    // Rueckruf laeuft jetzt auch nach dem EIGENEN Schreibvorgang (siehe
    // beobachteHome() in utils/user-settings.ts) und nach jeder
    // Aenderung, die gar nicht das Home betrifft - eine Farbe, eine
    // Groesse, eine Anheftung. Ohne diesen Vergleich baute das Home bei
    // jeder davon jeden Knopf neu, mitsamt Ziehquelle und Menuegeste,
    // und zwar mitten unter dem Zeiger des Nutzers.
    const wie = JSON.stringify(gelesen)
    if (wie === gezeichnet) return
    gezeichnet = wie
    icons = gelesen
    // Neu einlesen heisst: es kann sich etwas geaendert haben, auch an
    // den installierten Anwendungen. Der Zwischenspeicher faellt
    // deshalb hier und nur hier - bei einer blossen Groessenaenderung
    // waere er ein zweites Mal aufzustellen, ohne dass sich etwas
    // geaendert haben koennte.
    verwirfIndex()
    zeichne()
  }

  // Neu zeichnen, wenn sich die Flaeche aendert - genau der Fall aus
  // Messung 4: das Dock faehrt ein oder aus, die Leiste kommt oder geht,
  // ein Schirm wechselt seine Aufloesung. Ohne diesen Rueckruf blieben
  // die Symbole in einem Gitter stehen, das es nicht mehr gibt.
  //
  // AN DER Gdk.Surface UND NICHT AM FENSTER, UND DAS IST GEMESSEN
  //     Hier stand `window.connect("notify::width", ...)`. Das Home
  //     blieb daraufhin LEER, ohne eine einzige Fehlermeldung -
  //     gefunden am 20.08.2026 von tests/render/test_home.py::
  //     test_das_home_zeichnet_wirklich_symbole, 0 geaenderte
  //     Bildpunkte.
  //
  //     Der Grund, GEPRUEFT per Introspektion am selben Tag:
  //
  //         Gtk.Window.list_properties()   width: NEIN
  //                                        (nur width-request,
  //                                         default-width)
  //         Gdk.Surface.list_properties()  width: JA, height: JA
  //
  //     `get_width()` ist bei GTK4 die ZUGETEILTE Groesse und keine
  //     Eigenschaft - auf sie kann man nicht hoeren. Ein
  //     `notify::width` am Fenster ist deshalb kein Fehler, der etwas
  //     meldet: GObject nimmt den Namen an, und das Signal kommt
  //     einfach nie. Die Groesse, die der Compositor zuteilt, steht an
  //     der Gdk.Surface, und DIE meldet sie.
  //
  //     Die Surface gibt es erst nach dem Abbilden, also wird sie im
  //     "map" geholt. Dort wird auch einmal gezeichnet: beim ersten
  //     Lesevorgang ist die Flaeche noch 0x0, und zeichnen kann man erst,
  //     wenn es eine Flaeche gibt.
  //
  // Kein Zeitgeber: die Meldung kommt vom Compositor ueber GTK, und
  // zwischen zwei Aenderungen passiert nichts. Die 0.00 % im Leerlauf
  // (siehe Kopf) haengen genau daran.
  /** Die Gdk.Surface eines Fensters abhorchen, sobald es sie hat. */
  function verfolgeGroesse(window: Astal.Window): void {
    const anhaengen = () => {
      const surface = window.get_surface()
      if (!surface) {
        console.error("Home: das Fenster hat keine Flaeche - es kann seine "
                      + "Groesse nicht verfolgen")
        return
      }
      surface.connect("notify::width", () => zeichne())
      surface.connect("notify::height", () => zeichne())
      zeichne()
    }

    // SCHON ABGEBILDET ODER NOCH NICHT - BEIDE FAELLE, UND DAS IST GEMESSEN
    //
    //     Hier stand nur `window.connect("map", anhaengen)`, und das
    //     Home blieb LEER. GEMESSEN am 20.08.2026 mit einer Diagnosezeile
    //     in der erzeugten Datei:
    //
    //         DBG lies: 15
    //         DBG zeichne: 0x0 icons=15
    //         DBG zeichne: 0x0 icons=15
    //         (kein "DBG map")
    //
    //     Die Symbole waren also da, die Flaeche war 0x0, und "map" kam
    //     nie. Der Grund steht eine Bildschirmseite weiter oben: das
    //     Fenster wird mit `visible: true` GEBAUT - dieselbe Zeile, die
    //     das Dock hat -, ist beim Verlassen des Konstruktors also
    //     bereits abgebildet. Das Signal war gefallen, bevor jemand
    //     zuhoerte.
    //
    //     Ein `visible: false` mit spaeterem Einschalten haette es auch
    //     geloest und dafuer eine zweite Stelle geschaffen, an der steht,
    //     ob das Home sichtbar ist. Gefragt wird deshalb nach dem
    //     ZUSTAND statt auf das Ereignis zu warten.
    if (window.get_mapped()) anhaengen()
    else window.connect("map", anhaengen)
  }

  // GERUFEN WIRD DAS OBEN, beim Bauen der Flaeche - aus demselben
  // Grund wie annahme(): ein Schirm, der spaeter angesteckt wird, kommt
  // an einer Schleife an dieser Stelle nicht mehr vorbei, und seine
  // Flaeche bliebe leer.

  // DASS EINE FREMDE AENDERUNG HIER ANKOMMT - seit dem 21.08.2026
  //
  //     GEMELDET aus 0.1.7: "wenn ich es dort mit der dock versuche dann
  //     passiert nichts". Es galt in beide Richtungen: wer im Fuss oder
  //     im Starter etwas an den Symbolen aenderte, sah davon auf dem
  //     Home nichts, bis er sich neu anmeldete.
  //
  //     Der Grund war einfach und stand nirgends: gelesen wurde genau
  //     dreimal - beim Bauen, nach einem EIGENEN Schreibvorgang und
  //     sonst nie. Die Datei aendert sich aber auch, wenn ein anderes
  //     Fenster sie aendert.
  //
  //     Kein Zeitgeber und kein Abonnement bei einem anderen Fenster:
  //     ein Gio.FileMonitor meldet sich, statt gefragt zu werden, und
  //     erreicht damit auch den Starter, der von AGS nichts weiss. Die
  //     Messung dazu (ein Ereignis je Schreibvorgang, 0 % im Leerlauf)
  //     steht im Kopf von utils/user-settings.ts.
  //
  //     BEIDE Listen, und die zweite ist keine Zugabe: an ihr haengt,
  //     in welche Richtung der Menuepunkt zeigt (siehe dockPunkt()).
  //     Sie wird hier mitgelesen und nicht beim Aufklappen - ein Menue,
  //     das erst nach einem Unterprozess erscheint, fuehlt sich an wie
  //     eines, das haengt.
  beobachteHome(uebernimm)
  beobachteDock(pins => { dockNamen = pins })

  return { windows }
}
