 * Kurzhinweis, Fehlermeldung) und drei Abschriften irgendwann drei
 * verschiedene Namen zeigen.
 */
function benennung(name: string, info: GioUnix.DesktopAppInfo | null): string {
  return (info && info.get_display_name()) || name
}

