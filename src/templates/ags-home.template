/** Der Anwendungseintrag zu einem Namen, oder null.
 *
 * WORTGLEICH ZU entryFor() IN ags-dock.template, UND DAS IST HIER
 * VERMERKT STATT VERSCHWIEGEN
 *     Die Funktion dort ist nicht exportiert, und ags-dock.template
 *     gehoert am 20.08.2026 einem anderen Vorhaben - ein `export`
 *     nachzutragen hiesse, in einer Datei zu schreiben, in der gerade
 *     jemand anderes schreibt. Beides zusammen gehoert nach
 *     utils/apps.ts, neben terminalCommand(); das ist die Nacharbeit,
 *     die im Bericht zu dieser Aufgabe steht.
 *
 *     Bis dahin ist es EINE Abschrift mit einem Zeiger darauf und nicht
 *     eine zweite Antwort: die Namen kommen aus derselben Quelle
 *     (settings.py, gegen dieselbe pinnable()-Liste geprueft), also
 *     kann diese Suche gar nicht zu einem anderen Ergebnis kommen als
 *     die des Docks.
 */
// Die Exec-Basisnamen aller Anwendungseintraege dieser Maschine, EINMAL
// aufgestellt.
//
// WARUM ES DIESEN ZWISCHENSPEICHER GIBT - GEMESSEN am 20.08.2026
//     Ohne ihn durchsucht jedes Symbol die ganze Liste selbst. Gemessen
//     auf dieser Maschine (138 Eintraege):
//
//         ein Gio.AppInfo.get_all()                     7.1 ms
//         fuenfzehn Durchlaeufe, wie unten gebraucht   55.3 ms
//
//     Fuenfzehn Symbole sind die ausgelieferte Auswahl, und gezeichnet
//     wird nicht einmal: beim Abbilden, und danach bei jeder
//     Groessenaenderung (Leiste meldet sich an, Dock meldet sich an,
//     Dock faehrt ein). Aus 55 ms werden so schnell ein paar hundert -
//     mitten in der Hauptschleife, waehrend der Rest der Oberflaeche
//     hochfaehrt.
//
//     Aufgefallen ist es an einer FREMDEN Messung: tests/render/
//     test_geometry.py wartet drei Sekunden auf den Zeigergrund eines
//     Leistenmoduls und bekam ihn nicht mehr.
//
// null heisst "noch nicht aufgestellt". Aufgestellt wird beim ersten
// Bedarf und danach neu, wenn das Home neu einliest - eine Anwendung,
// die waehrenddessen dazukommt, ist genau der Fall, in dem ohnehin neu
// gelesen wird.
let execIndex: Map<string, GioUnix.DesktopAppInfo> | null = null

function verwirfIndex(): void {
  execIndex = null
}

function eintragFuer(program: string): GioUnix.DesktopAppInfo | null {
  const direct = GioUnix.DesktopAppInfo.new(`${program}.desktop`)
  if (direct) return direct

  if (execIndex === null) {
    execIndex = new Map()
    for (const info of Gio.AppInfo.get_all()) {
      const executable = info.get_executable()
      if (!executable) continue
      // basename, weil eine Exec-Zeile auch /usr/bin/<name> sein darf.
      const name = executable.split("/").pop()
      // Der ERSTE gewinnt, wie in der Schleife vorher: sie gab beim
      // ersten Treffer zurueck. `set` ohne diese Abfrage liesse den
      // letzten gewinnen - eine andere Anwendung als bisher, und zwar
      // lautlos.
      if (name && !execIndex.has(name)) {
        execIndex.set(name, info as GioUnix.DesktopAppInfo)
      }
    }
  }
  return execIndex.get(program) ?? null
}

/** Eine Anwendung starten - ueber ihren Eintrag, nicht ueber einen Namen.
 *
 * terminalCommand() kommt AUS ags-dock.template und wird nicht
 * nachgebaut: dort steht die Messung, warum ein Eintrag mit
 * `Terminal=true` ueber den Compositor und nicht ueber GIO startet
 * (GLib sucht in einer festen Liste bekannter Terminals, und kitty steht
 * nicht darin). Zwei Antworten auf "womit startet ein Konsoleneintrag"
 * waeren eine, die beim naechsten Mal vergessen wird.
 */
function starte(info: GioUnix.DesktopAppInfo): void {
  const terminal = terminalCommand(info)
  if (terminal) Hyprland.dispatch(`exec ${terminal}`)
  else info.launch([], null)
}

