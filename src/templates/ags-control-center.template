import GLib from "gi://GLib"
// Fuer JEDE Beschriftung, deren Text aus einem Skript kommt.
//
// Hier stand "nur fuer den EINEN Titel, der beliebig lang werden kann"
// - gemeint war die Wiedergabezeile. Der Satz war richtig und die Liste
// zu kurz: ein Druckerstatus, ein WLAN-Name, eine Datenschutzzeile mit
