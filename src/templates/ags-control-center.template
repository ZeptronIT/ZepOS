//
// pamixer BLEIBT der Weg zum SCHREIBEN (stumm schalten, Regler ziehen).
// Dass Lesen und Schreiben damit zwei Werkzeuge sind, ist geprueft und
// nicht angenommen: GEMESSEN am 22.08.2026 gegen eine eigene, private
// PipeWire-Instanz mit eigenem pipewire-pulse - `pamixer --set-volume`
// auf 10/25/50/75/100 % gab bei `wpctl` genau 10/25/50/75/100 %. Die
// beiden rechnen auf dieser PipeWire-Fassung (1.6.8) in derselben
// Skala; eine Kurve dazwischen haette den Regler nach jedem Zug
// springen lassen.

// Die Helligkeit
async function getBrightness(): Promise<number> {
  try {
    const output = await execAsync("brightnessctl -m")
    const parts = output.split(",")
    return parseInt(parts[3]?.replace("%", "")) || 100
  } catch {
    return 100
  }
}

// Wie viele Hilfsskripte es gibt
//
// ZEPOS_USER_ROOT und nicht ~/.local/bin: der Generator schreibt die
// Hilfsskripte nach $ZEPOS_USER_ROOT/helpers, und ~/.local/bin/helpers
// legt in diesem Projekt niemand an. Die Zeile las deshalb, solange es
// sie gibt, "Helper Scripts (0)" auf Maschinen mit sieben davon -
// dasselbe Verzeichnis, das der Waybar-Baustein falsch hatte, im
// zweiten Leser.
async function getHelpersCount(): Promise<number> {
  try {
    const output = await execAsync(`bash -c "ls -1 ${ZEPOS_USER_ROOT}/helpers 2>/dev/null | grep -v backup | wc -l"`)
    return parseInt(output.trim()) || 0
  } catch {
    return 0
  }
}

