// endet sie hier bei STYLE_MEASURE_LINE Zeichen mit drei Punkten.
//
// BERICHTIGT am 18.08.2026 (Task D): hier stand der Platzhalter noch
// mit geschweiften Klammern - genau der Fehler, den Task C an
// ags-kit.template:60 gemeldet hat (template_processor.py ersetzt ihn
// auch in einem Kommentar, still, durch die skalierte Pixelzahl). Der
// Fund lag diesmal im eigenen Auftragsfenster, darum repariert statt
// nur gemeldet.
import Pango from "gi://Pango"
import { createOverlayWindow, OverlayWidget } from "../utils/overlay"
import { _, format } from "../utils/i18n"
import { zepButton, ZepRolle } from "../utils/kit"

const HOME = GLib.get_home_dir()
// Das Widget laeuft eigenstaendig unter AGS und kann paths.py nicht
// importieren, deshalb wird die Nutzerwurzel hier aufgeloest.
// GLib.getenv gibt null zurueck, wenn nichts gesetzt ist; das || macht
// daraus die dokumentierte Vorgabe.
const CONFIG_HOME = GLib.getenv("XDG_CONFIG_HOME") || `${HOME}/.config`
const ZEPOS_USER_ROOT = GLib.getenv("ZEPOS_USER_ROOT") || `${CONFIG_HOME}/zepos`
const WINDOW_NAME = "control-center"
const UPDATE_INTERVAL = 3000

// Die Skripte
//
// Die drei letzten sind DIESELBEN, die die Leiste ruft. Das ist der
// Grund, aus dem sie mehr Felder ausgeben als ein Leistenmodul liest:
// die Leiste zeigt, DASS etwas ist, dieses Fenster zeigt, WAS. Zwei
// Skripte fuer dieselbe Frage waeren zwei Messzeitpunkte und damit zwei
// Antworten, die einander auf demselben Bildschirm widersprechen
// koennen.
const SCRIPTS = {
  network: `${HOME}/.local/bin/ags-network-scripts`,
  vpnControl: `${HOME}/.config/ags/scripts/vpn-control.sh`,
  helpersLauncher: `hyprctl hyprlaunch:helpers`,
  privacy: `${CONFIG_HOME}/ags/scripts/privacy.sh`,
  media: `${CONFIG_HOME}/ags/scripts/media.sh`,
  updates: `${CONFIG_HOME}/ags/scripts/updates.sh`,
  // Die zwei aus dem Abschnitt SCHREIBTISCH, die einen TEXT zeigen und
  // nicht nur ein Fenster oeffnen. Wieder DIESELBEN Skripte, die auch
  // die Leiste ruft, wenn man sie dort zuschaltet - aus demselben
  // Grund wie oben: zwei Skripte fuer eine Frage waeren zwei
  // Messzeitpunkte und zwei Antworten.
  weather: `${CONFIG_HOME}/ags/scripts/weather.sh`,
  clocks: `${CONFIG_HOME}/ags/scripts/clocks.sh`,
  hardware: `${CONFIG_HOME}/ags/scripts/hardware-monitor.py`,
  floating: `${HOME}/.local/bin/floating-window-manager load-layout`,
  btop: "kitty -e btop",
}

// Die Zeichen
//
// FUENF SIND AM 17.08.2026 GEGANGEN: wifi, wifiOff, bluetooth, network
// und palette.
//
//     Die ersten drei mit den Zeilen, die sie trugen - Netz und
//     Bluetooth werden seit heute OBEN bedient (siehe den Kopf des
//     Abschnitts NETZ & VERBINDUNGEN unten). palette mit der Zeile
//     "Style Editor", die aus demselben Grund gegangen ist.
//
//     `network` war schon vorher tot: die Tabelle nannte es, und keine
//     Zeile dieser Datei hat es je gelesen. Gezaehlt am 17.08.2026,
//     `grep -c "ICONS\.network\b"` gab 0.
const ICONS = {
  settings: "{{ICON_SETTINGS}}",
  // Die vier, die am 17.08.2026 hier gestrichen waren und am selben Tag
  // zurueckgekommen sind - siehe den Abschnitt NETZ & VERBINDUNGEN.
  wifi: "{{ICON_WIFI}}",
  wifiOff: "{{ICON_WIFI_OFF}}",
  bluetooth: "{{ICON_BLUETOOTH}}",
  palette: "{{ICON_PALETTE}}",
  volume: "{{ICON_VOLUME_HIGH}}",
  volumeMute: "{{ICON_VOLUME_MUTE}}",
  mic: "{{ICON_MIC}}",
  micMute: "{{ICON_MIC_MUTE}}",
  brightness: "{{ICON_BRIGHTNESS_HIGH}}",
  vpn: "{{ICON_VPN_CONNECTED}}",
  vpnOff: "{{ICON_VPN_DISCONNECTED}}",
  ip: "{{ICON_IP}}",
  shutdown: "{{ICON_SHUTDOWN}}",
  reboot: "{{ICON_REBOOT}}",
  suspend: "{{ICON_SUSPEND}}",
  lock: "{{ICON_LOCK}}",
  logout: "{{ICON_LOGOUT}}",
  printer: "{{ICON_PRINTER}}",
  watchdog: "{{ICON_WATCHDOG}}",
  helpers: "{{ICON_HELPERS}}",
  launch: "{{ICON_LAUNCH}}",
  power: "{{ICON_POWER}}",
  recording: "{{ICON_RECORDING}}",
  webcam: "{{ICON_WEBCAM}}",
  music: "{{ICON_MUSIC}}",
  play: "{{ICON_PLAY}}",
  pause: "{{ICON_PAUSE}}",
  next: "{{ICON_MEDIA_NEXT}}",
  previous: "{{ICON_MEDIA_PREV}}",
  displays: "{{ICON_MONITOR_MULTIPLE}}",
  update: "{{ICON_UPDATE}}",
  // Die sieben aus dem Abschnitt SCHREIBTISCH - siehe dort, warum es
  // ihn seit dem 12.08.2026 gibt.
  clock: "{{ICON_CLOCK}}",
  weather: "{{ICON_WEATHER_PARTLY_CLOUDY}}",
  keyboard: "{{ICON_KEYBOARD}}",
  floating: "{{ICON_WINDOW_FLOATING}}",
  wallpaper: "{{ICON_WALLPAPER}}",
  disk: "{{ICON_DISK}}",
