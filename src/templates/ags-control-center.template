/** Das Kontrollzentrum - seit Aufgabe 6 (18.08.2026) die SCHALE selbst.
 *
 * Frueher ein eigenes Aufklappfenster (createOverlayWindow), jetzt der
 * erste - und bislang einzige - Aufrufer von createShellWindow()
 * (Aufgabe 5, ags-overlay-utils.template): eine Seitenleiste links,
 * eine Seite rechts. Was dieses Fenster VORHER zeigte, ist unveraendert
 * die Seite "general" unter SYSTEM - nichts ist weggenommen, siehe die
 * Zusage vom 17.08.2026 ("alle funktionen auch im control panel aber
 * auch ausserhalb"). Netzwerk, Bluetooth und VPN bekommen ihre
 * Eintraege unter VERBINDUNGEN in den Aufgaben 7-9. Ton und Anzeige
 * unter SYSTEM standen bis Aufgabe 17 (19.08.2026) noch auf demselben
 * Umzugshinweis (stubSeite(), Aufgabe 6) - ein Eintrag, der ins Leere
 * fuehrt, ist schlimmer als einer, der sagt, was los ist. Seit Aufgabe
 * 17 sind auch sie echte Seiten: soundSeite traegt Lautstaerke und
 * Mikrofon, displaySeite die Helligkeit - beide Regler standen vorher
 * auf "general" (siehe der Kommentar bei soundSeite/displaySeite unten
 * fuer die Zaehlung, die belegt, dass dabei kein Bedienelement verloren
 * geht). stubSeite() selbst ist mit diesem Umzug gegangen: kein Aufrufer
 * blieb (Rule 14, totes Werkzeug wird geloescht, nicht behalten).
 *
 * `toggle` oeffnet ein anderes Aufklappfenster DIESES Prozesses - genau
 * die Funktion, die auch die Leiste bekommt (toggleByName in
 * ags-config.template). Sie wird hereingereicht und nicht importiert,
 * aus demselben Grund wie dort: die Fenster entstehen in app.ts, und
 * ein Widget, das seine Geschwister selbst nachschlaegt, braucht eine
 * zweite Liste davon, welche es gibt.
 *
 * Sie kam am 12.08.2026 dazu, mit dem Abschnitt SCHREIBTISCH: drei
 * seiner Zeilen oeffnen ein Fenster, das es laengst gibt und zu dem von
 * der Leiste kein Weg mehr fuehrt.
 */
export default function ControlCenter(
    toggle: (name: string) => void = () => {}): ShellWidget {
  // Die Bausteine, die sich aendern
  let networkIcon: Gtk.Label
  let networkLabel: Gtk.Label
  let btLabel: Gtk.Label
  let ipRow: Gtk.Box
  let ipLabel: Gtk.Label
  let vpnIcon: Gtk.Label
  let vpnLabel: Gtk.Label
  let printerLabel: Gtk.Label
  let watchdogLabel: Gtk.Label
  let watchdogIcon: Gtk.Label
  let helpersLabel: Gtk.Label
  let privacyBox: Gtk.Box
  let privacyMicRow: Gtk.Box
  let privacyMicLabel: Gtk.Label
  let privacyCamRow: Gtk.Box
  let privacyCamLabel: Gtk.Label
  let mediaRow: Gtk.Box
  let mediaIcon: Gtk.Label
  let mediaLabel: Gtk.Label
  let mediaPlayLabel: Gtk.Label
  let updateRow: Gtk.Box
  let updateLabel: Gtk.Label
  let updateBtn: Gtk.Button
  let weatherRow: Gtk.Box
  let weatherLabel: Gtk.Label
  let clocksRow: Gtk.Box
  let clocksLabel: Gtk.Label
  let hardwareLabel: Gtk.Label

  // Was der Knopf der Aktualisierungszeile gerade tut.
  //
  // Er haengt am ZUSTAND und nicht am Thema, und das ist der ganze
  // Unterschied zwischen einem Knopf und einem Bedienelement: "es steht
  // etwas an" hat vier Auspraegungen, und drei von ihnen brauchen
  // verschiedene Befehle. Ein Knopf, der immer `zepos-update` ruft,
  // taete in zwei von vier Faellen nachweislich das Falsche - bei einer
  // veralteten Konfiguration hilft nur neu erzeugen, und die
  // Arch-Aktualisierungen fasst update.scope "zepos" mit Absicht nicht
  // an.
  let updateAction = ""
  // Die Seite, die der Knopf statt eines Befehls oeffnet - leer, solange
  // er einen Befehl hat. Zwei Felder und kein "der Befehl faengt mit
  // settings: an": ein Befehl und eine Seite sind zwei Dinge, und eine
  // Zeichenkette, die beides sein kann, wird als erstes verwechselt.
  let updateSeite = ""

  // Alles neu einlesen
  /** Die eine Zeilenbeschriftung dieses Fensters.
   *
   * Die vier Angaben gehoeren zusammen - hexpand, xalign, ellipsize,
   * max_width_chars -, und tests/src/test_modal_second_open.py haelt
   * fest, dass sie GENAU EINMAL ausgeschrieben stehen. Der Grund steht
   * dort: am 17.08.2026 standen sie neunmal da und waren zweimal
   * vollstaendig.
   *
   * SIE STAND BIS ZUM 02.09.2026 IN generalSeite und war damit nur der
   * HALBEN Datei zugaenglich. Als die Geraetewahl im Tonabschnitt eine
   * Beschriftung brauchte, konnte sie diese hier nicht rufen - andere
   * Seite, anderer Gueltigkeitsbereich - und schrieb die vier Angaben
   * ein zweites Mal aus. Der Test wurde rot, und er hatte recht: nicht
   * die neue Zeile war falsch, sondern der Ort dieser Funktion.
   *
   * KEIN PARAMETER FUER DIE KLASSE, und das ist gemessen und nicht
   * bequem: `.cc-label` und `.zep-row-title` sind in ags-style.template
   * WORTGLEICH deklariert - beide `font-size: {{STYLE_FONT_BODY}};
   * color: $text;`. Ein Parameter haette also zwei Namen fuer dieselbe
   * Schrift eingefuehrt und obendrein die Unterschrift dieser Funktion
   * geaendert, auf die sich der Test namentlich beruft. Laufen die
   * beiden Klassen eines Tages auseinander, ist DAS der Moment fuer den
   * Parameter - nicht vorher.
   */
  const ccLabel = (text: string): Gtk.Label => {
    const label = new Gtk.Label({
      label: text, hexpand: true, xalign: 0,
      ellipsize: Pango.EllipsizeMode.END,
      max_width_chars: {{STYLE_MEASURE_LINE}},
    })
    label.add_css_class("cc-label")
    return label
  }

  const updateDisplay = async () => {
    // Das Netz-Zeichen und die Bluetooth-Zeile - status.sh, EIN Aufruf
    // fuer beide, damit sie denselben Messzeitpunkt teilen (siehe
    // SCRIPTS.status oben, wo auch steht, was hier vorher stand).
    //
    // .text ist bei network der Zeichensatz-Buchstabe (network_module())
    // - dasselbe Zeichen, das die Leiste zeigt. Bei bluetooth ist .text
    // dagegen Zeichen-plus-Zahl (fuer btIcon ungeeignet, den diese Zeile
    // nicht anfasst) und .tooltip der SATZ, den bluetooth_module()
    // daneben schreibt ("Bluetooth ist ausgeschaltet", Geraetenamen,
    // "Bluetooth an, nichts verbunden") - genau die Auskunft, die
    // btLabel als Text tragen soll.
    const sharedStatus = await readJson(SCRIPTS.status)
    const networkGlyph = typeof sharedStatus.network?.text === "string"
      ? sharedStatus.network.text : ""
    const bluetoothText = typeof sharedStatus.bluetooth?.tooltip === "string"
      ? sharedStatus.bluetooth.tooltip : ""

    // Netz
    networkIcon.set_text(networkGlyph || ICONS.wifiOff)
    networkLabel.set_text(await getNetworkStatus())

    // Die Adresse
    const ip = await getIpAddress()
    ipLabel.set_text(ip)
    ipRow.set_visible(ip.length > 0)

    // Bluetooth
    btLabel.set_text(bluetoothText || _("Bluetooth"))

    // VPN
    const vpnInfo = await getVpnInfo()
    const vpnConnected = await isVpnConnected()
    vpnLabel.set_text(format(_("VPN: {status}"), { status: vpnInfo }))
    vpnIcon.set_text(vpnConnected ? ICONS.vpn : ICONS.vpnOff)
    if (vpnConnected) {
      vpnIcon.add_css_class("connected")
      vpnIcon.remove_css_class("disconnected")
    } else {
      vpnIcon.remove_css_class("connected")
      vpnIcon.add_css_class("disconnected")
    }

    // Ton und Helligkeit: SEIT AUFGABE 17 (19.08.2026) NICHT MEHR HIER
    //
    // Lautstaerke, Mikrofon und Helligkeit lasen bis heute hier ihren
    // Zustand - dieselben drei Regler standen auf "general". Sie sind
    // mit Aufgabe 17 auf ihre eigenen Seiten umgezogen (soundSeite,
    // displaySeite, beide unten in dieser Datei) und lesen ihren
    // Zustand seither dort, ueber ihre eigene, istAktiv-gegatete
    // Schliessung - derselbe Grund, aus dem Bluetooth/Netzwerk/VPN ihren
    // eigenen Takt fuehren und nicht den von "general" (Aufgabe 15/16,
    // "1.2 Was stattdessen real und reparaturwuerdig war"): ein Takt,
    // der fuer eine Seite arbeitet, die gerade niemand sieht, ist
    // unnoetige Arbeit bei jedem Oeffnen der Schale.
    //
    // getBrightness() bleibt eine module-weite Funktion (siehe oben) -
    // displaySeite ruft sie, keine zweite Fassung.
    //
    // getVolumeStatus()/getMicStatus() STANDEN HIER UND SIND WEG -
    // 22.08.2026, Aufgabe 64. Sie fragten `pamixer --get-volume`, also
    // IMMER das Vorgabegeraet, und konnten deshalb nach einem
    // Geraetewechsel gar nichts anderes zeigen als die Vorgabe. Die
    // Ton-Seite liest ihre Zahlen seither aus audio-devices.sh, das JE
    // GERAET antwortet - und damit aus derselben Antwort, die sagt,
    // welches Geraet ueberhaupt gewaehlt ist. Zwei Quellen fuer eine
    // Zahl waeren zwei Messzeitpunkte gewesen; genau daran haette der
    // Regler nach dem Wechsel gelogen. Kein Aufrufer blieb uebrig
    // (`grep -c` ueber diese Datei gab 0), also geloescht statt als
    // veraltet markiert - Regel 14.

    // Systemdienste
    printerLabel.set_text(await getPrinterStatus())
    watchdogLabel.set_text(format(_("Network watchdog: {status}"),
                                  { status: await getWatchdogStatus() }))
    const wdClass = await getWatchdogClass()
    if (wdClass.includes("active")) {
      watchdogIcon.add_css_class("active")
    } else {
      watchdogIcon.remove_css_class("active")
    }
    helpersLabel.set_text(format(_("Helper scripts ({count})"),
                                 { count: await getHelpersCount() }))

    // ===== DATENSCHUTZ =====
    // Der Abschnitt zeigt sich nur, wenn er etwas zu sagen hat - und
    // jede der beiden Zeilen einzeln. Ein Abschnitt "Datenschutz" mit
    // zwei Zeilen "niemand" waere die Behauptung, hier werde dauernd
    // etwas ueberwacht.
    const privacy = await readJson(SCRIPTS.privacy)
    const listening = joined(privacy.mic)
    const watching = joined(privacy.cam)
    privacyMicLabel.set_text(listening)
    privacyCamLabel.set_text(watching)
    privacyMicRow.set_visible(listening !== "")
    privacyCamRow.set_visible(watching !== "")
    privacyBox.set_visible(listening !== "" || watching !== "")

    // ===== WIEDERGABE =====
    const media = await readJson(SCRIPTS.media)
    const status = typeof media.status === "string" ? media.status : ""
    const artist = typeof media.artist === "string" ? media.artist : ""
    const title = typeof media.title === "string" ? media.title : ""
    const player = typeof media.player === "string" ? media.player : ""
    const heading = title || player
    mediaLabel.set_text(artist ? `${artist} – ${heading}` : heading)
    mediaIcon.set_text(status === "Playing" ? ICONS.play : ICONS.pause)
    // Der Knopf zeigt die HANDLUNG und die Zeile den ZUSTAND: was
    // laeuft, steht links, und rechts steht, was ein Klick daraus
    // macht. Beide dasselbe Zeichen tragen zu lassen hiesse, dass eines
    // von beiden luegt.
    mediaPlayLabel.set_text(status === "Playing" ? ICONS.pause : ICONS.play)
    mediaRow.set_visible(status !== "")

    // ===== AKTUALISIERUNG =====
    const updates = await readJson(SCRIPTS.updates)
    const pending = typeof updates.text === "string" ? updates.text : ""
    const detail = typeof updates.detail === "string" ? updates.detail : ""
    const kind = typeof updates.class === "string" ? updates.class : ""
    updateLabel.set_text(detail)
    updateRow.set_visible(pending !== "")

    // Ein Zustand, ein Befehl. Jeder von ihnen ist ein Programm, das
    // packaging/zepos-desktop hart mitbringt: zepos-generate und
    // zepos-update aus zepos-config, zepos-settings-gui als eigenes
    // Paket, sudo und pacman als Bedingung dafuer, dass diese Maschine
    // ueberhaupt existiert.
    if (kind.includes("updates-regenerate")) {
      updateAction = "zepos-generate --all"
      updateSeite = ""
      updateBtn.set_tooltip_text(_("Regenerate the configuration"))
    } else if (kind.includes("updates-failed")) {
      updateAction = "sudo zepos-update"
      updateSeite = ""
      updateBtn.set_tooltip_text(_("Try the update again"))
    } else if (kind.includes("updates-base")) {
      // Der volle Schritt, und er steht hier, weil update.py ihn
      // ausdruecklich dem Menschen ueberlaesst: "Die Aufstellung der
      // Basis, die jeder Lauf mitfuehrt, ist genau dafuer da, dass der
      // Nutzer den vollen Schritt bewusst tun kann." Bewusst tun kann
      // er ihn nur, wenn es einen Weg dorthin gibt.
      updateAction = "sudo pacman -Syu"
      updateSeite = ""
      updateBtn.set_tooltip_text(
        _("Update the Arch base - in the terminal, with a prompt"))
    } else if (kind.includes("updates-disabled")) {
      // KEIN Befehl, sondern eine SEITE - seit Aufgabe 32 (19.08.2026).
      // Hier stand `zepos-settings-gui --page aktualisierung`, und weil
      // updateBtn seine drei anderen Zustaende in einem Terminal
      // ausfuehrt (sie fragen nach Passwort und Bestaetigung), lief das
      // GTK-Fenster in einem kitty mit `read` dahinter. Eine Seite
      // gehoert nicht in ein Terminal; `updateSeite` fuehrt sie am
      // Befehl vorbei (siehe updateBtn weiter unten).
      updateAction = ""
      updateSeite = "settings:aktualisierung"
      updateBtn.set_tooltip_text(_("Configure the self-update"))
    } else {
      updateAction = ""
      updateSeite = ""
    }

    // ===== SCHREIBTISCH =====
    // Die drei Zeilen mit einem TEXT. Sie lesen dieselben Skripte, die
    // die Leiste ruft, wenn man die Module dort zuschaltet - siehe den
    // Kopf von SCRIPTS.
    //
    // Wetter und Zeitzonen blenden sich aus, wenn ihr Skript nichts
    // sagt: ohne eingestellten Ort gibt weather.sh einen leeren Text
    // aus, ohne eingestellte Zusatzuhr clocks.sh ebenso. Eine Zeile
    // "Wetter: -" waere die Behauptung, hier stehe etwas.
    const weather = await readJson(SCRIPTS.weather)
    const weatherText = typeof weather.text === "string" ? weather.text : ""
    weatherLabel.set_text(weatherText)
    weatherRow.set_visible(weatherText !== "")

    const clocks = await readJson(SCRIPTS.clocks)
    const clocksText = typeof clocks.text === "string" ? clocks.text : ""
    clocksLabel.set_text(clocksText)
    clocksRow.set_visible(clocksText !== "")

    // Die Hardwarezeile bleibt IMMER stehen, auch wenn das Skript
    // "No HW" sagt: dass dieser Rechner keine Sensoren meldet, ist
    // selbst die Auskunft, und der Knopf daneben oeffnet btop, der es
    // besser weiss.
    const hardware = await readJson(SCRIPTS.hardware)
    const hardwareText = typeof hardware.text === "string" ? hardware.text : ""
    hardwareLabel.set_text(hardwareText || _("Hardware"))
  }

  // ============================================================================
  // DIE SEITENLEISTE: DREI GRUPPEN (Aufgabe 6, 18.08.2026)
  // ============================================================================
  //
  // gruppenAus() in ags-overlay-utils.template baut ZepNavGruppe aus der
  // REIHENFOLGE des ersten Auftretens von seite.gruppe in config.seiten -
  // die Reihenfolge unten in `seiten` bestimmt darum die Reihenfolge in
  // der Seitenleiste: VERBINDUNGEN vor SYSTEM. EINSTELLUNGEN (Spec
  // Abschnitt 2.2/4.1) bekommt in diesem Plan bewusst KEINE Seite und
  // taucht darum in der Seitenleiste gar nicht auf - "UI-1 baut sie
  // nicht ... der Platz kostet nichts" (Spezifikation, 4.1).
  const gruppeVerbindungen = _("CONNECTIONS")
  const gruppeSystem = _("SYSTEM")

  // VERBINDUNGEN: "bluetooth", "network" und "vpn" sind seit Aufgabe 7/8/9
  // (18.08.2026) alle drei die echten, importierten Seiten - siehe die
  // Importe am Kopf dieser Datei. Ihre `gruppe` traegt denselben msgid
  // "CONNECTIONS" wie gruppeVerbindungen hier (zwei `_()`-Aufrufe auf
  // denselben msgid ergeben denselben Text; gruppenAus() gruppiert nach
  // dem TEXT), darum keine eigene Uebergabe von aussen.

  // SYSTEM: Ton und Anzeige, seit Aufgabe 17 (19.08.2026) echte Seiten -
  // vorher zeigten beide nur den Umzugshinweis aus stubSeite() (Aufgabe
  // 6). "Das Meiste ist schon gebaut, es sitzt nur an der falschen
  // Stelle" (Aufgabenblatt 17, woertlich): volumeSlider/micSlider/
  // brightnessSlider samt ihrer Mute-Knoepfe standen bis heute auf
  // "general" (Abschnitt TON UND BILD, siehe unten) - dieselben
  // Bedienelemente ziehen hier ein, keine Neuentwicklung.
  //
  // WARUM ZWEI SEITEN UND NICHT EINE GEMEINSAME "TON & ANZEIGE"
  //     Die Spezifikation (Abschnitt 2.2) fuehrt "Ton" und "Anzeige" als
  //     ZWEI eigene Sidebar-Eintraege - dieser Auftrag baut genau das
  //     nach, keine Zusammenlegung, die es dort nicht gibt.
  //
  // WARUM DER KOPF DER SOUND-SEITE ZWEI WERTE TRAEGT
  //     zepStateHeader kennt Titel und Nebenzeile, kein drittes Feld
  //     (Aufgabe 4, ags-kit.template) - "der Kopf ist der Zustand"
  //     (Spezifikation 2.2). Die Sound-Seite haelt ZWEI unabhaengige
  //     Regler (Lautstaerke, Mikrofon); ihr Zustand ist deshalb beides:
  //     Titel fuer die Lautstaerke und Nebenzeile fuer das Mikrofon.
  //     Anzeige traegt nur einen Regler und darum nur einen Titel.
  //
  //     SEIT AUFGABE 64 (22.08.2026) traegt jede der beiden Zeilen
  //     ausserdem den NAMEN ihres Geraets. Das ist keine Zierde: bei
  //     genau einem Geraet je Richtung erscheint die Auswahlliste
  //     absichtlich nicht (siehe zeichneWahl unten), und der Kopf ist
  //     dann der einzige Ort, an dem ueberhaupt steht, worueber der
  //     Regler spricht.
  //
  // WAS AN DEN UEBERNOMMENEN BEDIENELEMENTEN GEAENDERT WURDE
  //     Bis zum 22.08.2026: NICHTS - Byte fuer Byte dieselben
  //     zepButton()-Aufrufe, dieselben Gtk.Scale-Bereiche (0-100 fuer
  //     Ton, 5-100 fuer Helligkeit) und dieselben Befehle
  //     (pamixer/brightnessctl) wie vorher auf "general"; nur
  //     updateDisplay() heisst hier lokal updateSound()/
  //     updateBrightness() und liest istAktiv(), wie es
  //     Netzwerk/Bluetooth/VPN seit Aufgabe 15/16 auch tun (kein Takt
  //     fuer eine Seite, die niemand sieht).
  //
  //     MIT AUFGABE 64 sind es drei Dinge, und alle drei stehen unten
  //     mit ihrer Messung: die Regler LESEN aus audio-devices.sh statt
  //     aus pamixer (je Geraet statt nur "die Vorgabe"), sie werden
  //     unbedienbar, wenn es kein Geraet gibt (Spezifikation 7.4), und
  //     eine Sperre haelt die programmatische Zuweisung davon ab, als
  //     Befehl zurueckzulaufen. Die pamixer-Aufrufe zum SCHREIBEN sind
  //     unveraendert.
  //
  // BEDIENELEMENTE VORHER/NACHHER (Aufgabenblatt 17, "zaehl sie wieder"):
  // siehe der Bericht dieser Aufgabe fuer die vollstaendige Rechnung -
  // 29 vorher (26 Knoepfe + 3 Regler, alle auf "general"), 29 nachher
  // (24 Knoepfe + 0 Regler auf "general", 2 Knoepfe + 2 Regler auf
  // "sound", 0 Knoepfe + 1 Regler auf "display" - 24+4+1 = 29). Es
  // verschwindet nichts, nur der Ort aendert sich.
  // ENTFERNT am 20.08.2026: mitSeitenboden().
  //
  //     Die Funktion wickelte jede Seite in eine polsterlose Gtk.Box,
  //     damit `.zep-shell-page { min-width: 672px }` nicht auf derselben
  //     Box sass wie `.cc-container` mit seinem eigenen Polster - GTK
  //     rechnet Polster IMMER oben auf eine gesetzte min-width drauf
  //     (GEMESSEN Aufgabe 23: 708 statt 672 fuer general).
  //
  //     Sie war die dritte Station eines Bodens, der von Anfang an an
  //     der falschen Stelle stand. 672 = 880 (Sprosse L) minus 208
  //     (Seitenleiste) rechnet mit der Sprosse, als waere sie der Platz
  //     fuer den Inhalt - sie ist die Breite des FENSTERS. Rahmen der
  //     Platte (2), Rinne der senkrechten Bildlaufleiste (24) und der
  //     1px-Rand der Seitenleiste selbst (1) gehen davon ab: GEMESSEN am
  //     20.08.2026 genau 27 Punkte, die als waagerechte Bildlaufleiste
  //     wieder herauskamen. Ein Stylesheet kann diese drei Posten nicht
  //     messen, es kann sie nur abschreiben.
  //
  //     Der Boden liegt seither in createOverlayWindow()
  //     (`config.fuelltDieSprosse`, ags-overlay-utils.template): dort
  //     werden Rahmen und Rinne bei jedem Aufgehen gemessen, von der
  //     Sprosse abgezogen und der Rest als Boden auf den GANZEN Rumpf
  //     gesetzt. Auf einem Rumpf kann sich kein Polster einer einzelnen
  //     Seite mehr draufrechnen - damit entfaellt der Grund fuer die
  //     Huelle, und eine Seite gibt wieder sich selbst zurueck.

  const soundSeite: ShellSeite = {
    id: "sound",
    titel: _("Sound"),
    symbol: ICONS.volume,
    gruppe: gruppeSystem,
    bauen: (win, _schliessen, istAktiv) => {
      let headerWrap: Gtk.Box
      let volumeSlider: Gtk.Scale, volumeIcon: Gtk.Label, volumeLabel: Gtk.Label
      let micSlider: Gtk.Scale, micIcon: Gtk.Label, micLabel: Gtk.Label
      // Die zwei Geraetewahlen - AUFGABE 64 (22.08.2026), am 01.09.2026
      // von einer offenen Liste auf eine AUFKLAPPBARE umgestellt. Je ein
      // Knopf, der das gewaehlte Geraet nennt, und die Liste dahinter im
      // Klappfenster; updateSound() fuellt sie neu.
      //
      // WARUM AUFKLAPPBAR - BESTELLT am 01.09.2026 ("kann man bei ton
      // mikrofon und lautsprecher auswaehlen anhand eines dropdowns?")
      //
      //     Die offene Liste WUCHS NACH UNTEN. Bei Kopfhoerer, HDMI,
      //     USB-Kopfhoerer und interner Tonkarte sind das vier Zeilen JE
      //     RICHTUNG, also acht zusaetzliche Zeilen im Kontrollzentrum -
      //     an einem Fenster, an dem derselbe Nutzer sich mehrfach ueber
      //     Laenge und Enge beschwert hat. Aufgeklappt zeigt es EINE
      //     Zeile je Richtung, und die Liste kostet erst Platz, wenn
      //     jemand sie sehen will.
      //
      //     Der Preis ist ein Klick mehr fuer den, der oft umschaltet.
      //     Das ist der richtige Tausch: umgeschaltet wird selten (wenn
      //     ein Kopfhoerer dazukommt), angesehen wird bei jedem Oeffnen
      //     des Kontrollzentrums.
      let ausgabeKnopf: Gtk.MenuButton, eingabeKnopf: Gtk.MenuButton
      let ausgabeListe: Gtk.Box, eingabeListe: Gtk.Box
      let ausgabeName: Gtk.Label, eingabeName: Gtk.Label

      // DER SCHUTZ VOR DEM SCHREIBEN, DAS AUS EINEM LESEN ENTSTEHT
      //
      //     `volumeSlider.set_value(...)` loest "value-changed" aus, und
      //     dieser Rueckruf ruft `pamixer --set-volume`. Jede Anzeige
      //     war damit zugleich ein Befehl. Solange die Zahl aus
      //     DEMSELBEN Geraet kam, das der Befehl trifft, fiel das nicht
      //     auf - der Wert wurde auf sich selbst gesetzt.
      //
      //     Mit der Geraetewahl faellt es auf: nach einem Wechsel zeigt
      //     der Regler den Wert des NEUEN Geraets, und ohne diese Sperre
      //     schriebe er ihn ungefragt auch hin. Die Sperre steht
      //     deshalb ab heute um jede programmatische Zuweisung.
      let stelleEin = false

      // KOPF AUSSERHALB DER FLAECHE - GEAENDERT am 20.08.2026 (Aufgabe
      // 49). Bis hierher hing der zepStateHeader IN `.cc-container`
      // (Polsterung 18) und rueckte damit doppelt ein: 18 vom Kasten
      // plus die eigenen 25 von `.zep-state-head` = 43, waehrend
      // Bluetooth und Netzwerk ihren Kopf bei 25 stehen haben. Das
      // Musterblatt ("Die Schale", 19.08.2026) baut die Inhaltsseite
      // aus ZWEI Bloecken - `.zustandskopf` mit eigener Polsterung und
      // darunter `.flaeche` (18/25) -, und genau so steht es jetzt hier.
      const mainBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
      // KEIN Mindestbreiten-Boden hier - siehe der Block bei der
      // entfernten mitSeitenboden() weiter oben.

      headerWrap = new Gtk.Box({})
      mainBox.append(headerWrap)

      const flaeche = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 8 })
      flaeche.add_css_class("zep-shell-flaeche")
      mainBox.append(flaeche)

      // Zeile: die Lautstaerke - unveraendert aus "general" uebernommen
      // (Aufgabe 6/Task D, 18.08.2026). set_child() ueberschreibt die
      // Beschriftung von zepButton mit volumeIcon selbst, weil
      // updateSound() dessen Text laufend zwischen ICONS.volume/
      // ICONS.volumeMute wechselt (derselbe Kunstgriff wie vorher).
      const volRow = new Gtk.Box({ spacing: 8 })
      volRow.add_css_class("cc-row")
      volumeIcon = new Gtk.Label({ label: ICONS.volume })
      volumeIcon.add_css_class("cc-icon")
      volumeIcon.add_css_class("volume-icon")
      const volBtn = zepButton("", "still", async () => {
        await execAsync("pamixer -t")
        updateSound()
      })
      volBtn.set_child(volumeIcon)
      volumeSlider = new Gtk.Scale({ orientation: Gtk.Orientation.HORIZONTAL, hexpand: true, draw_value: false })
      volumeSlider.set_range(0, 100)
      volumeSlider.add_css_class("cc-slider")
      volumeSlider.connect("value-changed", () => {
        if (stelleEin) return
        const val = Math.round(volumeSlider.get_value())
        volumeLabel.set_text(`${val}%`)
        execAsync(`pamixer --set-volume ${val}`)
      })
      volumeLabel = new Gtk.Label({ label: "0%" })
      volumeLabel.add_css_class("cc-value")
      volRow.append(volBtn)
      volRow.append(volumeSlider)
      volRow.append(volumeLabel)

      // Zeile: das Mikrofon - unveraendert aus "general" uebernommen.
      const micRow = new Gtk.Box({ spacing: 8 })
      micRow.add_css_class("cc-row")
      micIcon = new Gtk.Label({ label: ICONS.mic })
      micIcon.add_css_class("cc-icon")
      micIcon.add_css_class("mic-icon")
      const micBtn = zepButton("", "still", async () => {
        await execAsync("pamixer --default-source -t")
        updateSound()
      })
      micBtn.set_child(micIcon)
      micSlider = new Gtk.Scale({ orientation: Gtk.Orientation.HORIZONTAL, hexpand: true, draw_value: false })
      micSlider.set_range(0, 100)
      micSlider.add_css_class("cc-slider")
      micSlider.connect("value-changed", () => {
        if (stelleEin) return
        const val = Math.round(micSlider.get_value())
        micLabel.set_text(`${val}%`)
        execAsync(`pamixer --default-source --set-volume ${val}`)
      })
      micLabel = new Gtk.Label({ label: "0%" })
      micLabel.add_css_class("cc-value")
      micRow.append(micBtn)
      micRow.append(micSlider)
      micRow.append(micLabel)

      flaeche.append(volRow)
      flaeche.append(micRow)

      // DIE GERAETEWAHL - AUFGABE 64 (22.08.2026)
      //
      // BESTELLT, woertlich: "ich will pro ton und mikrofon auch das
      // geraet waehlen koennen, falls mehrere angeschlossen sind. ok,
      // das muss gehen."
      //
      // WARUM HIER UND NICHT IN DEN EINSTELLUNGEN
      //     GEMESSEN in ags-bar.template: das Lautstaerkemodul UND das
      //     Mikrofonmodul der Leiste tragen beide `toggles: "sound"`.
      //     Ein Klick auf eines von beiden fuehrt also genau auf diese
      //     Seite - und das ist der Moment, in dem jemand ein Headset
      //     einsteckt. Das Einstellungsfenster ist der Ort fuer die
      //     dauerhafte VORGABE, und die gibt es dort schon als
      //     `audio.default_sink` / `audio.default_source`
      //     (wireplumber-config.template, src/audio.py). Zwei
      //     verschiedene Fragen, zwei verschiedene Orte.
      //
      // EIN GERAET IST KEINE WAHL
      //     Der Nutzer sagt es selbst: "falls mehrere angeschlossen
      //     sind". Woertlich gelesen heisst das: die Liste erscheint,
      //     wenn es etwas zu waehlen gibt, und sonst nicht. Sie
      //     erscheint darum JE RICHTUNG einzeln - ein Rechner mit einer
      //     Tonkarte und drei Mikrofonen zeigt die Wahl nur beim
      //     Mikrofon.
      //
      //     Eine Liste mit einem Eintrag waere nicht nur Platz: sie
      //     laedt zu einem Klick ein, nach dem sich nichts aendert, und
      //     das sieht aus wie ein Fehler.
      /** Ein Klappknopf: das gewaehlte Geraet vorn, die Liste dahinter.
       *
       * NICHT Gtk.DropDown, SONDERN Gtk.MenuButton MIT Gtk.Popover UND
       * ZEILEN AUS DEM BAUSATZ
       *     Gtk.DropDown zeichnet seine Eintraege selbst und bringt
       *     GTKs eigene Knotentypen mit, die ags-style.template nicht
       *     kennt - eine Auswahl daraus saehe aus wie Adwaita und nicht
       *     wie ZepOS. Dieselbe Entscheidung und dieselbe Begruendung
       *     wie beim Rechtsklickmenue in ags-dock.template, wo sie
       *     ausfuehrlich steht: zepRow IST die klickbare Zeile dieses
       *     Schreibtischs, und eine Liste solcher Zeilen braucht kein
       *     eigenes Bauteil.
       *
       * WARUM DER POPOVER UEBER DEN FENSTERRAND DARF
       *     GTK4 legt einen Gtk.Popover als EIGENE Wayland-Flaeche an
       *     (xdg_popup), und gtk4-layer-shell haengt sie ueber
       *     zwlr_layer_surface_v1.get_popup an die Layer-Flaeche. Die
       *     Liste ist damit nicht auf die Hoehe des Kontrollzentrums
       *     beschraenkt - genau der Punkt der Umstellung.
       *
       * ER GEHT AUF DREI WEGEN WIEDER ZU, alle drei aus `autohide`:
       * Klick daneben und Escape ueber den Griff des Popups, und die
       * Auswahl selbst - jede Zeile klappt ZUERST zu und schaltet dann.
       * Ohne das erste bliebe die Liste offen ueber einem Knopf stehen,
       * der schon einen anderen Namen traegt.
       */
      const klappwahl = (symbol: string) => {
        const name = ccLabel("")
        const symbolLabel = new Gtk.Label({ label: symbol })
        symbolLabel.add_css_class("zep-row-icon")
        const pfeil = new Gtk.Label({ label: ICONS.chevronDown })
        pfeil.add_css_class("zep-row-icon")

        // spacing: 0 und der Abstand im Stylesheet - genau wie zepRow
        // selbst es haelt (ags-kit.template: `new Gtk.Box({ spacing: 0 })`
        // und `.zep-row-texts { margin-left: ... }`). Eine Zahl hier waere
        // ein zweiter Ort, an dem derselbe Abstand steht.
        const inhalt = new Gtk.Box({ spacing: 0 })
        inhalt.append(symbolLabel)
        inhalt.append(name)
        inhalt.append(pfeil)

        const liste = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL,
                                    spacing: 4 })
        liste.add_css_class("cc-geraetewahl-liste")

        const knopf = new Gtk.MenuButton({ child: inhalt })
        knopf.add_css_class("zep-row")
        knopf.add_css_class("cc-geraetewahl")
        knopf.set_popover(new Gtk.Popover({ child: liste }))
        return { knopf, liste, name }
      }

      const ausgabeLabel = zepSectionLabel(_("Output device"))
      const ausgabe = klappwahl(ICONS.volume)
      ausgabeKnopf = ausgabe.knopf
      ausgabeListe = ausgabe.liste
      ausgabeName = ausgabe.name
      const eingabeLabel = zepSectionLabel(_("Input device"))
      const eingang = klappwahl(ICONS.mic)
      eingabeKnopf = eingang.knopf
      eingabeListe = eingang.liste
      eingabeName = eingang.name
      flaeche.append(ausgabeLabel)
      flaeche.append(ausgabeKnopf)
      flaeche.append(eingabeLabel)
      flaeche.append(eingabeKnopf)

      /** Eine Richtung zeichnen - und sich ganz ausblenden, wenn es
       * nichts zu waehlen gibt.
       *
       * `zepRow` mit `aktion` und `ausgewaehlt` und kein eigener
       * Zeilentyp: dieselbe Zeile, die die Bluetooth- und die Netzseite
       * schon benutzen, mit demselben "aktiv"-Streifen fuer das Geraet,
       * das gerade spielt.
       *
       * EIN ZEICHEN JE RICHTUNG UND KEINE RATEREI. Der Kopfhoerer liesse
       * sich am node.name erkennen (so macht es die Leiste in
       * bar-status-config.template), aber diese Liste holt den node.name
       * bewusst nicht - siehe den Kopf von audio-devices-config.template.
       * Aus dem ANGEZEIGTEN Namen zu raten waere schlechter als gar
       * nicht zu raten: er ist uebersetzt, und ein Wortvergleich gegen
       * eine uebersetzte Zeichenkette trifft auf der naechsten Sprache
       * nichts mehr.
       */
      const zeichneWahl = (knopf: Gtk.MenuButton, liste: Gtk.Box,
                           name: Gtk.Label, marke: Gtk.Widget,
                           geraete: any[], symbol: string,
                           waehlen: (kennung: number) => void) => {
        removeAllChildren(liste)
        const zeigen = geraete.length > 1
        knopf.set_visible(zeigen)
        marke.set_visible(zeigen)
        if (!zeigen) return

        // Der Knopf traegt den Namen des gewaehlten Geraets, nicht eine
        // feste Aufschrift: er ist die EINE Zeile, die von der Liste
        // uebrig bleibt, solange sie zu ist, und eine Auswahl, die nicht
        // zeigt was gewaehlt ist, waere keine.
        const gewaehlt = geraete.find(g => g.vorgabe === true)
        name.set_text(String(gewaehlt?.name ?? ""))
        knopf.set_tooltip_text(String(gewaehlt?.name ?? ""))

        for (const geraet of geraete) {
          liste.append(zepRow({
            symbol,
            titel: String(geraet.name ?? ""),
            ausgewaehlt: geraet.vorgabe === true,
            // ZUERST ZU, DANN SCHALTEN. waehle() liest anschliessend neu
            // und schreibt den neuen Namen in `name` - stuende die Liste
            // dabei noch offen, zeigte der Knopf darunter bereits das
            // neue Geraet, waehrend die alte Auswahl noch davor haengt.
            aktion: () => {
              knopf.get_popover()?.popdown()
              waehlen(Number(geraet.kennung))
            },
          }))
        }
      }

      /** Umschalten und SOFORT neu lesen.
       *
       * Das `await` ist der ganze Punkt und keine Formsache: erst wenn
       * audio-devices.sh zurueck ist, steht die neue Vorgabe fest, und
       * erst dann darf die Seite sie lesen. GEMESSEN am 22.08.2026 an
       * einer privaten PipeWire-Instanz: `set-sink` kehrt nach 21,5 ms
       * zurueck, und die naechste Liste 15,4 ms spaeter nennt bereits das
       * neue Geraet MIT SEINER EIGENEN Lautstaerke (77 % statt der 55 %
       * des alten). Der Regler kann danach nichts Falsches zeigen, weil
       * er seinen Wert aus derselben Antwort nimmt, die sagt, welches
       * Geraet gewaehlt ist.
       */
      const waehle = async (unterbefehl: string, kennung: number) => {
        try {
          await execAsync([SCRIPTS.audioDevices, unterbefehl, String(kennung)])
        } catch (error) {
          console.error("audio-devices.sh:", String(error))
        }
        updateSound()
      }

      const updateSound = async () => {
        const geraete = await readJson(SCRIPTS.audioDevices + " list")
        const ausgabe: any[] = Array.isArray(geraete.ausgabe) ? geraete.ausgabe : []
        const eingabe: any[] = Array.isArray(geraete.eingabe) ? geraete.eingabe : []
        const vorgabe = (liste: any[]) =>
          liste.find(eintrag => eintrag.vorgabe === true) ?? null

        const vol = vorgabe(ausgabe)
        const mic = vorgabe(eingabe)

        // DIE DREI ZUSTAENDE, DIE DAS SKRIPT UNTERSCHEIDET, UND EIN
        // VIERTER, DEN NUR DIESE SEITE SEHEN KANN
        //
        //     "fehlt"/"stumm" kommen aus audio-devices.sh (dieselbe
        //     Unterscheidung wie in bar-status-config.template: das
        //     Paket fehlt, oder der Dienst antwortet nicht). Ein
        //     LEERES Objekt dagegen heisst, dass das Skript selbst
        //     nicht geantwortet hat - readJson() gibt dann {} zurueck,
        //     und `dienst` ist undefined.
        //
        //     Warum das getrennt gehoert: die ersten beiden kann der
        //     Nutzer beheben (Paket nachinstallieren, Dienst starten),
        //     der dritte ist ein kaputter Erzeugungslauf. Eine
        //     gemeinsame Meldung schickte ihn in die falsche Richtung.
        const dienst = typeof geraete.dienst === "string" ? geraete.dienst : ""
        const klage = dienst === "fehlt"
          ? _("wireplumber is not installed")
          : dienst === "stumm"
            ? _("The sound service is not answering")
            : dienst === ""
              ? _("The device list is not answering")
              : ""

        // Ein Regler ohne Geraet ist ein Bedienelement ohne Ziel -
        // Spezifikation 7.4. Er bleibt stehen (er verschwindet nicht,
        // sonst springt die Seite), aber er nimmt keine Eingabe an.
        volumeSlider.set_sensitive(vol !== null)
        micSlider.set_sensitive(mic !== null)

        // stelleEin sperrt "value-changed" - siehe die Begruendung bei
        // der Angabe selbst. Ohne die Sperre schriebe jede dieser drei
        // Zuweisungen den gelesenen Wert ungefragt zurueck.
        stelleEin = true
        try {
          volumeSlider.set_value(vol ? Number(vol.lautstaerke ?? 0) : 0)
          micSlider.set_value(mic ? Number(mic.lautstaerke ?? 0) : 0)
        } finally {
          stelleEin = false
        }

        volumeIcon.set_text(vol && vol.stumm ? ICONS.volumeMute : ICONS.volume)
        volumeLabel.set_text(vol ? `${vol.lautstaerke}%` : "—")
        micIcon.set_text(mic && mic.stumm ? ICONS.micMute : ICONS.mic)
        micLabel.set_text(mic ? `${mic.lautstaerke}%` : "—")

        zeichneWahl(ausgabeKnopf, ausgabeListe, ausgabeName, ausgabeLabel,
                    ausgabe, ICONS.volume,
                    kennung => waehle("set-sink", kennung))
        zeichneWahl(eingabeKnopf, eingabeListe, eingabeName, eingabeLabel,
                    eingabe, ICONS.mic,
                    kennung => waehle("set-source", kennung))

        // DER KOPF NENNT DAS GERAET MIT - GEAENDERT am 22.08.2026
        //
        //     Bis hierher stand hier "Lautstaerke 40 %" und darunter
        //     "Mikrofon 60 %". Zwei Zahlen ohne die Angabe, WOVON.
        //     Solange es nichts zu waehlen gab, war das vollstaendig;
        //     ab heute ist es die halbe Auskunft - und auf einem
        //     Rechner mit genau EINEM Geraet je Richtung (die Liste
        //     erscheint dann nicht, siehe zeichneWahl) ist der Kopf der
        //     EINZIGE Ort, an dem der Name ueberhaupt steht.
        //
        //     "Lautstaerke 40 %" und "Lautstaerke 40 % - Internes Audio"
        //     sind darum zwei msgids und nicht einer mit leerem Feld:
        //     eine Beschriftung, die auf " - " endet, weil das Geraet
        //     fehlt, ist kein uebersetzbarer Satz.
        removeAllChildren(headerWrap)
        headerWrap.append(zepStateHeader({
          // Der Kopf IST der Zustand (Spezifikation 2.2). Steht der Ton
          // still, sagt er warum - und nicht "Lautstaerke 0 %", was eine
          // Messung behauptet, die es nicht gab.
          titel: klage
            ? klage
            : vol === null
              ? _("No output device")
              : vol.stumm
                ? format(_("Volume muted - {device}"),
                         { device: String(vol.name ?? "") })
                : format(_("Volume {level}% - {device}"),
                         { level: vol.lautstaerke,
                           device: String(vol.name ?? "") }),
          unterzeile: klage
            ? ""
            : mic === null
              ? _("No input device")
              : mic.stumm
                ? format(_("Microphone muted - {device}"),
                         { device: String(mic.name ?? "") })
                : format(_("Microphone {level}% - {device}"),
                         { level: mic.lautstaerke,
                           device: String(mic.name ?? "") }),
        }))
      }

      // NUR WENN DIESE SEITE AUCH DIE AKTIVE IST - derselbe Grundsatz wie
      // Netzwerk/Bluetooth/VPN (Aufgabe 15/16, Fund 1.3): der Takt laeuft
      // fuer die Lebensdauer der Schale, tut aber nur etwas, wenn "sound"
      // auch die gezeigte Seite ist.
      interval(UPDATE_INTERVAL, () => { if (win.visible && istAktiv()) updateSound() })
      win.connect("notify::visible", () => {
        if (win.visible && istAktiv()) updateSound()
      })

      return mainBox
    },
  }

  const displaySeite: ShellSeite = {
    id: "display",
    titel: _("Display"),
    symbol: ICONS.displays,
    gruppe: gruppeSystem,
    bauen: (win, _schliessen, istAktiv) => {
      let headerWrap: Gtk.Box
      let brightnessSlider: Gtk.Scale, brightnessLabel: Gtk.Label

      // KOPF AUSSERHALB DER FLAECHE - GEAENDERT am 20.08.2026 (Aufgabe
      // 49), dieselbe Umstellung wie bei "sound" darueber und aus
      // demselben Grund: der zepStateHeader rueckte in `.cc-container`
      // doppelt ein (18 + 25 = 43 statt 25).
      const mainBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
      // KEIN Mindestbreiten-Boden hier - siehe der Block bei der
      // entfernten mitSeitenboden() weiter oben.

      headerWrap = new Gtk.Box({})
      mainBox.append(headerWrap)

      const flaeche = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 8 })
      flaeche.add_css_class("zep-shell-flaeche")
      mainBox.append(flaeche)

      // Zeile: die Helligkeit - unveraendert aus "general" uebernommen
      // (Aufgabe 6/Task D, 18.08.2026): kein Knopf, weil Helligkeit -
      // anders als Lautstaerke/Mikrofon - kein Stummschalten kennt, also
      // keine Handlung, die ein Knopf sinnvoll uebernehmen koennte (Spec
      // §7.4, "ein Knopf, hinter dem nichts passiert").
      const brightRow = new Gtk.Box({ spacing: 8 })
      brightRow.add_css_class("cc-row")
      const brightIcon = new Gtk.Label({ label: ICONS.brightness })
      brightIcon.add_css_class("cc-icon")
      brightIcon.add_css_class("brightness-icon")
      brightnessSlider = new Gtk.Scale({ orientation: Gtk.Orientation.HORIZONTAL, hexpand: true, draw_value: false })
      brightnessSlider.set_range(5, 100)
      brightnessSlider.add_css_class("cc-slider")
      brightnessSlider.connect("value-changed", () => {
        const val = Math.round(brightnessSlider.get_value())
        brightnessLabel.set_text(`${val}%`)
        execAsync(`brightnessctl set ${val}%`)
      })
      brightnessLabel = new Gtk.Label({ label: "100%" })
      brightnessLabel.add_css_class("cc-value")
      brightRow.append(brightIcon)
      brightRow.append(brightnessSlider)
      brightRow.append(brightnessLabel)

      flaeche.append(brightRow)

      const updateBrightness = async () => {
        const brightness = await getBrightness()
        brightnessSlider.set_value(brightness)
        brightnessLabel.set_text(`${brightness}%`)

        removeAllChildren(headerWrap)
        headerWrap.append(zepStateHeader({
          titel: format(_("Brightness {level}%"), { level: brightness }),
        }))
      }

      interval(UPDATE_INTERVAL, () => { if (win.visible && istAktiv()) updateBrightness() })
      win.connect("notify::visible", () => {
        if (win.visible && istAktiv()) updateBrightness()
      })

      return mainBox
    },
  }

  // DIE SEITE "general": WAS DAS KONTROLLZENTRUM VOR AUFGABE 6 GANZ
  // ALLEIN WAR
  //
  // KEIN width/height MEHR, UND DAS IST KEIN VERLUST, SONDERN EIN
  // UMZUG (Aufgabe 6, 18.08.2026)
  //     Hier standen bis heute `width: 520, height: 2470` mit rund 90
  //     Zeilen Messgeschichte darueber (400x580 -> 545x1622 am
  //     12.08.2026, danach 1682/1790/2098/2470 in der Hoehe und
  //     495/520 in der Breite, je einzeln gemessen und begruendet -
  //     nachzulesen in der Historie dieser Datei). ShellConfig
  //     (ags-overlay-utils.template, Aufgabe 5) kennt weder width noch
  //     height: die Schale setzt SHELL_WIDTH/SHELL_HEIGHT einmal fuer
  //     ALLE Seiten, nicht jede Seite fuer sich. Die alte Messreihe
  //     beschriebe damit ein Feld, das es an dieser Stelle nicht mehr
  //     gibt - stehen gelassen waere sie eine Erklaerung ohne Adresse
  //     (Regel 14).
  //
  // WAS DIE BREITE FUER DIESEN INHALT JETZT BEDEUTET, GEMESSEN GEGEN
  // DIE SPEZIFIKATION UND NICHT GEGEN DEN COMPOSITOR (tests/render/
  // ist fuer diese Aufgabe verboten)
  //     SHELL_WIDTH ist STYLE_MODAL_WIDTH_L (880), die Seitenleiste
  //     208 (zepSidebar, ags-style.template .zep-sidebar) - es bleiben
  //     rund 672 fuer diese Seite. Der letzte gemessene Wert fuer die
  //     Mindestbreite dieses Inhalts war 495-520 (siehe oben); 672 ist
  //     MEHR und schneidet also nichts ab. Was sich aendert, ist die
  //     Aufteilung: `.cc-power-grid` und die drei Wiedergabeknoepfe
  //     bleiben mit `halign: Gtk.Align.CENTER` schmal und stehen jetzt
  //     mit deutlich mehr Leerraum links und rechts davon, statt das
  //     Fenster (fast) auszufuellen - ein Aussehensunterschied, kein
  //     abgeschnittener Inhalt. `updateLabel` traegt `wrap: true`
  //     (Zeile "was ansteht"); bei mehr verfuegbarer Breite bricht ein
  //     langer Aktualisierungssatz auf WENIGER Zeilen um als bei 520 -
  //     die alte Hoehenmessung 2470 waere also ohnehin nicht mehr die
  //     wahre natuerliche Hoehe bei 672. Das macht nichts: die Fabrik
  //     misst live bei jedem show() (siehe getOverlayPosition() /
  //     outerBox.measure() in ags-overlay-utils.template) und nicht aus
  //     einer hier eingetragenen Zahl.
  const generalSeite: ShellSeite = {
    id: "general",
    // "Control" statt "Control center" - GEMESSEN, nicht geraten
    // (Aufgabenblatt 17, Aufgabe 3: "steht 'Kontrollzentrum' in der
    // Seitenleiste als 'Kontrollze…' - passt der Text bei 208px?").
    //
    // GEMESSEN am 19.08.2026, echter Compositor (schale-general.png,
    // dieselbe Aufgabe) UND per PangoCairo-Nachrechnung (headless,
    // gleiche Schrift/Groesse) ausserhalb des Arbeitsbaums:
    //
    //     Seitenleiste 208px (Spezifikation 2.2, Literal in
    //     ags-style.template, .zep-sidebar). Davon fuer den Titel
    //     verfuegbar: 208 - {{STYLE_SPACE_12}} (Polster links) -
    //     {{STYLE_SPACE_12}} (Polster rechts) - ~16 (Symbol) -
    //     {{STYLE_SPACE_12}} (Abstand Symbol/Text) = ~138px, alle drei
    //     Abstaende aus .zep-row/.zep-row-texts, bei der ausgelieferten
    //     Groesse.
    //
    //     "Kontrollzentrum" bei STYLE_FONT_BODY (20px, ausgelieferte
    //     Groesse) UND der eingetragenen Schriftfamilie (STYLE_FONT_FAMILY,
    //     ags-style.template: "Roboto", "JetBrainsMono Nerd Font",
    //     sans-serif): 180px in der tatsaechlich benutzten Schrift
    //     (Roboto fehlt auf dieser Entwicklungsmaschine, fontconfig
    //     weicht je Glyph auf die naechste im Stapel aus - "JetBrainsMono
    //     Nerd Font" traegt lateinische Buchstaben ebenfalls und wird
    //     genommen). Zur Gegenprobe mit einer echten proportionalen
    //     Schrift (Noto Sans, NICHT Roboto, aber naeher an dessen
    //     Charakter als eine Mono-Schrift): 151px - IMMER NOCH ueber den
    //     138px. Auch die ENGLISCHE Fassung "Control center" passt nur
    //     mit Noto Sans knapp (133px, 5px Luft) und NICHT mit der
    //     tatsaechlich eingetragenen Schriftfamilie (168px) - der Name
    //     ist zu lang fuer eine Navigationsspalte, in BEIDEN Sprachen,
    //     nicht nur eine Frage der deutschen Uebersetzung.
    //
    //     ENTSCHIEDEN: kuerzerer Eintragsname statt breiterer
    //     Seitenleiste. Die Seitenleiste zu verbreitern kostet
    //     Inhaltsbreite auf JEDER der sechs Seiten (SHELL_WIDTH ist EIN
    //     Deckel fuer alle); "Kontrollzentrum" ist die EINZIGE
    //     Fundstelle, die nicht passt - Netzwerk/Bluetooth/VPN/Ton/
    //     Anzeige passen alle (GEPRUEFT an denselben Bildern). Ein
    //     einzelner zu langer Name rechtfertigt keinen geteilten Boden,
    //     den fuenf andere Eintraege gar nicht brauchen.
    //
    //     "Control" statt "Center"/"Settings":
    //     "Settings" waere ein zweiter Name fuer die Gruppe
    //     EINSTELLUNGEN, die die Spezifikation (4.1) fuer eine spaetere
    //     Aufgabe vorsieht und die dieser Plan bewusst nicht baut - der
    //     Name wuerde ihr schon heute im Weg stehen. "Control" haelt
    //     die Wurzel des vollen Namens fest (kein neues Wort, keine
    //     neue Bedeutung) und misst 84px in der ungeguenstigsten Schrift
    //     dieser Maschine (JetBrainsMono Nerd Font), 69px mit Noto Sans -
    //     mit Abstand die groesste gemessene Luft (54-69px) aller
    //     geprueften Kandidaten.
    //
    //     DER TOOLTIP DES ZAHNRADS AUF DER LEISTE (ags-bar.template,
    //     staticModule) BLEIBT "Control center"/"Kontrollzentrum" -
    //     bewusst NICHT umbenannt: ein Tooltip hat kein 208px-Deckel und
    //     darf den vollen, beschreibenden Namen tragen; die Seitenleiste
    //     braucht die knappe Navigationsbeschriftung. Beide Aufrufer
    //     teilten sich bisher denselben msgid - "Control" ist deshalb
    //     ein EIGENER, neuer Katalogeintrag (po/desktop/de.po: "Control"
    //     -> "Kontrolle"), keine Aenderung an "Control center"
    //     ("Kontrollzentrum" bleibt dort unveraendert stehen).
    //
    //     tests/src/test_overlay_windows.py,
    //     test_the_control_centre_speaks_one_language: die Zeile
    //     "Control center": "Kontrollzentrum" ist dort durch "Control":
    //     "Kontrolle" ersetzt - eine bewusste, begruendete Anpassung an
    //     eine tatsaechliche Namensaenderung, keine Aufweichung der
    //     Zusicherung selbst (sie prueft weiterhin dieselbe Regel: msgid
    //     in der Vorlage, Uebersetzung im Katalog).
    titel: _("Control"),
    symbol: ICONS.settings,
    gruppe: gruppeSystem,
    bauen: (win, schliessen) => {
      closeFn = schliessen

      // Die Oberflaeche bauen
      //
      // `.zep-shell-flaeche` STATT `.cc-container` - GEAENDERT am
      // 20.08.2026 (Aufgabe 49). Diese Seite traegt keinen
      // zepStateHeader und keinen Trenner; ihr ganzer Inhalt IST die
      // Flaeche des Musterblatts ("Die Schale", 19.08.2026), und die
      // polstert 18/25. `.cc-container` polsterte 18 RUNDHERUM -
      // GEMESSEN am Bild (tests/render/, schale-general.png): links 18
      // statt 25, waehrend die VPN-Seite daneben 25 trug. Zwei
      // Antworten auf dieselbe Frage.
      //
      // `.cc-container` BLEIBT IM STYLESHEET UND WIRD NICHT UMGESTELLT:
      // ags-notifications.template haengt dieselbe Klasse an sein
      // Fenster (GEPRUEFT: `grep -rn 'add_css_class("cc-container")'
      // src/templates/`), und das ist KEINE Seite der Schale - eine
      // Aenderung an der Polsterung dort waere eine Aenderung an einem
      // fremden Fenster. Was diese Seite von `.cc-container` sonst noch
      // bekam, braucht sie nicht: `background: transparent` und
      // `border: none` sind die Vorgabe einer Gtk.Box, der
      // `border-radius` bleibt auf einer durchsichtigen Flaeche
      // unsichtbar, und die `min-width: 320px` ist seit dem 20.08.2026
      // ohne Aufgabe (siehe der Block darunter).
      const mainBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 8 })
      mainBox.add_css_class("zep-shell-flaeche")
      // NACHGETRAGEN Aufgabe 17 (19.08.2026): "general" erreichte 672+
      // bisher NUR, weil sein eigener Inhalt zufaellig breit genug war
      // (Aufgabe 15, siehe der Kommentar bei .zep-shell-page,
      // ags-style.template) - kein erzwungener Boden, nur ein Zufall.
      // Seit dieser Aufgabe DREI Zeilen weniger (Lautstaerke, Mikrofon,
      // Helligkeit sind auf "sound"/"display" umgezogen): GEMESSEN,
      // echter Compositor, 852 statt 880 (-28) OHNE diese Klasse. Mit
      // ihr - und der Verbundregel `.cc-container.zep-shell-page` in
      // ags-style.template, die .cc-container's eigenes 320px-Minimum
      // fuer Notifications unangetastet laesst - erreichte general
      // wieder verlaesslich die vollen 880, wie Netzwerk/Bluetooth/VPN.
      //
      // SEIT DEM 20.08.2026 GAR KEIN BODEN MEHR IM STYLESHEET: er wird
      // von der Schale gemessen und gesetzt - siehe der Block bei der
      // entfernten mitSeitenboden() weiter oben.

      /** Die Beschriftung einer Zeile - die, die den Text traegt.
       *
       * Vier Eigenschaften, die zusammengehoeren: sie nimmt den freien
       * Platz (hexpand), sie steht links (xalign) und sie hoert nach
       * STYLE_MEASURE_LINE Zeichen mit drei Punkten auf, statt das
       * Fenster zu verbreitern.
       *
       * AUSGESCHRIEBEN STANDEN SIE NEUNMAL DA, UND ZWEIMAL VOLLSTAENDIG
       *     Die Wiedergabezeile und die Zeilen des Abschnitts
       *     SCHREIBTISCH hatten alle vier; Netz, VPN, Bluetooth,
       *     Drucker, Watchdog, Hilfsskripte, Style Editor und die
       *     beiden Datenschutzzeilen hatten die letzten beiden nicht.
       *     Sieben Beschriftungen mit fremdem Text ohne Grenze - und
       *     das Fenster war am 17.08.2026 gemessene 930 statt 495
       *     Punkte breit.
       *
       *     Eine Vorsichtsmassnahme, an die sich jede neue Zeile erst
       *     erinnern muss, ist keine.
       */
      // Ein Aufklappfenster dieses Prozesses. Das Kontrollzentrum geht
      // dabei ZU: zwei Aufklappfenster uebereinander sind zwei Deckel
      // auf demselben Schirm, und das zweite laege ueber dem Knopf, der
      // es geoeffnet hat.
      //
      // SEIT DEM 17.08.2026 GEHEN AUCH NETZ, VPN UND STIL DIESEN WEG
      //     Drei Knoepfe riefen bis dahin `ags request network`, `ags
      //     request vpn-manager` und `ags request style` ueber
      //     execAsync - also einen zweiten AGS-Prozess, der die Anfrage
      //     ueber den Astal-Socket an genau DIESEN Prozess schickte,
      //     damit er toggleWidget aufruft. Das ist derselbe Umweg, den
      //     die Leiste am 12.08.2026 losgeworden ist (siehe
      //     toggleByName in ags-config.template), und er stand hier
      //     noch, weil die beiden Aufrufer Modulfunktionen waren und
      //     `toggle` nicht sehen konnten.
      //
      //     Sie stehen jetzt hier drin, wo `toggle` sichtbar ist. Ein
      //     Prozessstart, um im eigenen Prozess eine Funktion zu rufen,
      //     ist keine Entkopplung, sondern ein Umweg mit Wartezeit.
      const opens = (widget: string) => () => { toggle(widget); closeFn?.() }
      // Ein Befehl. Wortgleich zu dem, was das Leistenmodul tat.
      const runs = (command: string) => () => {
        execAsync(["bash", "-c", command])
        closeFn?.()
      }

      // NACHGETRAGEN AB AUFGABE 7 (18.08.2026): FUER BLUETOOTH (UND
      // AB AUFGABE 8/9 NETZWERK/VPN) IST `opens()` OBEN FALSCH
      //
      //     `opens()` schliesst DIESE Schale, nachdem sie ein ANDERES
      //     Fenster geoeffnet hat - richtig, solange das Ziel wirklich
      //     ein zweites Fenster ist (Stil-Editor, Hintergruende, ...).
      //     Bluetooth ist seit Aufgabe 7 keines mehr: `toggle("bluetooth")`
      //     ruft ueber toggleByName() (ags-config.template) inzwischen
      //     `widgets.control.zeigeSeite("bluetooth", ...)` - also GENAU
      //     DIESE Schale, nur auf eine andere Seite. Ein `closeFn?.()`
      //     danach wuerde sie sofort wieder zumachen, kaum dass sie
      //     umgeschaltet hat.
      //
      //     `zeigtSeite()` ist darum `opens()` OHNE das Schliessen - eine
      //     Navigation innerhalb derselben Schale, keine Fensteroeffnung.
      const zeigtSeite = (seite: string) => () => { toggle(seite) }

      // ===== DATENSCHUTZ =====
      //
      // GANZ OBEN, und das ist keine Geschmacksfrage: es ist die
      // einzige Auskunft dieses Fensters, die etwas kostet, das man
      // nicht zurueckbekommt. Sie steht ueber dem Netz, weil sie
      // dringender ist als jede Adresse.
      //
      // UNSICHTBAR, SOLANGE NICHTS LAEUFT - der ganze Abschnitt,
      // Ueberschrift und Trenner eingeschlossen. Ein Abschnitt
      // "Datenschutz", der immer dasteht und meist "niemand" sagt, ist
      // nach einer Woche ein Absatz, den niemand mehr liest, und dann
      // faellt auch der Tag nicht mehr auf, an dem er etwas sagt.
      privacyBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL, spacing: 8, visible: false,
      })

      const privacyTitle = new Gtk.Label({ label: _("PRIVACY"), xalign: 0 })
      privacyTitle.add_css_class("cc-section-title")

      // Die Mikrofonzeile, MIT Knopf.
      //
      // Der Knopf schaltet die Quelle stumm - `pamixer --default-source
      // -m`, dieselbe Quelle, die die Lautstaerkezeile weiter unten
      // regelt. Das ist die einzige Handlung, die es hier wirklich
      // gibt: einen fremden Aufnahmestrom kann man nicht zurueckziehen,
      // aber man kann dafuer sorgen, dass nichts mehr durch ihn kommt.
      //
      // Die KAMERAZEILE hat deshalb keinen Knopf. Ein v4l2-Zugriff
      // laesst sich vom Nutzerkonto aus nicht widerrufen, und ein
      // Knopf, der so aussieht, als koenne er es, waere schlimmer als
      // keiner - Spec §7.4.
      privacyMicRow = new Gtk.Box({ spacing: 10, visible: false })
      privacyMicRow.add_css_class("cc-row")
      const privacyMicIcon = new Gtk.Label({ label: ICONS.recording })
      privacyMicIcon.add_css_class("cc-icon")
      privacyMicIcon.add_css_class("mic-icon")
      const privacyMicText = new Gtk.Label({ label: _("Microphone:") })
      privacyMicText.add_css_class("cc-label")
      privacyMicLabel = ccLabel("")
      // zepButton, Rolle "umrandet" (Task D, 18.08.2026): eine wirkliche,
      // sofort wirksame Handlung (die Quelle stummschalten) und keine
      // blosse Navigation zu einem anderen Fenster - dieselbe Einordnung
      // wie die Geraetezeilen in ags-bluetooth.template.
      const privacyMicBtn = zepButton(ICONS.micMute, "umrandet", async () => {
        await execAsync("pamixer --default-source -m")
        updateDisplay()
      })
      privacyMicBtn.set_tooltip_text(_("Mute the microphone"))
      privacyMicRow.append(privacyMicIcon)
      privacyMicRow.append(privacyMicText)
      privacyMicRow.append(privacyMicLabel)
      privacyMicRow.append(privacyMicBtn)

      privacyCamRow = new Gtk.Box({ spacing: 10, visible: false })
      privacyCamRow.add_css_class("cc-row")
      const privacyCamIcon = new Gtk.Label({ label: ICONS.webcam })
      privacyCamIcon.add_css_class("cc-icon")
      const privacyCamText = new Gtk.Label({ label: _("Camera:") })
      privacyCamText.add_css_class("cc-label")
      privacyCamLabel = ccLabel("")
      privacyCamRow.append(privacyCamIcon)
      privacyCamRow.append(privacyCamText)
      privacyCamRow.append(privacyCamLabel)

      const privacyDivider = new Gtk.Separator({
        orientation: Gtk.Orientation.HORIZONTAL,
      })
      privacyDivider.add_css_class("cc-divider")

      privacyBox.append(privacyTitle)
      privacyBox.append(privacyMicRow)
      privacyBox.append(privacyCamRow)
      privacyBox.append(privacyDivider)

      // ===== NETZ =====
      //
      // ZWEI ZEILEN WAREN AM 17.08.2026 EINEN HALBEN TAG LANG FORT, UND
      // DAS WAR EIN FEHLER
      //     Vormittags hiess die Regel "eine Hauptfunktion hat genau
      //     einen Platz": Netz und Bluetooth waren auf die Leiste
      //     gezogen und HIER geloescht. Nachmittags, woertlich vom
      //     Nutzer: "im control panel soll alles wie vorher sein alle
      //     funktionen auch im control panel aber auch ausserhalb".
      //
      //     Die Sorge hinter der Regel war richtig, die Antwort nicht.
      //     Was an zwei Wegen zu einer Handlung schadet, ist nicht ihre
      //     ZAHL, sondern dass sie AUSEINANDERLAUFEN - genau das hat
      //     dieses Fenster am 12.08.2026 gekostet, als sein Netzknopf
      //     einen `nm-connection-editor` rief, den ZepOS nicht
      //     ausliefert, waehrend das Leistenmodul etwas anderes oeffnete.
      //     Zwei Knoepfe, zwei Programme, ein Fehler.
      //
      //     Die Antwort ist deshalb, dass beide Wege AUF DIESELBE
      //     FUNKTION zeigen und nicht, dass einer verschwindet:
      //
      //       netRow    opens("network")    -> widgets.network   [STAND 17.08.2026]
      //       btRow     opens("bluetooth")  -> widgets.bluetooth [STAND 17.08.2026]
      //       Leiste    toggles: "network" / "bluetooth"
      //
      //     STAND SEIT AUFGABE 7/8 (18.08.2026): netRow/btRow rufen
      //     `zeigtSeite("network")`/`zeigtSeite("bluetooth")` (siehe dort)
      //     statt `opens(...)`, und es gibt kein `widgets.network`/
      //     `widgets.bluetooth` mehr - beide Ziele sind Seiten DERSELBEN
      //     Schale geworden. Die Zeile bleibt trotzdem stehen: sie erklaert
      //     WARUM es ueberhaupt zwei Wege zu einer Funktion gibt (die
      //     Meldung vom 17.08.2026), nicht WELCHE Funktion heute gerufen
      //     wird - das aendert nichts an der Reihenfolge, in der die drei
      //     Wege entstanden sind.
      //
      //     `opens()` ruft `toggle`, und `toggle` ist toggleByName aus
      //     ags-config.template - DIESELBE Funktion, die die Leiste
      //     bekommt, auf DASSELBE Objekt aus der `widgets`-Tabelle. Es
      //     entsteht keine zweite Fassung, die auseinanderlaufen
      //     koennte; es gibt nur zwei Klingelknoepfe an einer Tuer.
      //
      //     Der btRow-Knopf startete bis dahin `blueman-manager`, einen
      //     GTK3-Prozess neben der Sitzung. GENAU DAS kommt nicht
      //     zurueck: er oeffnet jetzt das eigene Fenster, und blueman
      //     steht darin als Knopf fuer die Nebenfunktionen (Koppeln mit
      //     PIN, Dateien senden). Das ist der Unterschied zwischen
      //     "wieder da" und "wie es war".
      //
      // Dazu die Adresse zum Nachlesen und das VPN. Ein VPN ist eine
      // EINGERICHTETE Verbindung, die man an- und ausschaltet, und keine
      // Auswahl aus einer Liste - es hat oben nichts zu suchen.
      const netTitle = new Gtk.Label({
        label: _("NETWORK & CONNECTIONS"), xalign: 0,
      })
      netTitle.add_css_class("cc-section-title")

      // Zeile: das Netz
      const netRow = new Gtk.Box({ spacing: 10 })
      netRow.add_css_class("cc-row")
      networkIcon = new Gtk.Label({ label: ICONS.wifi })
      networkIcon.add_css_class("cc-icon")
      networkLabel = ccLabel(_("Loading …"))
      // zepButton, Rolle "still" (Task D, 18.08.2026): Navigation zur
      // Netzwerk-Seite dieser Schale.
      //
      // `zeigtSeite("network")` statt `opens("network")` seit Aufgabe 8
      // (18.08.2026, siehe der Kommentar bei zeigtSeite() oben und die
      // Bluetooth-Zeile btBtn, Aufgabe 7, dieselbe Begruendung) -
      // Netzwerk ist kein zweites Fenster mehr.
      const netBtn = zepButton(ICONS.settings, "still", zeigtSeite("network"))
      netBtn.set_tooltip_text(_("Wi-Fi networks - the same page as above"))
      netRow.append(networkIcon)
      netRow.append(networkLabel)
      netRow.append(netBtn)

      // Zeile: die IP-Adresse
      // Unsichtbar, bis updateDisplay() eine Adresse gefunden hat -
      // sichtbar aufzugehen und dann zu verschwinden waere ein Zucken.
      ipRow = new Gtk.Box({ spacing: 8, visible: false })
      ipRow.add_css_class("cc-ip-row")
      const ipIcon = new Gtk.Label({ label: ICONS.ip })
      ipIcon.add_css_class("cc-ip-icon")
      // Die einzige Zeile mit fremdem Text, die NICHT ccLabel benutzt:
      // sie traegt eine eigene Klasse und nimmt den freien Platz nicht.
      // Die Grenze braucht sie trotzdem - `ip` kann mehrere Adressen
      // nebeneinander melden.
      ipLabel = new Gtk.Label({
        label: "",
        ellipsize: Pango.EllipsizeMode.END,
        max_width_chars: {{STYLE_MEASURE_LINE}},
      })
      ipLabel.add_css_class("cc-ip-label")
      ipRow.append(ipIcon)
      ipRow.append(ipLabel)

      // Zeile: das VPN
      const vpnRow = new Gtk.Box({ spacing: 10 })
      vpnRow.add_css_class("cc-row")
      vpnIcon = new Gtk.Label({ label: ICONS.vpnOff })
      vpnIcon.add_css_class("cc-icon")
      vpnLabel = ccLabel(_("VPN: off"))
      // zepButton, Rolle "still" (Task D, 18.08.2026): Navigation zur
      // VPN-Seite dieser Schale.
      //
      // `zeigtSeite("vpn")` statt `opens("vpn")` seit Aufgabe 9
      // (18.08.2026, siehe der Kommentar bei zeigtSeite() oben sowie
      // btBtn/netBtn, Aufgabe 7/8, dieselbe Begruendung) - VPN ist kein
      // zweites Fenster mehr. Die VPN-EINSTELLUNGEN (ein anderes
      // Fenster, siehe VpnManager.tsx/openVpnSettings) bleiben
      // unberuehrt - diese Zeile hier fuehrt zur VPN-Seite selbst,
      // nicht zu ihrem Formular.
      const vpnBtn = zepButton(ICONS.power, "still", zeigtSeite("vpn"))
      vpnRow.append(vpnIcon)
      vpnRow.append(vpnLabel)
      vpnRow.append(vpnBtn)

      // Zeile: Bluetooth
      const btRow = new Gtk.Box({ spacing: 10 })
      btRow.add_css_class("cc-row")
      const btIcon = new Gtk.Label({ label: ICONS.bluetooth })
      btIcon.add_css_class("cc-icon")
      btLabel = ccLabel(_("Bluetooth"))
      // zepButton, Rolle "still" (Task D, 18.08.2026): Navigation zur
      // Bluetooth-Seite dieser Schale.
      //
      // `zeigtSeite("bluetooth")` statt `opens("bluetooth")` seit
      // Aufgabe 7 (18.08.2026, siehe der Kommentar bei zeigtSeite()
      // oben) - Bluetooth ist kein zweites Fenster mehr, das man
      // aufmacht und dabei dieses hier schliesst, sondern eine Seite
      // DERSELBEN Schale.
      const btBtn = zepButton(ICONS.settings, "still", zeigtSeite("bluetooth"))
      btBtn.set_tooltip_text(_("Bluetooth devices - the same page as above"))
      btRow.append(btIcon)
      btRow.append(btLabel)
      btRow.append(btBtn)

      const div1 = new Gtk.Separator({ orientation: Gtk.Orientation.HORIZONTAL })
      div1.add_css_class("cc-divider")

      // ===== TON UND BILD =====
      //
      // NUR NOCH ZWEI ZEILEN SEIT AUFGABE 17 (19.08.2026): Lautstaerke,
      // Mikrofon und Helligkeit sind auf ihre eigenen Seiten umgezogen
      // (soundSeite, displaySeite - siehe unten in dieser Datei). Die
      // Ueberschrift "SOUND & DISPLAY" bleibt trotzdem stehen, weil sie
      // fuer die BEIDEN verbliebenen Zeilen weiterhin stimmt:
      // mediaRow handelt von dem, was durch die Lautstaerke hindurchgeht
      // (Wiedergabe), displayRow oeffnet die Bildschirmanordnung (nwg-
      // displays-Nachfolger) - beides Nebenfunktionen dieses Fensters,
      // keine der beiden ist "die" Lautstaerke- oder Helligkeitsregelung
      // selbst, die jetzt auf ihrer eigenen Seite steht.
      const audioTitle = new Gtk.Label({ label: _("SOUND & DISPLAY"), xalign: 0 })
      audioTitle.add_css_class("cc-section-title")

      // Zeile: die Wiedergabe
      //
      // SIE STEHT UNTER TON & BILD, weil sie dorthin gehoert: darueber
      // die Lautstaerke, hier das, was durch sie hindurchgeht. Und sie
      // ist die einzige Zeile dieses Abschnitts, die sich ausblendet -
      // Lautstaerke, Mikrofon und Helligkeit gibt es immer, einen
      // Spieler nicht.
      //
      // DREI KNOEPFE UND KEIN REGLER: playerctl kann zurueck, anhalten
      // und weiter, und alle drei sind dieselben Befehle, die die
      // Medientasten der Tastatur schicken. Ein vierter Knopf fuer
      // etwas, das playerctl nicht kann, waere Spec §7.4.
      // ZWEI ZEILEN UND NICHT EINE, und das ist gemessen.
      //
      // Zuerst standen Zeichen, Titel und die drei Knoepfe nebeneinander.
      // GEMESSEN am 12.08.2026 auf einem Bildschirmabzug: das Fenster
      // ist 495 Punkte breit, Zeichen und Knoepfe nehmen davon rund 250,
      // und vom Titel "Die Band – Das Lied" blieb "Die Band – D…". Ein
      // Bedienelement, das gegen seine eigene Beschriftung um den Platz
      // kaempft, gewinnt immer - und die Beschriftung war das, was
      // gefehlt hat.
      //
      // Untereinander kostet die Zeile rund 50 Punkte mehr und der Titel
      // bekommt die ganze Breite.
      mediaRow = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL, spacing: 4, visible: false,
      })
      mediaRow.add_css_class("cc-row")

      const mediaTitleRow = new Gtk.Box({ spacing: 8 })
      mediaIcon = new Gtk.Label({ label: ICONS.music })
      mediaIcon.add_css_class("cc-icon")
      mediaLabel = ccLabel("")
      mediaTitleRow.append(mediaIcon)
      mediaTitleRow.append(mediaLabel)

      const mediaButtons = new Gtk.Box({
        spacing: 8, halign: Gtk.Align.CENTER, homogeneous: true,
      })

      // zepButton, Rolle "still" (Task D, 18.08.2026): Wiedergabe ist
      // ein Nebenweg dieses Fensters (siehe Kommentar am Kopf des
      // Abschnitts WIEDERGABE oben), keine Hauptsache.
      const mediaButton = (icon: string, tooltip: string,
                           command: string): Gtk.Button => {
        const button = zepButton(icon, "still", async () => {
          await execAsync(["bash", "-c", command])
          updateDisplay()
        })
        button.set_tooltip_text(tooltip)
        return button
      }

      const mediaPrevBtn = mediaButton(
        ICONS.previous, _("Previous track"), "playerctl previous")
      // Der mittlere Knopf traegt sein Zeichen als eigene Beschriftung,
      // weil es sich mit dem Zustand aendert - die anderen beiden nicht.
      // set_child(mediaPlayLabel) ueberschreibt die Beschriftung von
      // zepButton mit der eigenen, von aussen aktualisierbaren Label-
      // Instanz (derselbe Kunstgriff wie volBtn/micBtn oben).
      mediaPlayLabel = new Gtk.Label({ label: ICONS.play })
      const mediaPlayBtn = zepButton("", "still", async () => {
        await execAsync(["bash", "-c", "playerctl play-pause"])
        updateDisplay()
      })
      mediaPlayBtn.set_child(mediaPlayLabel)
      mediaPlayBtn.set_tooltip_text(_("Pause / resume"))
      const mediaNextBtn = mediaButton(
        ICONS.next, _("Next track"), "playerctl next")

      mediaButtons.append(mediaPrevBtn)
      mediaButtons.append(mediaPlayBtn)
      mediaButtons.append(mediaNextBtn)

      mediaRow.append(mediaTitleRow)
      mediaRow.append(mediaButtons)

      // Zeile: die Bildschirme
      //
      // GEMELDET am 12.08.2026 auf echter Hardware: "ich finde den
      // display manager nicht". Die Anwendung dafuer gibt es - die
      // Seite "Bildschirme" von zepos-settings-gui, die am selben Tag
      // nwg-displays abgeloest hat -, und vom Kontrollzentrum fuehrte
      // kein Weg dorthin. Eine Anwendung, die man nur findet, wenn man
      // ihren Namen schon kennt, ist fuer den, der sie sucht, nicht da.
      //
      // `--page bildschirme` und nicht nur der Programmname: der
      // Schalter existiert genau dafuer (siehe page_of() in
      // settings/zepos_settings_gui/main.py, "damit zepos-menu die
      // BILDSCHIRME findet und nicht nur die Anwendung, in der sie
      // liegen"). Er wird hier zum zweiten Mal benutzt, aus demselben
      // Grund.
      //
      // IMMER SICHTBAR, im Unterschied zu den vier bedingten Zeilen
      // dieses Fensters: einen Bildschirm hat dieser Rechner immer.
      const displayRow = new Gtk.Box({ spacing: 10 })
      displayRow.add_css_class("cc-row")
      const displayIcon = new Gtk.Label({ label: ICONS.displays })
      displayIcon.add_css_class("cc-icon")
      const displayLabel = ccLabel(_("Displays"))
      // zepButton, Rolle "still": reine Navigation.
      //
      // SEIT AUFGABE 32 (19.08.2026) IN DIE EIGENE OBERFLAECHE UND NICHT
      // MEHR IN EIN FREMDES PROGRAMM: hier stand `execAsync(["zepos-
      // settings-gui", "--page", "bildschirme"])`, also ein zweiter
      // Prozess mit einem GTK4/libadwaita-Fenster daneben. Die Seite
      // gibt es seit heute als Seite eines AGS-Fensters (ags-settings.
      // template), und `opens()` erreicht sie ueber toggleByName()
      // ("settings:bildschirme") - derselbe Weg, den Netz, Bluetooth und
      // VPN am 18.08.2026 genommen haben, als sie Seiten wurden.
      const displayBtn = zepButton(ICONS.launch, "still",
                                   opens("settings:bildschirme"))
      displayBtn.set_tooltip_text(
        _("Set arrangement, resolution and refresh rate"))
      displayRow.append(displayIcon)
      displayRow.append(displayLabel)
      displayRow.append(displayBtn)

      const div2 = new Gtk.Separator({ orientation: Gtk.Orientation.HORIZONTAL })
      div2.add_css_class("cc-divider")

      // ===== SCHREIBTISCH =====
      //
      // WOHER DIESER ABSCHNITT KOMMT (12.08.2026, Aufgabe #96)
      //     BESTELLT wurde eine Leiste mit "in der mitte die
      //     arbeitsbereiche links die uhrzeit und datum den rest kennst
      //     du". Sieben Module, die vorher auf der Leiste standen,
      //     gehoeren nicht in diesen Rest - sie sind aber auch nicht
      //     geloescht worden, sondern UMGEZOGEN, und das ist dieser
      //     Abschnitt.
      //
      //     Ein Modul, das ersatzlos verschwindet, ist eine Funktion,
      //     die der Nutzer verliert. Er kann jedes davon in den
      //     Einstellungen wieder auf die Leiste stellen (Seite
      //     "Leiste"); dieser Abschnitt ist der Weg fuer den, der die
      //     Einstellungen gar nicht erst suchen soll.
      //
      // WARUM HIER UND NICHT IM STARTMENUE
      //     Es sind Anzeigen und Aufklappfenster dieses Prozesses,
      //     keine Anwendungen. Drei der sieben Knoepfe rufen
      //     toggle() - eine Funktion IM SELBEN PROZESS -, und ein
      //     Startmenue kann das nicht: es startet Programme.
      const deskTitle = new Gtk.Label({ label: _("DESKTOP"), xalign: 0 })
      deskTitle.add_css_class("cc-section-title")

      /** Eine Zeile aus Zeichen, Text und einem Knopf, der etwas tut.
       *
       * Sieben Zeilen sahen ausgeschrieben siebenmal gleich aus - das
       * sind 21 Widgets, deren einziger Unterschied drei Zeichenketten
       * und ein Rueckruf sind. Der Kasten oben (mediaButton) macht es
       * fuer die Wiedergabetasten schon genauso.
       */
      // `action` darf null sein, und das ist keine Bequemlichkeit: eine
      // Zeile ohne Ziel bekommt dann KEINEN Knopf. Ein Knopf, hinter
      // dem nichts passiert, ist nach Spec §7.4 der schlimmste Fehler,
      // den ZepOS erzeugen kann - und genau daran ist am 12.08.2026
      // das Zahnrad im Fuss aufgefallen.
      const deskRow = (icon: string, text: string, tooltip: string,
                       action: (() => void) | null): [Gtk.Box, Gtk.Label] => {
        const row = new Gtk.Box({ spacing: 10 })
        row.add_css_class("cc-row")
        const iconLabel = new Gtk.Label({ label: icon })
        iconLabel.add_css_class("cc-icon")
        const label = ccLabel(text)
        row.append(iconLabel)
        row.append(label)
        if (action) {
          // zepButton, Rolle "still" (Task D, 18.08.2026): jede Zeile
          // dieses Bausteins oeffnet ein anderes Fenster oder startet
          // ein Werkzeug - Navigation, keine Hauptsache.
          const button = zepButton(ICONS.launch, "still", action)
          button.set_tooltip_text(tooltip)
          row.append(button)
        }
        return [row, label]
      }

      const [weatherBox, weatherText] = deskRow(
        ICONS.weather, "", _("Set the location for the weather"),
        // Aufgabe 32 (19.08.2026): die Seite "Wetter" des eigenen
        // Einstellungsfensters statt eines zweiten Prozesses - siehe
        // die Begruendung bei displayBtn weiter oben.
        opens("settings:wetter"))
      weatherRow = weatherBox
      weatherLabel = weatherText
      weatherRow.set_visible(false)

      // OHNE Knopf, im Unterschied zu allen anderen Zeilen hier: die
      // Zusatzuhren stehen unter "clocks.zones" in user-settings.json,
      // und das Einstellungsfenster hat dafuer KEINE Seite. Ein Knopf,
      // der stattdessen irgendeine andere Seite aufmacht, taete etwas
      // anderes, als er sagt.
      const [clocksBox, clocksText] = deskRow(
        ICONS.clock, "", "", null)
      clocksRow = clocksBox
      clocksLabel = clocksText
      clocksRow.set_visible(false)

      const [hardwareBox, hardwareText] = deskRow(
        ICONS.hardware, _("Hardware"), _("Open btop"), runs(SCRIPTS.btop))
      hardwareLabel = hardwareText

      const [shortcutsBox] = deskRow(
        ICONS.keyboard, _("Keyboard shortcuts"),
        _("Show all keyboard shortcuts"),
        opens("shortcuts"))
      const [floatingBox] = deskRow(
        ICONS.floating, _("Floating windows"),
        _("Restore the saved arrangement"),
        runs(SCRIPTS.floating))
      const [wallpaperBox] = deskRow(
        ICONS.wallpaper, _("Wallpaper"), _("Choose another image"),
        opens("wallpaper"))
      const [diskBox] = deskRow(
        ICONS.disk, _("Disk space"), _("Show how the drives are filled"),
        opens("disk"))

      const div2b = new Gtk.Separator({ orientation: Gtk.Orientation.HORIZONTAL })
      div2b.add_css_class("cc-divider")

      // ===== SYSTEMDIENSTE =====
      const sysTitle = new Gtk.Label({ label: _("SYSTEM SERVICES"), xalign: 0 })
      sysTitle.add_css_class("cc-section-title")

      // Zeile: der Drucker
      const printerRow = new Gtk.Box({ spacing: 10 })
      printerRow.add_css_class("cc-row")
      const printerIcon = new Gtk.Label({ label: ICONS.printer })
      printerIcon.add_css_class("cc-icon")
      printerIcon.add_css_class("printer-icon")
      printerLabel = ccLabel(_("Printer"))
      // zepButton, Rolle "still" (Task D, 18.08.2026): oeffnet ein
      // eigenes Werkzeug, Navigation.
      //
      // GEMESSEN am 12.08.2026: hier stand `system-config-printer`, und
      // packaging/zepos-apps/PKGBUILD nennt genau diesen Namen in der
      // Liste dessen, was ABSICHTLICH fehlt ("GTK3, alle gemessen").
      // Der Knopf war also auf jeder Installation ein Knopf, hinter dem
      // nichts passiert - Spec §7.4, und der Fehler, den niemand meldet.
      //
      // Das Werkzeug fuer dieselbe Aufgabe liefert ZepOS selbst aus:
      // printer-manager-config.template erzeugt ~/.local/bin/printer-
      // manager, das ueber lpstat/lpinfo/lpadmin geht und sein Menue mit
      // zepos-menu zeichnet. Es ist der Grund, aus dem cups ueberhaupt
      // in der Auswahl steht.
      const printerBtn = zepButton(ICONS.settings, "still", () => {
        execAsync(`${HOME}/.local/bin/printer-manager`)
        closeFn?.()
      })
      printerRow.append(printerIcon)
      printerRow.append(printerLabel)
      printerRow.append(printerBtn)

      // Zeile: der Netz-Watchdog
      const watchdogRow = new Gtk.Box({ spacing: 10 })
      watchdogRow.add_css_class("cc-row")
      watchdogIcon = new Gtk.Label({ label: ICONS.watchdog })
      watchdogIcon.add_css_class("cc-icon")
      watchdogLabel = ccLabel(_("Network watchdog"))
      // zepButton, Rolle "still" (Task D, 18.08.2026): startet ein
      // Werkzeug in einem eigenen Terminalfenster, Navigation.
      const watchdogBtn = zepButton(ICONS.launch, "still", () => {
        // OHNE das kaufmaennische Und, das hier bis zum 12.08.2026
        // stand. execAsync startet KEINE Shell - es zerlegt die
        // Zeichenkette mit GLib.shell_parse_argv und startet argv
        // direkt (die Messung dazu steht im Kopf von
        // tests/src/test_ags_exec.py). Das "&" war damit kein
        // Hintergrundzeichen, sondern ein ARGUMENT, das
        // network-watchdog.sh hinter "--once" zugestellt bekam.
        // Gebraucht wurde es ohnehin nicht: execAsync ist asynchron.
        execAsync(`kitty --class floating-center -e ${ZEPOS_USER_ROOT}/helpers/network-watchdog.sh --once`)
        closeFn?.()
      })
      watchdogRow.append(watchdogIcon)
      watchdogRow.append(watchdogLabel)
      watchdogRow.append(watchdogBtn)

      // Zeile: die Hilfsskripte
      const helpersRow = new Gtk.Box({ spacing: 10 })
      helpersRow.add_css_class("cc-row")
      const helpersIcon = new Gtk.Label({ label: ICONS.helpers })
      helpersIcon.add_css_class("cc-icon")
      helpersIcon.add_css_class("helpers-icon")
      helpersLabel = ccLabel(_("Helper scripts"))
      // zepButton, Rolle "still" (Task D, 18.08.2026): oeffnet den
      // Hilfsskripte-Starter, Navigation.
      const helpersBtn = zepButton(ICONS.launch, "still", () => {
        execAsync(SCRIPTS.helpersLauncher)
        closeFn?.()
      })
      helpersRow.append(helpersIcon)
      helpersRow.append(helpersLabel)
      helpersRow.append(helpersBtn)

      // Zeile: der Style Editor
      //
      // SIE WAR AM 17.08.2026 EINEN HALBEN TAG LANG FORT, aus derselben
      // Regel wie die Netz- und die Bluetooth-Zeile und mit demselben
      // Ergebnis: "im control panel soll alles wie vorher sein alle
      // funktionen auch im control panel aber auch ausserhalb".
      //
      // Der Befund, der zur Loeschung gefuehrt hat, bleibt richtig:
      // unter einer Ueberschrift "Systemdienste" sucht niemand das
      // Aussehen, und deshalb traegt die Leiste seit demselben Tag ein
      // eigenes Modul dafuer (custom/theme, ICON_PALETTE - dasselbe
      // Zeichen wie hier). Der Fehler war nur die Folgerung. Beide
      // Knoepfe rufen `opens("style")`, also DASSELBE widgets.style;
      // eine zweite Fassung gibt es nicht.
      //
      // "Style Editor" bleibt englisch, und das ist Absicht: es ist der
      // NAME des Fensters, das dieser Knopf oeffnet
      // (ags-style-editor.template traegt ihn als headerTitle). Eine
      // Zeile, die anders heisst als das, was sie aufmacht, waere ein
      // zweiter Name fuer eine Sache.
      const styleRow = new Gtk.Box({ spacing: 10 })
      styleRow.add_css_class("cc-row")
      const styleIcon = new Gtk.Label({ label: ICONS.palette })
      styleIcon.add_css_class("cc-icon")
      const styleLabel = ccLabel(_("Style editor"))
      // zepButton, Rolle "still" (Task D, 18.08.2026): Navigation zum
      // Stil-Editor, wie netBtn/btBtn oben.
      const styleBtn = zepButton(ICONS.launch, "still", opens("style"))
      styleBtn.set_tooltip_text(
        _("Appearance and colors - the same window as above"))
      styleRow.append(styleIcon)
      styleRow.append(styleLabel)
      styleRow.append(styleBtn)

      // Zeile: was ansteht
      //
      // src/update.py ist seit dem 12.08.2026 vollstaendig - und hatte
      // KEINE Oberflaeche. `zepos-update --status` in einem Terminal
      // war der ganze Weg, und der Nutzer erfuhr nie, dass etwas
      // ansteht.
      //
      // WAS HIER STEHT, IST DER SATZ DES MODULS SELBST. updates.sh legt
      // `zepos-update --status` in das Feld "detail" - also describe()
      // aus update.py, im Wortlaut. Ihn hier nachzubauen hiesse,
      // dieselbe Auskunft ein zweites Mal zu formulieren, und beim
      // naechsten Feld in update.py haette der Nutzer zwei Saetze, die
      // einander widersprechen.
      //
      // WAS DER KNOPF TUT, entscheidet der ZUSTAND - siehe updateAction
      // oben. Vier Zustaende, vier Befehle, und keiner von ihnen ist
      // eine zweite Aktualisierungslogik: es sind die vier Programme,
      // die es fuer diese vier Faelle ohnehin schon gibt.
      updateRow = new Gtk.Box({ spacing: 10, visible: false })
      updateRow.add_css_class("cc-row")
      const updateIcon = new Gtk.Label({ label: ICONS.update })
      updateIcon.add_css_class("cc-icon")
      updateLabel = new Gtk.Label({
        label: "", hexpand: true, xalign: 0, wrap: true,
        max_width_chars: {{STYLE_MEASURE_LINE}},
      })
      updateLabel.add_css_class("cc-label")
      // DER EINE `voll`-KNOPF DIESES FENSTERS (Task D, 18.08.2026)
      //
      // Alle anderen Knoepfe hier oeffnen entweder ein anderes Fenster
      // (still: netBtn/vpnBtn/btBtn/styleBtn/displayBtn/printerBtn/
      // watchdogBtn/helpersBtn/die deskRow-Zeilen), sind ein kleiner
      // Nebenweg (still: Wiedergabe, Stummschalten) oder beenden die
      // Sitzung (kritisch: die drei Abschaltknoepfe unten). Keiner
      // davon ist "die Hauptsache" dieses Fensters im Sinne des
      // Musters - sie bestehen, ob man sie anschaut oder nicht.
      //
      // updateRow dagegen ist NUR sichtbar, wenn wirklich etwas
      // ansteht (siehe updateDisplay oben, updateRow.set_visible), und
      // dieser Knopf tut genau DAS, weswegen die Zeile ueberhaupt
      // aufgegangen ist - die einzige Zeile des ganzen Fensters, die
      // auf einen Zustand reagiert statt bloss Auskunft zu geben oder
      // woanders hinzufuehren. Ein Kontrollzentrum, das etwas zu
      // melden hat, soll genau darauf hinweisen - das ist "voll".
      updateBtn = zepButton(ICONS.launch, "voll", () => {
        // Die Seite zuerst: sie ist der einzige der fuenf Zustaende, der
        // kein Terminal braucht (Aufgabe 32, 19.08.2026).
        if (updateSeite) {
          toggle(updateSeite)
          closeFn?.()
          return
        }
        if (!updateAction) return
        // Im Terminal und nicht im Hintergrund: drei der vier Befehle
        // fragen nach etwas - sudo nach dem Passwort, pacman nach der
        // Bestaetigung -, und eine Rueckfrage, die niemand sieht, ist
        // ein Befehl, der nicht laeuft. `floating-center` ist die
        // Fensterklasse, die die Zeile darueber schon benutzt.
        execAsync(["kitty", "--class", "floating-center",
                   "-e", "bash", "-c",
                   `${updateAction}; echo; read -rp "[Eingabetaste]"`])
        closeFn?.()
      })
      updateRow.append(updateIcon)
      updateRow.append(updateLabel)
      updateRow.append(updateBtn)

      const div3 = new Gtk.Separator({ orientation: Gtk.Orientation.HORIZONTAL })
      div3.add_css_class("cc-divider")

      // ===== SITZUNG: eine Zeile statt eines eigenen Rasters =====
      //
      // BIS ZUM 19.08.2026 STAND HIER EIN FUENFER-RASTER MIT SECHS
      // BEFEHLEN IN DIESER DATEI SELBST
      //     POWER_BUTTONS trug fuenf Zeilen (Herunterfahren, Neustart,
      //     Bereitschaft, Sperren, Abmelden - kein Ruhezustand) mit
      //     ihren eigenen `execAsync(cmd)`-Aufrufen, DANEBEN die
      //     Abmeldemaske zepos-logout mit denselben fuenf plus
      //     Ruhezustand als sechste, in einer ZWEITEN, unabhaengig
      //     gepflegten layout.json. Zwei Listen derselben Befehle -
      //     schon damals nicht deckungsgleich (Ruhezustand fehlte hier),
      //     und der Auftrag, der ein neues AGS-Fenster fuer diese sechs
      //     Aktionen baut (ags-logout.template, siehe dort), haette
      //     daraus DREI gemacht.
      //
      //     Aufgabe 26 raeumt das ab, genau wie Aufgabe 7/8/9 es fuer
      //     Bluetooth/Netzwerk/VPN schon getan haben (siehe die
      //     Kommentare bei netBtn/vpnBtn/btBtn oben): diese Zeile
      //     TRAEGT keinen Befehl mehr selbst, sie OEFFNET das eine
      //     Fenster, das alle sechs kennt - `opens("logout")`, derselbe
      //     Weg wie styleRow oben. Die Rollenzuordnung ("kritisch" fuer
      //     Abmelden/Neustart/Herunterfahren, "umrandet" fuer
      //     Sperren/Bereitschaft/Ruhezustand) lebt jetzt dort, mit der
      //     ausfuehrlichen Begruendung, die vorher hier stand.
      const sessionRow = new Gtk.Box({ spacing: 10 })
      sessionRow.add_css_class("cc-row")
      const sessionIcon = new Gtk.Label({ label: ICONS.power })
      sessionIcon.add_css_class("cc-icon")
      const sessionLabel = ccLabel(_("Session"))
      // zepButton, Rolle "still" (wie netBtn/vpnBtn/btBtn/styleBtn
      // oben): Navigation zu einem anderen Fenster, keine eigene
      // Handlung.
      const sessionBtn = zepButton(ICONS.launch, "still", opens("logout"))
      sessionBtn.set_tooltip_text(
        _("Lock, log out, restart, shut down, suspend or hibernate"))
      sessionRow.append(sessionIcon)
      sessionRow.append(sessionLabel)
      sessionRow.append(sessionBtn)

      // ===== ZUSAMMENSETZEN =====
      mainBox.append(privacyBox)
      mainBox.append(netTitle)
      mainBox.append(netRow)
      mainBox.append(ipRow)
      mainBox.append(vpnRow)
      mainBox.append(btRow)
      mainBox.append(div1)
      mainBox.append(audioTitle)
      mainBox.append(mediaRow)
      mainBox.append(displayRow)
      mainBox.append(div2)
      mainBox.append(deskTitle)
      mainBox.append(weatherRow)
      mainBox.append(clocksRow)
      mainBox.append(hardwareBox)
      mainBox.append(shortcutsBox)
      mainBox.append(floatingBox)
      mainBox.append(wallpaperBox)
      mainBox.append(diskBox)
      mainBox.append(div2b)
      mainBox.append(sysTitle)
      mainBox.append(printerRow)
      mainBox.append(watchdogRow)
      mainBox.append(helpersRow)
      mainBox.append(styleRow)
      mainBox.append(updateRow)
      mainBox.append(div3)
      mainBox.append(sessionRow)

      // DER TAKT LAEUFT FUER DIE LEBENSDAUER DER SCHALE, NICHT MEHR NUR
      // "SOLANGE DAS FENSTER OFFEN IST" - UND TROTZDEM OHNE DIE 300
      // PROZESSSTARTS JE MINUTE, DIE DAS AM 12.08.2026 GEKOSTET HAT
      //
      // ShellConfig (ags-overlay-utils.template, Aufgabe 5) kennt kein
      // onShow/onHide mehr - createShellWindow() ruft bauen() GENAU
      // EINMAL, beim Start der Oberflaeche (dokumentiert am Kopf von
      // ShellSeite.bauen dort: "er laeuft danach fuer die Lebensdauer
      // der Schale weiter, auch waehrend eine ANDERE Seite aktiv ist" -
      // wie es ags-bluetooth.template und ags-network.template mit
      // ihrem eigenen `interval(UPDATE_INTERVAL, updateDisplay)" in
      // buildContent schon tun, siehe dort). Hier stand bis heute
      // `ticker = interval(...)` in onShow und `ticker?.cancel()` in
      // onHide - beide Rueckrufe gibt es nicht mehr.
      //
      // Ersetzt durch dieselbe Loesung wie bei Bluetooth/Netzwerk: der
      // Takt LAEUFT durch, aber sein Rueckruf fragt zuerst `win.visible`
      // und tut sonst nichts. Der Unterschied zu deren `windowIsUp`-
      // Schalter ist nur, WOHER die Antwort kommt - dort ein eigenes
      // Feld, gesetzt in onShow/onHide; hier das Fenster selbst, weil
      // ShellSeite.bauen() genau dieses `win` schon in der Hand haelt
      // und kein onShow/onHide braucht, um es zu kennen.
      //
      // UND EIN ZWEITER RUECKRUF FUER DIE SOFORTIGE FRISCHE BEIM OEFFNEN
      //
      //     Der alte Takt (`ticker = interval(...)` in onShow) feuerte
      //     bei JEDEM Aufgehen sofort - Timer.interval() tut das beim
      //     ERSTEN Mal immer. Ein Takt, der nur alle drei Sekunden
      //     nachsieht, ob das Fenster gerade sichtbar wurde, liesse den
      //     Nutzer bis zu drei Sekunden lang die Zahlen vom letzten
      //     Zumachen sehen. `notify::visible` ist GTK4s eigenes Signal
      //     fuer genau diesen Wechsel (win.visible = true in show()
      //     loest es aus, siehe ags-overlay-utils.template) - es holt
      //     die Sofortigkeit des alten onShow zurueck, ohne dass die
      //     Fabrik dafuer etwas Neues lernen muesste.
      //
      // NICHT AM ECHTEN COMPOSITOR NACHGEMESSEN: tests/render/ ist fuer
      // diese Aufgabe verboten (Blattkopf). Beide Zeilen sind eine
      // Lesart der GTK4-Dokumentation zu GObject-Eigenschaften
      // (notify::<eigenschaft> feuert bei jeder Wertaenderung, auch bei
      // einer programmatischen) und keine eigene Messung.
      interval(UPDATE_INTERVAL, () => { if (win.visible) updateDisplay() })
      win.connect("notify::visible", () => {
        if (win.visible) updateDisplay()
      })

      return mainBox
    },
  }

  return createShellWindow({
    name: "control",
    cssClass: "ControlCenter",
    // VERBINDUNGEN vor SYSTEM, siehe der Kommentar bei gruppeVerbindungen
    // oben - die Reihenfolge hier IST die Reihenfolge der Seitenleiste.
    seiten: [networkSeite, bluetoothSeite, vpnSeite,
            generalSeite, soundSeite, displaySeite],
    // Wer das Kontrollzentrum oeffnet (Zahnrad in der Leiste, wie schon
    // vor Aufgabe 6), sieht zuerst dieselbe Seite, die er bisher als
    // ganzes Fenster gesehen hat - "general" und nicht die erste
    // Seitenleisten-Gruppe (VERBINDUNGEN), die heute nur Umzugshinweise
    // zeigt.
    startSeite: "general",
  })
}
