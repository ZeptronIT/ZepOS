// Eine JSON-Zeile aus einem der drei gemeinsamen Skripte.
//
// Ein leeres Objekt bei jedem Fehler und kein Wurf: die drei Zeilen,
// die daraus entstehen, blenden sich bei leerem Inhalt ohnehin aus -
// ein fehlendes Skript sieht damit genauso aus wie "nichts zu melden",
// und das ist hier richtig. Der Erzeuger schreibt alle drei, und wenn
// er es nicht getan hat, ist das kein Zustand, den DIESES Fenster
// erklaeren kann.
async function readJson(command: string): Promise<Record<string, any>> {
  try {
    const output = await execAsync(["bash", "-c", command])
    const line = output.trim()
    if (!line) return {}
    return JSON.parse(line) as Record<string, any>
  } catch {
    return {}
  }
}

// Eine Liste von Programmnamen als ein Satzstueck.
function joined(value: unknown): string {
  return Array.isArray(value) ? value.join(", ") : ""
}

// Ein Behaelter leeren, bevor ein frisches Bauteil hineinkommt - dieselbe
// Funktion wie in ags-network.template/ags-bluetooth.template, hier
// gebraucht seit Aufgabe 17 (19.08.2026): soundSeite/displaySeite bauen
// ihren zepStateHeader jeden Takt neu (er kennt keinen Mutator fuer
// seinen Text), genau wie statusWrap dort.
function removeAllChildren(box: Gtk.Box): void {
  let child = box.get_first_child()
  while (child) {
    const next = child.get_next_sibling()
    box.remove(child)
    child = next
  }
}

// Ein Skript rufen
//
// EIN SKRIPT, DAS SEINEN EIGENEN PFAD AUSGIBT, HAT NICHT GEANTWORTET -
// GEAENDERT am 19.08.2026, GEMELDET vom Nutzer zum zweiten Mal.
//
//     ags-network-scripts.template faengt eine unbekannte Aktion im
//     `*)`-Zweig ab und antwortet mit "Usage: $0 {...}" - `$0` ist der
//     Skriptpfad. Das ist eine ZEILE und kein leerer String, also
//     griff kein `|| Rueckfall` in einer aufrufenden Funktion, und der
//     Pfad landete unveraendert auf dem Bildschirm - so gefunden bei
//     `icon` und `bluetooth`, zwei Aktionen, die dieses Skript seit
//     dem 17.08.2026 nicht mehr kennt (siehe SCRIPTS.status oben).
//
//     Diese Pruefung faengt die Zeile HIER ab, an einer Stelle statt
//     an acht: jeder kuenftige Aufruf mit einer unbekannten Aktion
//     bekommt denselben Rueckfall, den er fuer ein STUMMES Skript
//     ohnehin schon vorsieht, statt seines eigenen Dateipfads.
//     tests/src/test_ags_network.py haelt zusaetzlich die gerufenen
//     Aktionen gegen den `case`-Zweig, damit eine neue unbekannte
//     Aktion gar nicht erst entsteht.
async function runScript(action: string): Promise<string> {
  try {
    const output = await execAsync([SCRIPTS.network, action])
    const line = output.trim()
    return line.startsWith("Usage:") ? "" : line
  } catch {
    return ""
  }
}

// Was das Netz meldet
