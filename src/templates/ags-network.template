function getSignalIcon(signal: number): string {
  if (signal >= 75) return ICONS.signal4
  if (signal >= 50) return ICONS.signal3
  if (signal >= 25) return ICONS.signal2
  return ICONS.signal1
}

/** Die Netze in Reichweite.
 *
 * `mitSuchlauf` ENTSCHEIDET UEBER ZWEI GROESSENORDNUNGEN, UND DAS IST
 * GEMESSEN (20.08.2026, Aufgabe 36, Maschine des Nutzers):
 *
 *     false  aus dem Zwischenspeicher von NetworkManager      13 ms
 *     true   echter Suchlauf, auf sein Ergebnis gewartet    3552 ms
 *                                                       und 5899 ms
 *
 * Die zweite Zahl laesst sich NICHT wegoptimieren: ein Suchlauf wartet
 * auf Funkverkehr, nicht auf Rechenzeit. Sie laesst sich nur aus dem
 * Weg raeumen - updateDisplay() zeigt darum ZUERST den Zwischenspeicher
 * und laesst den Suchlauf danach nachliefern.
 */
async function scanWifi(mitSuchlauf: boolean): Promise<WifiNetwork[]> {
  const networks: WifiNetwork[] = []
  try {
    const argumente = mitSuchlauf
      ? [SCRIPTS.network, "list", "rescan"]
      : [SCRIPTS.network, "list"]
    const output = await execAsync(argumente)
    const parsed = JSON.parse(output.trim())
    for (const net of parsed) {
      networks.push({ ssid: net.ssid, signal: net.signal, security: net.secure ? "WPA" : "",
                      active: net.active, bssid: net.bssid || "" })
    }
  } catch (e) { console.error("Die WLAN-Suche schlug fehl:", e) }
  return networks.sort((a, b) => b.signal - a.signal)
}

/** Die aktuelle Verbindung.
 *
 * SUCHT SEIT DEM 20.08.2026 NICHT MEHR SELBST (Aufgabe 36)
 *     Hier stand `const networks = await scanWifi()`, nur um die
 *     Signalstaerke der aktiven Verbindung zu erfahren - und
 *     updateDisplay() rief scanWifi() unmittelbar DANACH ein zweites
 *     Mal. GEMESSEN am 20.08.2026: zwei Suchlaeufe zu je 1060 ms in
 *     einem einzigen Aufbau, also 1060 ms geschenkt, fuer Daten, die
 *     der Aufrufer schon hatte.
 *
 *     Die Liste kommt jetzt als Parameter herein. Wer die Signalstaerke
 *     braucht, hat die Liste ohnehin - und wer sie nicht hat, uebergibt
 *     eine leere und bekommt 0, genau wie vorher bei einem
 *     fehlgeschlagenen Suchlauf.
 *
 * Die beiden verbliebenen Fragen laufen GLEICHZEITIG (Promise.all) statt
 * nacheinander: sie wissen nichts voneinander.
 */
async function getConnectionInfo(
  networks: WifiNetwork[],
): Promise<ConnectionInfo> {
  try {
    const [name, ip] = await Promise.all([
      execAsync([SCRIPTS.network, "info"]),
      execAsync([SCRIPTS.network, "ip"]),
    ])
    let type = "none", signal = 0, bssid = ""
    if (name.trim() && name.trim() !== NOT_CONNECTED) {
      if (name.trim() === WIRED_NAME) { type = "ethernet" }
      else {
        type = "wifi"
        // Signalstaerke UND Adresse des Zugangspunktes stammen aus
        // derselben Zeile derselben Liste - wer die eine hat, hat die
        // andere schon. Eine eigene Frage danach waere genau der
        // doppelte Aufruf, den der Kommentar ueber dieser Funktion
        // beschreibt.
        const active = networks.find(n => n.active)
        if (active) { signal = active.signal; bssid = active.bssid }
      }
    }
    return { type, name: name.trim() || NOT_CONNECTED, ip: ip.trim() || "", signal, bssid }
  } catch { return { type: "none", name: NOT_CONNECTED, ip: "", signal: 0, bssid: "" } }
}

async function connectToNetwork(ssid: string, password?: string): Promise<boolean> {
  try {
    if (password) { await execAsync([SCRIPTS.network, "connect", ssid, password]) }
    else { await execAsync([SCRIPTS.network, "connect", ssid]) }
    await new Promise(resolve => setTimeout(resolve, 2000))
    // OHNE Netzliste: hier wird nur gefragt, OB die Verbindung steht,
    // nicht wie stark sie ist. Ein Suchlauf an dieser Stelle waere
    // dieselbe Verwechslung, die getConnectionInfo() am 20.08.2026
    // losgeworden ist (siehe dort).
    const info = await getConnectionInfo([])
    return info.name === ssid || info.type !== "none"
  } catch (e) { console.error("Das Verbinden schlug fehl:", e); return false }
}

async function disconnect() {
  try { await execAsync(["bash", "-c", "nmcli con down $(nmcli -t -f NAME con show --active | head -1) 2>/dev/null || true"]) }
  catch (e) { console.error("Das Trennen schlug fehl:", e) }
}

function removeAllChildren(box: Gtk.Box) {
  let child = box.get_first_child()
  while (child) { const next = child.get_next_sibling(); box.remove(child); child = next }
}

