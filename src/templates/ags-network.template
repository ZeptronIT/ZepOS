    // Die Widgets, die spaeter beschrieben werden. Sie stehen hier und
    // nicht weiter unten im Rueckgabewert, weil updateDisplay() und die
    // drei Ansichtswechsel sie von aussen erreichen muessen.
    // statusIcon/statusLabel/ipLabel und detailSsidLabel/detailSignalLabel/
    // detailSignalIcon sind mit dem Umbau auf die Bauteile (18.08.2026,
    // task-C) gegangen: weder zepRow noch zepStateHeader nehmen Titel
    // und Nebenzeile als etwas anderes als TEXT entgegen, es gibt
    // keinen Griff, sie nachtraeglich zu aendern - statusWrap und
    // detailHeaderWrap tragen darum jeden Takt genau ein frisches
    // Bauteil, derselbe Kunstgriff wie in ags-bluetooth.template.
    // statusWrap traegt seit Aufgabe 12 (18.08.2026) einen
    // zepStateHeader statt einer zepRow (siehe updateDisplay()) -
    // detailHeaderWrap (Unteransicht, kein Gegenstueck bei Bluetooth/
    // VPN) bleibt eine zepRow. `wifiToggle` faellt als eigenes Feld:
    // der Schalter wird seit Aufgabe 12 jeden Takt frisch in
    // `buildWifiToggle()` gebaut, derselbe Kunstgriff wie
    // `buildPowerToggle()` in ags-bluetooth.template.
    let statusWrap: Gtk.Box
    let networkList: Gtk.Box, passwordBox: Gtk.Box, passwordEntry: Gtk.Entry
    let passwordSsidLabel: Gtk.Label, passwordErrorLabel: Gtk.Label, mainContent: Gtk.Box
    let detailBox: Gtk.Box, detailHeaderWrap: Gtk.Box
    let detailSecurityLabel: Gtk.Label, detailIpLabel: Gtk.Label, detailGatewayLabel: Gtk.Label, detailDnsLabel: Gtk.Label
    // Die Geraeteadresse und die des Zugangspunktes (22.08.2026, siehe
    // showDetail()). `detailMacRow` und `detailBssidRow` sind hier
    // mitgefuehrt, weil BEIDE Zeilen ihre Sichtbarkeit vom Zustand
    // abhaengig machen und nicht nur ihren Text.
    let detailMacLabel: Gtk.Label, detailMacHint: Gtk.Label, detailMacCopy: Gtk.Button
    let detailBssidLabel: Gtk.Label, detailBssidRow: Gtk.Box
    let detailDisconnectBtn: Gtk.Button
    // Was der Kopierknopf in die Zwischenablage legt. Der Text der
    // Beschriftung taugt dafuer nicht: steht dort NOTHING, waere der
    // Gedankenstrich das Kopierte.
    let macZumKopieren = ""
    let currentConnectionInfo: ConnectionInfo = { type: "none", name: "", ip: "", signal: 0, bssid: "" }

    // Wo die Ansage "es wird gesucht" steht. Genau EIN Kind oder keines -
    // dieselbe Bauart wie statusWrap darueber.
    let sucheWrap: Gtk.Box

    // DER LETZTE STAND, UEBER DAS SCHLIESSEN HINWEG - NEU am 20.08.2026
    // (Aufgabe 36).
    //
    // Diese beiden Felder sind der Grund, aus dem ein ZWEITES Oeffnen
    // sofort etwas zeigt statt einer leeren Flaeche. Sie leben so lange
    // wie die Schale (bauen() laeuft genau einmal), nicht so lange wie
    // eine Sichtbarkeit - und ein WLAN-Name in der Nachbarschaft ist
    // beim naechsten Oeffnen fast immer noch derselbe.
    //
    // Sie sind ein ZWISCHENSPEICHER und keine Wahrheit: was hier steht,
    // wird bei jedem Aufbau von der frischen Antwort ueberschrieben
    // (51 ms spaeter, siehe updateDisplay()).
    let letzteNetze: WifiNetwork[] = []
    let letzterSchalter = false

    const showPassword = (ssid: string) => {
      connectingSsid = ssid
      currentView = "password"
      passwordSsidLabel.set_text(
        format(_("Password for \"{ssid}\""), { ssid }))
      passwordEntry.set_text("")
      passwordErrorLabel.set_text("")
      passwordBox.set_visible(true)
      mainContent.set_visible(false)
      detailBox.set_visible(false)
      passwordEntry.grab_focus()
    }

    // EINE FRAGE STATT DREI, UND SIE BRINGT DIE GERAETEADRESSE MIT -
    // GEAENDERT am 22.08.2026
    //
    // WAS HIER STAND
    //     Drei `execAsync("bash -c ...")` hintereinander, jedes mit
    //     `await` vor dem naechsten: Gateway, DNS, Verschluesselung.
    //     Drei Shells, drei Prozessketten, drei Wartezeiten - fuer drei
    //     Felder EINER Auskunft, waehrend `details` in
    //     ags-network-scripts.template genau diese Auskunft schon als
    //     Aufgabe hatte und von niemandem gerufen wurde.
    //
    //     Es ist dieselbe Rechnung wie am 20.08.2026 (Aufgabe 36: 2160
    //     ms auf 43 ms) - nicht die einzelne Frage ist teuer, sondern
    //     die Zahl der Fragen. Die Geraeteadresse, der Anlass dieser
    //     Aenderung, kommt darum NICHT als vierter Aufruf dazu: sie ist
    //     ein Feld derselben Antwort.
    //
    // DIE ADRESSE DES ZUGANGSPUNKTES FRAGT GAR NIEMAND
    //     Sie steht in `currentConnectionInfo`, wo sie aus der
    //     Netzliste des laufenden Taktes stammt (siehe
    //     getConnectionInfo). Kein Aufruf, kein Warten.
    const showDetail = async () => {
      currentView = "detail"
      mainContent.set_visible(false)
      passwordBox.set_visible(false)
      detailBox.set_visible(true)

      // OHNE VERBINDUNG IST DIESE ANSICHT SEIT DEM 22.08.2026 ERREICHBAR
      //
      //     Der Anlass: die eigene Geraeteadresse braucht man, um sie in
      //     einem Hochschul-, Firmen- oder Hotelnetz ANZUMELDEN - und
      //     wer das tut, ist noch NICHT verbunden. Eine Ansicht, die nur
      //     im verbundenen Zustand aufgeht, haette die Adresse genau in
      //     dem Fall verschwiegen, fuer den sie gezeigt wird.
      //
      //     Was es ohne Verbindung nicht gibt, steht auch nicht da: kein
      //     Trennen-Knopf, keine Signalstaerke, kein Zugangspunkt.
      const verbunden = currentConnectionInfo.type !== "none"

      // Kopf der Detailansicht als frische zepRow (18.08.2026, task-C) -
      // dieselbe Form wie statusWrap in updateDisplay(), aus demselben
      // Grund: zepRow nimmt Titel und Nebenzeile nur als Text entgegen.
      removeAllChildren(detailHeaderWrap)
      detailHeaderWrap.append(zepRow({
        symbol: getSignalIcon(currentConnectionInfo.signal),
        titel: currentConnectionInfo.name || NOT_CONNECTED,
        unterzeile: verbunden ? `${currentConnectionInfo.signal}%` : NOTHING,
      }))
      detailIpLabel.set_text(currentConnectionInfo.ip || NOTHING)
      detailDisconnectBtn.set_visible(verbunden)

      // Der Zugangspunkt ist die Adresse der GEGENSEITE, und die gibt es
      // nur ueber Funk. An einer Kabelverbindung existiert kein
      // Zugangspunkt, und ohne Verbindung haengt man an keinem - ein
      // Gedankenstrich stuende dort fuer "unbekannt" und behauptete
      // damit, es gaebe eine Antwort. Die Zeile geht darum weg.
      detailBssidRow.set_visible(currentConnectionInfo.type === "wifi")
      detailBssidLabel.set_text(currentConnectionInfo.bssid || NOTHING)

      const leer = () => {
        detailGatewayLabel.set_text(NOTHING)
        detailDnsLabel.set_text(NOTHING)
        detailSecurityLabel.set_text(NOTHING)
        detailMacLabel.set_text(NOTHING)
        detailMacHint.set_visible(false)
        macZumKopieren = ""
        detailMacCopy.set_sensitive(false)
      }

      try {
        const auskunft = JSON.parse(
          (await execAsync([SCRIPTS.network, "details"])).trim())

        detailGatewayLabel.set_text(auskunft.gateway || NOTHING)
        detailDnsLabel.set_text(auskunft.dns || NOTHING)

        // DIE ADRESSE, DIE DAS NETZ SIEHT - und der Hinweis, wenn sie
        // nicht die des Adapters ist. Warum das ausgerechnet die
        // gefaehrliche Stelle dieser Anzeige ist, steht ueber
        // adapter_adresse() in ags-network-scripts.template.
        macZumKopieren = auskunft.mac || ""
        detailMacLabel.set_text(macZumKopieren || NOTHING)
        detailMacCopy.set_sensitive(Boolean(macZumKopieren))
        detailMacHint.set_visible(Boolean(auskunft.mac_wechselt))

        // "Offen" IST EINE AUSSAGE UEBER EIN FUNKNETZ, NICHT UEBER
        // NICHTS - berichtigt am 22.08.2026
        //
        //     Hier stand `secOut.trim() ? ... : pgettext(...,"Open")`,
        //     also: leere Antwort heisst "unverschluesselt". Die
        //     Antwort ist aber auch dann leer, wenn die Frage gar nicht
        //     zu stellen war - an einer Kabelverbindung (nmcli kennt
        //     `802-11-wireless-security` dort nicht) und ohne
        //     Verbindung (es gibt keine, nach der man fragen koennte).
        //     Beide lasen sich als "Sicherheit: Offen", und das ist
        //     keine Auskunft, sondern eine Behauptung.
        //
        // "Offen" im Sinne von UNGESICHERT, nicht im Sinne von
        // "oeffnen" - und darum mit `pgettext`.
        //
        // GEMESSEN am 21.08.2026: dieselbe msgid `_("Open")` stand hier
        // UND in ags-home.template:810, dort als Menuepunkt, der eine
        // Datei OEFFNET. Ein Katalog kennt aber nur EINEN Eintrag je
        // msgid, und der stand auf "Offen" - also las der Nutzer im
        // Rechtsklickmenue des Schreibtischs ein Adjektiv, wo ein
        // Befehl hingehoert.
        //
        // Beides zugleich geht nicht ohne Zusatz. Der Zusatz steht
        // HIER, weil dieses Wort das seltenere ist: `msgid "Open"` ohne
        // Zusatz bleibt der Befehl (jetzt "Oeffnen"), und die
        // Sicherheitsangabe bekommt ihren eigenen Eintrag. Dieselbe
        // Bauweise wie bei der Schirmausrichtung in
        // ags-wallpaper.template.
        if (auskunft.type === "802-11-wireless") {
          detailSecurityLabel.set_text(
            auskunft.security ? String(auskunft.security).toUpperCase()
              : pgettext("wifi security", "Open"))
        } else {
          detailSecurityLabel.set_text(NOTHING)
        }
      } catch (e) {
        console.error("Die Verbindungsauskunft schlug fehl:", e)
        leer()
      }
    }

    const showMain = () => {
      currentView = "main"
      connectingSsid = ""
      passwordBox.set_visible(false)
      detailBox.set_visible(false)
      mainContent.set_visible(true)
    }

    const tryConnect = async () => {
      const password = passwordEntry.get_text()
      if (!password) {
        passwordErrorLabel.set_text(_("Please enter the password"))
        return
      }
      passwordErrorLabel.set_text(_("Connecting ..."))
      const success = await connectToNetwork(connectingSsid, password)
      if (success) { showMain(); setTimeout(updateDisplay, 1000) }
      else {
        passwordErrorLabel.set_text(_("Connection failed"))
        passwordEntry.set_text("")
      }
    }

    /** Eine WLAN-Zeile: eine zepRow mit `aktion`, keine zweite Huelle
     * darum - BERICHTIGT am 19.08.2026 (Bericht Aufgabe 15/16, "Kasten
     * in Kasten"). Hier stand bis dahin `zepButton(umrandet)` um eine
     * zepRow, "dieselbe Zusammensetzung wie createDeviceRow()" - beide
     * Bauteile malen ihre eigene Flaeche, verschachtelt eine sichtbare
     * Doppel-Rundung (Zahlen im Bericht dieser Aufgabe). zepRow traegt
     * die Klickbarkeit seither selbst (siehe `aktion` in
     * ags-kit.template); createDeviceRow() in ags-bluetooth.template
     * traegt dieselbe Reparatur. Das verbundene Netz hebt sich weiter
     * ueber "ausgewaehlt" an zepRow ab statt ueber eine eigene
     * .active-Klasse. */
    const createNetworkRow = (network: WifiNetwork): Gtk.Widget => {
      // Zeilenende: Haekchen bei Verbindung, Schloss bei Sicherung ohne
      // Verbindung, sonst nichts - unveraendert gegenueber vorher, nur
      // jetzt als `ende` an zepRow statt direkt in einer eigenen Box.
      let ende: Gtk.Widget | undefined
      if (network.active) {
        const connIcon = new Gtk.Label({ label: ICONS.connected })
        connIcon.add_css_class("net-connected-icon")
        ende = connIcon
      } else if (network.security) {
        const lockIcon = new Gtk.Label({ label: ICONS.lock })
        lockIcon.add_css_class("net-lock-icon")
        ende = lockIcon
      }

      // Der Netzname kommt von einem fremden Router und ist beliebig lang;
      // zepRow kuerzt Titel und Nebenzeile selbst (STYLE_MEASURE_LINE aus
      // ags-kit.template) - keine eigene ellipsize/max_width_chars-Stuetze
      // mehr noetig.
      return zepRow({
        symbol: getSignalIcon(network.signal),
        titel: network.ssid,
        unterzeile: format(_("{signal}% • {security}"), {
          signal: network.signal,
          security: network.security || _("open"),
        }),
        ausgewaehlt: network.active,
        ende,
        aktion: async () => {
          if (network.active) { await disconnect(); setTimeout(updateDisplay, 1000) }
          else if (network.security) {
            const success = await connectToNetwork(network.ssid)
            if (!success) showPassword(network.ssid)
            else setTimeout(updateDisplay, 1000)
          } else { await connectToNetwork(network.ssid); setTimeout(updateDisplay, 1000) }
        },
      })
    }

    /** Ein Aufbau aus dem, was DA IST - ohne eine einzige Frage nach
     * aussen.
     *
     * Getrennt von updateDisplay(), damit derselbe Aufbau zweimal
     * laufen kann: einmal sofort mit dem Zwischenspeicher und einmal,
     * wenn der Suchlauf etwas Besseres gebracht hat.
     */
    const zeichne = (connInfo: ConnectionInfo,
                     networks: WifiNetwork[], wifiEnabled: boolean) => {
      // Der Zustandskopf als frischer zepStateHeader (18.08.2026,
      // Aufgabe 12) - siehe die Begruendung bei der Deklaration von
      // statusWrap oben und am Kopf dieser Datei. `zepStateHeader` kennt
      // kein `symbol` (anders als die zepRow, die hier bis Aufgabe 12
      // stand) - die Verbindungsart (Kabel/WLAN/keine) stand bisher
      // ZUSAETZLICH im Symbol (ICONS.ethernet/getSignalIcon()/
      // ICONS.wifiOff), sie bleibt jetzt allein im Titeltext erhalten
      // (WIRED_NAME/SSID/NOT_CONNECTED) - derselbe Verzicht, den
      // Bluetooth fuer sein Verbindungssymbol in Aufgabe 7 schon
      // gemacht hat ("die Seitenleiste zeigt das Symbol schon").
      //
      // Das Info-Symbol (Rolle "still") und der neue WLAN-Schalter
      // (`zepToggle`, Aufgabe 12) teilen sich `ende` als kleine Box -
      // beide sind Bedienelemente FUER DIESEN Kopf, aber fuer zwei
      // verschiedene Dinge: das Symbol oeffnet die Detailansicht DER
      // AKTUELLEN Verbindung (Kabel oder WLAN), der Schalter schaltet
      // NUR den WLAN-Empfaenger. GEPRUEFT (18.08.2026): eine Ethernet-
      // Verbindung bleibt bestehen, auch wenn der WLAN-Schalter aus
      // steht - beide Bedienelemente wirken darum unabhaengig
      // voneinander, nie beide auf dasselbe Feld.
      // DIE SPERRE IST AM 22.08.2026 GEFALLEN
      //     Hier stand `if (currentConnectionInfo.type !== "none")`, das
      //     Symbol tat also im getrennten Zustand nichts - ohne zu
      //     sagen, warum. Seit die Detailansicht die Geraeteadresse
      //     traegt, hat sie im getrennten Zustand ihre WICHTIGSTE
      //     Auskunft (siehe showDetail()): wer seine Adresse in einem
      //     fremden Netz anmelden muss, ist noch nicht drin.
      const buildDetailButton = (): Gtk.Widget =>
        zepButton(ICONS.info, "still", () => { showDetail() })

      // Derselbe Kunstgriff wie buildPowerToggle() in
      // ags-bluetooth.template: frisch gebaut fuer DIESEN Takt, damit
      // der Anfangswert keinen Klick ausloest (zepToggle verbindet sich
      // erst NACH dem Konstruktor mit "notify::active").
      const buildWifiToggle = (): Gtk.Widget => {
        const toggle = zepToggle(wifiEnabled, async (an) => {
          toggle.set_sensitive(false)
          try {
            await execAsync(`nmcli radio wifi ${an ? "on" : "off"}`)
          } catch (e) {
            console.error("Netzwerk: WLAN-Umschalten schlug fehl:", e)
          }
          updateDisplay()
        })
        toggle.set_tooltip_text(_("Turn Wi-Fi on or off"))
        return toggle
      }

      const buildHeaderEnde = (): Gtk.Widget => {
        const ende = new Gtk.Box({ spacing: 8 })
        ende.append(buildDetailButton())
        ende.append(buildWifiToggle())
        return ende
      }

      removeAllChildren(statusWrap)
      if (connInfo.type === "ethernet") {
        statusWrap.append(zepStateHeader({
          titel: WIRED_NAME,
          unterzeile: connInfo.ip || NOTHING, ende: buildHeaderEnde(),
        }))
      } else if (connInfo.type === "wifi") {
        statusWrap.append(zepStateHeader({
          titel: connInfo.name,
          unterzeile: connInfo.ip || NOTHING, ende: buildHeaderEnde(),
        }))
      } else {
        statusWrap.append(zepStateHeader({
          titel: NOT_CONNECTED,
          unterzeile: NOTHING, ende: buildHeaderEnde(),
        }))
      }

      removeAllChildren(networkList)
      for (const network of networks.slice(0, 12)) { networkList.append(createNetworkRow(network)) }
    }

    // ZWEI STUFEN STATT EINER, UND DIE ERSTE FRAGT DEN FUNK NICHT -
    // NEU am 20.08.2026 (Aufgabe 36)
    //
    // GEMELDET, woertlich: "die ags fenster bluetooth und wlan laden
    // teilweise sehr lange um den inhalt anzuzeigen das muss
    // performanter und user friendly werden".
    //
    // WAS HIER VORHER STAND, UND WAS ES GEMESSEN GEKOSTET HAT
    //     Fuenf Fragen, streng nacheinander, jede mit `await`, und die
    //     Oberflaeche blieb bis zur letzten stehen (AGS ist einfaedig).
    //     GEMESSEN am 20.08.2026 auf der Maschine des Nutzers:
    //
    //         info                                14 ms
    //         ip                                   3 ms
    //         list rescan  (in getConnectionInfo) 1060 ms
    //         list rescan  (noch einmal, hier)    1060 ms
    //         nmcli radio wifi                    12 ms
    //         ----------------------------------------
    //         Summe                             2160 ms
    //
    //     Zwei Drittel davon war DERSELBE Suchlauf, zweimal gemacht
    //     (behoben in getConnectionInfo(), siehe dort), und der Rest
    //     war ein Suchlauf VOR dem ersten Bild.
    //
    // DIE AUFTEILUNG
    //     Stufe 1 fragt nur, was aus dem Zwischenspeicher kommt, und
    //     zwar alles GLEICHZEITIG: info, ip, der Schalterstand des
    //     Empfaengers und die Netzliste ohne Suchlauf. GEMESSEN: 51 ms,
    //     und danach steht das Bild.
    //
    //     Stufe 2 stoesst den echten Suchlauf an (3,5 bis 5,9 s, siehe
    //     scanWifi()) und zeichnet neu, wenn er etwas gebracht hat.
    //     Waehrenddessen steht ueber der Liste, DASS gesucht wird -
    //     nicht als Zierde, sondern weil das die einzige ehrliche
    //     Auskunft ueber diese Sekunden ist.
    //
    // WAS DAMIT NICHT BEHAUPTET WIRD: der Suchlauf ist nicht schneller
    // geworden. Er ist aus dem Weg. Die Liste, die in Stufe 1 erscheint,
    // ist die vom letzten Suchlauf - fuer WLAN-Namen in der Nachbarschaft
    // ist das fast immer dieselbe Liste, und wenn nicht, korrigiert
    // Stufe 2 sie ein paar Sekunden spaeter.

    /** Laeuft gerade ein Suchlauf? Ein zweiter waehrenddessen waere ein
     * zweites Funkgeraet auf derselben Karte. */
    let suchtGerade = false

    /** Stufe 2: der echte Suchlauf, im Hintergrund, mit Ansage. */
    const sucheNach = async () => {
      if (suchtGerade || currentView !== "main") return
      suchtGerade = true
      // Die Ansage steht UEBER der Liste und ERSETZT sie nicht: was da
      // ist, bleibt bedienbar, waehrend nachgesucht wird.
      removeAllChildren(sucheWrap)
      sucheWrap.append(zepBusy(_("Searching for Wi-Fi networks …")))
      sucheWrap.set_visible(true)
      try {
        const frisch = await scanWifi(true)
        letzteNetze = frisch
        if (currentView === "main") {
          zeichne(currentConnectionInfo, frisch, letzterSchalter)
        }
      } catch (e) {
        console.error("Netzwerk: der Suchlauf schlug fehl:", e)
      }
      suchtGerade = false
      // Weg damit, in JEDEM Ausgang. Eine Scheibe, die sich ueber einem
      // Fehler weiterdreht, ist schlimmer als eine Fehlermeldung.
      removeAllChildren(sucheWrap)
      sucheWrap.set_visible(false)
    }

    /** Stufe 1: sofort zeigen, was da ist - und danach nachsuchen. */
    const updateDisplay = async () => {
      if (currentView !== "main") return
      // Eine Unteransicht wird nicht aufgefrischt - dieselbe Zeile wie
      // vorher, nur der Grund "ein geschlossenes Fenster wird nicht
      // aufgefrischt" ist mit dem `windowIsUp`-Feld gegangen (siehe Kopf
      // der Datei): DAS entscheidet jetzt, WER updateDisplay() ueberhaupt
      // ruft (der Takt unten fragt `win.visible` selbst), nicht mehr
      // diese Funktion selbst.

      // WAS SCHON DA IST, STEHT SOFORT DA. Beim allerersten Aufbau ist
      // `letzteNetze` leer und dieser Aufruf zeichnet eine leere Liste -
      // die 51 ms danach fuellen sie. Bei JEDEM weiteren Oeffnen steht
      // die Liste des letzten Mals sofort da, statt dass die Seite bei
      // null anfaengt.
      if (letzteNetze.length > 0) {
        zeichne(currentConnectionInfo, letzteNetze, letzterSchalter)
      }

      // Vier Fragen, KEINE davon fragt den Funk - und alle vier
      // gleichzeitig, weil keine von der anderen etwas wissen muss.
      const [netze, schalter] = await Promise.all([
        scanWifi(false),
        execAsync("nmcli radio wifi")
          .then(text => text.trim() === "enabled")
          .catch(() => false),
      ])
      const connInfo = await getConnectionInfo(netze)

      letzteNetze = netze
      letzterSchalter = schalter
      currentConnectionInfo = connInfo
      if (currentView !== "main") return
      zeichne(connInfo, netze, schalter)

      // Und JETZT erst der Suchlauf - ohne `await`, damit dieser
      // Rueckruf hier endet und die Oberflaeche wieder dem Nutzer
      // gehoert.
      void sucheNach()
    }

    // ----- Die Passwortabfrage -----
    passwordBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12, visible: false })
    passwordBox.add_css_class("net-password-box")

    // "Zurueck" ist ein Nebenweg aus dieser Ansicht - Rolle "still"
    // (Schritt 5 des Musters, 18.08.2026, task-C).
    const pwBackBtn = zepButton(`${ICONS.back} ${_("Back")}`, "still", showMain)

    // Auch hier steht ein fremder Name darin: `Passwort für "<SSID>"`.
    passwordSsidLabel = new Gtk.Label({
      label: _("Password for network"),
      ellipsize: Pango.EllipsizeMode.END,
      max_width_chars: {{STYLE_MEASURE_LINE}},
    })
    passwordSsidLabel.add_css_class("net-pw-title")

    passwordEntry = new Gtk.Entry({
      visibility: false,
      placeholder_text: _("Enter the Wi-Fi password ..."),
    })
    passwordEntry.add_css_class("net-pw-entry")
    passwordEntry.connect("activate", tryConnect)

    // Die Hauptsache dieser Ansicht: das Passwort bestaetigen und
    // verbinden - Rolle "voll" (Schritt 5 des Musters, genau EIN
    // voll je Ansicht).
    const pwConnectBtn = zepButton(`${ICONS.connect} ${_("Connect")}`, "voll", tryConnect)

    passwordErrorLabel = new Gtk.Label({ label: "" })
    passwordErrorLabel.add_css_class("net-pw-error")

    passwordBox.append(pwBackBtn)
    passwordBox.append(passwordSsidLabel)
    passwordBox.append(passwordEntry)
    passwordBox.append(pwConnectBtn)
    passwordBox.append(passwordErrorLabel)

    // ----- Die Hauptansicht -----
    //
    // `spacing: 0` SEIT DEM 20.08.2026 (Aufgabe 49), vorher 12: dieser
    // Kasten haelt seither nur noch DREI Kinder - Zustandskopf,
    // Trenner, Flaeche -, und alle drei bringen ihren Abstand selbst
    // mit (.zep-state-head 18/25, .zep-divider `margin:
    // {{STYLE_SPACE_8}} 0`, .zep-shell-flaeche 18/25, alle in
    // ags-style.template). Ein Abstand von 12 obendrauf zaehlte den des
    // Trenners ein zweites Mal. Die 12 zwischen den Zeilen stehen jetzt
    // an der Flaeche darunter.
    mainContent = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })

    // Der Zustandskopf: eine zepRow statt der alten .net-current-Box
    // (18.08.2026, task-C). Die BREITESTE der gemessenen Zeilen - 660
    // Punkte Mindestbreite standen hier, weil in dieser Beschriftung
    // der Netzname stand (siehe Kopf dieser Datei) - traegt jetzt die
    // Kuerzung aus ags-kit.template (STYLE_MEASURE_LINE), nicht mehr
    // eine eigene ellipsize/max_width_chars-Stuetze. statusWrap
    // traegt jeden Takt genau eine frische zepRow, gebaut in
    // updateDisplay().
    statusWrap = new Gtk.Box({})

    // ----- Die Zeile ueber der Liste: Ueberschrift und drei Knoepfe -----
    //
    // DER KNOPF FUER DIE NETZWERKVERWALTUNG STAND BIS ZUM 12.08.2026 IM KOPF
    //     Er war das einzige zusaetzliche Ding in einem der elf
    //     Koepfe: neun tragen Zeichen, Titel, Luecke, Schliesskreuz -
    //     dieser trug davor noch ein Zahnrad. Ein zehnter Kopf mit
    //     einem zehnten Aufbau ist der Anfang von zehn verschiedenen
    //     Koepfen, und der Kopf ist das, was der Nutzer bei jedem
    //     Fenster zuerst sieht.
    //
    //     Hier unten gehoert er ohnehin hin: er oeffnet dieselbe
    //     Oberflaeche, die auch das Netzmodul der Leiste oeffnet, und
    //     steht damit neben den beiden anderen Knoepfen, die etwas mit
    //     dem WLAN tun.
    const toggleRow = new Gtk.Box({ spacing: 12 })
    // hexpand an der Ueberschrift, damit die drei Knoepfe rechts
    // stehen - dieselbe Aufteilung wie im Kopf, wo eine leere Box die
    // Luecke haelt. zepSectionLabel statt einer eigenen Klasse
    // (18.08.2026, task-C), wie listHeader im Bluetoothfenster.
    const wifiHeader = zepSectionLabel(_("Wi-Fi networks"))
    wifiHeader.set_hexpand(true)

    // GEFALLEN, 18.08.2026 (Aufgabe 12): der WLAN-Schalter (vormals
    // net-wifi-toggle, ein Gtk.Button mit von Hand geschriebenen
    // .active/.inactive-Zustaenden) stand hier, in dieser Zeile ueber
    // der Liste - getrennt vom Zustandskopf, der ueber ihm steht und
    // "Kabelverbindung"/die SSID/"Nicht verbunden" zeigt. Bluetooth
    // haelt seinen Adapterschalter dagegen IM Zustandskopf, als `ende`
    // von zepStateHeader (buildPowerToggle() in ags-bluetooth.template).
    // Der Schalter zieht darum mit in `updateDisplay()` um - siehe
    // `buildWifiToggle()` dort - und ist jetzt `ende` des neuen
    // Zustandskopfes, nicht mehr Teil dieser Zeile. Siehe die
    // ausfuehrliche Begruendung am Kopf dieser Datei.

    // "Erneut suchen" ist die Hauptsache dieser Zeile - dieselbe Rolle
    // wie "Geraete suchen" (scanBtn) im Bluetoothfenster fuer dieselbe
    // Handlung: die Liste neu aufbauen. Rolle "voll" (18.08.2026,
    // task-C).
    const refreshBtn = zepButton(ICONS.refresh, "voll", () => { updateDisplay() })
    refreshBtn.set_tooltip_text(_("Scan again"))

    // GEMESSEN am 12.08.2026: hier stand `nm-connection-editor`. Das
    // Paket gleichen Namens liefert ZepOS nicht aus - es ist GTK3 und
    // steht in keinem Rezept -, also war dieser Knopf auf jeder
    // Installation einer, hinter dem nichts passiert. Spec §7.4.
    //
    // Die Oberflaeche fuer dieselbe Aufgabe ist unsere und wird
    // erzeugt: network-manager-gui-config.template schreibt sie nach
    // ~/.local/bin/network-manager-gui, und das Netzmodul der Leiste
    // oeffnet sie mit demselben Klick. Zwei Wege zu einer Aufgabe, von
    // denen der eine ins Leere fuehrt, sind ein Weg und ein Fehler.
    // Rolle "still": die Nebenfunktion, wie bluemanBtn im
    // Bluetoothfenster.
    //
    // `schliessen()` statt `closeWindow()`: seit Aufgabe 8 ist das der
    // Rueckruf, den `bauen()` von der Schale bekommt - er schliesst die
    // GANZE Schale, aus demselben Grund wie vorher (ein fremdes Programm
    // soll nicht hinter dem eigenen Fenster auftauchen).
    const nmBtn = zepButton(ICONS.settings, "still", () => {
      execAsync(`${HOME}/.local/bin/network-manager-gui`)
      schliessen()
    })
    nmBtn.set_tooltip_text(_("Open network management"))

    toggleRow.append(wifiHeader)
    toggleRow.append(refreshBtn)
    toggleRow.append(nmBtn)

    // ----- Die Liste, OHNE eigene Bildlaufleiste -----
    //
    // WARUM HIER KEIN Gtk.ScrolledWindow MEHR STEHT
    //     Es stand eines hier, mit `.net-scroll { min-height: 350px }`
    //     aus ags-style.template. Diese 350 Punkte waren der Grund fuer
    //     die gemessenen 721: ein Mindestmass, das eine leere Liste
    //     genauso beansprucht wie eine volle. Auf dem Bild vom
    //     12.08.2026 war das eine handtellergrosse leere Flaeche unter
    //     der Zeile "WLAN-Netzwerke".
    //
    //     Die Fabrik haengt eine Bildlaufleiste um den GANZEN Inhalt der
    //     Schale, und zwar eine, die neben dem Inhalt liegt statt
    //     darueber (overlay_scrolling: false). Zwei Bildlaufleisten
    //     ineinander sind ausserdem zwei Raeder unter einem Finger:
    //     GTK schickt das Scrollen an die innere, und die aeussere
    //     bewegt sich erst, wenn die innere am Anschlag ist.
    networkList = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6 })
    networkList.add_css_class("net-list")

    // zepDivider() statt einer eigenen Box mit net-divider-Klasse
    // (18.08.2026, task-C): ein Gtk.Separator meldet sich den
    // Hilfsmitteln als Trenner, eine leere Box nicht.
    const divider = zepDivider()

    // Die Ansage ueber der Liste, unsichtbar bis etwas laeuft.
    // ZWISCHEN Knopfzeile und Liste und nicht darunter: sie gehoert zu
    // dem, was gleich in der Liste steht, und dort sucht das Auge
    // waehrend des Wartens.
    sucheWrap = new Gtk.Box({ visible: false })

    // DIE FLAECHE UNTER DEM TRENNER - NACHGETRAGEN am 20.08.2026
    // (Aufgabe 49), wortgleich zu ags-bluetooth.template (siehe die
    // Herleitung dort). GEMELDET, zum zweiten Mal: "die abstände in dem
    // inner content neben der sidebar ... sind auch nicht richtig".
    //
    // GEMESSEN am Bild vor dieser Aenderung (tests/render/,
    // schale-network.png, Fenster 880x430): das Zahnrad rechts stand
    // NULL Punkte von der rechten Fensterkante entfernt (nur die 24
    // Punkte Rinne der Bildlaufleiste lagen dazwischen), die Liste
    // ebenso an der Trennlinie der Seitenleiste - die Seite trug
    // ueberhaupt keine Polsterung.
    //
    // Eine eigene Huelle und NICHT `mainContent` selbst, damit der
    // Zustandskopf (der schon 18/25 polstert) nicht doppelt einrueckt
    // und der Trenner weiter von Kante zu Kante laeuft - das Bild des
    // Musterblatts ("Die Schale", 19.08.2026).
    const flaeche = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL, spacing: 12,
    })
    flaeche.add_css_class("zep-shell-flaeche")
    flaeche.append(toggleRow)
    flaeche.append(sucheWrap)
    flaeche.append(networkList)

    mainContent.append(statusWrap)
    mainContent.append(divider)
    mainContent.append(flaeche)

    // ----- Die Detailansicht -----
    detailBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12, visible: false })
    detailBox.add_css_class("net-detail-box")

    // "Zurueck" ist ein Nebenweg aus dieser Ansicht - Rolle "still"
    // (18.08.2026, task-C).
    const detailBackBtn = zepButton(`${ICONS.back} ${_("Back")}`, "still", showMain)

    // Kopf der Detailansicht: eine zepRow statt eigener Klassen
    // (net-detail-header/-icon/-ssid/-signal), dieselbe Form wie
    // statusWrap oben - Zeichen, Titel, Nebenzeile. detailHeaderWrap
    // traegt jeden Aufruf von showDetail() genau eine frische zepRow.
    detailHeaderWrap = new Gtk.Box({})

    const detailGrid = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
    detailGrid.add_css_class("net-detail-grid")

    const createDetailRow = (labelText: string): [Gtk.Box, Gtk.Label] => {
      const row = new Gtk.Box({ spacing: 12 })
      row.add_css_class("net-detail-row")
      const lbl = new Gtk.Label({ label: labelText, xalign: 0 })
      lbl.add_css_class("net-detail-label")
      lbl.set_size_request(90, -1)
      // Der WERT kommt von aussen - eine IPv6-Adresse ist 39 Zeichen
      // lang, und `nmcli` gibt bei einem Unternehmensnetz auch schon
      // einmal "wpa-eap-suite-b-192" zurueck.
      const val = new Gtk.Label({
        label: NOTHING, xalign: 0, hexpand: true,
        ellipsize: Pango.EllipsizeMode.END,
        max_width_chars: {{STYLE_MEASURE_LINE}},
      })
      val.add_css_class("net-detail-value")
      row.append(lbl)
      row.append(val)
      return [row, val]
    }

    const [ipRow, ipVal] = createDetailRow(_("IP address"))
    detailIpLabel = ipVal

    // ----- Die beiden Adressen, und warum sie zwei verschiedene Zeilen
    // -----  mit zwei verschiedenen Namen sind (22.08.2026)
    //
    // GEMELDET, woertlich: "mir ist aufgefallen, dass man in dem ags
    // fenster für wlan nirgendwo eine info zur macadresse hat, weil
    // diese teilweise auch sehr wichtig ist".
    //
    // ES GIBT ZWEI, UND SIE BEANTWORTEN VERSCHIEDENE FRAGEN
    //     Die des ADAPTERS beantwortet "welche Adresse melde ich an" -
    //     Hochschulen, Firmen, Hotels, Netze mit Adressfilter verlangen
    //     sie, und man muss sie ablesen und eintragen koennen. Das ist
    //     die Frage aus der Meldung ("teilweise auch sehr wichtig"),
    //     und darum steht sie DIREKT UNTER der IP-Adresse: beides sind
    //     Adressen DIESES Rechners, und wer nach seiner Adresse sucht,
    //     sucht oben.
    //
    //     Die des ZUGANGSPUNKTES beantwortet "an welchem der fuenf
    //     Sender haenge ich" - nuetzlich in einem grossen Netz, in dem
    //     eine Ecke schlecht funkt. Sie steht darum bei Gateway und
    //     DNS: das sind die Angaben ueber die GEGENSEITE.
    //
    // ZWEI ZEILEN "MAC" UNTEREINANDER WAEREN SCHLIMMER ALS EINE
    //     Beide sind sechs Zweiergruppen aus Hexziffern; wer sie
    //     verwechselt, meldet in seinem Hochschulnetz den Sender der
    //     Hochschule an. Sie heissen deshalb NICHT beide "MAC": die
    //     eine traegt das Wort aus der Meldung ("MAC-Adresse", sonst
    //     findet der Nutzer sie nicht), die andere sagt, WESSEN Adresse
    //     sie ist ("Zugangspunkt"). Beide Namen bleiben unter der
    //     Spaltenbreite von 90 Punkten, damit die Werte aller Zeilen
    //     auf derselben Kante beginnen.
    const [macRow, macVal] = createDetailRow(_("MAC address"))
    detailMacLabel = macVal
    macVal.set_tooltip_text(
      _("The address of this computer's adapter - the one a network asks for when it wants a device registered"))

    // Der Hinweis steht NEBEN der Adresse und nicht am Zeilenende:
    // er gilt genau ihr. Dafuer gibt der Wert seine Dehnung ab - eine
    // Adresse ist siebzehn Zeichen lang und braucht keine.
    macVal.set_hexpand(false)
    detailMacHint = new Gtk.Label({
      label: _("temporary"), xalign: 0, hexpand: true, visible: false,
      ellipsize: Pango.EllipsizeMode.END,
      max_width_chars: {{STYLE_MEASURE_LINE}},
    })
    detailMacHint.add_css_class("net-detail-hinweis")
    detailMacHint.set_tooltip_text(
      _("This is not the adapter's own address - NetworkManager put a substitute in its place, so it can change. A registration made with it may stop working."))
    macRow.append(detailMacHint)

    // EIN KLICK LEGT SIE IN DIE ZWISCHENABLAGE, UND DAS IST KEIN
    // SCHMUCK
    //     Eine Adresse, die man abtippt, ist eine Adresse, die man
    //     vertippt: "00:00:5E:00:53:0B" sind siebzehn Zeichen aus
    //     einem Alphabet, in dem 0/O und 8/B nebeneinander liegen, und
    //     sie wird in ein Anmeldeformular getippt, das eine falsche
    //     Adresse anstandslos annimmt. Der Fehler zeigt sich dann als
    //     "das Netz laesst mich nicht rein" - an einer Stelle, an der
    //     niemand mehr nach einem Tippfehler sucht.
    //
    //     `wl-copy` ist in diesem Baum schon der Weg dorthin
    //     (ags-vpn-settings.template fuer den oeffentlichen
    //     WireGuard-Schluessel, cliphist-menu-config.template fuer den
    //     Zwischenablageverlauf). Der Wert steht als ARGUMENT nach
    //     `--`, nicht in einer Befehlszeile: eine Adresse aus
    //     Hexziffern und Doppelpunkten ist zwar harmlos, aber die Regel
    //     dieses Baumes lautet "kein fremder Wert in eine Shell", und
    //     hier gibt es gar keine.
    //
    //     Das Haekchen erscheint erst, wenn wl-copy WIRKLICH
    //     zurueckgekommen ist. Ein Haekchen, das schon beim Klick
    //     erscheint, sagt "kopiert" - auch wenn wl-clipboard fehlt, und
    //     dann sucht der Nutzer den Fehler in seiner Einfuegestelle.
    detailMacCopy = zepButton(ICONS.copy, "still", () => {
      if (!macZumKopieren) return
      const zeichen = detailMacCopy.get_child() as Gtk.Label
      execAsync(["wl-copy", "--", macZumKopieren])
        .then(() => {
          zeichen.set_label(ICONS.connected)
          setTimeout(() => zeichen.set_label(ICONS.copy), 1500)
        })
        .catch((e) => console.error("Das Kopieren der Adresse schlug fehl:", e))
    })
    detailMacCopy.set_tooltip_text(_("Copy the MAC address"))
    detailMacCopy.set_sensitive(false)
    macRow.append(detailMacCopy)

    const [gwRow, gwVal] = createDetailRow(_("Gateway"))
    detailGatewayLabel = gwVal
    const [dnsRow, dnsVal] = createDetailRow(_("DNS"))
    detailDnsLabel = dnsVal
    const [bssidRow, bssidVal] = createDetailRow(_("Access point"))
    detailBssidRow = bssidRow
    detailBssidLabel = bssidVal
    bssidVal.set_tooltip_text(
      _("The address of the transmitter this computer is currently on (BSSID)"))
    const [secRow, secVal] = createDetailRow(_("Security"))
    detailSecurityLabel = secVal

    detailGrid.append(ipRow)
    detailGrid.append(macRow)
    detailGrid.append(gwRow)
    detailGrid.append(dnsRow)
    detailGrid.append(bssidRow)
    detailGrid.append(secRow)

    // Trennen ist zerstoerend - Rolle "kritisch", nicht "umrandet"
    // (Task-C-Auftrag, ausdruecklich genannt).
    //
    // Seit dem 22.08.2026 mitgefuehrt, weil showDetail() ihn wegnimmt,
    // wenn nichts verbunden ist: ein Knopf, der eine Verbindung trennen
    // will, die es nicht gibt, ist ein Angebot auf eine Handlung ohne
    // Gegenstand.
    detailDisconnectBtn = zepButton(
      `${ICONS.disconnect} ${_("Disconnect")}`, "kritisch",
      async () => { await disconnect(); showMain(); setTimeout(updateDisplay, 1000) })

    detailBox.append(detailBackBtn)
    detailBox.append(detailHeaderWrap)
    detailBox.append(detailGrid)
    detailBox.append(detailDisconnectBtn)

    // ----- Die drei Ansichten untereinander, immer genau eine sichtbar -----
    const container = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
    // KEIN Mindestbreiten-Boden mehr an dieser Seite - GEAENDERT am
    // 20.08.2026.
    //
    //     Hier stand `container.add_css_class("zep-shell-page")`, und
    //     `.zep-shell-page` trug `min-width: 672px` (= Sprosse L 880
    //     minus 208 Seitenleiste). Diese Seite hat den Boden nie fuer
    //     sich selbst gebraucht - ihr breitester Bestandteil misst 307
    //     (GEMESSEN 20.08.2026) -, sondern damit die SCHALE ihre 880
    //     erreicht und beim Blaettern nicht springt.
    //
    //     Das ist jetzt Sache der Schale selbst: createOverlayWindow()
    //     misst Rahmen und Rinne der Bildlaufleiste und setzt den Boden
    //     auf den ganzen Rumpf (`config.fuelltDieSprosse`,
    //     ags-overlay-utils.template). Der Boden hier war um genau diese
    //     beiden Posten zu gross und lief als waagerechte
    //     Bildlaufleiste wieder heraus - 27px, GEMESSEN am 19. und noch
    //     einmal am 20.08.2026.
    container.append(passwordBox)
    container.append(detailBox)
    container.append(mainContent)

    // DIE ZWEISTUFIGE ESC-WEITERLEITUNG (Aufgabe 8, 18.08.2026) - siehe
    // die ausfuehrliche Begruendung am Kopf dieser Datei und die drei
    // ESC-Wege, VOR dieser Aenderung im Bericht zu Aufgabe 8
    // aufgeschrieben.
    //
    // Angehaengt an `container` - das Wurzel-Widget, das `bauen()`
    // zurueckgibt - und NICHT an `win`: nur so laeuft dieser Controller
    // (Bubble-Phase, GTK4-Standard) VOR dem der Schale, die ihren
    // eigenen Controller an `win` selbst haengt (createOverlayWindow in
    // ags-overlay-utils.template).
    const escController = new Gtk.EventControllerKey()
    escController.connect("key-pressed",
      (_controller: Gtk.EventControllerKey, keyval: number) => {
        if (keyval !== Gdk.KEY_Escape) return false
        // Hauptansicht: NICHT verbrauchen - das Ereignis bubbelt weiter
        // zum Controller der Schale, die schliesst (kein eigenes
        // onEscape dort). Genau das war das Verhalten der Hauptansicht
        // schon vorher (onEscape gab hier `false` zurueck).
        if (currentView === "main") return false
        showMain()
        return true
      })
    container.add_controller(escController)

    // DER TAKT LAEUFT FUER DIE LEBENSDAUER DER SCHALE, NICHT MEHR NUR
    // "SOLANGE DIESE SEITE OFFEN IST" - siehe ags-bluetooth.template
    // (Aufgabe 7) und ags-control-center.template (Aufgabe 6) fuer
    // dasselbe Muster und dieselbe Messung (300 Prozessstarts/Minute im
    // Leerlauf, Fix vom 12.08.2026, hier wie dort NICHT rueckgaengig
    // gemacht). `windowIsUp` (das eigene Feld, das diese Seite vorher
    // als eigenstaendiges Fenster fuehrte) faellt weg, `win.visible`
    // reicht.
    //
    // UND DER ERSATZ FUER onShow (siehe Kopf der Datei): bei jedem
    // Sichtbarwerden der Schale wird diese Seite auf die Hauptansicht
    // zurueckgesetzt und sofort neu gelesen - dieselbe Ansage wie das
    // alte `onShow: () => { windowIsUp = true; showMain();
    // updateDisplay() }`, nur auf Schalenebene statt Fensterebene.
    //
    // NUR WENN DIESE SEITE AUCH DIE AKTIVE IST (repariert 19.08.2026,
    // Bericht Aufgabe 15/16, Fund 1.3): vorher stand hier nur
    // `if (win.visible)` - die Schale ist EIN gemeinsames Fenster fuer
    // vier Seiten, und `notify::visible` feuert beim Oeffnen fuer ALLE
    // vier gleichzeitig, unabhaengig davon, welche gerade sichtbar ist.
    // showMain()/updateDisplay() liefen damit auch dann, wenn "general"
    // oder "vpn" die gezeigte Seite war - unnoetige Arbeit (ein WLAN-Scan
    // fuer eine Seite, die niemand sieht) bei jedem einzigen Oeffnen der
    // Schale, GENAU dieselbe Ursache, die bei VPN (ags-vpn.template) den
    // Fokus auf ein unsichtbares Eingabefeld gezogen hat. `istAktiv()`
    // kommt aus createShellWindow() (ags-overlay-utils.template) und
    // liest `aktivId` bei jedem Aufruf frisch - dieselbe Schliessung wie
    // dort begruendet.
    interval(UPDATE_INTERVAL, () => { if (win.visible && istAktiv()) updateDisplay() })
    win.connect("notify::visible", () => {
      if (win.visible && istAktiv()) { showMain(); updateDisplay() }
    })

    // UND DER SEITENWECHSEL SELBST - NEU am 20.08.2026 (Aufgabe 36)
    //
    //     `notify::visible` oben feuert nur, wenn die GANZE Schale auf-
    //     oder zugeht. Wer sie offen hat und links auf "Netzwerk"
    //     klickt, loeste bis heute GAR NICHTS aus: `wechsleSeite()`
    //     (ags-overlay-utils.template) setzt nur
    //     `set_visible_child_name()`, und keine Seite erfaehrt, dass sie
    //     jetzt die gezeigte ist. Zu sehen war der Stand des letzten
    //     Taktes - bis zu UPDATE_INTERVAL (5000 ms) alt -, und erst
    //     DANACH lief die Abfrage. Das ist die zweite Haelfte des
    //     "teilweise sehr lange" aus der Meldung.
    //
    //     `map` ist das Signal, das GTK4 dafuer schon hat, und es ist
    //     GEMESSEN und nicht angenommen (20.08.2026, GTK4 headless ueber
    //     broadwayd, eigener XDG_RUNTIME_DIR, kein Sitzungsbus, kein
    //     fremder Compositor): ein Gtk.Stack mappt genau sein sichtbares
    //     Kind und unmappt das vorige - beim Blaettern UND beim
    //     Wiederaufgehen der Schale.
    //
    //         map:general
    //         --- Fenster offen ---
    //         map:bluetooth / unmap:general   <- wechsleSeite(bluetooth)
    //         map:network   / unmap:bluetooth <- wechsleSeite(network)
    //         unmap:network                   <- Schale zu
    //         map:network                     <- Schale wieder auf
    //
    //     KEIN `istAktiv()` davor: gemappt wird nur die aktive Seite,
    //     das ist ja gerade die Aussage des Signals. Und kein Ersatz fuer
    //     `notify::visible` oben - jenes setzt zusaetzlich `showMain()`
    //     zurueck, und beide zusammen kosten nichts, weil `updateDisplay()`
    //     in Stufe 1 keinen Funkverkehr mehr ausloest (51 ms) und
    //     `sucheNach()` sich mit `suchtGerade` selbst gegen den zweiten
    //     Anlauf sperrt.
    container.connect("map", () => { updateDisplay() })

    return container
  },
}
