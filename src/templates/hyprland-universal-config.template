# =========================================
# HYPRLAND UNIVERSAL CONFIGURATION
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hyprland-universal-config.template
# =========================================
#
# This universal config works with any monitor setup.
# Monitor configuration comes from the settings application
# (user-configurable). Profile-specific settings come from
# profile-env.conf.
# =========================================

# =========================================
# MONITOR CONFIGURATION
# =========================================
# Written by the "Bildschirme" page of zepos-settings-gui. That page
# applies an arrangement on trial and takes it back after fifteen
# seconds without an answer - src/displays.py has the reasoning, and the
# short version is that a wrong monitor setting is the one mistake a
# user cannot click their way out of.
#
# Editing this file by hand works; it is read on start and on `hyprctl
# reload`. What it does not give you is that trial run.
#
# Save profile with: save-profile <name>

source = ~/.config/hypr/monitors.conf

# Fallback for unknown monitors
monitor=,preferred,auto,1

# =========================================
# WORKSPACE ASSIGNMENTS (from save-profile)
# =========================================

source = ~/.config/hypr/workspaces.conf

# What hypr-monitor-detect.sh worked out from the monitors actually
# attached. Sourced AFTER the profile's own assignments, so a screen that
# is here now wins over one that was here when the profile was saved -
# Hyprland merges workspace rules, later ones over earlier ones.
#
# The generator creates this file empty and the detection refills it on
# every start. It must never be deleted while this line exists: a source=
# line with no file behind it is a config error, not a skipped line.

source = ~/.config/hypr/workspaces-generated.conf

# =========================================
# PROFILE-SPECIFIC ENVIRONMENT
# =========================================
# GPU settings, colors, hardware-specific options

source = ~/.config/hypr/profile-env.conf

# =========================================
# AUTOSTART APPLICATIONS
# =========================================

# Core System Services (MUST come first)
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS DISPLAY
exec-once = dbus-update-activation-environment --all
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Der Bluetooth-Kopplungsagent lief hier vom 21.08. bis zum 21.08.2026
# als `exec-once` auf blueman-applet, mit zwei gsettings-Zeilen davor.
# Er ist mit Aufgabe 54, Stufe 2 GEFALLEN (Regel 14 - geloescht, nicht
# als veraltet markiert): der Agent ist seither ein Fenster im
# AGS-Prozess, der ohnehin laeuft, und die Begruendung samt der
# gemessenen Kette bis in den Kern steht im Kopf von
# src/templates/ags-bluetooth-agent.template.
#
# Zwei Agenten am selben Adapter waeren schlimmer als einer - deshalb
# faellt diese Zeile im SELBEN Schritt, in dem der eigene Agent kommt,
# und nicht einen spaeter.
#
# Das PAKET blueman bleibt Abhaengigkeit von zepos-desktop: es ist der
# einzige Weg zur Bluetooth-Dateiuebertragung in diesem Baum, und der
# Knopf in ags-bluetooth.template fuehrt weiter dorthin.

# GTK Configuration
exec-once = gsettings set org.gtk.Settings.FileChooser window-size '(1024,768)'
exec-once = gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
exec-once = gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'
exec-once = ~/.config/hypr/gtk-theme-fix.sh
exec-once = xsettingsd &

# System Utilities
exec-once = numlockx on
exec-once = ~/.config/hypr/monitor-color.sh

# Clipboard history (cliphist backend for the HyprClipX plugin).
# The watcher, not a service: this used to start clipman.service, and no
# package this project installs provides that unit, so the clipboard
# daemon was never running on any installation it makes. cliphist and
# wl-clipboard are both dependencies of zepos-desktop, and this is
# cliphist's own documented way of collecting the history.
#
# WAS AN DIESER ZEILE AM 12.08.2026 RICHTIGGESTELLT WURDE: DER KLAMMERSATZ
#     Sie sammelt fuer `cliphist-menu.sh` auf SUPER+ALT+V, und dafuer
#     bleibt sie stehen. Was sie NICHT ist, ist "the cliphist backend
#     for the HyprClipX plugin": jenes Fenster fragt einen Unix-Socket,
#
#         /tmp/clipman.sock        ClipboardManager::sendCommand()
#
#     und cliphist macht keinen auf. Es schreibt in seine eigene
#     Datenbank. Der Verlauf hinter SUPER+SHIFT+V war damit nicht
#     kaputt, sondern LEER - eine Taste, die ein korrektes, gestyltes,
#     leeres Fenster oeffnet, was erheblich schwerer zu bemerken ist
#     als eine, die gar nichts tut.
#
#     Die beiden sind also zwei Verlaeufe und nicht einer, und das war
#     schon vorher so: der Kommentar bei SUPER+ALT+V weiter unten sagt
#     ausdruecklich "Not a duplicate of the HyprClipX bind ... it adds
#     favourites, which the plugin has no equivalent for". Nur die
#     Klammer hier oben behauptete das Gegenteil.
exec-once = wl-paste --watch cliphist store

# Der Sammler hinter dem Zwischenablage-Verlauf auf SUPER+SHIFT+V.
#
# WARUM ES IHN VORHER NICHT GAB
#     Upstream legte ihn ueber hyprpm.toml nach $HOME/.local/bin, und
#     ein pacman-Paket darf unterhalb von ~ nichts besitzen
#     (src/paths.py fuehrt das Argument). packaging/zepos-hyprclipx
#     konnte ihn deshalb nicht ausliefern und fuehrte das am 11.08.2026
#     als offenen Punkt in seinem Kopf.
#
#     GEMESSEN am 12.08.2026 auf der Maschine des Nutzers: den Socket
#     haelt ein `clipman-daemon.py` aus ~/.local/bin, von Hand
#     dorthingelegt, Dateidatum 23.06.2026. Auf einer frisch
#     installierten Maschine gibt es ihn nicht, und die Zeile darueber
#     ersetzt ihn nicht - sie fuellt den anderen Verlauf.
#
# WAS JETZT STARTET
#     Der Sammler, den zepos-hyprclipx seit dem 12.08.2026 mitliefert -
#     dieselbe Quelle wie das Fenster, aus demselben Paket, und er
#     liest dieselbe erzeugte Konfiguration wie beide C++-Haelften.
#     plugins/hyprclipx/helpers/collector.py hat die Messung im Kopf.
#
# WARUM exec-once UND KEINE SYSTEMD-EINHEIT
#     Weil er wl-paste ruft und damit WAYLAND_DISPLAY braucht. Eine
#     Einheit muesste auf die zwei Zeilen ganz oben warten, die die
#     Umgebung in den Nutzerbus importieren; ein exec-once laeuft
#     ohnehin erst, wenn der Compositor steht.
#
# WARUM setsid -f
#     Damit er ein Neueinlesen der Konfiguration ueberlebt und sein
#     stdout nicht in Hyprlands Protokoll laeuft. Dieselbe Form wie
#     beim VPN-Waechter weiter unten.
exec-once = setsid -f /usr/bin/python3 /usr/lib/hyprclipx/collector.py >/dev/null 2>&1

# Hier starteten zwei exec-once den Cloud-Sync-Dienst und einen
# Game-Streaming-Server, bei jeder Anmeldung, beide seit dem Fork ohne
# Wirkung - und genau deshalb so lange unbemerkt: ein exec-once, dessen
# Kommando es nicht gibt, meldet Hyprland nirgends.
#
# Der Cloud-Sync steht in Spec §6.1 auf der Liste "ersatzlos geloescht".
# Sein Leistenmodul, sein Stylesheet und dessen @import waren schon
# entfernt; die exec-Zeile, drei Tastenkuerzel und zwei Fensterregeln
# nicht. Der Name steht hier absichtlich nicht mehr ausgeschrieben: die
# Kommentare stehen in der erzeugten hyprland.conf, und
# tests/src/test_reference_resolution.py liest die Datei, nicht die
# Absicht - eine Erklaerung, die das entfernte Kommando zitiert, ist
# fuer diese Pruefung dieselbe tote Referenz wie das Kommando selbst.
#
# Der Streaming-Server bietet die Sitzung ueber das Netz an. Eine
# Distribution startet so etwas nicht, weil das Paket installiert ist -
# wer ihn will, aktiviert ihn selbst.

# Run monitor detection to setup workspaces FIRST
exec-once = ~/.config/hypr/hypr-monitor-detect.sh
exec-once = ~/.config/ags/bar-workspace-detect.sh

# Profile-specific autostart (sourced from profile)
source = ~/.config/hypr/profile-autostart.conf

# Die Leiste hat keinen eigenen Starter mehr.
#
# Hier stand `sleep 5 && ~/.config/waybar/waybar-launcher`, ein Skript,
# das auf waybar-workspaces.conf wartete, bei Bedarf einen kompletten
# `-waybar-config` fuhr und dann waybar exec'te. Alle drei Aufgaben sind
# entfallen: die Leiste gehoert zu AGS, das unten ohnehin startet, und
# sie liest ~/.config/ags/workspaces.json beim Aufbauen selbst - eine
# Datei, die die Zeile darueber gerade geschrieben hat.

# AGS: die Leiste, das Dock, die zwoelf Ueberlagerungen und der
# Benachrichtigungsdienst - ein Prozess.
#
# `sleep 3` und nicht sofort, und der Grund ist jetzt ein anderer als
# frueher: die Leiste liest ~/.config/ags/workspaces.json waehrend sie
# ihre Knoepfe baut, und geschrieben wird die Datei von der
# Erkennungszeile oben. Ohne den Abstand haette die Leiste auf einem
# frisch angeschlossenen zweiten Schirm beim ersten Anmelden keine
# festen Arbeitsbereiche.
exec-once = sleep 3 && cd ~/.config/ags && setsid -f ags run >/dev/null 2>&1

# Claude Code, EINMAL bei der ersten Anmeldung angeboten.
#
# GEMELDET am 01.09.2026: "es soll bei installation mit installiert
# werden genauso wie ruflo aber als bash command install script".
#
# WARUM NICHT IM INSTALLER, sondern hier. Drei Messungen, jede fuer sich
# ausreichend:
#
#   1. installer/core/translate.py ruft seine Zusatzbefehle als
#      `arch-chroot -S <ziel> bash <datei>` auf - ALS ROOT. /etc/npmrc
#      setzt prefix=${HOME}/.local, und ${HOME} ist dort /root. Das
#      Programm laege unter /root/.local/bin/claude und waere fuer das
#      Konto des Nutzers weder im PATH noch lesbar.
#   2. Dieselbe Datei sagt, was ein Fehlschlag dort kostet: SysCommand
#      wirft, und in guided.py steht danach installation.genfstab().
#      Ein hier scheiternder Befehl kostet die /etc/fstab - ein System,
#      das nicht mehr bootet. Die Erreichbarkeit von registry.npmjs.org
#      zur Bedingung dafuer zu machen, ob eine Maschine startet, ist
#      kein Tausch, den irgendjemand eingehen wuerde.
#   3. Auch src/bin/zepos-session ist der falsche Ort: es laeuft VOR dem
#      Compositor, auf schwarzem Bildschirm, und die Sitzung wartet auf
#      ihn. Ein 50-MB-Ladevorgang dort waere eine erste Anmeldung, die
#      eine Minute lang nichts zeigt.
#
# NICHT das fehlende NETZ ist das Argument: der Installer verlangt
# ohnehin eines (installer/core/preflight.py, base_system_problem() -
# "eine Installation ganz ohne Netz gibt es heute nicht").
#
# Ein exec-once laeuft NEBEN dem Compositor, also sichtbar. Der Befehl
# selbst haelt die Zeile billig: liegt claude schon da oder wurde schon
# einmal gefragt, kehrt er sofort und lautlos zurueck - die Marke steht
# unter ${XDG_STATE_HOME:-~/.local/state}/zepos/, wie die von
# zepos-session. Sonst oeffnet er GENAU DAS Fenster, das auch der Klick
# im Dock oeffnet, und fragt darin.
#
# `sleep 8` und damit NACH der Leiste, nicht neben ihr. Die Zeile
# darueber gibt AGS drei Sekunden, und AGS baut danach Leiste und Dock
# auf; ein Terminal, das waehrenddessen aufgeht, landet auf einem
# Schreibtisch, den der Nutzer noch nicht sieht. Es kostet nur bei der
# ersten Anmeldung etwas: in jedem anderen Fall wartet hier ein Befehl,
# der ohnehin sofort zurueckkehrt.
exec-once = sleep 8 && zepos-claude-code --erstanmeldung

# Die Tapete, so frueh wie es geht.
#
# Hier stand `sleep 2 && ...`, und GEMESSEN am 12.08.2026 wartete es auf
# etwas, worauf schon gewartet wird: restore_wallpaper() in
# wallpaper-manager-config.template faengt selbst mit `sleep 1  # Ensure
# Hyprland is ready` an, weil es `hyprctl monitors -j` braucht. Zwei
# Wartezeiten fuer dieselbe Bedingung sind drei Sekunden, in denen der
# Schirm nicht uns gehoert - und genau die hat der Nutzer gesehen. Die
# Bedingung bleibt dort, wo sie begruendet ist, und die Zahl hier faellt
# weg. Siehe misc:force_default_wallpaper weiter unten fuer die andere
# Haelfte.
exec-once = ~/.local/bin/wallpaper-manager restore

# VPN Failsafe Watcher (re-initiates dead CHILD_SAs, surfaces half-up tunnels)
exec-once = sleep 10 && setsid -f ~/.config/ags/scripts/vpn-watcher.sh >/dev/null 2>&1

# Plugins werden NICHT hier geladen, sondern in
# ~/.config/hypr/plugins.conf, das weiter unten gesourcet wird. Ein
# exec-once liefe erst, wenn die Konfiguration laengst gelesen ist - die
# Optionen und Dispatcher, die ein Plugin mitbringt, waeren bis dahin
# schon als Fehler durchgelaufen.

# Notification Daemon (handled by AGS via AstalNotifd)

# Das Dock startet mit AGS. Es ist Dock.tsx, eine Layer-Shell-Flaeche im
# selben Prozess wie die Leiste - kein exec-once mehr.

# =========================================
# WAS HYPRLAND VON SICH AUS ZEIGT
# =========================================
#
# GEMELDET am 12.08.2026, nach dem ersten Anmelden auf echter Hardware:
# "ausserdem war kurz das maedchen von hyprland sichtbar das moechte ich
# nicht es darf immer nur mein hintergrund da sein".
#
# GEMESSEN am selben Tag: dieser Datei fehlte jede der beiden Zeilen
# unten. Hyprland zeichnet ohne sie seine eigene Tapete und sein Logo,
# sobald es hochkommt - das ist kein Fehler von Hyprland, sondern seine
# Vorgabe -, und unsere kam hinterher. Es gab damit bei JEDER Anmeldung
# ein Zeitfenster, in dem etwas Fremdes auf dem Schirm stand. Der Nutzer
# hatte nicht Pech, er hat hingesehen.
#
# Beide Halften gehoeren dazu und eine allein genuegt nicht: ohne die
# erste ist der Schirm fremd, ohne die zweite ist er nur kurz leer -
# das exec-once weiter oben hat sein `sleep 2` am selben Tag verloren,
# weil das Wallpaper-Skript in restore_wallpaper() ohnehin schon selbst
# wartet, bis hyprctl antwortet. Zwei Wartezeiten fuer dieselbe
# Bedingung sind eine Wartezeit und eine Verzoegerung.
#
# 0 und nicht -1: -1 waehlt eine ZUFAELLIGE der mitgelieferten Tapeten,
# 0 schaltet sie ab. Gemessen mit `Hyprland --verify-config` gegen
# 0.55.4 - beide Felder werden angenommen; die Namen sind zwischen den
# Fassungen gewandert und deshalb nachgeprueft statt erinnert.
misc {
    force_default_wallpaper = 0
    disable_hyprland_logo = true
}

# =========================================
# INPUT CONFIGURATION
# =========================================

input {
    kb_layout = de
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    numlock_by_default = true
    follow_mouse = 1
    sensitivity = 0

    touchpad {
        natural_scroll = no
    }
}

# DIE BELEGUNG DIESER MASCHINE - UND SIE UEBERSCHREIBT kb_layout OBEN
#
# `kb_layout = de` da drueber ist die AUSLIEFERUNG und nicht die
# Entscheidung. Bis zum 17.08.2026 war es beides, und das war ein Fehler:
# der Assistent laesst Deutsch oder Englisch waehlen, die Wahl kommt in
# der Konsole und in der Passphrase-Abfrage an - und hier nicht. Eine
# englische Installation haette eine deutsche Tastatur gehabt, sobald die
# Arbeitsflaeche da ist.
#
# zepos-session schreibt diese Datei bei JEDER Anmeldung neu und leitet
# die Belegung aus dem ab, was systemd ohnehin fuehrt; die drei Quellen
# und ihre Reihenfolge stehen dort. Hyprland liest von oben nach unten,
# also gewinnt sie gegen die Auslieferung darueber - und fehlt sie, gilt
# weiter, was oben steht.
source = ~/.config/hypr/keyboard.conf

# =========================================
# GENERAL CONFIGURATION
# =========================================

general {
    # DERSELBE ABSTAND WIE DIE LEISTE, UND ZWAR AUCH NACH EINEM DREH AM
    # REGLER.
    #
    # Die Leiste lag vom 11. bis zum 12.08.2026 links und liegt seither
    # wieder oben. Diese zwei Zeilen hat das nicht angefasst, und genau
    # das ist ihr Wert: EIN Randmass, das nicht davon abhaengt, an
    # welcher Kante die Leiste gerade klebt.
    #
    # GEMELDET am 11.08.2026: "die fenster auch den selben abstand zum
    # rand nutzen". Hier standen dafuer die Literale 5 und 20. Sie waren
    # aus zwei Gruenden nicht "derselbe Abstand":
    #
    #   Erstens rechnerisch. Hyprland legt gaps_in an JEDE Seite eines
    #   Fensters; zwischen zwei Fenstern sieht man also 2*gaps_in = 10,
    #   zum Rand 20. Zwei Abstaende, nicht einer.
    #
    #   Zweitens standen sie still. Die Leiste daneben folgt seit
    #   b96f90d dem Groessenregler - bei sizes.scale 1.85 ist sie 92
    #   statt 50 px -, diese beiden Zahlen nicht. Wer den Schreibtisch
    #   groesser stellte, bekam eine mitgewachsene Leiste in einem
    #   stehengebliebenen Raster.
    #
    # src/sizes.py haelt jetzt beide, auf den Sprossen 8 und 16 der
    # Abstandsleiter, und dort steht auch, warum die Messung an der
    # Vorlage genau auf dieses Paar faellt.
    gaps_in = {{STYLE_GAPS_IN}}
    gaps_out = {{STYLE_GAPS_OUT}}
    border_size = 1
    # Border color is configurable via Style Editor
    col.active_border = rgb({{STYLE_COLOR_HYPRLAND_ACTIVE_BORDER_RAW}})
    col.inactive_border = rgba({{STYLE_COLOR_HYPRLAND_INACTIVE_BORDER_RAW}}aa)
    # Ein von Hyprland selbst mitgebrachtes Layout, kein Plugin-Layout.
    # Hier stand "workspacelayout" - der Name, den hyprWorkspaceLayouts
    # registriert. Dieses Plugin gehoert nicht zu den fuenf, die ZepOS
    # ausliefert (Spec §7.1); auf jeder Maschine, die ZepOS installiert,
    # war das ein Layoutname, den niemand registriert hatte. SUPER+G
    # schaltet ohnehin zwischen dwindle und master um.
    layout = dwindle
}

# =========================================
# DECORATION
# =========================================

decoration {
    # DIESELBE RUNDUNG WIE DIE PLATTE DER LEISTE, seit dem 17.08.2026.
    #
    # Hier stand eine 0, also quadratische Fenster neben einer Leiste,
    # die keine einzige rechte Ecke mehr hat. Danach stand hier die
    # Sprosse der KACHEL - ein Pixelwert naeher und dieselbe Sorte
    # Fehler.
    #
    # GEMELDET am 17.08.2026: "auch die fenster die erscheinen wie
    # terminal mit dem hyprland header sind nicht so rund wie unsere
    # waybar das muss alles angepasst werden". GEMESSEN am selben Tag,
    # bei ausgeliefertem Regler: Leiste, Dock, alle zwoelf
    # Aufklappfenster, die Einblendungen, das Startmenue und der Starter
    # auf 20 px - die Fenster auf 12.
    #
    # Die Zahl kommt aus derselben Sprosse wie #bar (PANEL); die
    # Begruendung fuer die Rolle steht in src/sizes.py bei
    # STYLE_WINDOW_ROUNDING, und tests/src/test_placement.py rechnet die
    # Gleichheit nach, statt sie zu behaupten.
    #
    # SIE RUNDET AUCH DIE TITELLEISTE. hyprbars hat keine eigene
    # Rundungsoption und nimmt genau diesen Wert - die Messung dazu
    # steht in hyprland-plugins-config.template.
    rounding = {{STYLE_WINDOW_ROUNDING}}

    # DIESER SCHALTER IST DER HAUPTSCHALTER FUER DAS GLAS DER EIGENEN
    # FLAECHEN - er gilt nicht nur fuer Fenster, und das ist gemessen.
    #
    # WARUM DIE FRAGE ENTSTAND (01.09.2026)
    #     Mit den sieben Deckkraftregeln weiter unten fiel der Zwang zur
    #     Halbdurchsichtigkeit auf fremde Anwendungen. Damit lag nahe,
    #     auch die Fensterunschaerfe hier fallen zu lassen: sie kostet
    #     laut derselben Messung mehr als die Haelfte der Bildarbeit
    #     beim Fensterziehen (4,20 s gegen 1,95 s GPU je 600 Bilder),
    #     und die eigenen Flaechen haben doch ihre eigenen Regeln -
    #     `layerrule = match:namespace ^(name)$, blur on`, erzeugt aus
    #     GLASS_LAYERS, siehe weiter unten.
    #
    # DIE MESSUNG, DIE ES ENTSCHIEDEN HAT
    #     EINE verschachtelte Sitzung (Hyprland 0.56.2, 1920x1080), die
    #     ganze Oberflaeche darin, ein SCHACHBRETT aus 8-px-Kacheln als
    #     Tapete - die ausgelieferte Tapete ist unter der Leiste fast
    #     einfarbig, und ein Weichzeichner ueber einer einfarbigen
    #     Flaeche ist von keinem Weichzeichner zu unterscheiden (der
    #     erste Anlauf mass mit ihr 0,9 % Unterschied und haette fast das
    #     Gegenteil belegt). Dann derselbe Schirm zweimal abgezogen, nur
    #     mit `hyprctl keyword decoration:blur:enabled` dazwischen:
    #
    #         Leiste   78880 von 81840 Bildpunkten (96,4 %) verschieden
    #         Dock      8015 von 13320 Bildpunkten (60,2 %) verschieden
    #
    #     Die Streuung der Helligkeit in der Leiste stieg dabei von 39,1
    #     auf 42,8 und ihre Spanne von 43..234 auf 26..234: das
    #     Schachbrett kam schaerfer durch. Ohne diese Zeile ist das Glas
    #     der Leiste kein Glas mehr, sondern ein Loch.
    #
    #     `layerrule = blur on` BITTET also nur um die Unschaerfe fuer
    #     eine Flaeche - ausgefuehrt wird sie erst, wenn sie hier
    #     eingeschaltet ist. Die beiden sind kein Entweder-oder, sondern
    #     Schalter und Auswahl.
    #
    # WAS DARAUS FOLGT
    #     Die Fensterunschaerfe bleibt, weil sie die Flaechenunschaerfe
    #     traegt. Was faellt, ist die Halbdurchsichtigkeit, die sie auf
    #     fremden Fenstern ueberhaupt erst anwirft: ein deckendes Fenster
    #     hat nichts, wodurch etwas durchscheinen koennte, und der
    #     Compositor rechnet unter ihm nichts.
    blur {
        enabled = true
        size = 7
        passes = 3
        new_optimizations = true
    }

    # DIE ABGESETZTE KANTE AN FENSTERN - ohne Plugin und ohne Patch.
    #
    # Das Vorbild summer-day-and-night hat dafuer in seiner README
    # Aenderungen an Hyprlands eigenem CHyprDropShadowDecoration.cpp
    # stehen. GEMESSEN am 11.08.2026 in seiner EIGENEN Themendatei
    # (hypr/themes/summer-night/summer-night.conf) braucht es die gar
    # nicht mehr: dort steht
    #
    #     shadow { range = 0; render_power = 4; offset = 0 10;
    #              color = rgb(7d6a40) }
    #
    # Ein Schatten mit range 0 ist keine Weichzeichnung, sondern eine
    # zweite, versetzte Kopie der Fensterform - und um 10 px nach unten
    # versetzt IST das die Kante. Die Farbe ist dieselbe #7d6a40, die
    # seine Leiste unten traegt. Die README ist aelter als seine
    # Konfiguration; die C++-Aenderung wird nicht mehr gebraucht.
    #
    # ZUERST GEPRUEFT, OB EIN PLUGIN ES KANN, wie beauftragt: hyprbars
    # zeichnet eine Titelleiste OBEN, borders-plus-plus zusaetzliche
    # Rahmen RINGSUM (border_size_1..9, eine Breite je Rahmen, keine
    # Angabe pro Seite). Eine Kante, die es nur unten gibt, ist in
    # beiden nicht ausdrueckbar. Gebraucht wird trotzdem keines - der
    # eingebaute Schatten kann es.
    #
    # range = 0 ist der ganze Trick und keine Sparsamkeit: mit einem
    # range > 0 wird aus der Kante ein weicher Schlagschatten, also
    # genau das, was hier NICHT gemeint ist.
    shadow {
        enabled = yes
        range = 0
        render_power = 4
        offset = 0 {{STYLE_BAR_SHELF}}
        color = rgb({{STYLE_BAR_SHELF_COLOR_RAW}})
    }
}

# =========================================
# GLAS - Unschaerfe fuer die eigenen Flaechen
# =========================================
#
# decoration:blur oben gilt fuer FENSTER. Eine Layer-Shell-Flaeche - die
# Leiste, das Dock, die zwoelf Ueberlagerungen - bekommt Unschaerfe nur
# ueber eine eigene layerrule, und die spricht sie ueber den
# Namensraum an, unter dem die Flaeche sich anmeldet.
#
# GEMESSEN am 11.08.2026: es gab im ganzen Baum keine einzige
# layerrule. Die durchsichtigen Hintergruende der Oberflaeche zeigten
# also die Tapete scharf, was billig aussieht statt edel - und der Grund
# war nicht der Stil, sondern eine fehlende Zeile Compositor-Konfiguration.
#
# Die Liste steht in src/style_definition.py unter GLASS_LAYERS, samt der
# Begruendung, warum sie dort steht und was tests/src/test_glass.py
# dagegen haelt. Die Schwelle von ignorealpha kommt aus brand.py und ist
# aus der duennsten Glasschicht abgeleitet, nicht geraten.
{{STYLE_GLASS_LAYERRULES}}

# =========================================
# ANIMATIONS
# =========================================

# EINE Kurve und ZWEI Dauern, beide aus src/sizes.py. Hier standen vier
# Geschwindigkeiten (7, 7, 10, 7, 6) neben einem Stylesheet, das
# daneben 0.3s benutzte - fuenf Zahlen fuer zwei Sorten Bewegung, und
# keine Seite wusste von der anderen.
#
# `default` als Kurve ist ebenfalls weg: eine Zeile, die die eigene
# Kurve deklariert und sie dann in drei von fuenf Faellen nicht benutzt,
# hat keine Kurve.
#
# WELCHE ZEILE WELCHE DAUER BEKOMMT
#     Eine Flaeche, die KOMMT ODER GEHT, ist ENTER: ein Fenster oeffnet
#     sich, ein Arbeitsbereich schiebt sich herein. Ein Zustandswechsel
#     auf einer Flaeche, die BLEIBT, ist BASE: der Rahmen des aktiven
#     Fensters wechselt die Farbe, etwas blendet auf. Das ist dieselbe
#     Grenze, die das Stylesheet zwischen INSTANT und BASE zieht, eine
#     Stufe hoeher - ein Fenster ist mehr Flaeche als eine Kachel.
animations {
    enabled = {{STYLE_MOTION_ENABLED_HYPR}}
    bezier = {{STYLE_MOTION_CURVE_HYPR}}

    animation = windows, 1, {{STYLE_MOTION_ENTER_HYPR}}, {{STYLE_MOTION_CURVE_NAME}}
    animation = windowsOut, 1, {{STYLE_MOTION_ENTER_HYPR}}, {{STYLE_MOTION_CURVE_NAME}}, popin 80%
    animation = border, 1, {{STYLE_MOTION_BASE_HYPR}}, {{STYLE_MOTION_CURVE_NAME}}
    animation = fade, 1, {{STYLE_MOTION_BASE_HYPR}}, {{STYLE_MOTION_CURVE_NAME}}
    animation = workspaces, 1, {{STYLE_MOTION_ENTER_HYPR}}, {{STYLE_MOTION_CURVE_NAME}}
}

# =========================================
# LAYOUT CONFIGURATION
# =========================================

dwindle {
    preserve_split = yes
}

master {
    new_status = master
}

# =========================================
# MISC SETTINGS
# =========================================

gestures {
    # Hyprland 0.51+ neue Syntax
}

# =========================================
# WINDOW RULES (Hyprland 0.53+ Syntax)
# =========================================

# HIER STANDEN SIEBEN DECKKRAFTREGELN, UND SIE SIND AM 01.09.2026 GEFALLEN
#
# WAS GEMELDET WURDE, WOERTLICH
#     "bitte diesen effekt glasmorphism, der auf alle anwendungen
#      aufgezwungen wird, raus machen - dadurch machen wir alle nur
#      buggy, wer auch immer das macht"
#
# WAS HIER STAND
#     `opacity 0.8 0.8` auf kitty, org.gnome.Nautilus, firefox,
#     org.gnome.TextEditor, org.gnome.baobab, org.gnome.Loupe und
#     org.gnome.Papers - also auf jede Anwendung, die ZepOS ausliefert.
#
# WARUM ES FALSCH WAR, UND ES IST KEINE GESCHMACKSFRAGE
#     Das Glas dieses Systems ist fuer die EIGENEN Flaechen entworfen:
#     Leiste, Dock, Ueberlagerungen, Kontrollzentrum. Dort sitzt eine
#     Platte bekannter Farbe vor der Tapete, und tests/src/test_glass.py
#     rechnet fuer genau diese Platte nach, dass die Schrift darauf im
#     schlechtesten Fall noch 4,5:1 Kontrast hat.
#
#     Ein fremdes Fenster hat diese Platte nicht. `opacity` in Hyprland
#     blendet das GANZE Fenster ab, samt seiner Schrift - der Textbereich
#     eines Editors, die Dateiliste des Dateimanagers und der Satz einer
#     Webseite liegen dann zu 20 % ueber dem, was zufaellig dahinter
#     steht. Fuer diese Flaechen ist die Kontrastrechnung nie gefuehrt
#     worden, und sie laesst sich auch nicht fuehren: was hinter einem
#     Fenster liegt, weiss niemand vorher.
#
#     Dazu kommt die Rechenarbeit. Ein halbdurchsichtiges Fenster zwingt
#     den Compositor, bei JEDEM Bild die Unschaerfe unter ihm neu zu
#     rechnen, statt es als deckende Flaeche einfach hinzulegen.
#
# GEMESSEN am 01.09.2026, UND ZWAR AN DER GRAFIKKARTE
#     Die Rechenzeit der CPU taugt hier nicht: sie stieg um 7 %, und das
#     liegt nicht daran, dass die Unschaerfe billig ist, sondern daran,
#     dass sie ein Schattenprogramm ist und gar nicht auf der CPU laeuft.
#     Gezaehlt wird deshalb `drm-engine-render` aus /proc/<pid>/fdinfo -
#     die Nanosekunden, die die Render-Einheit fuer den Compositor
#     gearbeitet hat, je Kennung des Geraetezugangs einmal. Das
#     Gruppieren ist noetig und nicht Vorsicht: der Compositor haelt
#     denselben Zugang mehrfach offen, jeder Eintrag traegt denselben
#     Zaehler, und die blosse Summe meldete 23,7 s Bildarbeit in 11,7 s
#     Uhrzeit - mehr, als die Karte in der Zeit leisten kann.
#
#     Aufbau: verschachtelter Compositor (Hyprland 0.56.2, 1920x1080,
#     tests/render/desktop_session.py) auf integrierter Intel-Grafik, ein
#     kitty-Fenster von 1400x900, 600 Verschiebungen im Abstand eines
#     Bildes - also knapp 12 Sekunden ununterbrochenes Ziehen. kitty
#     wird fuer jeden Lauf neu gestartet, damit die Regel beim Aufgehen
#     des Fensters anliegt; dass sie anlag, ist am Abzug nachgeprueft
#     (100 % der Bildpunkte im Fensterinneren verschieden).
#
#         mit opacity 0.8       5,31 s GPU    8,86 ms je Bild
#         voll deckend          4,20 s GPU    6,99 ms je Bild   1,27x
#
#     Ein Fenster zu ziehen kostete also ein Viertel mehr Bildarbeit,
#     nur weil es halbdurchsichtig war. Der Wert ist in zwei getrennten
#     Sitzungen gemessen worden und kam mit 1,29x und 1,27x wieder.
#
#     Zum Vergleich, aus demselben Lauf: ganz OHNE Fensterunschaerfe
#     waeren es 1,95 s (3,25 ms je Bild). Diese Ersparnis wird hier
#     NICHT gehoben - warum, steht oben im decoration-Block.
#
# WAS BLEIBT UND WARUM
#     Die Zeile fuer org.gnome.Nautilus trug NEBEN der Deckkraft noch
#     `float on, center on, size 1200 800`. Das ist eine Aussage darueber,
#     WO der Dateimanager aufgeht, und keine ueber sein Glas - sie steht
#     seit der ersten oeffentlichen Fassung und war nie Teil der Meldung.
#     Gefallen ist deshalb ihre Deckkraft, nicht ihre Lage.
#
# DIE KLASSENNAMEN SIND DIE APP-IDs, UND DAS IST DER GRUND
#     Ein Wayland-Fenster meldet als Klasse seine app_id, und die ist bei
#     jeder Anwendung aus packaging/zepos-apps die umgekehrte
#     Domainschreibung ihrer .desktop-Datei - org.gnome.Nautilus, nicht
#     "nautilus". Eine Regel auf den Kurznamen greift nicht, und sie
#     scheitert lautlos: das Fenster erscheint einfach ohne sie.
windowrule = match:class (?i)^(org\.gnome\.Nautilus)$, float on, center on, size 1200 800

# Application Specific Rules
#
# Der Archivmanager und der Medienspieler schweben: beide werden aus
# einem anderen Fenster heraus geoeffnet - file-roller aus dem
# Kontextmenue des Dateimanagers, celluloid aus einem Doppelklick - und
# ein Fenster, das eine Antwort auf einen Klick ist, gehoert nicht in die
# Kachelung, in der es das Fenster verschiebt, aus dem es kam.
windowrule = match:class (?i)^(org\.gnome\.FileRoller)$, float on, center on, size 900 600
windowrule = match:class (?i)^(io\.github\.celluloid_player\.Celluloid)$, float on, center on, size 1280 720

# Floating Default Rules (SUPER+Q - centered with default size)
windowrule = match:class ^(floating-default)$, float on, center on, size 800 600

# Floating Center Rules (default: centered 800x600, scripts override with position_window)
windowrule = match:class ^(floating-center)$, float on, center on, size 1200 800

# YAD Rules (for VPN dialog)
windowrule = match:class (?i)^(yad)$, float on, center on, size 400 300

# Die Rechteabfrage. Sie muss DA aufgehen, WO DER NUTZER IST.
#
# HIER STAND `workspace 1`, UND DAS WAR DER GRUND, WARUM SIE NICHT KAM
#     Der Nutzer am 03.09.2026: "dialoge um den pfad mit dateien
#     anzugeben oder andere dialog erscheinen garnicht erst". Die Zeile
#     kam aus einem echten Fehler - die Abfrage landete auf dem
#     zugeklappten Laptopschirm (eDP-1, Arbeitsflaeche 10), waehrend der
#     Nutzer auf DP-5 arbeitete - und sie hat ihn gegen einen anderen
#     getauscht: jetzt landete sie auf Arbeitsflaeche 1, und wer auf 2
#     oder 3 sass, sah sie ebenso wenig.
#
#     `pin on` faengt das NICHT auf, und das ist am Quelltext der
#     ausgelieferten Fassung gemessen (hyprland-0.56.1,
#     src/output/Monitor.cpp:1477-1481):
#
#         // move pinned windows
#         for (auto const& w : ...windows()) {
#             if (w->m_workspace == POLDWORKSPACE && w->m_pinned)
#                 w->layoutTarget()->assignToSpace(pWorkspace->m_space);
#         }
#
#     Ein gepinntes Fenster wandert nur mit, wenn die Arbeitsflaeche, auf
#     der es LIEGT, gerade VERLASSEN wird. Liegt es auf 1 und der Nutzer
#     wechselt von 3 nach 4, bleibt es auf 1. Es wird erst sichtbar, wenn
#     er zufaellig von 1 weggeht.
#
# WAS OHNE DIE ZEILE GILT
#     Ohne Arbeitsflaechenregel geht das Fenster auf der Flaeche auf, die
#     gerade den Fokus hat - also dort, wo der Nutzer ist. `pin on`
#     bleibt und leistet dann das, wofuer es da ist: wer waehrend der
#     Abfrage die Flaeche wechselt, nimmt sie mit.
#
#     Der urspruengliche Fehler ist damit NICHT wieder da, sondern an
#     seinem Ort: dass eine Abfrage auf einem zugeklappten Schirm
#     aufgeht, heisst, dass dieser Schirm den Fokus hat - eine Frage der
#     MONITORE und nicht der Arbeitsflaechen. Ein zugeklappter Laptop,
#     dessen Ausgang noch an ist, ist der Befund; Dialoge auf
#     Arbeitsflaeche 1 zu zwingen war das Pflaster darauf.
windowrule = match:class ^(gcr-prompter)$, float on
windowrule = match:class ^(gcr-prompter)$, center on
windowrule = match:class ^(gcr-prompter)$, pin on

# Hier standen drei Fensterregeln fuer die Klasse blueman-applet
# (float/center/pin). Sie sind mit demselben Schritt gefallen wie die
# Startzeile oben: der eigene Agent ist eine LAYER-SHELL-Flaeche und
# kein Fenster des Fenstermanagers - `windowrule` greift auf ihn gar
# nicht. Seine Lage kommt aus createOverlayWindow(), seine Glasregeln
# aus GLASS_LAYERS ("bluetooth-pairing").

# =========================================
# JetBrains IDE Focus Fix
windowrule = float on, match:class ^(jetbrains-.+)$, match:title ^(win[0-9]+)$
windowrule = no_focus on, match:class ^(jetbrains-.+)$, match:title ^(win[0-9]+)$

# =========================================
# VPN Terminal Rules
windowrule = match:class ^(vpn-connection)$, float on, center on, size 1280 1024
windowrule = match:class ^(vpn-connection)$, workspace 1

# Android Emulator
windowrule = match:class (?i)^(Emulator)$, float on

# Satty Screenshot Annotation (Super+S - always floating, auto-sizes to screenshot)
windowrule = match:class ^(com\.gabm\.satty)$, float on, center on

# Profile-specific window rules
source = ~/.config/hypr/profile-windowrules.conf

# =========================================
# KEYBINDINGS
# =========================================
#
# JEDE bind-ZEILE TRAEGT IHRE BESCHREIBUNG UNMITTELBAR DARUEBER
#
#     # @Gruppe: Was diese Taste tut
#     bind = ...
#
#     Das ist keine Verzierung, sondern die Quelle: src/keybinds.py liest
#     diese Zeilen, und daraus entstehen die Tastenuebersicht der Leiste
#     und die Ueberlagerung in AGS. Beide hatten bis zum 12.08.2026 eine
#     eigene, von Hand gepflegte Liste NEBEN dieser Datei.
#
#     GEMESSEN an einem vollstaendigen `--all`-Lauf: der erzeugte Baum
#     bindet 86 Tastenkombinationen. 19 davon nannte keine der beiden
#     Listen, 26 Eintraege der Listen hatten hier keine Bindung, und die
#     Ueberlagerung schrieb "Browser (Epiphany)", waehrend die Zeile
#     unten firefox startet - eine Luege, die im Leistenmodul einen Tag
#     zuvor korrigiert worden war und die zweite Liste nie erreicht hat.
#
#     WAS IN KLAMMERN STEHT, SIND PROGRAMMNAMEN UND SONST NICHTS.
#     tests/src/test_keybinds.py haelt jeden Namen aus einer Klammer
#     gegen die Kommandozeile DERSELBEN Bindung; "Browser (Epiphany)"
#     ueber `exec, firefox` ist damit nicht mehr schreibbar. Jede andere
#     Praezisierung gehoert hinter einen Gedankenstrich.

$mainMod = SUPER

# Application Launchers
#
# WARUM JEDER TERMINALSTART SEIN VERZEICHNIS SELBST NENNT
#     Ein Terminal ohne `--directory` uebernimmt das Arbeitsverzeichnis
#     dessen, der es startet - hier also Hyprlands, und Hyprland hat
#     seines von start-hyprland geerbt, das von zepos-session, das von
#     greetd. Am 12.08.2026 gemeldet: "wir starten im terminal immer im
#     zepos verzeichniss". start-hyprland-config.template setzt jetzt
#     $HOME, bevor es den Compositor startet, und behebt damit die
#     URSACHE.
#
#     Diese Zeilen decken den zweiten Fall ab, den die Ursache nicht
#     erreicht: einen Compositor, der GAR NICHT durch start-hyprland kam
#     (`Hyprland` von Hand aus einem Projektverzeichnis, ein fremder
#     Anmeldedienst, eine Sitzung aus einer Werkstattumgebung). Eine
#     Zusicherung, die nur gilt, solange der Elternprozess sich richtig
#     verhaelt, ist keine.
#
#     `~` und nicht "$HOME": Hyprland reicht die Zeile an /bin/sh, das
#     die Tilde ersetzt - und die .desktop-Datei fuer dasselbe Terminal
#     hat keine Shell, die das taete. kitty loest sie deshalb ohnehin
#     selbst auf (kitty/child.py: expandvars(expanduser(cwd))), also
#     steht in beiden Dateien dasselbe.
# @Anwendungen: Terminal in einem schwebenden Fenster (kitty)
bind = $mainMod, Q, exec, kitty --directory ~ --class="floating-default"
# @Anwendungen: Terminal mit der Login-Shell (kitty, zsh)
bind = $mainMod SHIFT, Q, exec, kitty --directory ~ -e zsh
# SUPER+E, SUPER+T und SUPER+SHIFT+B zeigen auf die Anwendungen aus
# packaging/zepos-apps. Vorher stand hier ein `dbus-send` an
# org.xfce.Thunar, ein `sub` (Symlink auf sublime-text-4 aus dem AUR, den
# install-system.sh anlegte) und ein `ferdium` - drei Tasten, hinter
# denen auf keinem ZepOS je ein Programm stand, weil keines der drei
# installiert wurde. Das ist der Fehler, den §7.4 fuer den schlimmsten
# haelt: er meldet sich nicht.
#
# nautilus statt des D-Bus-Aufrufs: der Umweg ueber die Schnittstelle
# war da, um ein zweites Thunar-Fenster zu vermeiden. `nautilus
# --new-window` sagt dasselbe in einem Wort, und ohne einen Dienstnamen,
# der beim naechsten Wechsel des Dateimanagers wieder falsch waere.
# @Anwendungen: Dateien (nautilus)
bind = $mainMod, E, exec, nautilus --new-window
# @Anwendungen: Texteditor (gnome-text-editor)
bind = $mainMod, T, exec, gnome-text-editor
# @Anwendungen: Browser (firefox)
bind = $mainMod SHIFT, B, exec, firefox

# ALLES SUCHEN - und das ist die Taste, um die es in dieser ganzen
# Aenderung geht.
#
# GEMELDET am 11.08.2026: das Bildschirmfoto-Werkzeug fehle. Es fehlte
# nicht - grim, slurp und satty lagen auf der Platte und SUPER+S rief
# sie. Wer die Taste nicht kennt, hatte keinen Weg, sie zu finden: der
# Anwendungsstarter kennt nur .desktop-Dateien, und die Tastenuebersicht
# muss man erst einmal aufmachen koennen.
#
# `--show all` zeigt Anwendungen UND jede beschriebene Bindung dieser
# Datei, mit ihrer Taste daneben. Wer "bild" tippt, findet
# "Bildschirmfoto vom gewaehlten Bereich   SUPER + S", kann es mit Enter
# ausloesen und weiss beim naechsten Mal die Taste. Das ist der
# Unterschied zwischen einem Werkzeug, das da ist, und einem, das man
# hat.
#
# SUPER+SHIFT+H, weil genau diese Taste die Uebersicht seit jeher als
# "Helper Scripts" anbot - und ohne das HyprLaunch-Plugin an nichts
# gebunden war. Sie steht jetzt HIER statt in plugins.conf und wirkt
# deshalb auf jeder Maschine, mit Plugin wie ohne.
# @Anwendungen: Alles durchsuchen - Anwendungen und Tastenbefehle (zepos-menu)
bind = $mainMod SHIFT, H, exec, zepos-menu --show all

# SUPER+SPACE - der Anwendungsstarter - steht in
# ~/.config/hypr/plugins.conf: mit HyprLaunch, wenn das Plugin da ist,
# sonst mit zepos-menu. Eine hyprlaunch:toggle-Zeile HIER waere ein
# Dispatcher, den es ohne das Plugin nicht gibt, in der Datei, deren
# Scheitern die Sitzung kostet.

# SUPER+N ist frei, und das ist eine Entscheidung.
#
# Hier stand `kitty -e ncspot`. ncspot 1.3.4-1 liegt im angehefteten
# Schnappschuss, waere also lieferbar - aber ein Client fuer einen
# Musikdienst mit Kontozwang ist der Schreibtisch, aus dem dieses Projekt
# hervorging, und keine Aussage einer Distribution. Er kommt deshalb
# nicht mit (packaging/zepos-apps/PKGBUILD begruendet es), und eine
# Bindung auf ein Programm, das nicht installiert wird, ist genau der
# stumme Fehler, den §7.4 verbietet. Also faellt beides zusammen weg.

# Window Management
# @Fenster: Fenster schliessen
bind = $mainMod SHIFT, X, killactive
# HIER STAND `togglefloating`, und der Dispatcher macht die Arbeit auch
# weiter - er steht nur nicht mehr allein.
#
# GEMELDET am 01.09.2026, zweimal: "die kitty terminals oben der header
# wo x minimieren und vollbild ist keinen abstand zum oberen rand" und
# "fenster die schweben mit super v sieht man auf dem header oben recht
# bei dem x ein flackern des headers".
#
# GEMESSEN am 02.09.2026 an einem verschachtelten Hyprland 0.56.2 mit
# dieser Oberflaeche und diesem hyprbars, 1920x1080, ausgelieferte
# Groesse - dieselbe Taste, dasselbe Fenster:
#
#     gekachelt      Kopf oben  108   = 84 reserviert + 24 gaps_out
#     nach SUPER+V   Kopf oben -124   208 Punkte ueber dem Rand,
#                                     auf dem Bild nicht mehr zu finden
#
# Der Fehler liegt in Hyprlands fitBoxInWorkArea(): sie schiebt einen zu
# hohen Kasten oben heraus, weil nach dem zweiten Klemmschritt kein
# max() mehr steht. src/bin/zepos-float-toggle traegt die Rechnung, die
# Quellzeilen und den Grund, warum eine Fensterregel das NICHT kann -
# Hyprlands Groessenausdruecke kennen monitor_w und monitor_h, aber die
# Sperrzone der Leiste kennen sie nicht.
#
# Der Befehl schaltet um und sieht danach nach. Ein Fenster, das schon
# auf den Schirm passt, laesst er unangetastet.
#
# Die Beschreibung steht UNMITTELBAR ueber der bind-Zeile und nicht ueber
# diesem Block: src/keybinds.py liest sie als die letzte
# `# @Gruppe: Text`-Zeile davor, und tests/src/test_keybinds.py haelt
# das fest. Mit dem Begruendungsblock dazwischen war die Taste in keiner
# Uebersicht und in keiner Suche zu finden - gemessen, vier
# fehlgeschlagene Zusicherungen am 02.09.2026.
# @Fenster: Fenster schweben lassen oder wieder einkacheln
bind = $mainMod, V, exec, zepos-float-toggle
# @Fenster: Pseudo-Kachelung fuer dieses Fenster
bind = $mainMod, P, pseudo
# @Fenster: Teilung waagerecht oder senkrecht
bind = $mainMod, J, layoutmsg, togglesplit
# @Fenster: Maximieren - Leiste und Rahmen bleiben
bind = $mainMod, F, fullscreen, 1
# @Fenster: Echtes Vollbild ueber den ganzen Schirm
bind = $mainMod SHIFT, F, fullscreen, 0

# Special workspace toggle
# @Fenster: Abgelegte Fenster ein- und ausblenden
bind = $mainMod, D, workspace, special:minimized

# Layout Toggle
# @Fenster: Zwischen den Kachelungen dwindle und master wechseln (hyprctl)
bind = $mainMod, G, exec, hyprctl keyword general:layout "$(hyprctl getoption general:layout | grep -q 'dwindle' && echo 'master' || echo 'dwindle')"

# Session Management
# WARUM HIER KEIN `pidof zepos-lock ||` MEHR STEHT
#     Der Wachhund war bei hyprlock noetig, weil ein zweiter Prozess ein
#     zweites Fenster gezeichnet haette. zepos-lock kann das nicht:
#     ext-session-lock-v1 vergibt die Sperre genau einmal, der Compositor
#     weist jeden weiteren Client mit `finished` ab. GEMESSEN am
#     12.08.2026 im verschachtelten Hyprland - der zweite Client bekam
#     ::failed, nicht ::locked.
#
#     Die Wache lag ausserdem an der falschen Stelle: `pidof` fragt nach
#     einem PROZESS, und die Frage, auf die es ankommt, ist, ob die
#     SITZUNG gesperrt ist. Das weiss nur der Compositor.
#
# UND WARUM DIE MARKIERUNG DIREKT UEBER DER BINDUNG KLEBT
#     src/keybinds.py verlangt "unmittelbar", und beim Zusammenfuehren
#     des Sperrbildschirms am 12.08.2026 stand dieser Absatz zuerst
#     ZWISCHEN Markierung und bind-Zeile. Drei Tests fielen sofort: die
#     Markierung gehoerte zu nichts, und die Taste fehlte in der
#     Uebersicht. Genau dafuer ist die Regel da - eine Beschreibung, die
#     durch einen eingeschobenen Absatz von ihrer Zeile getrennt wird,
#     beschreibt beim naechsten Lesen etwas anderes.
#
#     Sie sagt auch nicht mehr "(hyprlock)": ein eingeklammerter
#     Programmname muss ein Wort DESSELBEN Kommandos sein.
# @System: Bildschirm sperren
bind = $mainMod, L, exec, zepos-lock
# Sitzung beenden: sperren, abmelden, neu starten, herunterfahren,
# Bereitschaft, Ruhezustand.
#
# BIS ZUM 19.08.2026 STARTETE DIESE TASTE EIN EIGENES PROGRAMM, UND
# GENAU DAS WAR DER GEMELDETE FEHLER
#     `bind = $mainMod, M, exec, zepos-logout` - ein C-Programm, das bei
#     JEDEM Druck einen NEUEN Prozess startete. Der Nutzer, woertlich:
#     "ausserdem erscheint er immer wieder wenn ich super m mache". Er
#     hatte recht: ein zweiter Druck auf SUPER+M oeffnete ein zweites
#     Fenster ueber dem ersten, statt das erste zu schliessen - Astal.
#     Window kennt kein zweites Exemplar desselben Namensraums, ein
#     zepos-logout-Prozess kennt den vorigen nicht.
#
#     Der Nutzer hat dazu entschieden, das ganze Programm zu entfernen
#     ("super m will ich entfernen das soll so nicht mehr existieren als
#     komplett ags overlay"): logout/zepos-logout.c und sein Paket sind
#     gefallen (Aufgabe 26, Regel 14 - geloescht, nicht als veraltet
#     markiert), src/templates/ags-logout.template ist der Ersatz.
#
#     DIESE TASTE BLEIBT, UND DAS IST EINE EIGENE ENTSCHEIDUNG: der
#     Nutzer wollte das PROGRAMM weg, nicht die TASTE - seine Meldung
#     nennt "super m" nur als das, was das alte Verhalten ausloest, und
#     eine Schnellzugriffstaste fuer "Sitzung beenden" ist unabhaengig
#     davon sinnvoll (SUPER+B fuer das Dock, SUPER+L fuer Sperren stehen
#     aus demselben Grund). Sie ruft jetzt `ags request logout` auf -
#     derselbe Weg wie SUPER+B fuer das Dock (siehe dort): kein
#     Prozessstart, sondern eine Anfrage an den LAUFENDEN AGS-Prozess,
#     der das Fenster ein- und ausschaltet (toggleWidget() in
#     ags-config.template). Der gemeldete Fehler verschwindet damit von
#     selbst - ein zweiter Druck SCHLIESST das Fenster, statt ein
#     zweites zu oeffnen.
# @System: Sitzung beenden - sperren, abmelden, neu starten (ags)
bind = $mainMod, M, exec, ags request logout

# Screenshots
# @Bildschirm: Bildschirmfoto vom gewaehlten Bereich (grim, slurp, satty)
bind = $mainMod, S, exec, grim -g "$(slurp)" - | satty -f -
# Screen Recording (SUPER+ALT+S to start, SUPER+ALT+S again to stop)
# @Bildschirm: Bildschirmaufnahme starten und wieder beenden (wf-recorder, slurp)
bind = $mainMod ALT, S, exec, pkill wf-recorder || wf-recorder -g "$(slurp)" -c libx264 -f ~/Videos/$(date +%Y%m%d_%H%M%S).mp4

# Focus Movement
# @Fenster-Navigation: Fokus nach links
bind = $mainMod, left, movefocus, l
# @Fenster-Navigation: Fokus nach rechts
bind = $mainMod, right, movefocus, r
# @Fenster-Navigation: Fokus nach oben
bind = $mainMod, up, movefocus, u
# @Fenster-Navigation: Fokus nach unten
bind = $mainMod, down, movefocus, d

# Window Movement
# @Fenster-Navigation: Fenster nach links schieben
bind = $mainMod SHIFT, left, movewindow, l
# @Fenster-Navigation: Fenster nach rechts schieben
bind = $mainMod SHIFT, right, movewindow, r
# @Fenster-Navigation: Fenster nach oben schieben
bind = $mainMod SHIFT, up, movewindow, u
# @Fenster-Navigation: Fenster nach unten schieben
bind = $mainMod SHIFT, down, movewindow, d

# Monitor Movement
# @Fenster-Navigation: Fenster auf den Schirm links davon
bind = SHIFT ALT, left, movewindow, mon:-1
# @Fenster-Navigation: Fenster auf den Schirm rechts davon
bind = SHIFT ALT, right, movewindow, mon:+1

# Workspace Switching
# @Arbeitsflaechen: Zur Arbeitsflaeche 1
bind = $mainMod, 1, workspace, 1
# @Arbeitsflaechen: Zur Arbeitsflaeche 2
bind = $mainMod, 2, workspace, 2
# @Arbeitsflaechen: Zur Arbeitsflaeche 3
bind = $mainMod, 3, workspace, 3
# @Arbeitsflaechen: Zur Arbeitsflaeche 4
bind = $mainMod, 4, workspace, 4
# @Arbeitsflaechen: Zur Arbeitsflaeche 5
bind = $mainMod, 5, workspace, 5
# @Arbeitsflaechen: Zur Arbeitsflaeche 6
bind = $mainMod, 6, workspace, 6
# @Arbeitsflaechen: Zur Arbeitsflaeche 7
bind = $mainMod, 7, workspace, 7
# @Arbeitsflaechen: Zur Arbeitsflaeche 8
bind = $mainMod, 8, workspace, 8
# @Arbeitsflaechen: Zur Arbeitsflaeche 9
bind = $mainMod, 9, workspace, 9
# @Arbeitsflaechen: Zur Arbeitsflaeche 10
bind = $mainMod, 0, workspace, 10

# Move to Workspace
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 1
bind = $mainMod SHIFT, 1, movetoworkspace, 1
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 2
bind = $mainMod SHIFT, 2, movetoworkspace, 2
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 3
bind = $mainMod SHIFT, 3, movetoworkspace, 3
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 4
bind = $mainMod SHIFT, 4, movetoworkspace, 4
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 5
bind = $mainMod SHIFT, 5, movetoworkspace, 5
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 6
bind = $mainMod SHIFT, 6, movetoworkspace, 6
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 7
bind = $mainMod SHIFT, 7, movetoworkspace, 7
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 8
bind = $mainMod SHIFT, 8, movetoworkspace, 8
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 9
bind = $mainMod SHIFT, 9, movetoworkspace, 9
# @Arbeitsflaechen: Fenster auf die Arbeitsflaeche 10
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Mouse Bindings
# @Maus: Mausrad nach unten - eine Arbeitsflaeche weiter
bind = $mainMod, mouse_down, workspace, e+1
# @Maus: Mausrad nach oben - eine Arbeitsflaeche zurueck
bind = $mainMod, mouse_up, workspace, e-1
# @Maus: Linke Maustaste gedrueckt halten - Fenster bewegen
bindm = $mainMod, mouse:272, movewindow
# @Maus: Rechte Maustaste gedrueckt halten - Fenstergroesse aendern
bindm = $mainMod, mouse:273, resizewindow

# Clipboard history through zepos-menu.
#
# The bind hypr-shortcuts already advertised and nothing provided:
# cliphist-menu.sh was generated, made executable and reachable from no
# key at all, so the shortcut overlay named a feature that was on disk
# and could not be opened.
#
# Not a duplicate of the HyprClipX bind, which is in
# ~/.config/hypr/plugins.conf and only exists when that plugin is
# loaded. This one works with or without it: it reads the history that
# `wl-paste --watch cliphist store` has been collecting since login,
# needs only cliphist, zepos-menu and wl-clipboard - all three required
# packages - and it adds favourites, which the plugin has no equivalent
# for.
# @Zwischenablage: Zwischenablage-Verlauf mit Favoriten (cliphist-menu.sh)
bind = $mainMod ALT, V, exec, ~/.config/hypr/cliphist-menu.sh

# Floating Window Manager
# @Layouts: Fensterpositionen des Bildschirms merken (floating-window-manager)
bind = $mainMod SHIFT, S, exec, ~/.local/bin/floating-window-manager save

# Benannte Layouts laden und loeschen.
#
# Die Shortcut-Uebersicht bot beide Tasten seit jeher an - "Layout laden"
# und "Layout loeschen" - und gebunden war keine von beiden. Das Skript
# kann beides und ist genau fuer diesen Aufruf gebaut: ohne Argument
# oeffnet es das Auswahlfenster mit den vorhandenen Layouts. Erreichbar war das bisher
# nur ueber Klicks auf das Leistenmodul.
#
# SUPER+ALT+S bleibt frei fuer die Bildschirmaufnahme weiter oben; das
# benannte Speichern liegt weiterhin auf dem Rechtsklick des Moduls.
# @Layouts: Gespeichertes Layout laden (floating-window-manager)
bind = $mainMod ALT, L, exec, ~/.local/bin/floating-window-manager load-layout
# @Layouts: Gespeichertes Layout loeschen (floating-window-manager)
bind = $mainMod ALT, D, exec, ~/.local/bin/floating-window-manager delete-layout

# @Bildschirm: Raster ueber die Tapete legen (grid-wallpaper-toggle)
bind = $mainMod SHIFT, G, exec, ~/.local/bin/grid-wallpaper-toggle toggle
# @Bildschirm: Das aktive Fenster als Abdruck ins Raster nehmen (grid-wallpaper-toggle)
bind = $mainMod SHIFT, W, exec, ~/.local/bin/grid-wallpaper-toggle footprint
# @Bildschirm: Alle Abdruecke aus dem Raster loeschen (grid-wallpaper-toggle)
bind = $mainMod SHIFT CTRL, W, exec, ~/.local/bin/grid-wallpaper-toggle clear-footprints

# Dock ein- und ausblenden.
#
# Hier stand ein Skript, das `pgrep -f nwg-dock-hyprland` fragte und den
# Prozess je nachdem startete oder abschoss. Das Dock ist jetzt ein
# Fenster in AGS; `ags request dock` erreicht denselben Prozess ueber
# seinen Socket und schaltet die Sichtbarkeit um - ohne Prozessstart und
# ohne pkill.
# @System: Dock ein- und ausblenden (ags)
bind = $mainMod, B, exec, ags request dock

# Die Tasten der fuenf Plugins - HyprLaunch, HyprClipX, HyprZones und die
# Titelleisten-Umschaltung - stehen in ~/.config/hypr/plugins.conf,
# zusammen mit den plugin=-Zeilen, von denen sie abhaengen.

# =========================================
# MEDIA & HARDWARE KEYS (Universal)
# =========================================

# Media Control (XF86 keys - work on most keyboards)
# @Medien: Abspielen oder anhalten (playerctl)
bind = , XF86AudioPlay, exec, playerctl play-pause
# @Medien: Abspielen oder anhalten (playerctl)
bind = , XF86AudioPause, exec, playerctl play-pause
# @Medien: Naechster Titel (playerctl)
bind = , XF86AudioNext, exec, playerctl next
# @Medien: Vorheriger Titel (playerctl)
bind = , XF86AudioPrev, exec, playerctl previous
# @Medien: Wiedergabe beenden (playerctl)
bind = , XF86AudioStop, exec, playerctl stop

# Volume Control (XF86 keys)
# @Ton: Lauter um fuenf Prozent (pactl)
bind = , XF86AudioRaiseVolume, exec, pactl set-sink-volume @DEFAULT_SINK@ +5%
# @Ton: Leiser um fuenf Prozent (pactl)
bind = , XF86AudioLowerVolume, exec, pactl set-sink-volume @DEFAULT_SINK@ -5%
# @Ton: Ton stumm schalten und wieder an (pactl)
bind = , XF86AudioMute, exec, pactl set-sink-mute @DEFAULT_SINK@ toggle
# @Ton: Mikrofon stumm schalten und wieder an (pactl)
bind = , XF86AudioMicMute, exec, pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness Control (for laptops - ignored on desktops)
# @Ton: Bildschirm dunkler um zehn Prozent (brightnessctl)
bind = , XF86MonBrightnessDown, exec, brightnessctl set 10%-
# @Ton: Bildschirm heller um zehn Prozent (brightnessctl)
bind = , XF86MonBrightnessUp, exec, brightnessctl set 10%+

# Fallback Media Keys (SUPER+F7-F9 for keyboards without media keys)
# @Medien: Vorheriger Titel - fuer Tastaturen ohne Medientasten (playerctl)
bind = $mainMod, F7, exec, playerctl previous
# @Medien: Abspielen oder anhalten - fuer Tastaturen ohne Medientasten (playerctl)
bind = $mainMod, F8, exec, playerctl play-pause
# @Medien: Naechster Titel - fuer Tastaturen ohne Medientasten (playerctl)
bind = $mainMod, F9, exec, playerctl next

# Fallback Volume Keys (SUPER+F10-F12)
# @Ton: Stumm schalten - fuer Tastaturen ohne Lautstaerketasten (pactl)
bind = $mainMod, F10, exec, pactl set-sink-mute @DEFAULT_SINK@ toggle
# @Ton: Leiser - fuer Tastaturen ohne Lautstaerketasten (pactl)
bind = $mainMod, F11, exec, pactl set-sink-volume @DEFAULT_SINK@ -5%
# @Ton: Lauter - fuer Tastaturen ohne Lautstaerketasten (pactl)
bind = $mainMod, F12, exec, pactl set-sink-volume @DEFAULT_SINK@ +5%

# Profile-specific keybindings (sourced from profile)
source = ~/.config/hypr/profile-keybinds.conf

# =========================================
# ENVIRONMENT VARIABLES (Common)
# =========================================

# Wayland Session
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_CURRENT_SESSION,Hyprland

# GTK/QT Configuration
env = GDK_BACKEND,wayland,x11
env = QT_QPA_PLATFORM,wayland;xcb
env = QT_AUTO_SCREEN_SCALE_FACTOR,1
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = GTK_THEME,Adwaita-dark
env = QT_QPA_PLATFORMTHEME,hyprqt6engine
env = XCURSOR_SIZE,24
env = XCURSOR_THEME,Bibata-Modern-Classic

# GTK Portal Settings
env = GTK_USE_PORTAL,0
env = GTK_CSD,0
env = SAL_USE_VCLPLUGIN,gtk3
env = _JAVA_AWT_WM_NONREPARENTING,1

# Application Support
env = ELECTRON_OZONE_PLATFORM_HINT,wayland
env = ELECTRON_ENABLE_LOGGING,0

# Flatpak Application Discovery
env = XDG_DATA_DIRS,/var/lib/flatpak/exports/share:~/.local/share/flatpak/exports/share:/usr/local/share:/usr/share

# Die Passphrasen-Abfrage
#
# ~/.gnupg/gpg-agent.conf zeigt pinentry-program auf pinentry-bemenu -
# die Begruendung mit den Messungen steht in
# src/system/gpg-agent-config.template. Die Farben koennen NICHT dorthin:
# gpg-agent.conf laesst hinter pinentry-program keine Argumente zu, das
# sagt pinentry-bemenus README ausdruecklich, und bemenu liest sie
# deshalb aus BEMENU_OPTS. Also steht die einzige Stelle, an der dieses
# Fenster ein Aussehen bekommen kann, hier.
#
# Die Farben sind dieselben, die die Abmeldemaske traegt: der Grund ist
# die Tinte, die Auswahl ist die Warnfarbe. Eine Abfrage nach einer
# Passphrase ist ein Moment, in dem jemand hinsehen soll.
env = BEMENU_OPTS,{{STYLE_PINENTRY_BEMENU_OPTS}}

# Input Method
env = GTK_IM_MODULE,fcitx
env = QT_IM_MODULE,fcitx
env = XMODIFIERS,@im=fcitx
env = SDL_IM_MODULE,fcitx
env = GLFW_IM_MODULE,ibus

# Cursor Fix
cursor {
    no_hardware_cursors = true
}

# =========================================
# PLUGIN CONFIGURATION
# =========================================
#
# Nichts davon steht hier. plugins.conf traegt die plugin=-Zeilen, die
# plugin{}-Bloecke und die Tastenbelegungen der fuenf Plugins, und
# zepos-generate schreibt einen Block nur dann hinein, wenn das
# dazugehoerige .so auf der Maschine liegt. Fehlt eines, steht dort ein
# Kommentar - eine gueltige Konfiguration, die nichts laedt.
#
# Das ist die Absicherung aus Spec §7.4: ein ABI-Bruch nach einem
# Hyprland-Update kostet eine Funktion, nie die Sitzung. Stuende der
# plugin{}-Block hier, waere er auf jeder Maschine ohne das passende
# Plugin ein Konfigurationsfehler in genau der Datei, die den Desktop
# startet.
#
# Nach dem $mainMod = SUPER weiter oben, weil die Datei Tasten belegt.

source = ~/.config/hypr/plugins.conf
