# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =====================================================================
# DIE EINGABEZEILE: powerlevel10k, und was ZepOS dafuer wirklich
# ausliefert
# =====================================================================
#
# GEMELDET am 12.08.2026: "es soll irgendwie die moeglichkeit geben
# powerlevel 10k einzurichten das theme fuer ein terminal voll
# automatisch und andere themes auch."
#
# HIER STAND DIE EINRICHTUNG SCHON, UND SIE HAT NICHTS EINGERICHTET.
# Achtzig Zeilen oh-my-zsh: `export ZSH="$HOME/.oh-my-zsh"`,
# `ZSH_THEME="powerlevel10k/powerlevel10k"`, eine plugins=()-Liste mit
# sieben Namen und `source $ZSH/oh-my-zsh.sh`. Gemessen mit `zsh -i` in
# einem leeren Heimatverzeichnis - also so, wie eine erste Anmeldung
# aussieht:
#
#     ~/.zshrc:90: no such file or directory: ~/.oh-my-zsh/oh-my-zsh.sh
#     PROMPT=[%m%# ]
#
# Eine Fehlermeldung bei jeder Anmeldung und der nackte
# zsh-Standardprompt. Die Konfiguration war da, das Konfigurierte nicht.
#
# WARUM OH-MY-ZSH GANZ WEG IST UND NICHT NACHINSTALLIERT WURDE
#     Es ist nicht paketierbar. GEMESSEN am angehefteten Schnappschuss
#     2026/08/04: weder [core] noch [extra] kennen ein Paket
#     "oh-my-zsh"; es gibt es nur in der AUR, als -git-Paket ohne
#     Stichtag und ohne Signatur - genau das, was Spec §4.3
#     ausgeschlossen hat. Und es aktualisiert sich selbst per git in
#     $HOME, was mit einer Distribution, die ~/.zshrc ERZEUGT, direkt
#     kollidiert.
#
#     Es waere auch ohne das die falsche Abhaengigkeit gewesen. Was es
#     hier zu tun hatte, waren drei Dinge, und fuer jedes gibt es eine
#     Zeile: das Theme laden, zwei Plugins laden, ein paar Voreinstellungen
#     fuer Verlauf und Vervollstaendigung setzen. Die plugins=()-Liste,
#     die hier stand, haette ausserdem auch MIT oh-my-zsh nichts getan:
#     zsh-completions, zsh-autosuggestions und zsh-syntax-highlighting
#     liegen bei Arch unter /usr/share/zsh/, nicht unter
#     $ZSH_CUSTOM/plugins/, wo oh-my-zsh sie gesucht haette.
#
# WOHER DIE DATEIEN KOMMEN
#     powerlevel10k gibt es im angehefteten Schnappschuss ebenfalls
#     nicht (das frueher vorhandene zsh-theme-powerlevel10k steht nicht
#     mehr in [extra] - nachgezaehlt in extra.db vom 04.08.2026). ZepOS
#     baut es deshalb selbst: packaging/zepos-zsh-prompt, auf einen
#     Commit gepinnt und mit Pruefsumme, wie astal und die
#     Hyprland-Plugins. Die drei Plugin-Pakete dagegen liegen in
#     [extra] und werden von dort installiert.
#
#     Alle vier stehen in den depends von packaging/zepos-desktop. Ohne
#     diese Kante waere die Zeile darunter wieder das, was hier stand:
#     eine Konfiguration ohne ihr Programm.

# Das Theme. Der Pfad ist der des Pakets und keine Vermutung -
# tests/src/test_prompt.py haelt ihn gegen das Rezept, das ihn anlegt.
[[ ! -r /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]] || \
    source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme

# Vervollstaendigung. zsh-completions legt seine Definitionen in
# site-functions ab, das schon im fpath steht; compinit ist das, was sie
# einliest, und ohne diesen Aufruf tut die Tabulatortaste nichts weiter
# als Dateinamen zu ergaenzen.
#
# Mit Zwischenspeicher (-d) und ohne Rechtepruefung (-u): der Aufbau
# kostet auf einer frischen Installation eine Drittelsekunde, und die
# faellt sonst bei JEDER Anmeldung an.
autoload -Uz compinit
compinit -u -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump-$ZSH_VERSION"

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Der Verlauf. Das waren die Voreinstellungen, die oh-my-zsh
# mitgebracht hat und die als Einzige davon wirklich gefehlt haetten:
# ohne sie merkt sich zsh nichts ueber das Ende der Sitzung hinaus.
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}
setopt append_history share_history inc_append_history
setopt hist_ignore_dups hist_ignore_space hist_verify extended_history
setopt auto_cd interactive_comments

# Die zwei Plugins, in DIESER Reihenfolge. zsh-syntax-highlighting
# haengt sich in jedes Widget ein, das zu diesem Zeitpunkt existiert -
# sein eigenes README verlangt deshalb, dass es als LETZTES geladen
# wird. Andersherum faerbt es die Vorschlaege von zsh-autosuggestions
# nicht mehr richtig ein.
[[ ! -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] || \
    source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ ! -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] || \
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

