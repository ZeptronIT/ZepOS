# Eigene Aliase gehoeren nach ~/.zshrc.d/*.zsh - der Lader dafuer steht
# ganz unten in dieser Datei, samt der Begruendung. `alias` zeigt, was
# gerade gilt.

# Die Einstellungen des Prompts.
#
# ~/.p10k.zsh wird ERZEUGT, aus src/templates/p10k-config.template, mit
# den Farben des aktiven Themas und den Symbolen aus
# src/icon_definition.py. Deshalb steht hier nicht mehr "run `p10k
# configure`", was frueher hier stand: der Fragebogen von p10k schreibt
# eine Datei, die der naechste `zepos-generate --all` ueberschreibt, und
# er stellt zwoelf Fragen fuer ein Ergebnis, das ZepOS schon kennt.
#
# Die Bedingung bleibt trotzdem: ein `zepos-generate -zshrc-config` ohne
# den p10k-Lauf daneben ist moeglich, und eine Anmeldung darf daran
# nicht scheitern.
[[ ! -r ~/.p10k.zsh ]] || source ~/.p10k.zsh

# DER PATH, UND DIE DREI BLOECKE, DIE HIER NICHT MEHR STEHEN
#
# GEMELDET am 17.08.2026, sinngemaess: warum steht in der ausgelieferten
# Konfiguration Software, die es auf dieser Maschine nicht gibt.
#
# Hier standen drei Bloecke vom Rechner eines Menschen, und jeder zeigte
# auf etwas, das ZepOS nicht installiert. NACHGESEHEN am 17.08.2026 auf
# der Wurzel der letzten Installation (iso/out/release-target.img,
# entschluesselt und eingehaengt), Pfad fuer Pfad:
#
#     /opt/anaconda            FEHLT   -> `conda init`-Block, dazu
#                                         CRYPTOGRAPHY_OPENSSL_NO_LEGACY
#                                         und SSL_CERT_FILE, die beide
#                                         nur seine OpenSSL-Fehler
#                                         geradebogen haben
#     /opt/android-sdk         FEHLT   -> ANDROID_HOME, ANDROID_SDK_ROOT,
#                                         ANDROID_NDK_HOME und drei
#                                         PATH-Anhaenge darauf
#     /usr/lib/jvm             FEHLT   -> JAVA_HOME
#     /usr/bin/npm             FEHLT   -> ~/.npm-global/bin
#
# WARUM DAS NICHT NUR HAESSLICH WAR
#     Der conda-Block RUFT AUF, bei jeder Anmeldung:
#     `/opt/anaconda/bin/conda shell.zsh hook`. Der Aufruf schlaegt fehl,
#     der Zweig darunter faengt ihn auf, und geblieben ist eine
#     Anmeldung, die jedes Mal etwas versucht, was es hier nie geben
#     wird.
#
#     ~/.npm-global/bin und die Android-Pfade standen ausserdem VOR
#     /usr/bin. Ein Verzeichnis vorne im PATH ist keine Kleinigkeit: was
#     dort liegt, gewinnt gegen jedes Programm des Systems. Am
#     17.08.2026 lag der Verdacht genau dort - es sei eine alte Huelle in
#     einem dieser Verzeichnisse, die `claude` abfaengt. Sie war es
#     nicht (die Ursache stand im Paketrezept), aber die Falle bleibt
#     eine, solange die Zeilen dastehen.
#
# WAS BLEIBT, UND WARUM GENAU DAS
#     ~/.local/bin. Es ist der Ort, an dem generate_config.sh die
#     erzeugten Hilfsskripte ablegt - start-hyprland, list-profiles,
#     save-profile, wallpaper-manager und die uebrigen. Ohne diese Zeile
#     ist `start-hyprland` ein Befehl, den es nicht gibt.
#
#     Zweimal genannt zu werden schadet ihm nicht: src/bin/zepos-session
#     setzt denselben Pfad fuer die ganze SITZUNG, also auch fuer die
#     Programme, die keine Anmeldeschale sind. Diese Zeile deckt den
#     zweiten Weg ab - eine zsh auf einer Konsole, per ssh, oder unter
#     einem Compositor, der nicht ueber zepos-session gestartet wurde.
#
# UND WARUM `typeset -U` STATT EINES WEITEREN `export PATH=...:$PATH`
#     Weil sich ein vorangestellter Pfad bei jeder verschachtelten Schale
#     wiederholt. GEMESSEN am 17.08.2026 auf dem Rechner, von dem diese
#     Vorlage stammt: ~/.local/bin steht dort DREIMAL im PATH,
#     ~/.npm-global/bin zweimal, /opt/anaconda/bin zweimal - eine zsh in
#     einer zsh in einer zsh. `typeset -U path PATH` ist zsh' eigene
#     Antwort darauf: die beiden bleiben aneinander gekoppelt, und jeder
#     Eintrag steht genau einmal darin, an seiner ersten Stelle.
typeset -U path PATH
path=(~/.local/bin $path)

# WAS DAMIT AUCH FUER npm GILT - und wie man Claude Code und Ruflo
# bekommt
#
# ZepOS bringt Node und npm mit (nodejs-lts-krypton und npm, siehe
# packaging/zepos-desktop/PKGBUILD), aber KEIN vorinstalliertes
# npm-Werkzeug. /etc/npmrc setzt npms Praefix auf ~/.local, also landet
# alles, was du global installierst, unter ~/.local/bin - dem
# Verzeichnis, das die Zeile darueber gerade in den PATH gesetzt hat. Es
# braucht deshalb weder root noch einen zweiten PATH-Eintrag.
#
# CLAUDE CODE liegt seit dem 01.09.2026 NICHT MEHR VORINSTALLIERT BEI.
# Bis dahin baute ZepOS es in ein eigenes Paket - 87,58 MiB, das
# groesste im ganzen Repository -, und das hiess zweierlei: ZepOS gab
# fremde, proprietaere Software unter einem eigenen Namen weiter, und es
# nagelte sie auf eine Fassung fest, waehrend npm laengst weiter war
# (2.1.233 gegen 2.1.257 am 01.09.2026). Beides ist weg. Der Weg dahin:
#
#     zepos-claude-code install     # holt es ueber npm
#     zepos-claude-code update      # holt die naechste Fassung
#     zepos-claude-code             # startet es - und fragt, ob es
#                                   # fehlt, statt zu klagen
#
# Derselbe Befehl steckt hinter dem Eintrag "Claude Code" im Starter,
# und bei der ersten Anmeldung fragt er von sich aus einmal nach.
# Darunter passiert nichts anderes als `npm i -g
# @anthropic-ai/claude-code`; wer es lieber selbst tippt, tippt das.
#
# RUFLO, aus demselben Grund und schon seit dem 20.08.2026:
#
#     npm i -g claude-flow      # danach: claude-flow --version
#
# Ein Orchestrierer, der Claude Code steuert und mehrere KI-Agenten in
# Rollen arbeiten laesst (Supervisor, Planer, Umsetzer). Es SETZT Claude
# Code VORAUS und braucht eine Internetverbindung, weil Claude Code mit
# der Anthropic-Schnittstelle spricht. Genau darum liegt keines von
# beiden vorinstalliert bei: ein Werkzeug, das ohne Netz ohnehin nichts
# tut, gewinnt nichts dadurch, dass es schon auf der Platte liegt - und
# aus npm bekommst du immer die aktuelle Fassung statt einer
# eingefrorenen.
#
# Wer seinen eigenen Praefix will, setzt ihn in ~/.npmrc; die eigene
# Datei gewinnt gegen /etc/npmrc.

# Custom aliases - Hyprland profile launchers
#
# Hier standen go-game, go-home und go-office: drei Aliase auf
# `start-hyprland gaming|home|office`. Diese drei Profile gibt es nicht.
# Ein Profil entsteht durch `save-profile <name>` - ZepOS bringt laptop
# und desktop mit, und der Name des naechsten gehoert dem Nutzer. Ein
# Alias, der einen festen Profilnamen einsetzt, kann darum nur einen
# Namen treffen, den es auf dieser Maschine gibt, oder eben keinen: alle
# drei endeten in "Profile 'gaming' not found!".
#
# `profiles` bleibt, weil es nichts voraussetzt - es zeigt die Profile,
# die wirklich da sind, und start-hyprland nimmt einen davon.
alias profiles='list-profiles'

# HIER STANDEN DREI ABKUERZUNGEN AUF PROGRAMME, DIE ES NICHT GIBT
#     `lg` auf lazygit, `ti` auf tig, `gu` auf gitui. NACHGESEHEN am
#     17.08.2026 auf der Wurzel der letzten Installation: keines der drei
#     liegt unter /usr/bin, und keines steht in den depends von
#     zepos-apps, zepos-apps-devel oder zepos-desktop. Drei Abkuerzungen,
#     die "command not found" abkuerzen.
#
#     Wer sie will, legt sich ~/.zshrc.d/git.zsh an - der Lader dafuer
#     steht unten, und eine Abkuerzung auf ein Programm, das jemand
#     selbst nachinstalliert hat, ist genau der Fall, fuer den es ihn
#     gibt.
#
# UND EINE ZEILE, DIE ZU conda GEHOERTE
#     `export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt` stand
#     unmittelbar hinter den drei Abkuerzungen und gehoerte zu keiner:
#     es war die zweite Haelfte des OpenSSL-Notbehelfs, dessen erste
#     Haelfte oben im conda-Block stand. Die Datei GIBT es auf ZepOS
#     (ca-certificates-utils 20240618-1, am 17.08.2026 nachgesehen) - sie
#     ist genau der Ort, an dem OpenSSL von sich aus nachsieht. Eine
#     Umgebungsvariable, die auf die Vorgabe zeigt, stellt nichts ein.

# ===== User drop-in commands (~/.zshrc.d/*.zsh) =====
# Custom commands/functions belong in ~/.zshrc.d/*.zsh, NOT inline in this file.
# This is the rule the origin broke: a 485-line build tool for one company's
# products lived directly in this template, and generate_config.sh shipped it
# into every generated ~/.zshrc. A drop-in would have been private to the one
# machine that needed it.
# This loader is part of the template, so it survives every zshrc regeneration;
# generate_config.sh never touches ~/.zshrc.d, so the drop-ins persist too.
# Add a new command as ~/.zshrc.d/<name>.zsh (e.g. work-ssh.zsh, work-sftp.zsh).
if [[ -d ~/.zshrc.d ]]; then
    for _f in ~/.zshrc.d/*.zsh(N); do
        source "$_f"
    done
    unset _f
fi
