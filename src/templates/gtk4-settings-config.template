# =========================================
# GTK4 SETTINGS - die Groesse fuer fremde Fenster
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/gtk4-settings-config.template
# =========================================
#
# WAS HIER FEHLTE, UND WIE ES AUFFIEL
#     gtk4-colors-config.template schreibt seit langem 45 benannte
#     libadwaita-Farben nach ~/.config/gtk-4.0/gtk.css, und deshalb sind
#     nautilus, loupe, papers, celluloid, gnome-text-editor und baobab
#     auf diesem Schreibtisch petrolfarben statt grau. Eine GROESSE
#     bekamen sie nie: GEMESSEN am 12.08.2026 setzt kein einziger
#     Treffer im ganzen Baum `gtk-font-name`, und src/sizes.py schreibt
#     genau das seit dem 11.08.2026 als Messung auf.
#
#     Die Folge sieht man erst, wenn man den Regler dreht. Bei
#     sizes.scale 1.85 traegt jedes eigene Fenster 24 px Schrift - und
#     der Dateimanager daneben rund 15, weil fuer ihn GTKs Vorgabe gilt
#     (Cantarell 11). Zwei Fenster nebeneinander, eine anderthalbfach
#     groesser als die andere.
#
# WARUM DIESE DATEI UND NICHT gsettings
#     Weil sie GEMESSEN ankommt und gsettings es nicht sicher tut.
#
#     GEMESSEN am 12.08.2026 gegen gtk4-broadwayd, mit XDG_CONFIG_HOME
#     auf ein leeres Verzeichnis und dieser Datei darin:
#     `Gtk.Settings.get_default().get_property("gtk-font-name")` gibt
#     zurueck, was hier steht. Kein Dienst, kein dconf, kein Portal, kein
#     angemeldeter Sitzungsbus - GTK liest die Datei selbst.
#
#     Der Weg ueber `gsettings set org.gnome.desktop.interface font-name`
#     haengt dagegen an drei Dingen, von denen ZepOS keins zusichert: an
#     gsettings-desktop-schemas (GEMESSEN: in keinem PKGBUILD dieses
#     Baums als Abhaengigkeit genannt), an dconf (ebenfalls nicht) und an
#     einem Einstellungsportal, das die Werte weiterreicht. Es gibt schon
#     drei exec-once-Zeilen, die auf diesem Weg das Thema und die Symbole
#     setzen; ob sie ankommen, weiss niemand. Eine vierte danebenzulegen
#     hiesse, dieselbe Ungewissheit ein viertes Mal einzugehen.
#
# WAS DIESE DATEI NICHT ERREICHT
#     GTK3-Anwendungen. Sie lesen ~/.config/gtk-3.0/settings.ini, mit
#     denselben Schluesselnamen - der Mechanismus ist also derselbe, nur
#     der Pfad ein anderer. Auf einem ZepOS betrifft das firefox
#     (ausdruecklich ausgeliefert, siehe GTK3_ERLAUBT in
#     tests/packaging/test_apps.py), xdg-user-dirs-gtk und
#     xdg-desktop-portal-gtk. Das ist eine eigene Route und eine eigene
#     Aufgabe: fuer die FARBEN braucht GTK3 ausserdem ein
#     ~/.config/gtk-3.0/gtk.css mit anderen Namen, und eine Route, die
#     die Groesse angleicht und die Farbe nicht, macht den Unterschied
#     zwischen firefox und dem Rest sichtbarer statt kleiner.
#
#     Und das Startmenue. Seine Schrift ist eine PF2-Binaerdatei, beim
#     BAU des Mediums mit `grub-mkfont -s 24` erzeugt. GRUB kennt zur
#     Laufzeit keine Schriftgroesse; wer nach der Installation am Regler
#     dreht, kann es nicht mitnehmen. Das ist eine Faehigkeitsgrenze und
#     kein Versaeumnis - der Anker der ganzen Leiter ist genau deshalb
#     diese 24.

[Settings]

# Die Grundschrift, in Pango-Schreibweise: Familie und PUNKT.
#
# Dieselbe Sprosse, auf der jede gelesene Zeile des eigenen
# Schreibtischs steht (BODY), nur in der Einheit, die Pango annimmt -
# src/sizes.py::gtk_font_points() rechnet um und sagt, warum das keine
# vierte Faehigkeit ist, sondern eine Umrechnung.
gtk-font-name = {{STYLE_GTK_FONT_NAME}}

# Ob die fremden Fenster sich bewegen duerfen.
#
# Derselbe Schalter, der auch Hyprlands `animations { enabled }` setzt.
# GEMESSEN am 12.08.2026: eine 0 hier kommt in GTK als
# gtk-enable-animations == False an. Ohne diese Zeile waere "Bewegung
# aus" eine Einstellung, die die eigene Oberflaeche anhaelt und die
# fremden Fenster daneben weiterlaufen laesst.
gtk-enable-animations = {{STYLE_MOTION_ENABLED_GTK}}
