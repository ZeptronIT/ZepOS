#!/bin/bash
# =========================================
# NETWORK WATCHDOG
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/network-watchdog-config.template
# =========================================
# Watches the internet connection and repairs it automatically.
# =========================================

LOG_DIR="$HOME/.local/log"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/network-watchdog.log"

# All three come from the watchdog section of the settings.
#
# The origin wrote its own virtual machine's gateway, its interface and
# its static address in here. On any other machine the gateway never
# answered, so the watchdog reported "Gateway nicht erreichbar -
# Host-Problem" forever and never repaired anything; had it ever got past
# that, it would have added a foreign static address to somebody's
# working interface.
#
# Gateway and interface are empty by default and worked out from the
# default route at run time, which is correct on every machine including
# the one they were written for. They are re-detected on each attempt, so
# a repair that changes them is picked up rather than remembered wrong.
GATEWAY_SETTING="{{STYLE_WATCHDOG_GATEWAY}}"
IFACE_SETTING="{{STYLE_WATCHDOG_INTERFACE}}"
# A host written in here is unreachable on every network that blocks it,
# and the watchdog then "repairs" a connection that was never broken -
# taking the interface down and up again every ten seconds.
INTERNET_CHECK="{{STYLE_WATCHDOG_TEST_HOST}}"
CHECK_INTERVAL=10
MAX_RETRIES=3

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

# Genau EINE Zeile wird ausgewertet: die erste, die
# "ip route show default" ausgibt. Der Kernel gibt die Routen zu einem
# Praefix nach aufsteigender Metrik aus, die erste Default-Route ist also
# die, ueber die die Pakete auch wirklich laufen.
#
# Gateway und Interface muessen aus DERSELBEN Zeile stammen. Bei zwei
# Default-Routen
#
#     default dev tun0 scope link
#     default via 203.0.113.1 dev eth0 metric 600
#
# lieferte eine Suche ueber alle Zeilen das Gateway aus Zeile 2 und das
# Interface aus Zeile 1: restart_network haette dann tun0 herunter- und
# hochgefahren, um das Gateway von eth0 zu reparieren. Der Leisten-
# Baustein waehlt die Zeile nach derselben Regel, damit Dienst und
# Anzeige nicht ueber denselben Zustand streiten koennen.
_default_route_line() {
    local line first=""
    while IFS= read -r line; do
        first="$line"
        break
    done < <(ip route show default 2>/dev/null)
    printf '%s\n' "$first"
}

# Der Wert hinter dem Schluesselwort $2 in der Routen-Zeile $1, sonst leer.
#
# Es wird nach dem Schluesselwort gesucht statt Felder zu zaehlen: eine
# Default-Route ueber eine Punkt-zu-Punkt-Verbindung lautet
# "default dev tun0" und hat gar kein "via", Gateway und Interface stehen
# also nicht an festen Positionen. Feldzaehlen liefert dort den
# Interface-Namen ALS Gateway, und der Watchdog pingt dann ewig eine
# Zeichenkette.
_route_field() {
    local -a fields
    local index
    read -ra fields <<< "$1"
    # Das letzte Feld kann kein Schluesselwort sein - dahinter steht nichts.
    for ((index = 0; index + 1 < ${#fields[@]}; index++)); do
        if [ "${fields[index]}" = "$2" ]; then
            printf '%s\n' "${fields[index + 1]}"
            return
        fi
    done
}

detect_iface() {
    if [ -n "$IFACE_SETTING" ]; then
        echo "$IFACE_SETTING"
        return
    fi
    _route_field "$(_default_route_line)" dev
}

detect_gateway() {
    if [ -n "$GATEWAY_SETTING" ]; then
        echo "$GATEWAY_SETTING"
        return
    fi
    _route_field "$(_default_route_line)" via
}

restart_network() {
    log "{{ICON_REPAIR}} Starte Netzwerk-Reparatur..."

    local iface
    iface="$(detect_iface)"
    if [ -z "$iface" ]; then
        log "  Kein Netzwerk-Interface ermittelbar - Reparatur nicht moeglich"
        return 1
    fi
    log "  Interface: $iface"

    # 1. ARP-Cache leeren (wichtig nach einem Neustart des Gateways)
    sudo ip neigh flush dev "$iface" 2>/dev/null
    log "  ARP-Cache geleert"

    # 2. Interface neu starten
    sudo ip link set "$iface" down 2>/dev/null
    sleep 1
    sudo ip link set "$iface" up 2>/dev/null
    sleep 2
    log "  Interface neu gestartet"

    # 3. Adresse und Route vom Netzwerk-Manager neu anfordern lassen.
    #    Nicht selbst setzen: der Ursprung schrieb hier eine feste
    #    Adresse hinein, die auf jeder anderen Maschine falsch ist. Wer
    #    die Adresse vergeben hat, weiss auch, welche - per DHCP wie per
    #    statischem Profil.
    if command -v nmcli >/dev/null 2>&1; then
        sudo nmcli device reapply "$iface" >/dev/null 2>&1 || \
            sudo nmcli device connect "$iface" >/dev/null 2>&1 || true
        sleep 2
        log "  Verbindung ueber NetworkManager neu angefordert"
    fi

    # 4. Gateway pingen um ARP zu refreshen. Die Route wird hier bewusst
    #    neu gelesen: nach dem Neustart des Interfaces kann eine andere
    #    Default-Route gelten, und dann waere die vorher gemerkte Adresse
    #    die falsche.
    local gw
    gw="$(detect_gateway)"
    if [ -n "$gw" ]; then
        ping -c 2 -W 1 "$gw" &>/dev/null
    fi
    sleep 1
}

# Reparieren und danach nachsehen, ob es geholfen hat. Alle drei
# Reparatur-Anlaesse enden gleich, und ein "wiederhergestellt", das nur
# an einer Stelle geprueft wird, ist an den anderen beiden geraten.
repair_and_verify() {
    restart_network
    if ping -c 1 -W 2 "$INTERNET_CHECK" &>/dev/null; then
        log "{{ICON_SUCCESS}} Internet wiederhergestellt!"
        return 0
    fi
    log "{{ICON_ERROR}} Reparatur fehlgeschlagen"
    return 1
}

# Drei Zustaende, nicht zwei. Ein fehlendes Gateway hiess frueher
# "keine Default-Route", und das ist beides zugleich falsch:
#
#   * "default dev tun0" (Punkt-zu-Punkt, VPN, PPP) hat kein "via" und
#     ist trotzdem eine vollstaendig funktionierende Route. Der Watchdog
#     hat sie alle zehn Sekunden "repariert": ARP geleert, Interface
#     herunter- und hochgefahren, NetworkManager neu angefordert - auf
#     einer Verbindung, die nie kaputt war.
#   * Gab es wirklich keine Route, lief derselbe Zweig ins Leere:
#     detect_iface() liest dieselbe leere Ausgabe, restart_network bricht
#     an der eigenen Interface-Pruefung ab, und repariert wird nichts.
#
# "Keine Default-Route" entscheidet sich deshalb an der Route selbst,
# nicht am fehlenden "via".
check_and_repair() {
    # Die Default-Route wird EINMAL gelesen: ob es eine gibt und welches
    # Gateway darauf steht, muessen sich auf dieselbe Ausgabe beziehen.
    local route gateway
    route="$(_default_route_line)"
    # Wie detect_gateway(), nur auf der bereits gelesenen Zeile.
    gateway="$GATEWAY_SETTING"
    [ -n "$gateway" ] || gateway="$(_route_field "$route" via)"

    # Fall 3: Route mit Gateway - erst das Gateway, dann das Internet.
    if [ -n "$gateway" ]; then
        if ! ping -c 1 -W 2 "$gateway" &>/dev/null; then
            log "{{ICON_WARNING}} Gateway nicht erreichbar - Host-Problem"
            return 1
        fi

        if ping -c 1 -W 2 "$INTERNET_CHECK" &>/dev/null; then
            [ "$ONCE_MODE" = "1" ] && echo "{{ICON_SUCCESS}} Alles OK - Gateway und Internet erreichbar"
            return 0
        fi

        log "{{ICON_WARNING}} Gateway OK aber kein Internet - repariere Netzwerk"
        repair_and_verify
        return $?
    fi

    # Fall 1: gar keine Default-Route - das IST der kaputte Zustand.
    if [ -z "$route" ]; then
        log "{{ICON_WARNING}} Keine Default-Route - repariere Netzwerk"
        repair_and_verify
        return $?
    fi

    # Fall 2: Route ohne "via". Es gibt keine Gateway-Adresse, die man
    # anpingen koennte, also entscheidet allein der Internet-Test.
    if ping -c 1 -W 2 "$INTERNET_CHECK" &>/dev/null; then
        [ "$ONCE_MODE" = "1" ] && echo "{{ICON_SUCCESS}} Alles OK - Internet ueber Default-Route ohne Gateway erreichbar"
        return 0
    fi

    log "{{ICON_WARNING}} Kein Internet ueber Default-Route ohne Gateway - repariere Netzwerk"
    repair_and_verify
}

# Einmalige Ausführung
if [ "$1" = "--once" ]; then
    ONCE_MODE=1
    check_and_repair
    result=$?
    echo ""
    echo "Drücke ENTER zum Beenden..."
    read
    exit $result
fi

ONCE_MODE=0

# Daemon-Modus
log "{{ICON_INFO}} Network Watchdog gestartet (Interval: ${CHECK_INTERVAL}s)"

retry_count=0
while true; do
    if check_and_repair; then
        retry_count=0
    else
        ((retry_count++))
        if [ $retry_count -ge $MAX_RETRIES ]; then
            log "{{ICON_ERROR}} Max Retries erreicht - warte auf Host-Reparatur"
            retry_count=0
            sleep 30
        fi
    fi
    sleep "$CHECK_INTERVAL"
done
