// Eine .conf einlesen - und was dabei NICHT still verschwindet.
//
// Der Einleser sitzt in src/vpn.py und nicht hier, aus demselben Grund,
// aus dem saveSettings() das Schreiben an settings.py abgibt: eine
// zweite Umsetzung in GJS ist die Doppelung, die dieses Fenster schon
// einmal teuer bezahlt hat (siehe den Kommentarkopf von saveSettings).
// Sie hat dort ausserdem Tests, die eine Vorlage nicht haben kann.
//
// DIE BASH-HUELLE, UND WARUM SIE HIER STEHT
//     `vpn.py --wg-import` endet mit 3, wenn die Datei zwar eingelesen
//     wurde, aber Haken-Zeilen (PostUp und Verwandte) abgelehnt worden
//     sind. Dieser Rueckgabewert ist Absicht: ein Aufrufer, der die
//     Ablehnung uebergehen will, soll das AKTIV tun muessen.
//
//     Astals execAsync verwirft bei jedem Wert ungleich 0 und reicht
//     dann nur die Fehlerausgabe durch - die eingelesenen Werte auf der
//     Standardausgabe waeren verloren. Die Huelle laesst genau die 3
//     durch und nichts sonst. Ihr Programmtext ist eine KONSTANTE,
//     alles Veraenderliche steht als Argument dahinter - dieselbe Regel
//     wie bei der einen Shell in ags-vpn.template.
// Der Pfad, den die Statuszeilen ZEIGEN - mit `~` statt dem
// aufgeloesten Heimatverzeichnis, und als WERT neben der Meldung statt
// in ihr: ein Uebersetzer darf den Satz aendern, den Pfad nicht.
// Dieselbe Trennung wie bei PSK_DISPLAY_PATH weiter oben.
//
// Ueber eine Funktion und nicht ueber ein Template-Literal an der
// Einsetzstelle: tests/src/test_ags_i18n.py verfolgt Ausdruecke bis in
// den Setzer und haelt ein Literal dort fuer eine sichtbare,
// unuebersetzte Zeichenkette - was es formal auch ist. GEMESSEN am
// 21.08.2026, zwei Fundstellen.
const WG_KEY_DISPLAY_DIR = "~/.config/wireguard"

function wgKeyDisplayPath(name: string): string {
  return `${WG_KEY_DISPLAY_DIR}/${name}`
}

const WG_IMPORT_SHELL =
  'out=$("$@"); rc=$?; if [ "$rc" = 0 ] || [ "$rc" = 3 ]; then printf %s "$out"; exit 0; fi; exit "$rc"'

function buildWgImportSection(): Gtk.Box {
  const section = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
  section.add_css_class("vpn-field")

  const title = new Gtk.Label({ label: _("WireGuard configuration"), xalign: 0 })
  title.add_css_class("vpn-field-label")

  const row = new Gtk.Box({ spacing: 8 })
  row.add_css_class("vpn-entry-row")

  const pathEntry = new Gtk.Entry({ hexpand: true, placeholder_text: _("Path to a .conf file ...") })
  pathEntry.add_css_class("vpn-entry")

  const status = new Gtk.Label({ label: "", xalign: 0, wrap: true })
  status.add_css_class("vpn-psk-status")

  // Rolle still: ein Zeichen-Knopf am Rand der Eingabezeile, wie
  // pskVisibilityBtn - er fuellt das Feld daneben, er ist nicht der Weg.
  //
  // Gtk.FileDialog und nicht zenity/yad: GTK4 bringt ihn selbst mit, der
  // Dateiwaehler-Portal-Dienst steht schon in den depends
  // ("xdg-desktop-portal-gtk # file chooser for GTK applications"), und
  // ein neues Paket fuer einen Dateiwaehler waere ein neues Paket fuer
  // einen Dateiwaehler.
  //
  // DAS EINGABEFELD BLEIBT TROTZDEM, und das ist kein zweiter Weg zum
  // selben Ziel: der Waehler FUELLT es, eingelesen wird immer daraus.
  // Faellt der Waehler aus (kein Portal, kein Elternfenster), kann der
  // Nutzer den Pfad hineinschreiben, statt vor einem Knopf zu stehen,
  // der nichts tut.
  const browseBtn = zepButton(ICONS.folder, "still", () => {
    try {
      const chooser = new (Gtk as any).FileDialog({
        title: _("Choose a WireGuard configuration"),
      })
      chooser.open(parentWindow, null, (_source: any, result: any) => {
        try {
          const file = chooser.open_finish(result)
          if (file) pathEntry.set_text(file.get_path() ?? "")
        } catch (e) {
          // Abgebrochen ist kein Fehler und bekommt keine Meldung.
        }
      })
    } catch (e) {
      status.set_text(_("No file chooser available - please type the path."))
      status.add_css_class("warning")
    }
  })
  browseBtn.set_tooltip_text(_("Choose a WireGuard configuration"))

  row.append(pathEntry)
  row.append(browseBtn)

  // Rolle umrandet: eine wirkliche, sofort wirksame Handlung, aber
  // nicht die Hauptsache des Fensters - dieselbe Einordnung wie
  // pskSaveBtn.
  const importBtn = zepButton(_("Import"), "umrandet", async () => {
    const path = pathEntry.get_text().trim()
    if (!path) return
    try {
      const answer = await execAsync(["bash", "-c", WG_IMPORT_SHELL,
                                      "zepos-wg-import", ...VPN_TOOL,
                                      "--wg-import", path])
      const payload = JSON.parse(answer)
      currentSettings.wireguard = payload.wireguard
      // Der DNS-Reiter ist derselbe wie bei IPsec, und `DNS =` aus der
      // Datei gehoert dorthin - nicht in einen zweiten.
      if (payload.dns) currentSettings.dns = payload.dns

      // Was die Datei ueber den UMFANG des Tunnels sagt, gleich beim
      // Einlesen - der mitlaufende Hinweis steht im Reiter
      // "Gegenstellen", aber wer gerade eine Anbieterdatei angeheftet
      // hat, soll es hier schon lesen. src/vpn.py rechnet es (siehe
      // wireguard_full_tunnel), damit hier nichts zweimal gerechnet
      // wird, was ohnehin schon im Umschlag liegt.
      const volltunnel = importFullTunnelNote(payload.full_tunnel ?? [])

      const refused: [number, string][] = payload.refused ?? []
      if (refused.length) {
        // BENANNT UND ABGELEHNT, NICHT STILL VERWORFEN. Eine Datei, von
        // der die Haelfte ankommt und deren Rest verschwindet, ist in
        // einem Netzwerkzeug gefaehrlicher als eine Fehlermeldung: was
        // fehlt, ist genau die Zeile, die den Verkehr eingegrenzt haette.
        status.set_text(format(
          _("Imported. These lines were NOT taken over, because they run commands: {lines}"),
          { lines: refused.map(([line, key]) => `${key} (${line})`).join(", ") }) + volltunnel)
        status.remove_css_class("success")
        status.add_css_class("warning")
      } else {
        status.set_text(_("Imported") + volltunnel)
        // Beide erst weg, dann eine hin: sonst bliebe die Farbe des
        // vorigen Einlesens unter der neuen stehen.
        status.remove_css_class("warning")
        status.remove_css_class("success")
        status.add_css_class(volltunnel ? "warning" : "success")
      }
      // Der Hinweis auf die Fremddatei: ANGEBOTEN, nicht getan. Sie
      // gehoert dem Nutzer, sie traegt seinen privaten Schluessel im
      // Klartext, und sie liegt mit ziemlicher Sicherheit mit 0644 im
      // Downloadordner.
      try {
        await execAsync(['notify-send', '-i', 'network-vpn', _("WireGuard"),
                         format(_("The key was stored privately. The original {path} still contains it in clear text - you may want to delete it."),
                                { path })])
      } catch { }
      rebuildTabs()
    } catch (e) {
      status.set_text(format(_("Not imported: {error}"), { error: String(e) }))
      status.remove_css_class("success")
      status.add_css_class("warning")
    }
  })

  const actions = new Gtk.Box({ spacing: 8, halign: Gtk.Align.END })
  actions.append(importBtn)

  section.append(title)
  section.append(row)
  section.append(actions)
  section.append(status)
  return section
}

// Build WireGuard Interface Tab
function buildWgInterfaceTab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
  const wg = currentSettings.wireguard

  const sectionTitle = new Gtk.Label({ label: _("Interface settings"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  // Die eigenen Adressen. Dieselbe Listenform wie die gerouteten Netze
  // auf der IPsec-Seite - ein zweites Bauteil fuer dieselbe Sache waere
  // ein zweites Bauteil fuer dieselbe Sache.
  box.append(buildStringList(
    _("Addresses"), _("Add address"), _("e.g. 10.9.0.2/24"),
    () => wg.addresses, (list) => { wg.addresses = list }))

  box.append(createNumericField(_("Listen port (0 = automatic)"), wg.listen_port ?? 0,
                                (val) => { wg.listen_port = val }))
  box.append(createNumericField(_("MTU (0 = automatic)"), wg.mtu ?? 0,
                                (val) => { wg.mtu = val }))

  // ---- Der Schluessel ------------------------------------------------
  //
  // WAS HIER ANDERS IST ALS BEIM PSK DARUEBER: der PSK wird EINGEGEBEN,
  // ein WireGuard-Schluesselpaar wird ERZEUGT. Deshalb gibt es hier kein
  // Eingabefeld fuer den privaten Schluessel, sondern einen Knopf - der
  // Schluessel geht dann gar nicht erst durch eine fremde Hand, durch
  // eine Zwischenablage oder durch ein Feld, das jemand offen stehen
  // laesst. Wer einen mitgebrachten Schluessel hat, bringt ihn als
  // .conf mit; das ist der Weg darueber im Reiter "Allgemein".
  const keySection = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
  keySection.add_css_class("vpn-field")

  const keyLabel = new Gtk.Label({ label: _("Private key"), xalign: 0 })
  keyLabel.add_css_class("vpn-field-label")

  const keyStatus = new Gtk.Label({ label: "", xalign: 0, wrap: true })
  keyStatus.add_css_class("vpn-psk-status")
  if (wg.private_key_file) {
    keyStatus.set_text(format(_("Key present in {path}"),
                              { path: wgKeyDisplayPath(wg.private_key_file) }))
    keyStatus.add_css_class("success")
  } else {
    keyStatus.set_text(_("No key yet - create one, or import a .conf file"))
    keyStatus.add_css_class("warning")
  }

  // Der EIGENE oeffentliche Schluessel ist kein Geheimnis - er ist
  // genau das, was der Gegenstelle geschickt werden muss. Er steht
  // deshalb offen da und laesst sich kopieren.
  const publicRow = new Gtk.Box({ spacing: 8 })
  publicRow.add_css_class("vpn-entry-row")
  const publicEntry = new Gtk.Entry({ hexpand: true, editable: false,
                                      text: wg.public_key ?? "",
                                      placeholder_text: _("Own public key ...") })
  publicEntry.add_css_class("vpn-entry")
  const copyBtn = zepButton(ICONS.copy, "still", () => {
    // wl-copy mit dem Wert als Argument ist hier zulaessig und nur
    // hier: ein OEFFENTLICHER Schluessel ist kein Geheimnis. Der
    // private geht nie durch eine Befehlszeile - siehe den Kopf des
    // WireGuard-Teils in src/vpn.py.
    if (wg.public_key) execAsync(["wl-copy", "--", wg.public_key]).catch(() => { })
  })
  copyBtn.set_tooltip_text(_("Copy the public key"))
  publicRow.append(publicEntry)
  publicRow.append(copyBtn)

  // Rolle umrandet: eine wirkliche Handlung, nicht die Hauptsache.
  const genBtn = zepButton(_("Create a key pair"), "umrandet", async () => {
    const name = `${currentSettings.connection_name || "work"}.key`
    try {
      const publicKey = (await execAsync([...VPN_TOOL, "--wg-genkey", name])).trim()
      wg.private_key_file = name
      wg.public_key = publicKey
      publicEntry.set_text(publicKey)
      keyStatus.set_text(format(_("Key present in {path}"),
                                { path: wgKeyDisplayPath(name) }))
      keyStatus.remove_css_class("warning")
      keyStatus.add_css_class("success")
    } catch (e) {
      keyStatus.set_text(format(_("No key was created: {error}"), { error: String(e) }))
      keyStatus.remove_css_class("success")
      keyStatus.add_css_class("warning")
    }
  })

  const keyActions = new Gtk.Box({ spacing: 8, halign: Gtk.Align.END })
  keyActions.append(genBtn)

  keySection.append(keyLabel)
  keySection.append(keyStatus)
  keySection.append(publicRow)
  keySection.append(keyActions)
  box.append(keySection)

  return box
}

// Welche Familien DIESE WireGuard-Verbindung ganz umleitet - ueber alle
// Gegenstellen zusammen. Der Zwilling von src/vpn.py::
// wireguard_full_tunnel(), und aus demselben Grund ueber die
// Vereinigung: was routet, ist die Summe der AllowedIPs.
function wgFullTunnel(): string[] {
  const alle: string[] = []
  for (const peer of currentSettings.wireguard?.peers ?? []) {
    for (const netz of peer.allowed_ips ?? []) alle.push(netz)
  }
  return fullTunnelFamilies(alle)
}

// Build WireGuard Peers Tab
function buildWgPeersTab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
  const wg = currentSettings.wireguard

  const header = new Gtk.Box({ spacing: 8 })
  const title = new Gtk.Label({ label: _("Peers"), xalign: 0, hexpand: true })
  title.add_css_class("vpn-section-title")

  // Rolle umrandet, wie addNetBtn. rebuildPeerList ist eine
  // Funktionsdeklaration und damit gehoben.
  const addBtn = zepButton(ICONS.add, "umrandet", () => {
    wg.peers.push({ public_key: "", endpoint: "", allowed_ips: [],
                    keepalive: 0, preshared_key_file: "" })
    rebuildPeerList()
  })
  addBtn.set_tooltip_text(_("Add peer"))

  header.append(title)
  header.append(addBtn)
  box.append(header)

  const hint = new Gtk.Label({
    label: _("Without at least one peer with allowed networks the tunnel comes up and carries no traffic."),
    xalign: 0, wrap: true,
  })
  hint.add_css_class("vpn-psk-status")
  box.append(hint)

  const list = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
  list.add_css_class("vpn-list-container")

  function rebuildPeerList() {
    clearBox(list)
    for (let i = 0; i < wg.peers.length; i++) {
      const idx = i
      const peer = wg.peers[i]
      const card = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6 })
      card.add_css_class("vpn-list-item")

      const cardHead = new Gtk.Box({ spacing: 8 })
      const cardTitle = new Gtk.Label({
        label: format(_("Peer {number}"), { number: String(idx + 1) }),
        xalign: 0, hexpand: true,
      })
      cardTitle.add_css_class("vpn-field-label")
      // Rolle kritisch, wie vom Auftrag verlangt (loeschen ist zerstoerend).
      const deleteBtn = zepButton(ICONS.delete, "kritisch", () => {
        wg.peers.splice(idx, 1)
        rebuildPeerList()
      })
      deleteBtn.set_tooltip_text(_("Delete peer"))
      cardHead.append(cardTitle)
      cardHead.append(deleteBtn)
      card.append(cardHead)

      card.append(createEntryField(_("Public key of the peer"), peer.public_key ?? "",
                                   (val) => { peer.public_key = val }))
      card.append(createEntryField(_("Endpoint"), peer.endpoint ?? "",
                                   (val) => { peer.endpoint = val }))
      card.append(createNumericField(_("Keepalive (seconds, 0 = off)"), peer.keepalive ?? 0,
                                     (val) => { peer.keepalive = val }))
      // AllowedIPs. Begrifflich dasselbe wie `routed_networks` auf der
      // IPsec-Seite, und deshalb dieselbe Listenform.
      //
      // Der Hinweis rechnet ueber ALLE Gegenstellen (wgFullTunnel) und
      // nicht ueber diese eine: in die Routentabelle kommt ihre
      // Vereinigung, und zwei Gegenstellen mit je einer Haelfte sind
      // zusammen ein Volltunnel, den keine von beiden allein waere.
      card.append(buildStringList(
        _("Allowed networks"), _("Add network"), _("e.g. 10.0.0.0/8"),
        () => peer.allowed_ips ?? [], (values) => { peer.allowed_ips = values },
        "vpn-field-label",
        () => fullTunnelNote(wgFullTunnel())))

      list.append(card)
    }
  }

  rebuildPeerList()
  box.append(list)
  return box
}

// ============================================================================
// OPENVPN
// ============================================================================
//
// Eine .ovpn einlesen - und warum das NICHT NetworkManager tut.
//
// Der Einleser sitzt in src/vpn.py, aus demselben Grund wie bei
// WireGuard (eine zweite Umsetzung in GJS ist die Doppelung, die
// dieses Fenster schon einmal teuer bezahlt hat) - und hier kommt ein
// zweiter Grund dazu, der gemessen ist:
//
//     NetworkManager BRINGT einen .ovpn-Einleser mit, und er
//     VERSCHLUCKT die gefaehrlichen Zeilen SPURLOS. GEMESSEN am
//     22.08.2026, indem er ausgefuehrt wurde (reiner
//     Bibliotheksaufruf, ohne D-Bus): eine Datei mit script-security,
//     up, down, route-up, ipchange, tls-verify und plugin kam ohne
//     eine einzige dieser Zeilen und ohne jede Meldung durch,
//     Rueckgabewert 0. Eine frei erfundene Direktive ebenso.
//
//     Ausgefuehrt wird davon nichts (nm-openvpn-service baut openvpns
//     Befehlszeile aus einer geschlossenen Liste und kennt kein
//     --config) - aber der Nutzer erfaehrt nie, dass die Zeile, die
//     seinen Verkehr eingegrenzt haette, verschwunden ist. Genau das
//     macht unser Einleser anders: benannt, mit Zeilennummer, und mit
//     einem eigenen Rueckgabewert.
const OVPN_KEY_DISPLAY_DIR = "~/.config/openvpn"

// Als Funktion und nicht als Template-Literal an der Einsetzstelle -
// dieselbe Begruendung wie bei wgKeyDisplayPath() weiter oben
// (test_ags_i18n.py verfolgt Ausdruecke bis in den Setzer).
function ovpnFileDisplayPath(name: string): string {
  return name.startsWith("/") ? name : `${OVPN_KEY_DISPLAY_DIR}/${name}`
}

// Dieselbe Huelle wie bei WireGuard, aus demselben Grund: `vpn.py
// --ovpn-import` endet mit 3, wenn Zeilen abgelehnt wurden, und
// execAsync wuerde bei jedem Wert ungleich 0 die Standardausgabe
// verwerfen - also genau die eingelesenen Werte. Der Programmtext ist
// eine KONSTANTE, alles Veraenderliche steht als Argument dahinter.
const OVPN_IMPORT_SHELL =
  'out=$("$@"); rc=$?; if [ "$rc" = 0 ] || [ "$rc" = 3 ]; then printf %s "$out"; exit 0; fi; exit "$rc"'

function buildOvpnImportSection(): Gtk.Box {
  const section = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
  section.add_css_class("vpn-field")

  const title = new Gtk.Label({ label: _("OpenVPN configuration"), xalign: 0 })
  title.add_css_class("vpn-field-label")

  const row = new Gtk.Box({ spacing: 8 })
  row.add_css_class("vpn-entry-row")

  const pathEntry = new Gtk.Entry({ hexpand: true, placeholder_text: _("Path to an .ovpn file ...") })
  pathEntry.add_css_class("vpn-entry")

  const status = new Gtk.Label({ label: "", xalign: 0, wrap: true })
  status.add_css_class("vpn-psk-status")

  // Die zweite, leisere Zeile: bekannte Direktiven, die nichts an der
  // Verbindung aendern, weil NetworkManager sein eigenes Gegenstueck
  // setzt. Sie bekommen KEINEN eigenen Rueckgabewert - aber sie werden
  // gezeigt, weil "still verworfen" genau der Vorwurf ist, den dieser
  // Einleser gegen NetworkManagers eigenen erhebt.
  const ignoredLabel = new Gtk.Label({ label: "", xalign: 0, wrap: true })
  ignoredLabel.add_css_class("vpn-psk-status")

  const browseBtn = zepButton(ICONS.folder, "still", () => {
    try {
      const chooser = new (Gtk as any).FileDialog({
        title: _("Choose an OpenVPN configuration"),
      })
      chooser.open(parentWindow, null, (_source: any, result: any) => {
        try {
          const file = chooser.open_finish(result)
          if (file) pathEntry.set_text(file.get_path() ?? "")
        } catch (e) {
          // Abgebrochen ist kein Fehler und bekommt keine Meldung.
        }
      })
    } catch (e) {
      status.set_text(_("No file chooser available - please type the path."))
      status.add_css_class("warning")
    }
  })
  browseBtn.set_tooltip_text(_("Choose an OpenVPN configuration"))

  row.append(pathEntry)
  row.append(browseBtn)

  const importBtn = zepButton(_("Import"), "umrandet", async () => {
    const path = pathEntry.get_text().trim()
    if (!path) return
    try {
      const answer = await execAsync(["bash", "-c", OVPN_IMPORT_SHELL,
                                      "zepos-ovpn-import", ...VPN_TOOL,
                                      "--ovpn-import", path])
      const payload = JSON.parse(answer)
      currentSettings.openvpn = payload.openvpn
      // DNS und Netzliste sind DIESELBEN Reiter wie bei IPsec und
      // WireGuard. `dhcp-option DNS` gehoert dorthin, `route` gehoert
      // in `routed_networks` - nicht in einen zweiten Reiter, der
      // dasselbe noch einmal sagt.
      if (payload.dns) currentSettings.dns = payload.dns
      if (payload.routed_networks?.length) {
        currentSettings.routed_networks = payload.routed_networks
      }

      // Wie bei WireGuard: was die Datei ueber den Umfang sagt, steht
      // schon hier. Bei OpenVPN kommen zwei Wege zusammen (die Netzliste
      // und `redirect-gateway`) - beide rechnet openvpn_full_tunnel()
      // in src/vpn.py, und beide liegen als `full_tunnel` im Umschlag.
      const volltunnel = importFullTunnelNote(payload.full_tunnel ?? [])

      const refused: [number, string][] = payload.refused ?? []
      if (refused.length) {
        status.set_text(format(
          _("Imported. These lines were NOT taken over, because they run commands: {lines}"),
          { lines: refused.map(([line, key]) => `${key} (${line})`).join(", ") }) + volltunnel)
        status.remove_css_class("success")
        status.add_css_class("warning")
      } else {
        status.set_text(_("Imported") + volltunnel)
        status.remove_css_class("warning")
        status.remove_css_class("success")
        status.add_css_class(volltunnel ? "warning" : "success")
      }

      const ignored: [number, string][] = payload.ignored ?? []
      ignoredLabel.set_text(ignored.length ? format(
        _("These lines have no effect here, because NetworkManager sets its own: {lines}"),
        { lines: ignored.map(([line, key]) => `${key} (${line})`).join(", ") }) : "")

      try {
        await execAsync(['notify-send', '-i', 'network-vpn', _("OpenVPN"),
                         format(_("The certificates and the key were stored privately. The original {path} still contains them in clear text - you may want to delete it."),
                                { path })])
      } catch { }
      rebuildTabs()
    } catch (e) {
      status.set_text(format(_("Not imported: {error}"), { error: String(e) }))
      status.remove_css_class("success")
      status.add_css_class("warning")
    }
  })

  const actions = new Gtk.Box({ spacing: 8, halign: Gtk.Align.END })
  actions.append(importBtn)

  section.append(title)
  section.append(row)
  section.append(actions)
  section.append(status)
  section.append(ignoredLabel)
  return section
}

// `redirect-gateway` aus den mitgenommenen Direktiven - der Zwilling von
// src/vpn.py::openvpn_redirect_families(). Die Fahnen, auf die es
// ankommt, sind an openvpn(8) abgelesen und dort begruendet; `!ipv4`
// nimmt IPv4 heraus, `ipv6` nimmt IPv6 dazu, alle uebrigen aendern nur
// das WIE. `redirect-private` steht absichtlich nicht dabei: es laesst
// die Standardroute in Ruhe.
function ovpnRedirectFamilies(): string[] {
  let v4 = false
  let v6 = false
  for (const entry of currentSettings.openvpn?.extra ?? []) {
    if (!entry.length) continue
    if (String(entry[0]).trim().toLowerCase() !== "redirect-gateway") continue
    const flags = entry.slice(1).map((flag) => String(flag).trim().toLowerCase())
    if (flags.indexOf("!ipv4") < 0) v4 = true
    if (flags.indexOf("ipv6") >= 0) v6 = true
  }
  const families: string[] = []
  if (v4) families.push(FULL_TUNNEL_V4)
  if (v6) families.push(FULL_TUNNEL_V6)
  return families
}

// Build OpenVPN Connection Tab
function buildOvpnConnectionTab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
  const ovpn = currentSettings.openvpn

  const sectionTitle = new Gtk.Label({ label: _("Connection settings"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  box.append(createEntryField(_("Server"), ovpn.remote ?? "",
                              (val) => { ovpn.remote = val }))
  box.append(createNumericField(_("Port (0 = 1194)"), ovpn.port ?? 0,
                                (val) => { ovpn.port = val }))
  box.append(createToggleGroup(_("Protocol"), [
    { label: _("UDP"), value: "udp" },
    { label: _("TCP"), value: "tcp" }
  ], (ovpn.proto ?? "udp").startsWith("tcp") ? "tcp" : "udp",
     (val) => { ovpn.proto = val }))
  box.append(createToggleGroup(_("Device"), [
    { label: _("tun (routed)"), value: "tun" },
    { label: _("tap (bridged)"), value: "tap" }
  ], (ovpn.dev ?? "tun") === "tap" ? "tap" : "tun",
     (val) => { ovpn.dev = val }))

  // WIE SICH DIE VERBINDUNG AUSWEIST - UND WARUM DAS HIER STEHT
  //     Der Wert entscheidet zweierlei: ob die VPN-Seite Anmeldefelder
  //     zeigt, und ob die Verbindung nach dem Aufwachen von selbst
  //     zurueckkommt (siehe den Hinweis im Reiter "Allgemein").
  //     Deshalb ist er ein Bedienelement und keine stille Ableitung -
  //     der Einleser setzt ihn aus der Datei, aber wer eine Verbindung
  //     von Hand anlegt, muss ihn sehen.
  box.append(createToggleGroup(_("Authentication"), [
    { label: _("Certificates"), value: "tls" },
    { label: _("Username and password"), value: "password" },
    { label: _("Both"), value: "password-tls" }
  ], ovpn.connection_type ?? "tls", (val) => {
    ovpn.connection_type = val
    rebuildTabs()
  }))

  if (ovpn.connection_type !== "tls") {
    box.append(createEntryField(_("Username"), ovpn.username ?? "",
                                (val) => { ovpn.username = val }))
    const note = new Gtk.Label({
      label: _("The password is not stored. It is typed on the VPN page and handed to NetworkManager in a file that is deleted again."),
      xalign: 0, wrap: true,
    })
    note.add_css_class("vpn-psk-status")
    box.append(note)
  }

  box.append(createEntryField(_("Verify server certificate (remote-cert-tls)"),
                              ovpn.remote_cert_tls ?? "",
                              (val) => { ovpn.remote_cert_tls = val }))
  box.append(createEntryField(_("Cipher"), ovpn.cipher ?? "",
                              (val) => { ovpn.cipher = val }))
  box.append(createEntryField(_("HMAC authentication"), ovpn.auth ?? "",
                              (val) => { ovpn.auth = val }))

  // DIE NETZLISTE - SEIT DEM 22.08.2026 AUCH HIER SICHTBAR
  //
  //     Sie wurde beim Einlesen einer .ovpn schon immer gefuellt (aus
  //     den `route`-Zeilen, siehe openvpn_routes() in src/vpn.py) und
  //     beim Verbinden schon immer gelesen - GEZEIGT wurde sie in
  //     keinem der vier Reiter dieser Bauart. Der Nutzer konnte also
  //     nicht sehen, was durch den Tunnel geht, und erst recht nichts
  //     daran aendern; bestellt am 22.08.2026: "ich will es
  //     konfigurierbar haben".
  //
  //     Sie steht in DIESEM Reiter und nicht in einem fuenften: die
  //     Leiste bleibt bei vier Knoepfen (siehe tabsForKind), und es ist
  //     derselbe Wert wie bei den anderen zwei Bauarten
  //     (currentSettings.routed_networks), also dasselbe Bauteil.
  box.append(buildStringList(
    _("Routed networks"), _("Add network"), _("e.g. 10.0.0.0/8"),
    () => currentSettings.routed_networks,
    (values) => { currentSettings.routed_networks = values },
    "vpn-field-label",
    () => {
      // Zwei Wege, auf denen eine .ovpn "alles" sagen kann, und zwei
      // Saetze: die Liste deckt alles ab - oder `redirect-gateway`
      // sagt es, ganz unabhaengig von der Liste. Ein einziger Satz
      // haette den zweiten Fall der Liste angelastet, die ihn nicht
      // verursacht.
      const teile: string[] = []
      const ausListe = fullTunnelNote(
        fullTunnelFamilies(currentSettings.routed_networks))
      if (ausListe) teile.push(ausListe)
      if (ovpnRedirectFamilies().length) {
        teile.push(_("Full tunnel: the file carries redirect-gateway, which sends all traffic through the tunnel - independently of this list."))
      }
      return teile.join(" ")
    }))

  // Die mitgenommenen Direktiven ohne eigenes Feld. NUR GEZEIGT: sie
  // stammen aus einer Erlaubnisliste in src/vpn.py, nicht aus einer
  // Durchreiche, und wer sie aendern will, aendert die .ovpn und liest
  // sie neu ein. Achtzehn weitere Eingabefelder waeren genau die
  // Breitenrechnung, die dieses Fenster schon einmal gesprengt hat.
  const extra = ovpn.extra ?? []
  if (extra.length) {
    const extraLabel = new Gtk.Label({
      label: format(_("{count} further options were taken over from the file: {options}"),
                    { count: String(extra.length),
                      options: extra.map((entry) => entry.join(" ")).join(", ") }),
      xalign: 0, wrap: true,
    })
    extraLabel.add_css_class("vpn-psk-status")
    box.append(extraLabel)
  }

  return box
}

// Build OpenVPN Certificates Tab
function buildOvpnCertificatesTab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
  const ovpn = currentSettings.openvpn

  const sectionTitle = new Gtk.Label({ label: _("Certificates and keys"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  const hint = new Gtk.Label({
    label: _("Blocks embedded in the .ovpn file were unpacked into ~/.config/openvpn, readable only by you (0600). Only their file names are stored in the settings."),
    xalign: 0, wrap: true,
  })
  hint.add_css_class("vpn-psk-status")
  box.append(hint)

  // Fuenf Zeilen, EINE Schleife. Fuenf abgeschriebene Bloecke waeren
  // fuenf Stellen, an denen der naechste Dateityp vergessen wird -
  // dieselbe Begruendung wie bei buildStringList weiter oben.
  const files: [string, string, (value: string) => void][] = [
    [_("CA certificate"), ovpn.ca_file ?? "", (val) => { ovpn.ca_file = val }],
    [_("Own certificate"), ovpn.cert_file ?? "", (val) => { ovpn.cert_file = val }],
    [_("Own private key"), ovpn.key_file ?? "", (val) => { ovpn.key_file = val }],
    [_("TLS auth key"), ovpn.tls_auth_file ?? "", (val) => { ovpn.tls_auth_file = val }],
    [_("TLS crypt key"), ovpn.tls_crypt_file ?? "", (val) => { ovpn.tls_crypt_file = val }],
  ]
  for (const [label, value, setter] of files) {
    const field = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
    field.add_css_class("vpn-field")
    const caption = new Gtk.Label({ label, xalign: 0 })
    caption.add_css_class("vpn-field-label")
    const entry = new Gtk.Entry({ hexpand: true, text: value,
                                  placeholder_text: _("File name or absolute path ...") })
    entry.add_css_class("vpn-entry")
    entry.connect("changed", () => setter(entry.get_text()))
    const where = new Gtk.Label({
      label: value ? format(_("Present in {path}"), { path: ovpnFileDisplayPath(value) })
                   : _("Not set"),
      xalign: 0, wrap: true,
    })
    where.add_css_class("vpn-psk-status")
    if (value) where.add_css_class("success")
    field.append(caption)
    field.append(entry)
    field.append(where)
    box.append(field)
  }

  box.append(createEntryField(_("TLS auth key direction (0, 1 or empty)"),
                              ovpn.ta_dir ?? "", (val) => { ovpn.ta_dir = val }))

  return box
}

// Build DNS Tab
function buildDnsTab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })

  const sectionTitle = new Gtk.Label({ label: _("DNS settings"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  box.append(createEntryField(_("Search domain"), currentSettings.dns.search_domain, (val) => { currentSettings.dns.search_domain = val }))

  // Dieselbe Liste wie die gerouteten Netze und die WireGuard-Adressen -
  // ein Bauteil, vier Verwendungen. Siehe buildStringList.
  box.append(buildStringList(
    _("DNS servers"), _("Add DNS server"), _("IP address ..."),
    () => currentSettings.dns.servers,
    (values) => { currentSettings.dns.servers = values }))

  return box
}

// ============================================================================
// MAIN WIDGET
// ============================================================================
export default function VpnSettings(): OverlayWidget {
  let closeFn: (() => void) | null = null

  // Load settings
  currentSettings = loadSettings()

  return createOverlayWindow({
    name: "vpn-settings",
    width: WIN_WIDTH,
    height: 600,
    cssClass: "VpnSettings",
    headerIcon: ICONS.settings,
    headerTitle: _("VPN settings"),
    accentCssClass: "vpn-accent",
    onShow: () => {
      currentSettings = loadSettings()

      // Rebuild tabs with loaded settings
      rebuildTabs()
    },
    buildContent: (win, closeWindow) => {
      closeFn = closeWindow
      closeFnModule = closeWindow
      // Fuer Gtk.FileDialog.open() im WireGuard-Einleser. Der Parameter
      // hiess bis zum 21.08.2026 `_win` und war unbenutzt; ein
      // Dateiwaehler braucht ein Elternfenster.
      parentWindow = win

      // Main container
      const mainBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
      mainBox.add_css_class("vpn-settings-container")

      // Tab bar. Die Knoepfe kommen aus rebuildTabs() weiter unten -
      // welche es sind, haengt an der Bauart, und sie werden beim
      // Umschalten getauscht statt einmal gebaut. Deshalb steht hier
      // nur noch die Huelle.
      tabBar = new Gtk.Box({ spacing: 4 })
      tabBar.add_css_class("vpn-tab-bar")

      // Tab content
      const contentBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL })
      contentBox.add_css_class("vpn-tab-content")

      // Scrolled window for content
      const scroll = new Gtk.ScrolledWindow({
        hscrollbar_policy: Gtk.PolicyType.NEVER,
        vscrollbar_policy: Gtk.PolicyType.AUTOMATIC,
        vexpand: true,
      })

      scrollContent = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL })
      scroll.set_child(scrollContent)
      contentBox.append(scroll)

      // NACH scrollContent und NACH tabBar: rebuildTabs() fuellt beide
      // und steigt aus, solange eines von beiden noch fehlt.
      rebuildTabs()

      // Actions
      const actionsBox = new Gtk.Box({ spacing: 12, halign: Gtk.Align.END })
      actionsBox.add_css_class("vpn-settings-actions")

      // VIER FUSSKNOEPFE, UND WARUM DIE UMSTELLUNG DIE BREITE NICHT
      // SPRENGT (WIN_WIDTH = Sprosse M = 660, siehe Dateikopf)
      //
      //     Hier stand 642 - der Wert, den dieses Fenster am 18.08.2026
      //     vormittags noch als eigene ausgemessene Zahl trug. Seit der
      //     Breitenleiter vom selben Tag nennt es die Sprosse M, und die
      //     ist 660. Die Rechnung darunter wird dadurch nur grosszuegiger,
      //     nicht knapper: achtzehn Punkte mehr, nicht weniger.
      //
      //     Die vier Knoepfe unten trugen vorher je eigene Innenabstaende
      //     (STYLE_SPACE_8/12 bei back-btn, STYLE_SPACE_12/20 bei
      //     reset/cancel/save-btn). zep-btn erzwingt fuer alle vier
      //     dieselben 0/STYLE_SPACE_16. Mit dem ausgelieferten Faktor
      //     1.85 aufgeloest (STYLE_SPACE_12=18px, STYLE_SPACE_16=25px,
      //     STYLE_SPACE_20=31px):
      //
      //         back-btn:            36px -> 50px   (+14px)
      //         reset/cancel/save:   62px -> 50px    (-12px je Knopf)
      //
      //     macht in Summe -22px auf die Fusszeile - die drei breiteren
      //     Knoepfe schrumpfen mehr, als der schmalste waechst. Die im
      //     Dateikopf gemessene Zeilenbreite (566px) wird durch die
      //     Umstellung also NICHT ueberschritten, sondern mit Abstand
      //     unterschritten - anders als bei se-tab-btn (Task B) haengt
      //     WIN_WIDTH hier an GENAU diesen vier Knoepfen, aber die
      //     Rechnung geht in die sichere Richtung. GEPRUEFT (nicht im
      //     Compositor gemessen, tests/render verboten), siehe
      //     Gruppe-E-Bericht.
      const resetBtn = zepButton("", "kritisch", resetSettings)
      const resetBtnBox = new Gtk.Box({ spacing: 6 })
      resetBtnBox.append(new Gtk.Label({ label: ICONS.reset }))
      resetBtnBox.append(new Gtk.Label({ label: _("Reset") }))
      resetBtn.set_child(resetBtnBox)

      const cancelBtn = zepButton(_("Cancel"), "umrandet", () => closeFn?.())

      // Back to VPN button. Rolle still: reine Navigation.
      const backBtn = zepButton(_("← VPN"), "still", () => {
        closeFn?.()
        execAsync("ags request vpn")
      })
      backBtn.set_tooltip_text(_("Back to the VPN connection"))

      // Rolle voll: die Hauptsache dieses Fensters - alle vier Reiter
      // teilen sich diese eine Fusszeile, genau EIN voll fuer das ganze
      // Fenster (nicht je Reiter).
      const saveBtn = zepButton("", "voll", async () => {
        await saveSettings()
        // Note: saveSettings() already closes overlay and opens VPN
      })
      const saveBtnBox = new Gtk.Box({ spacing: 6 })
      saveBtnBox.append(new Gtk.Label({ label: ICONS.save }))
      saveBtnBox.append(new Gtk.Label({ label: _("Save") }))
      saveBtn.set_child(saveBtnBox)

      actionsBox.append(backBtn)
      actionsBox.append(resetBtn)
      actionsBox.append(cancelBtn)
      actionsBox.append(saveBtn)

      // ============================================================
      // DIE VERBINDUNGSLISTE LINKS - seit dem 22.08.2026
      // ============================================================
      //
      // "das gleiche gilt uebrigens fuer die anderen vpn verbindungen
      //  auch!!!" - also nicht nur auf der Schalenseite, sondern auch
      // dort, wo eine Verbindung eingerichtet wird.
      //
      // KEIN FUENFTER REITER UND KEIN ZWEITES FENSTER
      //     Die Reiterleiste bleibt bei VIER Knoepfen (siehe
      //     tabsForKind()), und rechts steht Zeile fuer Zeile, was
      //     vorher dastand - dieselben acht build*Tab(). Was sich
      //     aendert, ist nur, WELCHE Verbindung sie fuellen.
      //
      // AUS ZEPROW, NICHT AUS ZEPSIDEBAR
      //     zepSidebar (ags-kit.template) baut die Seitenleiste der
      //     SCHALE: 208px breit, mit Gruppen. Hier waeren die 208px
      //     genau das, was die Breitenrechnung im Dateikopf nicht
      //     hergibt. Dieselbe ZEILE (zepRow, mit `ausgewaehlt` und
      //     `aktion`) in einer schmaleren Huelle ist darum keine
      //     dritte Zeilenform, sondern derselbe Baustein an einer
      //     Flaeche mit anderem Mass - genau die Unterscheidung, die
      //     der Kopf von zepSidebar am 19.08.2026 getroffen hat.
      // Ein getippter Abstand und KEIN {{STYLE_SPACE_*}}: die
      // Platzhalter loesen sich zu CSS-Werten mit Einheit auf ("12px"),
      // und Gtk.Box.spacing ist eine Zahl. GEMESSEN am 22.08.2026:
      // `ags bundle` brach mit `Syntax error "p"` ab. Dieselbe Zahl wie
      // bei tabBar darunter, damit die zwei Leisten uebereinander
      // denselben Rhythmus haben.
      listenBox = new Gtk.Box({ spacing: 4 })
      listenBox.add_css_class("vpn-connection-picker")

      const zeichneListe = () => {
        if (!listenBox) return
        let kind = listenBox.get_first_child()
        while (kind) {
          const naechstes = kind.get_next_sibling()
          listenBox.remove(kind)
          kind = naechstes
        }
        listenBox.append(zepSectionLabel(_("VPN connections")))
        for (const eintrag of alleVerbindungen) {
          const kennung = (eintrag as any).id
          const bauart = eintrag.kind === "wireguard" ? "WireGuard"
            : eintrag.kind === "openvpn" ? "OpenVPN" : "IPsec"
          listenBox.append(zepRow({
            symbol: ICONS.server,
            // Bauart UND Name in einer Zeile: eine Nebenzeile waere in
            // einer waagerechten Leiste eine zweite Hoehe, keine
            // zweite Zeile.
            titel: `${eintrag.connection_name || _("New connection")} · ${bauart}`,
            ausgewaehlt: kennung === gewaehlteId,
            aktion: () => {
              // Die gezeigte Verbindung zuerst in die Liste
              // zurueckschreiben - sonst verlaere ein Klick auf eine
              // andere Zeile jede Eingabe, die noch nicht gespeichert
              // ist.
              alleVerbindungen = alleVerbindungen.map(
                (e: any) => (e.id === gewaehlteId ? currentSettings : e))
              gewaehlteId = kennung
              currentSettings = alleVerbindungen.find(
                (e: any) => e.id === kennung) || currentSettings
              rebuildTabs()
              zeichneListe()
            },
          }))
        }
        const addBtn = zepButton(_("Add connection"), "umrandet", () => {
          alleVerbindungen = alleVerbindungen.map(
            (e: any) => (e.id === gewaehlteId ? currentSettings : e))
          const frisch = defaultSettings()
          ;(frisch as any).id = neueKennung()
          frisch.connection_name = ""
          alleVerbindungen = [...alleVerbindungen, frisch]
          gewaehlteId = (frisch as any).id
          currentSettings = frisch
          rebuildTabs()
          zeichneListe()
        })
        listenBox.append(addBtn)
      }
      zeichneListe()

      // Assemble
      //
      // DIE LEISTE STEHT OBEN UND NICHT LINKS - GEMESSEN, NICHT
      // ENTSCHIEDEN (22.08.2026)
      //
      //     Entworfen war sie links, als senkrechte Leiste neben den
      //     Reitern. Gemessen im verschachtelten Compositor
      //     (tests/render/test_vpn_breite.py, 1920x1080) verlangte das
      //     Fenster damit 1044 Punkte, wo Sprosse L 854 laesst -
      //     UEBERHANG 190.
      //
      //     Der Grund ist nicht die Leiste allein (die misst ~180),
      //     sondern die Form: nebeneinander ADDIEREN sich die
      //     Ansprueche von Leiste und Reiterflaeche, uebereinander
      //     gilt nur das MAXIMUM. Die Reiterflaeche allein verlangt
      //     schon fast die ganze Sprosse.
      //
      //     Und eine breitere Sprosse gibt es nicht: L (880) ist die
      //     oberste, und MEASURE_MODAL_SHARE (0,5) erlaubt auf 1920
      //     hoechstens 960 - die 1070, die das Fenster mit
      //     Seitenleiste braeuchte, sind auch mit einer neuen Sprosse
      //     nicht zu haben. Eine Sprosse anzulegen waere ausserdem eine
      //     Entscheidung ueber die LEITER und nicht ueber dieses
      //     Fenster.
      //
      //     Also waagerecht, ueber der Reiterleiste. Es ist dieselbe
      //     Liste aus denselben zepRow-Zeilen, dieselbe Auswahl und
      //     derselbe Hinzufuegen-Knopf - sie steht nur an der Kante,
      //     an der sie nichts kostet. Der senkrechte Entwurf ist damit
      //     nicht verworfen, sondern vertagt, bis die Fusszeile
      //     schmaler wird; der Befund steht im Bericht zu dieser
      //     Aufgabe.
      mainBox.append(listenBox)
      mainBox.append(tabBar)
      mainBox.append(contentBox)
      mainBox.append(actionsBox)

      return mainBox
    },
  })
}
