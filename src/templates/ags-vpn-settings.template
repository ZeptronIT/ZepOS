// Die zwei Bauarten. Als Zeichenketten-Vereinigung und nicht als
// `string`, damit ein Tippfehler beim Uebersetzen auffaellt und nicht
// erst an einem Fenster, das leere Reiter zeigt.
type VpnKind = "ipsec" | "wireguard"

interface WgPeer {
  public_key: string
  endpoint: string
  // Dieselbe Sache wie `routed_networks` auf der IPsec-Seite, nur wie
  // WireGuard sie nennt - und deshalb mit DEMSELBEN Bauteil bedient
  // (siehe buildWgPeersTab unten), nicht mit einem zweiten.
  allowed_ips: string[]
  keepalive: number
  // Ein DATEINAME, nie der Schluessel. Siehe den Kommentar bei
  // WgSettings.private_key_file.
  preshared_key_file: string
}

interface WgSettings {
  addresses: string[]
  listen_port: number
  mtu: number
  // DER DATEINAME UNTER ~/.config/wireguard, NICHT DER SCHLUESSEL.
  //
  // Dieses Fenster schreibt seinen Abschnitt nach user-settings.json,
  // und diese Datei liest der Stil-Erzeuger, gibt `zepos-settings` aus
  // und fasst der Doktor an. Ein privater Schluessel darin waere ein
  // Geheimnis in vier Programmen. Er liegt stattdessen einzeln unter
  // ~/.config/wireguard, 0600 vom ersten Byte, Verzeichnis 0700 -
  // geschrieben von src/vpn.py::write_wireguard_secret(), aus demselben
  // Grund, aus dem savePsk() weiter unten Gio.FileCreateFlags.PRIVATE
  // benutzt statt open()+chmod.
  private_key_file: string
  // Der EIGENE oeffentliche Schluessel. Er ist kein Geheimnis - er ist
  // genau das, was der Nutzer der Gegenstelle schicken muss - und steht
  // deshalb als einziger Schluesselwert in der Einstellungsdatei.
  public_key: string
  peers: WgPeer[]
}

interface VpnSettings {
  // Welche Bauart. Vorgabe "ipsec", und das darf nie geraten werden:
  // jede Installation von vor dem 21.08.2026 hat diesen Schluessel
  // nicht.
  kind: VpnKind
  server: string
  username: string
  connection_name: string
  remember_username: boolean
  // One CIDR per entry. The generator turns each one into a child
  // security association and into the matching route, so a list with
  // four networks needs no change anywhere else - the origin had three
  // named child SAs written out by hand, which is why it had exactly
  // three.
  routed_networks: string[]
  // A host that only answers through the tunnel, used to tell an
  // established tunnel from one that actually carries traffic.
  test_host: string
  phase1: {
    version: number
    aggressive: boolean
    proposals: string
    keylife: number
    dpd_delay: number
    dpd_timeout: number
    encap: boolean
    mobike: boolean
  }
  phase2: {
    rekey_time: number
    life_time: number
    mode: string
    replay_window: number
    esp_proposals: string
  }
  dns: {
    servers: string[]
    search_domain: string
  }
  // Both are read by the connect script and both were already written
  // by this dialog, but neither was declared - so every use of them here
  // was a type error, and the file only compiled because nothing type
  // checked it.
  xauth_enabled: boolean
  debug: boolean
  wireguard: WgSettings
}

// The SSOT stores the booleans below as the strings strongSwan expects,
// so they arrive here as "yes" or "no". Comparing a substituted literal
// directly - `"no" === "yes"` - is a type ERROR, not a false expression:
// TypeScript narrows both sides to their literal types and reports that
// they can never overlap. Passing through a parameter typed as `string`
// widens it back and compiles.
const isYes = (value: string): boolean => value === "yes"

