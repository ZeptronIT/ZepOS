// unterstützt - wireguard dateien oder eigene konfigurationen. also
// auswahl: ipsec oder ipsecv2 oder wireguard"
//
// GEMESSEN am selben Tag, BEVOR hier etwas gebaut wurde: das Fenster
// konnte IKEv1 und IKEv2 laengst. Der Umschalter stand im Reiter
// "Phase 1", hiess "IKE version" und lag zwischen
// Schluessellebensdauer und den beiden DPD-Fristen. Er war also da -
// und unauffindbar. Der Nutzer kannte ihn nicht, weil er ihn nie
// gesehen hat.
//
// DIESE AUSWAHL ERFINDET DARUM NICHTS. Sie zeigt eine Unterscheidung,
// die es gibt, an der Stelle, an der man sie sucht, und bildet auf zwei
// bestehende Werte ab:
//
//     IPsec (IKEv1)   kind=ipsec       phase1.version=1
//     IPsec (IKEv2)   kind=ipsec       phase1.version=2
//     WireGuard       kind=wireguard   phase1 bleibt unberuehrt
//
// DER ALTE UMSCHALTER IM DRITTEN REITER FAELLT (Regel 14): zwei
// Bedienelemente fuer denselben Wert sind zwei Stellen, an denen etwas
// Verschiedenes stehen kann - und die eine, die niemand findet,
// gewinnt am Ende. Der Aggressive/Main-Umschalter BLEIBT dort, weil er
// einen ANDEREN Wert traegt (phase1.aggressive); er haengt weiterhin an
// der Version und wird jetzt von hier aus sichtbar geschaltet.
//
// UND phase1.version BLEIBT BEI "WireGuard" UNBERUEHRT, absichtlich:
// wer von IPsec kommt und zurueckschaltet, findet seine IKE-Version
// vor, wie er sie verlassen hat.
//
// UND SEIT DEM 22.08.2026 EIN VIERTER EINTRAG: OpenVPN.
//
//     Bestellt: "ausserdem will ich, dass wir bei vpn auch openvpn
//     format unterstuetzen - das brauchen wir auch". Dasselbe Muster,
//     kein zweites: kind=openvpn, phase1 bleibt unberuehrt, die Reiter
//     werden getauscht statt angehaengt.
const KIND_IPSEC_V1 = "ipsec1"
const KIND_IPSEC_V2 = "ipsec2"
const KIND_WIREGUARD = "wireguard"
const KIND_OPENVPN = "openvpn"

function currentKindChoice(): string {
  if (currentSettings.kind === "wireguard") return KIND_WIREGUARD
  if (currentSettings.kind === "openvpn") return KIND_OPENVPN
  return currentSettings.phase1.version === 1 ? KIND_IPSEC_V1 : KIND_IPSEC_V2
}

function applyKindChoice(choice: string) {
  if (choice === KIND_WIREGUARD) {
    currentSettings.kind = "wireguard"
  } else if (choice === KIND_OPENVPN) {
    currentSettings.kind = "openvpn"
  } else {
    currentSettings.kind = "ipsec"
    currentSettings.phase1.version = choice === KIND_IPSEC_V1 ? 1 : 2
  }
  // Baut die Reiterleiste UND die Inhalte neu - also auch den Kasten,
  // in dem der gerade gedrueckte Knopf sitzt. Das ist in dieser Datei
  // schon der Normalfall (die rebuild-Schleife in buildStringList tut
  // dasselbe aus dem Loeschknopf ihrer eigenen Zeile heraus): die
  // Signalauslieferung haelt eine Referenz auf das Widget, solange der
  // Rueckruf laeuft.
  rebuildTabs()
}

// Der Weg zu vpn.py. Als fertige Argumentliste und nicht als
// Befehlstext: execAsync(string) zerlegt mit GLib.shell_parse_argv und
// startet keine Shell, ein Systemwurzelpfad mit einem Leerzeichen
// waere also zwei Argumente. Dieselbe Begruendung wie bei
// SETTINGS_WRITER oben.
const VPN_TOOL = ["python3", `${ZEPOS_SYSTEM_ROOT}/vpn.py`]

// Das Fenster, an dem der Dateiwaehler haengt. GTK4 will fuer
// Gtk.FileDialog.open() ein Elternfenster; buildContent() bekommt es
// und legt es hier ab.
let parentWindow: any = null

// Build General Tab
function buildGeneralTab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })

  const sectionTitle = new Gtk.Label({ label: _("Connection settings"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  // Die Bauart zuerst, weil sie bestimmt, was darunter ueberhaupt
  // sinnvoll ist.
  box.append(createToggleGroup(_("Connection kind"), [
    { label: _("IPsec (IKEv1)"), value: KIND_IPSEC_V1 },
    { label: _("IPsec (IKEv2)"), value: KIND_IPSEC_V2 },
    { label: _("WireGuard"), value: KIND_WIREGUARD },
    { label: _("OpenVPN"), value: KIND_OPENVPN }
  ], currentKindChoice(), applyKindChoice))

  // DER SATZ UEBER DEN UNBEAUFSICHTIGTEN WIEDERAUFBAU - HIER UND
  // NICHT ERST BEIM SCHEITERN
  //
  //     GEMESSEN am 22.08.2026 an NetworkManagers eigenem Einleser:
  //     eine .ovpn mit `auth-user-pass` ergibt `password-flags = 1`
  //     (agentengehalten, NICHT gespeichert), eine reine
  //     Zertifikatsdatei ergibt gar keine Geheimnisflagge. Und
  //     nm-openvpn-service erfragt `cert-pass`, wenn der private
  //     Schluessel verschluesselt ist.
  //
  //     Folge: nach einem Netzwechsel oder dem Aufwachen kommt eine
  //     reine Zertifikatsverbindung von selbst zurueck, eine mit
  //     Anmeldung nicht. Das ist ein Unterschied zur IPsec-Seite, wo
  //     strongSwan das Geheimnis in seiner eigenen Konfiguration
  //     haelt - und ein Unterschied, den der Nutzer sonst als Fehler
  //     erlebt, ohne ihn mit OpenVPN in Verbindung zu bringen.
  //
  //     Gefragt wird vpn.py und nicht der connection_type allein: die
  //     Passphrase des privaten Schluessels steht in der
  //     Schluesseldatei und nicht in den Einstellungen, und zwei
  //     Herleitungen fuer eine Antwort waeren zwei Stellen, an denen
  //     etwas Verschiedenes stehen kann.
  if (currentSettings.kind === "openvpn") {
    const unattended = new Gtk.Label({ label: "", xalign: 0, wrap: true })
    unattended.add_css_class("vpn-psk-status")
    box.append(unattended)
    execAsync([...VPN_TOOL, "--ovpn-unattended"]).then((answer) => {
      if (String(answer).trim() === "yes") {
        unattended.set_text(_("Certificates only - this connection comes back on its own after a network change or resume."))
        unattended.remove_css_class("warning")
        unattended.add_css_class("success")
      } else {
        unattended.set_text(_("This connection needs a password every time. After a network change or resume it stays down until you connect again."))
        unattended.remove_css_class("success")
        unattended.add_css_class("warning")
      }
    }).catch(() => { })
  }

  // Beide Bauarten. Der Name benennt die swanctl-Verbindung bzw. das
  // NetworkManager-Profil - EIN Name, damit vpn-control.sh und die
  // Leiste dieselbe Sache meinen.
  box.append(createEntryField(_("Connection name"), currentSettings.connection_name, (val) => { currentSettings.connection_name = val }))

  // NUR IPsec. OpenVPN traegt seinen Endpunkt in `openvpn.remote` und
  // seinen Nutzernamen in `openvpn.username` (Reiter "Verbindung") -
  // zwei Felder fuer denselben Wert waeren zwei Stellen, an denen
  // etwas Verschiedenes stehen kann. Dieselbe Regel, aus der der alte
  // IKE-Umschalter im dritten Reiter gefallen ist.
  if (currentSettings.kind === "ipsec") {
    box.append(createEntryField(_("VPN server"), currentSettings.server, (val) => { currentSettings.server = val }))
    box.append(createEntryField(_("Default username"), currentSettings.username, (val) => { currentSettings.username = val }))
  }

  // Optional. Without it an established tunnel that routes nothing looks
  // exactly like a working one, from the bar and from this dialog alike.
  // Gilt fuer beide Bauarten: ein WireGuard-Tunnel, der steht und
  // nichts traegt, sieht von aussen genauso aus.
  box.append(createEntryField(_("Test host (optional)"), currentSettings.test_host ?? "", (val) => { currentSettings.test_host = val }))

  if (currentSettings.kind === "ipsec") {
    // XAuth Toggle
    const xauthRow = new Gtk.Box({ spacing: 12 })
    xauthRow.add_css_class("vpn-field")
    xauthRow.append(createCheckbox(_("Enable XAuth"), currentSettings.xauth_enabled ?? false, (val) => { currentSettings.xauth_enabled = val }))
    box.append(xauthRow)
  }

  // Debug Toggle
  const debugRow = new Gtk.Box({ spacing: 12 })
  debugRow.add_css_class("vpn-field")
  debugRow.append(createCheckbox(_("Show debug terminal"), currentSettings.debug ?? false, (val) => { currentSettings.debug = val }))
  box.append(debugRow)

  if (currentSettings.kind === "wireguard") {
    box.append(buildWgImportSection())
    return box
  }

  if (currentSettings.kind === "openvpn") {
    box.append(buildOvpnImportSection())
    return box
  }

  // PSK Section (sudo-protected)
  const pskSection = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
  pskSection.add_css_class("vpn-field")

  const pskLabel = new Gtk.Label({ label: _("Pre-shared key"), xalign: 0 })
  pskLabel.add_css_class("vpn-field-label")

  const pskRow = new Gtk.Box({ spacing: 8 })
  pskRow.add_css_class("vpn-entry-row")

  const pskEntry = new Gtk.Entry({ hexpand: true, placeholder_text: _("Enter or show the PSK ..."), visibility: false })
  pskEntry.add_css_class("vpn-entry")

  let pskVisible = false
  // Rolle still, wie passwordVisBtn in ags-vpn.template (Zeichen-Knopf am
  // Rand der Eingabezeile) - dieselbe Hoehenpruefung gilt hier: .vpn-entry
  // bestimmt die Zeilenhoehe von .vpn-entry-row, nicht der Knopf.
  const pskVisibilityBtn = zepButton(ICONS.eye, "still", () => {
    if (!pskVisible) {
      // Read straight from the user's own file - no privilege involved
      const psk = loadPsk()
      if (psk) {
        pskEntry.set_text(psk)
        pskEntry.set_visibility(true)
        pskVisible = true
        const icon = pskVisibilityBtn.get_child() as Gtk.Label
        icon.set_text(ICONS.eyeSlash)
      }
    } else {
      pskEntry.set_visibility(false)
      pskVisible = false
      const icon = pskVisibilityBtn.get_child() as Gtk.Label
      icon.set_text(ICONS.eye)
    }
  })
  pskVisibilityBtn.set_tooltip_text(_("Show PSK"))

  // Status label showing if PSK exists. Declared before the save
  // button, which now updates it: a save that failed has to change what
  // the user is looking at, not only send a notification.
  const pskStatus = new Gtk.Label({ label: "", xalign: 0 })
  pskStatus.add_css_class("vpn-psk-status")

  // Rolle umrandet: eine wirkliche, sofort wirksame Handlung (PSK
  // speichern), aber nicht die Hauptsache des Fensters (das ist
  // vpn-save-btn unten) - dieselbe Einordnung wie privacyMicBtn (Task D).
  const pskSaveBtn = zepButton(ICONS.save, "umrandet", async () => {
    const psk = pskEntry.get_text()
    if (psk) {
      // The success message is now sent only if the file is really
      // there. Announcing a save that did not happen is what left users
      // in an unbreakable loop with "PSK nicht gefunden".
      const success = savePsk(psk) && pskFileExists()
      if (success) {
        try {
          await execAsync(['notify-send', '-i', 'dialog-password', _("VPN PSK"), _("The PSK was stored securely")])
        } catch { }
        pskStatus.set_text(format(_("✓ PSK present in {path}"), { path: PSK_DISPLAY_PATH }))
        pskStatus.remove_css_class("warning")
        pskStatus.add_css_class("success")
        // Clear and hide after save
        pskEntry.set_text("")
        pskEntry.set_visibility(false)
        pskVisible = false
        const icon = pskVisibilityBtn.get_child() as Gtk.Label
        icon.set_text(ICONS.eye)
      } else {
        try {
          await execAsync(['notify-send', '-u', 'critical', '-i', 'dialog-error',
                           _("VPN PSK"), _("The PSK could not be saved")])
        } catch { }
        pskStatus.set_text(_("⚠ The PSK could not be saved"))
        pskStatus.remove_css_class("success")
        pskStatus.add_css_class("warning")
      }
    }
  })
  pskSaveBtn.set_tooltip_text(_("Save PSK"))

  pskRow.append(pskEntry)
  pskRow.append(pskVisibilityBtn)
  pskRow.append(pskSaveBtn)

  // Check PSK status on load
  if (pskFileExists()) {
    pskStatus.set_text(format(_("✓ PSK present in {path}"), { path: PSK_DISPLAY_PATH }))
    pskStatus.add_css_class("success")
  } else {
    pskStatus.set_text(_("⚠ No PSK saved - please enter one and save it"))
    pskStatus.add_css_class("warning")
  }

  pskSection.append(pskLabel)
  pskSection.append(pskRow)
  pskSection.append(pskStatus)
  box.append(pskSection)

  return box
}

