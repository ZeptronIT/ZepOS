  ], currentSettings.phase2.mode, (val) => { currentSettings.phase2.mode = val }))

  box.append(createNumericField(_("Replay window"), currentSettings.phase2.replay_window, (val) => { currentSettings.phase2.replay_window = val }))
  box.append(createEntryField(_("ESP proposals"), currentSettings.phase2.esp_proposals, (val) => { currentSettings.phase2.esp_proposals = val }))

  // Routed networks. One CIDR per row - the generator derives both the
  // child security association and the route from it, and names the
  // child after the connection and its position in this list. The origin
  // asked for a name alongside every CIDR, which meant a name could
  // disagree with the connection it belonged to and a network could be
  // tunnelled under a child nothing ever initiated.
  const netHint = new Gtk.Label({
    label: _("Without at least one network the tunnel comes up and carries no traffic."),
    xalign: 0,
    wrap: true
  })
  netHint.add_css_class("vpn-psk-status")
  box.append(netHint)

  // Ueber buildStringList und nicht mehr als eigene rebuild-Schleife -
  // dieselbe Liste stand in dieser Datei zweimal und braucht sie die
  // zweite Bauart noch zweimal. Siehe die Begruendung dort.
  //
  // Der Volltunnel-Hinweis gilt HIER genauso wie bei den zwei anderen
  // Bauarten: `routed_networks` kann alles enthalten, und ein IPsec-
  // Teiltunnel ist eine Gewohnheit dieses Projekts, keine Eigenschaft
  // von IPsec. Eine Regel fuer alle drei, nicht drei Sonderfaelle.
  box.append(buildStringList(
    _("Routed networks"), _("Add network"), _("e.g. 10.0.0.0/8"),
    () => currentSettings.routed_networks,
    (values) => { currentSettings.routed_networks = values },
    "vpn-section-title",
    () => fullTunnelNote(fullTunnelFamilies(currentSettings.routed_networks))))

  return box
}

