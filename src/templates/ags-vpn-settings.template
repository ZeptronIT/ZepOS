//     darin.
//     `hint` kam am 22.08.2026 dazu und ist der Grund, aus dem der
//     Volltunnel-Hinweis MITLAEUFT statt einmal aufzublitzen: er wird
//     nach jedem Schreiben neu erfragt - beim Tippen, beim Hinzufuegen
//     und beim Loeschen. Er gibt eine Zeichenkette zurueck oder "";
//     leer heisst, die Zeile verschwindet ganz, statt als leerer
//     Absatz stehen zu bleiben.
//
//     Er bekommt KEIN Argument, obwohl die Liste eines waere: die
//     WireGuard-Gegenstellen fuehren VIER Listen, und ob der Tunnel
//     alles umleitet, entscheidet ihre Vereinigung - zwei Gegenstellen
//     mit je einer Haelfte sind zusammen ein Volltunnel, den keine von
//     beiden allein waere. Was gerechnet wird, entscheidet deshalb die
//     Aufrufstelle und nicht dieses Bauteil.
function buildStringList(title: string, addTooltip: string, placeholder: string,
                         read: () => string[], write: (values: string[]) => void,
                         titleClass: string = "vpn-field-label",
                         hint?: () => string): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6 })

  const header = new Gtk.Box({ spacing: 8 })
  const label = new Gtk.Label({ label: title, xalign: 0, hexpand: true })
  label.add_css_class(titleClass)

  const note = new Gtk.Label({ label: "", xalign: 0, wrap: true })
  note.add_css_class("vpn-psk-status")
  note.add_css_class("warning")

  function refreshNote() {
    const text = hint ? hint() : ""
    note.set_text(text)
    note.set_visible(text !== "")
  }

  // Rolle umrandet: eine wirkliche Handlung (Eintrag hinzufuegen),
  // keine Navigation. `rebuild` ist eine Funktionsdeklaration und damit
  // gehoben - der Aufruf hier loest erst beim Klick auf.
  const addBtn = zepButton(ICONS.add, "umrandet", () => {
    write([...read(), ""])
    rebuild()
  })
  addBtn.set_tooltip_text(addTooltip)

  header.append(label)
  header.append(addBtn)

  const list = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6 })
  list.add_css_class("vpn-list-container")

  function rebuild() {
    clearBox(list)
    const values = read()
    for (let i = 0; i < values.length; i++) {
      const idx = i
      const item = new Gtk.Box({ spacing: 8 })
      item.add_css_class("vpn-list-item")

      const entry = new Gtk.Entry({ text: values[idx], hexpand: true,
                                    placeholder_text: placeholder })
      entry.add_css_class("vpn-entry")
      entry.connect("changed", () => {
        const current = read()
        current[idx] = entry.get_text()
        write(current)
        // Bei JEDEM Zeichen und nicht erst beim Verlassen des Feldes:
        // wer `0.0.0.0/0` herausnimmt, soll den Hinweis verschwinden
        // sehen, waehrend er es tut.
        refreshNote()
      })

      // Rolle kritisch, wie vom Auftrag verlangt (loeschen ist zerstoerend).
      const deleteBtn = zepButton(ICONS.delete, "kritisch", () => {
        const current = read()
        current.splice(idx, 1)
        write(current)
        rebuild()
      })

      item.append(entry)
      item.append(deleteBtn)
      list.append(item)
    }
    refreshNote()
  }

  rebuild()
  box.append(header)
  box.append(list)
  box.append(note)
  return box
}

// Create a checkbox
function createCheckbox(label: string, checked: boolean, onChange: (checked: boolean) => void): Gtk.Button {
  const btn = new Gtk.Button({ can_focus: false })
  btn.set_child(new Gtk.Label({ label: `${checked ? "☑" : "☐"} ${label}` }))
  btn.add_css_class("vpn-checkbox")
  if (checked) btn.add_css_class("checked")

  let isChecked = checked
  btn.connect("clicked", () => {
    isChecked = !isChecked
    btn.set_child(new Gtk.Label({ label: `${isChecked ? "☑" : "☐"} ${label}` }))
    if (isChecked) {
      btn.add_css_class("checked")
    } else {
      btn.remove_css_class("checked")
    }
    onChange(isChecked)
  })

  return btn
}

