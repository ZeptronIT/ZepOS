// Die drei Bauarten. Als Zeichenketten-Vereinigung und nicht als
// `string`, damit ein Tippfehler beim Uebersetzen auffaellt und nicht
// erst an einem Fenster, das leere Reiter zeigt.
type VpnKind = "ipsec" | "wireguard" | "openvpn"

// OpenVPN, seit dem 22.08.2026. Einundzwanzig Werte, und KEINER davon
// ist ein Geheimnis: die fuenf `*_file` tragen DATEINAMEN unter
// ~/.config/openvpn (0600, Verzeichnis 0700), das Passwort steht
// ueberhaupt nicht auf der Platte - es wird auf der VPN-Seite getippt
// und geht von dort ueber eine 0600-Datei im Laufzeitverzeichnis an
// `nmcli ... passwd-file`.
interface OvpnSettings {
  remote: string
  port: number
  proto: string
  dev: string
  dev_type: string
  // "tls" (nur Zertifikate) | "password" (nur Anmeldung) |
  // "password-tls" (beides). Daran haengt, ob die VPN-Seite
  // Anmeldefelder zeigt - und ob die Verbindung ohne Zutun
  // wiederhergestellt werden kann, siehe den Hinweis im Reiter
  // "Allgemein".
  connection_type: string
  username: string
  remote_cert_tls: string
  cipher: string
  auth: string
  comp_lzo: string
  tunnel_mtu: number
  reneg_seconds: number
  ta_dir: string
  ca_file: string
  cert_file: string
  key_file: string
  tls_auth_file: string
  tls_crypt_file: string
  pkcs12_file: string
  // Direktiven ohne eigenes Bedienelement, aus einer ERLAUBNISLISTE in
  // src/vpn.py (OVPN_CARRIED_EXTRA) - nie eine Durchreiche. Sie werden
  // hier nur GEZEIGT, nicht bearbeitet: achtzehn weitere Felder waeren
  // genau die Breitenrechnung, die dieses Fenster schon einmal um 42
  // Punkte gesprengt hat.
  extra: string[][]
}

interface WgPeer {
  public_key: string
  endpoint: string
  // Dieselbe Sache wie `routed_networks` auf der IPsec-Seite, nur wie
  // WireGuard sie nennt - und deshalb mit DEMSELBEN Bauteil bedient
  // (siehe buildWgPeersTab unten), nicht mit einem zweiten.
  allowed_ips: string[]
  keepalive: number
  // Ein DATEINAME, nie der Schluessel. Siehe den Kommentar bei
  // WgSettings.private_key_file.
  preshared_key_file: string
}

interface WgSettings {
  addresses: string[]
  listen_port: number
  mtu: number
  // DER DATEINAME UNTER ~/.config/wireguard, NICHT DER SCHLUESSEL.
  //
  // Dieses Fenster schreibt seinen Abschnitt nach user-settings.json,
  // und diese Datei liest der Stil-Erzeuger, gibt `zepos-settings` aus
  // und fasst der Doktor an. Ein privater Schluessel darin waere ein
  // Geheimnis in vier Programmen. Er liegt stattdessen einzeln unter
  // ~/.config/wireguard, 0600 vom ersten Byte, Verzeichnis 0700 -
  // geschrieben von src/vpn.py::write_wireguard_secret(), aus demselben
  // Grund, aus dem savePsk() weiter unten Gio.FileCreateFlags.PRIVATE
  // benutzt statt open()+chmod.
  private_key_file: string
  // Der EIGENE oeffentliche Schluessel. Er ist kein Geheimnis - er ist
  // genau das, was der Nutzer der Gegenstelle schicken muss - und steht
  // deshalb als einziger Schluesselwert in der Einstellungsdatei.
  public_key: string
  peers: WgPeer[]
}

