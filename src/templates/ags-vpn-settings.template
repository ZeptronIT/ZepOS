//   * es aendert sich KEINE Vorgabe. Was in der Datei stand, steht nach
//     dem Einlesen unveraendert in der Liste.
//   * die Liste ist BEARBEITBAR - das war sie fuer IPsec und WireGuard
//     schon (buildStringList weiter unten), fuer OpenVPN nicht: dort
//     wurde sie beim Einlesen gefuellt und in keinem Reiter gezeigt.
//     Sie steht seit heute im Reiter "Verbindung".
//   * der Hinweis LAEUFT MIT. Nimmt der Nutzer das Nullnetz heraus,
//     verschwindet er; traegt er es wieder ein, kommt er zurueck. Ein
//     Hinweis, der nur beim Einlesen einmal aufblitzt, beschreibt einen
//     Zustand von damals.
//
// WARUM DIE RECHNUNG HIER STEHT, OBWOHL SIE IN src/vpn.py SCHON STEHT
//     Sonst gilt in dieser Datei die Regel des Einlesers: die Arbeit
//     macht src/vpn.py, das Fenster ruft. Hier geht das nicht - der
//     Hinweis muss bei JEDEM Tastendruck stimmen, und ein Kindprozess je
//     Tastendruck waere ein Kindprozess je Tastendruck.
//
//     Damit die beiden Fassungen nicht auseinanderlaufen, misst
//     tests/src/test_vpn_volltunnel.py sie GEGENEINANDER: es schneidet
//     den Block zwischen den zwei Marken unten heraus, uebersetzt ihn
//     mit `ags bundle`, laesst ihn unter gjs ueber dieselbe Tabelle
//     laufen wie die Python-Fassung und vergleicht Antwort fuer Antwort.
//     Eine Kopie, die nachgemessen wird, ist etwas anderes als eine
//     Kopie, die man findet, wenn sie schon falsch ist.
//
// WARUM GERECHNET UND NICHT VERGLICHEN
//     "Deckt alles ab" hat mehr als eine Schreibweise: 0.0.0.0/1 +
//     128.0.0.0/1 decken zusammen dasselbe ab wie 0.0.0.0/0, und
//     Anbieter schreiben genau so, um die Standardroute zu
//     UEBERSTIMMEN, ohne sie zu loeschen (openvpn(8) fuehrt das unter
//     der Fahne `def1`). Ein `indexOf("0.0.0.0/0")` sieht davon nichts.
//     Gerechnet wird deshalb ueber Intervalle: jedes Netz wird zu
//     [Anfang, Ende], die Intervalle werden sortiert und
//     zusammengeschoben, und gedeckt ist die Familie, wenn dabei genau
//     ein Stueck von der ersten bis zur letzten Adresse herauskommt.

// >>> VOLLTUNNEL-RECHNUNG
const FULL_TUNNEL_V4 = "ipv4"
const FULL_TUNNEL_V6 = "ipv6"

function parseIpv4(text: string): bigint | null {
  const parts = text.split(".")
  if (parts.length !== 4) return null
  let value = 0n
  for (const part of parts) {
    if (!/^[0-9]{1,3}$/.test(part)) return null
    const octet = Number(part)
    if (octet > 255) return null
    value = (value << 8n) | BigInt(octet)
  }
  return value
}

function parseIpv6(text: string): bigint | null {
  const halves = text.split("::")
  if (halves.length > 2) return null
  const stuecke = (piece: string): string[] => piece === "" ? [] : piece.split(":")
  let left = stuecke(halves[0])
  const right = halves.length === 2 ? stuecke(halves[1]) : []
  // Eine abschliessende IPv4-Schreibweise ("::ffff:203.0.113.1") ist
  // eine gueltige Adresse und wird zu den letzten ZWEI Gruppen.
  const tail = right.length ? right : left
  if (tail.length && tail[tail.length - 1].indexOf(".") >= 0) {
    const four = parseIpv4(tail[tail.length - 1])
    if (four === null) return null
    tail.pop()
    tail.push(((four >> 16n) & 0xffffn).toString(16))
    tail.push((four & 0xffffn).toString(16))
  }
  if (halves.length === 2) {
    const missing = 8 - (left.length + right.length)
    if (missing < 0) return null
    left = left.concat(new Array(missing).fill("0")).concat(right)
  } else if (left.length !== 8) {
    return null
  }
  let value = 0n
  for (const group of left) {
    if (!/^[0-9a-fA-F]{1,4}$/.test(group)) return null
    value = (value << 16n) | BigInt(parseInt(group, 16))
  }
  return value
}

// [Familie, erste Adresse, letzte Adresse] - oder null, wenn die Zeile
// kein Netz ist. Eine Zeile, die keines ist, deckt auch keines ab; sie
// zu MELDEN ist Sache des Einlesers, der Datei und Zeilennummer hat.
function cidrSpan(text: string): [number, bigint, bigint] | null {
  const value = text.trim()
  if (!value) return null
  const slash = value.indexOf("/")
  const head = slash < 0 ? value : value.slice(0, slash)
  const rest = slash < 0 ? "" : value.slice(slash + 1)
  const istV6 = head.indexOf(":") >= 0
  const bits = istV6 ? 128 : 32
  const address = istV6 ? parseIpv6(head) : parseIpv4(head)
  if (address === null) return null
  let length = bits
  if (slash >= 0) {
    if (!/^[0-9]{1,3}$/.test(rest)) return null
    length = Number(rest)
    if (length > bits) return null
  }
  const size = 1n << BigInt(bits - length)
  // Wirtsbits weg, wie ipaddress.ip_network(..., strict=False):
  // `192.0.2.9/24` ist das Netz 192.0.2.0/24 und kein Fehler.
  const start = (address / size) * size
  return [istV6 ? 6 : 4, start, start + size - 1n]
}

function coversEverything(spans: [bigint, bigint][], bits: number): boolean {
  if (!spans.length) return false
  const sorted = spans.slice().sort(
    (a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0))
  let reach = -1n
  for (const [start, end] of sorted) {
    // Eine Luecke: was danach kommt, kann sie nicht mehr fuellen, denn
    // sortiert ist nach dem Anfang.
    if (start > reach + 1n) return false
    if (end > reach) reach = end
  }
  return reach === (1n << BigInt(bits)) - 1n
}

function fullTunnelFamilies(values: string[]): string[] {
  const v4: [bigint, bigint][] = []
  const v6: [bigint, bigint][] = []
  for (const value of values ?? []) {
    const span = cidrSpan(String(value))
    if (span === null) continue
    ;(span[0] === 6 ? v6 : v4).push([span[1], span[2]])
  }
  const families: string[] = []
  if (coversEverything(v4, 32)) families.push(FULL_TUNNEL_V4)
  if (coversEverything(v6, 128)) families.push(FULL_TUNNEL_V6)
  return families
}
// <<< VOLLTUNNEL-RECHNUNG

// Der Satz zur Antwort. KEIN Fehler und keine Ablehnung - ein
// Volltunnel ist eine gueltige, oft gewollte Einstellung, und bei einem
// Anbieter-VPN ist er der ganze Zweck. Er traegt trotzdem die
// Warnfarbe des Bausatzes (.vpn-psk-status.warning, gelb), weil der
// Unterschied zwischen Firmentunnel und Anbietertunnel derjenige ist,
// den der Nutzer heute nur an der Geschwindigkeit merkt.
//
// Drei Saetze und nicht einer mit eingesetzter Familie: "IPv4 und IPv6"
// waere ein zusammengesetztes Stueck Sprache, dessen "und" kein
// Uebersetzer erreicht.
function fullTunnelNote(families: string[]): string {
  if (families.length === 2) {
    return _("Full tunnel: these networks cover the entire IPv4 and IPv6 address space. All traffic runs through the VPN - nothing goes past it.")
  }
  if (families.length === 1 && families[0] === FULL_TUNNEL_V6) {
    return _("Full tunnel: these networks cover the entire IPv6 address space. All IPv6 traffic runs through the VPN.")
  }
  if (families.length === 1) {
    return _("Full tunnel: these networks cover the entire IPv4 address space. All IPv4 traffic runs through the VPN.")
  }
  return ""
}

// Derselbe Befund im AUGENBLICK DES EINLESENS, angehaengt an die
// Statuszeile - beide Bauarten benutzen ihn, damit der Satz nicht
// zweimal dasteht. Er sagt AUSDRUECKLICH, dass nichts veraendert wurde:
// die Datei bestimmt, was gilt, und der Nutzer kann es danach in den
// Reitern aendern. Ein Einleser, der aus einem Volltunnel still einen
// Teiltunnel machte, waere schlimmer als gar keine Warnung.
function importFullTunnelNote(families: string[]): string {
  if (!families.length) return ""
  return " " + _("This configuration routes all traffic through the tunnel. It was taken over exactly as the file has it - the networks can be changed in the tabs.")
}

