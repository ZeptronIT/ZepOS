// Function to rebuild tabs (called when settings are loaded)
function rebuildTabs() {
  if (!scrollContent) return

  // Remove old tabs
  let child = scrollContent.get_first_child()
  while (child) {
    const next = child.get_next_sibling()
    scrollContent.remove(child)
    child = next
  }

  // Rebuild tabs with current settings
  generalBox = buildGeneralTab()
  phase1Box = buildPhase1Tab()
  phase1Box.set_visible(false)
  phase2Box = buildPhase2Tab()
  phase2Box.set_visible(false)
  dnsBox = buildDnsTab()
  dnsBox.set_visible(false)

  scrollContent.append(generalBox)
  scrollContent.append(phase1Box)
  scrollContent.append(phase2Box)
  scrollContent.append(dnsBox)

  // Reset to general tab
  switchTab("general")
}

// Deep merge helper
function deepMerge(target: any, source: any): any {
  const result = { ...target }
  for (const key in source) {
    if (source[key] !== null && typeof source[key] === 'object' && !Array.isArray(source[key])) {
      result[key] = deepMerge(target[key] || {}, source[key])
    } else if (source[key] !== undefined) {
      result[key] = source[key]
    }
  }
  return result
}

// Load settings from file
function loadSettings(): VpnSettings {
  try {
    const [ok, contents] = GLib.file_get_contents(SETTINGS_FILE)
    if (ok && contents) {
      const data = JSON.parse(new TextDecoder().decode(contents))
      if (data.vpn) {
        // Deep merge to preserve nested objects (phase1, phase2, dns)
        return deepMerge(defaultSettings(), data.vpn)
      }
    }
  } catch (e) {
    console.error("Failed to load VPN settings:", e)
  }
  return defaultSettings()
}

// Save settings to file (closeFn passed in to allow closing overlay)
let closeFnModule: (() => void) | null = null

async function saveSettings() {
  // Handed to settings.py rather than written here.
  //
  // This dialog owns ONE section of a document that also holds the
  // colours, the widget sizes, the weather location and the installer's
  // plugin choice. It used to read that document inside a `catch {}`
  // that fell back to an empty object and then wrote the result back -
  // so pressing "save" over a file it could not parse replaced the whole
  // document with a lone vpn section and deleted every other setting on
  // the machine. It stated no schema_version either, so a file first
  // created here made zepos-settings refuse to run at all.
  //
  // settings.py keeps the sections this dialog does not own, states the
  // version, writes at 0600 through a rename rather than truncating the
  // file, and REFUSES a document it cannot parse instead of replacing
  // it. A second implementation of that in GJS is what produced both
  // failures above, so there is not one.
  try {
    await execAsync([...SETTINGS_WRITER, JSON.stringify({ vpn: currentSettings })])
  } catch (e) {
    // Reported, not swallowed. The dialog closed on a save that never
    // happened, and the next thing the user saw was a tunnel dialling
    // the old server.
    console.error("Failed to save VPN settings:", e)
    try {
      // Der Fehler als WERT und nicht im Satz: ein Template-Literal mit
      // ${...} liest xgettext gar nicht aus, diese Meldung bekaeme also
      // keinen Katalogeintrag und bliebe still deutsch. 17.08.2026
      await execAsync(['notify-send', '-i', 'dialog-error', _("VPN settings"),
                       format(_("Not saved: {error}"), { error: String(e) })])
    } catch { }
    return
  }

  try {
    // Regenerate every script that carries a substituted VPN value.
    //
    // All three are SNAPSHOTS: what was substituted when they were
    // generated is what they use until something regenerates them. Only
    // the connect script was refreshed here, so renaming the connection
    // left vpn-control.sh terminating a name that no longer existed -
    // reporting a successful disconnect over a tunnel that was still up
    // - and left vpn-watcher.sh re-initiating children by their old
    // names, so half-up recovery silently never fired.
    //
    // The AGS widgets are deliberately absent: they re-read this file
    // every time they are shown, so their substituted values are
    // fallbacks for an absent key, not a snapshot that can go stale.
    for (const target of ["-vpn-connect-script", "-vpn-control-config",
                          "-vpn-watcher-config"]) {
      try {
        // As an argument list, not as one string: execAsync(string)
        // splits with GLib.shell_parse_argv, so a system root whose path
        // contains a space would arrive as two arguments and the
        // generator would be called with a path that is not one.
        await execAsync([`${ZEPOS_SYSTEM_ROOT}/generate_config.sh`, target])
      } catch (e) {
        console.error(`Failed to regenerate ${target}:`, e)
      }
    }

    // Send notification
    try {
      await execAsync(['notify-send', '-i', 'network-vpn', _("VPN settings"), _("Settings saved")])
    } catch { }

    // Close settings and open VPN connection window
    closeFnModule?.()
    await execAsync("ags request vpn")
  } catch (e) {
    console.error("Failed after saving VPN settings:", e)
  }
}

