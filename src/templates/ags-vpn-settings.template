interface TabSpec { id: string; label: string; build: () => Gtk.Box }

// WELCHE REITER ES GIBT, HAENGT AN DER BAUART - UND DIE LEISTE BLEIBT
// BEI VIER KNOEPFEN
//     Das ist keine Sparsamkeit, sondern die Bedingung der
//     Breitenrechnung im Dateikopf: ein fuenfter Reiter waere eine
//     zweite Rechnung an einer Leiste, die heute nicht die
//     massgebliche ist (massgeblich ist die Fusszeile mit ihren vier
//     Knoepfen). Statt anzuhaengen wird getauscht.
//
//     "Allgemein" und "DNS" tragen beide Bauarten: der Verbindungsname
//     und der Testrechner gelten fuer beide, und WireGuards
//     `DNS = ...` landet in DEMSELBEN DNS-Reiter wie die IPsec-Server -
//     ein zweiter waere derselbe Reiter zweimal.
function tabsForKind(): TabSpec[] {
  if (currentSettings.kind === "wireguard") {
    return [
      { id: "general", label: _("General"), build: buildGeneralTab },
      { id: "wgiface", label: _("Interface"), build: buildWgInterfaceTab },
      { id: "wgpeers", label: _("Peers"), build: buildWgPeersTab },
      { id: "dns", label: _("DNS"), build: buildDnsTab },
    ]
  }
  return [
    { id: "general", label: _("General"), build: buildGeneralTab },
    { id: "phase1", label: _("Phase 1"), build: buildPhase1Tab },
    { id: "phase2", label: _("Phase 2"), build: buildPhase2Tab },
    { id: "dns", label: _("DNS"), build: buildDnsTab },
  ]
}

// Ein Kasten leeren. GTK4 hat kein remove_all(), und die Schleife stand
// vorher zweimal gleich in dieser Datei.
function clearBox(box: Gtk.Box) {
  let child = box.get_first_child()
  while (child) {
    const next = child.get_next_sibling()
    box.remove(child)
    child = next
  }
}

// Function to rebuild tabs (called when settings are loaded and when the
// connection kind changes)
function rebuildTabs() {
  if (!scrollContent || !tabBar) return

  clearBox(scrollContent)
  clearBox(tabBar)
  tabButtons.clear()
  tabBoxes.clear()

  for (const tab of tabsForKind()) {
    // Rolle umrandet je Reiter, siehe Task B (se-tab-btn). ANDERS als
    // dort: der waagerechte Innenabstand von vpn-tab-btn und zep-btn ist
    // NICHT nur rechnerisch gleich, sondern derselbe Platzhalter
    // (STYLE_SPACE_16 auf beiden Seiten in beiden Regeln) - und
    // WIN_WIDTH dieses Fensters haengt (siehe Dateikopf) an der
    // Knopfreihe der Fusszeile, nicht an dieser Leiste. Die Kopplung,
    // die se-tab-btn stehen liess, gilt hier nicht - GEPRUEFT am
    // 18.08.2026, siehe Gruppe-E-Bericht.
    const btn = zepButton(tab.label, "umrandet", () => switchTab(tab.id))
    tabButtons.set(tab.id, btn)
    tabBar.append(btn)

    // ZUERST VERSTECKEN, DANN ANHAENGEN - und das ist keine Kosmetik.
    //
    //     Ein Kasten, der sichtbar in scrollContent haengt, geht in die
    //     Breitenanforderung ein. Wuerden hier alle vier nacheinander
    //     SICHTBAR angehaengt und erst am Ende von switchTab() bis auf
    //     einen versteckt, verlangte die Flaeche zwischendurch die
    //     Breite des BREITESTEN Reiters - und der Waechter der Fabrik
    //     (`notify::upper` in ags-overlay-utils.template) meldete einen
    //     Ueberhang, den es im Ruhezustand gar nicht gibt.
    //
    //     GEMESSEN am 21.08.2026 im verschachtelten Compositor: in
    //     dieser Reihenfolge geschrieben, meldete das Fenster beim
    //     Oeffnen "Inhalt 237px breiter als das Fenster erlaubt";
    //     danach keine Zeile mehr. Die alte Fassung dieser Datei hat
    //     jeden Kasten vor dem Anhaengen versteckt - aus genau diesem
    //     Grund, auch wenn dort nichts dazu stand.
    const box = tab.build()
    box.set_visible(false)
    tabBoxes.set(tab.id, box)
    scrollContent.append(box)
  }

  // Der zuletzt gewaehlte Reiter, WENN ES IHN IN DIESER BAUART NOCH
  // GIBT - sonst zurueck auf "Allgemein". Wer beim Umschalten auf
  // WireGuard gerade auf "Phase 2" stand, laendete sonst auf einem
  // Fenster, dessen Inhalt es nicht mehr gibt.
  switchTab(tabBoxes.has(currentTab) ? currentTab : "general")
}

// Deep merge helper
function deepMerge(target: any, source: any): any {
  const result = { ...target }
  for (const key in source) {
    if (source[key] !== null && typeof source[key] === 'object' && !Array.isArray(source[key])) {
      result[key] = deepMerge(target[key] || {}, source[key])
    } else if (source[key] !== undefined) {
      result[key] = source[key]
    }
  }
  return result
}

// Load settings from file
function loadSettings(): VpnSettings {
  try {
    const [ok, contents] = GLib.file_get_contents(SETTINGS_FILE)
    if (ok && contents) {
      const data = JSON.parse(new TextDecoder().decode(contents))
      if (data.vpn) {
        // Deep merge to preserve nested objects (phase1, phase2, dns)
        return deepMerge(defaultSettings(), data.vpn)
      }
    }
  } catch (e) {
    console.error("Failed to load VPN settings:", e)
  }
  return defaultSettings()
}

// Save settings to file (closeFn passed in to allow closing overlay)
let closeFnModule: (() => void) | null = null

async function saveSettings() {
  // Handed to settings.py rather than written here.
  //
  // This dialog owns ONE section of a document that also holds the
  // colours, the widget sizes, the weather location and the installer's
  // plugin choice. It used to read that document inside a `catch {}`
  // that fell back to an empty object and then wrote the result back -
  // so pressing "save" over a file it could not parse replaced the whole
  // document with a lone vpn section and deleted every other setting on
  // the machine. It stated no schema_version either, so a file first
  // created here made zepos-settings refuse to run at all.
  //
  // settings.py keeps the sections this dialog does not own, states the
  // version, writes at 0600 through a rename rather than truncating the
  // file, and REFUSES a document it cannot parse instead of replacing
  // it. A second implementation of that in GJS is what produced both
  // failures above, so there is not one.
  try {
    await execAsync([...SETTINGS_WRITER, JSON.stringify({ vpn: currentSettings })])
  } catch (e) {
    // Reported, not swallowed. The dialog closed on a save that never
    // happened, and the next thing the user saw was a tunnel dialling
    // the old server.
    console.error("Failed to save VPN settings:", e)
    try {
      // Der Fehler als WERT und nicht im Satz: ein Template-Literal mit
      // ${...} liest xgettext gar nicht aus, diese Meldung bekaeme also
      // keinen Katalogeintrag und bliebe still deutsch. 17.08.2026
      await execAsync(['notify-send', '-i', 'dialog-error', _("VPN settings"),
                       format(_("Not saved: {error}"), { error: String(e) })])
    } catch { }
    return
  }

  try {
    // Regenerate every script that carries a substituted VPN value.
    //
    // All three are SNAPSHOTS: what was substituted when they were
    // generated is what they use until something regenerates them. Only
    // the connect script was refreshed here, so renaming the connection
    // left vpn-control.sh terminating a name that no longer existed -
    // reporting a successful disconnect over a tunnel that was still up
    // - and left vpn-watcher.sh re-initiating children by their old
    // names, so half-up recovery silently never fired.
    //
    // The AGS widgets are deliberately absent: they re-read this file
    // every time they are shown, so their substituted values are
    // fallbacks for an absent key, not a snapshot that can go stale.
    for (const target of ["-vpn-connect-script", "-vpn-control-config",
                          "-vpn-watcher-config"]) {
      try {
        // As an argument list, not as one string: execAsync(string)
        // splits with GLib.shell_parse_argv, so a system root whose path
        // contains a space would arrive as two arguments and the
        // generator would be called with a path that is not one.
        await execAsync([`${ZEPOS_SYSTEM_ROOT}/generate_config.sh`, target])
      } catch (e) {
        console.error(`Failed to regenerate ${target}:`, e)
      }
    }

    // UND FUER WIREGUARD: DIE VERBINDUNG BEI NETWORKMANAGER NACHZIEHEN
    //
    //     Die drei Skripte darueber sind Abzuege der IPsec-Seite. Die
    //     WireGuard-Seite hat kein Skript - ihr Gegenstueck ist das
    //     Verbindungsprofil im NetworkManager, und das ist genauso ein
    //     Abzug: gespeicherte Einstellungen, die niemand nachzieht,
    //     sind ein Zwischenspeicher ohne Verfall. Genau dieser Fehler
    //     hat auf der IPsec-Seite dazu gefuehrt, dass ein umbenannter
    //     Tunnel beim Trennen Erfolg meldete und stehen blieb.
    //
    //     `--wg-apply` schreibt den privaten Schluessel NICHT in eine
    //     Befehlszeile: es legt eine 0600-Datei im Laufzeitverzeichnis
    //     ab, laesst NetworkManager sie lesen und loescht sie wieder.
    //     Die Begruendung steht im Kopf des WireGuard-Teils von
    //     src/vpn.py.
    if (currentSettings.kind === "wireguard") {
      try {
        await execAsync([...VPN_TOOL, "--wg-apply"])
      } catch (e) {
        console.error("Failed to apply the WireGuard connection:", e)
        try {
          await execAsync(['notify-send', '-u', 'critical', '-i', 'dialog-error',
                           _("WireGuard"),
                           format(_("The connection was not set up: {error}"),
                                  { error: String(e) })])
        } catch { }
      }
    }

    // Send notification
    try {
      await execAsync(['notify-send', '-i', 'network-vpn', _("VPN settings"), _("Settings saved")])
    } catch { }

    // Close settings and open VPN connection window
    closeFnModule?.()
    await execAsync("ags request vpn")
  } catch (e) {
