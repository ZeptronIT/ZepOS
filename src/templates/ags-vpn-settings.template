// A fresh copy every time, nested values included. A shallow spread of
// DEFAULT_VPN_SETTINGS hands out the very same `routed_networks` and
// `dns.servers` arrays the defaults are made of, so the first network
// added after a reset is pushed INTO the defaults and stays there for
// the lifetime of the process - resetting a second time then restores
// the edits instead of clearing them.
function defaultSettings(): VpnSettings {
  return JSON.parse(JSON.stringify(DEFAULT_VPN_SETTINGS))
}

