// Create a labeled entry field
function createEntryField(label: string, value: string, onChange: (text: string) => void): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
  box.add_css_class("vpn-field")

  const labelWidget = new Gtk.Label({ label, xalign: 0 })
  labelWidget.add_css_class("vpn-field-label")

  const entryRow = new Gtk.Box({ spacing: 0 })
  entryRow.add_css_class("vpn-entry-row")

  const entry = new Gtk.Entry({ hexpand: true, text: value })
  entry.add_css_class("vpn-entry")
  entry.connect("changed", () => onChange(entry.get_text()))

  entryRow.append(entry)
  box.append(labelWidget)
  box.append(entryRow)

  return box
}

// Create a numeric entry field
function createNumericField(label: string, value: number, onChange: (num: number) => void): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
  box.add_css_class("vpn-field")

  const labelWidget = new Gtk.Label({ label, xalign: 0 })
  labelWidget.add_css_class("vpn-field-label")

  const entryRow = new Gtk.Box({ spacing: 0 })
  entryRow.add_css_class("vpn-entry-row")

  const entry = new Gtk.Entry({ hexpand: true, text: value.toString() })
  entry.add_css_class("vpn-entry")
  entry.connect("changed", () => {
    const num = parseInt(entry.get_text())
    if (!isNaN(num)) onChange(num)
  })

  entryRow.append(entry)
  box.append(labelWidget)
  box.append(entryRow)

  return box
}

// Create a toggle button group
function createToggleGroup(label: string, options: { label: string; value: any }[], currentValue: any, onChange: (value: any) => void): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })

  const labelWidget = new Gtk.Label({ label, xalign: 0 })
  labelWidget.add_css_class("vpn-field-label")

  const toggleBox = new Gtk.Box({ spacing: 4 })
  toggleBox.add_css_class("vpn-toggle-group")

  const buttons: Gtk.Button[] = []

  for (const opt of options) {
    const btn = new Gtk.Button({ label: opt.label, can_focus: false })
    btn.add_css_class("vpn-toggle-btn")
    if (opt.value === currentValue) btn.add_css_class("active")

    btn.connect("clicked", () => {
      for (const b of buttons) b.remove_css_class("active")
      btn.add_css_class("active")
      onChange(opt.value)
    })

    buttons.push(btn)
    toggleBox.append(btn)
  }

  box.append(labelWidget)
  box.append(toggleBox)

  return box
}

// Create a checkbox
function createCheckbox(label: string, checked: boolean, onChange: (checked: boolean) => void): Gtk.Button {
  const btn = new Gtk.Button({ can_focus: false })
  btn.set_child(new Gtk.Label({ label: `${checked ? "☑" : "☐"} ${label}` }))
  btn.add_css_class("vpn-checkbox")
  if (checked) btn.add_css_class("checked")

  let isChecked = checked
  btn.connect("clicked", () => {
    isChecked = !isChecked
    btn.set_child(new Gtk.Label({ label: `${isChecked ? "☑" : "☐"} ${label}` }))
    if (isChecked) {
      btn.add_css_class("checked")
    } else {
      btn.remove_css_class("checked")
    }
    onChange(isChecked)
  })

  return btn
}

// Build General Tab
function buildGeneralTab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })

  const sectionTitle = new Gtk.Label({ label: _("Connection settings"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  box.append(createEntryField(_("VPN server"), currentSettings.server, (val) => { currentSettings.server = val }))
  box.append(createEntryField(_("Connection name"), currentSettings.connection_name, (val) => { currentSettings.connection_name = val }))
  box.append(createEntryField(_("Default username"), currentSettings.username, (val) => { currentSettings.username = val }))
  // Optional. Without it an established tunnel that routes nothing looks
  // exactly like a working one, from the bar and from this dialog alike.
  box.append(createEntryField(_("Test host (optional)"), currentSettings.test_host ?? "", (val) => { currentSettings.test_host = val }))

  // XAuth Toggle
  const xauthRow = new Gtk.Box({ spacing: 12 })
  xauthRow.add_css_class("vpn-field")
  xauthRow.append(createCheckbox(_("Enable XAuth"), currentSettings.xauth_enabled ?? false, (val) => { currentSettings.xauth_enabled = val }))
  box.append(xauthRow)

  // Debug Toggle
  const debugRow = new Gtk.Box({ spacing: 12 })
  debugRow.add_css_class("vpn-field")
  debugRow.append(createCheckbox(_("Show debug terminal"), currentSettings.debug ?? false, (val) => { currentSettings.debug = val }))
  box.append(debugRow)

  // PSK Section (sudo-protected)
  const pskSection = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
  pskSection.add_css_class("vpn-field")

  const pskLabel = new Gtk.Label({ label: _("Pre-shared key"), xalign: 0 })
  pskLabel.add_css_class("vpn-field-label")

  const pskRow = new Gtk.Box({ spacing: 8 })
  pskRow.add_css_class("vpn-entry-row")

  const pskEntry = new Gtk.Entry({ hexpand: true, placeholder_text: _("Enter or show the PSK ..."), visibility: false })
  pskEntry.add_css_class("vpn-entry")

  let pskVisible = false
  const pskVisibilityBtn = new Gtk.Button({ can_focus: false })
  pskVisibilityBtn.add_css_class("vpn-visibility-btn")
  pskVisibilityBtn.set_child(new Gtk.Label({ label: ICONS.eye }))
  pskVisibilityBtn.set_tooltip_text(_("Show PSK"))
  pskVisibilityBtn.connect("clicked", () => {
    if (!pskVisible) {
      // Read straight from the user's own file - no privilege involved
      const psk = loadPsk()
      if (psk) {
        pskEntry.set_text(psk)
        pskEntry.set_visibility(true)
        pskVisible = true
        const icon = pskVisibilityBtn.get_child() as Gtk.Label
        icon.set_text(ICONS.eyeSlash)
      }
    } else {
      pskEntry.set_visibility(false)
      pskVisible = false
      const icon = pskVisibilityBtn.get_child() as Gtk.Label
      icon.set_text(ICONS.eye)
    }
  })

  // Status label showing if PSK exists. Declared before the save
  // button, which now updates it: a save that failed has to change what
  // the user is looking at, not only send a notification.
  const pskStatus = new Gtk.Label({ label: "", xalign: 0 })
  pskStatus.add_css_class("vpn-psk-status")

  const pskSaveBtn = new Gtk.Button({ can_focus: false })
  pskSaveBtn.add_css_class("vpn-save-psk-btn")
  pskSaveBtn.set_child(new Gtk.Label({ label: ICONS.save }))
  pskSaveBtn.set_tooltip_text(_("Save PSK"))
  pskSaveBtn.connect("clicked", async () => {
    const psk = pskEntry.get_text()
    if (psk) {
      // The success message is now sent only if the file is really
      // there. Announcing a save that did not happen is what left users
      // in an unbreakable loop with "PSK nicht gefunden".
      const success = savePsk(psk) && pskFileExists()
      if (success) {
        try {
          await execAsync(['notify-send', '-i', 'dialog-password', _("VPN PSK"), _("The PSK was stored securely")])
        } catch { }
        pskStatus.set_text(format(_("✓ PSK present in {path}"), { path: PSK_DISPLAY_PATH }))
        pskStatus.remove_css_class("warning")
        pskStatus.add_css_class("success")
        // Clear and hide after save
        pskEntry.set_text("")
        pskEntry.set_visibility(false)
        pskVisible = false
        const icon = pskVisibilityBtn.get_child() as Gtk.Label
        icon.set_text(ICONS.eye)
      } else {
        try {
          await execAsync(['notify-send', '-u', 'critical', '-i', 'dialog-error',
                           _("VPN PSK"), _("The PSK could not be saved")])
        } catch { }
        pskStatus.set_text(_("⚠ The PSK could not be saved"))
        pskStatus.remove_css_class("success")
        pskStatus.add_css_class("warning")
      }
    }
  })

  pskRow.append(pskEntry)
  pskRow.append(pskVisibilityBtn)
  pskRow.append(pskSaveBtn)

  // Check PSK status on load
  if (pskFileExists()) {
    pskStatus.set_text(format(_("✓ PSK present in {path}"), { path: PSK_DISPLAY_PATH }))
    pskStatus.add_css_class("success")
  } else {
    pskStatus.set_text(_("⚠ No PSK saved - please enter one and save it"))
    pskStatus.add_css_class("warning")
  }

  pskSection.append(pskLabel)
  pskSection.append(pskRow)
  pskSection.append(pskStatus)
  box.append(pskSection)

  return box
}

// Build Phase 1 Tab
function buildPhase1Tab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })

  const sectionTitle = new Gtk.Label({ label: _("IKE phase 1 settings"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  // Aggressive/Main mode toggle (only visible for IKEv1)
  const aggressiveToggle = createToggleGroup(_("Mode"), [
    { label: _("Aggressive"), value: true },
    { label: _("Main"), value: false }
  ], currentSettings.phase1.aggressive, (val) => { currentSettings.phase1.aggressive = val })
  aggressiveToggle.set_visible(currentSettings.phase1.version === 1)

  box.append(createToggleGroup(_("IKE version"), [
    { label: _("IKEv1"), value: 1 },
    { label: _("IKEv2"), value: 2 }
  ], currentSettings.phase1.version, (val) => {
    currentSettings.phase1.version = val
    aggressiveToggle.set_visible(val === 1)
  }))

  box.append(aggressiveToggle)

  box.append(createEntryField(_("IKE proposals"), currentSettings.phase1.proposals, (val) => { currentSettings.phase1.proposals = val }))
  box.append(createNumericField(_("Key lifetime (seconds)"), currentSettings.phase1.keylife, (val) => { currentSettings.phase1.keylife = val }))
  box.append(createNumericField(_("DPD delay (seconds)"), currentSettings.phase1.dpd_delay, (val) => { currentSettings.phase1.dpd_delay = val }))
  box.append(createNumericField(_("DPD timeout (seconds)"), currentSettings.phase1.dpd_timeout, (val) => { currentSettings.phase1.dpd_timeout = val }))

  const checkboxRow = new Gtk.Box({ spacing: 12 })
  checkboxRow.add_css_class("vpn-checkbox-row")
  checkboxRow.append(createCheckbox(_("NAT encapsulation"), currentSettings.phase1.encap, (val) => { currentSettings.phase1.encap = val }))
  checkboxRow.append(createCheckbox(_("MOBIKE"), currentSettings.phase1.mobike, (val) => { currentSettings.phase1.mobike = val }))
  box.append(checkboxRow)

  return box
}

// Build Phase 2 Tab
function buildPhase2Tab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })

  const sectionTitle = new Gtk.Label({ label: _("ESP phase 2 settings"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  box.append(createNumericField(_("Rekey time (seconds)"), currentSettings.phase2.rekey_time, (val) => { currentSettings.phase2.rekey_time = val }))
  box.append(createNumericField(_("Life time (seconds)"), currentSettings.phase2.life_time, (val) => { currentSettings.phase2.life_time = val }))

  box.append(createToggleGroup(_("Mode"), [
    { label: _("Tunnel"), value: "tunnel" },
    { label: _("Transport"), value: "transport" }
  ], currentSettings.phase2.mode, (val) => { currentSettings.phase2.mode = val }))

  box.append(createNumericField(_("Replay window"), currentSettings.phase2.replay_window, (val) => { currentSettings.phase2.replay_window = val }))
  box.append(createEntryField(_("ESP proposals"), currentSettings.phase2.esp_proposals, (val) => { currentSettings.phase2.esp_proposals = val }))

  // Routed networks. One CIDR per row - the generator derives both the
  // child security association and the route from it, and names the
  // child after the connection and its position in this list. The origin
  // asked for a name alongside every CIDR, which meant a name could
  // disagree with the connection it belonged to and a network could be
  // tunnelled under a child nothing ever initiated.
  const netHeader = new Gtk.Box({ spacing: 8 })
  const netTitle = new Gtk.Label({ label: _("Routed networks"), xalign: 0, hexpand: true })
  netTitle.add_css_class("vpn-section-title")

  const addNetBtn = new Gtk.Button({ can_focus: false })
  addNetBtn.add_css_class("vpn-add-btn")
  addNetBtn.set_child(new Gtk.Label({ label: ICONS.add }))
  addNetBtn.set_tooltip_text(_("Add network"))

  netHeader.append(netTitle)
  netHeader.append(addNetBtn)
  box.append(netHeader)

  const netHint = new Gtk.Label({
    label: _("Without at least one network the tunnel comes up and carries no traffic."),
    xalign: 0,
    wrap: true
  })
  netHint.add_css_class("vpn-psk-status")
  box.append(netHint)

  const netList = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6 })
  netList.add_css_class("vpn-list-container")

  function rebuildNetList() {
    // Clear existing items
    let child = netList.get_first_child()
    while (child) {
      const next = child.get_next_sibling()
      netList.remove(child)
      child = next
    }

    // Rebuild list
    for (let i = 0; i < currentSettings.routed_networks.length; i++) {
      const idx = i
      const network = currentSettings.routed_networks[i]
      const netItem = new Gtk.Box({ spacing: 8 })
      netItem.add_css_class("vpn-list-item")

      const netEntry = new Gtk.Entry({ text: network, hexpand: true, placeholder_text: _("e.g. 10.0.0.0/8") })
      netEntry.add_css_class("vpn-entry")
      netEntry.connect("changed", () => {
        currentSettings.routed_networks[idx] = netEntry.get_text()
      })

      const deleteBtn = new Gtk.Button({ can_focus: false })
      deleteBtn.add_css_class("vpn-delete-btn")
      deleteBtn.set_child(new Gtk.Label({ label: ICONS.delete }))
      deleteBtn.connect("clicked", () => {
        currentSettings.routed_networks.splice(idx, 1)
        rebuildNetList()
      })

      netItem.append(netEntry)
      netItem.append(deleteBtn)
      netList.append(netItem)
    }
  }

  addNetBtn.connect("clicked", () => {
    currentSettings.routed_networks.push("")
    rebuildNetList()
  })

  rebuildNetList()
  box.append(netList)

  return box
}

// Build DNS Tab
function buildDnsTab(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })

  const sectionTitle = new Gtk.Label({ label: _("DNS settings"), xalign: 0 })
  sectionTitle.add_css_class("vpn-section-title")
  box.append(sectionTitle)

  box.append(createEntryField(_("Search domain"), currentSettings.dns.search_domain, (val) => { currentSettings.dns.search_domain = val }))

  // DNS Server Header with Add button
  const dnsHeader = new Gtk.Box({ spacing: 8 })
  const dnsTitle = new Gtk.Label({ label: _("DNS servers"), xalign: 0, hexpand: true })
  dnsTitle.add_css_class("vpn-field-label")

  const addDnsBtn = new Gtk.Button({ can_focus: false })
  addDnsBtn.add_css_class("vpn-add-btn")
  addDnsBtn.set_child(new Gtk.Label({ label: ICONS.add }))
  addDnsBtn.set_tooltip_text(_("Add DNS server"))

  dnsHeader.append(dnsTitle)
  dnsHeader.append(addDnsBtn)
  box.append(dnsHeader)

  const dnsList = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6 })
  dnsList.add_css_class("vpn-list-container")

  function rebuildDnsList() {
    // Clear existing items
    let child = dnsList.get_first_child()
    while (child) {
      const next = child.get_next_sibling()
      dnsList.remove(child)
      child = next
    }

    // Rebuild list
    for (let i = 0; i < currentSettings.dns.servers.length; i++) {
      const idx = i
      const server = currentSettings.dns.servers[i]
      const dnsItem = new Gtk.Box({ spacing: 8 })
      dnsItem.add_css_class("vpn-list-item")

      const dnsEntry = new Gtk.Entry({ text: server, hexpand: true, placeholder_text: _("IP address ...") })
      dnsEntry.add_css_class("vpn-entry")
      dnsEntry.connect("changed", () => {
        currentSettings.dns.servers[idx] = dnsEntry.get_text()
      })

      const deleteBtn = new Gtk.Button({ can_focus: false })
      deleteBtn.add_css_class("vpn-delete-btn")
      deleteBtn.set_child(new Gtk.Label({ label: ICONS.delete }))
      deleteBtn.connect("clicked", () => {
        currentSettings.dns.servers.splice(idx, 1)
        rebuildDnsList()
      })

      dnsItem.append(dnsEntry)
      dnsItem.append(deleteBtn)
      dnsList.append(dnsItem)
    }
  }

  addDnsBtn.connect("clicked", () => {
    currentSettings.dns.servers.push("")
    rebuildDnsList()
  })

  rebuildDnsList()
  box.append(dnsList)

  return box
}

// ============================================================================
// MAIN WIDGET
// ============================================================================
export default function VpnSettings(): OverlayWidget {
  let closeFn: (() => void) | null = null

  // Load settings
  currentSettings = loadSettings()

  return createOverlayWindow({
    name: "vpn-settings",
    width: WIN_WIDTH,
    height: 600,
    cssClass: "VpnSettings",
    headerIcon: ICONS.settings,
    headerTitle: _("VPN settings"),
    accentCssClass: "vpn-accent",
    onShow: () => {
      currentSettings = loadSettings()

      // Rebuild tabs with loaded settings
      rebuildTabs()
    },
    buildContent: (_win, closeWindow) => {
      closeFn = closeWindow
      closeFnModule = closeWindow

      // Main container
      const mainBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 0 })
      mainBox.add_css_class("vpn-settings-container")

      // Tab bar
      const tabBar = new Gtk.Box({ spacing: 4 })
      tabBar.add_css_class("vpn-tab-bar")

      const tabs = [
        { id: "general", label: _("General") },
        { id: "phase1", label: _("Phase 1") },
        { id: "phase2", label: _("Phase 2") },
        { id: "dns", label: _("DNS") }
      ]

      for (const tab of tabs) {
        const btn = new Gtk.Button({ label: tab.label, can_focus: false })
        btn.add_css_class("vpn-tab-btn")
        if (tab.id === "general") btn.add_css_class("active")
        btn.connect("clicked", () => switchTab(tab.id))
        tabButtons.set(tab.id, btn)
        tabBar.append(btn)
      }

      // Tab content
      const contentBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL })
      contentBox.add_css_class("vpn-tab-content")

      // Scrolled window for content
      const scroll = new Gtk.ScrolledWindow({
        hscrollbar_policy: Gtk.PolicyType.NEVER,
        vscrollbar_policy: Gtk.PolicyType.AUTOMATIC,
        vexpand: true,
      })

      scrollContent = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL })

      generalBox = buildGeneralTab()
      phase1Box = buildPhase1Tab()
      phase1Box.set_visible(false)
      phase2Box = buildPhase2Tab()
      phase2Box.set_visible(false)
      dnsBox = buildDnsTab()
      dnsBox.set_visible(false)

      scrollContent.append(generalBox)
      scrollContent.append(phase1Box)
      scrollContent.append(phase2Box)
      scrollContent.append(dnsBox)

      scroll.set_child(scrollContent)
      contentBox.append(scroll)

      // Actions
      const actionsBox = new Gtk.Box({ spacing: 12, halign: Gtk.Align.END })
      actionsBox.add_css_class("vpn-settings-actions")

      const resetBtn = new Gtk.Button({ can_focus: false })
      const resetBtnBox = new Gtk.Box({ spacing: 6 })
      resetBtnBox.append(new Gtk.Label({ label: ICONS.reset }))
      resetBtnBox.append(new Gtk.Label({ label: _("Reset") }))
      resetBtn.set_child(resetBtnBox)
      resetBtn.add_css_class("vpn-reset-btn")
      resetBtn.connect("clicked", resetSettings)

      const cancelBtn = new Gtk.Button({ label: _("Cancel"), can_focus: false })
      cancelBtn.add_css_class("vpn-cancel-btn")
      cancelBtn.connect("clicked", () => closeFn?.())

      // Back to VPN button
      const backBtn = new Gtk.Button({ can_focus: false })
      backBtn.add_css_class("vpn-back-btn")
      backBtn.set_child(new Gtk.Label({ label: _("← VPN") }))
      backBtn.set_tooltip_text(_("Back to the VPN connection"))
      backBtn.connect("clicked", () => {
        closeFn?.()
        execAsync("ags request vpn")
      })

      const saveBtn = new Gtk.Button({ can_focus: false })
      const saveBtnBox = new Gtk.Box({ spacing: 6 })
      saveBtnBox.append(new Gtk.Label({ label: ICONS.save }))
      saveBtnBox.append(new Gtk.Label({ label: _("Save") }))
      saveBtn.set_child(saveBtnBox)
      saveBtn.add_css_class("vpn-save-btn")
      saveBtn.connect("clicked", async () => {
        await saveSettings()
        // Note: saveSettings() already closes overlay and opens VPN
      })

      actionsBox.append(backBtn)
      actionsBox.append(resetBtn)
      actionsBox.append(cancelBtn)
      actionsBox.append(saveBtn)

      // Assemble
      mainBox.append(tabBar)
      mainBox.append(contentBox)
      mainBox.append(actionsBox)

      return mainBox
    },
  })
}
