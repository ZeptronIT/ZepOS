interface VpnSettings {
  server: string
  username: string
  connection_name: string
  remember_username: boolean
  // One CIDR per entry. The generator turns each one into a child
  // security association and into the matching route, so a list with
  // four networks needs no change anywhere else - the origin had three
  // named child SAs written out by hand, which is why it had exactly
  // three.
  routed_networks: string[]
  // A host that only answers through the tunnel, used to tell an
  // established tunnel from one that actually carries traffic.
  test_host: string
  phase1: {
    version: number
    aggressive: boolean
    proposals: string
    keylife: number
    dpd_delay: number
    dpd_timeout: number
    encap: boolean
    mobike: boolean
  }
  phase2: {
    rekey_time: number
    life_time: number
    mode: string
    replay_window: number
    esp_proposals: string
  }
  dns: {
    servers: string[]
    search_domain: string
  }
  // Both are read by the connect script and both were already written
  // by this dialog, but neither was declared - so every use of them here
  // was a type error, and the file only compiled because nothing type
  // checked it.
  xauth_enabled: boolean
  debug: boolean
}

// The SSOT stores the booleans below as the strings strongSwan expects,
// so they arrive here as "yes" or "no". Comparing a substituted literal
// directly - `"no" === "yes"` - is a type ERROR, not a false expression:
// TypeScript narrows both sides to their literal types and reports that
// they can never overlap. Passing through a parameter typed as `string`
// widens it back and compiles.
const isYes = (value: string): boolean => value === "yes"

// Every value here is substituted from the same SSOT the generator uses,
// none of it written in by hand.
//
// The connection values are empty until somebody fills them in. The
// origin had its employer's gateway, domain and internal resolvers in
// here, so the dialog opened pre-filled with a company the user had
// never heard of - and saving it once made those values their own.
//
// The phase values used to be a second, different set of defaults. That
// was survivable while the dialog was optional; it is not now that this
// dialog is the only way to configure a VPN at all. Saving without
// touching the Phase 1 tab wrote THESE values over the generator's, so
// an unedited "Save" silently moved the tunnel from IKEv2 main mode to
// IKEv1 aggressive mode with SHA-1 - a downgrade nothing reported and
// the dialog itself did not show, because it was displaying the values
// it was about to write, not the ones in force.
const DEFAULT_VPN_SETTINGS: VpnSettings = {
  server: "{{STYLE_VPN_SERVER}}",
  username: "{{STYLE_VPN_USERNAME}}",
  connection_name: "{{STYLE_VPN_CONNECTION_NAME}}",
  remember_username: true,
  routed_networks: [],
  test_host: "{{STYLE_VPN_TEST_HOST}}",
  phase1: {
    version: {{STYLE_VPN_VERSION}},
    aggressive: isYes("{{STYLE_VPN_AGGRESSIVE}}"),
    proposals: "{{STYLE_VPN_IKE_PROPOSALS}}",
    keylife: {{STYLE_VPN_KEYLIFE}},
    dpd_delay: {{STYLE_VPN_DPD_DELAY}},
    dpd_timeout: {{STYLE_VPN_DPD_TIMEOUT}},
    encap: isYes("{{STYLE_VPN_ENCAP}}"),
    mobike: isYes("{{STYLE_VPN_MOBIKE}}")
  },
  phase2: {
    rekey_time: {{STYLE_VPN_REKEY_TIME}},
    life_time: {{STYLE_VPN_LIFE_TIME}},
    mode: "{{STYLE_VPN_MODE}}",
    replay_window: {{STYLE_VPN_REPLAY_WINDOW}},
    esp_proposals: "{{STYLE_VPN_ESP_PROPOSALS}}"
  },
