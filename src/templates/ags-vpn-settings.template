// Create a toggle button group
function createToggleGroup(label: string, options: { label: string; value: any }[], currentValue: any, onChange: (value: any) => void): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })

  const labelWidget = new Gtk.Label({ label, xalign: 0 })
  labelWidget.add_css_class("vpn-field-label")

  const toggleBox = new Gtk.Box({ spacing: 4 })
  toggleBox.add_css_class("vpn-toggle-group")

  const buttons: Gtk.Button[] = []

  for (const opt of options) {
    // Rolle umrandet: gleichrangige Auswahlmoeglichkeiten, keine
    // Hauptsache - dieselbe Einordnung wie wp-monitor-btn (Task B). Wer
    // gerade gewaehlt ist, zeigt weiterhin die Klasse "active", nicht
    // die Rolle.
    const btn = zepButton(opt.label, "umrandet", () => {
      for (const b of buttons) b.remove_css_class("active")
      btn.add_css_class("active")
      onChange(opt.value)
    })
    if (opt.value === currentValue) btn.add_css_class("active")

    buttons.push(btn)
    toggleBox.append(btn)
  }

  box.append(labelWidget)
  box.append(toggleBox)

  return box
}

// EINE LISTE VON ZEICHENKETTEN MIT HINZUFUEGEN UND LOESCHEN
//
//     EINGEFUEHRT am 21.08.2026, und zwar durch ZUSAMMENFASSEN und
//     nicht durch Hinzufuegen: derselbe Aufbau (Kopf mit Plus-Knopf,
//     Liste aus Eingabezeile plus Loeschknopf, rebuild-Schleife) stand
//     in dieser Datei schon ZWEIMAL - einmal fuer die gerouteten Netze
//     in buildPhase2Tab, einmal fuer die DNS-Server in buildDnsTab. Die
//     zweite Bauart braucht ihn ein DRITTES Mal (die eigenen Adressen)
//     und ein VIERTES (die erlaubten Netze je Gegenstelle).
//
//     Vier Abschriften desselben Bauteils sind vier Stellen, an denen
//     der naechste Fehler nur an dreien behoben wird. Also einmal, hier.
//
//     `read`/`write` statt eines Feldnamens, weil die vier Listen an
//     vier verschiedenen Stellen haengen - zwei direkt an
//     currentSettings, eine an wireguard, eine an EINER Gegenstelle
//     darin.
function buildStringList(title: string, addTooltip: string, placeholder: string,
                         read: () => string[], write: (values: string[]) => void,
                         titleClass: string = "vpn-field-label"): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6 })

  const header = new Gtk.Box({ spacing: 8 })
  const label = new Gtk.Label({ label: title, xalign: 0, hexpand: true })
  label.add_css_class(titleClass)

  // Rolle umrandet: eine wirkliche Handlung (Eintrag hinzufuegen),
  // keine Navigation. `rebuild` ist eine Funktionsdeklaration und damit
  // gehoben - der Aufruf hier loest erst beim Klick auf.
  const addBtn = zepButton(ICONS.add, "umrandet", () => {
    write([...read(), ""])
    rebuild()
  })
  addBtn.set_tooltip_text(addTooltip)

  header.append(label)
  header.append(addBtn)

  const list = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 6 })
  list.add_css_class("vpn-list-container")

  function rebuild() {
    clearBox(list)
    const values = read()
    for (let i = 0; i < values.length; i++) {
      const idx = i
      const item = new Gtk.Box({ spacing: 8 })
      item.add_css_class("vpn-list-item")

      const entry = new Gtk.Entry({ text: values[idx], hexpand: true,
                                    placeholder_text: placeholder })
      entry.add_css_class("vpn-entry")
      entry.connect("changed", () => {
        const current = read()
        current[idx] = entry.get_text()
        write(current)
      })

      // Rolle kritisch, wie vom Auftrag verlangt (loeschen ist zerstoerend).
      const deleteBtn = zepButton(ICONS.delete, "kritisch", () => {
        const current = read()
        current.splice(idx, 1)
        write(current)
        rebuild()
      })

      item.append(entry)
      item.append(deleteBtn)
      list.append(item)
    }
  }

  rebuild()
  box.append(header)
  box.append(list)
  return box
}

// Create a checkbox
function createCheckbox(label: string, checked: boolean, onChange: (checked: boolean) => void): Gtk.Button {
  const btn = new Gtk.Button({ can_focus: false })
  btn.set_child(new Gtk.Label({ label: `${checked ? "☑" : "☐"} ${label}` }))
  btn.add_css_class("vpn-checkbox")
  if (checked) btn.add_css_class("checked")

  let isChecked = checked
  btn.connect("clicked", () => {
    isChecked = !isChecked
    btn.set_child(new Gtk.Label({ label: `${isChecked ? "☑" : "☐"} ${label}` }))
    if (isChecked) {
      btn.add_css_class("checked")
    } else {
      btn.remove_css_class("checked")
    }
    onChange(isChecked)
  })

  return btn
}

// ============================================================================
// DIE BAUART - EINE AUSWAHL MIT DREI EINTRAEGEN
// ============================================================================
//
// BESTELLT am 21.08.2026: "ich will, dass das vpn fenster auch wireguard
// unterstützt - wireguard dateien oder eigene konfigurationen. also
// auswahl: ipsec oder ipsecv2 oder wireguard"
//
// GEMESSEN am selben Tag, BEVOR hier etwas gebaut wurde: das Fenster
// konnte IKEv1 und IKEv2 laengst. Der Umschalter stand im Reiter
// "Phase 1", hiess "IKE version" und lag zwischen
// Schluessellebensdauer und den beiden DPD-Fristen. Er war also da -
// und unauffindbar. Der Nutzer kannte ihn nicht, weil er ihn nie
// gesehen hat.
//
// DIESE AUSWAHL ERFINDET DARUM NICHTS. Sie zeigt eine Unterscheidung,
// die es gibt, an der Stelle, an der man sie sucht, und bildet auf zwei
// bestehende Werte ab:
//
//     IPsec (IKEv1)   kind=ipsec       phase1.version=1
//     IPsec (IKEv2)   kind=ipsec       phase1.version=2
//     WireGuard       kind=wireguard   phase1 bleibt unberuehrt
//
// DER ALTE UMSCHALTER IM DRITTEN REITER FAELLT (Regel 14): zwei
// Bedienelemente fuer denselben Wert sind zwei Stellen, an denen etwas
// Verschiedenes stehen kann - und die eine, die niemand findet,
// gewinnt am Ende. Der Aggressive/Main-Umschalter BLEIBT dort, weil er
// einen ANDEREN Wert traegt (phase1.aggressive); er haengt weiterhin an
// der Version und wird jetzt von hier aus sichtbar geschaltet.
//
// UND phase1.version BLEIBT BEI "WireGuard" UNBERUEHRT, absichtlich:
// wer von IPsec kommt und zurueckschaltet, findet seine IKE-Version
// vor, wie er sie verlassen hat.
const KIND_IPSEC_V1 = "ipsec1"
const KIND_IPSEC_V2 = "ipsec2"
const KIND_WIREGUARD = "wireguard"

function currentKindChoice(): string {
  if (currentSettings.kind === "wireguard") return KIND_WIREGUARD
  return currentSettings.phase1.version === 1 ? KIND_IPSEC_V1 : KIND_IPSEC_V2
}

function applyKindChoice(choice: string) {
  if (choice === KIND_WIREGUARD) {
    currentSettings.kind = "wireguard"
  } else {
    currentSettings.kind = "ipsec"
    currentSettings.phase1.version = choice === KIND_IPSEC_V1 ? 1 : 2
  }
  // Baut die Reiterleiste UND die Inhalte neu - also auch den Kasten,
  // in dem der gerade gedrueckte Knopf sitzt. Das ist in dieser Datei
  // schon der Normalfall (die rebuild-Schleife in buildStringList tut
  // dasselbe aus dem Loeschknopf ihrer eigenen Zeile heraus): die
  // Signalauslieferung haelt eine Referenz auf das Widget, solange der
  // Rueckruf laeuft.
  rebuildTabs()
}

// Der Weg zu vpn.py. Als fertige Argumentliste und nicht als
// Befehlstext: execAsync(string) zerlegt mit GLib.shell_parse_argv und
// startet keine Shell, ein Systemwurzelpfad mit einem Leerzeichen
// waere also zwei Argumente. Dieselbe Begruendung wie bei
// SETTINGS_WRITER oben.
const VPN_TOOL = ["python3", `${ZEPOS_SYSTEM_ROOT}/vpn.py`]

// Das Fenster, an dem der Dateiwaehler haengt. GTK4 will fuer
// Gtk.FileDialog.open() ein Elternfenster; buildContent() bekommt es
// und legt es hier ab.
