// PSK file location (user config)
const PSK_FILE = `${HOME}/.config/strongswan/psk`
const PSK_DIR = `${HOME}/.config/strongswan`
// Der Pfad, den die Statuszeile ZEIGT - mit `~` statt dem aufgeloesten
// Heimatverzeichnis. Er steht als Wert neben der Meldung und nicht in
// ihr: ein Uebersetzer darf den Satz aendern, den Pfad nicht.
// 17.08.2026
const PSK_DISPLAY_PATH = "~/.config/strongswan/psk"

// Load PSK from user config file
function loadPsk(): string {
  try {
    const [ok, contents] = GLib.file_get_contents(PSK_FILE)
    if (!ok || !contents) return ""
    return new TextDecoder().decode(contents).trim()
  } catch (e) {
    return ""
  }
}

// Save PSK to user config file.
//
// Written from this process, not through a command line, and that is the
// whole point of the change.
//
// It used to hand execAsync the string
//   `python3 -c "..." > ${PSK_FILE} && chmod 600 ${PSK_FILE}`
// and Astal's execAsync(string) does not start a shell: it splits the
// string with GLib.shell_parse_argv and runs the result directly. So
// ">", the path, "&&", "chmod", "600" and the path again were passed to
// python3 AS ARGUMENTS. Measured: python3 exits 0, savePsk returns true,
// the dialog says "PSK wurde sicher gespeichert" - and no file is ever
// created, after which ags-vpn.template stops at "PSK nicht gefunden"
// forever. On a fresh installation that is a loop with no way out.
//
// Gio.FileCreateFlags.PRIVATE creates the file readable by its owner
// only, from the first byte rather than after a chmod - the same
// reasoning vpn-connect-script.template's umask carries. REPLACE_DESTINATION
// makes it a NEW file instead of rewriting an existing one, so a PSK
// store that was once world-readable does not stay that way.
function savePsk(psk: string): boolean {
  try {
    GLib.mkdir_with_parents(PSK_DIR, 0o700)
    const stream = Gio.File.new_for_path(PSK_FILE).replace(
      null, false,
      Gio.FileCreateFlags.PRIVATE | Gio.FileCreateFlags.REPLACE_DESTINATION,
      null)
    stream.write_all(new TextEncoder().encode(psk), null)
    stream.close(null)
    return true
  } catch (e) {
    console.error("Failed to save PSK:", e)
    return false
  }
}

// Check if PSK file exists
function pskFileExists(): boolean {
  return GLib.file_test(PSK_FILE, GLib.FileTest.IS_REGULAR)
}

// Switch tab
function switchTab(tabName: string) {
  currentTab = tabName

  // Update tab buttons
  for (const [name, btn] of tabButtons) {
    if (name === tabName) {
      btn.add_css_class("active")
    } else {
      btn.remove_css_class("active")
    }
  }

  // Show/hide content
  generalBox.set_visible(tabName === "general")
  phase1Box.set_visible(tabName === "phase1")
  phase2Box.set_visible(tabName === "phase2")
  dnsBox.set_visible(tabName === "dns")
}

