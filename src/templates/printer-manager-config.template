#!/bin/bash
# =========================================
# DRUCKER-DIALOG (CUPS)
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/printer-manager-config.template
# =========================================
#
# Ersetzt die drei gerätegebundenen Skripte des Ursprungs: zwei
# Einrichtungsskripte, die je genau ein Fabrikat mit dessen eigenem
# Treiber eintrugen, und eine Statusabfrage, die denselben Namen noch
# einmal fest verdrahtet hatte. Auf jedem anderen Schreibtisch liefen
# alle drei ins Leere.
#
# Hier steht kein Gerätename und kein Treiber. Was da ist, wird gefragt:
# `lpstat` für das, was eingerichtet ist, `lpinfo` für das, was
# erreichbar ist. Eingerichtet wird treiberlos über IPP - ein Weg für
# jedes Gerät, das ihn spricht, statt eines Skripts je Gerät.
#
# Ohne Rechteerhöhung, mit Absicht: lpadmin meldet sich selbst bei cupsd
# an. Wer nicht in der CUPS-Verwaltungsgruppe steht, bekommt hier eine
# Meldung, die das sagt - statt einer Passwortabfrage in einem Terminal,
# das niemand sieht, weil dieser Dialog aus einer Tastenkombination
# heraus startet.

set -u

ICON="{{ICON_PRINTER}}"
SELF="${0##*/}"

melden() {
    notify-send "$ICON Drucker" "$1"
}

# Eingerichtete Ziele, ein Name je Zeile.
#
# `lpstat -e` und nicht `lpstat -p`: -p schreibt einen ganzen Satz, dessen
# Wortlaut von der eingestellten Sprache abhängt. -e gibt nur die Namen
# aus, einen je Zeile, in jeder Sprache gleich.
eingerichtete_drucker() {
    lpstat -e 2>/dev/null
}

# Erreichbare Geräte, eine Adresse je Zeile.
#
# `lpinfo -v` listet auch die Rückwände `file` und `serial` auf. Das sind
# keine Geräte, die man einrichten will, und sie als solche anzubieten
# heißt, dem Nutzer Unsinn zur Auswahl zu stellen.
erreichbare_geraete() {
    lpinfo -v 2>/dev/null | while read -r klasse adresse _rest; do
        case "$klasse" in
            network|direct) printf '%s\n' "$adresse" ;;
        esac
    done
}

case "${1:-menu}" in
    list)
        eingerichtete_drucker
        ;;

    discover)
        erreichbare_geraete
        ;;

    menu)
        drucker=$(eingerichtete_drucker)
        if [ -z "$drucker" ]; then
            # Ein leeres Auswahlfenster ist von einem kaputten Dialog nicht
            # zu unterscheiden. Also lieber sagen, was fehlt und wie man
            # es behebt.
            melden "Kein Drucker eingerichtet. '$SELF add' sucht nach erreichbaren Geräten."
            exit 0
        fi
        auswahl=$(printf '%s\n' "$drucker" | zepos-menu --dmenu --prompt "$ICON Drucker")
        # Abbruch mit Escape gibt eine leere Zeile zurück. Die als
        # Auswahl zu lesen hieße, einen Drucker namens "" zum Standard zu
        # machen.
        [ -n "$auswahl" ] || exit 0
        if lpoptions -d "$auswahl" >/dev/null 2>&1; then
            melden "$auswahl ist jetzt der Standarddrucker."
        else
            melden "$auswahl liess sich nicht zum Standard machen."
            exit 1
        fi
        ;;

    add)
        geraete=$(erreichbare_geraete)
        if [ -z "$geraete" ]; then
            melden "Kein erreichbares Gerät gefunden."
            exit 0
        fi
        adresse=$(printf '%s\n' "$geraete" | zepos-menu --dmenu --prompt "$ICON Gerät")
        [ -n "$adresse" ] || exit 0

        name=$(printf '' | zepos-menu --dmenu --prompt "$ICON Name")
        # CUPS lehnt Namen mit Leerzeichen, "/" oder "#" ab - und zwar
        # erst, nachdem der Nutzer ihn getippt hat, in einer Meldung, die
        # er nie sieht, weil das Fenster da schon geschlossen ist.
        case "$name" in
            ''|*[\ /\#]*)
                melden "Ungültiger Name: Leerzeichen, / und # sind nicht erlaubt."
                exit 1
                ;;
        esac

        # -m everywhere ist der treiberlose IPP-Weg. Genau darin liegt der
        # Unterschied zu den beiden Ursprungsskripten, die je ein
        # herstellereigenes Treiberpaket mitbrachten und ohne dieses
        # Paket nichts taten.
        if fehler=$(lpadmin -p "$name" -v "$adresse" -E -m everywhere 2>&1); then
            melden "$name eingerichtet."
        else
            melden "Einrichten fehlgeschlagen: ${fehler:-cupsd antwortet nicht}"
            exit 1
        fi
        ;;

    status)
        # Ohne laufenden cupsd schreibt lpstat seinen Fehler nach stderr
        # und gibt sonst nichts aus. Eine leere Ausgabe sähe aus wie "kein
        # Drucker vorhanden" und schickte den Nutzer in die falsche
        # Richtung.
        if ! lpstat -t 2>/dev/null; then
            echo "CUPS antwortet nicht - läuft cupsd?" >&2
            exit 1
        fi
        ;;

    *)
        echo "Aufruf: $SELF {menu|list|discover|add|status}" >&2
        exit 1
        ;;
esac
