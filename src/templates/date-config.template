#!/bin/bash
# Date with calendar tooltip for the bar
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
#
# WARUM HIER KEINE SPRACHUMGEBUNG ERZWUNGEN WIRD
# Vor `date` und `cal` stand `LANG=de_DE.UTF-8`. Dieses Modul schreibt
# selbst kein deutsches Wort: %d.%m.%Y ist eine Ziffernfolge, und den
# Wochentag wie den ganzen Kalender liefert die Sprachumgebung. Deutsch
# war daran also nichts von uns - nur die Annahme, jede Installation sei
# eine deutsche.
#
# Erzwingen half dabei nicht: ist de_DE.UTF-8 auf dem Rechner nicht
# erzeugt, faellt date wortlos auf C zurueck - Rueckgabewert 0, leere
# Fehlerausgabe, englische Wochentage -, und LC_TIME oder LC_ALL des
# Nutzers stechen LANG ohnehin. Der ZepOS-Installer bietet Englisch an
# (en -> en_US, UTC); auf so einer Installation verlangte die Leiste eine
# Sprachumgebung, die es dort nicht geben muss.
#
# Ohne die Zeile erbt beides die Sprachumgebung der Sitzung. Dieselbe
# Entscheidung wie in src/clocks.py, und dieselbe Messung.

# DIE UHRZEIT STEHT SEIT DEM 12.08.2026 DABEI
#     GEMELDET an dem Tag, in zwei Worten: "deutsche uhrzeit".
#
#     GEMESSEN, bevor etwas geaendert wurde: dieses Modul schrieb
#     `%a %d.%m.%Y` und damit KEINE Uhrzeit. Das zweite Modul, das eine
#     zeigen koennte - custom/clocks - zeigt ausschliesslich ZUSAETZLICHE
#     Zeitzonen und gibt ohne eine einzige konfigurierte eine leere
#     Zeile aus, worauf die Leiste es ausblendet. Auf einer frischen
#     Installation stand also nirgends eine Uhr. Der Nutzer hat nicht
#     das Format bemaengelt, er hat die Uhr vermisst.
#
#     %H:%M und nicht %I:%M %p: die 24-Stunden-Zaehlung IST die deutsche
#     Uhrzeit, und sie ist zugleich die einzige Schreibweise, die ohne
#     Sprachumgebung auskommt - %p ist in der Umgebung C leer, und die
#     Zeile saehe dann aus wie eine mit einer verlorenen Angabe. Das ist
#     dieselbe Ueberlegung wie oben: dieses Modul schreibt Ziffern, den
#     Rest liefert die Sitzung.
#
#     Der Takt passt schon: ags-bar.template ruft dieses Skript alle
#     60000 ms, also einmal je Minute - genau die Aufloesung von %H:%M.
DATE_TEXT=$(date +"{{ICON_CALENDAR}}  %a %d.%m.%Y  %H:%M")

# Calendar with escaped newlines for JSON
CALENDAR=$(cal | sed ':a;N;$!ba;s/\n/\\n/g')

# WAS DIE LETZTE ZEILE DES TOOLTIPS SAGT, UND WARUM SIE HIER STEHT
#     Dieses Modul hat seit dem 12.08.2026 ZWEI Tasten: links der
#     Kalender, rechts das Meldungszentrum (die Messung dazu steht im
#     Zweig "custom/date" in src/templates/ags-bar.template). Eine
#     rechte Taste ohne Hinweis ist eine Funktion, die nur findet, wer
#     sie schon kennt - und dieses Modul ist auf einer frischen
#     Installation der einzige Weg zum Verlauf der Meldungen.
#
#     Im Tooltip und nicht auf der Leiste: Platz auf der Leiste ist das,
#     was gerade knapp geworden ist, und ein Hinweis, den man einmal
#     liest, gehoert nicht dauerhaft in die Breite.
HINWEIS="Rechte Taste: Meldungen"

# Output JSON for the bar
printf '{"text": "%s", "tooltip": "%s\\n%s"}\n' \
    "$DATE_TEXT" "$CALENDAR" "$HINWEIS"
