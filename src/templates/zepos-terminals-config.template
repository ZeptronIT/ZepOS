#!/bin/bash
# =========================================
# ZEPOS TERMINALS LAUNCHER
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/zepos-terminals-config.template
# =========================================
#
# Opens 2 floating Kitty terminals for ZepOS development
# 1. Main ZepOS directory
# 2. Home directory
#
# NO COORDINATE IN THIS FILE IS A NUMBER SOMEBODY TYPED.
#
# The origin placed the two windows at fixed pixel positions measured off
# its author's own desk. Those numbers describe one monitor layout: on a
# smaller screen both windows land partly or wholly outside it, and a
# window Hyprland has moved off the visible area is one the user cannot
# reach with the mouse. The geometry is derived from the screen the
# windows actually open on instead - and from monitors.py, which is the
# same answer the workspace rules and the bar are built from, so it
# cannot disagree with them when a cable moves.
# =========================================

# ZepOS configuration
# Substituted while generating, not defaulted at run time: this script
# ends up far from the package and cannot work out where that package
# is. A hard-coded installation path would be a guess, and a wrong
# guess aborts here with nothing but "no such file or directory".
ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"
HOME_DIR="$HOME"
DELAY=0.3

# Which workspace the two terminals open on. Not a monitor and not a
# position - monitors.py decides which screen this workspace lives on,
# and that is what the geometry below follows.
WORKSPACE=3

# The screen holding $WORKSPACE: origin and size, after any rotation.
# Empty when nothing could answer - no compositor, no hyprctl, a
# workspace no screen holds - and every use below is guarded on that.
SCREEN=""
if screen=$(python3 "$ZEPOS_SYSTEM_ROOT/monitors.py" --workspace "$WORKSPACE" 2>/dev/null); then
    SCREEN="$screen"
fi

# Helper function to position window after spawn
#
# Takes FRACTIONS of the screen, not pixels: `2 20 47 60` means "2% of
# the width from the left edge, 20% of the height down, 47% wide, 60%
# high". The caller says where on the screen a window belongs; this
# works out where that is on the screen there actually is.
position_window() {
    local title="$1"
    local workspace="$2"
    local left_percent="$3"
    local top_percent="$4"
    local width_percent="$5"
    local height_percent="$6"

    # Wait for window to appear (max 3 seconds)
    local addr=""
    local i
    for i in {1..30}; do
        # Both halves silenced: hyprctl fails when the compositor is not
        # there, and jq then reads an empty document and fails too. Two
        # error messages per attempt, thirty attempts, and the one line
        # that says what actually went wrong is printed below.
        addr=$(hyprctl clients -j 2>/dev/null \
               | jq -r ".[] | select(.title == \"$title\") | .address" 2>/dev/null)
        if [ -n "$addr" ] && [ "$addr" != "null" ]; then
            break
        fi
        addr=""
        sleep 0.1
    done

    if [ -z "$addr" ]; then
        echo "{{ICON_WARNING}} Warning: Could not position window '$title'"
        return 1
    fi

    # The move happens whether or not the screen could be measured: a
    # terminal on the right workspace and wherever Hyprland put it is
    # still usable, and it is what the user gets on any desk where the
    # compositor cannot be asked.
    hyprctl dispatch movetoworkspacesilent "$workspace,address:$addr" >/dev/null

    if [ -z "$SCREEN" ]; then
        return 0
    fi

    local screen_x screen_y screen_w screen_h
    read -r screen_x screen_y screen_w screen_h <<< "$SCREEN"

    # Integer arithmetic throughout - bash has no other kind - so the
    # rounding is a pixel or two and always inward, which is the safe
    # direction: a window one pixel narrower than intended is invisible
    # to the eye, one pixel wider than the screen is a scroll bar the
    # user cannot reach.
    local width=$(( screen_w * width_percent / 100 ))
    local height=$(( screen_h * height_percent / 100 ))
    local x=$(( screen_x + screen_w * left_percent / 100 ))
    local y=$(( screen_y + screen_h * top_percent / 100 ))

    hyprctl dispatch movewindowpixel "exact $x $y,address:$addr" >/dev/null
    hyprctl dispatch resizewindowpixel "exact $width $height,address:$addr" >/dev/null
    return 0
}

echo "{{ICON_CODE}} Opening ZepOS Development Terminals..."
notify-send "{{ICON_CODE}} ZepOS Terminals" "Opening 2 development terminals..." -t 3000

if [ -z "$SCREEN" ]; then
    # Said once, and not treated as a failure. The terminals are the
    # point; their placement is not.
    echo "{{ICON_WARNING}} Screen for workspace $WORKSPACE not detectable - windows are not positioned"
fi

# Terminal 1: ZepOS Root Directory
if [ -d "$ZEPOS_SYSTEM_ROOT" ]; then
    setsid -f kitty --class="floating-center" \
          --title="ZepOS: Main" \
          --directory "$ZEPOS_SYSTEM_ROOT"
    # Left half of the screen, vertically centred. Two windows side by
    # side with a 2% gutter between them and 2% margins at the edges.
    position_window "ZepOS: Main" "$WORKSPACE" 2 20 47 60
    sleep $DELAY
else
    echo "{{ICON_ERROR}} Directory not found: $ZEPOS_SYSTEM_ROOT"
    notify-send "{{ICON_ERROR}} Directory Missing" "ZepOS root not found: $ZEPOS_SYSTEM_ROOT" -u critical
    exit 1
fi

# Terminal 2: Home Directory
setsid -f kitty --class="floating-center" \
      --title="ZepOS: Home" \
      --directory "$HOME_DIR"
# Right half, mirroring the left one.
position_window "ZepOS: Home" "$WORKSPACE" 51 20 47 60
sleep $DELAY

echo "{{ICON_SUCCESS}} ZepOS terminals opened successfully!"
