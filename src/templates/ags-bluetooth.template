const WIN_WIDTH = 500

// DIE HOEHE IST AM 17.08.2026 VON 550 AUF 600 GEGANGEN, UND ES WAREN
// DREI PUNKTE
//     GEMESSEN am selben Tag mit drei bekannten Geraeten: der Inhalt
//     wollte 553 Punkte, das Fenster gab 550 - eine Bildlaufleiste fuer
//     DREI Punkte, und der Nutzer hat sie gesehen ("und nach unten
