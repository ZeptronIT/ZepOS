#!/bin/bash
# =========================================
# VPN FAILSAFE WATCHER
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/vpn-watcher-config.template
# =========================================
#
# Polls strongSwan tunnel health and re-initiates dead CHILD_SAs.
# Pairs with start_action=trap and the state-file mechanism in vpn-connect.sh.
#
# Conditions for action:
#   - state file present (user connected, did not disconnect)
#   - charon running, virtual IP present (IKE_SA still up)
#   - swanctl shows IKE ESTABLISHED but no INSTALLED CHILD_SA
#     -> half-up: try re-initiating every configured child
#
# Otherwise the watcher is a no-op (does NOT auto-connect on its own).
# =========================================

set -u

# Alles, was dieser Dienst anlegt - Sperrdatei und Protokoll -, gehoert
# vom ersten Byte an nur dem Benutzer.
umask 077

readonly STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vpn-active"
readonly LOCK_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vpn-watcher.lock"
readonly LOG_FILE="${HOME}/.local/share/vpn-logs/vpn-watcher.log"
readonly SUDOERS_HINT="Rechte-Regel fehlt: einmalig '${XDG_CONFIG_HOME:-$HOME/.config}/ags/scripts/vpn-control.sh install-privileges' ausfuehren (/etc/sudoers.d/zepos)."

readonly WATCH_INTERVAL=60
readonly MAX_CONSECUTIVE_FAILURES=3

# Substituted while generating, from vpn.routed_networks and
# vpn.connection_name. Both are empty until a VPN is configured, and this
# watcher is a no-op without a state file anyway - it never connects on
# its own.
readonly CHILD_SA_NAMES="{{STYLE_VPN_CHILD_NAMES}}"
readonly ROUTED_NETWORKS="{{STYLE_VPN_ROUTED_NETWORKS}}"

# Substituted while generating: this script runs from
# ~/.config/ags/scripts and cannot find the package by itself.
readonly ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"

# Der Tunnelzustand und die zugewiesene Adresse werden aus dem Bericht
# gelesen, den strongSwan selbst schreibt - einmal, in vpn.py, fuer alle
# Skripte, die sie brauchen.
vpn_query() {
    python3 "$ZEPOS_SYSTEM_ROOT/vpn.py" "$@"
}

mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

# Single-instance guard. A profile switch or hyprland reload can re-trigger
# the exec-once line — without flock we'd stack watchers and double-initiate.
exec 200>"$LOCK_FILE"
if ! flock -n -x 200; then
    log "Another watcher is already running; exiting."
    exit 0
fi

log "VPN watcher started (pid $$, interval ${WATCH_INTERVAL}s)"

# Dieser Dienst hat kein Terminal - hyprland startet ihn abgekoppelt,
# eine systemd-Unit im Benutzerkontext ebenso - und keinen
# Askpass-Helfer. Ein blankes `sudo` kann hier niemanden nach einem
# Passwort fragen; es gibt niemanden.
#
# Der Ursprung loeste das, indem das Verbinden das Login-Passwort des
# Benutzers nach $XDG_RUNTIME_DIR/vpn-sudo-cache schrieb und dieser
# Dienst es `sudo -S` unterschob. Ein Login-Passwort auf der Platte,
# damit ein Hintergrundprozess ein paar ip-Befehle absetzen kann.
#
# Diese Befehle stehen jetzt in /etc/sudoers.d/zepos. `sudo -n` fuehrt
# sie ohne Passwort und ohne Rueckfrage aus - genau das, was ein Dienst
# ohne Gegenueber braucht. Ohne die Regel scheitert `sudo -n` sofort,
# und der Watcher sagt einmal, was fehlt, statt es minuetlich zu
# wiederholen. pkexec kommt hier bewusst nicht vor: es wuerde einen
# Dialog oeffnen, den niemand angefordert hat.
run_sudo() {
    sudo -n "$@" 2>/dev/null
}

# Einmal pro Lauf gemeldet, nicht einmal pro Runde.
privileges_reported=false

have_privileges() {
    if sudo -n true 2>/dev/null; then
        return 0
    fi
    if [ "$privileges_reported" = false ]; then
        log "Keine Root-Rechte ohne Passwort - Reparatur nicht moeglich."
        log "$SUDOERS_HINT"
        privileges_reported=true
    fi
    return 1
}

# Returns 0 = healthy, 1 = half-up (try recovery), 2 = no tunnel (no-op)
#
# Hier stand eine Vorpruefung auf eine Adresse aus dem Pool eines
# bestimmten Gateways. Sie war als billiger Abbruch gedacht, bevor sudo
# ins Spiel kommt, und traf bei jedem anderen Gateway nicht zu: der
# Watcher meldete "kein Tunnel", und die Reparatur, fuer die es ihn gibt,
# lief nie. Der Bericht von
# strongSwan sagt ohnehin genauer, was los ist - also wird nur noch
# gefragt, was ohne Rechte feststellbar ist (haben wir verbunden, laeuft
# charon), und der Rest kommt aus dem Bericht.
check_tunnel_health() {
    [ -f "$STATE_FILE" ] || return 2
    pgrep -f charon > /dev/null 2>&1 || return 2

    # Ab hier braucht es Root-Rechte. Ohne sie laesst sich nichts
    # feststellen und erst recht nichts reparieren -> als "unbekannt"
    # behandeln und zurueckziehen.
    have_privileges || return 2

    local sas
    sas=$(run_sudo swanctl --list-sas) || return 2

    # Dieselbe Auswertung wie im Verbindungsskript: 0 gesund, 1 halb
    # oben, 2 kein Tunnel. Die Anzahl der CHILD_SAs auf der
    # Standardausgabe interessiert hier nicht.
    local health=0
    printf '%s\n' "$sas" | vpn_query --tunnel-health > /dev/null || health=$?

    # Ein Bericht ganz ohne IKE_SA heisst an DIESER Stelle nicht "kein
    # Tunnel": Zustandsdatei und charon sind da, es ist also alles
    # zusammengebrochen, was wir aufgebaut hatten. Genau dafuer gibt es
    # die Wiederherstellung, und `swanctl --initiate --child` bringt die
    # IKE_SA wieder mit hoch.
    [ "$health" -eq 2 ] && health=1
    return $health
}

reinitiate_children() {
    # The same names the connect script wrote into the configuration,
    # generated from vpn.routed_networks. Reading them here through jq -
    # as the origin did - was a second, independent derivation from a file
    # that may have changed since, and its fallback was the previous
    # employer's connection name, so an unconfigured machine kept trying
    # to initiate a child called "work-ipsec" once a minute, forever.
    local children="$CHILD_SA_NAMES"
    [ -n "$children" ] || return 1

    local any_ok=1
    for child in $children; do
        local out
        # swanctl bringt seine eigene Zeitgrenze mit. Ein `timeout` davor
        # muesste in der Rechte-Regel stehen - und damit jeder Befehl,
        # den man timeout mitgeben kann.
        out=$(run_sudo swanctl --initiate --child "$child" --timeout 15 2>&1)
        if echo "$out" | grep -qiE "successfully|established"; then
            log "Re-initiated CHILD_SA '$child' OK"
            any_ok=0
        else
            log "Re-initiate failed for '$child': $out"
        fi
    done
    return $any_ok
}

# Self-overlap heal: when the VPN server hands out the virtual IP from inside one
# of the routed networks, the VIP sits INSIDE that network's remote_ts.
# strongSwan then auto-installs a broad pass policy  src N dst N  (prio ~191807)
# that SHADOWS the real tunnel policy  src <VIP>/32 dst N  (prio ~379519) — lower
# number = higher prio. Result: hosts in that network get sent in clear over the
# local interface instead of through the tunnel and are unreachable. Routed
# networks that do not contain the VIP are unaffected.
# Heal: for every remote_ts whose first octet matches the VIP (possible overlap),
# clone strongSwan's own tunnel policy at a HIGHER priority (150) so it beats the
# pass policy. The current reqid is read per-selector from 'swanctl --list-sas'
# (robust remote_ts->reqid mapping) and re-synced via 'update' whenever it drifts
# after a reconnect/rekey. NON-destructive: never deletes strongSwan policies.
# Split "net/prefix" into its two "net/(prefix+1)" halves. Needed because xfrm
# policies are keyed by (selector, dir) — priority is only an attribute, not part
# of the key. So we cannot 'add' a second policy with the SAME selector as
# strongSwan's existing /prefix tunnel policy (RTNETLINK: File exists). Splitting
# into two halves gives DISTINCT selectors that still cover the whole range and,
# at a lower priority number, win over the broad pass policy.
split_selector() {
    local cidr=$1 net prefix a b c d ip newp halfsize lower upper
    net=${cidr%/*}; prefix=${cidr#*/}
    IFS=. read -r a b c d <<< "$net"
    ip=$(( (a<<24) | (b<<16) | (c<<8) | d ))
    newp=$((prefix + 1))
    halfsize=$(( 1 << (32 - newp) ))
    lower=$ip
    upper=$(( ip + halfsize ))
    printf '%d.%d.%d.%d/%d %d.%d.%d.%d/%d\n' \
        $(((lower>>24)&255)) $(((lower>>16)&255)) $(((lower>>8)&255)) $((lower&255)) $newp \
        $(((upper>>24)&255)) $(((upper>>16)&255)) $(((upper>>8)&255)) $((upper&255)) $newp
}

heal_self_overlap() {
    local vip vip_octet sas pol t_src t_dst children ts cur_reqid have_reqid half_lo half_hi h
    sas=$(run_sudo swanctl --list-sas 2>/dev/null) || return 0

    # Die virtuelle Adresse aus dem Bericht, nicht aus einem Muster ueber
    # `ip addr show`. Hier stand `grep 10\.[0-9]+\....`, also "die erste
    # Adresse aus 10.0.0.0/8" - auf einer Maschine mit einem
    # Docker-Netz oder einem zweiten Tunnel in 10/8 war das die falsche,
    # und die geheilten Policies zeigten auf eine Adresse, die dem
    # Tunnel nie gehoert hat.
    vip=$(printf '%s\n' "$sas" | vpn_query --virtual-address) || vip=""
    [ -n "$vip" ] || return 0
    vip_octet=${vip%%.*}

    pol=$(run_sudo ip xfrm policy 2>/dev/null) || return 0
    t_src=$(printf '%s\n' "$pol" | grep -oP 'tmpl src \K[0-9.]+' | head -1)
    t_dst=$(printf '%s\n' "$pol" | grep -oP 'tmpl src [0-9.]+ dst \K[0-9.]+' | head -1)
    [ -n "$t_src" ] && [ -n "$t_dst" ] || return 0

    children="$ROUTED_NETWORKS"
    for ts in $children; do
        # only selectors whose first octet matches the VIP can contain it (overlap)
        [ "${ts%%.*}" = "$vip_octet" ] || continue

        # current reqid for THIS selector — robust remote_ts->reqid mapping via swanctl.
        # ('ip xfrm policy' parsing is unreliable: children share overlapping blocks,
        #  so grabbing the wrong child's reqid points the policy at a dead SA.)
        cur_reqid=$(printf '%s\n' "$sas" | awk -v sel="$ts" '
            match($0,/reqid [0-9]+/){r=substr($0,RSTART+6,RLENGTH-6)}
            $1=="remote" && $2==sel {print r; exit}')
        [ -n "$cur_reqid" ] || continue

        # split into two distinct half-selectors (cannot reuse strongSwan's exact
        # selector: xfrm policies are keyed by selector+dir, so 'add' would collide).
        read -r half_lo half_hi <<< "$(split_selector "$ts")"

        # reqid currently pinned in OUR prio-150 policy (only we use the /9 split)
        have_reqid=$(printf '%s\n' "$pol" | awk -v sel="dst $half_lo" '
            $1=="src" && index($0, sel){f=1}
            f && match($0,/reqid [0-9]+/){print substr($0,RSTART+6,RLENGTH-6); exit}')

        # act only when missing or pinned to a stale reqid (self-corrects after a
        # reconnect/rekey that reassigns reqids; avoids 60s log spam otherwise).
        if [ "$have_reqid" != "$cur_reqid" ]; then
            for h in "$half_lo" "$half_hi"; do
                run_sudo ip xfrm policy update src "$vip/32" dst "$h" dir out priority 150 \
                    tmpl src "$t_src" dst "$t_dst" proto esp reqid "$cur_reqid" mode tunnel 2>/dev/null || true
                run_sudo ip xfrm policy update src "$h" dst "$vip/32" dir in priority 150 \
                    tmpl src "$t_dst" dst "$t_src" proto esp reqid "$cur_reqid" mode tunnel 2>/dev/null || true
            done
            run_sudo ip route flush cache 2>/dev/null || true
            log "Self-overlap heal: $ts /9-split tunnel policies -> reqid $cur_reqid (was '${have_reqid:-none}', VIP $vip)"
        fi
    done
}

failures=0

# Eine Runde: pruefen, und bei Bedarf reparieren.
watch_once() {
    # Der Rueckgabewert wird sofort festgehalten. Nach einem `if ...; fi`
    # ohne else steht in $? die Null der if-Anweisung selbst und nicht
    # mehr der Wert der Bedingung - der Unterschied zwischen "halb oben"
    # (1) und "kein Tunnel" (2) waere damit verloren.
    local rc=0
    check_tunnel_health || rc=$?

    if [ "$rc" -eq 0 ]; then
        if [ "$failures" -gt 0 ]; then
            log "Tunnel healthy again after $failures failure(s)"
        fi
        failures=0
        # Tunnel is up + CHILD_SAs INSTALLED -> ensure overlapping selectors
        # (e.g. 10.0.0.0/8, which contains the VIP) are actually tunnelled.
        heal_self_overlap
        return 0
    fi

    if [ "$rc" -eq 1 ]; then
        log "Tunnel half-up detected (IKE up, CHILD_SAs down). Re-initiating..."
        if reinitiate_children; then
            failures=0
        else
            failures=$((failures + 1))
            log "Recovery attempt $failures/$MAX_CONSECUTIVE_FAILURES failed"
            if [ "$failures" -ge "$MAX_CONSECUTIVE_FAILURES" ]; then
                notify-send -u critical -i network-vpn \
                    "VPN Watcher" \
                    "Tunnel kann nicht wiederhergestellt werden. Bitte manuell neu verbinden."
                # Drop state file so the AGS bar shows stale/disconnected
                # instead of falsely reporting connected.
                rm -f "$STATE_FILE"
                failures=0
            fi
        fi
    fi
    # rc=2: nothing to do (user disconnected, or no privileges).
    return 0
}

# Eine einzelne Runde, wie beim Netz-Watchdog nebenan. Damit laesst sich
# von Hand und im Test nachsehen, was der Dienst in dieser Sekunde tut,
# ohne eine Minute auf die naechste Runde zu warten.
if [ "${1:-}" = "--once" ]; then
    watch_once
    exit 0
fi

while true; do
    watch_once
    sleep "$WATCH_INTERVAL"
done
