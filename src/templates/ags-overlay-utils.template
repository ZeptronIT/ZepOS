// neben overlay.ts unter ags/utils/ (generate_config.sh, beide auf
// "$ZEPOS_OUTPUT_ROOT/ags/utils"), darum der Geschwister-Pfad "./kit"
// und nicht "../utils/kit" wie in den Fenstern ausserhalb von utils/.
import { zepSidebar, ZepNavGruppe, ZepNavEintrag } from "./kit"

const CLOSE_ICON = "{{ICON_CLOSE}}"

// Der Abstand zum Schirmrand, und es ist DERSELBE, den die Leiste haelt.
//
// GEMESSEN am 12.08.2026 auf einem Bildschirmabzug des verschachtelten
// Compositors: hier stand die Zahl 20, die Leiste darueber haelt
// {{STYLE_GAPS_OUT}} - an diesem Tag 24. Der Kalender begann bei x=20,
// die Leiste bei x=24, und dieser Versatz von vier Punkten ist auf dem
// Bild zu sehen. Zwei Randzahlen sind ausserdem eine zu viel: die aus
// dem Stilsystem folgt dem Groessenregler, eine getippte nicht.
const EDGE_GAP = {{STYLE_GAPS_OUT}}

// Wie viel vom Schirm ein Fenster hoechstens nimmt, das sich VOR etwas
// anderes stellt.
//
// EINER VON VIER ABDRUECKEN EINER ZAHL, DIE IN src/sizes.py STEHT
//     Dort heisst sie MEASURE_MODAL_SHARE und ist begruendet. Sie ist
//     mit Absicht KEIN Platzhalter - sizes.py sagt warum: "eine Anzahl
//     und keine Laenge ... gelesen wird sie nicht von einer Vorlage,
//     sondern von den Programmen, die ein solches Fenster aufziehen".
//     Dies hier ist eines dieser Programme; die anderen drei sind
//     menu/zepos_menu/window.py,
//     plugins/hyprlaunch/include/hyprlaunch/Config.hpp und
//     plugins/hyprclipx/include/hyprclipx/Config.hpp.
//
//     Am 12.08.2026 waren es noch zwei, und die beiden eigenen
//     Programme daneben kannten die Regel gar nicht: der Starter
//     rechnete gegen den GANZEN Schirm, der Zwischenablageverlauf gegen
//     nichts. tests/src/test_modal_rule.py haelt seither alle vier an
//     EINER Stelle gegen die Groessentabelle - vier einzelne
//     Zusicherungen faenden genau den fuenften Abdruck nicht, den
//     jemand ohne sie hinzufuegt.
//
// WAS SIE HIER BEHEBT, GEMESSEN am 12.08.2026
//     Das Kontrollzentrum meldete sich als 400x580 an und stand als
//     545x1622 auf einem Schirm mit 1080 Zeilen - 645 Punkte davon
//     unter dem Bildrand, darunter eine ganze Abschnittsueberschrift.
//     Der Kalender: angemeldet 420x480, gestanden 472x810.
const MODAL_SHARE = 0.5

// Und senkrecht derselbe Anteil mal 1,5 - NACHGETRAGEN am 01.09.2026.
//
// EIN FAKTOR UND KEIN ZWEITER ANTEIL, UND DAS IST DER PUNKT
//     MODAL_SHARE darueber bleibt 0,5 und bleibt die Zahl, die
//     tests/src/test_modal_rule.py in allen vier Programmen gegen
//     sizes.MEASURE_MODAL_SHARE haelt - auch hier, auch senkrecht: die
//     Rechnung unten lautet `mh * MODAL_SHARE * MODAL_HEIGHT_FACTOR`.
//     Eine zweite Zahl daneben haette die Regel verdoppelt; ein Faktor
//     laesst die Regel eine und macht die Abweichung von ihr sichtbar.
//     Ihre Herleitung und die Tabelle der Schirmhoehen stehen bei
//     MEASURE_MODAL_HEIGHT_FACTOR in src/sizes.py; hier steht nur, was
//     sie tut.
//
// WAS SIE BEHEBT, IN EINER ZAHL
//     Gemeldet: "die vpn ags fenster hoeher das ist zu gequetscht alles".
//     Die Schale wuenscht sich seit jeher 900 Punkte (SHELL_HEIGHT weiter
//     unten) und bekam auf dem 1200er Schirm des Nutzers 600, weil
//     0,5 * 1200 = 600 ist. Mit dem Faktor 1,5 - der Zahl, die der
//     Nutzer selbst genannt hat - bekommt sie ihre 900: der Wunsch und
//     der Deckel treffen sich, statt einander zu ueberschreiben.
//
//     Der harte Platz (`usableH - 2 * EDGE_GAP`) steht unveraendert
//     daneben und bindet auf kleinen Schirmen weiterhin zuerst: hoeher
//     als der Schirm wird damit auch mit diesem Faktor kein Fenster.
const MODAL_HEIGHT_FACTOR = 1.5

// ============================================================================
// DIE TYPEN
// ============================================================================

export interface OverlayWidget {
  window: Astal.Window
  /** `at` ist das Bedienelement, das dieses Fenster aufmacht. */
  show: (at?: OverlayAnchor) => Promise<void>
  hide: () => void
}

// WO EIN AUFKLAPPFENSTER AUFGEHT, UND WARUM DAS SEIT DEM 17.08.2026
// NICHT MEHR DER MAUSZEIGER ENTSCHEIDET
//
//     GEMELDET, woertlich: "die modale fuer kontroll zentrum erscheint
//     ganz links im fenster buggy wir brauchen es aber dort der user mit
//     maus raufklickt".
//
//     GEMESSEN am selben Tag im verschachtelten Compositor, Schirm
//     1920x1200 (der des Nutzers), das Zahnrad rechts aussen bei x=1848
//     mit 48 Punkten Breite, seine Mitte also 1872. Dreimal derselbe
//     Aufruf `ags request control`, nur der Zeiger stand woanders:
//
//         Zeiger 1872 (auf dem Zahnrad)   Fenster x=1401  - richtig
//         Zeiger  960 (Bildmitte)         Fenster x= 713
//         Zeiger  120 (am Datum)          Fenster x=  24  - GANZ LINKS
//
//     Beide Runden je Fall gaben dieselbe Zahl; das zweite Aufgehen war
//     also nicht der Unterschied. Der Unterschied war der ZEIGER: das
//     Fenster ging dort auf, wo die Maus GERADE STAND, und nicht dort,
//     wo das Bedienelement sitzt, das es aufmacht. Die 24 sind EDGE_GAP,
//     also die Klemmung an den linken Bildrand - genau das Bild aus der
//     Meldung.
//
//     Der Zeiger ist nur solange derselbe Punkt wie das Bedienelement,
//     wie ein Mausklick der Ausloeser ist und die Maus sich seither
//     nicht bewegt hat. Er ist es NICHT bei einer Tastenbindung, nicht
//     bei einem Knopf im Kontrollzentrum, der ein anderes Fenster
//     aufmacht, und nicht, wenn die Maus zwischen Klick und Aufgehen
//     wandert.
//
//     Seither sagt der AUSLOESER, wo er sitzt: die Leiste rechnet die
//     Mitte des angeklickten Moduls aus (siehe anchorOf() in
//     ags-bar.template) und reicht sie herein. Der Zeiger bleibt der
//     Rueckfall fuer alles, was kein Bedienelement mit einer Lage hat -
//     dort ist er die richtige Antwort, weil die Maus dann wirklich das
//     Letzte ist, was der Nutzer angefasst hat.
export interface OverlayAnchor {
  /** Der Anschlussname des Schirms, auf dem das Bedienelement sitzt. */
  monitor: string
  /** Seine MITTE, waagerecht, in den Koordinaten DIESES Schirms. */
  x: number
}

// Der Punkt, gegen den gerechnet wird - einer von zweien.
//
// "pointer" traegt Koordinaten des COMPOSITORS und muss deshalb erst
// einem Schirm zugeordnet werden; "widget" nennt den Schirm selbst und
// rechnet in dessen Koordinaten. Beides in EINEM Typ, weil beides
// dieselbe Frage beantwortet und getOverlayPosition() sonst zweimal
// dastuende.
type Spot =
  | { kind: "pointer"; x: number; y: number }
  | { kind: "widget"; monitor: string; x: number }

// Der Punkt, an dem ein Fenster aufgeht.
//
// ER WIRD EINMAL GELESEN UND DANN FESTGEHALTEN, SEIT DEM 17.08.2026
//     getOverlayPosition() fragte `hyprctl cursorpos` bei JEDEM Aufruf
//     selbst - auch in der Nachfuehrung, die nach dem Aufgehen zwei
//     Sekunden lang laeuft. Wer in dieser Zeit die Maus bewegt, zieht
//     das offene Fenster hinter sich her.
//
//     GEMESSEN am 17.08.2026 im verschachtelten Compositor: Klick auf
//     das Zahnrad bei x=1860, Fenster geht bei x=1401 auf, Zeiger
//     danach nach x=300 - 100 ms spaeter steht das Fenster bei x=24,
//     dem linken Bildschirmrand. Genau das hat der Nutzer gemeldet
//     ("beim zweiten klick erscheint das modal links am rand des
//     bildschirms").
//
//     Ein Fenster gehoert dorthin, wo geklickt wurde. Wo der Zeiger
//     eine halbe Sekunde spaeter steht, ist eine andere Frage, und sie
//     wird hier nicht mehr gestellt.
/** Wo der Zeiger JETZT steht - in den Koordinaten des Compositors. */
async function pointerPosition(): Promise<Spot | null> {
  try {
    const result = await execAsync("hyprctl cursorpos -j")
    const cursor = JSON.parse(result)
    return { kind: "pointer", x: cursor.x, y: cursor.y }
  } catch (e) {
    console.error("Der Zeigerstand liess sich nicht lesen:", e)
    return null
  }
}

// Die Lage UND die Groesse. Beides kommt aus derselben Rechnung, weil
// beides denselben Schirm meint; getrennt gerechnet wuerde ein Fenster
// nach der einen Zahl gestellt und nach der anderen gebaut.
//
// marginBottom und marginRight standen bis zum 12.08.2026 hier und
// wurden von NIEMANDEM gelesen - das Fenster haengt an TOP|LEFT, und
// show() setzt genau die beiden. Zwei Felder, die eine Lage behaupten,
// die kein Anker je einnimmt, sind schlimmer als keine.
interface OverlayPosition {
  marginTop: number
  marginLeft: number
  width: number
  height: number
  monitor: number
  monitorName: string
}

// Einen Hyprland-Ausgangsnamen (etwa "DP-7") zu seinem Gdk.Monitor
// aufloesen. Hyprlands Monitorkennungen und die Indizes von GDK sind
// NICHT dieselben, deshalb wird ueber den Anschlussnamen gesucht und
// nicht der Zahl vertraut.
function findGdkMonitorByName(name: string): Gdk.Monitor | null {
  const display = Gdk.Display.get_default()
  if (!display) return null
  const monitors = display.get_monitors()
  for (let i = 0; i < monitors.get_n_items(); i++) {
    const m = monitors.get_item(i) as Gdk.Monitor
    if (m.connector === name) return m
  }
  return null
}

