// Das gemeinsame Handwerkszeug der Aufklappfenster (AGS v3, Astal Layer-Shell)
// Von ZepOS erzeugt
// Enthaelt: createOverlayWindow(), OverlayWidget
//
// ES GIBT GENAU EINEN WEG, EIN AUFKLAPPFENSTER ZU BAUEN, UND DAS IST
// SEIT DEM 12.08.2026 KEINE VERABREDUNG MEHR, SONDERN EINE ZUSICHERUNG
//     getOverlayPosition() war bis dahin exportiert, und genau ein
//     Widget hat davon Gebrauch gemacht: ags-network.template holte sich
//     die Raender und baute sein Astal.Window selbst. Es bekam damit
//     weder den Hoehendeckel noch die Bildlaufleiste, und GEMESSEN im
//     verschachtelten Compositor stand es 721 Punkte hoch da, wo der
//     Deckel 540 sagt.
//
//     Eine Abkuerzung, die exportiert ist, wird genommen. Sie ist
//     deshalb keine mehr: getOverlayPosition() ist modulintern, und wer
//     die Lage eines Fensters braucht, bekommt sie nur mitsamt dem
//     Fenster. Der Buendler faellt um, wenn jemand es wieder
//     importiert - eine Zusicherung, die schon beim Uebersetzen greift,
//     ist die einzige, die niemand vergessen kann.
//
//     tests/src/test_modal_rule.py haelt dieselbe Regel ueber ALLE
//     Vorlagen und nennt jedes selbst gebaute Ueberlagerungsfenster beim
//     Namen.

import Astal from "gi://Astal?version=4.0"
import { Gtk, Gdk } from "ags/gtk4"
import Gio from "gi://Gio"
import { execAsync } from "ags/process"
