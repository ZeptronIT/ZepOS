// WO EIN AUFKLAPPFENSTER HINKOMMT UND WIE GROSS ES WIRD
// ============================================================================

/**
 * Lage und Groesse eines Aufklappfensters, aus dem Anhaltspunkt und dem
 * Schirm.
 *
 * `anchor` ist der Punkt, an dem geklickt wurde - er wird von aussen
 * hereingereicht und hier NICHT nachgeschlagen, damit dieselbe Rechnung
 * beim Aufgehen und beim Nachfuehren dasselbe Ergebnis hat.
 *
 * - waagerecht am Anhaltspunkt zentriert
 * - senkrecht unter der Leiste (deren exklusive Zone den Versatz haelt)
 * - EDGE_GAP Abstand zu jedem Schirmrand, dieselbe Zahl wie die Leiste
 * - die Groesse gedeckelt: auf MODAL_SHARE des Schirms und auf das,
 *   was zwischen den Raendern ueberhaupt Platz hat
 * - die Lage so beschnitten, dass das Fenster ganz auf dem Schirm liegt
 */
async function getOverlayPosition(
  winWidth: number,
  winHeight: number,
  anchor: Spot | null
): Promise<OverlayPosition> {
  try {
    // Ohne Anhaltspunkt gibt es keinen Schirm, auf dem gesucht werden
    // koennte. Dann gilt der Rueckfall unten - auf demselben Weg wie
    // ein hyprctl, das nicht geantwortet hat, denn es ist derselbe Fall.
    if (!anchor) throw new Error("kein Anhaltspunkt")

    const monitorsResult = await execAsync("hyprctl monitors -j")
    const monitors = JSON.parse(monitorsResult) as Array<{
      id: number
      name: string
      x: number
      y: number
      width: number
      height: number
      scale: number
      transform: number
      reserved: number[]
    }>

    for (const mon of monitors) {
      const mx = mon.x
      const my = mon.y
      // Hyprland meldet die Masse der Hardware; die Drehungen 1/3/5/7
      // (90°/270°) vertauschen Breite und Hoehe
      const rotated = (mon.transform & 1) === 1
      const physW = mon.width / mon.scale
      const physH = mon.height / mon.scale
      const mw = rotated ? physH : physW
      const mh = rotated ? physW : physH
      const barHeight = mon.reserved?.[1] || 50

      // IST DIES DER SCHIRM? Zwei Anhaltspunkte, zwei Antworten - und
      // die zweite ist die genauere.
      //
      //   "widget"   Der Ausloeser NENNT seinen Schirm. Das ist der
      //              Anschlussname, den auch die Leiste je Flaeche
      //              benutzt (Bar() in ags-bar.template), also ein
      //              Vergleich und keine Suche.
      //   "pointer"  Nur Koordinaten. Dann muss der Schirm gesucht
      //              werden, auf dem sie liegen.
      const trifft = anchor.kind === "widget"
        ? mon.name === anchor.monitor
        : (anchor.x >= mx && anchor.x < mx + mw &&
           anchor.y >= my && anchor.y < my + mh)

      if (trifft) {

        // Die exklusive Zone der Leiste gilt - nutzbar ist, was darunter
        // liegt.
        const usableW = mw
        const usableH = mh - barHeight

        // Die Groesse, die dieses Fenster WIRKLICH bekommt, aus drei
        // Grenzen, und jede hat einen eigenen Grund:
        //
        //   winWidth/winHeight   was das Widget sich wuenscht. Es bleibt
        //                        eine Bitte und wird nie ueberschritten.
        //   MODAL_SHARE          die Regel des Entwurfssystems: ein
        //                        Fenster, das sich vor die Arbeit
        //                        stellt, nimmt hoechstens die Haelfte
        //                        des Schirms. Gerechnet auf den GANZEN
        //                        Schirm, so wie src/sizes.py es sagt
        //                        ("wie viel vom Schirm") und wie
        //                        menu/zepos_menu/window.py es tut.
        //   MODAL_HEIGHT_FACTOR  dieselbe Regel senkrecht, seit dem
        //                        01.09.2026 mal 1,5: waagerecht war
        //                        Luft, senkrecht war keine. Ein FAKTOR
        //                        auf denselben Anteil und keine zweite
        //                        Zahl daneben - die Regel bleibt eine,
        //                        und die Abweichung von ihr steht als
        //                        eigene, begruendete Zahl da.
        //                        Herleitung bei
        //                        MEASURE_MODAL_HEIGHT_FACTOR in
        //                        src/sizes.py.
        //   usable - 2*EDGE_GAP  der harte Platz. Er bindet erst auf
        //                        kleinen Schirmen, und dann rettet er.
        const effectiveW = Math.min(winWidth, Math.floor(mw * MODAL_SHARE),
                                    usableW - 2 * EDGE_GAP)
        const effectiveH = Math.min(
          winHeight, Math.floor(mh * MODAL_SHARE * MODAL_HEIGHT_FACTOR),
          usableH - 2 * EDGE_GAP)

        // Waagerecht am Anhaltspunkt zentriert, senkrecht ein EDGE_GAP
        // unter der Leiste.
        //
        // Der Zeiger kommt in Koordinaten des COMPOSITORS und muss auf
        // diesen Schirm umgerechnet werden; ein Bedienelement nennt
        // seine Lage schon in dessen Koordinaten - es sitzt IN einer
        // Flaeche, die auf diesem Schirm liegt, und weiss von den
        // Nachbarschirmen nichts.
        const punkt = anchor.kind === "widget" ? anchor.x : anchor.x - mx
        let localX = punkt - effectiveW / 2
        let localY = EDGE_GAP

        // Auf den Schirm beschneiden, Rand eingerechnet
        if (localX < EDGE_GAP) localX = EDGE_GAP
        if (localX + effectiveW > usableW - EDGE_GAP) localX = usableW - effectiveW - EDGE_GAP
        if (localY + effectiveH > usableH - EDGE_GAP) localY = usableH - effectiveH - EDGE_GAP
        if (localY < EDGE_GAP) localY = EDGE_GAP

        return {
          marginTop: Math.round(localY),
          marginLeft: Math.round(localX),
          width: Math.round(effectiveW),
          height: Math.round(effectiveH),
          monitor: mon.id,
          monitorName: mon.name,
        }
      }
    }
  } catch (e) {
    console.error("Die Lage der Ueberlagerung liess sich nicht bestimmen:", e)
  }

  // Der Rueckfall. Er gibt die GEWUENSCHTE Groesse zurueck und keine
  // erfundene: wer den Schirm nicht kennt, kennt auch seinen Deckel
  // nicht, und eine geratene Grenze waere schlimmer als keine.
  return { marginTop: EDGE_GAP, marginLeft: EDGE_GAP,
           width: winWidth, height: winHeight, monitor: 0, monitorName: "" }
}

