#!/bin/bash
# =========================================
# HYPRLAND MONITOR DETECTION SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hypr-monitor-detect-config.template
# =========================================
#
# Reads what is actually attached from the compositor and writes the
# workspace assignments that follow from it.
#
# The origin decided this from the machine's name: two of them selected
# one of two prewritten layouts, one of which named three screens by their
# serial numbers. Every other computer fell through to the fallback.
#
# What is written here are workspace assignments and nothing else.
# Monitor modes live in monitors.conf, which the settings application owns -
# a second writer would fight it over the same setting.
#
# Safety features:
# - The file Hyprland sources is created before anything can fail
# - Never applies a layout in which every monitor is rotated
# - Falls back to all workspaces on the first available monitor
# =========================================

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
OUTPUT_FILE="$HYPR_DIR/workspaces-generated.conf"

# The new version is built beside the file it replaces, not in /tmp, so
# putting it in place is a rename inside one directory: it either happened
# or it did not, and a reload can never read half a layout. It also keeps
# a world-writable directory out of the path of a file Hyprland sources.
TEMP_FILE="$OUTPUT_FILE.new"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Safety first - log everything
LOG_FILE="${TMPDIR:-/tmp}/hypr-monitor-detect-$(date +%Y%m%d-%H%M%S).log"
exec 1> >(tee -a "$LOG_FILE")
exec 2>&1

echo "{{ICON_INFO}} Starting Hyprland Monitor Detection at $(date)"

# The file the Hyprland config sources has to exist before anything else
# can go wrong. A `source =` line with no file behind it is a config
# ERROR, not a skipped line: measured on Hyprland 0.55.4, a config whose
# only content is such a line makes `Hyprland --verify-config` exit 1 with
# "source= globbing error: found no match". A detection that merely did
# not run must not turn into a session that will not parse.
ensure_output_file() {
    mkdir -p "$HYPR_DIR"

    if [ ! -f "$OUTPUT_FILE" ]; then
        {
            echo "# Workspace assignments - generated, DO NOT EDIT"
            echo "# Detection has not produced a layout on this machine yet."
        } > "$OUTPUT_FILE"
    fi
}

# Function to safely get monitor info
get_monitor_info() {
    if ! command -v hyprctl &> /dev/null; then
        echo "{{ICON_ERROR}} Error: hyprctl not found!" >&2
        return 1
    fi

    # Get monitor data with error handling
    local monitor_data=$(hyprctl monitors -j 2>/dev/null || echo "[]")
    if [ "$monitor_data" = "[]" ]; then
        echo "{{ICON_WARNING}} Warning: No monitors detected or Hyprland not running" >&2
        return 1
    fi

    echo "$monitor_data"
}

# All workspaces on the first monitor that can be named.
#
# The crude answer, for when the layout could not be worked out at all. A
# desk with no assignments is worse than one with blunt ones: every
# workspace then opens wherever the focus happens to be.
write_fallback() {
    local monitors=$1
    local first_monitor

    # `// empty` rather than `.[0].name`: jq prints the four letters
    # "null" for a missing key, and `[ -n "null" ]` is true - which used
    # to write `monitor:null` for all ten workspaces and call it a
    # success.
    first_monitor=$(echo "$monitors" | jq -r '[.[] | select(.name != null and .name != "")] | .[0].name // empty' 2>/dev/null)

    if [ -z "$first_monitor" ]; then
        echo "{{ICON_ERROR}} No monitor could be named - nothing to assign"
        return 1
    fi

    {
        echo "# FALLBACK - the layout could not be derived"
        echo "# All workspaces on the first available monitor"
        echo ""
        for i in {1..10}; do
            echo "workspace=$i,monitor:$first_monitor"
        done
    } >> "$TEMP_FILE"
}

# Function to create workspace configuration
create_workspace_config() {
    local monitors
    monitors=$(get_monitor_info) || return 1

    local total_monitors=$(echo "$monitors" | jq '. | length' 2>/dev/null || echo "0")
    local rotated_monitors=$(echo "$monitors" | jq '[.[] | select(.transform != 0 and .transform != null)] | length' 2>/dev/null || echo "0")

    echo "{{ICON_MONITOR}} Monitor Summary:"
    echo "  - Total monitors: $total_monitors"
    echo "  - Rotated monitors: $rotated_monitors"

    echo "{{ICON_WRITE}} Creating workspace assignments"

    cat > "$TEMP_FILE" << 'EOF'
# =========================================
# GENERATED WORKSPACE ASSIGNMENTS
# Created by hypr-monitor-detect.sh
# DO NOT EDIT - This file is auto-generated
#
# Sourced after workspaces.conf, so what is attached right now refines
# the layout the active profile brought with it.
# =========================================

EOF

    # The layout itself comes from the command, so that the rule which
    # decides it exists once rather than once per artifact that needs it.
    # It writes nothing at all when it fails, so the fallback below always
    # starts from the header and never from half a layout.
    #
    # zepos-generate rather than the module behind it: the command is what
    # the package installs into /usr/bin, and it is the one name that
    # stays the same whether the modules came from the package or from a
    # checkout. A script in ~/.config/hypr cannot work out which of the
    # two it came from, and it no longer has to.
    if zepos-generate --monitors >> "$TEMP_FILE"; then
        echo "{{ICON_SUCCESS}} Layout derived from the attached monitors"
    else
        echo -e "${YELLOW}{{ICON_WARNING}} Could not derive a layout - using the fallback${NC}"
        if ! write_fallback "$monitors"; then
            rm -f "$TEMP_FILE"
            return 1
        fi
    fi

    # Add footer with recovery information
    cat >> "$TEMP_FILE" << EOF

# =========================================
# EMERGENCY RECOVERY
# If this layout causes problems:
# 1. Press Ctrl+Alt+F2 to switch to TTY2
# 2. Empty this file:  echo '# disabled' > $OUTPUT_FILE
#    Do NOT delete it - the Hyprland config sources it, and a source=
#    line with no file behind it is a config error.
# 3. Run: hyprctl reload
# =========================================
# Generated at: $(date)
# Log file: $LOG_FILE
# =========================================
EOF

    if [ ! -s "$TEMP_FILE" ]; then
        echo "{{ICON_ERROR}} Failed to create configuration"
        rm -f "$TEMP_FILE"
        return 1
    fi

    # Checked BEFORE it is put in place, not after. The origin moved the
    # file into position first and then reported "configuration not
    # applied" when the check failed - over a file that was already live.
    if ! test_config_safety "$TEMP_FILE"; then
        echo -e "${RED}{{ICON_ERROR}} Safety check failed - configuration not applied${NC}"
        rm -f "$TEMP_FILE"
        return 1
    fi

    mv "$TEMP_FILE" "$OUTPUT_FILE"
    echo "{{ICON_SUCCESS}} Workspace configuration created successfully"
    echo "{{ICON_INFO}} Configuration saved to: $OUTPUT_FILE"
    return 0
}

# Function to test configuration safety
test_config_safety() {
    local config_file=$1

    echo "{{ICON_CHECK}} Testing configuration safety..."

    # Check if at least one monitor has no rotation
    local monitors=$(get_monitor_info)
    local non_rotated=$(echo "$monitors" | jq '[.[] | select(.transform == 0 or .transform == null)] | length')

    if [ "$non_rotated" -eq "0" ]; then
        echo -e "${RED}{{ICON_ERROR}} SAFETY CHECK FAILED: All monitors are rotated!${NC}"
        echo -e "${RED}This could leave you without display access!${NC}"
        return 1
    fi

    # Check if configuration file exists and is readable
    if [ ! -r "$config_file" ]; then
        echo -e "${RED}{{ICON_ERROR}} SAFETY CHECK FAILED: Cannot read configuration file${NC}"
        return 1
    fi

    echo -e "${GREEN}{{ICON_SUCCESS}} Safety checks passed${NC}"
    return 0
}

# Main execution
main() {
    echo "{{ICON_START}} Hyprland Monitor Detection Started"
    echo "========================================="

    ensure_output_file

    if create_workspace_config; then
        echo -e "${GREEN}{{ICON_SUCCESS}} Configuration complete!${NC}"
        echo "{{ICON_INFO}} Please reload Hyprland to apply changes"
        echo "{{ICON_TIP}} Run: hyprctl reload"
    else
        echo -e "${RED}{{ICON_ERROR}} Failed to create workspace assignments${NC}"
        echo "{{ICON_INFO}} Log saved to: $LOG_FILE"
        exit 1
    fi

    echo "{{ICON_INFO}} Log saved to: $LOG_FILE"
}

# Run main function
main "$@"
