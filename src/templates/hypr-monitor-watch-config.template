#!/usr/bin/env python3
# =========================================
# MONITOR HOTPLUG WATCHER
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hypr-monitor-watch-config.template
# =========================================
#
# Re-derives everything that follows from "which screens are attached"
# whenever a screen is plugged in or unplugged.
#
# WHAT WAS REPORTED (04.09.2026), VERBATIM
#     "bei anschliessen eines weiteren bildschirm wird der background
#      schwarz und wenn ich verusche allgemein ags sachen dort zu machen
#      erscheinen die fenster nur auf der edp also dem laptop monitor und
#      sie werdne nicht als getrennte instanzen behandelt"
#
# ONE CAUSE, THREE SYMPTOMS
#     Three artefacts are derived from the attached screens, and until
#     04.09.2026 all three were `exec-once` in the Hyprland config - they
#     ran exactly once, at login:
#
#         swaybg per output          wallpaper-manager restore
#         hypr/workspaces-           hypr-monitor-detect.sh
#         generated.conf             (Hyprland sources it)
#         ags/workspaces.json        bar-workspace-detect.sh
#
#     A screen attached later therefore got no swaybg - it shows the
#     compositor's black - and no workspace of its own, so every
#     workspace stayed on the first screen and anything opened on the new
#     one jumped back. That second half is what "the windows only appear
#     on the eDP" is: it is about workspaces, not windows.
#
#     What did follow a screen were the shell's own layer surfaces
#     (jeSchirm() in ags-kit.template, since 0.1.13, measured in
#     tests/render/test_mehrschirm.py). That is exactly why the user saw
#     the bar appear on the new screen and an unusable screen anyway.
#
# WHY A SEPARATE PROCESS AND NOT THE SHELL
#     AGS already holds a connection to this very socket. It is still the
#     wrong place: the workspace assignment and the wallpaper must not
#     depend on the shell being up, and the shell is restarted by every
#     generation run. A screen change during that window would be lost.
#
# WHY PYTHON AND NOT BASH
#     Reading a unix socket from bash needs `nc -U`, and netcat is not
#     otherwise a dependency of this system. socket.AF_UNIX costs
#     nothing, and python3 is already required by everything here.
#
# WHY IT REACTS TO THE SET OF SCREENS AND NOT TO THE EVENT
#     `hyprctl reload` re-reads monitors.conf, and re-applying a monitor
#     mode can itself emit monitoradded/monitorremoved. An event-driven
#     loop would then feed itself: reload -> event -> reload. So the
#     event is only a reason to LOOK; the chain runs when the set of
#     connector names has actually changed since the last run. A reload
#     that re-adds the same screens changes nothing and stops there.
# =========================================
import json
import os
import select
import socket
import subprocess
import sys
import time
from pathlib import Path

# How long to gather events before looking. One plug emits several lines
# (monitoradded, monitoraddedv2, and the workspace moves that follow),
# and a dock emits several screens' worth. Without this the chain would
# run three or four times per plug and kill swaybg mid-start each time.
ENTPRELLUNG = 0.6

# The chain kills and restarts swaybg. If reading the compositor fails,
# waiting is better than acting on nothing.
GEDULD = 2.0


def _heim() -> Path:
    return Path(os.environ.get("HOME", str(Path.home())))


def _konfig() -> Path:
    gesetzt = os.environ.get("XDG_CONFIG_HOME")
    return Path(gesetzt) if gesetzt else _heim() / ".config"


def _protokoll_datei() -> Path:
    """Wohin die Meldungen gehen.

    In das Laufzeitverzeichnis, weil es je Anmeldung neu ist: ein
    Protokoll, das eine Sitzung ueberlebt, waechst und wird nie gelesen.
    """
    laufzeit = os.environ.get("XDG_RUNTIME_DIR")
    wurzel = Path(laufzeit) if laufzeit else Path(
        os.environ.get("TMPDIR", "/tmp"))
    return wurzel / "zepos-monitor-watch.log"


PROTOKOLL = _protokoll_datei()


def melde(text: str) -> None:
    """Nach stdout UND in die Datei.

    Beides, weil die exec-once-Zeile stdout wegwerfen darf und weil ein
    Messstand ihn liest.
    """
    zeile = f"{time.strftime('%H:%M:%S')} {text}"
    print(zeile, flush=True)
    try:
        with PROTOKOLL.open("a", encoding="utf-8") as datei:
            datei.write(zeile + "\n")
    except OSError:
        pass          # ein fehlendes Protokoll ist kein Grund aufzuhoeren


def socket_pfad() -> Path | None:
    """Der Ereignisstrom des Compositors.

    Zwei Orte und nicht einer, aus demselben Grund wie in
    ags-hyprland.template: bis Hyprland 0.40 lag er unter /tmp/hypr/$HIS,
    seither unter $XDG_RUNTIME_DIR/hypr/$HIS.
    """
    signatur = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not signatur:
        melde("{{ICON_ERROR}} HYPRLAND_INSTANCE_SIGNATURE fehlt - ohne sie "
              "gibt es keinen Ereignisstrom")
        return None
    laufzeit = os.environ.get("XDG_RUNTIME_DIR")
    kandidaten = []
    if laufzeit:
        kandidaten.append(Path(laufzeit) / "hypr" / signatur / ".socket2.sock")
    kandidaten.append(Path("/tmp/hypr") / signatur / ".socket2.sock")
    for pfad in kandidaten:
        if pfad.exists():
            return pfad
    melde(f"{{ICON_ERROR}} kein .socket2.sock an "
          f"{', '.join(str(pfad) for pfad in kandidaten)}")
    return None


def schirme() -> set[str] | None:
    """Die Anschlussnamen der angesteckten Schirme, oder None.

    None heisst "nicht zu erfahren" und ist ausdruecklich NICHT die leere
    Menge: ein hyprctl, das nicht antwortet, wuerde sonst wie ein Rechner
    ohne Bildschirm aussehen und die Kette bei jedem Ereignis ausloesen.
    """
    try:
        fertig = subprocess.run(
            ["hyprctl", "monitors", "-j"],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as fehler:
        melde(f"{{ICON_ERROR}} hyprctl monitors: {fehler}")
        return None
    if fertig.returncode != 0:
        melde(f"{{ICON_ERROR}} hyprctl monitors endete mit "
              f"{fertig.returncode}: {fertig.stderr.strip()[:200]}")
        return None
    try:
        daten = json.loads(fertig.stdout)
    except ValueError as fehler:
        melde(f"{{ICON_ERROR}} hyprctl monitors antwortete kein JSON: "
              f"{fehler}")
        return None
    return {eintrag.get("name", "") for eintrag in daten if eintrag.get("name")}


def fuehre(name: str, befehl: list[str]) -> None:
    """Einen Schritt der Kette. Ein Fehlschlag nimmt die anderen nicht mit.

    Jeder Schritt steht fuer sich: eine Tapete, die sich nicht setzen
    laesst, darf die Arbeitsflaechen nicht kosten, und umgekehrt. Der
    Grund steht im Protokoll, weil ein stiller Fehlschlag hier
    ununterscheidbar von "es gibt nichts zu tun" waere.

    KEINE ROEHRE, SONDERN DAS PROTOKOLL - UND DAS IST GEMESSEN
        Hier stand `capture_output=True`. Der Lauf blieb daraufhin 120
        Sekunden an `wallpaper-manager restore` haengen und endete im
        Zeitablauf (tests/render/test_schirm_nachziehen.py, 04.09.2026).

        Der Grund ist nicht die Tapete, sondern die Roehre: `restore`
        startet swaybg mit `&` und `disown`, das Kind ERBT die Roehre,
        und `capture_output` liest bis zum Dateiende. Das kommt erst,
        wenn auch das letzte Kind sie schliesst - also nie, denn swaybg
        ist ein Dienst.

        Eine echte Datei hat dieses Ende nicht: subprocess wartet dann
        nur noch darauf, dass der Befehl SELBST endet. Dass swaybg sie
        offen behaelt, stoert niemanden - im Gegenteil, seine Klagen
        landen dort, wo sie hingehoeren.
    """
    try:
        senke = PROTOKOLL.open("a", encoding="utf-8")
    except OSError:
        senke = None
    try:
        fertig = subprocess.run(
            befehl, stdin=subprocess.DEVNULL,
            stdout=senke or subprocess.DEVNULL,
            stderr=subprocess.STDOUT if senke else subprocess.DEVNULL,
            timeout=120)
    except (OSError, subprocess.SubprocessError) as fehler:
        melde(f"{{ICON_ERROR}} {name}: {fehler}")
        return
    finally:
        if senke:
            senke.close()
    if fertig.returncode != 0:
        melde(f"{{ICON_ERROR}} {name} endete mit {fertig.returncode} - was "
              f"es gesagt hat, steht darueber in diesem Protokoll")
        return
    melde(f"{{ICON_SUCCESS}} {name}")


def kette() -> None:
    """Die vier Schritte, in dieser Reihenfolge - und die ist begruendet.

    ZUERST DIE ZUORDNUNG, DANN DAS NEULESEN: hypr-monitor-detect.sh
    schreibt workspaces-generated.conf, und Hyprland sourct sie. Ein
    reload davor las die alte Datei.

    DIE LEISTE NACH DEM NEULESEN, weil sie die Aufteilung anzeigt, die
    der Compositor wirklich hat - nicht die, die auf der Platte steht.

    DIE TAPETE ZULETZT, weil sie die langsamste ist: `restore` faengt mit
    einem eigenen `sleep 1` an, und die Arbeitsflaechen sollen nicht
    darauf warten.
    """
    konfig = _konfig()
    fuehre("Arbeitsflaechen-Zuordnung",
           ["bash", str(konfig / "hypr" / "hypr-monitor-detect.sh")])
    fuehre("Hyprland neu einlesen", ["hyprctl", "reload"])
    fuehre("Arbeitsflaechen der Leiste",
           ["bash", str(konfig / "ags" / "bar-workspace-detect.sh")])
    fuehre("Tapete",
           [str(_heim() / ".local" / "bin" / "wallpaper-manager"), "restore"])


# Die Ereignisse, die ein Nachsehen wert sind. Die v2-Formen stehen
# daneben, weil Hyprland beide sendet und eine Fassung ohne die alten
# auf einem aelteren Compositor stumm bliebe.
ANLAESSE = ("monitoradded", "monitoraddedv2",
            "monitorremoved", "monitorremovedv2")


def main() -> int:
    pfad = socket_pfad()
    if not pfad:
        return 1

    bekannt = schirme()
    melde(f"{{ICON_INFO}} Waechter steht an {pfad} - "
          f"Schirme: {', '.join(sorted(bekannt)) if bekannt else 'unbekannt'}")

    try:
        strom = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        strom.connect(str(pfad))
    except OSError as fehler:
        melde(f"{{ICON_ERROR}} {pfad} liess sich nicht verbinden: {fehler}")
        return 1

    # EIN EIGENER PUFFER UND KEIN makefile() - UND DAS IST GEMESSEN
    #
    #     Hier stand `strom.makefile("rb")` mit `readline()`, und fuer
    #     das Entprellen `settimeout(ENTPRELLUNG)` und danach wieder
    #     `settimeout(None)`. Der Waechter starb beim ERSTEN
    #     Schirmwechsel (tests/render/test_schirm_nachziehen.py,
    #     04.09.2026):
    #
    #         OSError: cannot read from timed out object
    #
    #     Ein Socket-Dateiobjekt vertraegt keine Zeitgrenze am Socket
    #     darunter: nach einem settimeout() ist es unbrauchbar, auch
    #     wenn die Grenze danach wieder aufgehoben wird. Der Prozess war
    #     damit nach dem ersten Kabel weg - und das zweite Kabel des
    #     Tages waere wieder schwarz geblieben.
    #
    #     Mit einem eigenen Puffer bleibt der Socket die ganze Zeit
    #     blockierend, und das Entprellen laeuft ueber select() mit
    #     einer Frist. Nichts davon aendert den Zustand des Sockets.
    with strom:
        puffer = b""
        while True:
            while b"\n" not in puffer:
                try:
                    stueck = strom.recv(4096)
                except OSError as fehler:
                    melde(f"{{ICON_ERROR}} der Ereignisstrom brach ab: {fehler}")
                    return 1
                if not stueck:
                    # Der Compositor ist gegangen. Dann ist die Sitzung
                    # vorbei, und ein Waechter ohne Compositor hat nichts
                    # zu bewachen.
                    melde(f"{{ICON_INFO}} der Ereignisstrom ist zu Ende - Schluss")
                    return 0
                puffer += stueck
            zeile, puffer = puffer.split(b"\n", 1)
            name = zeile.decode("utf-8", "replace").split(">>", 1)[0].strip()
            if name not in ANLAESSE:
                continue

            # ENTPRELLEN: alles wegraeumen, was in derselben Regung noch
            # nachkommt. Ohne das lief die Kette je Anstecken mehrfach
            # und riss swaybg mitten im Starten wieder ab.
            #
            # DASS DABEI EREIGNISSE WEGGEWORFEN WERDEN, IST KEIN VERLUST:
            # entschieden wird gleich darunter an der MENGE der Schirme,
            # nicht an den Ereignissen. Was ein verworfenes Ereignis
            # gemeldet haette, steht in dieser Menge ohnehin.
            frist = time.monotonic() + ENTPRELLUNG
            while True:
                bleibt = frist - time.monotonic()
                if bleibt <= 0:
                    break
                try:
                    lesbar, _, _ = select.select([strom], [], [], bleibt)
                    if not lesbar:
                        break
                    if not strom.recv(65536):
                        break        # der Compositor ist gegangen
                except OSError:
                    break
            puffer = b""

            jetzt = schirme()
            if jetzt is None:
                time.sleep(GEDULD)
                continue
            if jetzt == bekannt:
                # Genau der Fall, den `hyprctl reload` selbst ausloest.
                melde(f"{{ICON_INFO}} {name}, aber dieselben Schirme "
                      f"({', '.join(sorted(jetzt)) or 'keine'}) - nichts zu tun")
                continue

            gekommen = sorted(jetzt - bekannt)
            gegangen = sorted(bekannt - jetzt) if bekannt else []
            melde(f"{{ICON_INFO}} Schirmwechsel: "
                  f"+{gekommen or '-'} -{gegangen or '-'}")
            bekannt = jetzt
            kette()


if __name__ == "__main__":
    sys.exit(main())
