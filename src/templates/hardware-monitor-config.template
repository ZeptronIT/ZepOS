#!/usr/bin/env python3
"""
Hardware Monitoring Module for the bar
Generated by ZepOS - DO NOT EDIT DIRECTLY!

Reads a liquid cooler through liquidctl, the GPU through nvidia-smi and
the RGB device count through openrgb, and reports whatever those three
say is there.

NO DEVICE IS NAMED IN THIS FILE. The origin printed one cooler's product
designation and one graphics card's into the tooltip, beside readings
taken from the machine this actually runs on. A user with a different
cooler therefore saw their own liquid temperature under somebody else's
product name, which is worse than an unlabelled reading: an unlabelled
number is merely terse, a wrongly labelled one is false. Both tools
report the device's own name; that name is used when it comes, and
nothing is claimed when it does not.
"""
import json
import subprocess
import os
import time


def _cache_file():
    """Where the readings are cached, per user.

    A fixed path in /tmp is ONE file for every account on the machine.
    The first user to run this owns it, everybody else's write fails -
    silently, through the `except: pass` in save_cache - so their bar
    re-runs liquidctl and nvidia-smi on every single refresh, and reads
    the first user's temperatures in the meantime. XDG_RUNTIME_DIR is
    per-user and 0700 by definition; TMPDIR covers a session that has
    none.
    """
    base = (os.environ.get("XDG_RUNTIME_DIR")
            or os.environ.get("TMPDIR") or "/tmp")
    return os.path.join(base, "zepos-hardware-cache.json")


CACHE_FILE = _cache_file()
CACHE_TTL_FAST = 10   # seconds — cooler/gpu (temperatures must stay fresh)
CACHE_TTL_SLOW = 300  # seconds — rgb device list (rarely changes, avoids usbfs spam)

def run_command(cmd, timeout=2):
    """Run command and return output"""
    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
            shell=isinstance(cmd, str)
        )
        return result.stdout.strip() if result.returncode == 0 else None
    except:
        return None

def load_cache():
    """Load cache file unconditionally; per-key freshness is checked in main()."""
    try:
        if os.path.exists(CACHE_FILE):
            with open(CACHE_FILE, 'r') as f:
                return json.load(f)
    except:
        pass
    return {}

def is_fresh(cache, key, ttl):
    """True if cache[key] exists and its timestamp is within ttl seconds."""
    return key in cache and (time.time() - cache.get(f'_ts_{key}', 0)) < ttl

def save_cache(data):
    """Save data to cache"""
    try:
        with open(CACHE_FILE, 'w') as f:
            json.dump(data, f)
    except:
        pass


# =====================================================================
# WAS JEDE MASCHINE HAT - Last, Speicher, Temperatur
# =====================================================================
#
# GEMELDET am 13.08.2026: "im header sollte btop dargestellt werden wie
# am anfang auch" - und, zum selben Modul: es habe "No HW" gezeigt.
#
# GEMESSEN am selben Tag auf dem Notebook des Nutzers, mit dem erzeugten
# Skript: `{"text": "󰘚 No HW", ... "class": "hardware-offline"}`.
# Das ist kein Fehler des Skripts gewesen, sondern seine Bauart: es
# fragte AUSSCHLIESSLICH nach einer Wasserkuehlung (liquidctl), einer
# eigenstaendigen Grafikkarte (nvidia-smi) und RGB-Geraeten (openrgb).
# Ein Notebook hat keines der drei. Das Modul konnte auf einem Notebook
# also gar nichts anderes sagen als "No HW" - dauerhaft, und dazu in der
# Klasse hardware-offline, also als Warnung gefaerbt. Ein Modul, das
# immer warnt, ist genau so kaputt wie eines, das immer leer ist.
#
# Die drei Werte hier kommen dagegen aus /proc und /sys, also aus dem
# Kern. Sie brauchen kein Paket, keinen Dienst und kein Recht - und sie
# sind zugleich die drei, die btop oben in seine Kopfzeile schreibt.
#
# DIE WURZELN SIND VARIABEL, aus demselben Grund wie
# ZEPOS_POWER_SUPPLY_ROOT in bar-status-config.template: `[ -r /proc ]`
# beantwortet der Kern selbst, und ohne diese beiden Namen haenge jede
# Zusicherung darueber daran, was die Maschine gerade tut, auf der die
# Suite laeuft.
PROC_ROOT = os.environ.get("ZEPOS_PROC_ROOT", "/proc")
HWMON_ROOT = os.environ.get("ZEPOS_HWMON_ROOT", "/sys/class/hwmon")


def _read_text(path):
    """Eine Datei aus /proc oder /sys, oder None."""
    try:
        with open(path, 'r') as handle:
            return handle.read()
    except OSError:
        return None


def _cpu_sample():
    """(untaetig, gesamt) aus der ersten Zeile von /proc/stat, oder None.

    Die Zeile zaehlt Zeitscheiben SEIT DEM START, nicht die Auslastung.
    Eine Momentaufnahme sagt deshalb nichts; erst der Unterschied
    zwischen zwei Aufnahmen ist eine Last.
    """
    text = _read_text(os.path.join(PROC_ROOT, "stat"))
    if not text:
        return None
    for line in text.splitlines():
        if not line.startswith("cpu "):
            continue
        try:
            fields = [int(value) for value in line.split()[1:]]
        except ValueError:
            return None
        if len(fields) < 4:
            return None
        # Feld 3 ist idle, Feld 4 iowait - beides Zeit, in der nichts
        # gerechnet wurde. Die Reihenfolge steht in proc(5).
        idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
        return idle, sum(fields)
    return None


def get_cpu_load(previous):
    """Die Prozessorlast in Prozent, oder None.

    `previous` ist die Aufnahme des letzten Laufs aus dem Zwischenspeicher.
    Gibt es sie nicht - der erste Lauf nach dem Anmelden -, wird 100 ms
    gewartet und selbst ein zweites Mal gelesen. EINMAL, und nicht bei
    jedem Takt: das Modul laeuft alle drei Sekunden, und eine Zehntel
    Sekunde Schlaf je Takt waere ein Dreissigstel eines Prozessorkerns,
    dauerhaft, fuer eine Zahl, die auch aus dem Unterschied zweier
    Takte kommt.

    Zurueck kommt AUSSERDEM die neue Aufnahme, damit der Aufrufer sie
    ablegen kann - sonst muesste diese Funktion den Zwischenspeicher
    kennen, und dann haette sie zwei Aufgaben.
    """
    current = _cpu_sample()
    if current is None:
        return None, None
    if previous is None or len(previous) != 2:
        time.sleep(0.1)
        older, current = current, _cpu_sample()
        if current is None:
            return None, None
        previous = older

    idle_delta = current[0] - previous[0]
    total_delta = current[1] - previous[1]
    # Kein Fortschritt: zwei Aufnahmen aus derselben Zeitscheibe, oder
    # ein Zaehler, der uebergelaufen ist. Beides ist keine Last von 0 %,
    # sondern keine Messung.
    if total_delta <= 0 or idle_delta < 0:
        return None, current
    busy = 100.0 * (total_delta - idle_delta) / total_delta
    return max(0, min(100, int(busy + 0.5))), current


def get_memory_use():
    """Der belegte Arbeitsspeicher in Prozent, oder None.

    Ueber MemAvailable und nicht ueber MemFree: Linux benutzt jeden
    freien Block als Zwischenspeicher, MemFree ist auf einer Maschine,
    die laeuft, deshalb immer klein und sagt nichts. MemAvailable ist die
    Schaetzung des Kerns, wie viel eine neue Anwendung wirklich bekaeme -
    dieselbe Zahl, aus der auch btop seinen Balken zeichnet.
    """
    text = _read_text(os.path.join(PROC_ROOT, "meminfo"))
    if not text:
        return None
    values = {}
    for line in text.splitlines():
        name, _, rest = line.partition(":")
        if name in ("MemTotal", "MemAvailable"):
            try:
                values[name] = int(rest.split()[0])
            except (IndexError, ValueError):
                return None
    total = values.get("MemTotal")
    available = values.get("MemAvailable")
    if not total or available is None:
        return None
    used = max(0, total - available)
    return max(0, min(100, int(100.0 * used / total + 0.5)))


# Die hwmon-Treiber, die eine PROZESSOR-Temperatur melden, in der
# Reihenfolge, in der ihnen zu glauben ist:
#
#   coretemp    Intel, je Kern und als Paket. Der Treiber sitzt am
#               Sensor im Chip selbst.
#   k10temp     AMD, seit Family 10h. Dasselbe.
#   zenpower    ein Ersatz fuer k10temp aus dem AUR, auf Zen genauer.
#   cpu_thermal ARM (Raspberry Pi und Verwandte).
#   acpitz      ZULETZT, und mit Absicht: das ist die ACPI-Thermalzone,
#               also die Temperatur, die das BIOS meldet - oft die des
#               Gehaeuses und nicht die des Prozessors. Sie ist besser
#               als nichts und schlechter als jede der vier darueber.
CPU_SENSORS = ("coretemp", "k10temp", "zenpower", "cpu_thermal", "acpitz")


def get_cpu_temperature():
    """Die Prozessortemperatur in Grad Celsius, oder None."""
    found = {}
    try:
        entries = sorted(os.listdir(HWMON_ROOT))
    except OSError:
        return None
    for entry in entries:
        directory = os.path.join(HWMON_ROOT, entry)
        name = _read_text(os.path.join(directory, "name"))
        if not name:
            continue
        name = name.strip()
        if name not in CPU_SENSORS or name in found:
            continue
        # temp1_input ist bei coretemp das Paket und bei den uebrigen der
        # einzige Wert. In Tausendstel Grad, siehe
        # Documentation/hwmon/sysfs-interface.
        raw = _read_text(os.path.join(directory, "temp1_input"))
        if raw is None:
            continue
        try:
            found[name] = int(raw.strip()) / 1000.0
        except ValueError:
            continue
    for name in CPU_SENSORS:
        if name in found:
            return int(found[name] + 0.5)
    return None

# The characters liquidctl draws its readings with. A line that starts
# with one of them is a reading; a line that does not is the heading
# naming the device those readings belong to. Kept as data because the
# heading is the ONLY place the device's name exists.
TREE_MARKERS = ('├', '└', '│', '|', '`')

def get_cooler_status():
    """The first device liquidctl reports, named by liquidctl.

    Only the first block is read. The previous version appended the fan
    speeds of EVERY device liquidctl found to one list and printed the
    lot under one heading, so on a machine with a cooler and a separate
    fan controller the second device's fans were reported as the first
    device's.

    A reading is recognised by what it says, a heading by exclusion.
    The other way round - heading recognised by the absence of a tree
    character - breaks on any liquidctl that draws its output
    differently, and it breaks by reporting every line as a device name.
    """
    output = run_command(['liquidctl', 'status'])
    if not output:
        return None

    data = {"name": "", "temp": "N/A", "pump": "N/A", "fans": []}

    for line in output.split('\n'):
        stripped = line.strip()
        if not stripped:
            continue
        if 'Liquid temperature' in stripped:
            try:
                # Parse: "├── Liquid temperature        29.7  °C"
                for part in stripped.split():
                    try:
                        # Try to convert to float, if successful it's the temperature
                        data["temp"] = str(float(part))
                        break
                    except ValueError:
                        continue
            except:
                pass
        elif 'Pump speed' in stripped:
            # Parse: "└── Pump speed                2130  rpm"
            speeds = [part for part in stripped.split() if part.isdigit()]
            if speeds:
                data["pump"] = speeds[-1]
        elif 'Fan' in stripped and 'speed' in stripped:
            # Parse: "├── Fan 1 speed                634  rpm"
            #
            # The LAST whole number on the line, not the first. liquidctl
            # NUMBERS its fans, so the first one is the fan's index: the
            # previous version reported that as the speed, and every
            # machine with three fans showed "Fans: 1, 2, 3 RPM" - three
            # numbers that were never speeds and that nobody could tell
            # from very slow fans. The unit follows the value rather than
            # preceding it, so the last number is always the reading.
            speeds = [part for part in stripped.split() if part.isdigit()]
            if speeds:
                data["fans"].append(speeds[-1])
        elif not stripped.startswith(TREE_MARKERS):
            if data["name"]:
                # A second device begins here; its readings are not this
                # one's and must not be labelled with this one's name.
                break
            data["name"] = stripped

    return data

def get_gpu_status():
    """GPU readings, and the name the driver gives the card.

    `name` is queried LAST and rejoined from everything after the six
    numeric fields. nvidia-smi separates csv fields with ", " and a
    product name is the one field that could contain that sequence; put
    first, a single comma in it would shift every reading one place.
    """
    cmd = [
        'nvidia-smi',
        '--query-gpu=temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw,fan.speed,name',
        '--format=csv,noheader,nounits'
    ]
    output = run_command(cmd)
    if not output:
        return None

    try:
        values = output.split(', ')
        return {
            "temp": values[0],
            "util": values[1],
            "mem_used": values[2],
            "mem_total": values[3],
            "power": values[4],
            "fan": values[5],
            "name": ', '.join(values[6:]).strip()
        }
    except:
        return None

def get_rgb_devices():
    """Count OpenRGB devices"""
    output = run_command(['openrgb', '--list-devices'])
    if not output:
        return 0
    
    count = 0
    for line in output.split('\n'):
        if 'Device' in line and ':' in line:
            count += 1
    
    return count

def main():
    # Load cache (always — freshness gates the actual command execution below)
    cache = load_cache()
    now = time.time()
    new_cache = dict(cache)

    # Cooler: 10s TTL — temperature needs to stay current
    if is_fresh(cache, 'cooler', CACHE_TTL_FAST):
        cooler = cache['cooler']
    else:
        cooler = get_cooler_status()
        if cooler:
            new_cache['cooler'] = cooler
            new_cache['_ts_cooler'] = now
        elif 'cooler' in cache:
            cooler = cache['cooler']

    # GPU: 10s TTL — temperature needs to stay current
    if is_fresh(cache, 'gpu', CACHE_TTL_FAST):
        gpu = cache['gpu']
    else:
        gpu = get_gpu_status()
        if gpu:
            new_cache['gpu'] = gpu
            new_cache['_ts_gpu'] = now
        elif 'gpu' in cache:
            gpu = cache['gpu']

    # RGB: 300s TTL — device list is static; avoids usbfs claim-warning spam
    if is_fresh(cache, 'rgb_count', CACHE_TTL_SLOW):
        rgb_count = cache['rgb_count']
    else:
        rgb_count = get_rgb_devices()
        if rgb_count > 0:
            new_cache['rgb_count'] = rgb_count
            new_cache['_ts_rgb_count'] = now
        elif 'rgb_count' in cache:
            rgb_count = cache['rgb_count']

    # Prozessor, Speicher und Temperatur. Kein TTL: sie kosten drei
    # Dateien aus /proc und /sys, also weniger als das Nachschlagen im
    # Zwischenspeicher - und eine Last, die zehn Sekunden alt ist, ist
    # keine Last mehr. Abgelegt wird nur die STAT-Aufnahme, weil die
    # naechste Last der Unterschied zu ihr ist.
    cpu_load, cpu_sample = get_cpu_load(cache.get('cpu_sample'))
    if cpu_sample is not None:
        new_cache['cpu_sample'] = list(cpu_sample)
        new_cache['_ts_cpu_sample'] = now
    memory = get_memory_use()
    cpu_temp = get_cpu_temperature()

    save_cache(new_cache)

    # Build output text
    text_parts = []
    tooltip_lines = ["{{ICON_SERVER_RACK}} Hardware Monitor"]

    # ZUERST, was jede Maschine hat - siehe den Abschnitt oben. Die
    # beiden Prozentzahlen stehen AUF der Leiste, die Temperatur nur im
    # Kurzhinweis: sie ist die Zahl, die man selten liest, und ihr
    # Zustand steht ohnehin in der Farbe des Moduls. Die Leiste hat auf
    # 1366 px keinen Platz fuer eine dritte Zahl, die immer dasselbe
    # sagt - was sie hat, misst tests/src/test_bar_headless.py.
    if cpu_load is not None:
        text_parts.append(f"{{ICON_CPU}} {cpu_load}%")
        tooltip_lines.append(f"\n{{ICON_CPU}} Prozessor: {cpu_load}%")
    if cpu_temp is not None:
        tooltip_lines.append(f"{{ICON_TEMP}} Temperatur: {cpu_temp}°C")
    if memory is not None:
        text_parts.append(f"{{ICON_RAM}} {memory}%")
        tooltip_lines.append(f"{{ICON_RAM}} Arbeitsspeicher: {memory}% belegt")

    # Liquid cooler, under the name liquidctl gave it. `or` and not a
    # default argument: a cached entry written by an older version of
    # this script has no name key at all, and a KeyError here is a bar
    # module that prints nothing and explains nothing.
    if cooler:
        # Always show temperature if available, otherwise pump speed
        if cooler['temp'] != 'N/A' and cooler['temp']:
            text_parts.append(f"{{ICON_COOLER}} {cooler['temp']}°C")
        elif cooler['pump'] != 'N/A' and cooler['pump']:
            text_parts.append(f"{{ICON_COOLER}} {cooler['pump']}rpm")

        # The device's own name when it reported one, and the plain
        # category when it did not. What is never printed is a product
        # this script picked: the readings underneath come from the
        # machine, and a name that does not belong to them makes every
        # one of them a lie.
        tooltip_lines.append(
            f"\n{{ICON_COOLER}} {cooler.get('name') or 'Liquid cooler'}:")
        tooltip_lines.append(f"  Liquid: {cooler['temp']}°C")
        tooltip_lines.append(f"  Pump: {cooler['pump']} RPM")
        if cooler['fans']:
            tooltip_lines.append(f"  Fans: {', '.join(cooler['fans'])} RPM")

    # GPU
    if gpu:
        text_parts.append(f"{{ICON_TEMP}} {gpu['temp']}°C")
        tooltip_lines.append(f"\n{{ICON_TEMP}} {gpu.get('name') or 'GPU'}:")
        tooltip_lines.append(f"  Temp: {gpu['temp']}°C | Load: {gpu['util']}%")
        tooltip_lines.append(f"  VRAM: {gpu['mem_used']}/{gpu['mem_total']} MB")
        tooltip_lines.append(f"  Power: {gpu['power']}W | Fan: {gpu['fan']}%")
    
    # RGB
    if rgb_count > 0:
        text_parts.append(f"{{ICON_RGB}} {rgb_count}")
        tooltip_lines.append(f"\n{{ICON_RGB}} RGB Devices: {rgb_count}")
    
    # Status class based on temperatures
    class_name = "hardware-normal"

    # DIE SCHWELLEN DES PROZESSORS, UND WORAUS SIE KOMMEN
    #     Nicht gewaehlt: die Grenze eines x86-Prozessors heisst Tjmax
    #     und liegt bei Intel wie bei AMD zwischen 95 und 105 °C - dort
    #     drosselt der Chip selbst. 90 ist damit "es wird gleich
    #     langsam", 80 "es arbeitet unter Volllast". Die beiden Zahlen
    #     sagen also etwas ueber die Maschine und nicht ueber den
    #     Geschmack dessen, der sie hingeschrieben hat.
    #
    #     Die Reihenfolge ist wichtig: erst der Prozessor, dann Kuehler
    #     und Grafikkarte darunter. Jede spaetere Pruefung darf nur
    #     verschaerfen, nie zuruecknehmen - deshalb steht in jeder das
    #     `!= "hardware-critical"`.
    if cpu_temp is not None:
        if cpu_temp >= 90:
            class_name = "hardware-critical"
        elif cpu_temp >= 80:
            class_name = "hardware-warning"

    # Und der Speicher. 95 % belegt heisst, dass der Kern gleich anfaengt
    # auszulagern oder Prozesse zu beenden; 90 % ist der Punkt, an dem
    # ein grosses Programm nicht mehr startet. Beides ueber
    # MemAvailable, also ueber die Schaetzung des Kerns und nicht ueber
    # MemFree - siehe get_memory_use().
    if memory is not None:
        if memory >= 95:
            class_name = "hardware-critical"
        elif memory >= 90 and class_name != "hardware-critical":
            class_name = "hardware-warning"

    # Check liquid temp
    #
    # 40 und 50 °C, und diese beiden Zahlen sind KEINE Chipgrenze,
    # sondern die des Wassers: eine Kompaktkuehlung laeuft im Leerlauf
    # bei 30 bis 35 °C, unter Last bei 40 bis 45; ab 50 gibt der
    # Radiator die Waerme nicht mehr schnell genug ab, und die
    # Kerntemperatur steigt danach ohne weiteren Anlass. Sie stehen
    # unveraendert seit der Waybar-Fassung hier; was fehlte, war dieser
    # Satz.
    if cooler and cooler['temp'] != 'N/A':
        try:
            liquid_temp = float(cooler['temp'])
            if liquid_temp > 50:
                class_name = "hardware-critical"
            elif liquid_temp > 40 and class_name != "hardware-critical":
                class_name = "hardware-warning"
        except:
            pass

    # Check GPU temp (override if higher)
    if gpu and gpu['temp']:
        try:
            gpu_temp = float(gpu['temp'])
            if gpu_temp > 85:
                class_name = "hardware-critical"
            elif gpu_temp > 75 and class_name != "hardware-critical":
                class_name = "hardware-warning"
        except:
            pass
    
    # KEINE AUSKUNFT IST KEINE WARNUNG
    #
    #     Hier stand `if not cooler and not gpu: class_name =
    #     "hardware-offline"`. Auf einem Notebook waren beide immer leer,
    #     also stand das Modul dauerhaft in einer Zustandsklasse - und
    #     bar-style.template malte dafuer bis zum 13.08.2026 einen
    #     deckenden Kasten. Der Nutzer sah auf seiner Leiste eine
    #     dauerhafte Warnung fuer eine Wasserkuehlung, die er nicht hat.
    #
    #     "Offline" heisst ab jetzt, was das Wort sagt: es kam GAR KEINE
    #     Zahl - kein /proc, kein /sys, kein Werkzeug. Auf einer
    #     laufenden Maschine kann das nicht vorkommen, und genau deshalb
    #     ist es die richtige Bedingung: dieser Zweig meldet einen Fehler
    #     und keine Ausstattung.
    if not text_parts:
        class_name = "hardware-offline"

    # Output
    #
    # "No HW" stand hier als Rueckfalltext und war auf jedem Notebook DER
    # Text - siehe oben. Er sagt jetzt, was wirklich los ist: die
    # Maschine antwortet nicht. Das Zeichen bleibt das Mainboard, weil
    # genau darum geht es.
    output = {
        "text": (" ".join(text_parts) if text_parts
                 else "{{ICON_MOTHERBOARD}} ?"),
        "tooltip": ("\n".join(tooltip_lines) if text_parts else
                    "Weder /proc noch /sys geben eine Auskunft ueber diese "
                    "Maschine"),
        "class": class_name
    }

    print(json.dumps(output))

if __name__ == "__main__":
    main()