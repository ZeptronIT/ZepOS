// i18n der Oberflaeche - AGS v3 (GJS)
// Generated by ZepOS
//
// DIESELBE MECHANIK WIE IM INSTALLER, NICHT EINE ZWEITE
//     installer/core/i18n.py benutzt gettext, po/de.po ist sein
//     Katalog, po/build.sh uebersetzt ihn nach .mo. Diese Datei macht
//     nichts anderes - sie ruft dasselbe gettext auf, liest dasselbe
//     .mo-Format und faellt auf dieselbe Weise auf den msgid zurueck,
//     wenn ein Eintrag fehlt. Zwei Uebersetzungsmechaniken in einem
//     Produkt waeren schlimmer als eine unvollstaendige.
//
//     GEMESSEN am 17.08.2026, weil "GJS kann gettext" eine Vermutung
//     gewesen waere. Ein gebuendeltes Probeprogramm - `ags bundle`,
//     derselbe Weg, den die Oberflaeche geht - gegen den KATALOG DES
//     INSTALLERS (po/build/de/LC_MESSAGES/zepos-installer.mo):
//
//         LANG=de_DE.UTF-8  ->  "Es wurde keine Festplatte ausgewaehlt."
//         LANG=en_US.UTF-8  ->  "No disk was selected."
//
//     Beides aus dem gebuendelten Programm heraus. Der Buendler laesst
//     `import Gettext from "gettext"` unangetastet stehen, genau wie
//     `gi://GLib` - das Modul ist in GJS eingebaut (gjs 1.88.1) und
//     nichts muss dafuer aufgeloest werden.
//
// WARUM EIN EIGENER DOMAENENNAME
//     Der Katalog des Installers heisst zepos-installer, und der Name
//     steht im Dateinamen des .mo. Die Oberflaeche in denselben Topf zu
//     werfen hiesse, ein Paket ohne Installer mit einem Katalog
//     auszuliefern, der so heisst, als gehoerte er dazu. Eine Domaene
//     ist gettexts eigenes Mittel dafuer und keine zweite Mechanik: es
//     bleiben dieselben .po-Dateien, dasselbe po/build.sh, dasselbe
//     msgfmt.
//
// WIE DIE SPRACHE HIERHER KOMMT
//     Gar nicht - sie ist schon da. Der Installer schreibt die Wahl aus
//     LANGUAGE_DEFAULTS (installer/gui/pages.py) ueber archinstall nach
//     /etc/locale.conf als LANG=de_DE.UTF-8 bzw. LANG=en_US.UTF-8,
//     systemd reicht LANG an greetd.service, und von dort erbt es die
//     ganze Kette bis `ags run`. gettext liest genau diese Variable.
//     Deshalb steht hier kein setlocale und keine Sprachwahl: die
//     Vorgabe IST die Sprache der Installation, und ein zweiter Ort,
//     an dem sie steht, waere ein Ort, an dem sie falsch sein kann.
//
//     Was hier NICHT passiert, steht in tests/src/test_locale.py: eine
//     Anzeigesprache erzwingen. Diese Datei erzwingt nichts, sie liest.

import Gettext from "gettext"
import GLib from "gi://GLib"

export const DOMAIN = "zepos-desktop"

// Wo der Katalog liegt.
//
// Ohne jede Angabe sucht gettext in /usr/share/locale, und genau dort
// legt ihn packaging/zepos-config ab. Auf einer Installation ist also
// NICHTS einzustellen, und ein hier hingeschriebener Pfad waere eine
// zweite Wahrheit neben dem PKGBUILD.
//
// Ein Entwicklerbaum hat dort nichts. po/build.sh schreibt den Katalog
// neben die Quellen nach po/build - dieselbe Rolle wie DEV_LOCALEDIR in
// installer/core/i18n.py, nur dass ein Widget seinen Quellbaum nicht
// von selbst kennt: der Pfad wird beim Erzeugen eingesetzt.
//
// GEPRUEFT und nicht gesetzt, und das ist der Unterschied, an dem es
// sonst haengt: bindtextdomain SETZT das Verzeichnis, auch ein leeres.
// Neben einer INSTALLIERTEN Paketwurzel gibt es kein po/build - gemessen
// am 17.08.2026 mit GLib.file_test gegen beide Faelle: im Quellbaum
// true, neben der Paketwurzel false. Ein blindes bindtextdomain haette
// dort den installierten Katalog unerreichbar gemacht, und zwar
// lautlos: gettext faellt auf den msgid zurueck und meldet nichts.
//
// Der Pfad steht deshalb NUR als Platzhalter da und nirgends
// ausgeschrieben - tests/src/test_naming.py verbietet einer erzeugten
// Datei, die Paketwurzel zu raten, und ein Pfad in diesem Kommentar
// waere die Vorlage dafuer, es doch zu tun.
//
// ZEPOS_LOCALEDIR schlaegt beides. Damit kann ein Testlauf auf einen
// eigenen Katalog zeigen, ohne etwas zu installieren.
const ENTWICKLERBAUM = "{{ZEPOS_SYSTEM_ROOT}}/../po/build"
const LOCALEDIR = GLib.getenv("ZEPOS_LOCALEDIR")
  || (GLib.file_test(ENTWICKLERBAUM, GLib.FileTest.IS_DIR)
      ? ENTWICKLERBAUM : null)
if (LOCALEDIR) {
  Gettext.bindtextdomain(DOMAIN, LOCALEDIR)
}

// Der Katalog wird bei JEDEM Aufruf gefragt und nicht einmal beim Laden.
// Derselbe Grund wie im Kopf von `_()` in installer/core/i18n.py: ein
// Modul wird importiert, bevor irgendetwas eingerichtet ist.
export function _(message: string): string {
  return Gettext.dgettext(DOMAIN, message)
}

// Fuer eine Zeichenkette, deren Form von einer Anzahl abhaengt.
//
// Keine Bequemlichkeit gegenueber `_()`: wieviele Pluralformen eine
// Sprache hat und welche Zahl welche nimmt, entscheidet die Sprache,
// und diese Regel steht im Plural-Forms-Kopf des Katalogs. "1 Meldungen"
// aus einer einzigen Vorlage zu bauen ist der Fehler, den es verhindert,
// und er faellt sofort auf.
export function ngettext(singular: string, plural: string,
                         n: number): string {
  return Gettext.dngettext(DOMAIN, singular, plural, n)
}

// Dasselbe, aber mit einem Zusatz, der nur den Uebersetzer erreicht.
//
// WOFUER
//     Fuer eine Beschriftung, die zu kurz ist, um sich selbst zu
//     erklaeren. Der Stil-Editor beschriftet zwei Schieber mit "W" und
//     "H" (width, height), die Tapetenauswahl einen Knopf mit "P" oder
//     "L" (portrait, landscape). Als blosser msgid im Katalog ist "W"
//     ein Buchstabe ohne Frage und ohne Antwort - auf Deutsch heisst er
//     "B" wie Breite, aber das kann niemand wissen, der nur "W" sieht.
//
//     Der Zusatz steht NICHT auf dem Schirm. Er unterscheidet nur zwei
//     Eintraege, die denselben msgid haetten, und gibt dem Uebersetzer
//     den Satz, der ihm sonst fehlt.
//
// GEMESSEN am 17.08.2026 gegen einen eigens gebauten Katalog: mit
// msgctxt "slider axis" liefert dgettext(D, "W") den Eintrag OHNE
// Zusatz und dpgettext(D, "slider axis", "W") den MIT - die zwei
// Eintraege bleiben also getrennt, was der ganze Zweck ist.
export function pgettext(context: string, message: string): string {
  return Gettext.dpgettext(DOMAIN, context, message)
}

// Einsetzen benannter Platzhalter.
//
// WARUM NICHT `${...}` IM UEBERSETZTEN TEXT
//     xgettext liest ein Template-Literal mit Einsetzung gar nicht aus -
//     GEMESSEN am 17.08.2026: `_(\`Tick ${x}\`)` erscheint in keiner
//     erzeugten .pot-Datei, waehrend `_("Hello world")` daneben
//     auftaucht. Eine Zeichenkette, die der Auszug nicht sieht, ist eine
//     Zeichenkette ohne Katalogeintrag, und niemand merkt es.
//
//     Ausserdem darf eine Uebersetzung die Reihenfolge aendern duerfen.
//     Benannte Platzhalter erlauben das; `%s %s` erlaubt es nicht.
//
// Die Schreibweise {name} ist die des Installers - po/de.po fuehrt
// "The password for '{user}' is shorter than {minimum} characters." -,
// damit ein Uebersetzer nicht zwei Formen lernen muss.
export function format(template: string,
                       values: Record<string, string | number>): string {
  return template.replace(/\{(\w+)\}/g, (ganzes, name: string) => {
    const wert = values[name]
    // Ein unbekannter Platzhalter bleibt stehen, statt zu verschwinden.
    // Verschwindet er, liest der Nutzer einen halben Satz und niemand
    // erfaehrt davon; bleibt er stehen, steht der Fehler auf dem Schirm.
    return wert === undefined ? ganzes : String(wert)
  })
}
