# Moderne Mako Config mit Glassmorphism-Effekt
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/mako-config.template

sort=-time
layer=overlay

# Position
anchor=top-right
margin=10,10,10,0

# Notification Style (from Style Editor)
background-color={{STYLE_COLOR_NOTIFICATION_BG}}DD
text-color={{STYLE_COLOR_NOTIFICATION_TEXT}}
border-size=1
border-color={{STYLE_COLOR_NOTIFICATION_BORDER}}AA
border-radius={{STYLE_WINDOW_ROUNDING}}
padding=15
width=320
height=100
max-visible=5

# Schatten-Effekt (funktioniert mit transparency)
outer-margin=5

# Font - nutze eine moderne Font
font=Inter 11
# Alternativ: font=JetBrainsMono Nerd Font 10

# Icons aktivieren für besseren Look
icons=1
max-icon-size=48
icon-location=left

# Timeouts
default-timeout=5000
ignore-timeout=1

# Progress Bar Style
progress-color=over {{STYLE_COLOR_NOTIFICATION_PROGRESS}}

# Hover-Effekt
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

# Urgency Styles (from Style Editor)
[urgency=low]
background-color={{STYLE_COLOR_NOTIFICATION_BG}}DD
border-color={{STYLE_COLOR_NOTIFICATION_LOW_BORDER}}AA
text-color={{STYLE_COLOR_NOTIFICATION_LOW_TEXT}}
default-timeout=3000

[urgency=normal]
background-color={{STYLE_COLOR_NOTIFICATION_BG}}DD
border-color={{STYLE_COLOR_NOTIFICATION_BORDER}}AA
text-color={{STYLE_COLOR_NOTIFICATION_TEXT}}

[urgency=critical]
background-color={{STYLE_COLOR_NOTIFICATION_BG}}DD
border-color={{STYLE_COLOR_NOTIFICATION_CRITICAL_BORDER}}AA
text-color={{STYLE_COLOR_NOTIFICATION_CRITICAL_TEXT}}
default-timeout=0

# Browser Notifications (AFTER urgency rules to override!)
[app-name=Chromium urgency=critical]
background-color=#0c0c0cDD
border-color=#4285f4
text-color=#4285f4
format={{ICON_CHROME}} <b>%s</b>\n%b
default-timeout=5000

[app-name=Chrome urgency=critical]
background-color=#0c0c0cDD
border-color=#4285f4
text-color=#4285f4
format={{ICON_CHROME}} <b>%s</b>\n%b
default-timeout=5000

[app-name=Google-chrome urgency=critical]
background-color=#0c0c0cDD
border-color=#4285f4
text-color=#4285f4
format={{ICON_CHROME}} <b>%s</b>\n%b
default-timeout=5000

[app-name=Firefox urgency=critical]
background-color=#0c0c0cDD
border-color=#ff7139
text-color=#ff7139
