// Battery/Power Widget for AGS v3 (GTK4)
// Generated by ZepOS
// Features: Battery status with visual progress, Power profiles
// Clean minimal design — Astal.Window overlay

import { Gtk } from "ags/gtk4"
import { execAsync } from "ags/process"
import { interval } from "ags/time"
import GLib from "gi://GLib"
import Pango from "gi://Pango"
import { createOverlayWindow, OverlayWidget } from "../utils/overlay"
import { _, format } from "../utils/i18n"
import { zepButton } from "../utils/kit"

const WINDOW_NAME = "battery"
const UPDATE_INTERVAL = 5000

// DIE BREITE, UND WARUM SIE HIER NICHT DURCH MEHR PUNKTE ENTSTEHT
//
//     GEMELDET, woertlich: "die ags fenster sind so eingequetscht das
//     man nach rechts und nach unten scrollen muss", und daneben, dass
//     die Akkuanzeige mit Prozentzeichen nicht zu sehen sei. Auf den
//     Bildern vom 17.08.2026 stand in diesem Fenster eine einzelne
//     Ziffer statt des Ladestands und "Läd" statt "Lädt" - der
//     Ladestand war hinter der rechten Kante abgeschnitten, samt seinem
//     Prozentzeichen, also genau die Meldung.
//
//     GEMESSEN am 17.08.2026 im verschachtelten Compositor, Schirm
//     1920x1080, je einmal unter de_DE.UTF-8 und en_US.UTF-8:
//
//         Fenster laut hyprctl layers                      320
//         Inhalt, natuerlich                     de 555 / en 492
//
//     ZWEIHUNDERTFUENFUNDSECHZIG PUNKTE DAVON SIND DREI WOERTER, und das
//     ist der Grund, aus dem dieses Fenster NICHT einfach breiter wird.
//     Der Baum, gemessen:
//
//         .battery-section (Zeichen, Ladestand, Balken, Werte)  192
//         .battery-profile-buttons                             505
//
//     Die Knopfreihe ist `homogeneous: true` und misst damit dreimal
//     ihren breitesten Knopf. Der breiteste war der mit der laengsten
//     Beschriftung - "Energiesparen" misst 137 Punkte, der Knopf darum
//     163, dreimal 489 plus zweimal 8 spacing sind 505. Ein Fenster, das
//     das bezahlt, waere 581 Punkte breit gewesen: breiter als das
//     Kontrollzentrum (519), und das fuer einen Akkustand, ein
//     Prozentzeichen und drei Knoepfe. Auf Englisch waeren es 518
//     gewesen - eine Fenstergroesse, die davon abhaengt, wie lang ein
//     Uebersetzer ein Wort macht, ist keine Groesse, sondern ein Zufall.
//
//     Deshalb bricht die Beschriftung jetzt um (siehe die Knopfreihe
//     unten), und die Breite kommt aus derselben Addition wie beim
//     Kalender:
//
//         .battery-container { min-width: 360px }           360
//         dessen padding {{STYLE_SPACE_16}}, zweimal        +50
//                                                          ----
//         Inhalt                                            410
//         .overlay-outer, Rahmen 1px, zweimal                +2
//         senkrechte Bildlaufleiste (immer reserviert)      +24
//                                                          ----
//                                                           436
const WIN_WIDTH = 436

// DIE HOEHE STAND AUF 280, UND DER INHALT IST MEHR ALS DOPPELT SO HOCH
//
//     GEMESSEN am 17.08.2026: die natuerliche Hoehe dieses Aufbaus ist
//     636 Punkte, das Fenster stand 280 hoch da. Unter der Kante lagen
//     der Ladebalken zur Haelfte, beide Werte darunter und die ganze
//     Knopfreihe - das war die zweite Haelfte der Meldung ("nach unten
//     scrollen"). 280 war keine Grenze, die jemand gezogen hat, sondern
//     eine, die nichts mass: der Deckel des Entwurfssystems liegt auf
//     einem Schirm mit 1080 Zeilen bei 540 (MEASURE_MODAL_SHARE in
//     src/sizes.py), also weit darueber.
//
//     Hier steht deshalb die gemessene natuerliche Hoehe. Was davon auf
//     den Schirm passt, entscheidet der Deckel und nicht diese Zahl -
//     dieselbe Bauform wie beim Kalender (678). Mit der umbrechenden
//     Beschriftung unten sind es 657 statt 636 - die Knopfreihe ist eine
//     Zeile hoeher geworden, und auch das ist gemessen und nicht
//     geschaetzt.
const WIN_HEIGHT = 657

// WIE VIELE ZEICHEN EINE PROFILBESCHRIFTUNG BREIT SEIN DARF
//
//     Die drei Knoepfe teilen sich die Breite des Fensters zu gleichen
//     Teilen. Was bleibt, ist gerechnet und nicht geschaetzt:
//
//         Sichtfenster bei WIN_WIDTH 436       436 - 2 - 24 = 410
//         .battery-container padding, zweimal              -50
//         .battery-profile-buttons, spacing 8, zweimal     -16
//                                                         ----
//         fuer drei Knoepfe                                344
//         je Knopf                                         114
//         .battery-profile-btn padding {{STYLE_SPACE_8}} 2x -24
//         dessen Rahmen 1px, zweimal                        -2
//                                                          ---
//         fuer die Beschriftung                             88
//
//     GEMESSEN: "Energiesparen" ist 13 Zeichen und 137 Punkte breit,
//     also 10,5 Punkte je Zeichen - die Schrift dieser Oberflaeche ist
//     Fira Code und damit dicktengleich. In 88 Punkte passen acht davon.
//
// GEFUNDEN, NICHT BEHOBEN, am 18.08.2026 (Task A): die Rechnung oben
// geht von "battery-profile-btn padding {{STYLE_SPACE_8}} 2x" aus - der
// alten, fenstereigenen Knopfregel. Der Knopf ist seither ein zepButton
// (Rolle "umrandet", ags-kit.template), und dessen Regel zep-btn traegt
// `padding: 0 {{STYLE_SPACE_16}}` - doppelt so viel horizontal wie hier
// gerechnet. Die 88 Punkte fuer die Beschriftung stimmen damit nicht
// mehr; WIN_WIDTH und PROFILE_LABEL_CHARS bleiben trotzdem stehen, weil
// die Breitenleiter (Stufe 5) diese Rechnung neu macht und nicht dieser
// Auftrag (sechs Fenster mit je einer Klasse).
const PROFILE_LABEL_CHARS = 8

// Icons
const ICONS = {
  battery: "{{ICON_BATTERY_FULL}}",
  batteryLow: "{{ICON_BATTERY_LOW}}",
  batteryMid: "{{ICON_BATTERY_MID}}",
  batteryHigh: "{{ICON_BATTERY_HIGH}}",
  batteryEmpty: "{{ICON_BATTERY_EMPTY}}",
  charging: "{{ICON_BATTERY_CHARGING}}",
  plug: "{{ICON_PLUG}}",
  performance: "{{ICON_SPEEDOMETER}}",
  powersave: "{{ICON_LEAF}}",
  clock: "{{ICON_CLOCK}}",
  bolt: "{{ICON_BOLT}}",
}

// Profile configuration
interface ProfileConfig {
  id: string
  icon: string
  label: () => string
  color: string
}

// Der Name eines Profils steht EINMAL. Bis zum 17.08.2026 stand er
// zweimal - hier und noch einmal als `labels` in setPowerProfile()
// darunter -, und die zwei Tabellen waren schon auseinandergelaufen:
// der Knopf sagte "Sparen", die Meldung nach dem Klick auf denselben
// Knopf sagte "Energiesparen". Beim Uebersetzen waeren daraus zwei
// Katalogeintraege fuer dieselbe Sache geworden.
//
// `label` ist eine FUNKTION und kein Feld: `_()` beim Laden des Moduls
// aufzurufen hiesse, den Katalog zu fragen, bevor irgendetwas
// eingerichtet ist - derselbe Grund, aus dem `_()` in utils/i18n.ts bei
// jedem Aufruf nachschlaegt und nicht einmal beim Import.
const PROFILES: ProfileConfig[] = [
  { id: "power-saver", icon: ICONS.powersave,
    label: () => _("Power Saver"), color: "#a6e3a1" },
  { id: "balanced", icon: ICONS.battery,
    label: () => _("Balanced"), color: "#89b4fa" },
  { id: "performance", icon: ICONS.performance,
    label: () => _("Performance"), color: "#f9e2af" },
]

// Der Anzeigename eines Profils, an seiner Kennung.
function profileLabel(id: string): string {
  return PROFILES.find((p) => p.id === id)?.label() ?? id
}

// Helper for shell commands
async function sh(cmd: string): Promise<string> {
  try {
    return await execAsync(["bash", "-c", cmd])
  } catch {
    return ""
  }
}

function getBatteryIcon(percent: number, charging: boolean): string {
  if (charging) return ICONS.charging
  if (percent <= 10) return ICONS.batteryEmpty
  if (percent <= 25) return ICONS.batteryLow
  if (percent <= 50) return ICONS.batteryMid
  if (percent <= 75) return ICONS.batteryHigh
  return ICONS.battery
}

async function getBatteryInfo() {
  const capacityStr = await sh("cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo 0")
  const percent = parseInt(capacityStr.trim()) || 0

  const statusStr = await sh("cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo Unknown")
  const status = statusStr.trim()

  const powerNowRaw = parseInt(await sh("cat /sys/class/power_supply/BAT0/power_now 2>/dev/null || echo 0"))
  const powerNow = powerNowRaw / 1000000

  const voltageRaw = parseInt(await sh("cat /sys/class/power_supply/BAT0/voltage_now 2>/dev/null || echo 0"))
  const voltage = voltageRaw / 1000000

  const energyNow = parseInt(await sh("cat /sys/class/power_supply/BAT0/energy_now 2>/dev/null || echo 0"))
  const energyFull = parseInt(await sh("cat /sys/class/power_supply/BAT0/energy_full 2>/dev/null || echo 0"))

  // Check if AC adapter is connected
  const acOnline = await sh("cat /sys/class/power_supply/AC*/online 2>/dev/null || cat /sys/class/power_supply/ADP*/online 2>/dev/null || echo 0")
  const isPluggedIn = acOnline.trim() === "1"

  let timeRemaining = "—"
  let powerDisplay = "—"

  if (status === "Discharging" && powerNowRaw > 0) {
    // Discharging: show time remaining and power consumption
    const hours = energyNow / powerNowRaw
    const h = Math.floor(hours)
    const m = Math.floor((hours - h) * 60)
    timeRemaining = `${h}h ${m}m`
    powerDisplay = `${powerNow.toFixed(1)}W`
  } else if (status === "Charging" && powerNowRaw > 0) {
    // Charging: show time until full and charging power
    const remaining = energyFull - energyNow
    const hours = remaining / powerNowRaw
    const h = Math.floor(hours)
    const m = Math.floor((hours - h) * 60)
    timeRemaining = `${h}h ${m}m`
    powerDisplay = `+${powerNow.toFixed(1)}W`
  } else if (status === "Full" || status === "Not charging") {
    // Full or not charging: show voltage and plugged status
    //
    // Hier stand "Am Netz" als deutsche Zeichenkette, und zwar als
    // einzige in dieser Datei. GESEHEN am 17.08.2026 auf dem
    // Abnahmebild unter en_US.UTF-8: ueber "Time left" stand "Am Netz".
    // Es ist dieselbe Aussage wie der Status "Not charging" darueber,
    // also derselbe Katalogeintrag und keine zweite Uebersetzung.
    timeRemaining = isPluggedIn ? _("On mains") : "—"
    powerDisplay = `${voltage.toFixed(1)}V`
  }

  return { percent, status, timeRemaining, powerDisplay, voltage, isPluggedIn }
}

async function getPowerProfile(): Promise<string> {
  const output = await sh("powerprofilesctl get 2>/dev/null")
  return output.trim() || "balanced"
}

async function setPowerProfile(profile: string) {
  const result = await sh(`powerprofilesctl set ${profile} 2>&1`)

  // Als ARGUMENTLISTE und nicht als eine Zeichenkette.
  //
  // Hier stand `GLib.spawn_command_line_async` mit einer zusammen-
  // gebauten Kommandozeile, und das ging nur gut, solange der Text
  // deutsch und fest war: eine uebersetzte Meldung mit einem
  // Anfuehrungszeichen darin - im Englischen ein Apostroph, im
  // Franzoesischen jedes zweite Wort - haette die Zeile zerlegt und
  // notify-send mit den Bruchstuecken gestartet. Eine Liste wird nicht
  // von einer Shell gelesen, also gibt es nichts zu zerlegen. Dieselbe
  // Begruendung steht in ags-vpn-settings.template beim Generatoraufruf.
  const titel = _("Power profile")
  try {
    if (result.includes("error") || result.includes("Error")) {
      await execAsync(["notify-send", "-u", "critical", titel,
                       format(_("Error: {message}"),
                              { message: result.trim() })])
    } else {
      await execAsync(["notify-send", titel, profileLabel(profile)])
    }
  } catch {
    // Eine Meldung, die nicht ankommt, darf das Umschalten nicht
    // ruecknehmen - es hat schon stattgefunden.
  }
}

export default function Battery(): OverlayWidget {
  // UI Elements
  let batteryIcon: Gtk.Label
  let percentLabel: Gtk.Label
  let statusLabel: Gtk.Label
  let timeLabel: Gtk.Label
  let powerLabel: Gtk.Label
  let progressBar: Gtk.ProgressBar
  let profileButtons: Map<string, Gtk.Button> = new Map()

  // Update display
  const updateDisplay = async () => {
    const battery = await getBatteryInfo()
    const profile = await getPowerProfile()
    const isCharging = battery.status === "Charging"

    batteryIcon.set_text(getBatteryIcon(battery.percent, isCharging))
    percentLabel.set_text(`${battery.percent}%`)

    const statusText =
      battery.status === "Charging" ? _("Charging") :
      battery.status === "Discharging" ? _("Discharging") :
      battery.status === "Full" ? _("Full") :
      battery.status === "Not charging" ? _("On mains") : battery.status
    statusLabel.set_text(statusText)

    timeLabel.set_text(battery.timeRemaining)
    powerLabel.set_text(battery.powerDisplay)
    progressBar.set_fraction(battery.percent / 100)

    // Progress bar styling
    progressBar.remove_css_class("critical")
    progressBar.remove_css_class("warning")
    progressBar.remove_css_class("charging")
    if (isCharging) progressBar.add_css_class("charging")
    else if (battery.percent <= 15) progressBar.add_css_class("critical")
    else if (battery.percent <= 30) progressBar.add_css_class("warning")

    // Profile buttons
    profileButtons.forEach((btn, id) => {
      if (id === profile) btn.add_css_class("active")
      else btn.remove_css_class("active")
    })
  }

  return createOverlayWindow({
    name: WINDOW_NAME,
    width: WIN_WIDTH,
    height: WIN_HEIGHT,
    cssClass: "Battery",
    headerIcon: ICONS.battery,
    headerTitle: _("Battery"),
    accentCssClass: "battery-accent",
    onShow: () => { updateDisplay() },
    buildContent: (_win, closeWindow) => {
      // ============================================================================
      // BUILD UI
      // ============================================================================

      const mainBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 16 })
      mainBox.add_css_class("battery-container")

      // ===== BATTERY DISPLAY =====
      const batterySection = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 12 })
      batterySection.add_css_class("battery-section")

      // Big icon + percent
      const displayRow = new Gtk.Box({ spacing: 16, halign: Gtk.Align.CENTER })

      batteryIcon = new Gtk.Label({ label: ICONS.battery })
      batteryIcon.add_css_class("battery-big-icon")

      const infoBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 2, valign: Gtk.Align.CENTER })

      percentLabel = new Gtk.Label({ label: "0%", xalign: 0 })
      percentLabel.add_css_class("battery-percent")

      statusLabel = new Gtk.Label({ label: "—", xalign: 0 })
      statusLabel.add_css_class("battery-status-text")

      infoBox.append(percentLabel)
      infoBox.append(statusLabel)

      displayRow.append(batteryIcon)
      displayRow.append(infoBox)

      // Progress bar
      progressBar = new Gtk.ProgressBar({ hexpand: true })
      progressBar.add_css_class("battery-progress")

      // Stats row - only show when relevant values exist
      const statsRow = new Gtk.Box({ spacing: 24, halign: Gtk.Align.CENTER })
      statsRow.add_css_class("battery-stats")

      const timeBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 2, halign: Gtk.Align.CENTER })
      const timeIcon = new Gtk.Label({ label: ICONS.clock })
      timeIcon.add_css_class("battery-stat-icon")
      timeLabel = new Gtk.Label({ label: "—" })
      timeLabel.add_css_class("battery-stat-value")
      const timeTitle = new Gtk.Label({ label: _("Time left") })
      timeTitle.add_css_class("battery-stat-title")
      timeBox.append(timeIcon)
      timeBox.append(timeLabel)
      timeBox.append(timeTitle)

      const powerBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 2, halign: Gtk.Align.CENTER })
      const powerIcon = new Gtk.Label({ label: ICONS.bolt })
      powerIcon.add_css_class("battery-stat-icon")
      powerLabel = new Gtk.Label({ label: "—" })
      powerLabel.add_css_class("battery-stat-value")
      const powerTitle = new Gtk.Label({ label: _("Power") })
      powerTitle.add_css_class("battery-stat-title")
      powerBox.append(powerIcon)
      powerBox.append(powerLabel)
      powerBox.append(powerTitle)

      statsRow.append(timeBox)
      statsRow.append(powerBox)

      batterySection.append(displayRow)
      batterySection.append(progressBar)
      batterySection.append(statsRow)

      // ===== POWER PROFILES =====
      const profileSection = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 10 })
      profileSection.add_css_class("battery-profile-section")

      const profileRow = new Gtk.Box({ spacing: 8, homogeneous: true })
      profileRow.add_css_class("battery-profile-buttons")

      for (const p of PROFILES) {
        // zepButton, Rolle "umrandet" (Task A, 18.08.2026): die drei
        // Profile sind gleichrangige Auswahlmoeglichkeiten und keine
        // Hauptsache-gegen-Nebenwege-Reihe wie bei Bluetooth (dort hat
        // "suchen" ein klares "voll") - dieselbe Einordnung wie die
        // Geraetezeilen dort, die ebenfalls "umrandet" tragen. Welches
        // Profil GERADE gilt, zeigt weiterhin die Klasse "active" unten
        // (siehe battery-profile-buttons zep-btn.active im Stylesheet)
        // und nicht die Rolle - eine Rolle "voll" waere IMMER hell,
        // unabhaengig vom gewaehlten Profil, und stuende damit gegen die
        // "active"-Kennzeichnung.
        const btn = zepButton("", "umrandet", () => {
          setPowerProfile(p.id)
          GLib.timeout_add(GLib.PRIORITY_DEFAULT, 500, () => {
            updateDisplay()
            return GLib.SOURCE_REMOVE
          })
        })
        btn.add_css_class(`profile-${p.id}`)

        const btnBox = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL, spacing: 4 })
        const btnIcon = new Gtk.Label({ label: p.icon })
        btnIcon.add_css_class("battery-profile-icon")
        // DIE BESCHRIFTUNG BRICHT UM, UND SIE DARF DAS MITTEN IM WORT
        //
        //     Eine Gtk.Label ohne Umbruch und ohne Kuerzung meldet ihre
        //     GANZE ZEILE als MINDESTbreite. Drei davon in einer
        //     homogeneous-Reihe haben dieses Fenster auf 581 Punkte
        //     getrieben (siehe WIN_WIDTH oben) - der Text hat das
        //     Fenster bestimmt und nicht umgekehrt.
        //
        //     WORD_CHAR UND NICHT WORD, UND DAS IST EINE GEGENPROBE
        //     WORD bricht nur an Leerzeichen, und "Energiesparen" hat
        //     keins. GEMESSEN am 17.08.2026 mit genau diesem Aufbau,
        //     einmal mit WORD statt WORD_CHAR im ERZEUGTEN Battery.tsx:
        //
        //         WORD       "Energiesparen" min 137 / nat 137
        //                    "Leistung"      min  84 / nat  84
        //                    Knopfreihe      505, Inhalt 555
        //         WORD_CHAR  "Energiesparen" min  21 / nat  84
        //                    Knopfreihe      346, Inhalt 410
        //
        //     Mit WORD waere dieser Umbruch also wirkungslos gewesen -
        //     dieselben 137 wie ohne ihn, und dasselbe zu breite
        //     Fenster. Ein deutsches Kompositum ist der Normalfall und
        //     nicht die Ausnahme, und in welcher Sprache das naechste
        //     ankommt, weiss diese Datei nicht. WORD_CHAR bricht zur Not
        //     im Wort und setzt dabei einen Trennstrich; damit gibt es
        //     kein Wort mehr, das dieses Fenster aufziehen kann.
        //
        //     max_width_chars deckelt die NATUERLICHE Breite - ohne die
        //     Zahl waere sie weiterhin die volle Zeile, und der Umbruch
        //     traete erst ein, wenn es schon zu eng ist.
        const btnLabel = new Gtk.Label({
          label: p.label(),
          wrap: true,
          wrap_mode: Pango.WrapMode.WORD_CHAR,
          justify: Gtk.Justification.CENTER,
          max_width_chars: PROFILE_LABEL_CHARS,
        })
        btnLabel.add_css_class("battery-profile-label")

        btnBox.append(btnIcon)
        btnBox.append(btnLabel)
        btn.set_child(btnBox)

        profileButtons.set(p.id, btn)
        profileRow.append(btn)
      }

      profileSection.append(profileRow)

      // ===== ASSEMBLE =====
      mainBox.append(batterySection)
      mainBox.append(profileSection)

      // Start update interval
      interval(UPDATE_INTERVAL, updateDisplay)

      return mainBox
    },
  })
}
