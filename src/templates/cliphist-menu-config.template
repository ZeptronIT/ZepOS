#!/bin/bash
# =========================================
# ZWISCHENABLAGE-VERLAUF MIT FAVORITEN
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/cliphist-menu-config.template
# =========================================
#
# WARUM ES DIESES SKRIPT GIBT, OBWOHL ES EIN PLUGIN FUER DEN VERLAUF GIBT
#     Wegen der Favoriten. hyprclipx zeigt den Verlauf, den `wl-paste
#     --watch cliphist store` seit dem Login sammelt, und kann einen
#     Eintrag nicht dauerhaft festhalten. Hier steht er in
#     ~/.config/cliphist/favorites und ueberlebt jeden Neustart.
#
#     Die drei Betriebsarten sind in Bash gebaut und nicht im
#     Auswahlfenster: zepos-menu ist ein Auswahlfenster fuer beliebige
#     Zeilen und weiss nichts von Zwischenablagen. Ein Favoritenknopf
#     darin waere eine Zwischenablagefunktion in einem allgemeinen
#     Werkzeug - und die anderen fuenf Aufrufer haetten ihn auch.
#
# Steuerung:
#   - Eintrag auswählen = Sofort einfügen
#   - [FAV] = Favoriten-Modus (Favoriten anzeigen, Auswahl toggled Status)
#   - [SHOW FAV] = Nur Favoriten anzeigen (zum Einfügen)

FAVORITES_FILE="$HOME/.config/cliphist/favorites"
MODE="${1:-normal}"  # normal, fav, showfav

mkdir -p "$(dirname "$FAVORITES_FILE")"
touch "$FAVORITES_FILE"

# Show menu
show_menu() {
    {
        case "$MODE" in
            normal)
                # Optionen oben
                echo "[{{ICON_STAR}} FAV] Favorit hinzufuegen/entfernen"
                echo "[{{ICON_STAR}} SHOW] Nur Favoriten anzeigen"
                echo "──────────────"
                # Nur cliphist Historie (keine Favoriten hier)
                cliphist list
                ;;
            fav)
                # FAV-Modus: Favoriten verwalten
                echo "Waehle Eintrag zum Favorit-Toggle:"
                echo "──────────────"
                # Zuerst existierende Favoriten (zum Entfernen)
                if [ -s "$FAVORITES_FILE" ]; then
                    echo "--- Favoriten (Auswahl entfernt) ---"
                    while IFS= read -r fav; do
                        [[ -n "$fav" ]] && echo "{{ICON_STAR}} $fav"
                    done < "$FAVORITES_FILE"
                    echo "──────────────"
                fi
                # Dann Historie (zum Hinzufügen)
                echo "--- Historie (Auswahl macht Favorit) ---"
                cliphist list
                ;;
            showfav)
                # Nur Favoriten anzeigen (zum Einfügen)
                echo "[{{ICON_ARROW_LEFT}} BACK] Zurueck zur Historie"
                echo "──────────────"
                if [ -s "$FAVORITES_FILE" ]; then
                    while IFS= read -r fav; do
                        [[ -n "$fav" ]] && echo "{{ICON_STAR}} $fav"
                    done < "$FAVORITES_FILE"
                else
                    echo "(Keine Favoriten vorhanden)"
                fi
                ;;
        esac
    } | zepos-menu --dmenu \
             --prompt "$(case "$MODE" in
                 fav) echo "{{ICON_STAR}} Favorit verwalten" ;;
                 showfav) echo "{{ICON_STAR}} Favoriten" ;;
                 *) echo "{{ICON_CLIPBOARD}} Clipboard" ;;
             esac)" \
             --cache-file /dev/null \
             --sort-order=default
}

# Toggle favorite
toggle_favorite() {
    local text="$1"
    if grep -Fxq "$text" "$FAVORITES_FILE" 2>/dev/null; then
        grep -Fxv "$text" "$FAVORITES_FILE" > "$FAVORITES_FILE.tmp"
        mv "$FAVORITES_FILE.tmp" "$FAVORITES_FILE"
        notify-send "{{ICON_CLIPBOARD}} Clipboard" "Favorit entfernt" -t 1500
    else
        echo "$text" >> "$FAVORITES_FILE"
        notify-send "{{ICON_CLIPBOARD}} Clipboard" "{{ICON_STAR}} Favorit hinzugefuegt" -t 1500
    fi
}

# Main
main() {
    local selected
    selected=$(show_menu)

    [ -z "$selected" ] && exit 0
    [[ "$selected" == "──────────────" ]] && exit 0
    [[ "$selected" == "Waehle Eintrag"* ]] && exit 0
    [[ "$selected" == "--- "* ]] && exit 0
    [[ "$selected" == "(Keine Favoriten"* ]] && exit 0

    # Navigation
    if [[ "$selected" == "[{{ICON_STAR}} FAV]"* ]]; then
        exec "$0" fav
    fi
    if [[ "$selected" == "[{{ICON_STAR}} SHOW]"* ]]; then
        exec "$0" showfav
    fi
    if [[ "$selected" == "[{{ICON_ARROW_LEFT}} BACK]"* ]]; then
        exec "$0" normal
    fi

    # Text extrahieren
    local text
    if [[ "$selected" == "{{ICON_STAR}} "* ]]; then
        text="${selected#{{ICON_STAR}} }"
    else
        text=$(echo "$selected" | cliphist decode 2>/dev/null)
    fi

    [ -z "$text" ] && exit 0

    case "$MODE" in
        fav)
            # Favorit-Modus: Toggle
            toggle_favorite "$text"
            ;;
        *)
            # Normal/ShowFav: Einfügen
            printf '%s' "$text" | wl-copy
            notify-send "{{ICON_CLIPBOARD}} Clipboard" "{{ICON_CHECK}} Kopiert" -t 1000
            ;;
    esac
}

main
