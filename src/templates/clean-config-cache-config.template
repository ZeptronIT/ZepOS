#!/bin/bash
# Config Cache Cleaner
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/clean-config-cache-config.template

echo "{{ICON_CLEAN}} Config Cache Cleaner"
echo "======================"

# Ferdium Caches
if [ -d "$HOME/.config/Ferdium" ]; then
    echo "{{ICON_FERDIUM}} Cleaning Ferdium caches..."
    find ~/.config/Ferdium -type d -name "Cache" -exec rm -rf {} + 2>/dev/null
    find ~/.config/Ferdium -type d -name "CacheStorage" -exec rm -rf {} + 2>/dev/null
    find ~/.config/Ferdium -type d -name "Code Cache" -exec rm -rf {} + 2>/dev/null
fi

# OpenRGB Logs
if [ -d "$HOME/.config/OpenRGB/logs" ]; then
    echo "{{ICON_RGB}} Cleaning OpenRGB logs..."
    # Lösche Dateien in Batches um "Argumentliste zu lang" zu vermeiden
    find ~/.config/OpenRGB/logs -type f -delete
    # Oder komplett den logs Ordner neu erstellen
    rm -rf ~/.config/OpenRGB/logs
    mkdir -p ~/.config/OpenRGB/logs
fi

# Chromium Caches
if [ -d "$HOME/.config/chromium" ]; then
    echo "{{ICON_CHROME}} Cleaning Chromium caches..."
    rm -rf ~/.config/chromium/*/Cache
    rm -rf ~/.config/chromium/*/Code\ Cache
    rm -rf ~/.config/chromium/*/Service\ Worker/CacheStorage
fi

# Zeige neue Größen
echo -e "\n{{ICON_CHART}} Neue Größen:"
du -sh ~/.config/Ferdium 2>/dev/null || echo "Ferdium: Not found"
du -sh ~/.config/OpenRGB 2>/dev/null || echo "OpenRGB: Not found"
du -sh ~/.config/chromium 2>/dev/null || echo "Chromium: Not found"

echo -e "\n{{ICON_CHECK}} Bereinigung abgeschlossen!"