#!/bin/bash
# =========================================
# LIST PROFILES SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/list-profiles-config.template
# =========================================

# Settings, profiles and generated helpers belong to the user. A
# generated script runs standalone and cannot import paths.py, so the
# default is spelled out here; an unset variable would expand to nothing
# and turn every path below into one starting at the filesystem root.
ZEPOS_USER_ROOT="${ZEPOS_USER_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/zepos}"

PROFILE_DIR="$ZEPOS_USER_ROOT/profiles"
HYPR_DIR="$HOME/.config/hypr"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Get current profile
CURRENT=$("$HYPR_DIR/hyprland-status" get 2>/dev/null || echo "none")

echo ""
echo -e "${CYAN}{{ICON_LIST}} Available Hyprland Profiles${NC}"
echo "================================"
echo ""

for dir in "$PROFILE_DIR"/*/; do
    if [ -d "$dir" ]; then
        name=$(basename "$dir")

        # Check if profile has monitors.conf (configured)
        if [ -f "$dir/monitors.conf" ]; then
            # Check for placeholder
            if grep -q "Placeholder" "$dir/monitors.conf" 2>/dev/null; then
                status="${YELLOW}(not configured)${NC}"
            else
                status="${GREEN}(ready)${NC}"
            fi
        else
            status="${YELLOW}(missing monitors.conf)${NC}"
        fi

        # Mark current profile
        if [ "$name" = "$CURRENT" ]; then
            echo -e "  {{ICON_ACTIVE}} $name $status ${GREEN}<-- current${NC}"
        else
            echo -e "  {{ICON_PROFILE}} $name $status"
        fi
    fi
done

echo ""
echo "Commands:"
echo "  start-hyprland <profile>  - Start Hyprland with profile"
echo "  save-profile <name>       - Save current monitors as profile"
echo "  zepos-settings-gui        - Configure monitors (Bildschirme page)"
echo ""
