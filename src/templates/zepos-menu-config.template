# zepos-menu - Konfiguration
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/zepos-menu-config.template
#
# NEUN SCHLUESSEL, UND JEDER WIRD GELESEN
#     Der Vorgaenger dieser Datei war wofis Konfiguration und trug
#     vierundzwanzig Zeilen. Die Haelfte davon waren Widget-Stellschrauben
#     eines GTK3-Programms, das es hier nicht mehr gibt - halign,
#     content_halign, orientation, hide_scroll, filter_rate, no_actions,
#     gtk_dark, location, allow_markup, matching, allow_images. Ein
#     Schluessel, den niemand liest, ist eine Einstellung, die jemand
#     aendert und deren Ausbleiben er sich nicht erklaeren kann.
#
#     Uebrig ist, was menu/zepos_menu/options.py in DEFAULTS auffuehrt,
#     und das ist zugleich die Liste, gegen die eine unbekannte Zeile hier
#     mit einer Meldung auf stderr beantwortet wird.
#
# ZWEI DAVON WURDEN ABGESCHAFFT, NICHT UEBERNOMMEN
#     allow_markup=true stand hier und war gefaehrlich: wofi setzte die
#     Zeilen dann als Pango-Markup, und eine SSID oder ein
#     Zwischenablagetext mit "&" darin ist ungueltiges Markup. zepos-menu
#     setzt jede Zeile als Text.
#
#     matching=contains war der einzige Wert, den dieses Projekt je
#     benutzt hat. Er ist jetzt das Verhalten und keine Einstellung mehr;
#     die Begruendung gegen einen Fuzzy-Vergleich steht bei
#     zepos_menu.entries.matches().

# Die Fenstergroesse, wenn der Aufrufer keine nennt. network-manager-gui
# nennt drei verschiedene ueber --width/--height; der Starter nimmt diese.
#
# SEIT DEM 12.08.2026 IST DAS EINE OBERGRENZE UND KEINE ZUSAGE
#     GEMELDET an dem Tag: das Suchfenster sei zu hoch. GEMESSEN: 864 px
#     sind auf einem 1080er Schirm genau der Platz, den Kopf und Fuss
#     uebriglassen - auf den Pixel, ohne Rand. Ein Fenster, das sich vor
#     die Arbeit stellt und dabei die ganze Arbeit verdeckt, ist kein
#     Fenster mehr, das sich vorstellt.
#
#     menu/zepos_menu/window.py deckelt diese Zahl deshalb auf die
#     Haelfte des Schirms - auf 1080 also 540, auf 1440 720, auf einem
#     alten Notebook 384. Die Zahlen hier bleiben, weil sie auf einem
#     sehr grossen Schirm weiterhin die Obergrenze sind: ein Starter, der
#     auf 4K 2160 px hoch aufgeht, ist derselbe Fehler in die andere
#     Richtung. Die Begruendung fuer die Haelfte steht in src/sizes.py
#     bei MEASURE_MODAL_SHARE.
width=1536
height=864

# Was im leeren Eingabefeld steht, solange nichts getippt ist.
prompt={{ICON_SEARCH}} Suchen ...

# Die Betriebsart ohne --dmenu. drun ist die einzige gebaute; alles
# andere beendet das Programm mit einer Meldung, die den Namen nennt.
show=drun

# Gross- und Kleinschreibung beim Filtern egal. Ein Starter, in dem
# "firefox" den Firefox nicht findet, weil der Eintrag "Firefox" heisst,
# ist ein Starter, den man zweimal bedient.
insensitive=true

# alphabetical fuer den Starter. Die fuenf Skripte uebergeben
# --sort-order=default, weil ihre Reihenfolge etwas bedeutet: die
# WLAN-Liste ist nach Signalstaerke sortiert und der
# Zwischenablageverlauf nach Alter.
sort_order=alphabetical

# Womit eine Anwendung mit Terminal=true geoeffnet wird. Ohne diese
# Zeile suchte sich GIO selbst ein Terminal - ueber die GSettings einer
# GNOME-Sitzung, die es auf ZepOS nicht gibt.
terminal=kitty

# Die Layer-Shell-Ebene. overlay liegt ueber allem, auch ueber einem
# Vollbildfenster - was fuer einen Starter richtig ist, den man aus
# jedem Zustand heraus mit einer Taste oeffnet.
layer=overlay

# Kantenlaenge des Anwendungssymbols im Starter, in Pixeln. Bei --dmenu
# gibt es keine Symbole.
image_size=40
