#!/bin/bash
# AGS Network Scripts
# Generated by ZepOS
# Location: ~/.local/bin/ags-network-scripts

SCRIPT_NAME=$(basename "$0")
ACTION="${1:-info}"

# Substituted while generating: this script ends up in ~/.local/bin and
# cannot work out where the package it belongs to was installed.
ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"

# Zerlegt EINE Zeile aus `nmcli -t` in ihre Felder, ein Feld je Zeile.
#
# nmcli(1) beschreibt die Regel unter `-e|--escape`: im knappen Modus
# trennt ein Doppelpunkt die Felder, und ein Doppelpunkt ODER ein
# Backslash, der im Wert selbst steht, bekommt einen Backslash
# vorangestellt. `-e yes` ist die Voreinstellung, die Ausgabe ist also
# immer so geschuetzt.
#
# `IFS=:` und `cut -d:` kennen diese Regel nicht - sie trennen auch an
# einem geschuetzten Doppelpunkt. Eine SSID wie "Cafe: Gast" kommt als
# "Cafe\: Gast" an und schob damit jedes folgende Feld um eins weiter:
# die Signalstaerke landete im Namen, die Verschluesselung in der
# Signalstaerke, und der Name selbst trug einen Backslash, den niemand
# vergeben hat.
#
# Ein Feld kann keinen Zeilenumbruch enthalten - die Ausgabe ist
# zeilenweise - deshalb ist "ein Feld je Zeile" eine verlustfreie
# Uebergabe. Ganz in bash, ohne weiteres Programm: dieses Skript laeuft
# aus der Leiste heraus mehrmals je Minute.
nmcli_fields() {
    local line="$1"
    local field="" index=0 character
    while [ "$index" -lt "${#line}" ]; do
        character="${line:index:1}"
        if [ "$character" = "\\" ]; then
            # Was hinter dem Schutzzeichen steht, steht fuer sich selbst:
            # aus "\:" wird ":", aus "\\" wird "\".
            index=$((index + 1))
            field+="${line:index:1}"
        elif [ "$character" = ":" ]; then
            printf '%s\n' "$field"
            field=""
        else
            field+="$character"
        fi
        index=$((index + 1))
    done
    printf '%s\n' "$field"
}

# Das n-te Feld (ab 1) einer Zeile aus `nmcli -t`.
nmcli_field() {
    local line="$1" wanted="$2"
    local fields=()
    mapfile -t fields < <(nmcli_fields "$line")
    printf '%s\n' "${fields[wanted - 1]}"
}

# Get current WiFi SSID
#
# Das Feld ACTIVE ist "yes" oder "no" und kann weder Doppelpunkt noch
# Backslash tragen; danach beginnt der Name, den der Aufsteller des
# Zugangspunktes vergeben hat.
get_wifi_ssid() {
    local line
    while IFS= read -r line; do
        case "$line" in
            yes:*) nmcli_field "$line" 2; return ;;
        esac
    done < <(LANG=C nmcli -t -f active,ssid dev wifi 2>/dev/null)
}

# get_wifi_signal() stand hier und ist am 17.08.2026 mit seinem einzigen
# Leser gegangen: network_icon(). Die Signalstaerke sagt seither das
# Leistenmodul selbst (bar-status-config.template, network_module) und
# das Netzfenster ueber `list` - beide fragen nmcli direkt.

# Check if ethernet is connected
#
# Ohne nmcli_fields: TYPE und STATE stammen beide von NetworkManager
# selbst ("ethernet", "connected"), niemand kann einen Doppelpunkt
# hineinschreiben, und nur Felder mit fremdem Text brauchen den Zerleger.
is_ethernet_connected() {
    LANG=C nmcli -t -f TYPE,STATE dev 2>/dev/null | grep -q 'ethernet:connected'
}

# Network info (SSID or "Kabelverbindung" or "Nicht verbunden")
network_info() {
    local ssid=$(get_wifi_ssid)
    if [ -n "$ssid" ]; then
        echo "$ssid"
    elif is_ethernet_connected; then
        echo "Kabelverbindung"
    else
        echo "Nicht verbunden"
    fi
}

# Get IP address
network_ip() {
    ip -4 route get 1 2>/dev/null | awk '{print $7; exit}'
}

# VPN info
vpn_info() {
    # Check StrongSwan first (used for IPsec VPN).
    #
    # Welche Adresse der Tunnel hat, beantwortet vpn.py - aus dem, was
    # strongSwan gemeldet hat. Hier stand ein `grep` ueber `ip addr
    # show` auf den Adressbereich eines bestimmten Gateways: bei jedem
    # anderen fand die Zeile nichts, und das Widget zeigte "Aus",
    # waehrend der Tunnel stand.
    local vpn_state="" vpn_ip=""
    read -r vpn_state vpn_ip <<< "$(python3 "$ZEPOS_SYSTEM_ROOT/vpn.py" --status 2>/dev/null)"
    case "$vpn_state" in
        connected)
            if [ -n "$vpn_ip" ]; then
                echo "Verbunden ($vpn_ip)"
            else
                echo "Verbunden"
            fi
            return
            ;;
        stale)
            echo "Unvollständig"
            return
            ;;
    esac
    # Fallback: check NetworkManager VPN
    #
    # Geprueft wird die SPALTE, nicht die Zeile. `grep vpn` traf jede
    # Zeile, in der irgendwo "vpn" stand - auch eine WLAN-Verbindung, die
    # der Benutzer "Buero vpn" genannt hat. Der Name ist ausserdem das
    # Feld, das einen geschuetzten Doppelpunkt tragen kann, weshalb er
    # ueber nmcli_fields kommt und nicht ueber `cut`.
    local line fields=()
    while IFS= read -r line; do
        mapfile -t fields < <(nmcli_fields "$line")
        case "${fields[1]}" in
            *vpn*)
                if [ "${fields[2]}" = "activated" ]; then
                    echo "${fields[0]}"
                    return
                fi
                ;;
        esac
    done < <(nmcli -t -f NAME,TYPE,STATE con show --active 2>/dev/null)
    echo "Aus"
}

# Printer info
printer_info() {
    local count=$(lpstat -p 2>/dev/null | grep -c 'printer' 2>/dev/null)
    count=${count:-0}
    count=$(echo "$count" | tr -d '[:space:]')
    if [ -z "$count" ] || [ "$count" = "0" ]; then
        echo "Kein Drucker"
    elif [ "$count" = "1" ]; then
        echo "1 Drucker"
    else
        echo "$count Drucker"
    fi
}

# Watchdog info
#
# network-watchdog.service is the name generate_config.sh writes into
# ~/.config/systemd/user. Both functions below asked about
# "watchdog.service", which no unit on the system is called, so
# is-active answered "inactive" for a daemon that was running: the bar
# module - which asks for the right name - showed the heartbeat as fine
# while the AGS control centre read "Watchdog: Inaktiv" on the same
# screen at the same moment.
watchdog_info() {
    if systemctl --user is-active network-watchdog.service &>/dev/null; then
        echo "Aktiv"
    else
        echo "Inaktiv"
    fi
}

# Watchdog class
watchdog_class() {
    if systemctl --user is-active network-watchdog.service &>/dev/null; then
        echo "active"
    else
        echo ""
    fi
}

# Network list (JSON for AGS)
network_list() {
    local rescan="$1"
    if [ "$rescan" = "rescan" ]; then
        LANG=C nmcli dev wifi rescan 2>/dev/null
        sleep 1
    fi

    # Get active SSID first
    local active_ssid=$(get_wifi_ssid)

    # Gebaut mit jq, nicht mit echo.
    #
    # Eine SSID wird von dem vergeben, der den Zugangspunkt aufstellt -
    # sie darf ein Anführungszeichen oder einen Backslash enthalten, und
    # jedes davon schloss die JSON-Zeichenkette zu früh. AGS bekam dann
    # kaputtes JSON und zeigte die GANZE Netzwerkliste nicht mehr an:
    # eine fremde SSID in Reichweite legte das Widget lahm.
    # Zerlegt mit nmcli_fields, nicht mit `IFS=:`.
    #
    # Aus dem Namen eines fremden Zugangspunktes kommt ein geschuetzter
    # Doppelpunkt zurueck, und `IFS=:` trennte auch an dem: aus
    # "Cafe\: Gast:72:WPA2:no" wurden fuenf Felder statt vier, die
    # Signalstaerke war " Gast", `tonumber?` machte daraus 0, und der
    # Name trug einen Backslash, den niemand vergeben hat.
    #
    # Aus demselben Grund sind `sort -t: -k2 -rn` und `awk -F: '!seen'`
    # verschwunden: beide trennen ebenfalls am geschuetzten Doppelpunkt,
    # also sortierte das eine nach dem falschen Feld und das andere fasste
    # nach einem abgeschnittenen Namen zusammen. Beides macht jetzt jq,
    # unten, auf den fertig zerlegten Werten.
    local entries=()
    local line fields=() ssid signal security
    while IFS= read -r line; do
        mapfile -t fields < <(nmcli_fields "$line")
        ssid="${fields[0]}"
        signal="${fields[1]}"
        security="${fields[2]}"
        [ -z "$ssid" ] && continue
        local is_active="false"
        # Check if this is the active network
        [ "$ssid" = "$active_ssid" ] && is_active="true"
        local is_secure="false"
        [ -n "$security" ] && [ "$security" != "--" ] && is_secure="true"
        # Die Signalstärke kommt ebenfalls von aussen; als --arg
        # hereingegeben und in jq nach Zahl gewandelt, damit ein leeres
        # Feld eine 0 ergibt statt einer Datei ohne Wert an dieser Stelle.
        entries+=("$(jq -cn --arg ssid "$ssid" --arg signal "$signal" \
            --argjson secure "$is_secure" --argjson active "$is_active" \
            '{ssid: $ssid, signal: ($signal | tonumber? // 0),
              secure: $secure, active: $active}')")
    done < <(LANG=C nmcli -t -f SSID,SIGNAL,SECURITY,ACTIVE dev wifi list 2>/dev/null)

    if [ ${#entries[@]} -eq 0 ]; then
        echo "[]"
    else
        # Je Name der staerkste Eintrag, absteigend nach Signal - dieselbe
        # Auswahl wie vorher `sort | awk`, nur auf Werten statt auf Text.
        printf '%s\n' "${entries[@]}" \
            | jq -s -c 'group_by(.ssid) | map(max_by(.signal))
                        | sort_by(-.signal)'
    fi
}

# Network connect
network_connect() {
    local ssid="$1"
    local password="$2"

    if [ -n "$password" ]; then
        nmcli dev wifi connect "$ssid" password "$password" 2>&1
    else
        nmcli connection up "$ssid" 2>/dev/null || nmcli dev wifi connect "$ssid" 2>&1
    fi
}

# Network details
network_details() {
    local info=$(nmcli -t -f NAME,TYPE,DEVICE,STATE con show --active 2>/dev/null | head -1)
    if [ -n "$info" ]; then
        # Der Name gehoert dem Benutzer und darf einen Doppelpunkt
        # enthalten. `cut -d: -f1` schnitt ihn dort ab und schob Typ und
        # Geraet um ein Feld weiter, sodass das Widget als Typ den Rest
        # des Namens anzeigte.
        local fields=()
        mapfile -t fields < <(nmcli_fields "$info")
        local name="${fields[0]}"
        local type="${fields[1]}"
        local device="${fields[2]}"
        local ip=$(network_ip)
        local gateway=$(ip route | grep default | awk '{print $3}')
        local dns=$(grep nameserver /etc/resolv.conf 2>/dev/null | head -1 | awk '{print $2}')

        # Derselbe Grund wie in network_list: der Verbindungsname wird
        # vom Benutzer vergeben, und ein Anführungszeichen darin machte
        # aus dieser Antwort kaputtes JSON.
        jq -n --arg name "$name" --arg type "$type" --arg device "$device" \
              --arg ip "$ip" --arg gateway "$gateway" --arg dns "$dns" \
              '{name: $name, type: $type, device: $device,
                ip: $ip, gateway: $gateway, dns: $dns}'
    else
        echo "{}"
    fi
}

# Main dispatcher
#
# ZWEI ANTWORTEN SIND AM 17.08.2026 GEGANGEN, UND ZWAR WEIL NIEMAND SIE
# MEHR STELLT
#
#     `icon`        gab ein WLAN-Zeichen aus. Sein einziger Leser war
#                   getNetworkIcon() im Kontrollzentrum, und dessen
#                   Netzzeile ist an diesem Tag auf die Leiste gezogen -
#                   dort kommt das Zeichen aus status.sh
#                   (bar-status-config.template), das dieselbe Frage
#                   ohnehin schon beantwortet.
#     `bluetooth`   zaehlte verbundene Geraete. Sein einziger Leser war
#                   getBluetoothStatus(), aus derselben Zeile. Die
#                   Bluetooth-Bedienung steht seit heute in einem
#                   eigenen Fenster (ags-bluetooth.template), das
#                   bluetoothctl SELBST fragt - mit Frist, was dieses
#                   Skript nie tat.
#
#     Gezaehlt am selben Tag ueber den ganzen Baum: `grep -rn
#     network_icon\|bluetooth_info` fand nach dem Umbau nur noch diese
#     Datei. Ein Zweig, den niemand ruft, ist kein Vorrat, sondern eine
#     zweite Antwort auf eine Frage, die anderswo schon beantwortet
#     wird - und die beiden waeren beim naechsten Umbau auseinander
#     gelaufen.
case "$ACTION" in
    info) network_info ;;
    ip) network_ip ;;
    vpn) vpn_info ;;
    printer) printer_info ;;
    watchdog) watchdog_info ;;
    watchdog-class) watchdog_class ;;
    list) network_list "$2" ;;
    connect) network_connect "$2" "$3" ;;
    details) network_details ;;
    *) echo "Usage: $0 {info|ip|vpn|printer|watchdog|watchdog-class|list|connect|details}" ;;
esac
