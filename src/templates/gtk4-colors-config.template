/* --- die Flaechen ------------------------------------------------- */
/* Der Rahmen traegt das Petrol, der Inhalt das Ink darunter. */
@define-color window_bg_color {{STYLE_GTK4_WINDOW_BG}};
@define-color window_fg_color {{STYLE_GTK4_WINDOW_FG}};
@define-color view_bg_color {{STYLE_GTK4_VIEW_BG}};
@define-color view_fg_color {{STYLE_GTK4_VIEW_FG}};
@define-color headerbar_bg_color {{STYLE_GTK4_HEADERBAR_BG}};
@define-color headerbar_fg_color {{STYLE_GTK4_HEADERBAR_FG}};
@define-color headerbar_border_color {{STYLE_GTK4_BORDER}};
@define-color headerbar_backdrop_color {{STYLE_GTK4_WINDOW_BG}};
@define-color sidebar_bg_color {{STYLE_GTK4_SIDEBAR_BG}};
@define-color sidebar_fg_color {{STYLE_GTK4_SIDEBAR_FG}};
@define-color sidebar_backdrop_color {{STYLE_GTK4_SIDEBAR_BG}};
@define-color sidebar_border_color {{STYLE_GTK4_BORDER}};
@define-color secondary_sidebar_bg_color {{STYLE_GTK4_SIDEBAR_BG}};
@define-color secondary_sidebar_fg_color {{STYLE_GTK4_SIDEBAR_FG}};
@define-color secondary_sidebar_border_color {{STYLE_GTK4_BORDER}};
@define-color card_bg_color {{STYLE_GTK4_CARD_BG}};
@define-color card_fg_color {{STYLE_GTK4_WINDOW_FG}};
@define-color dialog_bg_color {{STYLE_GTK4_DIALOG_BG}};
@define-color dialog_fg_color {{STYLE_GTK4_WINDOW_FG}};
@define-color popover_bg_color {{STYLE_GTK4_POPOVER_BG}};
@define-color popover_fg_color {{STYLE_GTK4_WINDOW_FG}};
/* Die Flaeche hinter einem Vorschaubild. Sie ist bewusst das Ink und
 * nicht das Petrol: ein Bild mit durchsichtigem Grund soll vor dem
 * dunkelsten Ton stehen, sonst faerbt der Rahmen das Bild. */
@define-color thumbnail_bg_color {{STYLE_GTK4_VIEW_BG}};
@define-color thumbnail_fg_color {{STYLE_GTK4_WINDOW_FG}};

/* --- der Akzent --------------------------------------------------- */
/* accent_color wird gelesen, accent_bg_color wird gesehen - siehe
 * src/style_definition.py, Abschnitt "DIE FREMDEN GTK4-FENSTER". */
@define-color accent_color {{STYLE_GTK4_ACCENT}};
@define-color accent_bg_color {{STYLE_GTK4_ACCENT_BG}};
@define-color accent_fg_color {{STYLE_GTK4_ACCENT_FG}};

/* --- die Zustaende ------------------------------------------------ */
/* Gruen heisst gut und rot heisst schlecht, auch auf dieser Marke.
 * src/brand.py begruendet im Kopf, warum diese drei ausdruecklich NICHT
 * auf die Firmenfarben gezogen werden: eine Distribution, die ihre
 * Fehlerzustaende ins Cyan umfaerbt, versteckt Fehler, um aufgeraeumt
 * auszusehen. */
@define-color success_color {{STYLE_GTK4_SUCCESS}};
@define-color success_bg_color {{STYLE_GTK4_SUCCESS_BG}};
@define-color success_fg_color {{STYLE_GTK4_ON_STATE_FG}};
@define-color warning_color {{STYLE_GTK4_WARNING}};
@define-color warning_bg_color {{STYLE_GTK4_WARNING_BG}};
@define-color warning_fg_color {{STYLE_GTK4_ON_STATE_FG}};
@define-color error_color {{STYLE_GTK4_ERROR}};
@define-color error_bg_color {{STYLE_GTK4_ERROR_BG}};
@define-color error_fg_color {{STYLE_GTK4_ON_STATE_FG}};
/* "Loeschen" traegt dieselbe Farbe wie ein Fehler, und das ist Absicht:
 * libadwaita trennt die beiden Namen, damit man sie trennen KANN - hier
 * gibt es keinen Grund dazu, und zwei Rottoene nebeneinander waeren
 * zwei Bedeutungen, die niemand auseinanderhaelt. */
@define-color destructive_color {{STYLE_GTK4_ERROR}};
@define-color destructive_bg_color {{STYLE_GTK4_ERROR_BG}};
@define-color destructive_fg_color {{STYLE_GTK4_ON_STATE_FG}};

/* --- was darueber liegt ------------------------------------------- */
/* Der Schatten unter einer Kopfleiste und der Rand einer Karte. Beide
 * sind Formen, keine Schrift, also stehen hier die Randfarbe und der
 * dunkelste Ton statt eines Textwertes. */
@define-color shade_color {{STYLE_GTK4_VIEW_BG}};
@define-color headerbar_shade_color {{STYLE_GTK4_VIEW_BG}};
@define-color sidebar_shade_color {{STYLE_GTK4_VIEW_BG}};
@define-color secondary_sidebar_shade_color {{STYLE_GTK4_VIEW_BG}};
@define-color card_shade_color {{STYLE_GTK4_VIEW_BG}};
@define-color scrollbar_outline_color {{STYLE_GTK4_BORDER}};
/* Die zweite Textstufe: Einheiten, Datumsangaben, die Haelfte einer
 * Beschriftung, die nicht der Wert ist. */
@define-color dimmed_color {{STYLE_GTK4_SUBTEXT}};

/* --- dieselben Werte als CSS-Variablen ----------------------------- */
/* Warum das kein doppelt Gemoppeltes ist, sondern die Haelfte, die
 * ankommt, steht oben unter "WARUM @define-color UND ZUSAETZLICH DIE
 * CSS-VARIABLEN" - mit den Zahlen der Messung vom 12.08.2026.
 *
 * Die Reihenfolge ist die der Bloecke darueber, damit die zwei
 * Fassungen einer Farbe nebeneinander gelesen werden koennen. */
:root {
    /* die Flaechen */
    --window-bg-color: {{STYLE_GTK4_WINDOW_BG}};
    --window-fg-color: {{STYLE_GTK4_WINDOW_FG}};
    --view-bg-color: {{STYLE_GTK4_VIEW_BG}};
    --view-fg-color: {{STYLE_GTK4_VIEW_FG}};
    --headerbar-bg-color: {{STYLE_GTK4_HEADERBAR_BG}};
    --headerbar-fg-color: {{STYLE_GTK4_HEADERBAR_FG}};
    --headerbar-border-color: {{STYLE_GTK4_BORDER}};
    --headerbar-backdrop-color: {{STYLE_GTK4_WINDOW_BG}};
    --sidebar-bg-color: {{STYLE_GTK4_SIDEBAR_BG}};
    --sidebar-fg-color: {{STYLE_GTK4_SIDEBAR_FG}};
    --sidebar-backdrop-color: {{STYLE_GTK4_SIDEBAR_BG}};
    --sidebar-border-color: {{STYLE_GTK4_BORDER}};
    --secondary-sidebar-bg-color: {{STYLE_GTK4_SIDEBAR_BG}};
    --secondary-sidebar-fg-color: {{STYLE_GTK4_SIDEBAR_FG}};
    --secondary-sidebar-border-color: {{STYLE_GTK4_BORDER}};
    --card-bg-color: {{STYLE_GTK4_CARD_BG}};
    --card-fg-color: {{STYLE_GTK4_WINDOW_FG}};
    --dialog-bg-color: {{STYLE_GTK4_DIALOG_BG}};
    --dialog-fg-color: {{STYLE_GTK4_WINDOW_FG}};
    --popover-bg-color: {{STYLE_GTK4_POPOVER_BG}};
    --popover-fg-color: {{STYLE_GTK4_WINDOW_FG}};
    --thumbnail-bg-color: {{STYLE_GTK4_VIEW_BG}};
    --thumbnail-fg-color: {{STYLE_GTK4_WINDOW_FG}};

    /* der Akzent. Die erste der sechs Zeilen, die ueber den alten
     * Namen NICHT ankommen - libadwaita rechnet --accent-color sonst
     * aus --accent-bg-color aus und trifft dabei 2,10:1. */
    --accent-color: {{STYLE_GTK4_ACCENT}};
    --accent-bg-color: {{STYLE_GTK4_ACCENT_BG}};
    --accent-fg-color: {{STYLE_GTK4_ACCENT_FG}};

    /* die Zustaende. Dieselbe Lage wie beim Akzent, viermal. */
    --success-color: {{STYLE_GTK4_SUCCESS}};
    --success-bg-color: {{STYLE_GTK4_SUCCESS_BG}};
    --success-fg-color: {{STYLE_GTK4_ON_STATE_FG}};
    --warning-color: {{STYLE_GTK4_WARNING}};
    --warning-bg-color: {{STYLE_GTK4_WARNING_BG}};
    --warning-fg-color: {{STYLE_GTK4_ON_STATE_FG}};
    --error-color: {{STYLE_GTK4_ERROR}};
    --error-bg-color: {{STYLE_GTK4_ERROR_BG}};
    --error-fg-color: {{STYLE_GTK4_ON_STATE_FG}};
    --destructive-color: {{STYLE_GTK4_ERROR}};
    --destructive-bg-color: {{STYLE_GTK4_ERROR_BG}};
    --destructive-fg-color: {{STYLE_GTK4_ON_STATE_FG}};

    /* was darueber liegt */
    --shade-color: {{STYLE_GTK4_VIEW_BG}};
    --headerbar-shade-color: {{STYLE_GTK4_VIEW_BG}};
    --sidebar-shade-color: {{STYLE_GTK4_VIEW_BG}};
    --secondary-sidebar-shade-color: {{STYLE_GTK4_VIEW_BG}};
    --card-shade-color: {{STYLE_GTK4_VIEW_BG}};
    --scrollbar-outline-color: {{STYLE_GTK4_BORDER}};

    /* DREI NAMEN, DIE OBEN FEHLTEN
     * libadwaita 1.9.2 fuehrt 42 Bruecken vom alten Namen zur
     * Variablen; die @define-color-Liste darueber setzt 42 minus die
     * fuenf gerechneten, also 37 davon - und laesst diese drei aus.
     * Sie standen damit auf Adwaitas Vorgabe, waehrend alles um sie
     * herum die Marke trug.
     *
     *   headerbar_darker_shade_color   der Schatten unter einer
     *                                  Kopfleiste im Vollbild
     *   popover_shade_color            der Schatten eines Aufklappers
     *   secondary_sidebar_backdrop_color  die zweite Seitenleiste,
     *                                  wenn das Fenster nicht vorn ist
     *
     * Alle drei sind Flaechen oder Schatten, also bekommen sie
     * dieselben Werte wie ihre Geschwister zwei Bloecke weiter oben. */
    --headerbar-darker-shade-color: {{STYLE_GTK4_VIEW_BG}};
    --popover-shade-color: {{STYLE_GTK4_VIEW_BG}};
    --secondary-sidebar-backdrop-color: {{STYLE_GTK4_SIDEBAR_BG}};

    /* DIE VIER, DIE NUR IM DUNKLEN MODUS GESETZT WERDEN
     * libadwaita hat genau drei `@media (prefers-color-scheme: dark)`
     * Bloecke, und der dritte setzt diese vier. Er greift auf diesem
     * Schreibtisch nicht (die Messung oben), also standen sie auf den
     * hellen Vorgaben: --overview-bg-color war #f3f3f5, ein fast
     * weisses Grau, in einem sonst petrolfarbenen Fenster. */
    --active-toggle-bg-color: {{STYLE_GTK4_CARD_BG}};
    --active-toggle-fg-color: {{STYLE_GTK4_WINDOW_FG}};
    --overview-bg-color: {{STYLE_GTK4_VIEW_BG}};
    --overview-fg-color: {{STYLE_GTK4_WINDOW_FG}};

    /* DIE DECKKRAFT, MIT DER JEDE NEBENZEILE GEMALT WIRD
     *
     * GEMELDET am 01.09.2026: "die einstellungen sind irgendwie
     * verbuggt, die schrift ist so blass, man kann sie kaum sehen". Es
     * ist nicht das Einstellungsfenster - es ist jedes GTK4-Fenster auf
     * diesem Rechner, und der Grund steht weiter oben schon seit dem
     * 12.08.2026: `--dimmed-color` gibt es nicht, 1.9 blendet mit
     * `--dim-opacity` ab. Das `@define-color dimmed_color` oben wird
     * fuer diese Knoten also NIE gelesen. Dieser Absatz ist die
     * Folgerung daraus, die bis heute niemand gezogen hat.
     *
     * GEMESSEN am 01.09.2026 an libadwaita 1.9.3, aus dem Blatt, das
     * `gresource extract /usr/lib/libadwaita-1.so.0
     *  /org/gnome/Adwaita/styles/gtk.css` herausholt:
     *
     *     :root { --dim-opacity: 55%; }
     *     .dimmed, row label.subtitle, .dim-label, headerbar .subtitle,
     *     windowtitle .subtitle, entry > text > placeholder,
     *     label.separator { opacity: var(--dim-opacity); }
     *
     * Und was diese 55 % auf DIESER Palette ergeben, WCAG 2.1 SC 1.4.3
     * verlangt 4,5:1 fuer Fliesstext:
     *
     *     Grund                       dimmed_color   libadwaitas 55 %
     *     Fenster/Kopfleiste/Popover      6,57:1           4,15:1
     *     Zeile einer boxed-list          7,48:1           4,52:1
     *     Ansicht (view_bg)               8,81:1           4,96:1
     *
     * Die linke Spalte ist, was ZepOS gemeint hat; die rechte, was
     * ankommt. Im Thema "Tageslicht" faellt jede der drei Zeilen durch
     * (4,17 / 3,95 / 4,07).
     *
     * Der Wert hier ist ABGELEITET und nicht gewaehlt: es ist die
     * Deckkraft, bei der die Vordergrundfarbe auf dem Fenstergrund genau
     * dimmed_color ergibt - dieselbe zweite Textstufe, mit der jede
     * AGS-Flaeche ihre Nebenzeilen schreibt. Die Rechnung, die drei
     * Kanaele und die Gegenprobe stehen bei brand.dim_opacity().
     *
     * NICHT MITGEHOBEN: --disabled-opacity (50 %) und --border-opacity
     * (15 %). Ein abgeschaltetes Bedienelement soll abgeschaltet
     * aussehen - WCAG 1.4.3 nimmt es woertlich aus -, und eine
     * Trennlinie zwischen zwei Zeilen traegt keine Auskunft. */
    --dim-opacity: {{STYLE_ADWAITA_DIM_OPACITY}};

    /* UND DIE RECHENVORSCHRIFT SELBST
     * Die fuenf Zeilen oben setzen die Zustandsfarben fest, und damit
     * ist der haeufigste Fall erledigt. libadwaita rechnet sie an vier
     * Stellen aber NOCH EINMAL aus, jeweils lokal, nachdem es die
     * Flaechenfarbe dort veraendert hat - in `.osd`, in `toast`, in
     * `toggle-group.osd > toggle:checked` und im Dateiauswaehler
     * (`filechooser ... { --accent-bg-color: #959595; }`). Die ersten
     * drei setzen ihre eigene Vorschrift daneben und sind richtig; der
     * Dateiauswaehler erbt diese hier.
     *
     * `max(l, 0.85)` ist woertlich das, was libadwaitas eigener
     * dunkler Block setzt - hier steht es nicht als Erfindung, sondern
     * weil der Block nicht greift. */
    --standalone-color-oklab: max(l, 0.85) a b;
}
