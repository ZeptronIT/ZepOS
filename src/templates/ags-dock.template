//     einem fehlgeschlagenen Lesevorgang GAR NICHTS schreiben.
//
//     `settings.py dock add|remove` tut beides in einem Prozess. Was
//     hier bleibt, ist der Aufruf - ueber utils/user-settings.ts,
//     dasselbe Modul, das auch das Home benutzt. Gerechnet wird dabei
//     nicht anders: settings.dock_plan() ruft genau die vier
//     Funktionen, die die Bruecke fuer dasselbe Bedienelement ruft.
//
//     bar.dock_pins BEDEUTET WEITERHIN DASSELBE. Die Liste, ihre Form
//     und ihr Verhaeltnis zu dock_baseline sind unveraendert; nur der
//     Weg dorthin ist einer statt dreier.

// =====================================================================
// DAS RECHTSKLICK-MENUE
// =====================================================================

/** Ein Punkt des Menues. */
interface MenueEintrag {
  symbol: string
  text: string
  tun: () => void
}

/** Das Menue an einem Knopf aufklappen.
 *
 * NICHT Gtk.PopoverMenu, SONDERN Gtk.Popover MIT ZEILEN AUS DEM BAUSATZ
 *     Gtk.PopoverMenu nimmt ein Gio.MenuModel und zeichnet seine
 *     Eintraege SELBST - als `modelbutton`, ein Knotentyp, den GTK
 *     stylt und den ags-style.template nicht kennt. Ein Menue daraus
 *     saehe aus wie Adwaita und nicht wie ZepOS, und die einzige
 *     Antwort darauf waere eine zweite Knopfform im Stylesheet, die
 *     genau eine Stelle benutzt.
 *
 *     zepRow IST die klickbare Zeile dieses Schreibtischs - Symbol
 *     links, Text daneben, durchsichtige Huelle, `.zep-row` mit Radius,
 *     Polsterung und Zeigergrund aus ags-style.template. Ein Menue ist
 *     eine Liste solcher Zeilen und braucht dafuer kein eigenes
 *     Bauteil; dass hier trotzdem KEIN zepMenu() im Bausatz entsteht,
 *     ist eine Entscheidung und steht im Bericht zu dieser Aufgabe.
 *
 * DIE FLAECHE, UND DASS SIE UEBER DEN RAND DARF
 *     Der Fuss ist eine Layer-Shell-Flaeche von der Groesse seiner
 *     Knopfreihe - GEMESSEN am 20.08.2026 (784, 996, 353, 60) bei der
 *     ausgelieferten Auswahl. Ein Menue darin waere 60 Punkte hoch,
 *     wenn es in der Flaeche bliebe, also unbrauchbar. Es bleibt nicht
 *     darin: GTK4 legt einen Gtk.Popover als EIGENE Wayland-Flaeche an
 *     (xdg_popup), und gtk4-layer-shell haengt sie ueber
 *     zwlr_layer_surface_v1.get_popup an die Layer-Flaeche. Die
 *     Messung dazu steht im Kopf, "DAS MENUE UEBER DEM FUSS".
 *
 * ES GEHT WIEDER ZU, UND ZWAR AUF DREI WEGEN - ALLE DREI AUS `autohide`
 *     Klick daneben  der Popup haelt einen Griff (xdg_popup.grab). Wer
 *                    daneben klickt, beendet ihn; GTK meldet "closed".
 *     Escape         derselbe Griff. Der Compositor gibt dem POPUP den
 *                    Tastaturfokus, nicht dem Fuss darunter.
 *     Auswahl        jede Zeile klappt zuerst zu und tut dann ihres.
 *
 *     WAS HIER NICHT STEHT, UND WARUM NICHT: eine Umschaltung der
 *     Tastaturannahme des Fusses (Astal.Keymode.ON_DEMAND, solange das
 *     Menue steht). Sie stand hier, mit der Begruendung, eine
 *     Layer-Flaeche auf Keymode.NONE bekomme vom Compositor gar keine
 *     Tastenereignisse - der Satz stimmt fuer die FLAECHE und gilt
 *     nicht fuer ihren Popup.
 *
 *     GEMESSEN am 20.08.2026 (tests/render/test_menue.py, derselbe
 *     Lauf einmal mit und einmal ohne die Umschaltung): der
 *     Wayland-Mitschnitt zeigt `wl_keyboard.enter(..., wl_surface#178)`
 *     auf die Flaeche des POPUPS, und Escape von aussen (wtype)
 *     schliesst das Menue in BEIDEN Faellen. Die Umschaltung war also
 *     wirkungslos - und nicht folgenlos: der Fuss verspricht an drei
 *     Stellen, die Tastatur NIE zu nehmen (ags-power-button.template,
 *     ags-starter-button.template, Dock() unten). Ein Versprechen, das
 *     fuer eine Zeile ohne Wirkung gebrochen wird, ist keines.
 *
 * EIN MENUE JE RECHTSKLICK, UND DANACH IST ES WEG
 *     Zwischendurch stand hier die Gegenrichtung: EIN Popover je Knopf,
 *     bei seinem Knopf gebaut, aufgeklappt befuellt, zugeklappt
 *     geleert. Sie ist gemessen und wieder gefallen, und beide Zahlen
 *     stehen hier, damit niemand denselben Weg noch einmal geht.
 *
 *     WAS SIE HEILEN SOLLTE: eine Warnung beim Zugehen. GEMESSEN am
 *     20.08.2026 (tests/render/test_menue.py):
 *
 *         Gtk-CRITICAL: gtk_widget_is_ancestor:
 *                       assertion 'GTK_IS_WIDGET (widget)' failed
 *
 *     WAS SIE NICHT GEHEILT HAT: dieselbe Warnung, gleiche Anzahl. Die
 *     Eingrenzung danach hat gezeigt, dass sie gar nicht beim Zugehen
 *     entsteht, sondern beim AUFklappen, und dass sie an `autohide`
 *     haengt - an einem leeren Popover ohne jede Zeile genauso. Sie
 *     steht deshalb in GTKs eigener Buchfuehrung und nicht in dieser
 *     Datei; die Eingrenzung ist in
 *     test_die_eine_fremde_warnung_bleibt_die_eine_fremde_warnung
 *     aufgeschrieben.
 *
 *     WAS SIE GEKOSTET HAT: sieben neue Warnungen, eine je angeheftetem
 *     Knopf, beim Beenden der Oberflaeche (GEMESSEN in
 *     tests/src/test_bar_headless.py):
 *
 *         Gtk-WARNING: Finalizing GtkButton 0x..., but it still has
 *                      children left
 *
 *     Ein Popover, das mit set_parent() an einem Knopf haengt, MUSS
 *     abgenommen sein, bevor der Knopf vergeht - und beim Beenden
 *     vergehen alle auf einmal. Ein Menue, das nur so lange existiert
 *     wie es offen ist, hat dieses Problem nicht: es gibt keines,
 *     solange niemand rechts geklickt hat, und nach dem Zugehen wieder
 *     keines.
 */
function zeigeMenue(anker: Gtk.Widget,
                    eintraege: MenueEintrag[]): Gtk.Popover | null {
  if (!eintraege.length) return null

  const liste = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL })

  // OHNE EIGENE KLASSEN, SEIT DEM 20.08.2026 (Aufgabe 50)
  //
  // Hier standen `liste.add_css_class("dock-menu")` und
  // `menue.add_css_class("dock-menu-popover")`. Beide hatten repo-weit
  // NULL Leser - `grep -rn "dock-menu" src/` fand genau diese zwei
  // Zeilen -, und das war der ganze Grund, aus dem das Menue am
  // 20.08.2026 weiss war: es gab zwei Handgriffe und keine Regel daran.
  //
  // Die Regel steht jetzt in ags-style.template, und sie steht dort auf
  // `popover > contents` und nicht auf einem dieser Namen. Das ist
  // Absicht und im Kopf jener Regel begruendet: es gibt in diesem Baum
  // ein zweites eigenes Popover (der Ueberlauf der Ablage,
  // ags-bar.template) und die Kontextmenues jeder Gtk.Entry, und alle
  // haben dieselbe weisse Platte. Ein Name, der nur hier gilt, haette
  // eines von drei Menues gerichtet.
  //
  // Damit sind die zwei Klassen ohne Leser - und eine Klasse ohne Leser
  // ist genau die Falle, in die dieses Menue schon einmal getreten ist.
  const menue = new Gtk.Popover({ has_arrow: false })
  menue.set_child(liste)
  menue.set_parent(anker)
  // Nach OBEN, weil der Fuss am unteren Bildschirmrand steht. GTK
  // richtet sich sonst nach dem Platz und klappte nach unten aus - also
  // aus dem Schirm heraus.
  menue.set_position(Gtk.PositionType.TOP)

  eintraege.forEach((eintrag, stelle) => {
    if (stelle) liste.append(zepDivider())
    const zeile = zepRow({
      symbol: eintrag.symbol,
      titel: eintrag.text,
      // DIE KOMPAKTE SPROSSE, UND WARUM SIE UND KEINE EIGENE
      //
      //     GEMELDET am 20.08.2026: "die icons bei rechtsklick ags
      //     fenster soll auch abstand zum text haben".
      //
      //     `navEintrag` ist kein "Navigationseintrag" im Sinne einer
      //     Seitenleiste, sondern der EINZEILIGE Zuschnitt derselben
      //     Zeile - der Bausatz sagt das selbst ("keine zweite
      //     Zeilenform, nur ein zusaetzlicher CSS-Modifikator auf
      //     DERSELBEN Zeile"). Ein Menuepunkt ist genau das: eine
      //     Zeile, ein Satz, kein Untertitel.
      //
      //     Und er bringt die Sprosse mit, die am 19.08.2026 (cadb681)
      //     schon einmal fuer genau diese Frage gewaehlt worden ist -
      //     GEMESSEN im erzeugten style.scss bei Vorgabegroesse:
      //
      //         .zep-row-texts                margin-left 18px
      //         .zep-row-nav .zep-row-texts   margin-left 12px
      //
      //     18px ist die Karte (STYLE_SPACE_12), 12px die kompakte
      //     Zeile (STYLE_SPACE_8) - die Sprosse, die dem Musterblatt
      //     mit seinen 10px am naechsten kommt. Eine dritte Zahl fuer
      //     das Menue waeren zwei Menues mit zwei Abstaenden.
      //
      //     WAS DAMIT NICHT BEHOBEN IST, und es ist gemessen: eine
      //     Gtk.Label mittet den VORSCHUB, sichtbar ist die TINTE.
      //     GEMESSEN am 20.08.2026 mit Pango, "Fira Code,
      //     JetBrainsMono Nerd Font" bei 20px - Vorschub bei allen vier
      //     Zeichen 12px:
      //
      //         ICON_PIN           Tinte 15   ragt 2px nach rechts
      //         ICON_MINUS         Tinte 15   ragt 3px nach rechts
      //         ICON_WINDOW        Tinte 14   ragt 2px nach rechts
      //         ICON_WINDOW_CLOSE  Tinte 12   ragt 0px nach rechts
      //
      //     Der SICHTBARE Abstand schwankt damit zwischen 9 und 12
      //     Punkten, obwohl im Stylesheet ueberall 12 steht. Die
      //     saubere Antwort waere eine eigene Zelle je Zeichen, wie
      //     .bar-symbol sie in der Leiste hat (dea3f0b) - die saesse
      //     aber in zepRow und damit in JEDEM Fenster dieses
      //     Schreibtischs. Siehe den Bericht zu dieser Aufgabe.
      navEintrag: true,
      // ERST ZU, DANN TUN. Andersherum stuende das Menue noch, waehrend
      // das Fenster darunter schon zugeht oder ein Programm startet -
      // und ein Menue ueber allen Fenstern ist genau das, was diese
      // Datei nicht bauen soll.
      aktion: () => {
        menue.popdown()
        eintrag.tun()
      },
    })
    liste.append(zeile)
  })

  // ABGENOMMEN IM LEERLAUF UND NICHT IM RUECKRUF: "closed" laeuft
  // MITTEN im Abbau des Popovers, GTK reicht danach noch den
  // Tastaturfokus zurueck. Wer in diesem Augenblick den Widgetbaum
  // anfasst, nimmt genau dem Widget den Boden weg, nach dem GTK gerade
  // fragt.
  menue.connect("closed", () => {
    GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
      if (menue.get_parent()) menue.unparent()
      return GLib.SOURCE_REMOVE
    })
  })

  menue.popup()
  return menue
}

interface Pin {
  program: string
  info: GioUnix.DesktopAppInfo
  button: Gtk.Button
}

/** Die angehefteten Anwendungen, einmal aufgeloest.
 *
 * Einmal und nicht bei jedem Ereignis: welche Programme installiert
 * sind, aendert sich nicht, waehrend jemand ein Fenster verschiebt, und
 * Gio.AppInfo.get_all() liest jedes .desktop auf der Maschine.
 *
 * DIE LISTE STEHT SEIT DEM 20.08.2026 IM AUFRUF und nicht mehr fest in
 * PINNED: das Rechtsklick-Menue aendert sie zur Laufzeit, und ein
 * zweites Aufloesen mit derselben Regel ist besser als eine zweite
 * Regel. PINNED ist der ANFANGSWERT - siehe DockContent().
 */
function resolvePins(namen: string[]): Pin[] {
  const pins: Pin[] = []
  for (const program of namen) {
    const info = entryFor(program)
    if (!info) {
      // Kein Fehlschlag der Sitzung: das Programm ist nicht (mehr)
      // installiert. Gehoert ins Protokoll und nicht auf das Dock.
      console.log(`Dock: kein Anwendungseintrag fuer "${program}" - nicht angeheftet`)
      continue
    }

    // DER EINTRAG, DER SAGT, DASS ER KEINE ANWENDUNG IST.
    //
    // Siehe den Kopf: das ist die eine Zeile, die das Zahnrad im Fuss
    // wegnimmt, ohne dass irgendwo "xdg-desktop-portal-gnome" steht.
    // Ein Dienst markiert seinen Eintrag mit NoDisplay=true, weil er
    // fuer den Menschen nicht zu starten ist - GIO liefert ihn
    // trotzdem aus (GEMESSEN am 12.08.2026: DesktopAppInfo.new(
    // "xdg-desktop-portal-gnome.desktop") gibt ein Objekt zurueck,
    // nicht null), also muss das Dock selbst hinsehen.
    if (info.get_nodisplay()) {
      console.log(`Dock: "${program}" ist ein Dienst (NoDisplay=true) - `
        + `nicht angeheftet; sein Eintrag "${info.get_display_name()}" `
        + `startet kein Fenster`)
      continue
    }
    const button = new Gtk.Button({ can_focus: false })
    button.add_css_class("dock-button")
    button.add_css_class("dock-pin")
    button.set_tooltip_text(info.get_display_name() || program)

    // Ein Eintrag OHNE Icon-Zeile. Selten, aber moeglich - und der
    // Rueckfall darf hier so wenig ein Zahnrad sein wie unten bei den
    // losen Fenstern: `application-x-executable` stand an beiden
    // Stellen und ist in Papirus-Dark ein Zahnkranz, also das Bild der
    // Systemeinstellungen. Dieselbe Verwechslung, dieselbe Antwort.
    const icon = info.get_icon()
    if (icon) {
      const image = new Gtk.Image({ pixel_size: ICON_SIZE })
      image.set_from_gicon(icon)
      button.set_child(image)
    } else {
      console.error(`Dock: der Eintrag von "${program}" nennt kein Symbol - `
        + "der Knopf bekommt das Ersatzzeichen")
      const label = new Gtk.Label({ label: UNKNOWN_WINDOW_ICON })
      label.add_css_class("dock-unknown")
      button.set_child(label)
    }

    pins.push({ program, info, button })
  }
  return pins
}

/** Der Inhalt des Docks: die Reihe Knoepfe.
 *
 * Getrennt vom Fenster, aus demselben Grund wie BarContent in Bar.tsx:
 * ein Gtk.Box laesst sich unter gtk4-broadwayd bauen und zaehlen, eine
 * Layer-Shell-Flaeche nicht.
 */
export function DockContent(): Gtk.Box {
  const box = new Gtk.Box({ orientation: Gtk.Orientation.HORIZONTAL })
  box.set_name("dock")

  // Der Trenner zwischen den angehefteten Anwendungen und den uebrigen
  // Fenstern. Er steht auch dann im Kasten, wenn rechts von ihm nichts
  // ist - dann unsichtbar; ein Trenner, der bei jedem Fensterwechsel neu
  // eingehaengt wird, waere ein Kind mehr, dessen Platz sich verschiebt.
  //
  // ER STEHT SEIT DEM 20.08.2026 ALS ERSTES IM KASTEN, und das ist die
  // eine Zeile, die die Anheftungen austauschbar macht: die Symbole
  // werden VOR ihn gehaengt (insert_child_after mit null = ganz nach
  // vorn), die losen Fenster dahinter. Wer die Reihe der Anheftungen
  // neu baut, muss damit weder den Trenner noch ein einziges
  // Fensterkind anfassen.
  const separator = new Gtk.Separator({ orientation: Gtk.Orientation.VERTICAL })
  separator.add_css_class("dock-separator")
  separator.set_visible(false)
  box.append(separator)

  const buttons = new Map<string, Gtk.Button>()
  // Die Klick-Verbindung je Knopf - angeheftet wie lose -, damit sie
  // ersetzt und nicht gestapelt wird: ein Knopf, der nach zehn
  // Ereignissen zehn Rueckrufe traegt, startet beim naechsten Klick zehn
  // Programme.
  //
  // Seit dem 20.08.2026 stehen auch die LOSEN Knoepfe darin. Ihr
  // Rueckruf war bis dahin einmalig, weil er immer dasselbe tat; jetzt
  // haengt er am Zustand (abgelegt? welcher Bereich ist sichtbar?) und
  // muss deshalb mitwandern. Der Schluessel ist der Knopf und nicht die
  // Adresse - dieselbe Begruendung wie unten bei den Anheftungen.
  const handlers = new Map<Gtk.Button, number>()

  // =================================================================
  // DIE ANGEHEFTETEN SYMBOLE - AUSTAUSCHBAR SEIT DEM 20.08.2026
  // =================================================================
  //
  // `namen` ist die Liste, die auf dem Fuss steht, `pins` sind die
  // Knoepfe dazu. Beide aendern sich, wenn jemand im Rechtsklick-Menue
  // anheftet oder abnimmt - und nur dann.
  //
  // PINNED IST DER ANFANGSWERT UND NICHT MEHR DIE WAHRHEIT, und das ist
  // der Unterschied zu jeder Fassung vor dem 20.08.2026. Was gilt, steht
  // in user-settings.json und kommt ueber `settings.py dock`; PINNED ist
  // der Abzug davon, den der Erzeugungslauf hier hineingeschrieben hat.
  //
  // ER WIRD SEIT DEM 21.08.2026 SOFORT NACHGEPRUEFT, und das ist der
  // Unterschied zu gestern: beobachteDock() unten liest die wirksame
  // Liste, sobald das Dock steht. Vorher galt PINNED, bis jemand im MENUE
  // dieses Fusses etwas anheftete - wer im Starter anheftete und die
  // Oberflaeche neu startete, ohne neu zu erzeugen, sah die alte Reihe
  // wieder. Der Abzug ist damit das, was in der ersten Bildschirmseite
  // steht, und nicht mehr das, was gilt.
  let namen: string[] = [...PINNED]
  let pins: Pin[] = []

  // Was auf dem HOME liegt. Nicht der Zustand dieses Fensters, sondern
  // der des anderen - gebraucht fuer die Richtung des Menuepunkts (siehe
  // homePunkt()) und frisch gehalten von derselben Ueberwachung, die
  // auch `namen` frisch haelt.
  let homeNamen: string[] = []

  /** Die Reihe der Anheftungen neu bauen. */
  const setzePins = (neue: string[]) => {
    for (const alt of pins) {
      box.remove(alt.button)
      // Und aus der Verbindungstabelle - dieselbe Begruendung wie unten
      // bei den losen Knoepfen: ein Eintrag ohne Knopf haelt sein
      // Gtk.Button-Objekt am Leben, solange das Dock laeuft.
      handlers.delete(alt.button)
    }
    namen = neue
    pins = resolvePins(namen)
    let vorher: Gtk.Widget | null = null
    for (const pin of pins) {
      // null heisst "ganz nach vorn", also vor den Trenner und vor
      // jedes lose Fenster. Siehe die Begruendung am Trenner oben.
      box.insert_child_after(pin.button, vorher)
      vorher = pin.button
      rechtsklick(pin.button, () => pinMenue(pin))
    }
  }

  /** Was ein Rechtsklick auf ein ANGEHEFTETES Symbol anbietet.
   *
   * DREI PUNKTE SEIT DEM 21.08.2026, UND JEDER TUT WIRKLICH ETWAS
   *     "Neues Fenster"       ruft starte() - genau den Weg, den ein
   *                           gewoehnlicher Klick nimmt, wenn die
   *                           Anwendung noch nicht laeuft. Er ist damit
   *                           kein neuer Code, sondern der vorhandene
   *                           ohne die Bedingung davor. Er ist der
   *                           EINZIGE Weg zu einem zweiten Fenster
   *                           einer laufenden Anwendung: der Linksklick
   *                           holt das erste nach vorn, und das ist so
   *                           gewollt ("wie Apple OS").
   *     das Home              "Zum Home hinzufuegen" oder "Vom Home
   *                           entfernen", je nachdem, was gerade dort
   *                           liegt - siehe homePunkt(). BESTELLT am
   *                           21.08.2026: "das gleiche muss bei der dock
   *                           auch funktionieren, weil ich nicht jedes
   *                           icon auf der dock oder auf dem home haben
   *                           will."
   *     "Vom Dock entfernen"  die Bestellung vom 20.08.2026, woertlich.
   *
   * WAS ABSICHTLICH FEHLT: "Schliessen". Ein angehefteter Knopf ist
   * EINER fuer alle Fenster seiner Anwendung (siehe den Kopf) - welches
   * davon "Schliessen" meinte, koennte niemand beantworten, und ein
   * Punkt, der bei drei Fenstern irgendeines davon trifft, ist
   * schlimmer als keiner. Zum Schliessen gibt es den Knopf des
   * Fensters, hinter dem Trenner.
   */
  const pinMenue = (pin: Pin): MenueEintrag[] => [
    {
      symbol: NEW_WINDOW_ICON,
      text: _("New window"),
      tun: () => starte(pin.info),
    },
    homePunkt(pin.program),
    {
      symbol: UNPIN_ICON,
      text: _("Remove from dock"),
      // OHNE setzePins() DAHINTER, seit dem 21.08.2026: die Aenderung
      // kommt ueber die Ueberwachung der Einstellungsdatei zurueck
      // (siehe beobachteDock() weiter unten), genau wie eine Aenderung aus
      // dem Home, aus dem Starter oder aus dem Einstellungsfenster. Ein
      // eigener Weg fuer den eigenen Schreibvorgang waere der einzige,
      // der je gepflegt wuerde - und die drei anderen blieben kaputt.
      tun: () => void dockRemove(pin.program),
    },
  ]

  /** Der Punkt, der dieses Programm aufs Home legt - oder es abnimmt.
   *
   * ER SCHLAEGT UM UND WIRD NICHT AUSGEGRAUT
   *     Drei Antworten waren moeglich auf "was, wenn es schon auf dem
   *     Home liegt": den Punkt trotzdem zeigen (er taete nichts - Spec
   *     §7.4 verbietet genau das), ihn ausblenden (ein Rechtsklick, der
   *     mal einen Punkt hat und mal nicht), oder die Gegenrichtung
   *     anbieten.
   *
   *     Die dritte ist die einzige, die immer etwas sagt, und sie ist
   *     nicht erfunden: der Starter traegt seit dem 20.08.2026 genau
   *     diesen Umschlag fuer den Fuss (43b8b25). Ausgegraut gibt es in
   *     diesem Haus ueberhaupt nicht - siehe den Kopf dieser Datei,
   *     "eine fehlende Anwendung im Fuss bekommt keinen ausgegrauten
   *     Knopf".
   *
   * `homeNamen` ist der Stand, den DIESE Sitzung zuletzt gelesen hat,
   * frisch gehalten von derselben Ueberwachung wie `namen`. Ein
   * Lesevorgang beim Aufklappen waere ein Menue, das auf einen
   * Unterprozess wartet.
   */
  const homePunkt = (program: string): MenueEintrag => {
    if (homeNamen.includes(program)) {
      return {
        symbol: HOME_ICON,
        text: _("Remove from Home"),
        tun: () => void homeRemove(program),
      }
    }
    return {
      symbol: HOME_ICON,
      text: _("Add to Home"),
      tun: () => void homeAdd(program),
    }
  }

  /** Der Programmname, unter dem dieses Fenster im Fuss steht - oder
   * stehen koennte -, und ob es schon dort steht.
   *
   * null heisst: dieses Fenster hat gar keinen Namen, unter dem sich
   * etwas anheften oder ablegen liesse. Zwei Gruende, und jeder einzelne
   * waere sonst ein Menuepunkt, der nichts tut - Spec §7.4, dieselbe
   * Regel, aus der eine fehlende Anwendung im Fuss keinen ausgegrauten
   * Knopf bekommt:
   *
   *   kein Programm     /proc/<pid>/comm hat nichts hergegeben. Ohne
   *                     Programmnamen gibt es nichts zu schreiben.
   *   kein Eintrag      entryFor() findet nichts, oder der Eintrag
   *                     markiert sich als Dienst. Dann bekaeme der Name
   *                     beim naechsten resolvePins() ohnehin keinen
   *                     Knopf - der Punkt schriebe eine Anheftung, die
   *                     unsichtbar bliebe.
   *
   * ZWEI GRUENDE STATT VIER, SEIT DEM 21.08.2026, und die zwei
   * weggefallenen sind nicht verschwunden, sondern haben ihre Antwort
   * gewechselt:
   *
   *   schon angeheftet  hiess bis gestern "kein Punkt". Es heisst jetzt
   *                     "Vom Dock entfernen" - dieselbe Umkehr wie beim
   *                     Home eine Funktion weiter oben und im Starter
   *                     seit dem 20.08.2026. Ein Rechtsklick, der bei
   *                     dem einen Fenster einen Punkt hat und bei dem
   *                     daneben nicht, ist schwerer zu verstehen als
   *                     einer, der beide Richtungen kennt.
   *   schon vertreten   das Fenster gehoert zu einer angehefteten
   *                     Anwendung und steht nur deshalb hier, weil es
   *                     ABGELEGT ist (siehe den Kopf). Es ist damit
   *                     ebenfalls "schon angeheftet", nur unter dem
   *                     Namen der ANHEFTUNG - und genau der wird
   *                     zurueckgegeben, damit "Vom Dock entfernen" den
   *                     Knopf trifft, den der Nutzer meint. Ein zweiter
   *                     Eintrag entstuende dabei nie: angeheftet wird
   *                     hier nichts, was schon dasteht.
   */
  const dockName = (client: Hyprland.Client): string | null => {
    const vertreter = pins.find(
      pin => belongsTo(client.class, pin.info, pin.program))
    if (vertreter) return vertreter.program

    const program = programOf(client.pid)
    if (!program) return null
    if (namen.includes(program)) return program
    const info = entryFor(program)
    if (!info || info.get_nodisplay()) return null
    return program
  }

  /** Was ein Rechtsklick auf ein FENSTER anbietet.
   *
   * "Schliessen" steht IMMER da; die zwei Punkte davor stehen da, wenn
   * dieses Fenster ueberhaupt einen Namen hat, unter dem sich etwas
   * ablegen laesst (siehe dockName()). Ein Menue mit einem einzigen
   * Punkt ist erlaubt und richtig; eines mit einem toten zweiten waere
   * es nicht.
   *
   * "Schliessen" ist derselbe Befehl, den der Mittelklick seit jeher
   * absetzt - und das ist sein zweiter Zweck: der Mittelklick war eine
   * Geste ohne Beschriftung, und niemand, der sie nicht kennt, konnte
   * sie finden.
   */
  const fensterMenue = (client: Hyprland.Client): MenueEintrag[] => {
    const eintraege: MenueEintrag[] = []
    const program = dockName(client)
    if (program) {
      eintraege.push(namen.includes(program)
        ? {
            symbol: UNPIN_ICON,
            text: _("Remove from dock"),
            tun: () => void dockRemove(program),
          }
        : {
            symbol: PIN_ICON,
            text: _("Add to dock"),
            tun: () => void dockAdd(program),
          })
      eintraege.push(homePunkt(program))
    }
    eintraege.push({
      symbol: CLOSE_ICON,
      text: _("Close"),
      tun: () => Hyprland.dispatch(`closewindow address:${client.address}`),
    })
    return eintraege
  }

  /** Einen Rechtsklick an einen Knopf haengen.
   *
   * `haengen` liefert die Eintraege ERST BEIM KLICK und nicht beim
   * Verbinden: was ein Menue anbietet, haengt am Zustand in dem Moment,
   * in dem es aufgeht - ob die Anwendung laeuft, ob dieser Name schon
   * angeheftet ist. Eine Liste, die beim Bauen des Knopfes entstuende,
   * waere beim ersten Rechtsklick schon alt.
   *
   * EINMAL JE KNOPF, und darum steht dieser Aufruf beim ENTSTEHEN des
   * Knopfes und nicht in update(): ein Knopf mit zehn Gesten klappt
   * beim naechsten Rechtsklick zehn Menues uebereinander auf. Dieselbe
   * Falle wie beim Linksklick, nur sichtbarer - siehe die Fork-Bombe
   * vom 17.08.2026 weiter unten.
   */
  const rechtsklick = (knopf: Gtk.Button,
                       haengen: () => MenueEintrag[]) => {
    // Knopf 3 ist die rechte Taste. "pressed" und nicht "released":
    // ein Menue, das erst beim Loslassen aufgeht, fuehlt sich an wie
    // eines, das haengt.
    const geste = new Gtk.GestureClick({ button: 3 })
    geste.connect("pressed", () => zeigeMenue(knopf, haengen()))
    knopf.add_controller(geste)
  }

  setzePins([...PINNED])

  /** Die gelesene Anheftungsliste uebernehmen - wenn sie neu ist.
   *
   * WOFUER DAS DIE ANTWORT IST - GEMELDET AUS 0.1.7
   *     "auch im ags launcher bzw hyprlauncher kann ich nicht mit
   *     rechtsklick zu home hinzufügen, und wenn ich es dort mit der
   *     dock versuche dann passiert nichts"
   *
   *     Der zweite Halbsatz war ein Fehler in einer ausgelieferten
   *     Fassung, und er war klein: der Starter SCHRIEB richtig - die
   *     Anheftung stand in user-settings.json, apps.pinned() gab den
   *     Namen zurueck -, nur erfuhr es niemand. Dieses Fenster horchte
   *     allein auf Hyprland (Fenster gehen auf und zu) und baute seine
   *     Reihe nur dann neu, wenn es SELBST geschrieben hatte. GEZAEHLT
   *     am 21.08.2026: `grep -n "FileMonitor|watch|reload"` ueber
   *     diese Vorlage, null Treffer.
   *
   * NUR BEI EINEM UNTERSCHIED, und das ist kein Sparen, sondern eine
   * Notwendigkeit: die Ueberwachung meldet JEDE Aenderung der Datei -
   * auch die eigene (siehe beobachteDock() in utils/user-settings.ts),
   * auch eine Farbe, auch eine Groesse. Ohne diesen Vergleich baute der
   * Fuss bei jeder davon jeden Knopf neu, mitsamt Gesten, und das
   * mitten unter dem Zeiger des Nutzers.
   */
  const uebernimm = (gelesen: string[]) => {
    if (JSON.stringify(gelesen) === JSON.stringify(namen)) return
    setzePins(gelesen)
    // SOFORT UND NICHT BEIM NAECHSTEN EREIGNIS: ohne diese Zeile
    // stuenden die neuen Knoepfe ohne Klick-Verbindung und ohne
    // Zustandsklasse da, bis der Nutzer zufaellig ein Fenster bewegt.
    update(Hyprland.refresh())
  }

  // DIE GROESSE, DIE DER FUSS ZULETZT ANGEFORDERT HAT - "BxH" oder ""
  //
  // Siehe fordereFlaecheNeuAn() gleich darunter. Ein Text und nicht zwei
  // Zahlen, weil verglichen und nicht gerechnet wird.
  let angefordert = ""

  /** Die Layer-Shell-Flaeche auf die Groesse ihres Inhalts zurueckholen.
   *
   * DIE STEHENGEBLIEBENE BREITE, UND WORAN SIE LAG (20.08.2026)
   *     BESTELLT, woertlich: "ausserdem passt sich die dock nicht an die
   *     aktuelle zahl der icons an. wenn wir neue terminals haben und
   *     sie entfernt werden bleibt die dock gleich lang".
   *
   *     GEMESSEN am 20.08.2026 im verschachtelten Compositor (Hyprland
   *     0.56.2, tests/render/desktop_session.py, headless 1920x1080,
   *     ausgelieferte Groesse), Kasten der Flaeche zepos-dock aus
   *     `hyprctl layers` und daneben die untere reservierte Zone aus
   *     `hyprctl monitors`:
   *
   *                                     VORHER              NACHHER
   *       nur die Anheftungen      (784,996,353,60)/84   (784,996,353,60)/84
   *       ein Fenster dazu         (755,996,411,60)/84   (755,996,411,60)/84
   *       ein zweites dazu         (730,984,460,72)/96   (730,984,460,72)/96
   *       eines davon minimiert    (730,984,460,72)/96   (730,984,460,72)/96
   *       dasselbe GESCHLOSSEN     (730,984,460,72)/96   (755,984,411,72)/96
   *       das zweite GESCHLOSSEN   (730,984,460,72)/96   (784,996,353,60)/84
   *
   *     Der Fuss wuchs also mit jedem Fenster und kam nie zurueck - und
   *     mit ihm blieb die reservierte Zone auf 96 statt 84 stehen, also
   *     zwoelf Punkte Bildschirmhoehe, die kein Fenster mehr bekam.
   *
   * WELCHER DER BEIDEN VERDAECHTIGEN ES WAR, UND WELCHER NICHT
   *     Verdaechtig war zuerst die Aenderung von 0e25b63 (dieselbe Nacht,
   *     "abgelegte Fenster stehen im Fuss"): sie hat den Filter in
   *     update() geoeffnet, damit ein minimiertes Fenster seinen Knopf
   *     BEHAELT - und im Bericht dazu steht ausdruecklich, dass die
   *     Flaeche beim Minimieren nicht mehr schrumpft (411 statt 353).
   *     Der Verdacht war, dass dieselbe Zeile auch das Schrumpfen beim
   *     SCHLIESSEN verhindert.
   *
   *     ER IST FALSCH, und zwar gemessen. Eine Sonde in update() hat am
   *     20.08.2026 bei jedem Ereignis die natuerliche Breite des
   *     Inhalts NEBEN die zugeteilte gestellt:
   *
   *       Fenster geht auf    box-nat 411   box-alloc 353 -> 411
   *       zweites geht auf    box-nat 460   box-alloc 411 -> 460
   *       eines geschlossen   box-nat 411   box-alloc 460   (bleibt)
   *       beide geschlossen   box-nat 353   box-alloc 460   (bleibt)
   *
   *     Der INHALT schrumpft also tadellos: der Knopf wird entfernt, die
   *     Reihe misst sich schmaler. Was nicht schrumpft, ist die FLAECHE.
   *     Damit ist es der zweite Verdacht, und er ist eine Eigenschaft von
   *     GTK4 und nicht dieser Datei: ein Gtk.Window fordert beim
   *     Compositor eine Groesse an, wenn es sie BRAUCHT - eine
   *     Mindestgroesse, die waechst, schiebt die Flaeche auseinander.
   *     Eine, die faellt, tut nichts: die Flaeche ist gross genug, also
   *     bleibt sie. Bei einem gewoehnlichen Fenster zieht der Mensch es
   *     kleiner; eine Layer-Shell-Flaeche hat niemanden, der das tut.
   *
   * WARUM set_default_size(-1, -1) UND NICHT queue_resize()
   *     queue_resize() sagt "miss neu", nicht "fordere neu an" - genau
   *     das ist bei jeder der stehengebliebenen Messungen oben ohnehin
   *     passiert (die Sonde zeigt die neue natuerliche Breite). -1
   *     nimmt die Vorgabegroesse ZURUECK und laesst das Fenster damit
   *     wieder die natuerliche Groesse seines Inhalts anfordern; das
   *     Wachsen bleibt unberuehrt (Zeile zwei und drei der Tabelle
   *     oben).
   *
   * NUR BEI EINER AENDERUNG, und darum `angefordert`: der Fuss laeuft
   * bei JEDEM Hyprland-Ereignis durch update(), also auch bei jedem
   * Fensterwechsel. Eine Groessenanforderung je Fokuswechsel waere eine
   * Neuverhandlung mit dem Compositor fuer nichts.
   *
   * KEINE FLAECHE, KEINE ANFORDERUNG: waehrend Dock() den Inhalt baut
   * (`window.set_child(DockContent())`) laeuft update() bereits, und
   * get_root() ist dann null - GEMESSEN, die ersten zwei Durchlaeufe
   * jedes Starts. Dann wird auch nichts gemerkt, sonst bliebe die erste
   * echte Groesse ungefordert.
   */
  const fordereFlaecheNeuAn = (inhalt: Gtk.Box) => {
    const flaeche = inhalt.get_root() as Gtk.Window | null
    if (!flaeche) return
    const breite = inhalt.measure(Gtk.Orientation.HORIZONTAL, -1)[1]
    const hoehe = inhalt.measure(Gtk.Orientation.VERTICAL, -1)[1]
    const jetzt = `${breite}x${hoehe}`
    if (jetzt === angefordert) return
    angefordert = jetzt
    flaeche.set_default_size(-1, -1)
  }

  const update = (state: Hyprland.HyprlandState) => {
    const display = box.get_display()
    const theme = display ? Gtk.IconTheme.get_for_display(display) : null

    // Sonderarbeitsbereiche haben negative Kennungen. Ihre Fenster sind
    // per Definition weggelegt; sie im Dock zu zeigen hiesse, das
    // Weglegen rueckgaengig zu machen, ohne dass jemand darum gebeten
    // hat.
    //
    // AUSSER special:minimized: darum HAT jemand gebeten, und zwar am
    // 20.08.2026 woertlich. Siehe den Kopf, "DIE ABGELEGTEN FENSTER" -
    // ein minimiertes Fenster ist eines, das man zurueckholen will,
    // und der Fuss ist der Ort, an dem das geht.
    const shown = state.clients
      .filter(client => client.workspace.id > 0 || isMinimized(client))
      // Die abgelegten ans ENDE, hinter alle offenen. Ihre Kennung ist
      // negativ, ohne diese erste Stufe stuenden sie also ganz vorn -
      // und die Bestellung sagt "rechts neben den standard icons".
      .sort((left, right) =>
        Number(isMinimized(left)) - Number(isMinimized(right))
        || left.workspace.id - right.workspace.id
        || left.title.localeCompare(right.title))

    // Jedes Fenster gehoert entweder zu einer angehefteten Anwendung
    // oder auf einen eigenen Knopf. Ein Fenster an beiden Stellen waere
    // dasselbe Programm zweimal im Dock.
    //
    // EIN ABGELEGTES FENSTER BEKOMMT IMMER EINEN EIGENEN KNOPF, auch
    // wenn seine Anwendung angeheftet ist - siehe den Kopf, "WOHIN EIN
    // ABGELEGTES FENSTER GEHOERT". Die Regel darueber bleibt trotzdem
    // heil: es steht dann NICHT zusaetzlich unter seiner Anheftung,
    // sondern nur dort. Was die Anheftung von ihm behaelt, ist die
    // Auskunft, dass ihre Anwendung laeuft (`putAway`) - sonst saehe
    // ein Firefox mit einem einzigen, abgelegten Fenster aus wie
    // "startet nicht", und ein Klick oeffnete einen zweiten.
    const owned = new Map<string, Hyprland.Client[]>()
    const putAway = new Map<string, Hyprland.Client[]>()
    const loose: Hyprland.Client[] = []
    for (const client of shown) {
      const minimized = isMinimized(client)
      const pin = pins.find(candidate =>
        belongsTo(client.class, candidate.info, candidate.program))
      if (pin) {
        const table = minimized ? putAway : owned
        const list = table.get(pin.program) ?? []
        list.push(client)
        table.set(pin.program, list)
      }
      if (minimized || !pin) loose.push(client)
    }

    for (const pin of pins) {
      const windows = owned.get(pin.program) ?? []
      const abgelegt = putAway.get(pin.program) ?? []
      const classes = ["dock-button", "dock-pin"]
      // "laeuft" zaehlt die abgelegten MIT. Ein minimiertes Programm
      // laeuft - der Strich unter dem Symbol sagt genau das und nichts
      // ueber Sichtbarkeit.
      if (windows.length || abgelegt.length) classes.push("running")
      if (windows.some(client => client.workspace.id === state.focused)) {
        classes.push("active")
      }
      pin.button.set_css_classes(classes)
      const zahl = windows.length + abgelegt.length
      pin.button.set_tooltip_text(
        zahl
          ? `${pin.info.get_display_name() || pin.program} (${zahl})`
          : (pin.info.get_display_name() || pin.program))
      // Neu verbunden, weil das Ziel sich mit jedem Ereignis aendert:
      // laeuft die Anwendung, holt der Klick ihr erstes Fenster nach
      // vorn; laeuft sie nicht, startet er sie ueber ihren Eintrag - und
      // damit mit der Exec-Zeile, die das Paket vorgesehen hat, statt
      // mit einem Programmnamen, den diese Datei erraten haette.
      //
      // GESCHLUESSELT NACH DEM KNOPF UND NICHT NACH DEM PROGRAMMNAMEN,
      // seit dem 17.08.2026. Das ist der ganze Fehler von diesem Tag:
      //
      //     GEMELDET: "wenn ich auf den claude icon druecke spammt er
      //     terminal mit claude auf die oberflaeche immer mehr bis alles
      //     laggt".
      //
      //     src/apps.py fuehrte zepos-claude-code ZWEIMAL - einmal als
      //     fremde Anwendung (zepos-apps nennt es in seinen
      //     Abhaengigkeiten) und einmal als eigenes Paket. Zwei
      //     Eintraege, ein Programmname, EIN Platz in dieser Tabelle:
      //     der zweite Durchlauf holte die Verbindung des ERSTEN
      //     Knopfes und trennte sie am ZWEITEN - wo sie nicht sass.
      //     Also blieb sie am ersten haengen, und der bekam bei jedem
      //     Hyprland-Ereignis eine weitere dazu. Ein Klick startete
      //     danach so viele Programme, wie seit dem Anmelden Ereignisse
      //     gekommen waren, und jedes neue Fenster war ein weiteres
      //     Ereignis.
      //
      //     Die Liste ist repariert (src/apps.py, `shipped`). Diese
      //     Zeile ist die zweite Haelfte: ein Knopf ist als Objekt
      //     eindeutig, ein Name ist es nicht. Wer morgen dieselbe
      //     Anwendung zweimal anheftet - von Hand, ueber die
      //     Einstellungen -, bekommt zwei Zeichen und keine Fork-Bombe.
      const previousHandler = handlers.get(pin.button)
      if (previousHandler !== undefined) pin.button.disconnect(previousHandler)
      const first = windows[0]
      // Das erste ABGELEGTE Fenster dieser Anwendung, und der Grund,
      // aus dem der Knopf davon ueberhaupt weiss: liegt jedes Fenster
      // einer Anwendung abgelegt, dann laeuft sie - und ein Klick, der
      // sie dann noch einmal STARTET, macht aus einem minimierten
      // Firefox zwei Firefoxe. Der Nutzer hat einmal minimiert und
      // erwartet, dass derselbe Klick es rueckgaengig macht.
      const firstPutAway = abgelegt[0]
      const focused = state.focused
      handlers.set(pin.button, pin.button.connect("clicked", () => {
        if (first) {
          Hyprland.dispatch(`focuswindow address:${first.address}`)
          return
        }
        if (firstPutAway) {
          restore(firstPutAway, focused)
          return
        }
        starte(pin.info)
      }))
    }

    separator.set_visible(pins.length > 0 && loose.length > 0)

    const addresses = loose.map(client => client.address)
    for (const [address, button] of buttons) {
      if (!addresses.includes(address)) {
        box.remove(button)
        buttons.delete(address)
        // Und aus der Verbindungstabelle. Sie ist nach dem Knopf
        // geschluesselt; ein entfernter Knopf, der darin stehenbleibt,
        // haelt sein Gtk.Button-Objekt am Leben, solange das Dock laeuft.
        handlers.delete(button)
      }
    }

    let previous: Gtk.Widget | null = separator
    for (const client of loose) {
      let button = buttons.get(client.address)
      if (!button) {
        button = new Gtk.Button({ can_focus: false })
        button.add_css_class("dock-button")

        if (theme) button.set_child(iconFor(client, theme))

        // Der Mittelklick bleibt EINMAL verbunden: sein Ziel ist die
        // Adresse, und die aendert sich fuer dieses Fenster nie.
        const middle = new Gtk.GestureClick({ button: 2 })
        middle.connect("released", () =>
          Hyprland.dispatch(`closewindow address:${client.address}`))
        button.add_controller(middle)

        // Der Rechtsklick, ebenfalls EINMAL - was er anbietet, wird
        // beim Klick gerechnet und nicht hier. Siehe rechtsklick().
        rechtsklick(button, () => fensterMenue(client))

        buttons.set(client.address, button)
        box.append(button)
      }

      const minimized = isMinimized(client)

      // Der LINKSKLICK dagegen wird bei jedem Ereignis neu verbunden,
      // genau wie oben bei den angehefteten Anwendungen - und aus einem
      // Grund, den es vor dem 20.08.2026 nicht gab: er hing an dem
      // `client`, mit dem der Knopf ENTSTANDEN ist, und tat immer
      // dasselbe (focuswindow). Jetzt haengt sein Ziel davon ab, ob das
      // Fenster gerade abgelegt ist und welchen Bereich der Nutzer
      // gerade ansieht - zwei Angaben, die sich beide aendern, waehrend
      // der Knopf steht. Ein einmal verbundener Rueckruf holte ein
      // Fenster auf den Arbeitsbereich zurueck, den der Nutzer beim
      // Minimieren ansah, und nicht auf den, den er jetzt ansieht.
      const previousClick = handlers.get(button)
      if (previousClick !== undefined) button.disconnect(previousClick)
      const focused = state.focused
      handlers.set(button, button.connect("clicked", () => {
        if (minimized) restore(client, focused)
        else Hyprland.dispatch(`focuswindow address:${client.address}`)
      }))

      button.set_tooltip_text(client.title || client.class)
      // Abgelegt schlaegt aktiv, und zwar ohne dass die beiden je
      // zusammentreffen koennten: ein abgelegtes Fenster liegt auf
      // special:minimized, und state.focused ist immer die
      // activeWorkspace eines Schirms - GEMESSEN am 20.08.2026, auch
      // waehrend der Sonderbereich per SUPER+D eingeblendet war, meldet
      // `hyprctl monitors -j` dort weiter den gewoehnlichen Bereich.
      const classes = ["dock-button"]
      if (minimized) classes.push("minimized")
      else if (client.workspace.id === state.focused) classes.push("active")
      button.set_css_classes(classes)

      box.reorder_child_after(button, previous)
      previous = button
    }

    // ZULETZT, und erst nachdem jeder Knopf steht: die Flaeche neu
    // anfordern. Siehe fordereFlaecheNeuAn() - ohne diese Zeile behaelt
    // der Fuss die Breite, die er einmal hatte.
    fordereFlaecheNeuAn(box)
  }

  update(Hyprland.refresh())
  Hyprland.subscribe(() => update(Hyprland.refresh()))

  // ZULETZT, und erst nachdem update() einmal gelaufen ist: die
  // Einstellungen. Einmal beim Bauen - PINNED ist der Abzug des letzten
  // Erzeugungslaufs und nicht das, was gilt (siehe dort) - und danach
  // bei jeder Aenderung der Datei, von wem auch immer sie kommt.
  //
  // NACH update() UND NICHT DAVOR: uebernimm() ruft update() selbst,
  // wenn sich die Reihe geaendert hat. Stuende die Anmeldung davor,
  // liefe update() zweimal in derselben Sekunde, und der zweite Lauf
  // faende genau das vor, was der erste hinterlassen hat.
  //
  // BEIDE Listen, und die zweite ist keine Zugabe: an ihr haengt, in
  // welche Richtung der Menuepunkt zeigt (siehe homePunkt()).
  beobachteDock(uebernimm)
  beobachteHome(icons => { homeNamen = icons.map(icon => icon.name) })

  return box
}

export interface DockHandle {
  windows: Astal.Window[]
  toggle: () => void
  visible: () => boolean
}

// =====================================================================
// WER MIT DEM DOCK EIN- UND AUSFAEHRT
// =====================================================================
//
// BESTELLT, woertlich (20.08.2026): "die dock beim einfahren mit super b
// soll auch links der button mit shutdown auch mit verschwinden mit der
// selben animation".
//
// GEMESSEN am 20.08.2026, VOR dieser Kopplung, im verschachtelten
// Compositor (Hyprland 0.56.2, 1920x1080, ausgelieferte Groesse,
// tests/render/desktop_session.py), ein einziges `ags request dock`:
//
//     Flaeche       vorher                  nachher
//     zepos-dock    (784, 996, 353, 60)     fort
//     zepos-power   ( 24, 999,  53, 57)     STEHT WEITER DA
//     bemalt im unteren Drittel  23593 Punkte  ->  2717 Punkte
//
// Die 2717 uebrigen Punkte sind Punkt fuer Punkt der Kasten des
// Knopfes. Ein Fuss, der einfaehrt und einen Knopf stehen laesst, sieht
// aus wie ein Fehler - und er ist einer.
//
// WARUM EINE ANMELDUNG BEIM DOCK UND NICHT EIN ZWEITER SCHALTER
//     Drei Wege waren zu haben, und zwei davon legen eine zweite
//     Wahrheit an:
//
//       ein zweiter Zweig in app.ts   `ags request dock` toggelt das
//                                     Dock UND ruft den Knopf. Dann
//                                     tragen ZWEI Stellen den Zustand,
//                                     und jeder weitere Weg zum Dock
//                                     (ein Knopf, eine Geste, ein
//                                     zweites Kuerzel) muss beide
//                                     wieder von Hand bedienen. Genau
//                                     die Sorte Kopplung, die beim
//                                     naechsten Umbau auseinanderfaellt.
//       ein gemeinsamer Zustand       eine dritte Datei, die beide
//                                     lesen. Sie waere fuer genau zwei
//                                     Leser da und muesste trotzdem
//                                     erklaeren, wem sie gehoert.
//       DAS DOCK SAGT BESCHEID        <- dieser Weg. Es gibt genau EINE
//                                     Stelle, an der sich die
//                                     Sichtbarkeit des Docks aendert
//                                     (toggle() weiter unten), und die
//                                     sagt es weiter. Wer mitfahren
//                                     will, meldet sich an; wer nicht
//                                     mitfahren will, merkt nichts.
//                                     Das Dock selbst muss dafuer
//                                     nichts ueber den Knopf wissen -
//                                     es kennt nur `Mitfahrer`.
//
// WARUM DAS SCHON "DIESELBE ANIMATION" IST, OHNE DASS HIER EINE DAUER
// ODER EINE KURVE STEHT
//     Weil die Bewegung nicht dieser Datei gehoert. Weder das Dock noch
//     der Knopf blendet sich selbst aus: beide setzen `visible`, melden
//     damit ihre Layer-Shell-Flaeche ab, und was man DANN sieht, malt
//     der Compositor. Hyprland fuehrt dafuer die Klasse `layers` mit
//     `layersIn`/`layersOut`, und ZepOS schreibt keine Regel JE
//     NAMENSRAUM - hyprland-universal-config.template setzt nur den
//     `animations`-Block, und dessen Dauern und Kurve kommen aus der
//     Bewegungsleiter (src/sizes.py, MOTION_ROLES und
//     MOTION_CURVE_POINTS). Zwei Flaechen derselben Art, im selben Zug
//     abgemeldet, bekommen deshalb zwangslaeufig dieselbe Dauer,
//     dieselbe Beschleunigung und denselben Anfang.
//
//     Eine Dauer in dieser Datei waere eine ZWEITE Bewegung neben der
//     des Compositors - und die beiden waeren genau so lange gleich,
//     wie niemand an einer von beiden dreht.
//
//     GEMESSEN am 20.08.2026 an demselben Aufbau: `hyprctl animations`
//     meldet fuer `layersOut` "overridden: 0", also den Erbwert von
//     `global` (bezier default, speed 8.00 = 800 ms). Die Bilder dazu
//     zeigen keinen Ruck, sondern ein Ausblenden an Ort und Stelle -
//     der Kasten des Docks bleibt (784, 996, 353, 60) und wird leerer:
//     20868 Punkte bei 97 ms, 11513 bei 260 ms, 5988 bei 426 ms, 2344
//     bei 674 ms. Der Knopf stand dabei unveraendert bei 2717.
//
// IM SELBEN ZUG heisst: im selben Durchlauf der Ereignisschleife.
// melde() laeuft synchron in toggle(), also sind beide Flaechen
// abgemeldet, bevor GTK das naechste Mal zum Compositor schreibt - und
// nicht 30 ms spaeter, was schlimmer aussaehe als ein Knopf, der
// stehenbleibt.

/** Eine Flaeche, die mit dem Dock kommt und geht. */
export type Mitfahrer = (sichtbar: boolean) => void

const mitfahrer: Mitfahrer[] = []

// Was das Dock zuletzt gemeldet hat - oder null, solange es nichts
// gemeldet hat. DREI Zustaende und nicht zwei, und beide Zusatzfaelle
// treten wirklich auf:
//
//   null     Dock() ist noch nicht gelaufen oder hat ohne Anzeige
//            abgebrochen. Dann gibt es nichts, womit man mitfahren
//            koennte, und ein Mitfahrer bleibt, wie er gebaut wurde -
//            ein Abschaltknopf, der sich wegen eines FEHLENDEN Docks
//            versteckt, waere die zweite Beschwerde nach der ersten.
//   true     das Dock steht. app.ts baut den Knopf NACH dem Dock (siehe
//            dort, "Der Abschaltknopf, NACH dem Dock"), also ist das
//            der Normalfall bei der Anmeldung.
//   false    das Dock ist eingefahren.
let stand: boolean | null = null

function melde(sichtbar: boolean): void {
  stand = sichtbar
  for (const folge of mitfahrer) folge(sichtbar)
}

/** Diese Funktion mit dem Dock mitfahren lassen.
 *
 * Sie wird bei jedem Wechsel gerufen - und einmal sofort, wenn das Dock
 * schon steht, damit ein spaet gebauter Mitfahrer nicht bis zum ersten
 * SUPER+B in der Luft haengt.
 */
export function faehrtMitDemDock(folge: Mitfahrer): void {
  mitfahrer.push(folge)
  if (stand !== null) folge(stand)
}

/** Ein Dock je Schirm, unten am Rand, sichtbar.
 *
 * Sichtbar, und das ist die zweite Haelfte der Antwort auf "die nwg dock
 * unten geht nicht mehr". Hier stand `visible: false`, mit der
 * Begruendung, SUPER+B sei der einzige Weg, auf dem es auch wieder
 * verschwindet. Das stimmt weiterhin - und es hiess, dass ein Nutzer,
 * der die Taste nicht kennt, nie ein Dock zu sehen bekam. Eine
 * Oberflaeche, die man erst herbeirufen muss, ist fuer den, der sie
 * nicht kennt, dasselbe wie keine.
 *
 * DREI EIGENSCHAFTEN MACHEN AUS DIESER FLAECHE EINE FUSSZEILE, und
 * keine davon steht hier zufaellig:
 *
 *   anchor BOTTOM        unten und nur unten. Mit LEFT und RIGHT dazu
 *                        zoege sich die Flaeche ueber die volle Breite
 *                        und reservierte einen Streifen, der zu beiden
 *                        Seiten des Docks leer waere.
 *   EXCLUSIVE            der Streifen gehoert ihr. Ohne das laege sie
 *                        UEBER dem untersten Fenster, und ein
 *                        maximiertes Fenster verdeckte seine eigene
 *                        Fusszeile.
 *   visible: true        sie steht da, ohne dass jemand eine Taste
 *                        kennt.
 *
 * Alle drei werden gemessen und nicht behauptet - siehe
 * tests/src/test_placement.py.
 */
export default function Dock(): DockHandle {
  const windows: Astal.Window[] = []

  // OB DAS DOCK GERADE EINGEFAHREN IST, als eigene Zahl neben den
  // Fenstern.
  //
  // Gebraucht seit dem 01.09.2026, seit ein Schirm auch NACH dem
  // Anmelden dazukommen kann (siehe jeSchirm() in ../utils/kit): das
  // neue Fenster muss so stehen wie die anderen. Ohne diese Zahl
  // erschiene bei jedem angesteckten Schirm ein Dock, obwohl der Nutzer
  // es gerade mit SUPER+B weggeschickt hat - `windows.some(...)` kann
  // es nicht sagen, weil die Liste in genau diesem Moment leer sein
  // kann (alle Schirme fort, einer kommt wieder).
  let sichtbar = true

  jeSchirm("Dock", (monitor: Gdk.Monitor) => {
    const window = new Astal.Window({
      namespace: "zepos-dock",
      name: `dock-${monitor.connector}`,
      layer: Astal.Layer.TOP,
      anchor: Astal.WindowAnchor.BOTTOM,
      exclusivity: Astal.Exclusivity.EXCLUSIVE,
      gdkmonitor: monitor,
      visible: sichtbar,
    })
    window.add_css_class("dock-window")
    window.set_margin_bottom(DOCK_MARGIN_BOTTOM)
    window.set_child(DockContent())
    windows.push(window)
    return window
  }, (window: Astal.Window) => {
    const stelle = windows.indexOf(window)
    if (stelle >= 0) windows.splice(stelle, 1)
    window.destroy()
  })

  // Der Anfangsstand fuer alle, die mitfahren wollen. Er steht HIER und
  // nicht als Vorgabe bei `stand`, weil `sichtbar` eine Zeile weiter
  // oben steht: waeren es zwei Stellen, koennte jemand die eine aendern
  // und die andere vergessen.
  melde(sichtbar)

  return {
    windows,
    toggle: () => {
      // `showing` ist der Stand VOR dem Umschalten - dieselbe Zeile wie
      // vor dem 01.09.2026, nur dass er jetzt aus `sichtbar` kommt und
      // nicht aus `windows.some(...)`. Die Liste kann in genau diesem
      // Augenblick leer sein (alle Schirme fort), und "keine Flaeche
      // sichtbar" hiesse dann faelschlich "eingefahren".
      const showing = sichtbar
      sichtbar = !showing
      for (const window of windows) window.visible = !showing
      // NACH der Schleife und im selben Durchlauf: erst steht der neue
      // Stand des Docks fest, dann faehrt alles mit, was mitfaehrt -
      // und beides, bevor GTK das naechste Mal zum Compositor schreibt.
      melde(sichtbar)
    },
    visible: () => sichtbar,
  }
}
