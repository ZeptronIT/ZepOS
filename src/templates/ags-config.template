// Helper to toggle overlay widget visibility
//
// `at` ist das Bedienelement, das dieses Fenster aufmacht - siehe
// OverlayAnchor in utils/overlay.ts. Ohne Angabe nimmt die Fabrik den
// Mauszeiger; das ist die richtige Antwort fuer eine Tastenbindung und
// war bis zum 17.08.2026 die einzige, auch fuer einen Klick auf ein
// Modul, das ganz woanders sitzt.
async function toggleWidget(widget: OverlayWidget | null,
                            at?: OverlayAnchor): Promise<string> {
  if (widget) {
    if (widget.window.visible) {
      widget.hide()
    } else {
      await widget.show(at)
    }
    return "toggled"
  }
  return "widget not found"
}

// Was ein Klick auf der Leiste erreicht.
//
// Hier lag bisher ein Prozessstart: jedes Leistenmodul rief `ags request
// <name>` auf, was einen zweiten AGS-Prozess startete, der die Anfrage
// ueber den Astal-Socket an genau diesen Prozess schickte, der dann
// toggleWidget aufrief. Sechs Module taten das. Jetzt rufen sie diese
// Funktion.
//
// SEIT AUFGABE 7/8/9 (18.08.2026) LEITET SIE "bluetooth", "network" UND
// "vpn" IN DIE SCHALE UM, STATT EIN FENSTER ZU TOGGELN - UND SEIT
// AUFGABE 17 (19.08.2026) AUCH "sound"
//     Keine der drei Vorlagen (Aufgabe 7/8/9) baut ein eigenes
//     Astal.Window mehr - alle drei exportieren nur noch ihre ShellSeite
//     (bluetoothSeite/networkSeite/vpnSeite), die ControlCenter() als
//     Seite unter VERBINDUNGEN einhaengt (ags-control-center.template).
//     "sound" ist KEINE eigene Vorlage - soundSeite steht direkt in
//     ags-control-center.template (Aufgabe 17, "Ton wird eine Seite") -,
//     aber derselbe Umleitungsweg gilt: `widgets.control` ist zur
//     Laufzeit ein ShellWidget (ControlCenter() ruft seit Aufgabe 6
//     createShellWindow()); die Tabelle bleibt als
//     `Record<string, OverlayWidget | null>` typisiert (ShellWidget
//     ERWEITERT OverlayWidget nur um zeigeSeite()), darum der Zuschnitt
//     hier am Aufruf und nicht an der Tabelle selbst.
//
//     BESTELLT, woertlich (19.08.2026): "ich will das auch bei mikrofon
//     oder sprecher ein fenster kommt mit einer scrollbar oder
//     progressbar aehnlich wie im kontrollzentrum sodass man die
//     lautstaerke auch einstellen kann." KEIN eigenes drittes Fenster
//     dafuer (Aufgabenblatt 17, Aufgabe 2, woertlich: "zwei Wege zu
//     derselben Funktion waeren zwei Staende, die sich widersprechen
//     koennen") - die Leistenmodule `pulseaudio`/`pulseaudio#microphone`
//     (ags-bar.template) rufen `toggle("sound", ...)` und landen ueber
//     denselben Pfad wie Netzwerk/Bluetooth auf der Sound-Seite der
//     Schale.
//
//     EIN Aenderungsort fuer JE NAME BIS ZU DREI Aufrufer: die Leiste
//     (`toggles: "bluetooth"`/`"network"`/"sound"` in ags-bar.template),
//     die Tastenbindung (`reqStr.includes(...)` im requestHandler unten)
//     und die jeweilige Zeile auf der Seite "general" des
//     Kontrollzentrums selbst (btRow/netRow/vpnRow, rufen `toggle(name)`
//     ueber denselben Weg) - alle gehen durch toggleByName(). "vpn" hat
//     kein eigenes Leistenmodul. "sound" bekommt mit dieser Aufgabe NUR
//     den ersten der drei (die Leiste, siehe pulseaudio/pulseaudio#
//     microphone unten) - keine Tastenbindung (Aufgabenblatt 17, Aufgabe
//     2 nennt nur die Leiste) und keine Zeile auf "general" (die drei
//     Regler zogen dort weg, siehe Aufgabe 1 desselben Blatts, "Umzug,
//     keine Neuentwicklung" - eine zusaetzliche Navigationszeile waere
//     das Zweite). "vpn-settings" bleibt AUSSEN vor und nimmt weiterhin
//     den toggleWidget-Weg: die VPN-Einstellungen sind ein eigenes
//     Fenster, kein Verbindungsziel.
function toggleByName(name: string, at?: OverlayAnchor): void {
  if (name === "bluetooth" || name === "network" || name === "vpn"
      || name === "sound") {
    (widgets.control as ShellWidget | null)?.zeigeSeite(name, at)
    return
  }
  // "settings:bildschirme" - dieselbe Umleitung wie oben, nur in die
  // ZWEITE Schale dieses Prozesses. Der Doppelpunkt trennt Fenster und
  // Seite, weil beide Schalen eigene Seitennamen fuehren: ein blosses
  // "bildschirme" waere ab der naechsten Seite des Kontrollzentrums
  // zweideutig. Die Seitennamen kommen aus model.PAGES (Aufgabe 32).
  if (name.startsWith("settings:")) {
    (widgets.settings as ShellWidget | null)
      ?.zeigeSeite(name.slice("settings:".length), at)
    return
  }
  void toggleWidget(widgets[name] ?? null, at)
}

const BAR_CSS = `${GLib.get_user_config_dir()}/ags/bar.css`

/** Den Leistenstil aus der Datei nachladen. Rueckgabe: was zu melden ist.
 *
 * Zwei Aufrufer: der Start unten und `ags request reload-bar-style`, das
 * restore-latest-backup benutzt, um eine zurueckgeholte Datei wirksam zu
 * machen, ohne die Oberflaeche zu beenden.
 */
function applyBarStyle(): string {
  if (!GLib.file_test(BAR_CSS, GLib.FileTest.EXISTS)) return "no bar.css"
  try {
    // false, nicht true: `reset` wuerfe die Regeln der zwoelf
    // Ueberlagerungen mit weg, die aus style.scss kommen.
    app.apply_css(BAR_CSS, false)
    return "reloaded"
  } catch (e) {
    console.error("Failed to apply bar.css:", e)
    return "failed"
  }
}

