// Helper to toggle overlay widget visibility
//
// `at` ist das Bedienelement, das dieses Fenster aufmacht - siehe
// OverlayAnchor in utils/overlay.ts. Ohne Angabe nimmt die Fabrik den
// Mauszeiger; das ist die richtige Antwort fuer eine Tastenbindung und
// war bis zum 17.08.2026 die einzige, auch fuer einen Klick auf ein
// Modul, das ganz woanders sitzt.
async function toggleWidget(widget: OverlayWidget | null,
                            at?: OverlayAnchor): Promise<string> {
  if (widget) {
    if (widget.window.visible) {
      widget.hide()
    } else {
      await widget.show(at)
    }
    return "toggled"
  }
  return "widget not found"
}

// Was ein Klick auf der Leiste erreicht.
//
// Hier lag bisher ein Prozessstart: jedes Leistenmodul rief `ags request
// <name>` auf, was einen zweiten AGS-Prozess startete, der die Anfrage
// ueber den Astal-Socket an genau diesen Prozess schickte, der dann
// toggleWidget aufrief. Sechs Module taten das. Jetzt rufen sie diese
// Funktion.
//
// SEIT AUFGABE 7 (18.08.2026, "Bluetooth wird eine Seite") LEITET SIE
// "bluetooth" IN DIE SCHALE UM, STATT EIN FENSTER ZU TOGGELN
//     BluetoothManager.tsx baut kein eigenes Astal.Window mehr - es
//     exportiert bluetoothSeite: ShellSeite, die ControlCenter() als
//     Seite unter VERBINDUNGEN einhaengt (ags-control-center.template).
//     `widgets.control` ist zur Laufzeit ein ShellWidget (ControlCenter()
//     ruft seit Aufgabe 6 createShellWindow()); die Tabelle bleibt als
//     `Record<string, OverlayWidget | null>` typisiert (ShellWidget
//     ERWEITERT OverlayWidget nur um zeigeSeite()), darum der Zuschnitt
//     hier am Aufruf und nicht an der Tabelle selbst.
//
//     EIN Aenderungsort fuer DREI Aufrufer: die Leiste (`toggles:
//     "bluetooth"` in ags-bar.template), die Tastenbindung
//     (`reqStr.includes("bluetooth")` im requestHandler unten) und die
//     Zeile "Bluetooth" auf der Seite "general" des Kontrollzentrums
//     selbst (btRow, ruft `toggle("bluetooth")` ueber denselben Weg) -
//     alle drei gehen durch toggleByName(). Netzwerk und VPN bleiben bis
//     zu ihren eigenen Aufgaben (8/9) echte, eigene Fenster und nehmen
//     weiterhin den toggleWidget-Weg.
function toggleByName(name: string, at?: OverlayAnchor): void {
  if (name === "bluetooth") {
    (widgets.control as ShellWidget | null)?.zeigeSeite(name, at)
    return
  }
  void toggleWidget(widgets[name] ?? null, at)
}

const BAR_CSS = `${GLib.get_user_config_dir()}/ags/bar.css`

/** Den Leistenstil aus der Datei nachladen. Rueckgabe: was zu melden ist.
 *
 * Zwei Aufrufer: der Start unten und `ags request reload-bar-style`, das
 * restore-latest-backup benutzt, um eine zurueckgeholte Datei wirksam zu
 * machen, ohne die Oberflaeche zu beenden.
 */
function applyBarStyle(): string {
  if (!GLib.file_test(BAR_CSS, GLib.FileTest.EXISTS)) return "no bar.css"
  try {
    // false, nicht true: `reset` wuerfe die Regeln der zwoelf
    // Ueberlagerungen mit weg, die aus style.scss kommen.
    app.apply_css(BAR_CSS, false)
    return "reloaded"
  } catch (e) {
    console.error("Failed to apply bar.css:", e)
    return "failed"
  }
}

