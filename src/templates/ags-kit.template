// DIE BAUTEILE DER ZEPOS-FENSTER
//
// Erzeugt nach ags/utils/kit.ts. Wer ein Fenster baut, ruft von hier -
// er baut keinen Gtk.Button und haengt keine eigene Klasse dran.
//
// WARUM FUNKTIONEN UND NICHT NUR CSS-KLASSEN
//     GEMESSEN am 18.08.2026: ags-style.template trug 45 Knopfregeln in
//     41 Klassen, ohne eine einzige gemeinsame. Es gab keine Regel, die
//     das verboten haette - es gab nur keine, die es leicht gemacht
//     haette. Eine Klasse, an die man sich halten SOLL, ist schwaecher
//     als eine Funktion, die man aufruft; die eine ist eine Bitte, die
//     andere eine Schnittstelle.
//
// WAS HIER NICHT HINEINGEHOERT: alles, was ein Fenster besonders macht.
// Das Kit kennt Knopf, Zeile, Schalter, Abschnittsmarke und Trenner -
// mehr nicht. Ein Bauteil, das nur ein Fenster braucht, gehoert in
// dieses Fenster.
import { Gtk } from "ags/gtk4"

export type ZepRolle = "voll" | "umrandet" | "still" | "kritisch"

// Ein Knopf. EINE Hoehe, EIN Radius, vier Rollen.
//
// Die Rolle steht in der Klasse und nicht im Aufruf des Aussehens: das
// Stylesheet entscheidet, wie "kritisch" aussieht, nicht diese Datei.
export function zepButton(
  label: string,
  rolle: ZepRolle,
  aktion: () => void,
): Gtk.Button {
  const knopf = new Gtk.Button({ can_focus: true })
  knopf.set_child(new Gtk.Label({ label }))
  knopf.add_css_class("zep-btn")
  knopf.add_css_class(`zep-btn-${rolle}`)
  knopf.connect("clicked", aktion)
  return knopf
}

// Eine Zeile: Symbol, Titel, optionale Nebenzeile, optionales Ende.
//
// Titel und Nebenzeile kuerzen UND deckeln ihre natuerliche Breite -
// beides zusammen, nicht nur das eine. `ellipsize` senkt bei GTK nur
// die MINDESTBREITE eines Labels, nicht seine NATUERLICHE; ohne
// `max_width_chars` blaeht ein langer Text die Zeile und damit das
// ganze Fenster auf, bis etwas von aussen deckelt. GENAU DAS war ein
// gemessener Fehler dieses Projekts: am 17.08.2026 hat eine
// Beschriftung ohne `max_width_chars` das Netzfenster auf 660 Punkte
// Mindestbreite aufgeblasen (ags-network.template, Kopf der Datei,
// `.net-current min=660`) und dieselbe Ursache in ags-bluetooth.template
// das Fenster auf 460 statt 312 Punkte gebracht (dort, Kopf der Datei,
// vor der Umstellung auf zepRow).
//
// NACHGETRAGEN am 18.08.2026, task-6: zepRow selbst rief bis hierher
// `set_ellipsize(3)` ohne `set_max_width_chars` - also GENAU die
// Luecke, die die beiden Fenster oben aufgeblasen hat, nur diesmal im
// geteilten Bauteil statt in einem einzelnen Fenster. Elf der zwoelf
// Fenster tragen unbegrenzte Fremdtexte (VPN-Profilnamen, WLAN-Namen,
// Themennamen) - ohne Deckel haette das Kit diesen Fehler elfmal
// wiederholt, statt ihn zu verhindern. Vorgabe ist darum KUERZEN, mit
// STYLE_MEASURE_LINE als Grenze (dieselbe schmale Spalte wie in
// ags-network.template und ags-bluetooth.template). Ein Fenster, das
// ausnahmsweise den vollen Text braucht, setzt `vollerText: true`.
export function zepRow(opts: {
  symbol: string
  titel: string
  unterzeile?: string
  ende?: Gtk.Widget
  // NACHGETRAGEN am 18.08.2026, task-5: der "ausgewaehlt"-Zustand fehlte
  // hier, und Bluetooth ist der erste Verbraucher, der ihn braucht - das
  // verbundene Geraet muss sich von den uebrigen abheben. GEZAEHLT
  // (`grep -oE '\.[a-z][a-z0-9-]*\.active|&\.active' ags-style.template`):
  // 18 Fundstellen im Bestand (.net-item.active, .cc-toggle-btn.active,
  // .se-tab-btn.active, ...), zepRow bekommt darum dieselbe Klasse statt
  // einer eigenen.
  ausgewaehlt?: boolean
  // NACHGETRAGEN am 18.08.2026, task-6: die Abschaltung fuer die
  // Kuerzung oben - siehe die Begruendung am Funktionskopf. Vorgabe ist
  // KUERZEN (also `false`/nicht gesetzt); nur ein Fenster, das
  // ausdruecklich den vollen Text braucht, setzt hier `true`.
  vollerText?: boolean
  // NACHGETRAGEN am 19.08.2026 (Bericht Aufgabe 15/16, Fund "Kasten in
  // Kasten"): eine anklickbare Zeile, ohne eine zweite Huelle darueber.
  //
  // WAS VORHER STAND, UND WARUM DAS FALSCH WAR
  //     Drei Fundstellen (zepSidebar hier, createNetworkRow in
  //     ags-network.template, createDeviceRow in ags-bluetooth.template)
  //     loesten "eine Zeile, die man anklicken kann" alle gleich:
  //     `zepButton("", "umrandet", aktion)`, dann `.set_child(zepRow(...))`
  //     hineingesteckt. BEIDE Bauteile malen ihre EIGENE Flaeche
  //     (background/border/border-radius, ags-style.template)  - GEMESSEN
  //     bei Vorgabegroesse: Knopf 49px hoch, Radius 8, Rand IMMER
  //     sichtbar; Zeile 74px hoch, Radius 12, Randstreifen nur "aktiv" -
  //     GROESSER als der Knopf und nicht konzentrisch zu ihm (25px
  //     waagerechter, 0px senkrechter Abstand zwischeneinander). Weil der
  //     Knopf keine senkrechte Polsterung traegt, gewann ohnehin die
  //     Zeile die tatsaechliche Hoehe - die aeussere Huelle malte nur
  //     noch eine zweite, kleiner gerundete Flaeche INNERHALB der
  //     ersten, sichtbar genau dort, wo die Zeile ihre Farbe wechselt
  //     (Zeigergrund, "ausgewaehlt").
  //
  // WARUM EINE OPTION AN ZEPROW UND KEIN DRITTES BAUTEIL
  //     Die Vorgabe, die zu dieser Verschachtelung gefuehrt hat, war
  //     selbst der Fehler: "zepSidebar baut seine Eintraege aus zepRow,
  //     bau keine zweite Zeilenform daneben" - richtig fuer den INHALT
  //     (Symbol, Titel, Nebenzeile, ausgewaehlt-Zustand ist ueberall
  //     derselbe), aber sie hat uebersehen, dass die KLICKBARKEIT eine
  //     eigene Faehigkeit ist, keine eigene Zeilenform. zepRow bekommt
  //     die Faehigkeit darum HIER dazu, statt dass ein zweites Bauteil
  //     neben ihr entsteht - dieselbe Zeile bleibt in allen drei
  //     Fundstellen dieselbe Zeile, nur ihre Huelle aendert sich.
  //
  // WIE DIE HUELLE OHNE EIGENE FLAECHE AUSKOMMT
  //     `new Gtk.Button(...)` DIREKT, nicht `zepButton()`: ein Knopf
  //     braucht seine Tastaturbedienung und seinen Fokus (die
  //     Klickbarkeit, wegen der die alte Fassung ueberhaupt eine Huelle
  //     brauchte - "der Umsetzer brauchte fuer die Klickbarkeit eine
  //     Huelle und bekam so zwei", Bericht dieser Aufgabe), aber KEINE
  //     der vier Rollen von zepButton (die tragen alle eine eigene
  //     Flaeche). `.zep-row-click` (ags-style.template) macht die Huelle
  //     durchsichtig - GENAU EINE Flaeche malt noch etwas: .zep-row
  //     selbst, unveraendert.
  aktion?: () => void
}): Gtk.Widget {
  const zeile = new Gtk.Box({ spacing: 0 })
  zeile.add_css_class("zep-row")
  if (opts.ausgewaehlt) zeile.add_css_class("active")

  const symbol = new Gtk.Label({ label: opts.symbol })
  symbol.add_css_class("zep-row-icon")
  zeile.append(symbol)

  const texte = new Gtk.Box({
    orientation: Gtk.Orientation.VERTICAL,
    spacing: 0,
  })
  texte.add_css_class("zep-row-texts")

  const titel = new Gtk.Label({ label: opts.titel, xalign: 0 })
  titel.add_css_class("zep-row-title")
  titel.set_ellipsize(3)  // Pango.EllipsizeMode.END
  // Vorgabe ist KUERZEN (siehe Funktionskopf) - `ellipsize` allein
  // deckelt nicht die natuerliche Breite, erst dieser Aufruf tut das.
  if (!opts.vollerText) titel.set_max_width_chars({{STYLE_MEASURE_LINE}})
  texte.append(titel)

  if (opts.unterzeile) {
    const unter = new Gtk.Label({ label: opts.unterzeile, xalign: 0 })
    unter.add_css_class("zep-row-sub")
    unter.set_ellipsize(3)
    if (!opts.vollerText) unter.set_max_width_chars({{STYLE_MEASURE_LINE}})
    texte.append(unter)
  }
  zeile.append(texte)

  const luecke = new Gtk.Box({ hexpand: true })
  zeile.append(luecke)

  if (opts.ende) zeile.append(opts.ende)

  if (!opts.aktion) return zeile

  // Eine einzige Huelle, ohne eigene Flaeche - siehe die Begruendung am
  // Funktionskopf (`aktion`).
  const knopf = new Gtk.Button({ can_focus: true })
  knopf.add_css_class("zep-row-click")
  knopf.set_child(zeile)
  knopf.connect("clicked", opts.aktion)
  return knopf
}

// Der Schalter. Gtk.Switch und kein selbstgebauter Knopf: er bringt
// seine Barrierefreiheit und seine Tastaturbedienung mit.
export function zepToggle(
  an: boolean,
  aktion: (an: boolean) => void,
): Gtk.Widget {
  const schalter = new Gtk.Switch({ active: an, valign: Gtk.Align.CENTER })
  schalter.add_css_class("zep-toggle")
  schalter.connect("notify::active", () => aktion(schalter.get_active()))
  return schalter
}

// Die Marke ueber einer Gruppe. Klein, gedaempft, gesperrt gesetzt.
export function zepSectionLabel(text: string): Gtk.Label {
  const marke = new Gtk.Label({ label: text, xalign: 0 })
  marke.add_css_class("zep-section")
  return marke
}

// Der Trenner. Ein Gtk.Separator und keine 1-px-Box: er meldet sich
// den Hilfsmitteln als Trenner.
export function zepDivider(): Gtk.Widget {
  const trenner = new Gtk.Separator({
    orientation: Gtk.Orientation.HORIZONTAL,
  })
  trenner.add_css_class("zep-divider")
  return trenner
}

// NACHGETRAGEN am 18.08.2026, task-4 (die Schale, Stufe 3): das
// Kontrollzentrum bekommt eine Seitenleiste, Netzwerk/Bluetooth/VPN
// ziehen als Seiten hinein. Zwei Bauteile dafuer, keins davon ein
// zweites Zeilenbauteil.
export interface ZepNavEintrag {
  id: string
  titel: string
  symbol: string
}

export interface ZepNavGruppe {
  titel: string          // "VERBINDUNGEN", "SYSTEM", "EINSTELLUNGEN"
  eintraege: ZepNavEintrag[]
}

// Die Seitenleiste. 208 px breit (siehe .zep-sidebar in
// ags-style.template), Gruppen mit Zwischenueberschrift.
//
// JEDER EINTRAG IST EINE ZEPROW - GEBAUT WIE JEDE ANKLICKBARE ZEILE
// DIESES PROJEKTS
//     GEMESSEN am 18.08.2026: createNetworkRow() in ags-network.template
//     und createDeviceRow() in ags-bluetooth.template loesen "eine Zeile,
//     die man anklicken kann" beide gleich - zepButton("", "umrandet",
//     aktion) fuer den Klick, .set_child(zepRow({...})) fuer den Inhalt.
//     zepRow traegt "ausgewaehlt" seit 208e32a bereits (task-5,
//     Bluetooth) und deckelt die natuerliche Breite von Fremdtexten
//     selbst. Eine dritte, eigene Zeilenform fuer die Seitenleiste waere
//     genau die Doppelung, die dieses Vorhaben gerade fuer Knoepfe
//     abgeraeumt hat (sieben Auftraege, siehe test_button_kit.py) - hier
//     also keine.
//
//     BERICHTIGT am 19.08.2026 (Bericht Aufgabe 15/16, "Kasten in
//     Kasten"): "gebaut wie jede anklickbare Zeile" war genau das
//     Problem - zepButton("umrandet") und zepRow malen BEIDE ihre eigene
//     Flaeche, verschachtelt ergibt das zwei Kaesten uebereinander
//     (Zahlen im Bericht dieser Aufgabe). Die Vorgabe "keine dritte
//     Zeilenform" bleibt richtig; falsch war, sie mit einer zweiten
//     HUELLE statt einer Faehigkeit von zepRow selbst umzusetzen. zepRow
//     traegt seither ihr eigenes `aktion` (siehe dort) - der Eintrag
//     bleibt eine Zeile, nicht zwei.
export function zepSidebar(
  gruppen: ZepNavGruppe[],
  aktiv: string,
  aufSeite: (id: string) => void,
): Gtk.Widget {
  const leiste = new Gtk.Box({
    orientation: Gtk.Orientation.VERTICAL,
    spacing: 0,
  })
  leiste.add_css_class("zep-sidebar")

  for (const gruppe of gruppen) {
    const block = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL,
      spacing: 0,
    })
    block.add_css_class("zep-sidebar-group")
    block.append(zepSectionLabel(gruppe.titel))

    for (const eintrag of gruppe.eintraege) {
      block.append(zepRow({
        symbol: eintrag.symbol,
        titel: eintrag.titel,
        ausgewaehlt: eintrag.id === aktiv,
        aktion: () => aufSeite(eintrag.id),
      }))
    }

    leiste.append(block)
  }

  return leiste
}

/**
 * Der Kopf einer Seite. Er IST der Zustand, nicht eine Titelzeile
 * darueber: "Bluetooth ist an" als Ueberschrift, darunter die Nebenzeile
 * "1 von 2 Geraeten verbunden", rechts das Bedienelement.
 *
 * `ende` ist frei - ein zepToggle, ein zepButton, oder nichts.
 *
 * Der Titel traegt KEINE eigene Klasse - seine Schrift (19px) kommt aus
 * .zep-state-head selbst, per Vererbung (siehe ags-style.template). Die
 * Nebenzeile bekommt darum ausdruecklich .zep-row-sub zurueck (dasselbe
 * Bauteil-CSS wie in zepRow), sonst waere sie ebenfalls 19px gross.
 */
export function zepStateHeader(opts: {
  titel: string
  unterzeile?: string
  ende?: Gtk.Widget
}): Gtk.Widget {
  const kopf = new Gtk.Box({ spacing: 0 })
  kopf.add_css_class("zep-state-head")

  const texte = new Gtk.Box({
    orientation: Gtk.Orientation.VERTICAL,
    spacing: 0,
  })

  const titel = new Gtk.Label({ label: opts.titel, xalign: 0 })
  texte.append(titel)

  if (opts.unterzeile) {
    const unter = new Gtk.Label({ label: opts.unterzeile, xalign: 0 })
    unter.add_css_class("zep-row-sub")
    texte.append(unter)
  }
  kopf.append(texte)

  const luecke = new Gtk.Box({ hexpand: true })
  kopf.append(luecke)

  if (opts.ende) kopf.append(opts.ende)
  return kopf
}
