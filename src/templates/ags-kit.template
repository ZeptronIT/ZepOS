// DIE BAUTEILE DER ZEPOS-FENSTER
//
// Erzeugt nach ags/utils/kit.ts. Wer ein Fenster baut, ruft von hier -
// er baut keinen Gtk.Button und haengt keine eigene Klasse dran.
//
// WARUM FUNKTIONEN UND NICHT NUR CSS-KLASSEN
//     GEMESSEN am 18.08.2026: ags-style.template trug 45 Knopfregeln in
//     41 Klassen, ohne eine einzige gemeinsame. Es gab keine Regel, die
//     das verboten haette - es gab nur keine, die es leicht gemacht
//     haette. Eine Klasse, an die man sich halten SOLL, ist schwaecher
//     als eine Funktion, die man aufruft; die eine ist eine Bitte, die
//     andere eine Schnittstelle.
//
// WAS HIER NICHT HINEINGEHOERT: alles, was ein Fenster besonders macht.
// Das Kit kennt Knopf, Zeile, Schalter, Abschnittsmarke und Trenner -
// mehr nicht. Ein Bauteil, das nur ein Fenster braucht, gehoert in
// dieses Fenster.
import { Gtk, Gdk } from "ags/gtk4"

export type ZepRolle = "voll" | "umrandet" | "still" | "kritisch"

// Ein Knopf. EINE Hoehe, EIN Radius, vier Rollen.
//
// Die Rolle steht in der Klasse und nicht im Aufruf des Aussehens: das
// Stylesheet entscheidet, wie "kritisch" aussieht, nicht diese Datei.
export function zepButton(
  label: string,
  rolle: ZepRolle,
  aktion: () => void,
): Gtk.Button {
  const knopf = new Gtk.Button({ can_focus: true })
  knopf.set_child(new Gtk.Label({ label }))
  knopf.add_css_class("zep-btn")
  knopf.add_css_class(`zep-btn-${rolle}`)
  knopf.connect("clicked", aktion)
  return knopf
}

// Eine Zeile: Symbol, Titel, optionale Nebenzeile, optionales Ende.
//
// Titel und Nebenzeile kuerzen UND deckeln ihre natuerliche Breite -
// beides zusammen, nicht nur das eine. `ellipsize` senkt bei GTK nur
// die MINDESTBREITE eines Labels, nicht seine NATUERLICHE; ohne
// `max_width_chars` blaeht ein langer Text die Zeile und damit das
// ganze Fenster auf, bis etwas von aussen deckelt. GENAU DAS war ein
// gemessener Fehler dieses Projekts: am 17.08.2026 hat eine
// Beschriftung ohne `max_width_chars` das Netzfenster auf 660 Punkte
// Mindestbreite aufgeblasen (ags-network.template, Kopf der Datei,
// `.net-current min=660`) und dieselbe Ursache in ags-bluetooth.template
// das Fenster auf 460 statt 312 Punkte gebracht (dort, Kopf der Datei,
// vor der Umstellung auf zepRow).
//
// NACHGETRAGEN am 18.08.2026, task-6: zepRow selbst rief bis hierher
// `set_ellipsize(3)` ohne `set_max_width_chars` - also GENAU die
// Luecke, die die beiden Fenster oben aufgeblasen hat, nur diesmal im
// geteilten Bauteil statt in einem einzelnen Fenster. Elf der zwoelf
// Fenster tragen unbegrenzte Fremdtexte (VPN-Profilnamen, WLAN-Namen,
// Themennamen) - ohne Deckel haette das Kit diesen Fehler elfmal
// wiederholt, statt ihn zu verhindern. Vorgabe ist darum KUERZEN, mit
// STYLE_MEASURE_LINE als Grenze (dieselbe schmale Spalte wie in
// ags-network.template und ags-bluetooth.template). Ein Fenster, das
// ausnahmsweise den vollen Text braucht, setzt `vollerText: true`.
export function zepRow(opts: {
  symbol: string
  titel: string
  unterzeile?: string
  ende?: Gtk.Widget
  // NACHGETRAGEN am 18.08.2026, task-5: der "ausgewaehlt"-Zustand fehlte
  // hier, und Bluetooth ist der erste Verbraucher, der ihn braucht - das
  // verbundene Geraet muss sich von den uebrigen abheben. GEZAEHLT
  // (`grep -oE '\.[a-z][a-z0-9-]*\.active|&\.active' ags-style.template`):
  // 18 Fundstellen im Bestand (.net-item.active, .cc-toggle-btn.active,
  // .se-tab-btn.active, ...), zepRow bekommt darum dieselbe Klasse statt
  // einer eigenen.
  ausgewaehlt?: boolean
  // NACHGETRAGEN am 18.08.2026, task-6: die Abschaltung fuer die
  // Kuerzung oben - siehe die Begruendung am Funktionskopf. Vorgabe ist
  // KUERZEN (also `false`/nicht gesetzt); nur ein Fenster, das
  // ausdruecklich den vollen Text braucht, setzt hier `true`.
  vollerText?: boolean
  // NACHGETRAGEN am 19.08.2026 (Bericht Aufgabe 15/16, Fund "Kasten in
  // Kasten"): eine anklickbare Zeile, ohne eine zweite Huelle darueber.
  //
  // WAS VORHER STAND, UND WARUM DAS FALSCH WAR
  //     Drei Fundstellen (zepSidebar hier, createNetworkRow in
  //     ags-network.template, createDeviceRow in ags-bluetooth.template)
  //     loesten "eine Zeile, die man anklicken kann" alle gleich:
  //     `zepButton("", "umrandet", aktion)`, dann `.set_child(zepRow(...))`
  //     hineingesteckt. BEIDE Bauteile malen ihre EIGENE Flaeche
  //     (background/border/border-radius, ags-style.template)  - GEMESSEN
  //     bei Vorgabegroesse: Knopf 49px hoch, Radius 8, Rand IMMER
  //     sichtbar; Zeile 74px hoch, Radius 12, Randstreifen nur "aktiv" -
  //     GROESSER als der Knopf und nicht konzentrisch zu ihm (25px
  //     waagerechter, 0px senkrechter Abstand zwischeneinander). Weil der
  //     Knopf keine senkrechte Polsterung traegt, gewann ohnehin die
  //     Zeile die tatsaechliche Hoehe - die aeussere Huelle malte nur
  //     noch eine zweite, kleiner gerundete Flaeche INNERHALB der
  //     ersten, sichtbar genau dort, wo die Zeile ihre Farbe wechselt
  //     (Zeigergrund, "ausgewaehlt").
  //
  // WARUM EINE OPTION AN ZEPROW UND KEIN DRITTES BAUTEIL
  //     Die Vorgabe, die zu dieser Verschachtelung gefuehrt hat, war
  //     selbst der Fehler: "zepSidebar baut seine Eintraege aus zepRow,
  //     bau keine zweite Zeilenform daneben" - richtig fuer den INHALT
  //     (Symbol, Titel, Nebenzeile, ausgewaehlt-Zustand ist ueberall
  //     derselbe), aber sie hat uebersehen, dass die KLICKBARKEIT eine
  //     eigene Faehigkeit ist, keine eigene Zeilenform. zepRow bekommt
  //     die Faehigkeit darum HIER dazu, statt dass ein zweites Bauteil
  //     neben ihr entsteht - dieselbe Zeile bleibt in allen drei
  //     Fundstellen dieselbe Zeile, nur ihre Huelle aendert sich.
  //
  // WIE DIE HUELLE OHNE EIGENE FLAECHE AUSKOMMT
  //     `new Gtk.Button(...)` DIREKT, nicht `zepButton()`: ein Knopf
  //     braucht seine Tastaturbedienung und seinen Fokus (die
  //     Klickbarkeit, wegen der die alte Fassung ueberhaupt eine Huelle
  //     brauchte - "der Umsetzer brauchte fuer die Klickbarkeit eine
  //     Huelle und bekam so zwei", Bericht dieser Aufgabe), aber KEINE
  //     der vier Rollen von zepButton (die tragen alle eine eigene
  //     Flaeche). `.zep-row-click` (ags-style.template) macht die Huelle
  //     durchsichtig - GENAU EINE Flaeche malt noch etwas: .zep-row
  //     selbst, unveraendert.
  aktion?: () => void
  // NACHGETRAGEN am 19.08.2026 (Aufgabe 19, Nutzermeldung "die sidebar
  // items nav links sind viel zu hoch"): eine Seitenleiste braucht eine
  // ANDERE Zeilenhoehe als eine Inhaltskarte - siehe die Herleitung von
  // STYLE_NAV_ROW_HEIGHT in sizes.py. `navEintrag` ist die Ausnahme wie
  // `ausgewaehlt`/`vollerText`: keine zweite Zeilenform, nur ein
  // zusaetzlicher CSS-Modifikator auf DERSELBEN Zeile (Klasse
  // `zep-row-nav`, ags-style.template) - genau die Faehigkeit, die
  // `aktion` schon vorgemacht hat.
  navEintrag?: boolean
  /**
   * `ende` ist selbst BEDIENBAR und gehoert deshalb NEBEN die klickbare
   * Huelle, nicht hinein.
   *
   * NACHGETRAGEN am 01.09.2026, und die Zahl davor ist eine MESSUNG und
   * keine Ueberlegung.
   *
   * WAS GEMESSEN WURDE (tests/render/test_zeprow_verschachtelung.py, am
   * abgebildeten Fenster im verschachtelten Compositor, mit echten
   * Tasten ueber wtype: zweimal Tabulator auf den Schalter, dann
   * Leertaste). Die Zahlen sind die der GEGENPROBE - sie entstehen
   * jederzeit neu, indem man `endeBedienbar` in ags-vpn.template
   * ausbaut:
   *
   *     4000ms --fokus-gelesen-- fokus=GtkSwitch[zep-toggle]
   *     4448ms KNOPF-clicked     fokus=GtkSwitch[zep-toggle]
   *
   *     Der Fokus lag auf dem SCHALTER, gefeuert hat die ZEILE, und
   *     `notify::active` kam kein einziges Mal. Der Tabulator erreicht
   *     den Schalter (die Fokuskette lautet
   *     `GtkButton[zep-row-click] > GtkSwitch[zep-toggle] > ...`), aber
   *     die Leertaste dort blaettert in die Einzelheiten statt zu
   *     schalten.
   *
   *     Auf Deutsch: wer die Maus nicht benutzen kann, kann eine
   *     VPN-Verbindung nicht ein- und ausschalten. Die Zeile ist der
   *     einzige Ort, an dem der Schalter steht.
   *
   * WORAN ES LAG
   *     Ein Gtk.Button ist in GTK4 kein Behaelter fuer bedienbare
   *     Kinder. Steckt der Schalter IN der Huelle, liegt die Huelle in
   *     seiner Ereigniskette darueber und faengt die Taste ab.
   *
   * WAS DIESE BETRIEBSART TUT
   *     Sie haengt `ende` als GESCHWISTER der Huelle in die Zeile statt
   *     hinein:
   *
   *         Vorgabe:  Button[.zep-row-click] > Box[.zep-row] > [.., ende]
   *         hier:     Box[.zep-row] > [ Button[.zep-row-click] > [..],
   *                                     ende ]
   *
   *     Die Zeile bleibt als Ganzes klickbar - `.zep-row` ist weiterhin
   *     der Kasten, der gezeichnet wird, und der Klick auf Symbol, Text
   *     und Luecke geht weiter an `aktion`. Nur das bedienbare Kind
   *     liegt nicht mehr darunter.
   *
   * WARUM EINE OPTION UND KEINE NEUE VORGABE
   *     GEZAEHLT am 02.09.2026 ueber alle src/templates/*.template
   *     (tests/src/test_zeprow_zaehlung.py): von SECHZEHN zepRow-
   *     Aufrufen setzt GENAU EINER `aktion` und `ende` zugleich -
   *     ags-vpn.template. Bluetooth, Netz, Seitenleiste,
   *     Kontrollzentrum, Dock, Home und die Verbindungseinstellungen
   *     setzen nur `aktion` und haengen kein bedienbares Kind in ihre
   *     Zeile; ags-settings.template setzt fuenfmal nur `ende` ohne
   *     `aktion`. Eine neue Vorgabe aenderte also fuenfzehn Aufrufer,
   *     um einen zu reparieren.
   *
   *     Der Weg der Vorgabe bleibt darum ZEICHEN FUER ZEICHEN derselbe
   *     Baum wie vorher - siehe die Zuordnung unten, die genau dafuer
   *     zwei getrennte Zusammenbauten hat statt eines mit Bedingungen
   *     darin.
   *
   * WIRKT NUR ZUSAMMEN MIT `aktion` UND `ende`. Ohne Huelle gibt es
   * nichts zu trennen, ohne `ende` nichts zu verschieben.
   */
  endeBedienbar?: boolean
}): Gtk.Widget {
  const zeile = new Gtk.Box({ spacing: 0 })
  zeile.add_css_class("zep-row")
  if (opts.ausgewaehlt) zeile.add_css_class("active")
  if (opts.navEintrag) zeile.add_css_class("zep-row-nav")

  // AUFGABE 19, NUTZERMELDUNG ("das icon im navlink sollte links sein
  // und rechts davon der text aber aktuell steht der text oben und das
  // icon in der mitte"): GEMESSEN (Bildlauf dieser Aufgabe, Debug-Bau
  // mit rot/gruen eingefaerbten Testkindern) - Symbol und `texte`
  // STANDEN bereits nebeneinander in `zeile` (Gtk.Orientation.HORIZONTAL
  // ist die GTK4-Vorgabe fuer Gtk.Box, unveraendert), aber `texte` ist
  // selbst eine Box mit VERTICAL-Orientierung, und OHNE `valign` fuellt
  // sie (Vorgabe FILL) die ganze Zeilenhoehe und packt ihr einziges Kind
  // (den Titel) an ihren eigenen ANFANG - waehrend `symbol` (ein Label,
  // kein Behaelter) unter FILL auf sein Zentrum abbildet. Ergebnis: der
  // Titel sitzt am oberen Rand der Zeile, das Symbol in ihrer Mitte -
  // "Text oben, Symbol darunter", exakt die Meldung. Isoliert bestaetigt:
  // dieselbe Zeile OHNE den texte-Umbau (Titel direkt in `zeile`) zeigte
  // beide nebeneinander; der `texte`-Umbau MIT `valign: CENTER` ebenso.
  // Betrifft jeden Aufrufer von zepRow (Kartenzeilen wie Seitenleiste),
  // darum hier behoben und nicht nur fuer `navEintrag`.
  const symbol = new Gtk.Label({ label: opts.symbol, valign: Gtk.Align.CENTER })
  symbol.add_css_class("zep-row-icon")

  const texte = new Gtk.Box({
    orientation: Gtk.Orientation.VERTICAL,
    spacing: 0,
    valign: Gtk.Align.CENTER,
  })
  texte.add_css_class("zep-row-texts")

  const titel = new Gtk.Label({ label: opts.titel, xalign: 0 })
  titel.add_css_class("zep-row-title")
  titel.set_ellipsize(3)  // Pango.EllipsizeMode.END
  // Vorgabe ist KUERZEN (siehe Funktionskopf) - `ellipsize` allein
  // deckelt nicht die natuerliche Breite, erst dieser Aufruf tut das.
  if (!opts.vollerText) titel.set_max_width_chars({{STYLE_MEASURE_LINE}})
  texte.append(titel)

  if (opts.unterzeile) {
    const unter = new Gtk.Label({ label: opts.unterzeile, xalign: 0 })
    unter.add_css_class("zep-row-sub")
    unter.set_ellipsize(3)
    if (!opts.vollerText) unter.set_max_width_chars({{STYLE_MEASURE_LINE}})
    texte.append(unter)
  }

  const luecke = new Gtk.Box({ hexpand: true })

  // ZWEI GETRENNTE ZUSAMMENBAUTEN UND KEIN EINZELNER MIT BEDINGUNGEN
  // DARIN - siehe `endeBedienbar` am Funktionskopf.
  //
  //     Der Weg der Vorgabe unten haengt Symbol, Texte, Luecke und
  //     `ende` in GENAU DIESER Reihenfolge in `zeile` und wickelt
  //     `zeile` dann in die Huelle. Das ist Zeichen fuer Zeichen der
  //     Baum, den fuenfzehn Aufrufer heute bekommen - ein Zusammenbau mit
  //     `if`s darin haette dieselbe Reihenfolge nur BEHAUPTET.
  const getrennt = Boolean(opts.aktion && opts.ende && opts.endeBedienbar)

  if (!getrennt) {
    zeile.append(symbol)
    zeile.append(texte)
    zeile.append(luecke)
    if (opts.ende) zeile.append(opts.ende)

    if (!opts.aktion) return zeile

    // Eine einzige Huelle, ohne eigene Flaeche - siehe die Begruendung
    // am Funktionskopf (`aktion`).
    const knopf = new Gtk.Button({ can_focus: true })
    knopf.add_css_class("zep-row-click")
    knopf.set_child(zeile)
    knopf.connect("clicked", opts.aktion)
    return knopf
  }

  // DIE GETRENNTE BETRIEBSART
  //
  //     `zeile` ist hier der AEUSSERE Kasten und traegt weiterhin
  //     `.zep-row` - sie ist es, die gezeichnet wird, und Zeigergrund,
  //     Rundung und der Zustand "ausgewaehlt" bleiben damit unveraendert
  //     dieselbe Flaeche wie in der Vorgabe.
  //
  //     Die Huelle bekommt NUR Symbol, Texte und Luecke; `ende` wird ihr
  //     Geschwister. Damit liegt kein bedienbares Kind mehr unter einem
  //     Gtk.Button, und die Leertaste auf dem Schalter erreicht den
  //     Schalter.
  //
  //     `hexpand` auf beiden: die Huelle nimmt den Platz bis zum `ende`,
  //     sonst sass der Klickbereich nur unter dem Text und die Luecke
  //     daneben waere tot - genau das, was `luecke` verhindern soll.
  const huelle = new Gtk.Button({ can_focus: true, hexpand: true })
  huelle.add_css_class("zep-row-click")
  // Die zweite Klasse traegt Zeigerdruck und Tastaturfokus. Die zwei
  // Regeln zu `.zep-row-click` haben einen Nachfahrenpfeil auf
  // `.zep-row` und treffen hier nichts mehr, weil die Zeile in dieser
  // Betriebsart UEBER der Huelle liegt statt darunter. GEMESSEN am
  // 01.09.2026, was ohne sie bleibt: GTKs eigener Rahmen (128,165,211)
  // statt $accent (#33C9EE) und gar keine Fuellung. Herleitung bei
  // `.zep-row-click-getrennt` in ags-style.template.
  huelle.add_css_class("zep-row-click-getrennt")
  huelle.connect("clicked", opts.aktion!)

  const inhalt = new Gtk.Box({ spacing: 0, hexpand: true })
  inhalt.append(symbol)
  inhalt.append(texte)
  inhalt.append(luecke)
  huelle.set_child(inhalt)

  zeile.append(huelle)
  zeile.append(opts.ende!)
  return zeile
}

// Der Schalter. Gtk.Switch und kein selbstgebauter Knopf: er bringt
// seine Barrierefreiheit und seine Tastaturbedienung mit.
export function zepToggle(
  an: boolean,
  aktion: (an: boolean) => void,
): Gtk.Widget {
  const schalter = new Gtk.Switch({ active: an, valign: Gtk.Align.CENTER })
  schalter.add_css_class("zep-toggle")
  schalter.connect("notify::active", () => aktion(schalter.get_active()))
  return schalter
}

// Die Marke ueber einer Gruppe. Klein, gedaempft, gesperrt gesetzt.
export function zepSectionLabel(text: string): Gtk.Label {
  // ZENTRIERT SEIT DEM 19.08.2026, auf Ansage des Nutzers: "sorge auch
  // dafuer das die titel in der sidebar zentriert sind".
  //
  // Hier stand `xalign: 0` - das ist die Zeile, die den Text links
  // festnagelt, und nicht das Stylesheet. In GTK4 ist die Ausrichtung
  // eines Labels eine Widget-Eigenschaft; wer sie in .zep-section
  // sucht, findet sie nicht und aendert am Bildschirm nichts.
  //
  // GEMEINT SIND DIE UEBERSCHRIFTEN UND NICHT DIE EINTRAEGE: ein
  // Eintrag traegt Symbol links und Beschriftung rechts daneben, am
  // selben Tag ausdruecklich so bestellt ("das icon im navlink sollte
  // links sein und rechts davon der text"). Ihn zu zentrieren wuerde
  // derselben Ansage widersprechen - darum steht die Aenderung hier
  // und nicht in zepRow.
  const marke = new Gtk.Label({ label: text, xalign: 0.5 })
  marke.add_css_class("zep-section")
  return marke
}

// Die Zeile, die sagt, dass gerade etwas laeuft. Scheibe links, Satz
// daneben.
//
// NACHGETRAGEN am 20.08.2026, Aufgabe 36. GEMELDET, woertlich: "die ags
// fenster bluetooth und wlan laden teilweise sehr lange um den inhalt
// anzuzeigen das muss performanter und user friendly werden" - zwei
// Beschwerden in einem Satz. Dies ist die Antwort auf die zweite; die
// erste (Geschwindigkeit) steht in ags-network.template und
// ags-bluetooth.template.
//
// WARUM INS KIT UND NICHT IN DIE BEIDEN SEITEN
//     GEZAEHLT am 20.08.2026 per grep ueber Kit und Stylesheet: fuer
//     "laedt" gab es KEIN Bauteil. Das einzige Vorbild im ganzen Baum
//     war ein von Hand gebauter Gtk.Spinner in ags-vpn.template
//     ("Disconnecting ..."), ohne CSS-Klasse und ohne zweiten
//     Verbraucher. Haetten Netzwerk und Bluetooth sich jetzt jeder eine
//     eigene Scheibe gebaut, waeren es drei Fassungen derselben Aussage -
//     genau die Lage, aus der die 45 Knopfregeln in 41 Klassen
//     entstanden sind (siehe Kopf dieser Datei).
//
// WAS HIER STEHT UND WAS NICHT: dieses Bauteil dreht eine Scheibe und
// setzt einen Text daneben. Es entscheidet NICHT, wann es erscheint und
// WAS dort steht - das weiss nur die Seite, die wartet. Der Text kommt
// deshalb als Parameter herein und nicht als Vorgabe von hier: eine
// Scheibe, die "wird gesucht" sagt, waehrend in Wahrheit ein Fehler
// vorliegt, ist schlimmer als eine Fehlermeldung. Wer dieses Bauteil
// zeigt, muss es auch wieder wegnehmen.
export function zepBusy(text: string): Gtk.Widget {
  const zeile = new Gtk.Box({ valign: Gtk.Align.CENTER })
  zeile.add_css_class("zep-busy")

  // `spinning: true` im Konstruktor und nicht spaeter: die Scheibe
  // laeuft, sobald sie im Baum haengt, und sie haengt nur so lange, wie
  // die Seite sie haengen laesst.
  const scheibe = new Gtk.Spinner({ spinning: true, valign: Gtk.Align.CENTER })
  scheibe.add_css_class("zep-busy-spinner")

  const satz = new Gtk.Label({ label: text, xalign: 0 })
  satz.add_css_class("zep-busy-text")
  // Gekuerzt UND gedeckelt, dieselbe Begruendung und dieselbe Grenze wie
  // bei zepRow oben: der Satz kann einen Netz- oder Geraetenamen
  // tragen, und `ellipsize` allein senkt nur die Mindestbreite.
  satz.set_ellipsize(3)  // Pango.EllipsizeMode.END
  satz.set_max_width_chars({{STYLE_MEASURE_LINE}})

  zeile.append(scheibe)
  zeile.append(satz)
  return zeile
}

// Der Trenner. Ein Gtk.Separator und keine 1-px-Box: er meldet sich
// den Hilfsmitteln als Trenner.
export function zepDivider(): Gtk.Widget {
  const trenner = new Gtk.Separator({
    orientation: Gtk.Orientation.HORIZONTAL,
  })
  trenner.add_css_class("zep-divider")
  return trenner
}

// NACHGETRAGEN am 18.08.2026, task-4 (die Schale, Stufe 3): das
// Kontrollzentrum bekommt eine Seitenleiste, Netzwerk/Bluetooth/VPN
// ziehen als Seiten hinein. Zwei Bauteile dafuer, keins davon ein
// zweites Zeilenbauteil.
export interface ZepNavEintrag {
  id: string
  titel: string
  symbol: string
}

export interface ZepNavGruppe {
  titel: string          // "VERBINDUNGEN", "SYSTEM", "EINSTELLUNGEN"
  eintraege: ZepNavEintrag[]
}

// Die Seitenleiste. 208 px breit (siehe .zep-sidebar in
// ags-style.template), Gruppen mit Zwischenueberschrift.
//
// JEDER EINTRAG IST EINE ZEPROW - GEBAUT WIE JEDE ANKLICKBARE ZEILE
// DIESES PROJEKTS
//     GEMESSEN am 18.08.2026: createNetworkRow() in ags-network.template
//     und createDeviceRow() in ags-bluetooth.template loesen "eine Zeile,
//     die man anklicken kann" beide gleich - zepButton("", "umrandet",
//     aktion) fuer den Klick, .set_child(zepRow({...})) fuer den Inhalt.
//     zepRow traegt "ausgewaehlt" seit 208e32a bereits (task-5,
//     Bluetooth) und deckelt die natuerliche Breite von Fremdtexten
//     selbst. Eine dritte, eigene Zeilenform fuer die Seitenleiste waere
//     genau die Doppelung, die dieses Vorhaben gerade fuer Knoepfe
//     abgeraeumt hat (sieben Auftraege, siehe test_button_kit.py) - hier
//     also keine.
//
//     BERICHTIGT am 19.08.2026 (Bericht Aufgabe 15/16, "Kasten in
//     Kasten"): "gebaut wie jede anklickbare Zeile" war genau das
//     Problem - zepButton("umrandet") und zepRow malen BEIDE ihre eigene
//     Flaeche, verschachtelt ergibt das zwei Kaesten uebereinander
//     (Zahlen im Bericht dieser Aufgabe). Die Vorgabe "keine dritte
//     Zeilenform" bleibt richtig; falsch war, sie mit einer zweiten
//     HUELLE statt einer Faehigkeit von zepRow selbst umzusetzen. zepRow
//     traegt seither ihr eigenes `aktion` (siehe dort) - der Eintrag
//     bleibt eine Zeile, nicht zwei.
export function zepSidebar(
  gruppen: ZepNavGruppe[],
  aktiv: string,
  aufSeite: (id: string) => void,
): Gtk.Widget {
  const leiste = new Gtk.Box({
    orientation: Gtk.Orientation.VERTICAL,
    spacing: 0,
  })
  leiste.add_css_class("zep-sidebar")

  for (const gruppe of gruppen) {
    const block = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL,
      spacing: 0,
    })
    block.add_css_class("zep-sidebar-group")
    block.append(zepSectionLabel(gruppe.titel))

    for (const eintrag of gruppe.eintraege) {
      block.append(zepRow({
        symbol: eintrag.symbol,
        titel: eintrag.titel,
        ausgewaehlt: eintrag.id === aktiv,
        aktion: () => aufSeite(eintrag.id),
        // Ein Navigationseintrag ist einzeilig (Symbol, Beschriftung,
        // sonst nichts) und braucht darum STYLE_NAV_ROW_HEIGHT statt der
        // Kartenhoehe STYLE_ROW_HEIGHT - siehe die Begruendung bei
        // `navEintrag` oben und bei STYLE_NAV_ROW_HEIGHT in sizes.py.
        navEintrag: true,
      }))
    }

    leiste.append(block)
  }

  return leiste
}

/**
 * Der Kopf einer Seite. Er IST der Zustand, nicht eine Titelzeile
 * darueber: "Bluetooth ist an" als Ueberschrift, darunter die Nebenzeile
 * "1 von 2 Geraeten verbunden", rechts das Bedienelement.
 *
 * `ende` ist frei - ein zepToggle, ein zepButton, oder nichts.
 *
 * Der Titel traegt KEINE eigene Klasse - seine Schrift (19px) kommt aus
 * .zep-state-head selbst, per Vererbung (siehe ags-style.template). Die
 * Nebenzeile bekommt darum ausdruecklich .zep-row-sub zurueck (dasselbe
 * Bauteil-CSS wie in zepRow), sonst waere sie ebenfalls 19px gross.
 */
export function zepStateHeader(opts: {
  titel: string
  unterzeile?: string
  ende?: Gtk.Widget
}): Gtk.Widget {
  const kopf = new Gtk.Box({ spacing: 0 })
  kopf.add_css_class("zep-state-head")

  // valign: CENTER aus demselben Grund wie bei zepRow (siehe dort,
  // Aufgabe 19) - derselbe Aufbau (VERTICAL-Box in einer HORIZONTAL-Box),
  // hier bisher ohne sichtbare Folge, weil `kopf` keine erzwungene
  // Mindesthoehe traegt und `texte` meist der hoechste Nachbar ist. Nicht
  // erst warten, bis ein `ende` mit mehr Hoehe (z.B. ein zweizeiliger
  // Knopf) denselben Fehler hier auch sichtbar macht.
  const texte = new Gtk.Box({
    orientation: Gtk.Orientation.VERTICAL,
    spacing: 0,
    valign: Gtk.Align.CENTER,
  })

  // NACHGETRAGEN am 19.08.2026 (Aufgabe 19, Nutzermeldung "ich will
  // auch nicht horizontal scrollen"): zepStateHeader deckelte seinen
  // Titel bisher NICHT, anders als zepRow (siehe die Begruendung am
  // Funktionskopf von zepRow oben - `ellipsize` allein senkt nur die
  // MINDESTbreite, nicht die natuerliche). GEMESSEN: `titel` nimmt in
  // ags-network.template `connInfo.name` entgegen - den WLAN-Namen,
  // unbegrenzt und von aussen gegeben. STYLE_MEASURE_LINE (45 Zeichen)
  // ist dieselbe Grenze, die zepRow fuer genau diesen Fall schon setzt,
  // und weit genug fuer jeden WLAN-Namen (WPA2 selbst erlaubt hoechstens
  // 32).
  const titel = new Gtk.Label({ label: opts.titel, xalign: 0 })
  titel.set_ellipsize(3)  // Pango.EllipsizeMode.END
  titel.set_max_width_chars({{STYLE_MEASURE_LINE}})
  texte.append(titel)

  if (opts.unterzeile) {
    const unter = new Gtk.Label({ label: opts.unterzeile, xalign: 0 })
    unter.add_css_class("zep-row-sub")
    unter.set_ellipsize(3)
    unter.set_max_width_chars({{STYLE_MEASURE_LINE}})
    texte.append(unter)
  }
  kopf.append(texte)

  const luecke = new Gtk.Box({ hexpand: true })
  kopf.append(luecke)

  if (opts.ende) kopf.append(opts.ende)
  return kopf
}


// ============================================================================
// EINE FLAECHE JE SCHIRM - AUCH NACH DEM ANSTECKEN
// ============================================================================

/** Was jeSchirm() zurueckgibt. */
export interface SchirmFolge {
  /** Wie viele Stuecke gerade stehen. Fuer Messungen und Protokolle. */
  anzahl: () => number
  /** Alles abraeumen und nicht mehr mitzaehlen. */
  aufloesen: () => void
}

/** Fuer jeden Schirm ein Stueck bauen - jetzt UND bei jeder Aenderung.
 *
 * WAS GEMELDET WURDE
 *     Der Nutzer am 01.09.2026, woertlich: "ich habe einen bildschirm
 *     hingezogen und ueber dem monitor geplaced und trotzdem wird die
 *     oberflaeche nicht erweitert - ich sehe auf dem monitor nicht den
 *     header usw, die dock dort nochmal, sondern einfach nur ein grauer
 *     bildschirm".
 *
 * DIE URSACHE, GEMESSEN am 01.09.2026
 *     Fuenf Bauteile bauten eine Layer-Shell-Flaeche je Schirm - die
 *     Leiste, das Dock, das Home, der Abschaltknopf und der
 *     Starterknopf -, und alle fuenf fragten `get_monitors()` GENAU
 *     EINMAL, beim Start. Ein `grep` ueber src/templates fand am selben
 *     Tag KEIN einziges "items-changed", "monitor-added" oder
 *     "monitor-removed". Ein Schirm, der nach dem Anmelden dazukam,
 *     bekam deshalb nie eine Flaeche: er blieb grau, weil auf ihm
 *     nichts gebaut worden war.
 *
 * WARUM EIN EINZIGER WEG UND NICHT FUENF
 *     Fuenf Schleifen sind fuenf Stellen, an denen jemand das
 *     Abraeumen vergisst - und das Abraeumen ist die Haelfte, die weh
 *     tut: eine Flaeche, deren Schirm verschwindet, haelt einen Zeiger
 *     auf einen Gdk.Monitor, den es nicht mehr gibt. Wird sie danach
 *     wieder sichtbar gemacht (das Dock und die beiden Knoepfe tun
 *     genau das bei jedem SUPER+B), landet sie auf dem Schirm, den der
 *     Compositor sich aussucht. So entstehen zwei Leisten auf einem
 *     Schirm.
 *
 * WORAN ERKANNT WIRD, DASS EIN SCHIRM DERSELBE IST
 *     Am Gdk.Monitor SELBST und nicht an seinem Anschlussnamen. Ein
 *     Schirm, der abgesteckt und wieder angesteckt wird, heisst wieder
 *     "DP-1" - aber GDK wirft sein altes Objekt weg und legt ein neues
 *     an. Wer nach dem Namen vergleicht, haelt die alte, tote Flaeche
 *     fuer die richtige und baut keine neue; wer nach dem Objekt
 *     vergleicht, raeumt die tote ab und baut eine, die wirklich auf
 *     dem neuen Ausgang sitzt.
 *
 * ERST ABRAEUMEN, DANN BAUEN, und das ist kein Geschmack: ein Wechsel
 * kann beides in einem Ereignis bringen (ein Schirm geht, einer kommt).
 * Andersherum stuenden fuer einen Augenblick zwei Flaechen desselben
 * Bauteils da - genau das Bild, das der Nutzer gemeldet hat.
 *
 * `baue` und `raeumeAb` laufen in einem eigenen try: ein Bauteil, das
 * an einem Schirm scheitert, darf die anderen vier nicht mitnehmen.
 * Dieselbe Ueberlegung, aus der ags-config.template jedes Widget in
 * sein eigenes try setzt.
 */
export function jeSchirm<T>(
  name: string,
  baue: (monitor: Gdk.Monitor) => T,
  raeumeAb: (stueck: T) => void,
): SchirmFolge {
  const display = Gdk.Display.get_default()
  const gebaut = new Map<Gdk.Monitor, T>()
  if (!display) {
    console.error(`Keine Anzeige - es gibt kein ${name}`)
    return { anzahl: () => 0, aufloesen: () => {} }
  }

  const monitors = display.get_monitors()

  const abgleichen = () => {
    const jetzt: Gdk.Monitor[] = []
    for (let index = 0; index < monitors.get_n_items(); index++) {
      const monitor = monitors.get_item(index) as Gdk.Monitor
      if (monitor) jetzt.push(monitor)
    }

    for (const [monitor, stueck] of [...gebaut]) {
      if (jetzt.indexOf(monitor) >= 0) continue
      gebaut.delete(monitor)
      try {
        raeumeAb(stueck)
      } catch (fehler) {
        console.error(`${name}: eine Flaeche liess sich nicht abraeumen:`,
                      fehler)
      }
    }

    for (const monitor of jetzt) {
      if (gebaut.has(monitor)) continue
      try {
        gebaut.set(monitor, baue(monitor))
      } catch (fehler) {
        console.error(`${name}: keine Flaeche fuer ${monitor.connector}:`,
                      fehler)
      }
    }
  }

  const kennung = monitors.connect("items-changed", () => abgleichen())
  abgleichen()

  return {
    anzahl: () => gebaut.size,
    aufloesen: () => {
      monitors.disconnect(kennung)
      for (const [monitor, stueck] of [...gebaut]) {
        gebaut.delete(monitor)
        try {
          raeumeAb(stueck)
        } catch (fehler) {
          console.error(`${name}: eine Flaeche liess sich nicht abraeumen:`,
                        fehler)
        }
      }
    },
  }
}
