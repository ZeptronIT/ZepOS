#!/bin/bash
# =========================================
# HYPRLAND UNIVERSAL START SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/start-hyprland-config.template
# =========================================
#
# Usage: start-hyprland [profile] [--force]
# Example: start-hyprland laptop
#         start-hyprland desktop --force
#         start-hyprland              # Auto-detect monitors (first-time setup)
#
# A profile is whatever `save-profile <name>` created; laptop and desktop
# are the two ZepOS ships. `list-profiles` shows the ones that are on
# this machine - the examples here used to name gaming and home, which
# are on none.
# =========================================

# Settings, profiles and generated helpers belong to the user. A
# generated script runs standalone and cannot import paths.py, so the
# default is spelled out here; an unset variable would expand to nothing
# and turn every path below into one starting at the filesystem root.
ZEPOS_USER_ROOT="${ZEPOS_USER_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/zepos}"

PROFILE_DIR="$ZEPOS_USER_ROOT/profiles"
HYPR_DIR="$HOME/.config/hypr"
# Substituted while generating, not defaulted at run time: this script
# ends up far from the package and cannot work out where that package
# is. A hard-coded installation path would be a guess, and a wrong
# guess aborts here with nothing but "no such file or directory".
ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Get profile from argument
PROFILE="${1:-}"
FORCE_REGENERATE=false
AUTO_MODE=false

# Check for force flag in any position
for arg in "$@"; do
    if [ "$arg" = "-force" ] || [ "$arg" = "--force" ] || [ "$arg" = "-f" ]; then
        FORCE_REGENERATE=true
    fi
done

# If no profile specified, use auto-detect mode
if [ -z "$PROFILE" ]; then
    # Check if any profiles exist
    if ls -d "$PROFILE_DIR"/*/ &>/dev/null 2>&1; then
        echo -e "${YELLOW}{{ICON_WARNING}} No profile specified${NC}"
        echo ""
        echo "Usage: start-hyprland [profile] [--force]"
        echo ""
        echo "Available profiles:"
        for dir in "$PROFILE_DIR"/*/; do
            [ -d "$dir" ] && echo "  - $(basename "$dir")"
        done
        echo ""
        echo -e "${CYAN}Tip: Run without arguments for auto-detect mode (first-time setup)${NC}"
        echo -e "${CYAN}     Or specify a profile name above${NC}"
        echo ""
        read -p "Start with auto-detect mode? [Y/n]: " choice
        case "$choice" in
            n|N) exit 0 ;;
            *) AUTO_MODE=true ;;
        esac
    else
        # No profiles exist - auto mode is the only option
        AUTO_MODE=true
    fi
fi

# Check if profile exists (only if not in auto mode)
if [ "$AUTO_MODE" = false ] && [ ! -d "$PROFILE_DIR/$PROFILE" ]; then
    echo -e "${RED}{{ICON_ERROR}} Profile '$PROFILE' not found!${NC}"
    echo ""
    echo "Available profiles:"
    for dir in "$PROFILE_DIR"/*/; do
        [ -d "$dir" ] && echo "  - $(basename "$dir")"
    done
    echo ""
    echo -e "${CYAN}Tip: Run 'start-hyprland' without arguments for auto-detect mode${NC}"
    exit 1
fi

if [ "$FORCE_REGENERATE" = true ]; then
    echo -e "${YELLOW}{{ICON_WARNING}} Force regeneration requested${NC}"
fi

# =========================================
# AUTO-DETECT MODE (First-time setup)
# =========================================
if [ "$AUTO_MODE" = true ]; then
    echo -e "${CYAN}{{ICON_START}} Starting Hyprland in AUTO-DETECT mode...${NC}"
    echo ""
    echo -e "${YELLOW}{{ICON_WARNING}} This is first-time setup mode.${NC}"
    echo -e "${YELLOW}   Monitors will be auto-detected by Hyprland.${NC}"
    echo ""

    # Ensure hypr directory exists
    mkdir -p "$HYPR_DIR"

    # Create minimal auto-detect monitor config
    echo "{{ICON_SETTINGS}} Creating auto-detect monitor configuration..."
    cat > "$HYPR_DIR/monitors.conf" << 'MONITORS_EOF'
# Auto-detect monitors (first-time setup)
# After starting, arrange the screens in Systemeinstellungen >
# Bildschirme, then run 'save-profile <name>' to save the arrangement.
monitor=,preferred,auto,1
MONITORS_EOF

    # Create minimal workspace config
    cat > "$HYPR_DIR/workspaces.conf" << 'WORKSPACES_EOF'
# Auto-generated workspaces (first-time setup)
# Will be replaced when you save a profile
WORKSPACES_EOF

    # Create empty profile configs
    touch "$HYPR_DIR/profile-env.conf"
    touch "$HYPR_DIR/profile-autostart.conf"
    touch "$HYPR_DIR/profile-keybinds.conf"
    touch "$HYPR_DIR/profile-windowrules.conf"

    # Navigate to zepos directory
    cd "$ZEPOS_SYSTEM_ROOT" || exit 1

    # Generate universal Hyprland config
    echo "{{ICON_SETTINGS}} Generating Hyprland configuration..."
    ./generate_config.sh -hyprland-universal-config
    ./generate_config.sh -hyprland-plugins-config

    # Set status to auto mode
    "$HYPR_DIR/hyprland-status" set "auto" 2>/dev/null || true

    # Generate profile-specific configs
    echo "{{ICON_WRITE}} Generating default configs..."
    "$HYPR_DIR/hyprland-status" generate 2>/dev/null || true

    echo ""
    echo -e "${GREEN}{{ICON_CHECK}} Configuration ready${NC}"
    echo ""
    echo -e "${CYAN}+-------------------------------------------------------+${NC}"
    echo -e "${CYAN}|${NC} ${YELLOW}NEXT STEPS after Hyprland starts:${NC}                    ${CYAN}|${NC}"
    echo -e "${CYAN}|${NC}                                                       ${CYAN}|${NC}"
    echo -e "${CYAN}|${NC}  1. Open terminal: ${GREEN}SUPER + Q${NC}                        ${CYAN}|${NC}"
    echo -e "${CYAN}|${NC}  2. Open ${GREEN}Systemeinstellungen${NC} (SUPER+SPACE)         ${CYAN}|${NC}"
    echo -e "${CYAN}|${NC}  3. Page 'Bildschirme': arrange, then 'Anwenden'     ${CYAN}|${NC}"
    echo -e "${CYAN}|${NC}  4. Save profile: ${GREEN}save-profile <name>${NC}               ${CYAN}|${NC}"
    echo -e "${CYAN}|${NC}                                                       ${CYAN}|${NC}"
    echo -e "${CYAN}|${NC}  From then on, use: ${GREEN}start-hyprland <name>${NC}           ${CYAN}|${NC}"
    echo -e "${CYAN}+-------------------------------------------------------+${NC}"
    echo ""

    # Start Hyprland via official wrapper
    echo "{{ICON_START}} Launching Hyprland..."
    cd "$HOME" || cd / || exit 1
    exec /usr/bin/start-hyprland
fi

# =========================================
# PROFILE MODE (Normal operation)
# =========================================
echo "{{ICON_START}} Starting Hyprland with '$PROFILE' profile..."

# Check if profile needs to change
CURRENT_PROFILE=$("$HYPR_DIR/hyprland-status" get 2>/dev/null || echo "unknown")

# Always regenerate configs on startup to ensure everything is up to date
if [ "$CURRENT_PROFILE" != "$PROFILE" ]; then
    echo "{{ICON_DETECT}} Profile change: $CURRENT_PROFILE -> $PROFILE"
elif [ "$FORCE_REGENERATE" = true ]; then
    echo "{{ICON_REFRESH}} Force regeneration requested..."
else
    echo "{{ICON_REFRESH}} Regenerating configs for $PROFILE profile..."
fi

# Set the current profile
"$HYPR_DIR/hyprland-status" set "$PROFILE"

# Copy profile files to hypr directory
echo "{{ICON_COPY}} Copying profile configuration..."

cp "$PROFILE_DIR/$PROFILE/monitors.conf" "$HYPR_DIR/monitors.conf"
cp "$PROFILE_DIR/$PROFILE/workspaces.conf" "$HYPR_DIR/workspaces.conf"
cp "$PROFILE_DIR/$PROFILE/profile-env.conf" "$HYPR_DIR/profile-env.conf"
cp "$PROFILE_DIR/$PROFILE/profile-autostart.conf" "$HYPR_DIR/profile-autostart.conf"
cp "$PROFILE_DIR/$PROFILE/profile-keybinds.conf" "$HYPR_DIR/profile-keybinds.conf"
if [ -f "$PROFILE_DIR/$PROFILE/profile-windowrules.conf" ]; then
    cp "$PROFILE_DIR/$PROFILE/profile-windowrules.conf" "$HYPR_DIR/profile-windowrules.conf"
else
    touch "$HYPR_DIR/profile-windowrules.conf"
fi

# Kein Audio an dieser Stelle mehr.
#
# Hier wurden wireplumber.conf und easyeffectsrc aus dem Profil kopiert -
# aus profiles/gaming/, dem einzigen Profil, in das generate_config.sh
# sie geschrieben hat. Beide Dateien beschreiben inzwischen keine
# bestimmte Hardware mehr, sondern das, was in den Nutzereinstellungen
# unter audio.* steht, und davon gibt es eine Antwort pro RECHNER. Ein
# Profil hier ist eine Monitoranordnung: save-profile legt monitors.conf,
# workspaces.conf, profile-env.conf, profile-autostart.conf und
# profile-keybinds.conf ab und war noch nie fuer ein Tonausgabegeraet
# zustaendig.
#
# generate_config.sh schreibt beide Dateien jetzt direkt dorthin, wo
# WirePlumber und EasyEffects sie lesen. Damit gilt die Einstellung ab
# dem naechsten `zepos-generate --all` und in jedem Profil, statt in
# einem, das ZepOS gar nicht ausliefert.

# Navigate to zepos directory
cd "$ZEPOS_SYSTEM_ROOT" || exit 1

# Die Marke für fremde GTK4-Fenster — ~/.config/gtk-4.0/gtk.css
#
# Vor der Sitzung und nicht nur bei `--all`, aus demselben Grund wie das
# Abmeldelayout weiter unten: GTK 4 liest diese Datei EINMAL, beim Start
# jeder Anwendung. Eine Farbe, die der Nutzer geändert hat, erreicht die
# neun Anwendungen aus zepos-apps also erst mit der nächsten Anmeldung —
# und genau die ist hier.
echo "{{ICON_WRITE}} Generating GTK4 brand colours..."
./generate_config.sh -gtk4-colors-config
./generate_config.sh -gtk4-settings-config

# KColorScheme SSOT für Kirigami/Qt6-Apps (EasyEffects etc.) — kdeglobals + BreezeDark.colors
echo "{{ICON_WRITE}} Generating Qt6/Kirigami color-scheme configs..."
./generate_config.sh -kdeglobals-config
./generate_config.sh -breezedark-colors-config

# Generate universal Hyprland config
echo "{{ICON_SETTINGS}} Generating Hyprland configuration..."
./generate_config.sh -hyprland-universal-config

# Welche Plugins DIESE Sitzung laden kann, unmittelbar bevor sie startet.
#
# Hyprland liest die plugin=-Zeilen beim Parsen der Konfiguration, also
# bevor irgendetwas von ZepOS innerhalb der Sitzung laufen koennte.
# "Beim Sitzungsstart pruefen" kann deshalb nur heissen: hier, im
# Starter, ein exec vor dem Compositor. Ein `pacman -Syu`, das ein Plugin
# entfernt oder gegen ein anderes Hyprland-ABI austauscht, wirkt sich
# damit beim naechsten Login aus und nicht erst beim naechsten
# zepos-generate.
./generate_config.sh -hyprland-plugins-config

# Generate profile-specific configs (ags, zepos-logout, etc.)
echo "{{ICON_WRITE}} Generating profile-specific configs..."
"$HYPR_DIR/hyprland-status" generate

echo -e "${GREEN}{{ICON_CHECK}} Configuration ready${NC}"

# Das Arbeitsverzeichnis, das der Compositor erbt - und damit ALLES, was
# er startet.
#
# GEMELDET am 12.08.2026: "wir starten im terminal immer im zepos
# verzeichniss was falsch ist es muss im standard verzeichniss sein."
#
# GEMESSEN, und die Ursache steht dreissig Zeilen weiter oben in DIESER
# Datei: `cd "$ZEPOS_SYSTEM_ROOT"` wechselt hierher, damit die
# ./generate_config.sh-Aufrufe darunter ihr eigenes Verzeichnis finden,
# und danach wechselt niemand zurueck. Ein `exec` behaelt das
# Arbeitsverzeichnis, ein Kindprozess erbt es, und ein Terminal ist ein
# Kindprozess: Sitzung -> Starter -> Hyprland -> kitty -> zsh, vier
# Vererbungen weit, und am Ende steht ein Prompt im Projektverzeichnis
# dieses Systems statt im Heimatverzeichnis des Nutzers.
#
# Es ist NICHT nur das Terminal. Alles, was der Compositor startet,
# haengt an dieser einen Zeile - ein Dateidialog, der dort aufgeht, ein
# `firefox datei.html` aus einem Skript, ein Absturzbericht, der sein
# Kernabbild in ein Systemverzeichnis legt. Das Terminal ist bloss die
# Stelle, an der man es SIEHT.
#
# `cd /` als zweiter Versuch und dann erst der Abbruch: ein $HOME, in das
# nicht gewechselt werden kann (nicht eingehaengt, falsche Rechte), darf
# keine Anmeldung verhindern, die sonst funktioniert haette - aber der
# Compositor darf auch nicht mit dem Projektverzeichnis weiterlaufen,
# denn genau das ist der Fehler, der hier behoben wird.
cd "$HOME" || cd / || exit 1

# Start Hyprland via official wrapper (prevents "was not started" warning)
echo "{{ICON_START}} Launching Hyprland..."
exec /usr/bin/start-hyprland
