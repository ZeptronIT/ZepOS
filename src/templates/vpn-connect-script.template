#!/bin/bash
# =========================================
# VPN CONNECTION SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/vpn-connect-script.template
# =========================================
#
# This script runs in a terminal to show VPN connection progress
# =========================================

# Settings and generated helpers belong to the user. A generated script
# runs standalone and cannot import paths.py, so the default is spelled
# out here; an unset variable would expand to nothing and turn every
# path below into one starting at the filesystem root.
ZEPOS_USER_ROOT="${ZEPOS_USER_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/zepos}"
# Substituted while generating: this script ends up in
# ~/.config/ags/scripts and cannot work out where the package is.
ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"

# Which address the tunnel got is a question strongSwan answers, and
# vpn.py is where that answer is read out of `swanctl --list-sas` - once,
# for the six artifacts that used to derive it separately by matching
# interface addresses against one gateway's pool. See the module for the
# line it reads and why the pattern could never work.
vpn_query() {
    python3 "$ZEPOS_SYSTEM_ROOT/vpn.py" "$@"
}

# Every file this script creates carries or describes a credential: the
# swanctl configuration with the pre-shared key in it, the log with the
# username, the state file. They are private from the moment they are
# created, not from the moment a chmod runs afterwards - the file is
# world-readable in between, and that is exactly long enough for another
# account on the machine to read it. The same reasoning is written out
# at installer/core/netprofile.py:161 for the wireless passphrase.
umask 077

# Get parameters
USERNAME="$1"
PASSWORD="$2"
# $3 used to be a sudo password. It is deliberately NOT read: nothing in
# this script authenticates with a password any more. The privileged
# commands are granted by /etc/sudoers.d/zepos, so `sudo -n` runs them
# without one - which is also the only thing that works for the watcher,
# which has no terminal to ask at. Neither caller collects one any more
# and both pass the slot empty (vpn-control-config.template, and
# ags-vpn.template, which stopped showing the field once it was clear
# that /proc/<pid>/cmdline is world-readable). The slot itself stays so
# that the six arguments behind it keep their positions.
TOKEN="$4"
PSK="$5"
VPN_CONNECTION="$6"
LOG_FILE="$7"

# A private directory on the per-user tmpfs for everything intermediate.
# The origin put the swanctl configuration - pre-shared key included - in
# /tmp under a name made from its own process id, at mode 0644. A pid is
# not a secret and /tmp is readable by every account on the machine.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/zepos-vpn"
mkdir -p "$RUNTIME_DIR"

# Anything left behind is a secret left behind, whichever way the script
# ends - including the Ctrl-C in the terminal it runs in.
cleanup_runtime() {
    rm -f "$RUNTIME_DIR/work.conf" "$RUNTIME_DIR/resolv.conf"
}
trap cleanup_runtime EXIT INT TERM

# Setup logging
LOG_DIR="$HOME/.local/share/vpn-logs"
mkdir -p "$LOG_DIR"
DETAILED_LOG="$LOG_DIR/vpn-$(date '+%Y%m%d-%H%M%S').log"

# Logging function - writes to console and file
log() {
    local level="$1"
    shift
    local msg="$*"
    local timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    local color=""
    local reset="\033[0m"

    case "$level" in
        INFO)  color="\033[0;32m" ;;  # Green
        WARN)  color="\033[0;33m" ;;  # Yellow
        ERROR) color="\033[0;31m" ;;  # Red
        DEBUG) color="\033[0;36m" ;;  # Cyan
        *)     color="" ;;
    esac

    # Console output with color
    echo -e "${color}[$timestamp] [$level] $msg${reset}"
    # File output without color
    echo "[$timestamp] [$level] $msg" >> "$DETAILED_LOG"
}

# Into the log file only, never onto the console.
#
# In silent mode the AGS widget redirects this script's standard output
# into /tmp/vpn-control-<date>.log.detail, where every account on the
# machine can read it. The log file below is under $HOME and 0600.
log_private() {
    local level="$1"
    shift
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $*" >> "$DETAILED_LOG"
}

# Log section header
log_section() {
    echo "" | tee -a "$DETAILED_LOG"
    echo "=========================================" | tee -a "$DETAILED_LOG"
    echo "  $1" | tee -a "$DETAILED_LOG"
    echo "=========================================" | tee -a "$DETAILED_LOG"
}

# Start logging
log_section "VPN CONNECTION - $(date)"
log INFO "Log-Datei: $DETAILED_LOG"
log INFO "Server: {{STYLE_VPN_SERVER}}"
log INFO "IKE Version: {{STYLE_VPN_VERSION}}"
log_private INFO "Username: $USERNAME"
log INFO "Connection: $VPN_CONNECTION"
echo ""

log_section "PARAMETER VALIDIERUNG"
# Laengen statt Werte. Der Ursprung schrieb den Token hier und an zwei
# weiteren Stellen im Klartext heraus und legte zusaetzlich Passwort und
# Token als Hexdump im Log ab. Ein Einmal-Token in einer Logdatei ist
# entweder abgelaufen und nutzlos oder gueltig und gefaehrlich.
log DEBUG "Parameter empfangen: $#"
log DEBUG "USERNAME: [HIDDEN] (Länge: ${#USERNAME})"
log DEBUG "PASSWORD: [HIDDEN] (Länge: ${#PASSWORD})"
log DEBUG "TOKEN: [HIDDEN] (Länge: ${#TOKEN})"
log DEBUG "PSK: [HIDDEN] (Länge: ${#PSK})"
log DEBUG "VPN_CONNECTION: '$VPN_CONNECTION'"
echo ""

log_section "VPN KONFIGURATION PRUEFEN"

# The routed networks, and one child security association per network,
# are generated from vpn.routed_networks at generation time. The origin
# spelled three of them out here instead, so a fourth network could not
# be expressed at all - and an installation belonging to somebody else
# inherited that employer's three.
CHILDREN_CONF="{{STYLE_VPN_CHILDREN}}"
ROUTED_NETWORKS="{{STYLE_VPN_ROUTED_NETWORKS}}"
BYPASS_NETWORKS="{{STYLE_VPN_BYPASS_NETWORKS}}"
VPN_SERVER="{{STYLE_VPN_SERVER}}"
VPN_DNS_SERVERS="{{STYLE_VPN_DNS_SERVERS}}"
VPN_SEARCH_DOMAIN="{{STYLE_VPN_SEARCH_DOMAIN}}"
VPN_TEST_HOST="{{STYLE_VPN_TEST_HOST}}"

# Checked before anything is asked for or changed. An unconfigured VPN
# has to produce nothing, not something: guessing a server would aim a
# fresh installation at a stranger's network, and a tunnel with no routed
# network establishes, reports "connected" and carries no traffic at all.
if [ -z "$VPN_SERVER" ]; then
    log ERROR "Kein VPN-Server konfiguriert."
    log ERROR "Bitte vpn.server in $ZEPOS_USER_ROOT/user-settings.json setzen"
    log ERROR "(oder im VPN-Einstellungsfenster) und die Konfiguration neu erzeugen."
    if [ -t 0 ]; then
        echo ""
        echo "Press any key to exit"
        read -n 1
    fi
    exit 1
fi

if [ -z "$CHILDREN_CONF" ]; then
    log ERROR "Kein geroutetes Netz konfiguriert."
    log ERROR "Ein Tunnel ohne geroutetes Netz baut sich auf und traegt keinen Verkehr:"
    log ERROR "die Verbindung meldet Erfolg, erreichbar ist nichts."
    log ERROR "Bitte vpn.routed_networks in $ZEPOS_USER_ROOT/user-settings.json setzen"
    log ERROR "(oder im VPN-Einstellungsfenster) und die Konfiguration neu erzeugen."
    if [ -t 0 ]; then
        echo ""
        echo "Press any key to exit"
        read -n 1
    fi
    exit 1
fi

log INFO "Geroutete Netze: $ROUTED_NETWORKS"
echo ""

log_section "RECHTE PRUEFEN"

# Wie dieses Skript an Root-Rechte kommt - und woran es sie NICHT mehr
# bekommt.
#
# Der Ursprung liess sich das Login-Passwort uebergeben, pruefte es mit
# `sudo -S -v` und legte es anschliessend unter
# $XDG_RUNTIME_DIR/vpn-sudo-cache ab, damit Watcher und Trennung spaeter
# unbeaufsichtigt `sudo -S` damit fuettern konnten. Ein Login-Passwort
# auf der Platte ist der Preis fuer diese Bequemlichkeit, und er ist zu
# hoch: wer die Datei liest, hat das ganze Konto und nicht nur diese paar
# Netzbefehle.
#
# Stattdessen steht in /etc/sudoers.d/zepos, welche Befehle ohne
# Passwort laufen duerfen. `sudo -n` fuehrt genau die aus - im Terminal
# wie im Hintergrunddienst, der niemanden fragen kann.
SUDOERS_HINT="Rechte-Regel installieren: ${XDG_CONFIG_HOME:-$HOME/.config}/ags/scripts/vpn-control.sh install-privileges"

# Ein Rest aus einer aelteren Fassung. Er wird hier entfernt und nicht
# nur ignoriert: sonst laege das Passwort bis zum naechsten Abmelden
# weiter da, ohne dass es noch irgendetwas liest.
rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vpn-sudo-cache"

if sudo -n true 2>/dev/null; then
    PRIVILEGE_MODE="rule"
    log INFO "Rechte-Regel aktiv - kein Passwort noetig ✓"
elif [ -t 0 ]; then
    PRIVILEGE_MODE="ask"
    log WARN "Keine Rechte-Regel gefunden - sudo fragt gleich nach dem Passwort."
    log WARN "$SUDOERS_HINT"
elif command -v pkexec >/dev/null 2>&1; then
    PRIVILEGE_MODE="pkexec"
    log WARN "Keine Rechte-Regel gefunden - jeder Schritt fragt einzeln nach."
    log WARN "$SUDOERS_HINT"
else
    log ERROR "Keine Moeglichkeit, Root-Rechte zu erhalten."
    log ERROR "$SUDOERS_HINT"
    exit 1
fi

# Every privileged command in this script goes through here, and every
# one of them is listed in the drop-in. Nothing pipes a password in:
# `sudo -S` does not appear in this file at all.
run_sudo() {
    case "$PRIVILEGE_MODE" in
        rule) sudo -n "$@" ;;
        ask)  sudo "$@" ;;
        *)    pkexec "$@" ;;
    esac
}

# State file path — written on successful connect, removed on disconnect.
# Used by status checkers (AGS VpnManager, vpn-status.py) to detect a *real*
# tunnel (CHILD_SAs installed) rather than just "charon running + virtual IP".
VPN_STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/vpn-active"
# Remove any stale state from a previous failed run before we begin.
rm -f "$VPN_STATE_FILE"
echo ""

# Der Ursprung raeumte hier ein altes EAP-Secret aus /etc/ipsec.secrets
# weg. Diese Datei gehoert zum abgeloesten starter/ipsec-Weg; die
# Konfiguration, die dieses Skript schreibt, liegt vollstaendig unter
# /etc/swanctl, und charon liest ipsec.secrets dabei nie. Der Schritt
# raeumte also nichts auf, was jemanden stoert - haette aber `sed -i` in
# der Rechte-Regel verlangt, und sed schreibt ueber seinen `w`-Befehl
# jede Datei des Systems. Root mit Umweg, fuer einen Aufraeumschritt ohne
# Wirkung.

log_section "VPN KONFIGURATION ERSTELLEN"

# Create swanctl config
log INFO "Erstelle VPN-Konfiguration..."

# Create config file separately to avoid heredoc issues
FULL_SECRET="${PASSWORD}${TOKEN}"

# Check if XAuth is enabled
USER_SETTINGS_FILE="$ZEPOS_USER_ROOT/user-settings.json"
XAUTH_ENABLED="false"
if [ -f "$USER_SETTINGS_FILE" ] && command -v jq &> /dev/null; then
    XAUTH_ENABLED=$(jq -r '.vpn.xauth_enabled // false' "$USER_SETTINGS_FILE" 2>/dev/null)
fi
log DEBUG "XAuth enabled: $XAUTH_ENABLED"

# CHILDREN_CONF and ROUTED_NETWORKS were built and checked at the top of
# this script, from vpn.routed_networks. Reading the same list again here
# through jq - as the origin did - meant the connect script and the
# generated configuration could disagree about which networks the tunnel
# covers, and only the second of the two was ever shown to the user.

# Build aggressive line only for IKEv1
AGGRESSIVE_LINE=""
if [ "{{STYLE_VPN_VERSION}}" = "1" ]; then
    AGGRESSIVE_LINE="        aggressive = {{STYLE_VPN_AGGRESSIVE}}"
fi

# Build local auth and secrets blocks based on XAuth setting
if [ "$XAUTH_ENABLED" = "true" ]; then
    LOCAL_AUTH="        local-1 {
            auth = psk
            id = ${USERNAME}
        }
        local-2 {
            auth = xauth
            xauth_id = ${USERNAME}
            id = ${USERNAME}
        }"
    XAUTH_SECRET="
    xauth-work {
        id = ${USERNAME}
        secret = \"${FULL_SECRET}\"
    }"
else
    LOCAL_AUTH="        local {
            auth = psk
            id = ${USERNAME}
        }"
    XAUTH_SECRET=""
fi

# Bind the IKE source to the default-route interface, NOT to %any.
# With %any strongSwan takes the first address it finds. On a host that also
# runs a point-to-point tunnel — WireGuard is the common case — that is the
# tunnel's own /32: the IKE replies then come back through that tunnel, never
# reach strongSwan, and the connection dies in IKE_SA_INIT timeouts. Pinning
# to the interface the default route uses lets the two tunnels coexist.
DEFAULT_IFACE=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
if [[ -z "$DEFAULT_IFACE" ]]; then
    log WARN "No default route found; falling back to local_addrs = %any (may conflict with WireGuard)"
    LOCAL_ADDRS_LINE="        # local_addrs = %any (default, no default route detected)"
else
    log DEBUG "Pinning IKE source to default-route interface: ${DEFAULT_IFACE}"
    LOCAL_ADDRS_LINE="        local_addrs = ${DEFAULT_IFACE}"
fi

# Die fertige Konfiguration traegt den Pre-Shared Key. Sie entsteht unter
# $XDG_RUNTIME_DIR - ein tmpfs, das nur dem Benutzer gehoert und das der
# Sitzungsdienst beim Abmelden leert - und dank `umask 077` ganz oben mit
# Modus 0600 vom ersten Byte an. Der Ursprung schrieb sie nach
# /tmp/work.conf.$$ und liess sie dort mit 0644 mehrere sudo-Aufrufe lang
# liegen.
WORK_CONF="$RUNTIME_DIR/work.conf"

cat > "$WORK_CONF" << EOF
connections {
    ${VPN_CONNECTION} {
        version = {{STYLE_VPN_VERSION}}
${LOCAL_ADDRS_LINE}
${AGGRESSIVE_LINE}
        proposals = {{STYLE_VPN_IKE_PROPOSALS}}
        dpd_delay = {{STYLE_VPN_DPD_DELAY}}s
        dpd_timeout = {{STYLE_VPN_DPD_TIMEOUT}}s
        encap = {{STYLE_VPN_ENCAP}}
        mobike = {{STYLE_VPN_MOBIKE}}
        rekey_time = {{STYLE_VPN_KEYLIFE}}s
${LOCAL_AUTH}
        remote {
            auth = psk
            id = {{STYLE_VPN_SERVER}}
        }
        remote_addrs = {{STYLE_VPN_SERVER}}
        vips = 0.0.0.0
        children {${CHILDREN_CONF}
        }
    }
}

secrets {
    ike-work {
        id = {{STYLE_VPN_SERVER}}
        secret = "${PSK}"
    }${XAUTH_SECRET}
}
EOF

log_section "XAUTH SECRET"
# Nur die Laenge. Der Ursprung schrieb den Token hier zweimal im Klartext
# heraus und legte anschliessend Passwort und Token als Hexdump ins Log -
# ein Hexdump umgeht jede Suche nach dem Wert selbst, das Geheimnis steht
# trotzdem da.
log DEBUG "XAuth secret Länge: $((${#PASSWORD} + ${#TOKEN}))"

log_section "KONFIGURATION INSTALLIEREN"
log INFO "Schreibe Konfiguration nach /etc/swanctl/conf.d/work.conf..."
run_sudo mkdir -p /etc/swanctl/conf.d

# Zwei Schritte, damit die Zieldatei den Schluessel nie unter einem
# offenen Modus traegt: `install` legt sie LEER mit 0600 an, `tee`
# schreibt danach hinein, ohne den Modus zu aendern. Ein einzelnes `tee`
# haette sie unter roots umask mit 0644 erzeugt - und /etc/swanctl ist
# fuer alle betretbar.
#
# Beide Befehle stehen mit ausgeschriebenem Ziel in der Rechte-Regel. Ein
# `cp <quelle> <ziel>` mit Platzhalter, wie der Ursprung es brauchte,
# haette dort den Zielpfad dem Aufrufer ueberlassen.
if run_sudo install -m 0600 -o root -g root /dev/null /etc/swanctl/conf.d/work.conf &&
   run_sudo tee /etc/swanctl/conf.d/work.conf < "$WORK_CONF" > /dev/null; then
    log INFO "Konfiguration installiert ✓"
else
    log ERROR "Konfiguration konnte nicht geschrieben werden!"
    log ERROR "$SUDOERS_HINT"
fi

rm -f "$WORK_CONF"
log DEBUG "Temporäre Konfiguration bereinigt"

log_section "STRONGSWAN SERVICE"
log INFO "Starte StrongSwan Service neu..."
if run_sudo systemctl restart strongswan; then
    log INFO "StrongSwan Service neugestartet ✓"
else
    log ERROR "StrongSwan Service Neustart fehlgeschlagen!"
fi
sleep 2

# Check service status
SERVICE_STATUS=$(run_sudo systemctl is-active strongswan 2>/dev/null)
log DEBUG "StrongSwan Service Status: $SERVICE_STATUS"

log_section "VPN KONFIGURATION LADEN"
log INFO "Lade VPN Konfiguration..."
LOAD_OUTPUT=$(run_sudo swanctl --load-all 2>&1)
echo "$LOAD_OUTPUT" >> "$DETAILED_LOG"
if echo "$LOAD_OUTPUT" | grep -q "successfully"; then
    log INFO "Konfiguration geladen ✓"
else
    log WARN "Konfiguration möglicherweise nicht vollständig geladen"
    log DEBUG "$LOAD_OUTPUT"
fi

log_section "VPN VERBINDUNG INITIIEREN"
log INFO "Initiiere VPN-Verbindungen (Child SAs)..."
log INFO "Timeout: 30 Sekunden pro Child SA"

# Function to initiate with timeout and logging
initiate_child_sa() {
    local SA_NAME="$1"
    log INFO "Initiiere ${SA_NAME}..."

    # swanctl bringt seine eigene Zeitgrenze mit. Der Ursprung wickelte
    # stattdessen `timeout 30 sudo ...` darum - was hiesse, `timeout` in
    # der Rechte-Regel freizugeben, und damit jeden Befehl, den man ihm
    # mitgibt.
    INIT_OUTPUT=$(run_sudo swanctl --initiate --child "${SA_NAME}" --timeout 30 2>&1)
    INIT_EXIT=$?

    echo "=== ${SA_NAME} ===" >> "$DETAILED_LOG"
    echo "Exit code: $INIT_EXIT" >> "$DETAILED_LOG"
    echo "Output: $INIT_OUTPUT" >> "$DETAILED_LOG"

    if echo "$INIT_OUTPUT" | grep -qi "timed out\|timeout"; then
        log ERROR "  ${SA_NAME}: TIMEOUT nach 30 Sekunden!"
        log ERROR "  Server antwortet nicht oder Proposals inkompatibel"
        return 1
    elif [ $INIT_EXIT -ne 0 ]; then
        log ERROR "  ${SA_NAME}: FEHLER (Exit code: $INIT_EXIT)"
        log ERROR "  $INIT_OUTPUT"
        return 1
    elif echo "$INIT_OUTPUT" | grep -qi "successfully\|established"; then
        log INFO "  ${SA_NAME}: Erfolgreich ✓"
        return 0
    else
        log WARN "  ${SA_NAME}: Unbekannter Status"
        log WARN "  $INIT_OUTPUT"
        return 1
    fi
}

# The same names the children block above was built from, generated once
# and substituted into every script that needs them. The origin derived
# them here a second time, live from the settings file, so a settings
# change between generating the configuration and starting the connection
# produced "child 'x' not found" - naming a child the user never
# configured, from a file they had just edited.
CHILD_SA_NAMES="{{STYLE_VPN_CHILD_NAMES}}"

# Try each child SA
FIRST_FAILED=false
for SA_NAME in $CHILD_SA_NAMES; do
    if ! initiate_child_sa "${SA_NAME}"; then
        FIRST_FAILED=true
        break
    fi
done

if [ "$FIRST_FAILED" = true ]; then
    log_section "FEHLERDIAGNOSE"
    log ERROR "Child SA fehlgeschlagen - prüfe Ursache..."

    # Check if IKE SA was established
    log INFO "Prüfe IKE SA Status..."
    IKE_STATUS=$(run_sudo swanctl --list-sas 2>&1)
    echo "$IKE_STATUS" >> "$DETAILED_LOG"

    if echo "$IKE_STATUS" | grep -q "ESTABLISHED"; then
        log INFO "IKE SA ist ESTABLISHED - Problem liegt bei Child SA"
    else
        log ERROR "IKE SA NICHT established - Problem bei Phase 1"
        log ERROR "Mögliche Ursachen:"
        log ERROR "  - Falscher PSK"
        log ERROR "  - Server unterstützt Proposals nicht"
        log ERROR "  - Netzwerk-Problem (Firewall, NAT)"
    fi

    # Show charon/strongswan logs
    log INFO "StrongSwan Logs (letzte 30 Zeilen):"
    if [ -f /var/log/charon.log ]; then
        run_sudo tail -30 /var/log/charon.log 2>&1 | tee -a "$DETAILED_LOG"
    else
        # Eine feste Form, nicht zwei: die Rechte-Regel nennt genau diesen
        # Aufruf. `strongswan-starter` gehoert ausserdem zum abgeloesten
        # starter-Weg, den diese Konfiguration nicht mehr benutzt.
        run_sudo journalctl -u strongswan --no-pager -n 30 2>&1 | tee -a "$DETAILED_LOG" || \
        log WARN "Keine StrongSwan Logs gefunden"
    fi

    # Show current config for debugging
    log INFO "Aktuelle swanctl Konfiguration:"
    run_sudo swanctl --list-conns 2>&1 | tee -a "$DETAILED_LOG"
fi

log_section "VERBINDUNGSSTATUS"
log INFO "Prüfe Verbindungsstatus..."
SAS_OUTPUT=$(run_sudo swanctl --list-sas 2>&1)
echo "$SAS_OUTPUT" >> "$DETAILED_LOG"
echo "$SAS_OUTPUT"

log_section "NETZWERK KONFIGURATION"

# Die virtuelle Adresse kommt aus dem Bericht, den strongSwan gerade
# geliefert hat - nicht aus einem Muster ueber `ip addr show`.
#
# Der Ursprung suchte hier nach einer Adresse aus dem Pool eines
# bestimmten Gateways. Wer eine andere bekam, fand nichts, und
# dieser ganze Abschnitt - Routen, lokaler Schutz, Bypass, DNS, Diagnose -
# wurde uebersprungen: der Tunnel stand, trug aber keinen Verkehr, und
# keine Zeile sagte warum.
#
# Drei Ausgaenge, weil es drei Zustaende gibt:
#   0  eine Adresse wurde zugewiesen
#   1  ueberhaupt keine IKE_SA - es gibt keinen Tunnel
#   2  Tunnel steht, das Gateway hat keine Adresse vergeben. Das ist eine
#      gueltige Verbindung; sie wird eingerichtet wie jede andere, nur
#      ohne `src`-Hinweis auf den Routen.
VPN_IP=$(printf '%s\n' "$SAS_OUTPUT" | vpn_query --virtual-address)
VPN_IP_STATUS=$?

# Ohne Adresse KEIN `src`-Argument, statt eines leeren: `ip route add ...
# src` ohne Wert ist ein Syntaxfehler, und die Route entstuende nicht.
VPN_SRC=""
[ -n "$VPN_IP" ] && VPN_SRC="src $VPN_IP"

if [ "$VPN_IP_STATUS" -ne 1 ]; then
    if [ -n "$VPN_IP" ]; then
        log INFO "VPN IP zugewiesen: $VPN_IP"
    else
        log INFO "Das Gateway hat keine virtuelle Adresse vergeben - der"
        log INFO "Tunnel benutzt die lokale Adresse. Routen werden ohne"
        log INFO "src-Hinweis gesetzt."
    fi

    # Fix routing tables for policy-based IPsec
    log INFO "Konfiguriere VPN-Routen..."

    # Detect active network interface dynamically
    ACTIVE_IFACE=$(ip route get 1.1.1.1 | grep -oP 'dev \K\S+')
    log INFO "Aktives Netzwerk-Interface: $ACTIVE_IFACE"

    # Add routes to main table (if not exists).
    # Same list as the child security associations. The origin wrote its
    # three networks out here a second and a third time, so a fourth one
    # would have been tunnelled but never routed - the tunnel comes up,
    # part of the traffic goes nowhere, and nothing says why.
    log DEBUG "Füge Routen zur Haupttabelle hinzu..."
    for NET in $ROUTED_NETWORKS; do
        run_sudo ip route add "$NET" dev $ACTIVE_IFACE $VPN_SRC 2>/dev/null && \
            log DEBUG "  $NET hinzugefügt" || \
            log DEBUG "  $NET existiert bereits"
    done

    # Fix table 220 (remove gateway routes, add direct routes)
    log DEBUG "Konfiguriere Routing-Tabelle 220..."
    for NET in $ROUTED_NETWORKS; do
        run_sudo ip route del "$NET" table 220 2>/dev/null || true
        run_sudo ip route add "$NET" dev $ACTIVE_IFACE $VPN_SRC table 220 2>&1 | tee -a "$DETAILED_LOG"
    done

    # Flush route cache to apply changes
    run_sudo ip route flush cache

    log INFO "Routen konfiguriert ✓"

    log_section "LOKALES NETZWERK SCHUTZ"

    # Detect local network dynamically (works for any user/network)
    LOCAL_NET=$(ip route | grep "proto kernel" | grep -v "linkdown" | grep "$ACTIVE_IFACE" | awk '{print $1}' | head -1)
    LOCAL_GW=$(ip route | grep "^default" | awk '{print $3}' | head -1)

    if [ -n "$LOCAL_NET" ]; then
        log INFO "Lokales Netzwerk erkannt: $LOCAL_NET (Gateway: $LOCAL_GW)"
        log INFO "Installiere xfrm Passthrough-Policies..."

        # Add passthrough policies with higher priority than StrongSwan's (priority 100 vs ~375423)
        # This ensures local network traffic bypasses the IPsec tunnel
        run_sudo ip xfrm policy add dir out src 0.0.0.0/0 dst $LOCAL_NET priority 100 2>/dev/null && \
            log INFO "  Outbound passthrough fuer $LOCAL_NET ✓" || \
            log WARN "  Outbound passthrough existiert bereits"
        run_sudo ip xfrm policy add dir in src $LOCAL_NET dst 0.0.0.0/0 priority 100 2>/dev/null && \
            log INFO "  Inbound passthrough fuer $LOCAL_NET ✓" || \
            log WARN "  Inbound passthrough existiert bereits"
        run_sudo ip xfrm policy add dir fwd src $LOCAL_NET dst 0.0.0.0/0 priority 100 2>/dev/null && \
            log INFO "  Forward passthrough fuer $LOCAL_NET ✓" || \
            log WARN "  Forward passthrough existiert bereits"

        # Ensure default gateway route is intact
        if [ -n "$LOCAL_GW" ]; then
            run_sudo ip route replace default via $LOCAL_GW dev $ACTIVE_IFACE metric 50 2>/dev/null || true
            log DEBUG "Default Gateway Route gesichert: $LOCAL_GW via $ACTIVE_IFACE"
        fi

        log INFO "Lokales Netzwerk geschuetzt ✓"
    else
        log WARN "Lokales Netzwerk konnte nicht erkannt werden!"
        log WARN "Internet-Konnektivitaet koennte beeintraechtigt sein"
    fi

    # Route the configured bypass networks PAST the IPsec tunnel.
    #
    # A routed network can legitimately contain a subnet that has to stay
    # outside the tunnel - a parallel WireGuard link to a home LAN inside
    # 192.168.0.0/16, for instance. Without a higher-priority passthrough
    # policy IPsec captures that traffic and the other tunnel goes dark.
    #
    # The origin had exactly one such subnet and its own router's German
    # interface name written in here, so the feature existed for one
    # person's home network and for nobody else's. The list comes from
    # vpn.bypass_networks now, and a route on ANY device counts: pinning
    # it to one interface name meant renaming the connection silently
    # switched the protection off.
    for BYPASS_NET in $BYPASS_NETWORKS; do
        if ! ip route show 2>/dev/null | grep -qF "$BYPASS_NET"; then
            log DEBUG "Bypass-Netz $BYPASS_NET nicht aktiv - uebersprungen"
            continue
        fi
        log INFO "Bypass-Netz erkannt ($BYPASS_NET) - installiere Passthrough..."
        run_sudo ip xfrm policy add dir out src 0.0.0.0/0 dst "$BYPASS_NET" priority 100 2>/dev/null && \
            log INFO "  Outbound passthrough fuer $BYPASS_NET ✓" || \
            log WARN "  Outbound passthrough existiert bereits"
        run_sudo ip xfrm policy add dir in src "$BYPASS_NET" dst 0.0.0.0/0 priority 100 2>/dev/null && \
            log INFO "  Inbound passthrough fuer $BYPASS_NET ✓" || \
            log WARN "  Inbound passthrough existiert bereits"
        run_sudo ip xfrm policy add dir fwd src "$BYPASS_NET" dst 0.0.0.0/0 priority 100 2>/dev/null && \
            log INFO "  Forward passthrough fuer $BYPASS_NET ✓" || \
            log WARN "  Forward passthrough existiert bereits"
        log INFO "Bypass-Netz $BYPASS_NET geschuetzt ✓"
    done

    log_section "DNS KONFIGURATION"
    log INFO "Konfiguriere DNS Server..."

    # Backup original resolv.conf if not already backed up
    if [ ! -f /etc/resolv.conf.vpn-backup ]; then
        run_sudo cp /etc/resolv.conf /etc/resolv.conf.vpn-backup
        log DEBUG "resolv.conf Backup erstellt"
    fi

    # Any number of internal resolvers, in the order they are configured.
    # The origin had exactly two and gave each one its own placeholder, so
    # a third could not be expressed and a single one left the second
    # `nameserver` line empty.
    VPN_DNS_PRIMARY="${VPN_DNS_SERVERS%% *}"

    # Test if the internal DNS is reachable through the tunnel (DNS query, not ping)
    INTERNAL_DNS_OK=false
    if [ -n "$VPN_DNS_PRIMARY" ]; then
        if timeout 2 nslookup google.com "$VPN_DNS_PRIMARY" >/dev/null 2>&1; then
            INTERNAL_DNS_OK=true
            log INFO "Interner DNS $VPN_DNS_PRIMARY erreichbar ✓"
        else
            log WARN "Interner DNS $VPN_DNS_PRIMARY NICHT erreichbar!"
        fi
    else
        log INFO "Kein interner DNS konfiguriert - behalte lokalen DNS"
    fi

    # Die neue resolv.conf entsteht vollstaendig hier, als gewoehnliche
    # Datei des Benutzers, und wird anschliessend in einem Stueck
    # hineingeschrieben.
    #
    # Der Ursprung baute sie mit `sudo sed -i` und `sudo bash -c "echo
    # >> ..."` an Ort und Stelle um. Beides muesste in der Rechte-Regel
    # stehen, und beides ist dort Root ohne Umweg: `bash -c` sowieso, sed
    # ueber seinen `w`-Befehl, mit dem es jede Datei des Systems schreibt.
    # `tee` mit ausgeschriebenem Ziel kann genau eine Datei fuellen, und
    # der Inhalt kommt von der Standardeingabe - mehr Rechte braucht es
    # nicht.
    RESOLV_NEW="$RUNTIME_DIR/resolv.conf"
    RESOLV_CHANGED=false
    SEARCH_MERGED=false

    {
        if [ "$INTERNAL_DNS_OK" = true ]; then
            # Internal DNS reachable: put it BEFORE the local one, so names
            # that only exist below the search domain resolve at all.
            for DNS_SERVER in $VPN_DNS_SERVERS; do
                printf 'nameserver %s\n' "$DNS_SERVER"
            done
        fi
        # Die bestehenden Zeilen bleiben erhalten. Fehlt die Datei - auf
        # einer Maschine ohne Resolver-Konfiguration -, entsteht eine
        # neue nur aus dem, was der Tunnel beisteuert, statt dass die
        # Schleife die ganze Gruppe mit einem Lesefehler abbricht.
        if [ -r /etc/resolv.conf ]; then
            while IFS= read -r RESOLV_LINE || [ -n "$RESOLV_LINE" ]; do
                case "$RESOLV_LINE" in
                    search\ *)
                        if [ -n "$VPN_SEARCH_DOMAIN" ]; then
                            printf '%s %s\n' "$RESOLV_LINE" "$VPN_SEARCH_DOMAIN"
                            SEARCH_MERGED=true
                        else
                            printf '%s\n' "$RESOLV_LINE"
                        fi
                        ;;
                    *)
                        printf '%s\n' "$RESOLV_LINE"
                        ;;
                esac
            done < /etc/resolv.conf
        fi
        if [ -n "$VPN_SEARCH_DOMAIN" ] && [ "$SEARCH_MERGED" != true ]; then
            printf 'search %s\n' "$VPN_SEARCH_DOMAIN"
        fi
    } > "$RESOLV_NEW"

    if [ "$INTERNAL_DNS_OK" = true ]; then
        RESOLV_CHANGED=true
        log INFO "DNS konfiguriert: $VPN_DNS_SERVERS (primaer) + lokal ✓"
    elif [ -n "$VPN_DNS_PRIMARY" ]; then
        # Internal DNS not reachable: keep the local one as primary.
        log WARN "Interner DNS nicht erreichbar - behalte lokalen DNS als primaer"
        log WARN "Interne Hostnamen werden nicht aufloesbar sein"
    fi

    if [ -n "$VPN_SEARCH_DOMAIN" ]; then
        RESOLV_CHANGED=true
        log INFO "Search Domain konfiguriert: $VPN_SEARCH_DOMAIN ✓"
    fi

    if [ "$RESOLV_CHANGED" = true ]; then
        run_sudo tee /etc/resolv.conf < "$RESOLV_NEW" > /dev/null || \
            log ERROR "DNS-Konfiguration konnte nicht geschrieben werden - $SUDOERS_HINT"
    fi
    rm -f "$RESOLV_NEW"

    log_section "IPSEC DIAGNOSE"

    # Check IPsec policies (traffic selectors)
    log DEBUG "IPsec Traffic Selectors:"
    POLICY_OUTPUT=$(run_sudo ip xfrm policy 2>&1)
    echo "$POLICY_OUTPUT" >> "$DETAILED_LOG"
    if [ -n "$VPN_IP" ]; then
        echo "$POLICY_OUTPUT" | grep -A2 "src $VPN_IP" || log DEBUG "  Keine Policies gefunden"
    else
        echo "$POLICY_OUTPUT" | head -20
    fi

    log DEBUG "IPsec States:"
    STATE_OUTPUT=$(run_sudo ip xfrm state 2>&1)
    echo "$STATE_OUTPUT" >> "$DETAILED_LOG"
    echo "$STATE_OUTPUT" | head -20

    # The routes for the configured networks, not for a fixed set of
    # ranges. The origin matched RFC1918 as a whole here, which listed
    # every route on the machine that happened to be private - including
    # the local LAN the tunnel is explicitly kept away from.
    log DEBUG "Aktuelle Routen (VPN-Netze):"
    ROUTES_FOUND=false
    for NET in $ROUTED_NETWORKS; do
        NET_ROUTES=$(ip route show | grep -F "$NET")
        if [ -n "$NET_ROUTES" ]; then
            ROUTES_FOUND=true
            echo "$NET_ROUTES" | while read -r line; do log DEBUG "  $line"; done
        fi
    done
    if [ "$ROUTES_FOUND" = false ]; then
        log DEBUG "  Keine VPN-Routen gefunden"
    fi

    log_section "KONNEKTIVITÄTSTEST"
    log INFO "Teste Konnektivitaet (1s Timeout pro Test)..."

    # Test own VPN IP
    if [ -n "$VPN_IP" ]; then
        if ping -c 1 -W 1 $VPN_IP >/dev/null 2>&1; then
            log INFO "  ✓ VPN IP $VPN_IP erreichbar"
        else
            log WARN "  ✗ VPN IP $VPN_IP nicht erreichbar"
        fi
    fi

    # Test internet (by IP, no DNS needed)
    if ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1; then
        log INFO "  ✓ Internet erreichbar (1.1.1.1)"
    else
        log WARN "  ✗ Internet NICHT erreichbar!"
    fi

    # Test DNS resolution (short timeout)
    if timeout 2 host google.com >/dev/null 2>&1; then
        log INFO "  ✓ DNS-Aufloesung funktioniert (google.com)"
    else
        log WARN "  ✗ DNS-Aufloesung fehlgeschlagen"
    fi

    # Test the internal DNS again, now that resolv.conf has been rewritten
    if [ "$INTERNAL_DNS_OK" = true ]; then
        if timeout 2 nslookup google.com "$VPN_DNS_PRIMARY" >/dev/null 2>&1; then
            log INFO "  ✓ Interner DNS $VPN_DNS_PRIMARY erreichbar"
        else
            log WARN "  ✗ Interner DNS $VPN_DNS_PRIMARY nicht erreichbar"
        fi
    fi

    # A host that only answers through the tunnel. Reaching 1.1.1.1 above
    # proves the internet works, not that the VPN carries anything - the
    # difference between the two is exactly the failure the user cannot
    # otherwise see: an established tunnel that routes nothing.
    if [ -n "$VPN_TEST_HOST" ]; then
        if ping -c 1 -W 2 "$VPN_TEST_HOST" >/dev/null 2>&1; then
            log INFO "  ✓ Test-Host $VPN_TEST_HOST ueber den Tunnel erreichbar"
        else
            log WARN "  ✗ Test-Host $VPN_TEST_HOST NICHT erreichbar"
            log WARN "    Der Tunnel steht, traegt aber offenbar keinen Verkehr."
        fi
    fi

    log DEBUG "Aktive ESP-Verbindungen:"
    ESP_OUTPUT=$(run_sudo ip xfrm state | grep -E "spi|proto esp" | head -10)
    echo "$ESP_OUTPUT" >> "$DETAILED_LOG"
    echo "$ESP_OUTPUT"
else
    # VPN_IP_STATUS 1: strongSwan meldet ueberhaupt keine IKE_SA. Nicht
    # "keine Adresse gefunden" - es gibt nichts, was eine haette.
    log ERROR "Kein Tunnel: strongSwan meldet keine IKE_SA."
    log DEBUG "swanctl-Bericht steht oben; aktuelle IP-Adressen:"
    ip addr show >> "$DETAILED_LOG"
fi

log_section "ENDERGEBNIS"
EXIT_CODE=1
FINAL_SAS=$(run_sudo swanctl --list-sas 2>/dev/null)
# CHILD_SAs are the *data path*. INSTALLED ones carry traffic; without them
# the IKE_SA may show ESTABLISHED but no traffic flows (Fix A invariant).
#
# Gezaehlt wird, was der Bericht als CHILD_SA ausweist, nicht wie oft das
# Wort INSTALLED irgendwo vorkommt - dieselbe Auswertung, die der Watcher
# benutzt, damit beide denselben Tunnel gleich beurteilen.
INSTALLED_CHILDREN=$(printf '%s\n' "$FINAL_SAS" | vpn_query --tunnel-health)
TUNNEL_HEALTH=$?
if [ "$TUNNEL_HEALTH" -eq 0 ]; then
    log INFO "========================================="
    log INFO "   VPN ERFOLGREICH VERBUNDEN!"
    log INFO "   Aktive Child SAs: $INSTALLED_CHILDREN"
    log INFO "========================================="
    notify-send -u normal -i network-vpn "VPN Connected" "Erfolgreich mit Corporate Network verbunden"
    # Write status to log file
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Successfully connected" >> "$LOG_FILE"
    log INFO "Detailliertes Log: $DETAILED_LOG"
    # Write state file so AGS/Waybar can detect a *real* tunnel.
    # File presence = tunnel was up at last connect attempt; cleared on disconnect.
    {
        printf '{"status":"connected"'
        printf ',"connection_name":"%s"' "${VPN_CONNECTION}"
        printf ',"server":"%s"' "{{STYLE_VPN_SERVER}}"
        # Was strongSwan gemeldet hat, sonst nichts. Leer heisst "keine
        # virtuelle Adresse zugewiesen" - ein gueltiger Zustand, den die
        # Leiste und die Widgets als solchen lesen. "unknown" stand
        # frueher hier und war von einer echten Adresse nicht zu
        # unterscheiden, ausser durch Hinsehen.
        printf ',"virtual_ip":"%s"' "${VPN_IP}"
        printf ',"installed_children":%d' "${INSTALLED_CHILDREN}"
        printf ',"connected_at":"%s"' "$(date -Iseconds)"
        printf '}\n'
    } > "$VPN_STATE_FILE"
    # Kein chmod dahinter: die umask ganz oben legt die Datei bereits mit
    # 0600 an. Ein nachtraegliches Verengen laesst genau das Zeitfenster
    # offen, um das es hier ueberall geht.
    log DEBUG "VPN-State-File geschrieben: $VPN_STATE_FILE"
    EXIT_CODE=0
else
    log ERROR "========================================="
    log ERROR "   VPN VERBINDUNG FEHLGESCHLAGEN!"
    log ERROR "========================================="
    log ERROR "Bitte Log-Datei prüfen für Details"
    notify-send -u critical -i network-vpn "VPN Error" "Verbindung fehlgeschlagen. Terminal prüfen für Details."
    # Write error to log file
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Connection failed" >> "$LOG_FILE"

    # Additional diagnostics on failure
    log_section "FEHLERDIAGNOSE"
    log ERROR "StrongSwan Journal (letzte 30 Zeilen):"
    run_sudo journalctl -u strongswan --no-pager -n 30 2>&1 | tee -a "$DETAILED_LOG"

    log ERROR "Charon Log (falls vorhanden):"
    if [ -f /var/log/charon.log ]; then
        run_sudo tail -30 /var/log/charon.log 2>&1 | tee -a "$DETAILED_LOG"
    else
        log DEBUG "  /var/log/charon.log nicht gefunden"
    fi

    log INFO "Detailliertes Log für Support: $DETAILED_LOG"
fi

# In terminal mode (debug), wait for user to read output before closing
if [ -t 0 ]; then
    echo ""
    echo "Press any key to close this window"
    read -n 1
fi

exit $EXIT_CODE