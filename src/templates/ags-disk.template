// DIE BREITE IST EINE ADDITION UND KEINE GEGRIFFENE ZAHL
//
//     Hier stand 500, und `.disk-container` traegt `min-width: 480px`.
//     Zwei Zahlen, die Verschiedenes messen: die eine ist der Deckel des
//     FENSTERS, die andere der Anspruch des INHALTS - und das Fenster
//     muss neben dem Inhalt auch den Kasten bezahlen, in dem er sitzt.
//     Derselbe Fehler wie beim Kalender; die lange Fassung steht in
//     ags-calendar.template.
//
//     GEMESSEN am 17.08.2026 im verschachtelten Compositor, Schirm
//     1920x1080, je einmal unter de_DE.UTF-8 und en_US.UTF-8. Beide
//     Sprachen gaben dieselbe Zahl - der Anspruch dieses Fensters haengt
//     an der min-width und an keiner Beschriftung:
//
//         .disk-container { min-width: 480px }          480
//         dessen padding {{STYLE_SPACE_16}}, zweimal    +50
//                                                      ----
//         Inhalt, gemessen                              530
//         .overlay-outer, Rahmen 1px, zweimal            +2
//         senkrechte Bildlaufleiste (immer reserviert)  +24
//                                                      ----
//                                                       556
//
//     Bei 500 blieb davon ein Sichtfenster von 500 - 2 - 24 = 474; die
//     fehlenden 56 Punkte lagen hinter der rechten Kante, und auf dem
//     Bild endete jede Partitionszeile mitten in ihrer Prozentzahl.
const WIN_WIDTH = 556
const WIN_HEIGHT = 580
const UPDATE_INTERVAL = 30000 // 30 seconds

// Icons
const ICONS = {
  disk: "{{ICON_DISK}}",
  computer: "{{ICON_COMPUTER}}",
  home: "{{ICON_HOME}}",
  settings: "{{ICON_SETTINGS}}",
  folder: "{{ICON_FOLDER}}",
  search: "{{ICON_SEARCH}}",
}

// Partition info interface
interface PartitionInfo {
  device: string
  mount: string
  fstype: string
  size: string
  used: string
  avail: string
  percent: number
  icon: string
}

interface DiskTotal {
  name: string
  size: string
  used: string
  free: string
  percent: number
}

// Helper to remove all children from a box (GTK4 doesn't have get_children)
function removeAllChildren(box: Gtk.Box) {
  let child = box.get_first_child()
  while (child) {
    const next = child.get_next_sibling()
    box.remove(child)
    child = next
  }
}

// ============================================================================
// DATA FUNCTIONS
// ============================================================================

// Get icon for mount point
function getPartitionIcon(mount: string): string {
  if (mount === "/") return ICONS.computer
  if (mount.startsWith("/boot")) return ICONS.settings
  if (mount.startsWith("/home")) return ICONS.home
  return ICONS.disk
}

// Parse disk info from df command
async function getDiskInfo(): Promise<PartitionInfo[]> {
  const partitions: PartitionInfo[] = []

  try {
    const output = await execAsync("df -h --output=source,fstype,size,used,avail,pcent,target")
    const lines = output.trim().split("\n").slice(1) // Skip header

    for (const line of lines) {
      const parts = line.trim().split(/\s+/)
      if (parts.length < 7) continue

      const [device, fstype, size, used, avail, percentStr, ...mountParts] = parts
      const mount = mountParts.join(" ")

      // Skip virtual filesystems
      if (["tmpfs", "devtmpfs", "efivarfs", "overlay", "squashfs", "fuse"].includes(fstype)) continue
      if (!mount) continue

      const percent = parseInt(percentStr.replace("%", "")) || 0

      partitions.push({
        device,
        mount,
        fstype,
        size,
        used,
        avail,
        percent,
        icon: getPartitionIcon(mount),
      })
    }
  } catch (e) {
    console.error("Failed to get disk info:", e)
  }

  return partitions
}

// Wieviele Partitionen. Mit ngettext, weil "1 Partitionen" der Fehler
// ist, den ein Leser sofort sieht - und weil die Anzahl der Formen der
// Sprache gehoert und nicht dieser Datei.
function partitionCount(anzahl: number): string {
  return format(ngettext("{count} partition", "{count} partitions", anzahl),
                { count: anzahl })
}

// Get total disk info for root
async function getDiskTotal(): Promise<DiskTotal> {
  const total: DiskTotal = {
    name: _("System"),
    size: "0G",
    used: "0G",
    free: "0G",
    percent: 0,
  }

  try {
    // Get root partition info
    const dfOutput = await execAsync("df -h --output=size,used,avail,pcent /")
    const lines = dfOutput.trim().split("\n")
    if (lines.length > 1) {
      const parts = lines[1].trim().split(/\s+/)
      if (parts.length >= 4) {
        total.size = parts[0]
        total.used = parts[1]
        total.free = parts[2]
        total.percent = parseInt(parts[3].replace("%", "")) || 0
      }
    }

    // Try to get disk model name
    try {
      const findmntOutput = await execAsync("findmnt -no SOURCE /")
      const rootDev = findmntOutput.trim()
      if (rootDev) {
        const diskDev = rootDev.replace(/[0-9]+$/, "").replace(/p$/, "")
        const modelOutput = await execAsync(`lsblk -dno MODEL ${diskDev}`)
        const model = modelOutput.trim()
        if (model) total.name = model
      }
    } catch {
      // Keep default name
    }
  } catch (e) {
    console.error("Failed to get disk total:", e)
  }

  return total
}

// Get color class based on percentage
function getColorClass(percent: number): string {
  if (percent >= 90) return "critical"
  if (percent >= 75) return "warning"
  return "normal"
}

// Get color hex for drawing
function getColorHex(percent: number): { r: number; g: number; b: number } {
  if (percent >= 90) return { r: 0.95, g: 0.55, b: 0.66 } // #f38ba8 critical
  if (percent >= 75) return { r: 0.98, g: 0.89, b: 0.69 } // #f9e2af warning
  return { r: 0.54, g: 0.71, b: 0.98 } // #89b4fa normal
}

// ============================================================================
// CIRCULAR PROGRESS WIDGET (Cairo Drawing - GTK4)
// ============================================================================
function createCircularProgress(size: number, thickness: number): { widget: Gtk.DrawingArea; setValue: (percent: number) => void } {
  const drawingArea = new Gtk.DrawingArea()
  drawingArea.set_size_request(size, size)
  drawingArea.add_css_class("disk-ring")

  let currentPercent = 0

  // GTK4 uses set_draw_func instead of "draw" signal
  drawingArea.set_draw_func((_area: Gtk.DrawingArea, cr: any, width: number, height: number) => {
    const centerX = width / 2
    const centerY = height / 2
    const radius = (Math.min(width, height) - thickness) / 2

    // Background ring
    cr.setSourceRGBA(0.19, 0.20, 0.27, 1) // #313244
    cr.setLineWidth(thickness)
    cr.arc(centerX, centerY, radius, 0, 2 * Math.PI)
    cr.stroke()

    // Progress ring
    const color = getColorHex(currentPercent)
    cr.setSourceRGBA(color.r, color.g, color.b, 1)
    cr.setLineWidth(thickness)
    cr.setLineCap(1) // CAIRO_LINE_CAP_ROUND

    const startAngle = -Math.PI / 2 // Start at top
    const endAngle = startAngle + (currentPercent / 100) * 2 * Math.PI

    cr.arc(centerX, centerY, radius, startAngle, endAngle)
    cr.stroke()
  })

  const setValue = (percent: number) => {
    currentPercent = percent
    drawingArea.queue_draw()
  }

  return { widget: drawingArea, setValue }
}

// ============================================================================
// MAIN WIDGET
// ============================================================================
export default function DiskUsage(): OverlayWidget {
  // UI elements
  let totalNameLabel: Gtk.Label
  let ringPercentLabel: Gtk.Label
  let usedLabel: Gtk.Label
  let freeLabel: Gtk.Label
  let sizeLabel: Gtk.Label
  let partitionsList: Gtk.Box
  let partitionCountLabel: Gtk.Label
  let circularProgress: { widget: Gtk.DrawingArea; setValue: (percent: number) => void }
  let closeFn: (() => void) | null = null

  // ============================================================================
  // CREATE PARTITION ROW
  // ============================================================================
  const createPartitionRow = (part: PartitionInfo): Gtk.Box => {
    const row = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL,
      spacing: 8,
    })
    row.add_css_class("disk-partition")
    row.add_css_class(getColorClass(part.percent))

    // Header row with icon, name, device, percent
    const headerRow = new Gtk.Box({ spacing: 10 })

    const iconBox = new Gtk.Box()
    iconBox.add_css_class("disk-partition-icon")
    iconBox.add_css_class(getColorClass(part.percent))
    const icon = new Gtk.Label({ label: part.icon })
    iconBox.append(icon)

    const infoBox = new Gtk.Box({
      orientation: Gtk.Orientation.VERTICAL,
      spacing: 0,
      hexpand: true,
    })
    const mountLabel = new Gtk.Label({ label: part.mount, xalign: 0 })
    mountLabel.add_css_class("disk-partition-mount")
    const deviceLabel = new Gtk.Label({ label: part.device, xalign: 0 })
    deviceLabel.add_css_class("disk-partition-device")
    infoBox.append(mountLabel)
    infoBox.append(deviceLabel)

    const percentLabel = new Gtk.Label({ label: `${part.percent}%` })
    percentLabel.add_css_class("disk-partition-percent")
    percentLabel.add_css_class(getColorClass(part.percent))

    headerRow.append(iconBox)
    headerRow.append(infoBox)
    headerRow.append(percentLabel)

    // Progress bar
    const progress = new Gtk.ProgressBar({ hexpand: true })
    progress.set_fraction(part.percent / 100)
    progress.add_css_class("disk-partition-progress")
    progress.add_css_class(getColorClass(part.percent))

    // Size info
    const sizeRow = new Gtk.Box()
    const usedText = new Gtk.Label({
      label: format(_("{size} used"), { size: part.used }), xalign: 0,
    })
    usedText.add_css_class("disk-partition-size")
    const freeText = new Gtk.Label({
      label: format(_("{size} free"), { size: part.avail }),
      xalign: 1, hexpand: true,
    })
    freeText.add_css_class("disk-partition-size")
    sizeRow.append(usedText)
    sizeRow.append(freeText)

    row.append(headerRow)
    row.append(progress)
    row.append(sizeRow)

    return row
  }

  // ============================================================================
  // UPDATE DISPLAY
  // ============================================================================
  const updateDisplay = async () => {
    const total = await getDiskTotal()
    const partitions = await getDiskInfo()

    // Update circular progress
    circularProgress.setValue(total.percent)
    ringPercentLabel.set_text(`${total.percent}%`)

    // Update labels
    totalNameLabel.set_text(total.name)
    usedLabel.set_text(total.used)
    freeLabel.set_text(total.free)
    sizeLabel.set_text(total.size)
    partitionCountLabel.set_text(partitionCount(partitions.length))

    // Update partition list
    removeAllChildren(partitionsList)
    for (const part of partitions) {
      partitionsList.append(createPartitionRow(part))
    }
  }

  // Launch app and close overlay
  function launchApp(command: string) {
    execAsync(command)
    closeFn?.()
  }

  return createOverlayWindow({
    name: "disk",
    width: WIN_WIDTH,
    height: WIN_HEIGHT,
    cssClass: "DiskUsage",
    headerIcon: ICONS.disk,
    headerTitle: _("Disk space"),
    accentCssClass: "disk-accent",
    onShow: () => {
      updateDisplay()
    },
    buildContent: (_win, closeWindow) => {
      closeFn = closeWindow

      const mainBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 0,
      })
      mainBox.add_css_class("disk-container")

      // ===== MAIN DISK OVERVIEW - Circular Progress =====
      const overviewBox = new Gtk.Box({ spacing: 20, halign: Gtk.Align.CENTER })
      overviewBox.add_css_class("disk-overview")

      // Circular progress with center text
      const ringContainer = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        halign: Gtk.Align.CENTER,
      })
      ringContainer.add_css_class("disk-ring-container")

      // Create the circular progress (120px size, 10px thickness)
      circularProgress = createCircularProgress(120, 10)

      // Overlay for center text
      const ringOverlay = new Gtk.Overlay()
      ringOverlay.set_child(circularProgress.widget)

      const centerBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        halign: Gtk.Align.CENTER,
        valign: Gtk.Align.CENTER,
      })
      ringPercentLabel = new Gtk.Label({ label: "0%" })
      ringPercentLabel.add_css_class("disk-ring-percent")
      const ringLabel = new Gtk.Label({ label: _("in use") })
      ringLabel.add_css_class("disk-ring-label")
      centerBox.append(ringPercentLabel)
      centerBox.append(ringLabel)
      ringOverlay.add_overlay(centerBox)

      ringContainer.append(ringOverlay)

      // Stats next to ring
      const statsBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 8,
        valign: Gtk.Align.CENTER,
      })
      statsBox.add_css_class("disk-stats")

      // Used stat
      const usedStatBox = new Gtk.Box({ spacing: 8 })
      const usedDot = new Gtk.Box()
      usedDot.set_size_request(12, 12)
      usedDot.add_css_class("disk-stat-dot")
      usedDot.add_css_class("used")
      const usedInfoBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 0,
      })
      usedLabel = new Gtk.Label({ label: "0G", xalign: 0 })
      usedLabel.add_css_class("disk-stat-value")
      const usedTitle = new Gtk.Label({ label: _("Used"), xalign: 0 })
      usedTitle.add_css_class("disk-stat-label")
      usedInfoBox.append(usedLabel)
      usedInfoBox.append(usedTitle)
      usedStatBox.append(usedDot)
      usedStatBox.append(usedInfoBox)

      // Free stat
      const freeStatBox = new Gtk.Box({ spacing: 8 })
      const freeDot = new Gtk.Box()
      freeDot.set_size_request(12, 12)
      freeDot.add_css_class("disk-stat-dot")
      freeDot.add_css_class("free")
      const freeInfoBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 0,
      })
      freeLabel = new Gtk.Label({ label: "0G", xalign: 0 })
      freeLabel.add_css_class("disk-stat-value")
      const freeTitle = new Gtk.Label({ label: _("Available"), xalign: 0 })
      freeTitle.add_css_class("disk-stat-label")
      freeInfoBox.append(freeLabel)
      freeInfoBox.append(freeTitle)
      freeStatBox.append(freeDot)
      freeStatBox.append(freeInfoBox)

      // Total stat
      const totalStatBox = new Gtk.Box({ spacing: 8 })
      const totalDot = new Gtk.Box()
      totalDot.set_size_request(12, 12)
      totalDot.add_css_class("disk-stat-dot")
      totalDot.add_css_class("total")
      const totalInfoBox = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 0,
      })
      sizeLabel = new Gtk.Label({ label: "0G", xalign: 0 })
      sizeLabel.add_css_class("disk-stat-value")
      const sizeTitle = new Gtk.Label({ label: _("Total"), xalign: 0 })
      sizeTitle.add_css_class("disk-stat-label")
      totalInfoBox.append(sizeLabel)
      totalInfoBox.append(sizeTitle)
      totalStatBox.append(totalDot)
      totalStatBox.append(totalInfoBox)

      // Header subtitle label (disk model name)
      totalNameLabel = new Gtk.Label({ label: _("System"), xalign: 0 })
      totalNameLabel.add_css_class("disk-header-subtitle")

      statsBox.append(usedStatBox)
      statsBox.append(freeStatBox)
      statsBox.append(totalStatBox)

      overviewBox.append(ringContainer)
      overviewBox.append(statsBox)

      // ===== PARTITIONS SECTION =====
      const partitionsHeader = new Gtk.Box({ spacing: 20, halign: Gtk.Align.CENTER })
      partitionsHeader.add_css_class("disk-partitions-header")

      const partitionsTitle = new Gtk.Label({ label: _("PARTITIONS") })
      partitionsTitle.add_css_class("disk-section-title")

      partitionCountLabel = new Gtk.Label({ label: partitionCount(0) })
      partitionCountLabel.add_css_class("disk-partition-count")

      partitionsHeader.append(partitionsTitle)
      partitionsHeader.append(partitionCountLabel)

      const scroll = new Gtk.ScrolledWindow({
        hscrollbar_policy: Gtk.PolicyType.NEVER,
        vscrollbar_policy: Gtk.PolicyType.AUTOMATIC,
        vexpand: true,
      })
      scroll.add_css_class("disk-scroll")

      partitionsList = new Gtk.Box({
        orientation: Gtk.Orientation.VERTICAL,
        spacing: 10,
      })
      partitionsList.add_css_class("disk-partitions-list")
      scroll.set_child(partitionsList)

      // ===== QUICK ACTIONS =====
      const actionsBox = new Gtk.Box({ spacing: 11, homogeneous: true })
      actionsBox.add_css_class("disk-actions")

      // zepButton, Rolle "umrandet" fuer beide (Task A, 18.08.2026):
      // Dateimanager und Analyse sind zwei gleichrangige Werkzeuge,
      // keins ist die Hauptsache dieses Fensters (das ist die
      // Speicherplatzuebersicht darueber).
      const filesBtn = zepButton("", "umrandet", () => launchApp("nautilus / &"))
      filesBtn.set_tooltip_text(_("Open the root directory"))
      const filesBtnBox = new Gtk.Box({ spacing: 11, halign: Gtk.Align.CENTER })
      const filesIcon = new Gtk.Label({ label: ICONS.folder })
      filesIcon.add_css_class("disk-action-icon")
      const filesLabel = new Gtk.Label({ label: _("Files") })
      filesLabel.add_css_class("disk-action-text")
      filesBtnBox.append(filesIcon)
      filesBtnBox.append(filesLabel)
      filesBtn.set_child(filesBtnBox)

      const analyzeBtn = zepButton("", "umrandet", () => launchApp("baobab &"))
      analyzeBtn.set_tooltip_text(_("Analyze disk usage with Baobab"))
      const analyzeBtnBox = new Gtk.Box({ spacing: 11, halign: Gtk.Align.CENTER })
      const analyzeIcon = new Gtk.Label({ label: ICONS.search })
      analyzeIcon.add_css_class("disk-action-icon")
      const analyzeLabel = new Gtk.Label({ label: _("Analyze") })
      analyzeLabel.add_css_class("disk-action-text")
      analyzeBtnBox.append(analyzeIcon)
      analyzeBtnBox.append(analyzeLabel)
      analyzeBtn.set_child(analyzeBtnBox)

      // Zwei Knoepfe, nicht drei. Der dritte hiess "Disks" und rief
      // `gnome-disks` - gnome-disk-utility 46.1-3, GTK3, und auf keinem
      // ZepOS installiert. Ein Knopf, der nichts tut, ist schlimmer als
      // ein fehlender: der fehlende sagt die Wahrheit.
      //
      // Ersetzt ist er nicht, weil es nichts zu ersetzen gibt: im
      // angehefteten Schnappschuss 2026/08/04 steht kein GTK4-Werkzeug
      // zum Partitionieren. Die Aufgabe verteilt sich stattdessen -
      // eingeteilt wird mit dem ZepOS-Installer, eingehaengt vom
      // Dateimanager ueber udisks2, und was die Platte fuellt, sagt der
      // Knopf daneben.
      actionsBox.append(filesBtn)
      actionsBox.append(analyzeBtn)

      // ===== ASSEMBLE =====
      mainBox.append(totalNameLabel)
      mainBox.append(overviewBox)
      mainBox.append(partitionsHeader)
      mainBox.append(scroll)
      mainBox.append(actionsBox)

      // Start update interval
      interval(UPDATE_INTERVAL, updateDisplay)

      return mainBox
    },
  })
}
