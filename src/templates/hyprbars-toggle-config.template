#!/bin/bash
# Toggle Hyprbars (Window Titlebars)
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hyprbars-toggle-config.template

STATE_FILE="$HOME/.cache/hyprbars-state"
NORMAL_HEIGHT="{{STYLE_HYPRBARS_HEIGHT}}"

# Get current state (default: enabled)
if [ -f "$STATE_FILE" ]; then
    CURRENT_STATE=$(cat "$STATE_FILE")
else
    CURRENT_STATE="enabled"
fi

# Toggle
if [ "$CURRENT_STATE" = "enabled" ]; then
    # Disable titlebars
    hyprctl keyword plugin:hyprbars:bar_height 0
    echo "disabled" > "$STATE_FILE"
    notify-send -t 1500 "{{ICON_WINDOW}} Titlebars" "Ausgeblendet"
else
    # Enable titlebars
    hyprctl keyword plugin:hyprbars:bar_height "$NORMAL_HEIGHT"
    echo "enabled" > "$STATE_FILE"
    notify-send -t 1500 "{{ICON_WINDOW}} Titlebars" "Eingeblendet"
fi

# Force layout recalculation by toggling gaps
sleep 0.05

# Get current gaps (format: "5 5 5 5" or similar)
CURRENT_GAPS=$(hyprctl getoption general:gaps_in -j | jq -r '.custom // "5"')

# Toggle gaps to force recalculation (add 1 to first value, then restore)
hyprctl keyword general:gaps_in 6
hyprctl keyword general:gaps_in "$CURRENT_GAPS"
