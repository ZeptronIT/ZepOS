# =========================================
# HYPRCLIPX - Zwischenablage-Verlauf
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/hyprclipx-config.template
# =========================================
#
# Gelesen von plugins/hyprclipx/src/ConfigParser.cpp, von beiden
# Haelften. Format und Begruendung wie bei
# src/templates/hyprlaunch-config.template - dort steht die lange
# Fassung, warum diese Zahlen nicht im uebersetzten Objekt stehen
# duerfen und warum der Parser ein "px" hinnimmt.

[window]
window_width = {{STYLE_CLIPBOARD_WIDTH}}
window_height = {{STYLE_CLIPBOARD_HEIGHT}}

# Wohin das Fenster gegenueber der Schreibmarke rueckt, wenn der Nutzer
# es mit den Pfeiltasten verschiebt. Beides 0, und das ist kein
# fehlender Wert: das Fenster setzt sich an die Schreibmarke, und der
# Versatz ist die Korrektur, die der Nutzer selbst einstellt.
# ClipboardRenderer schreibt sie in seine eigene Zustandsdatei, nicht
# hierher.
offset_x = 0
offset_y = 0

[general]
# Wieviele Eintraege der Verlauf hoechstens haelt. Eine ANZAHL, keine
# Groesse: sie hat mit der Schrift nichts zu tun und steht deshalb
# nicht in src/sizes.py.
max_items = 50

# Wieviele Zeichen die Vorschau einer Zeile zeigt. Ebenfalls eine
# Anzahl - was sich mit dem Faktor aendert, ist die Breite, die sechzig
# Zeichen einnehmen, und die ist genau deshalb keine zweite
# Einstellung.
preview_chars = {{STYLE_MEASURE_PROSE}}

# Die Taste, die das Fenster oeffnet. Gebunden wird sie in
# src/templates/hyprland-plugins-config.template; hier steht sie, weil
# das Fenster sie anzeigt.
hotkey = "SUPER SHIFT V"

# Der Socket des Sammlers. /tmp und nicht $XDG_RUNTIME_DIR, weil beide
# Haelften und der Sammler ihn finden muessen und die Variable in einem
# vom Compositor geforkten Prozess nicht zuverlaessig gesetzt ist.
#
# Seit dem 12.08.2026 liest AUCH der Sammler diese Zeile
# (plugins/hyprclipx/helpers/collector.py). Vorher stand der Pfad in
# seinem Kopf ein zweites Mal, zusammen mit einem max_items von 700
# neben den 50 hier - das Fenster holte fuenfzig Eintraege und der
# Sammler hob siebenhundert auf.
socket_path = "/tmp/clipman.sock"

# Wo der Schreibmarken-Helfer liegt.
#
# Er sagt dem Fenster, an welcher Stelle des Schirms die Schreibmarke
# steht, damit der Verlauf dort aufgeht und nicht am Mauszeiger. Das
# Paket legt ihn nach /usr/lib/hyprclipx/; wer aus dem Arbeitsbaum
# heraus baut, traegt hier den Pfad dorthin ein.
#
# Bis zum 12.08.2026 stand der Pfad im uebersetzten Objekt und zeigte
# nach ~/.local/bin - dorthin, wo kein pacman-Paket etwas ablegen darf.
# plugins/hyprclipx/src/Globals.cpp fuehrt die Messung.
caret_helper = "/usr/lib/hyprclipx/caret-position.py"

[spacing]
# Die Abstandsleiter aus src/sizes.py. Warum sie hier steht und nicht
# im Stylesheet: src/templates/hyprlaunch-config.template.
#
# Der Verlauf benutzt heute die Sprossen 2, 4 und 8 - upstream hatte
# dort 1, 2, 4 und 6 stehen, und die 1 und die 6 sind auf die Leiter
# gerundet worden. Die Rechnung steht in
# plugins/hyprclipx/src/ClipboardRenderer.cpp.
space_2 = {{STYLE_SPACE_2}}
space_4 = {{STYLE_SPACE_4}}
space_8 = {{STYLE_SPACE_8}}
space_12 = {{STYLE_SPACE_12}}
space_16 = {{STYLE_SPACE_16}}
space_20 = {{STYLE_SPACE_20}}
space_24 = {{STYLE_SPACE_24}}
