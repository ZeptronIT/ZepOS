#!/bin/bash
# =========================================
# TTY MONITOR ROTATION SCRIPT
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# To customise: copy the template to $XDG_CONFIG_HOME/zepos/templates/tty-monitor-rotation-config.template
# =========================================
#
# Dreht die Framebuffer-Konsole so, wie die Bildschirme stehen.
#
# Vorher zählte das Skript die DP-Anschlüsse unter /sys/class/drm und tat
# unterhalb von dreien gar nichts - und schrieb sonst die feste Zahl 3.
# Beides beschrieb genau einen Arbeitsplatz: bei einem oder zwei hochkant
# stehenden Schirmen passierte nichts, bei drei quer stehenden wurde eine
# lesbare Konsole gekippt, und wer seine Schirme andersherum dreht, bekam
# die Konsole verkehrt herum.
#
# Wie die Schirme stehen, weiß der Compositor. In einer TTY läuft er
# vielleicht nicht - dann fragt das Skript nach dem Winkel, statt einen zu
# raten: eine falsch gedrehte Konsole ist von dort aus schwer zu
# reparieren.
# =========================================

# Beim Generieren eingesetzt.
ZEPOS_SYSTEM_ROOT="{{ZEPOS_SYSTEM_ROOT}}"

# Die Drehung der Framebuffer-Konsole. Der Pfad steht hier genau einmal,
# damit Tests mitlesen können, was das Skript schreiben würde, ohne die
# Konsole des Testrechners zu drehen.
FBCON_ROTATE="${FBCON_ROTATE:-/sys/class/graphics/fbcon/rotate_all}"

# Winkel des Bildschirms -> Wert für fbcon.
#
# fbcon zählt andersherum als wl_output: dessen transform ist die
# Drehung, die der Compositor GEGEN die Schirmlage rechnet, und fbcons
# Zahl benennt, wie weit der Text gedreht wird. transform 1 (90°)
# entspricht also fbcon 3 und transform 3 (270°) entspricht fbcon 1 -
# genau die Paarung, die der ursprüngliche Arbeitsplatz benutzte: seine
# hochkant stehenden Schirme waren die mit transform 1, und hier stand 3.
fbcon_value_for() {
    case "$1" in
        0)   echo 0 ;;
        90)  echo 3 ;;
        180) echo 2 ;;
        270) echo 1 ;;
        *)   return 1 ;;
    esac
}

# Der Winkel des ersten Schirms, der nicht aufrecht steht - oder 0.
detect_angle() {
    local monitors
    monitors=$(python3 "$ZEPOS_SYSTEM_ROOT/monitors.py" --list 2>/dev/null) || return 1

    local name x transform width height role
    while read -r name x transform width height role; do
        case "$transform" in
            # 4 bis 7 sind dieselben Drehungen, zusätzlich gespiegelt.
            1|5) echo 90;  return 0 ;;
            2|6) echo 180; return 0 ;;
            3|7) echo 270; return 0 ;;
        esac
    done <<< "$monitors"

    echo 0
}

# Function to rotate TTY
rotate_tty() {
    local angle=$1
    local value

    if ! value=$(fbcon_value_for "$angle"); then
        echo "{{ICON_ERROR}} Unbrauchbarer Winkel: $angle (erlaubt: 0, 90, 180, 270)"
        return 1
    fi

    if [ "$value" = "0" ]; then
        echo "{{ICON_INFO}} Kein Bildschirm steht hochkant - nichts zu drehen"
        return 0
    fi

    # Erst sagen, was passieren soll, dann prüfen, ob es geht: wer keine
    # Rechte hat, erfährt so trotzdem, was das Skript vorhatte.
    echo "{{ICON_START}} Drehe TTY um ${angle}° (fbcon $value)..."

    if [ ! -w "$FBCON_ROTATE" ]; then
        echo "{{ICON_ERROR}} Keine Schreibrechte auf $FBCON_ROTATE"
        echo "Run: sudo $0 rotate $angle"
        return 1
    fi

    echo "$value" > "$FBCON_ROTATE" || {
        echo "{{ICON_ERROR}} TTY-Drehung fehlgeschlagen"
        return 1
    }

    echo "{{ICON_SUCCESS}} TTY rotated successfully!"
    echo "{{ICON_INFO}} This is temporary - will reset on reboot"

    # Wait for rotation to complete
    sleep 0.5

    # Force terminal refresh by switching VT
    CURRENT_VT=$(fgconsole)
    chvt 1
    chvt $CURRENT_VT

    # Clear screen to fix boundaries
    clear
}

# Function to reset TTY rotation
reset_tty() {
    if [ ! -w "$FBCON_ROTATE" ]; then
        echo "{{ICON_ERROR}} Keine Schreibrechte auf $FBCON_ROTATE"
        echo "Run: sudo $0 reset"
        return 1
    fi

    echo "{{ICON_START}} Resetting TTY rotation..."
    echo 0 > "$FBCON_ROTATE"
    echo "{{ICON_SUCCESS}} TTY rotation reset!"
}

# Main logic
ACTION="${1:-rotate}"
ANGLE="${2:-}"

# Check if in TTY
if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    echo "{{ICON_WARNING}} You're in a graphical session!"
    echo "This script is meant for TTY (Ctrl+Alt+F2)"
    echo ""
    echo "Usage:"
    echo "  1. Press Ctrl+Alt+F2 to switch to TTY"
    echo "  2. Login"
    echo "  3. Run: sudo $0"
    echo "  4. Run: sudo $0 reset (to undo)"
    exit 0
fi

# Execute action
case "$ACTION" in
    "rotate")
        if [ -z "$ANGLE" ]; then
            if ! ANGLE=$(detect_angle); then
                echo "{{ICON_WARNING}} Hyprland ist nicht erreichbar - die Lage der"
                echo "Bildschirme ist von hier aus nicht feststellbar."
                echo "Winkel angeben, z. B.: $0 rotate 90"
                exit 1
            fi
        fi
        rotate_tty "$ANGLE"
        ;;
    "reset")
        reset_tty
        ;;
    *)
        echo "Usage: $0 [rotate [0|90|180|270]|reset]"
        echo "  rotate - Konsole so drehen, wie die Bildschirme stehen"
        echo "           (ohne Winkel: aus der Bildschirmlage ermittelt)"
        echo "  reset  - Reset to normal orientation"
        exit 1
        ;;
esac
