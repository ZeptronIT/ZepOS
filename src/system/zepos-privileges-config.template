# =========================================
# ZepOS PRIVILEGES - /etc/sudoers.d/zepos
# Generated by ZepOS - DO NOT EDIT DIRECTLY!
# Erzeugt aus {{ZEPOS_SYSTEM_ROOT}}/system/zepos-privileges-config.template
# To customise: copy the template to
# $XDG_CONFIG_HOME/zepos/system/zepos-privileges-config.template
# =========================================
#
# Installieren (einmalig, fragt nach dem Passwort):
#
#     ~/.config/ags/scripts/vpn-control.sh install-privileges
#
# oder von Hand, wobei REGEL fuer den Pfad dieser Datei steht - der
# Generator nennt ihn, wenn er sie schreibt (system/zepos unterhalb der
# Einstellungswurzel, dort wo auch user-settings.json liegt):
#
#     visudo -c -f REGEL
#     sudo install -m 0440 -o root -g root REGEL /etc/sudoers.d/zepos
#
# =========================================
# Warum es diese Datei gibt
# =========================================
#
# VPN-Watcher und Netz-Watchdog laufen unbeaufsichtigt: der eine wird von
# hyprlands exec-once gestartet, der andere von einer systemd-Unit im
# Benutzerkontext. Beide haben kein Terminal und keinen Askpass-Helfer.
# Ein blankes `sudo` kann dort niemanden nach einem Passwort fragen und
# schlaegt jedes Mal fehl - der Netz-Watchdog protokollierte deshalb seit
# jeher "Reparatur fehlgeschlagen", ohne je etwas repariert zu haben.
#
# Der Ausweg des Ursprungs war, das Login-Passwort des Benutzers beim
# Verbinden in eine Datei zu schreiben und die Hintergrunddienste
# `sudo -S` damit fuettern zu lassen. Ein Login-Passwort auf der Platte
# ist der Preis fuer eine Bequemlichkeit, und er ist zu hoch: wer die
# Datei liest, hat nicht diese paar Netzbefehle, sondern das Konto.
#
# Hier steht stattdessen, was genau ohne Passwort laufen darf. Kein
# Geheimnis liegt irgendwo, und `sudo -n` funktioniert genau fuer diese
# Befehle - aus einer User-Unit ebenso wie aus einem Terminal.
#
# =========================================
# Was hier bewusst NICHT steht
# =========================================
#
# Keine Shell (`bash -c`, `sh -c`) und kein Werkzeug, das beliebige
# Dateien schreiben kann: `sed -i` etwa schreibt ueber seinen `w`-Befehl
# jede Datei des Systems, eine solche Regel waere Root mit Umweg. Wo eine
# Datei unter /etc geschrieben werden muss, steht ihr Ziel ausgeschrieben
# und ohne Platzhalter da; nur der INHALT kommt vom Aufrufer.
#
# Platzhalter in Argumenten trifft sudo per fnmatch, und dort deckt ein
# `*` auch Schraegstriche ab. Sie stehen deshalb nur da, wo der Wert von
# der Konfiguration des Benutzers abhaengt (Netz, Interface, Child-SA)
# und nirgends in einem Zielpfad.
#
# `ip route` und `ip xfrm` sind maechtig - damit laesst sich der
# Datenverkehr der Maschine umlenken. Das ist allerdings genau das, was
# ein VPN-Client tut; die Regel ist nicht weiter zu fassen, ohne die
# Funktion aufzugeben.

# Die Gruppe, in der das Installationsprogramm das Konto des Benutzers
# anlegt (archinstall, users[].sudo = true). Wer sein Konto in einer
# anderen Administrationsgruppe fuehrt, aendert diese eine Zeile unten.

# --- Die Fangfrage -------------------------------------------------
#
# `sudo -n true` beantwortet "ist diese Regel ueberhaupt installiert?",
# ohne irgendetwas zu tun. Ohne diesen Eintrag muesste jedes Skript
# einen echten Befehl abfeuern, um es herauszufinden - und /usr/bin/true
# als Root auszufuehren aendert nichts an der Maschine.
Cmnd_Alias ZEPOS_PROBE = /usr/bin/true

# --- VPN: Tunnel steuern -------------------------------------------
Cmnd_Alias ZEPOS_VPN_TUNNEL = /usr/bin/swanctl --load-all, \
                              /usr/bin/swanctl --list-sas, \
                              /usr/bin/swanctl --list-conns, \
                              /usr/bin/swanctl --initiate --child *, \
                              /usr/bin/swanctl --terminate --ike *

# --- VPN: Konfiguration nach /etc/swanctl schreiben -----------------
#
# Zwei Schritte, damit die Datei mit dem Pre-Shared Key von der ersten
# Sekunde an 0600 ist: `install` legt sie LEER mit dem richtigen Modus an,
# `tee` schreibt danach in die bestehende Datei, ohne deren Modus zu
# aendern. Ein einzelnes `tee` haette sie unter roots umask mit 0644
# erzeugt - world-readable, mit dem Schluessel darin.
Cmnd_Alias ZEPOS_VPN_CONFIG = /usr/bin/mkdir -p /etc/swanctl/conf.d, \
                              /usr/bin/install -m 0600 -o root -g root /dev/null /etc/swanctl/conf.d/work.conf, \
                              /usr/bin/tee /etc/swanctl/conf.d/work.conf

# --- VPN: Routen und IPsec-Policies --------------------------------
Cmnd_Alias ZEPOS_VPN_NET = /usr/bin/ip route *, \
                           /usr/bin/ip xfrm *, \
                           /usr/bin/ip addr del *

# --- VPN: DNS waehrend der Verbindung ------------------------------
#
# Ziele ausgeschrieben, Inhalt ueber die Standardeingabe. resolv.conf ist
# fuer alle lesbar - der Modus bleibt, wie er ist, weil `tee` in die
# bestehende Datei schreibt.
Cmnd_Alias ZEPOS_VPN_DNS = /usr/bin/cp /etc/resolv.conf /etc/resolv.conf.vpn-backup, \
                           /usr/bin/cp /etc/resolv.conf.vpn-backup /etc/resolv.conf, \
                           /usr/bin/tee /etc/resolv.conf, \
                           /usr/bin/rm -f /etc/resolv.conf.vpn-backup

# --- VPN: Dienst und Diagnose --------------------------------------
Cmnd_Alias ZEPOS_VPN_SERVICE = /usr/bin/systemctl restart strongswan, \
                               /usr/bin/systemctl stop strongswan, \
                               /usr/bin/systemctl is-active strongswan, \
                               /usr/bin/systemctl restart NetworkManager, \
                               /usr/bin/killall -9 charon, \
                               /usr/bin/journalctl -u strongswan --no-pager -n 30, \
                               /usr/bin/tail -30 /var/log/charon.log

# --- Netz-Watchdog: Reparatur --------------------------------------
#
# Die vier Befehle aus restart_network() in network-watchdog.sh. Der
# Watchdog laeuft als systemd-Unit im Benutzerkontext und rief sie mit
# blankem `sudo` auf: ohne diese Regel scheitert dort jeder Aufruf, und
# genau das stand als "Reparatur fehlgeschlagen" im Log - alle zehn
# Sekunden, ohne dass je etwas repariert wurde.
Cmnd_Alias ZEPOS_NET_REPAIR = /usr/bin/ip neigh flush dev *, \
                              /usr/bin/ip link set * down, \
                              /usr/bin/ip link set * up, \
                              /usr/bin/nmcli device reapply *, \
                              /usr/bin/nmcli device connect *

%wheel ALL=(root) NOPASSWD: ZEPOS_PROBE, ZEPOS_VPN_TUNNEL, ZEPOS_VPN_CONFIG, ZEPOS_VPN_NET, ZEPOS_VPN_DNS, ZEPOS_VPN_SERVICE, ZEPOS_NET_REPAIR
