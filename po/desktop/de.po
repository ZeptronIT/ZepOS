msgid "Connection"
msgstr "Verbindung"

msgid "Certificates"
msgstr "Zertifikate"

msgid "OpenVPN"
msgstr "OpenVPN"

msgid "Certificates only - this connection comes back on its own after a network change or resume."
msgstr "Nur Zertifikate – diese Verbindung kommt nach einem Netzwechsel oder dem Aufwachen von selbst zurück."

msgid "This connection needs a password every time. After a network change or resume it stays down until you connect again."
msgstr "Diese Verbindung braucht jedes Mal ein Passwort. Nach einem Netzwechsel oder dem Aufwachen bleibt sie unten, bis Sie erneut verbinden."

msgid "OpenVPN configuration"
msgstr "OpenVPN-Konfiguration"

msgid "Path to an .ovpn file ..."
msgstr "Pfad zu einer .ovpn-Datei …"

msgid "Choose an OpenVPN configuration"
msgstr "Eine OpenVPN-Konfiguration wählen"

msgid "These lines have no effect here, because NetworkManager sets its own: {lines}"
msgstr "Diese Zeilen wirken hier nicht, weil NetworkManager sein eigenes Gegenstück setzt: {lines}"

msgid "The certificates and the key were stored privately. The original {path} still contains them in clear text - you may want to delete it."
msgstr "Die Zertifikate und der Schlüssel wurden privat abgelegt. Das Original {path} enthält sie weiterhin im Klartext – Sie sollten es löschen."

msgid "Server"
msgstr "Server"

msgid "Port (0 = 1194)"
msgstr "Port (0 = 1194)"

msgid "Protocol"
msgstr "Protokoll"

msgid "UDP"
msgstr "UDP"

msgid "TCP"
msgstr "TCP"

msgid "Device"
msgstr "Gerät"

msgid "tun (routed)"
msgstr "tun (geroutet)"

msgid "tap (bridged)"
msgstr "tap (gebrückt)"

msgid "Authentication"
msgstr "Ausweis"

msgid "Username and password"
msgstr "Benutzername und Passwort"

msgid "Both"
msgstr "Beides"

msgid "The password is not stored. It is typed on the VPN page and handed to NetworkManager in a file that is deleted again."
msgstr "Das Passwort wird nicht gespeichert. Es wird auf der VPN-Seite eingegeben und NetworkManager in einer Datei übergeben, die danach gelöscht wird."

msgid "Verify server certificate (remote-cert-tls)"
msgstr "Serverzertifikat prüfen (remote-cert-tls)"

msgid "Cipher"
msgstr "Verschlüsselung"

msgid "HMAC authentication"
msgstr "HMAC-Authentisierung"

msgid "{count} further options were taken over from the file: {options}"
msgstr "{count} weitere Optionen wurden aus der Datei übernommen: {options}"

msgid "Certificates and keys"
msgstr "Zertifikate und Schlüssel"

msgid "Blocks embedded in the .ovpn file were unpacked into ~/.config/openvpn, readable only by you (0600). Only their file names are stored in the settings."
msgstr "In der .ovpn eingebettete Blöcke wurden nach ~/.config/openvpn ausgepackt, nur für Sie lesbar (0600). In den Einstellungen stehen nur ihre Dateinamen."

msgid "CA certificate"
msgstr "CA-Zertifikat"

msgid "Own certificate"
msgstr "Eigenes Zertifikat"

msgid "Own private key"
msgstr "Eigener privater Schlüssel"

msgid "TLS auth key"
msgstr "TLS-Auth-Schlüssel"

msgid "TLS crypt key"
msgstr "TLS-Crypt-Schlüssel"

msgid "File name or absolute path ..."
msgstr "Dateiname oder absoluter Pfad …"

msgid "Present in {path}"
msgstr "Vorhanden in {path}"

msgid "Not set"
msgstr "Nicht gesetzt"

msgid "TLS auth key direction (0, 1 or empty)"
msgstr "Richtung des TLS-Auth-Schlüssels (0, 1 oder leer)"

msgid "This OpenVPN connection identifies itself with certificates - there is nothing to type here."
msgstr "Diese OpenVPN-Verbindung weist sich mit Zertifikaten aus – hier ist nichts einzugeben."


