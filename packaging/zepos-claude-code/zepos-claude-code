#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Der Starter hinter dem Eintrag "Claude Code" - installiert nach
# /usr/bin/zepos-claude-code, aufgerufen von
# /usr/share/applications/zepos-claude-code.desktop als
# `kitty -e zepos-claude-code`.
#
# WOZU EINE ZWISCHENSTUFE, WENN ES claude AUCH DIREKT TUT
#     GEMELDET am 17.08.2026: der Klick im Dock zeigt nichts. Er zeigte
#     etwas - nur zu kurz, um es zu lesen.
#
#     `kitty -e claude` bindet die Lebensdauer des FENSTERS an die
#     Lebensdauer des Programms. Endet claude, endet kitty. Beim
#     allerersten Start ist das genau der falsche Weg: da endet claude
#     womoeglich nach einer Zeile, und diese Zeile ist die Antwort auf
#     die Frage, warum nichts passiert.
#
#     GEMESSEN am 17.08.2026 an der ausgelieferten Binaerdatei (2.1.233),
#     mit einer Option, die es nicht gibt:
#
#         $ claude --gibtsnicht
#         error: unknown option '--gibtsnicht'
#         Rueckgabewert 1
#
#     Eine Zeile, ein Rueckgabewert ungleich null - und im Dock ein
#     Fenster, das aufblitzt und weg ist.
#
# WARUM NICHT `kitty --hold`
#     Weil --hold nicht zwischen den beiden Faellen unterscheidet. Es
#     haelt das Fenster IMMER offen, also auch nach einem gewollten
#     Beenden - dann steht ein totes Terminal auf dem Schreibtisch, das
#     der Nutzer von Hand schliessen muss, jedes Mal. Ein Fenster, das
#     sich nach getaner Arbeit nicht schliesst, ist derselbe Fehler wie
#     eines, das sich zu frueh schliesst; nur die Richtung stimmt nicht.
#
#     Die Unterscheidung, die --hold fehlt, ist der Rueckgabewert. Genau
#     die trifft dieses Skript.
set -u

PROGRAMM="claude"

# Das Fenster offen halten, bis jemand es gelesen hat.
#
# `read` und keine Endlosschleife: eine Taste beendet, und der
# Rueckgabewert bleibt der des Programms - wer diesen Starter aus einem
# Skript aufruft, bekommt weiterhin die Wahrheit.
#
# `[ -t 0 ]` davor, weil dieses Skript nicht immer an einem Terminal
# haengt. Ohne Eingabe kaeme `read` sofort zurueck, die Schleife waere
# wirkungslos und die Meldung stuende trotzdem da - also wird sie in dem
# Fall gar nicht erst gedruckt. Gemessen ist der Fall in der eigenen
# Testsuite, die dieses Skript ohne Terminal aufruft.
halten() {
    local ende="$1"

    if [ ! -t 0 ]; then
        exit "$ende"
    fi

    printf '\n%s\n%s\n' \
        "Claude Code hat mit Rueckgabewert $ende aufgehoert. Die Ursache steht darueber." \
        "[Eingabetaste] schliesst dieses Fenster."
    read -r _ || true
    exit "$ende"
}

# Erst gar nicht da: dann sagt das Fenster das, statt zu blinken. Der
# Fall ist nicht theoretisch - wer `pacman -Rdd zepos-claude-code` nimmt,
# behaelt den Starter-Eintrag im Zwischenspeicher des Menues. 127 ist der
# Wert, mit dem jede Schale "command not found" meldet.
if ! command -v "$PROGRAMM" >/dev/null 2>&1; then
    printf '%s\n%s\n' \
        "ZepOS: '$PROGRAMM' ist auf dieser Maschine nicht installiert." \
        "Das Paket dazu heisst zepos-claude-code." >&2
    halten 127
fi

# Das eigentliche Programm, im Vordergrund und mit allem, was der
# Aufrufer mitgibt. "$@" und nicht $@: eine Frage mit Leerzeichen darin
# ist EIN Argument.
"$PROGRAMM" "$@"
rueckgabe=$?

# WELCHE RUECKGABEWERTE "GEWOLLT BEENDET" HEISSEN
#     0    das uebliche Ende - /exit, Strg+D, ein fertiger Auftrag.
#     130  Strg+C. 128+SIGINT(2), die Rechnung, mit der jede Schale einen
#          abgebrochenen Vordergrundprozess meldet.
#     143  128+SIGTERM(15) - das Fenster wurde geschlossen oder die
#          Sitzung faehrt herunter. Da ist niemand mehr, der etwas liest.
#
#     Alles andere ist ein Fehlschlag, und ein Fehlschlag hat eine
#     Meldung, die schon auf diesem Bildschirm steht.
case "$rueckgabe" in
    0|130|143) exit "$rueckgabe" ;;
esac

halten "$rueckgabe"
