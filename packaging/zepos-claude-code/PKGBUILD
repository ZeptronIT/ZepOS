# Maintainer: ZeptronIT <https://github.com/ZeptronIT/ZepOS>
#
# Claude Code auf ZepOS - vorinstalliert und aus dem Starter erreichbar.
#
# GEMELDET am 13.08.2026: "kann man claude code auch bei ZepOS immer
# direkt vor installieren direkt zu beginn und beim suchen in dem
# launcher auch claude code anzeigen bei auswahl wird ein terminal
# geoeffnet mit claude code"
#
# WARUM NICHT UEBER npm INSTALL, UND WARUM NICHT AUS DEM AUR
#     Spec 4.3 schliesst das AUR aus, und ein `npm install -g` beim
#     ersten Start waere ein Netzzugriff auf einer frisch installierten
#     Maschine - genau die Sorte Abhaengigkeit, die dieses Projekt aus
#     der Installation herausgehalten hat.
#
#     Das Vorbild steht daneben: packaging/aylurs-gtk-shell holt sich
#     gnim als npm-Tarball von registry.npmjs.org, mit fester Version und
#     Pruefsumme. Genau so wird hier verfahren.
#
# WELCHES TARBALL, UND WARUM NICHT DAS OFFENSICHTLICHE
#     GEMESSEN am 13.08.2026: @anthropic-ai/claude-code 2.1.233 ist nur
#     24606 Bytes gross und enthaelt das Programm NICHT. Es ist ein
#     Nachlader - install.cjs sucht beim Installieren die passende
#     Binaerdatei unter den optionalDependencies und kopiert sie ueber
#     einen Platzhalter. Sein eigener Kopf sagt es:
#
#         "Detects the platform, finds the matching native binary from
#          optionalDependencies, and copies it over the bin/claude.exe
#          placeholder. After this runs, `claude` execs the native binary
#          directly - no Node.js process stays resident."
#
#     Dieses Rezept holt deshalb GLEICH die Binaerdatei:
#     @anthropic-ai/claude-code-linux-x64. Das spart den Umweg, macht den
#     Bau reproduzierbar - eine feste Version, eine Pruefsumme - und
#     erspart dem Paket eine Abhaengigkeit auf nodejs, weil die
#     Binaerdatei laut demselben Kopf ohne Node laeuft.
#
#     x64 und nicht x64-musl: Arch ist glibc.
#
# WAS DAS KOSTET, und die Zahl gehoert hierher statt in eine Ueberraschung
#     Entpackt sind es 324598650 Bytes - rund 310 MiB, laut Registry in
#     vier Dateien. Die Auslieferungs-ISO liegt heute bei 1,23 GB; im
#     SquashFS der ISO wird davon weniger, aber es bleibt der groesste
#     einzelne Zuwachs, den ZepOS je bekommen hat. Wer das nicht will,
#     nimmt den Namen aus zepos-apps depends - der Rest des Systems
#     haengt an keiner Stelle davon ab.
_zepos_repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"

pkgname=zepos-claude-code
pkgver=2.1.233
# pkgrel 2 seit dem 17.08.2026: dieselbe Fassung von Claude Code, aber
# ein anderes Paket - ohne strip (siehe options unten), mit dem Starter
# /usr/bin/zepos-claude-code und einem eigenen Symbol. Ohne diese
# Erhoehung sieht pacman auf einer schon installierten Maschine kein
# Update und laesst das bun-Paket liegen.
#
# pkgrel 3 am selben Tag, und aus demselben Grund: das Zeichen ist jetzt
# das von Claude Code statt eines Roboterarms aus Papirus. Der Inhalt des
# Pakets aendert sich damit (vier PNG mehr, ein anderes Icon= im
# Eintrag), die Version von Claude Code nicht - ohne die Erhoehung
# bekaeme eine installierte Maschine den Roboterarm nie los.
#
# pkgrel 4, immer noch am 17.08.2026: der Eintrag setzt jetzt die
# Fensterklasse (--class und StartupWMClass), damit das Dock das Fenster
# seinem eigenen Eintrag zuordnen kann. Ohne die Erhoehung behielte eine
# installierte Maschine den zweiten Knopf.
pkgrel=4
pkgdesc="Claude Code - der Assistent von Anthropic auf der Kommandozeile"
arch=('x86_64')
url="https://claude.com/claude-code"
license=('LicenseRef-Anthropic-Commercial-Terms')

# !strip - UND DAS IST DER GANZE FEHLER VOM 17.08.2026
#
# GEMELDET: "wenn ich claude im terminal eingeben will kommt claude is a
# fast javascript bla bla und claude selber wird nicht gestartet".
#
# Das ist nicht die Hilfe von Claude Code, das ist die Hilfe von BUN -
# dem Laufzeitsystem, mit dem Claude Code uebersetzt ist. Es lag an
# keinem zweiten `claude` auf dem PATH; das ausgelieferte
# /usr/bin/claude WAR bun.
#
# DIE MESSUNG, in vier Zeilen, alle am 17.08.2026 ausgefuehrt:
#
#     Aus dem Tarball                324598064 Bytes, "not stripped"
#         ./claude --version    ->   2.1.233 (Claude Code)
#     Aus dem gebauten Paket         324542688 Bytes, "stripped"
#         ./claude --version    ->   1.4.0            <- bun
#
#     Und der Beweis, dass genau strip dazwischen liegt: eine Kopie der
#     Tarball-Datei durch `strip --strip-all` gegeben ergibt
#     Byte fuer Byte dieselbe Datei wie die im Paket -
#     sha256 c8530870039bf80b50a7cca258919e47a4c3d05b8e86d34f405bd92c0c176a8c
#     auf beiden Seiten, gegen 55d281096f57d411ebbdd94dbf5e9ff3accb7c05713e37348c2c11d4b83bf9d9
#     davor. 55376 Bytes Unterschied.
#
# WARUM strip DIESE DATEI ZERSTOERT UND NICHT NUR VERKLEINERT
#     Eine mit `bun build --compile` erzeugte Datei ist die
#     bun-Binaerdatei MIT dem uebersetzten Programm daran. Beim Start
#     sieht bun in sich selbst nach, ob dieser Anhang da ist: ist er da,
#     laeuft das Programm; ist er weg, ist die Datei wieder das, was sie
#     vorher war - der blanke bun. strip raeumt aber genau das weg, was
#     zu keinem geladenen Abschnitt gehoert. Aus einem Assistenten wird
#     so ein JavaScript-Laufzeitsystem, ohne eine einzige Fehlermeldung.
#
# WARUM DAS NIEMANDEM AUFGEFALLEN IST
#     makepkg strippt von sich aus - `strip` steht in OPTIONS von Arch'
#     makepkg.conf, und packaging/Dockerfile haengt nur `!debug` an. Der
#     Bau lief also durch, das Paket war da, der Starter-Eintrag war da,
#     und erst wer `claude` TIPPTE, sah den Unterschied. Kein anderes
#     Rezept dieses Projekts braucht die Zeile: sie alle liefern Code
#     aus, den strip nur kleiner macht.
options=('!strip')

# KEINE Abhaengigkeit auf nodejs: die Binaerdatei ist eigenstaendig
# (siehe oben). kitty steht hier, weil der Starter-Eintrag unten es
# NAMENTLICH aufruft - dieselbe Regel wie bei blueman in
# packaging/zepos-desktop: was die ausgelieferte Konfiguration nennt,
# installiert das Paket.
depends=('kitty')

# Die Binaerdatei, direkt aus der Registry. sha512 und nicht sha256,
# weil npm die Pruefsumme in genau dieser Form veroeffentlicht
# (dist.integrity, base64) - so wird sie uebernommen statt nachgerechnet,
# und niemand muss 310 MiB herunterladen, um dieses Rezept zu pruefen.
source=("claude-code-linux-x64-$pkgver.tgz::https://registry.npmjs.org/@anthropic-ai/claude-code-linux-x64/-/claude-code-linux-x64-$pkgver.tgz"
        "zepos-claude-code.desktop"
        "zepos-claude-code"
        "claude-code-48.png"
        "claude-code-64.png"
        "claude-code-128.png"
        "claude-code-256.png")
sha512sums=('b9b315bc1065b24b39344d049ae7042c1da1fd767ae0bf3a26098c05459284b803024aebcc2875cc87f9a97d7e48fb245c09cc7ca0454cc35e693e94aeec5191'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

# DAS ZEICHEN
#
# GEMELDET am 17.08.2026: "ich will das das logo von claude benutzt wird
# statt ein roboter arm". Der Roboterarm war applications-engineering aus
# Papirus-Dark, die Notloesung vom selben Tag.
#
# WARUM DIE DATEIEN HIER LIEGEN UND NICHT AUS DEM TARBALL KOMMEN
#     GEMESSEN: das npm-Paket claude-code-linux-x64 2.1.233 enthaelt vier
#     Eintraege - package/claude, package.json, LICENSE.md, README.md.
#     Keine einzige Grafik. Es gibt im Paket nichts zu entnehmen.
#
#     NACHGESEHEN auf dem Zielsystem: unter /usr/share/icons kennt keines
#     der sieben Themen einen Namen fuer Claude oder Anthropic, und
#     /usr/share/pixmaps ebenso wenig.
#
# WARUM ES NICHT GEZEICHNET, SONDERN GEHOLT WURDE
#     Eine Marke aus dem Gedaechtnis nachzumalen ergibt eine Naeherung,
#     die aussieht wie das Original und keines ist. Die Vorlage ist
#     deshalb das ausgelieferte Programmzeichen selbst:
#
#         https://claude.ai/images/claude_app_icon.png
#         338x338 RGBA, 14038 Bytes
#         sha256 c7b5642f810adfba78781592d9dec18d7eb376c7ebf403c4d882fb9d39f65408
#
#     Eine skalierbare Fassung gibt es dort nicht - die naheliegenden
#     SVG-Adressen (claude.ai/logo.svg, /icon.svg,
#     /images/claude_app_icon.svg) liefern alle dieselbe HTML-Seite der
#     Weboberflaeche, 90325 Bytes, kein SVG. 338 Pixel sind darum die
#     Obergrenze, und deshalb endet die Reihe bei 256 statt bei 512:
#     hochskaliert waere nur unscharf.
#
#     Zugeschnitten wird nichts. `magick -trim` misst 338x338 von
#     338x338 - der Schatten des Zeichens reicht bis an die Kante.
#
# WARUM VORGERECHNETE PNG UND KEIN BAUSCHRITT
#     Die vier Groessen mit ImageMagick beim Bauen zu erzeugen hiesse
#     makedepends=('imagemagick') fuer 41 KiB Bild. Sie liegen deshalb
#     fertig daneben, Lanczos-verkleinert aus derselben Vorlage.
#
# WOHIN SIE GEHEN
#     hicolor, nicht Papirus. hicolor ist der Satz, in den ein Programm
#     sein eigenes Zeichen legt, und aus dem JEDES Thema es holt, wenn es
#     selbst keines hat - genau der Fall hier. Ein Zeichen in Papirus
#     abzulegen hiesse, ein fremdes Thema zu veraendern.
_zeichen_groessen=(48 64 128 256)

package() {
    # Ein npm-Tarball entpackt IMMER nach package/, egal wie das Paket
    # heisst - dieselbe Eigenheit, die aylurs-gtk-shell bei gnim
    # ausnutzt.
    local quelle="$srcdir/package"

    # Die Binaerdatei liegt unter ihrem schlichten Namen; der Nachlader
    # nennt sie in PLATFORMS als `bin: BINARY_NAME` mit BINARY_NAME =
    # 'claude'. Gesucht wird trotzdem, statt den Pfad zu raten: ein
    # Rezept, das an einer geaenderten Ablage still ein leeres Paket
    # baut, ist schlimmer als eines, das abbricht.
    local binaer
    binaer="$(find "$quelle" -maxdepth 2 -type f -name claude | head -1)"
    if [ -z "$binaer" ]; then
        echo "im Tarball liegt keine Datei namens 'claude' - die Ablage" >&2
        echo "des npm-Pakets hat sich geaendert. Ohne sie waere dies ein" >&2
        echo "Paket, das einen Starter-Eintrag ohne Programm mitbringt." >&2
        return 1
    fi

    install -Dm755 "$binaer" "$pkgdir/usr/bin/claude"

    # Das Zwischenstueck zwischen dem Starter-Eintrag und dem Programm.
    # Sein eigener Kopf sagt, warum es das gibt: `kitty -e claude`
    # schliesst das Fenster in dem Augenblick, in dem claude etwas zu
    # sagen hat.
    install -Dm755 "$srcdir/zepos-claude-code" \
        "$pkgdir/usr/bin/zepos-claude-code"

    # Der Starter-Eintrag. Er ist der eigentliche Auftrag: im Starter
    # suchbar, und ein Klick oeffnet ein Terminal mit Claude Code.
    install -Dm644 "$srcdir/zepos-claude-code.desktop" \
        "$pkgdir/usr/share/applications/zepos-claude-code.desktop"

    # Das Zeichen, in den Groessen, die der Starter und das Dock
    # anfordern. Der DATEINAME ist der Symbolname aus dem Eintrag
    # (Icon=zepos-claude-code) - stimmen die beiden nicht ueberein, zeigt
    # der Starter einen leeren Kasten und sagt dazu nichts.
    local groesse
    for groesse in "${_zeichen_groessen[@]}"; do
        install -Dm644 "$srcdir/claude-code-$groesse.png" \
            "$pkgdir/usr/share/icons/hicolor/${groesse}x${groesse}/apps/zepos-claude-code.png"
    done

    # Die Lizenz aus dem Tarball, wenn sie mitkommt.
    if [ -f "$quelle/LICENSE.md" ]; then
        install -Dm644 "$quelle/LICENSE.md" \
            "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
    fi
}
