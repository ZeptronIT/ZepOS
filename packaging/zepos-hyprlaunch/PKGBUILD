# Maintainer: ZeptronIT <https://github.com/ZeptronIT/ZepOS>
#
# hyprlaunch - der Anwendungsstarter auf SUPER+SPACE (Spec §7.1).
#
# WAS AM 11.08.2026 GEAENDERT WURDE UND AM 19.08.2026 WIEDER RUECKGAENGIG
# GEMACHT WURDE: DIE QUELLE LAG KURZ HIER
#     Vom 11.08. bis zum 19.08.2026 lag die Quelle unter plugins/hyprlaunch/
#     in diesem Baum, und dieses Rezept baute daraus - ein Tarball, den
#     packaging/build.sh aus dem ARBEITSBAUM machte. Der Grund war
#     Verfuegbarkeit: ein Konto einer Privatperson, ohne Fork, der es
#     ueberleben wuerde.
#
#     Die Sicherheitspruefung vor der Veroeffentlichung
#     (.superpowers/sdd/2026-08-18-ags-schale-und-breitenleiter/
#     sicherheitsanalyse.md, Abschnitt 6) hat den eigentlichen Fehler daran
#     benannt: der Quellbaum von azzuriel/hyprlaunch traegt KEINE
#     Lizenzdatei und keinen Copyright-Vermerk - die GitHub-API meldet
#     "license": null. Code ohne Lizenz ist urheberrechtlich "alle Rechte
#     vorbehalten". Leon Marzolls Erlaubnis vom 11.08.2026 (plugins/LICENSE)
#     deckt, dass ZepOS diese Quellen bauen und veraendern darf - er ist
#     selbst Contributor an denselben Baeumen. Sie deckt NICHT, dass ZepOS
#     eine KOPIE des fremden Quellbaums selbst weiterverbreitet: eine
#     Erlaubnis gilt dem, dem sie erteilt wurde, und dieses Repository
#     oeffentlich zu machen haette genau das getan.
#
#     Der Nutzer hat am 19.08.2026 entschieden: die Quellen werden nicht
#     mitveroeffentlicht. Dieses Rezept holt sie beim Bauen direkt aus dem
#     Repository des Urhebers, wie es bei einem AUR-Paket ueblich ist -
#     festgenagelt auf den Commit, der schon in plugins/LICENSE als der
#     uebernommene Stand steht, geprueft mit einer Pruefsumme, NICHT auf
#     `main`: ein Bau, der von einem beweglichen Zweig holt, ist nicht
#     reproduzierbar. Damit verbreitet ZepOS fremden Code nicht selbst
#     weiter, und das gebaute Paket - das Objekt, das dieses Rezept
#     ausliefert - aendert sich dadurch nicht.
#
#     Was daran offen bleibt, weil es keine Textfrage ist: dasselbe
#     Verfuegbarkeitsrisiko wie vor dem 11.08.2026 gilt wieder. Verschwindet
#     azzuriel/hyprlaunch, laesst sich dieses Paket nicht mehr bauen, bis
#     jemand den Tarball von Hand woanders ablegt und dieses Rezept darauf
#     zeigt.
#
# WAS AN DER UEBERNOMMENEN QUELLE GEAENDERT WIRD, UND WOMIT
#     Das Aussehen. 116 Zeilen CSS standen als `static const char*` im
#     uebersetzten Objekt, mit zwanzig Farbliteralen in zehn Toenen -
#     kein einziger davon aus src/brand.py, und der Schreibtisch ist
#     petrolfarben. Die drei Fenstermasse standen als `static constexpr`
#     daneben, wo der Regler aus src/sizes.py sie nicht erreichen
#     konnte. Beides kommt jetzt aus erzeugten Dateien in
#     ~/.config/hyprlaunch/.
#
#     Diese Aenderungen liegen nicht mehr als bearbeitete Dateien in
#     diesem Baum - aus demselben Grund, aus dem die unveraenderte Quelle
#     nicht mehr hier liegt: eine bearbeitete Kopie fremden Codes ist
#     immer noch eine Kopie. Sie liegen als zepos-hyprlaunch.patch neben
#     diesem Rezept, ZepOS' eigenes Diff und keine fremde Quelle,
#     angewendet in prepare(). Die einzelnen Messungen stehen in den
#     Kopfzeilen des Patches selbst und in den Kommentaren, die er in die
#     betroffenen Dateien schreibt.
#
# DIE LIZENZ, UND WARUM SIE ALS DATEI MITKOMMT
#     BSD-3-Clause erlaubt genau das hier - uebernehmen, aendern,
#     weitergeben - unter der Bedingung, dass Urhebervermerk und
#     Haftungsausschluss erhalten bleiben. Upstream hatte beides nicht:
#     die Lizenz steht dort in einer Zeile der README und in keiner
#     Datei. Ein Vermerk, den es nicht gibt, laesst sich nicht erhalten,
#     also ist er in plugins/LICENSE zum ersten Mal ausgeschrieben, aus
#     dem, was nachpruefbar ist. Dieses Rezept legt ihn unter
#     /usr/share/licenses ab, direkt aus diesem Baum statt aus dem
#     heruntergeladenen Tarball - der traegt keine LICENSE-Datei, aus der
#     package() sie kopieren koennte.
#
# WARUM DAS PAKET ZWEI DATEIEN LEGT UND NICHT EINE
#     Spec §4.2 sagt, ein Plugin-Paket legt genau eine Datei ab, das
#     Objekt unter /usr/lib/hyprland/plugins/<name>.so, und dieser Satz
#     ist ueber den Pfad recht, den src/plugins.py prueft. hyprlaunch
#     ist trotzdem absichtlich zweigeteilt: das Plugin enthaelt kein GTK
#     und keine Threads, und das Fenster ist ein eigener
#     Layer-Shell-Prozess, den das Plugin mit
#
#         execlp("hyprlaunch-ui", "hyprlaunch-ui", arg, nullptr)   Globals.cpp
#
#     startet. execlp sucht in PATH, also muss /usr/bin/hyprlaunch-ui
#     existieren. Ein Paket, das nur das Objekt auslieferte, gaebe einen
#     Desktop, dessen SUPER+SPACE ein Plugin laedt, einen Dispatcher
#     registriert, forkt und scheitert - und §7.4 hat einige Muehe
#     darauf verwendet, dass diese Taste nie tot ist. Ein Paket, weil
#     die zwei Haelften ein Programm sind: ein CMake-Projekt, ein
#     gemeinsames ConfigParser.cpp.
#
# WAS DIE DREI zepos-hyprland-ABHAENGIGKEITEN SOLLEN
#     packaging/zepos-hyprzones/PKGBUILD fuehrt es aus: die
#     Versionsspanne ist Spec §7.3 und sieht einen Rebuild nicht, das
#     ABI-Kuerzel sieht ihn, und Hyprlands eigene Ladeprüfung vergleicht
#     die Zeichenkette "0.1" und sieht gar nichts.
_zepos_repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"

# Der Stand, den plugins/LICENSE als uebernommen nennt - hier wiederholt,
# weil das Bauen ihn braucht, nicht weil er anderswo unbekannt waere.
_commit=24e5c8b82f96f87ac25000353e36a8b17ced4b00

pkgname=zepos-hyprlaunch
pkgver="$(<"$_zepos_repo/VERSION")"
pkgrel=1
pkgdesc="Der Anwendungsstarter von ZepOS: ein GTK4-Layer-Shell-Fenster und sein Hyprland-Plugin"
arch=('x86_64')
url="https://github.com/azzuriel/hyprlaunch"
# Gemessen am 11.08.2026: der Quellbaum traegt KEINE Lizenzdatei und
# keinen Copyright-Vermerk, die GitHub-API meldet "license": null. Hier
# stand trotzdem BSD-3-Clause - vermutlich mitgewandert von den Plugins
# des Hyprland-Projekts, die wirklich so lizenziert sind.
#
# 'custom' beschreibt die Lage, statt eine Lizenz zu behaupten: Leon
# Marzoll hat am 11.08.2026 erklaert, dass ZepOS die Quellen verwenden
# und veraendern darf. Eine Erlaubnis gilt dem, dem sie erteilt wurde -
# was ein NUTZER von ZepOS mit diesem Code darf, steht damit nirgends.
# plugins/LICENSE haelt das fest und nennt das eine, was die Luecke
# schliesst: eine Lizenzdatei im Repositorium des Urhebers.
license=('custom')

# Das ABI-Kuerzel, das zepos-hyprland veroeffentlicht, aus der Datei
# gelesen, die jenes Paket installiert. packaging/zepos-hyprzones/
# PKGBUILD hat die Gruende vollstaendig: gelesen werden muss es hier
# statt in package(), weil makepkg diese Felder auch ausserhalb der
# Paketfunktionen auswertet und dann mit nichts gesetzt, und der
# Rueckfall unten ist eine Zeichenkette, die kein Paket bereitstellt,
# damit ein Bau ohne zepos-hyprland anhaelt statt zu raten.
_abi_file="/usr/lib/hyprland/plugin-abi"
_abi="$(cat "$_abi_file" 2>/dev/null || true)"
: "${_abi:=zepos.hyprland.absent}"

# gtk4 und gtk4-layer-shell gehoeren der UI-Haelfte und nicht dem
# Plugin - das Objekt linkt gegen keins von beiden, und genau das ist
# der Sinn der Teilung.
#
# Die drei Schriften stehen hier aus demselben Grund wie bei
# zepos-menu: das erzeugte Stylesheet nennt die Familien aus
# src/brand.py, und fontconfig beantwortet eine fehlende Familie durch
# Ersatz. Das faellt nicht auf - es rendert nur in irgendetwas anderem.
# adwaita-icon-theme traegt die Symbole fuer .desktop-Dateien, deren
# eigenes Symbol das Thema nicht hat.
#
# json-glib SEIT DEM 21.08.2026, UND NUR DIE UI-HAELFTE BRAUCHT ES
#     Das Rechtsklick-Menue heftet eine Anwendung an den Fuss. Die
#     Anheftungsliste ist eine ERSATZliste, also heisst anheften: lesen,
#     anhaengen, ganz zurueckschreiben - und gelesen wird die Antwort
#     von `zepos-settings-gui --json get`, GEMESSEN 46231 Bytes, mit
#     `.effective` drei Ebenen tief darin.
#
#     Von Hand aus dem Text geklaubt braeche dieser Leser still, sobald
#     die Bruecke ein Feld ergaenzt. json-glib ist klein, gehoert zum
#     GNOME-Kern und liegt in [extra]; hyprlaunch-ui linkt GLib und GIO
#     ohnehin schon. GEMESSEN am 21.08.2026 am gebauten Objekt:
#
#         readelf -d hyprlaunch-ui | grep json  ->  libjson-glib-1.0.so.0
#         readelf -d hyprlaunch.so  | grep json ->  (nichts)
#
#     Die zweite Zeile ist der Punkt: src/ConfigParser.cpp steht in
#     BEIDEN Zielen, aber CMakeLists.txt haengt json-glib allein an
#     hyprlaunch-ui. Das Objekt, das IN den Compositor geladen wird,
#     bekommt keine Bibliothek dazu - dieselbe Trennung, die package()
#     unten fuer GTK schon prueft.
#
# zepos-settings-gui steht NICHT hier, sondern unter optdepends. Es ist
# der Befehl, den das Menue ruft, und ohne ihn bietet der Starter den
# Menuepunkt gar nicht erst an (LauncherRenderer::entryMenu prueft, ob
# die Bruecke geantwortet hat). Eine harte Abhaengigkeit waere ausserdem
# der Zyklus, den der Absatz unten schon fuer zepos-config beschreibt.
depends=('zepos-hyprland>=0.56.1' 'zepos-hyprland<0.57.0'
         "hyprland-plugin-abi=$_abi"
         'gtk4' 'gtk4-layer-shell' 'glib2' 'json-glib'
         'glibc' 'libgcc' 'libstdc++'
         'ttf-fira-code' 'ttf-jetbrains-mono-nerd' 'adwaita-icon-theme')
makedepends=('cmake' 'ninja' 'zepos-hyprland' 'json-glib')

# zepos-config erzeugt ~/.config/hyprlaunch/config und style.css. Ohne
# sie oeffnet der Starter trotzdem - in Full-HD-Groessen und
# ungestylt -, und er sagt auf stderr, welcher Befehl die Dateien
# schreibt. Deshalb eine Empfehlung und keine Abhaengigkeit: zwei
# Pakete, die einander nennen, sind ein Zyklus, den pacman zwar
# aufloest und den niemand lesen kann.
optdepends=('zepos-config: erzeugt config und style.css, ohne die der Starter ungestylt bleibt'
            'zepos-settings-gui: fuehrt die Anheftungen des Docks; ohne ihn bleibt das Rechtsklick-Menue leer')

# Zwei Quellen: der unveraenderte Baum des Urhebers, auf den Commit
# festgenagelt, den plugins/LICENSE als uebernommen nennt - und ZepOS'
# eigenes Diff darauf, das neben diesem Rezept liegt. NICHT `main`: ein
# Bau, der von einem beweglichen Zweig holt, ist nicht reproduzierbar.
source=("hyprlaunch-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        "zepos-hyprlaunch.patch")
sha256sums=('9e79a3a77b77214d60d9f3129362c8bb264a772b8946e3a53dc3be8cca576e75'
            'a8483d64a946fcaf2ef74c8a8d41eb6f016e0a3f48b607ebd97f56f544e35bef')

_src="hyprlaunch-$_commit"
_plugin_dir="usr/lib/hyprland/plugins"

prepare() {
    cd "$srcdir/$_src"
    patch -p1 < "$srcdir/zepos-hyprlaunch.patch"
}

build() {
    cd "$srcdir/$_src"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_RPATH=ON
    cmake --build build --config Release
}

package() {
    cd "$srcdir/$_src"
    DESTDIR="$pkgdir" cmake --install build

    test -f "$pkgdir/$_plugin_dir/hyprlaunch.so" || {
        echo "das Plugin-Objekt liegt nicht unter /$_plugin_dir/hyprlaunch.so;" >&2
        echo "src/plugins.py wuerde dieses Plugin wortlos fallen lassen" >&2
        return 1
    }

    # Die Haelfte, die der Dispatcher forkt. Geprueft aus demselben
    # Grund: das Versagen ist eine Taste, die nichts tut, ohne eine
    # Zeile in irgendeinem Protokoll.
    local ui="$pkgdir/usr/bin/hyprlaunch-ui"
    test -x "$ui" || {
        echo "hyprlaunch-ui liegt nicht in /usr/bin; das execlp des" >&2
        echo "Plugins faende nichts und SUPER+SPACE waere eine tote Taste" >&2
        return 1
    }

    # ZWEI WERKZEUGE, WEIL ES ZWEI VERSCHIEDENE FRAGEN SIND
    #
    #     readelf -d   was DIESES Objekt selbst angefordert hat
    #     ldd          was beim Start tatsaechlich alles geladen wird
    #
    # Wortgleich zu packaging/zepos-lock/PKGBUILD (und, bis zu seiner
    # Loeschung mit dem Programm, packaging/zepos-logout/PKGBUILD -
    # Aufgabe 26, 19.08.2026): fuer "steht es auf GTK4" ist readelf
    # richtig, fuer "kommt GTK3 durch eine Seitentuer" ist es FALSCH.
    # Arch setzt -Wl,--as-needed, also traegt der Linker kein
    # DT_NEEDED fuer eine Bibliothek ein, aus der kein Symbol benutzt
    # wird; die Gefahr ist ohnehin die Bibliothek, die IHRERSEITS GTK3
    # mitbringt, und die sieht nur ldd.
    #
    # GEMESSEN am 11.08.2026 an genau diesem Objekt, lokal gebaut:
    #     objdump -p hyprlaunch-ui | grep NEEDED | grep gtk
    #       NEEDED  libgtk-4.so.1
    #       NEEDED  libgtk4-layer-shell.so.0
    #     ldd hyprlaunch-ui | grep -c libgtk-3   ->  0
    local needed
    needed="$(readelf -d "$ui")"

    grep -q "libgtk-4" <<<"$needed" || {
        echo "hyprlaunch-ui ist nicht gegen GTK4 gelinkt." >&2
        echo "Die Entscheidung vom 11.08.2026 stellt die Oberflaeche" >&2
        echo "durchgehend auf GTK4." >&2
        return 1
    }
    grep -q "gtk4-layer-shell" <<<"$needed" || {
        echo "hyprlaunch-ui wurde ohne gtk4-layer-shell gebaut." >&2
        echo "Das Fenster waere dann ein gewoehnliches Fenster, das der" >&2
        echo "Compositor platziert und dem er den Fokus nimmt - ein" >&2
        echo "Starter, der beim Tippen den Fokus verliert." >&2
        return 1
    }

    local loaded
    loaded="$(ldd "$ui")"
    if grep -q "libgtk-3" <<<"$loaded"; then
        echo "hyprlaunch-ui laedt libgtk-3:" >&2
        grep "libgtk-3" <<<"$loaded" >&2
        echo "Ein Programm, das beide Toolkits laedt, beantwortet die" >&2
        echo "GTK4-Frage mit ja und zeigt trotzdem GTK3." >&2
        return 1
    fi

    # Und die Gegenprobe zur Teilung: das Plugin-Objekt darf GAR KEIN
    # GTK anfordern. Es wird in den Compositor geladen, und eine
    # zweite GTK-Hauptschleife im Compositor-Prozess ist der Grund,
    # aus dem upstream ueberhaupt geteilt hat.
    if readelf -d "$pkgdir/$_plugin_dir/hyprlaunch.so" | grep -q "libgtk"; then
        echo "das Plugin-Objekt linkt gegen GTK. Es wird IN den" >&2
        echo "Compositor geladen; die Teilung in Plugin und" >&2
        echo "Fensterprozess ist genau dafuer da." >&2
        return 1
    fi

    # DASSELBE FUER json-glib, seit dem 21.08.2026.
    #
    # Die Bibliothek kam mit dem Rechtsklick-Menue dazu, und sie
    # gehoert dem Fenster: es liest damit die Antwort von
    # zepos-settings-gui. Das Plugin ruft die Bruecke nicht - es liest
    # die Konfigurationsdatei und registriert Dispatcher.
    #
    # Die Falle, gegen die das hier steht: src/ConfigParser.cpp steht in
    # BEIDEN Zielen. Wer json-glib eines Tages in jene Datei zieht statt
    # in AppDiscovery.cpp, haengt sie wortlos auch dem Objekt im
    # Compositor an - und `-Wl,--as-needed` verhindert das nicht, sobald
    # wirklich ein Symbol benutzt wird.
    if readelf -d "$pkgdir/$_plugin_dir/hyprlaunch.so" | grep -q "json-glib"; then
        echo "das Plugin-Objekt linkt gegen json-glib. Es liest die" >&2
        echo "Konfigurationsdatei und ruft keine Bruecke; die" >&2
        echo "Bibliothek gehoert allein hyprlaunch-ui." >&2
        return 1
    fi

    # Und die Gegenprobe: das FENSTER muss sie haben. Ohne sie liesse
    # sich die Anheftungsliste nicht lesen, und das Rechtsklick-Menue
    # bliebe wortlos leer - ein Rechtsklick, der nichts tut, ist genau
    # die Sorte Versagen ohne Protokollzeile, gegen die die Pruefungen
    # hier alle stehen.
    grep -q "json-glib" <<<"$needed" || {
        echo "hyprlaunch-ui wurde ohne json-glib gebaut. Das" >&2
        echo "Rechtsklick-Menue koennte die Anheftungen des Docks" >&2
        echo "nicht lesen und bliebe leer." >&2
        return 1
    }

    # Erneut gelesen, nach dem Uebersetzen: ein `pacman -Syu` zwischen
    # dem Einlesen dieser Datei und jetzt hinterliesse ein Objekt, das
    # gegen den einen Headersatz uebersetzt ist und eine Abhaengigkeit
    # auf einen anderen traegt.
    [[ -f "$_abi_file" && "$(<"$_abi_file")" == "$_abi" ]] || {
        echo "das ABI des Compositors ist nicht das, das dieser Bau" >&2
        echo "angemeldet hat:" >&2
        echo "  angemeldet: $_abi" >&2
        echo "  installiert: $(cat "$_abi_file" 2>/dev/null || echo '<kein zepos-hyprland>')" >&2
        return 1
    }

    # plugins/LICENSE liegt in diesem Baum, nicht im heruntergeladenen
    # Tarball - der traegt keine LICENSE-Datei, weil upstream keine
    # hat (siehe oben).
    install -Dm644 "$_zepos_repo/plugins/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
