+// ============================================================================
+// Der Fuss und das Home (21.08.2026)
+// ============================================================================
+//
+// WARUM DIESES PROGRAMM UEBERHAUPT IN DIE EINSTELLUNGEN SCHREIBT
+//     Weil der Nutzer es bestellt hat: "was das menue angeht bei
+//     rechtsklick will ich das wir das am besten auslagern auf das
+//     aktuelle". Ein Rechtsklick auf eine Trefferzeile heftet die
+//     Anwendung an den Fuss oder legt sie aufs Home. Beide Listen liest
+//     die Oberflaeche aus derselben Datei, also gibt es nichts zu
+//     verabreden - nur denselben Befehl zu rufen.
+//
+// WARUM settings.py UND NICHT MEHR zepos-settings-gui --json (21.08.2026)
+//     Hier stand bis zum 21.08.2026 ein Leser, der `--json get`
+//     aufrief, sich durch pages[] -> controls[] -> effective[] hangelte,
+//     die Liste ANHAENGTE und mit `--json set` ganz zurueckschrieb.
+//     Genau dasselbe stand im Fuss (ags-dock.template) - und dem Home
+//     fehlte "Zum Dock hinzufuegen" ausdruecklich deshalb, weil es die
+//     DRITTE Abschrift gebraucht haette.
+//
+//     Abgeschrieben waeren dabei nicht die sechs Zeilen Aufruf, sondern
+//     die REGEL: bar.dock_pins ist eine ERSATZliste, also muss jeder
+//     Schreiber ZUERST lesen und bei einem fehlgeschlagenen Lesevorgang
+//     GAR NICHTS schreiben. Wer das einmal vergisst, loescht dem Nutzer
+//     jedes Symbol, das er je angeheftet hat.
+//
+//     `python3 <settings.py> dock add <name>` tut das Lesen, Rechnen
+//     und Schreiben in EINEM Prozess. Dieses Programm kann den
+//     Lesevorgang damit nicht mehr vergessen, weil es ihn nicht mehr
+//     macht. Gelesen wird hier nur noch fuer die ANZEIGE - in welche
+//     Richtung der Menuepunkt zeigt.
+//
+//     Die Antwort ist dabei nebenbei um drei Groessenordnungen
+//     kleiner geworden: GEMESSEN am 21.08.2026 antwortete
+//     `zepos-settings-gui --json get` mit 46231 Bytes, `settings.py
+//     dock` mit 122.
+//
+// WARUM g_spawn_sync UND NICHT popen WIE BEIM RECHNER
+//     evaluateCalculator() weiter oben braucht eine SHELL, weil es eine
+//     Pipeline absetzt (`echo ... | bc`). Hier gibt es keine Pipeline,
+//     und eine Shell waere ein Zitierproblem, das man nicht haben muss:
+//     die Namen kommen aus fremden .desktop-Dateien, und ein
+//     Anfuehrungszeichen darin waere in einer Kommandozeile eine
+//     Luecke. g_spawn_sync nimmt ein argv-Feld - da gibt es nichts zu
+//     zitieren, weil nichts geparst wird.
+//
+// WARUM SYNCHRON, UND WAS DAS KOSTET
+//     GEMESSEN am 21.08.2026, sieben Laeufe je Befehl auf dieser
+//     Maschine:
+//
+//         python3 settings.py dock   36 ms Median
+//         python3 settings.py home   34 ms Median
+//
+//     Zwei Aufrufe zwischen Rechtsklick und Menue sind rund 70 ms und
+//     damit an der Grenze dessen, was als Warten gelesen wird. Ein
+//     asynchroner Weg haette dafuer ein Menue gebraucht, das sich nach
+//     dem Aufklappen noch aendert - also einen Punkt, der erst "Zum
+//     Dock hinzufuegen" heisst und dann etwas anderes. Das ist
+//     schlechter als 70 ms.
+
+namespace {
+
+// Der Interpreter. Ein NAME und kein Pfad: welches python3 gilt,
+// entscheidet der PATH der Sitzung, und derselbe Name steht in
+// ags-user-settings.template. Der PFAD, der wirklich variabel ist -
+// der zu settings.py -, kommt aus der erzeugten Datei (Config.hpp).
+constexpr const char* PYTHON = "python3";
+
+/** Ein Aufruf von settings.py. false heisst: es ist gar nicht gelaufen.
+ *
+ * DER RUECKGABEWERT WIRD HIER GEPRUEFT, ANDERS ALS BEI DER BRUECKE
+ *     `zepos-settings-gui` endete mit 1, WENN es eine Aenderung
+ *     ablehnte, und legte seine Klage dabei auf STDOUT - unterschieden
+ *     wurde deshalb an `ok` im Dokument. settings.py macht es
+ *     andersherum und wie jedes andere Programm: 0 heisst getan, 1
+ *     heisst "die Datei ist nicht zu lesen, es wurde nichts geaendert",
+ *     2 heisst "das Argument taugt nicht", und die Klage steht auf
+ *     STDERR. Ein Aufrufer, der den Wert uebergeht, uebersieht genau
+ *     die Faelle, in denen nichts geschrieben wurde.
+ */
+bool callSettings(const std::string& script,
+                  const std::vector<std::string>& args,
+                  std::string& answer, std::string& failure) {
+    if (script.empty()) {
+        // EIN Literal, nicht zwei aneinandergesetzte - der Grund
+        // steht bei derselben Aenderung in LauncherRenderer.cpp.
+        failure = _("no path to settings.py (settings_script is missing from ~/.config/hyprlaunch/config)");
+        return false;
+    }
+
+    std::vector<char*> argv;
+    argv.push_back(const_cast<char*>(PYTHON));
+    argv.push_back(const_cast<char*>(script.c_str()));
+    for (const std::string& arg : args)
+        argv.push_back(const_cast<char*>(arg.c_str()));
+    argv.push_back(nullptr);
+
+    gchar* out = nullptr;
+    gchar* err = nullptr;
+    gint status = 0;
+    GError* error = nullptr;
+
+    const gboolean started = g_spawn_sync(
+        nullptr, argv.data(), nullptr,
+        static_cast<GSpawnFlags>(G_SPAWN_SEARCH_PATH),
+        nullptr, nullptr, &out, &err, &status, &error);
+
+    if (!started) {
+        if (error && error->message) {
+            failure = error->message;
+        } else {
+            // EIN FORMAT UND KEINE VERKETTUNG, seit dem 02.09.2026.
+            // Vorher stand der Name des Programms vorn und der Satz
+            // dahinter (`std::string(PYTHON) + " liess sich nicht
+            // starten"`); eine Sprache, die ihn woanders braucht,
+            // koennte ihn nicht dorthin schieben. Dieselbe Regel, aus
+            // der format() in src/templates/ags-i18n.template
+            // ueberhaupt entstanden ist.
+            //
+            // g_autofree, weil g_strdup_printf ALLOZIERT: der Wert
+            // wandert in ein std::string, und ohne diese Angabe waere
+            // jeder fehlgeschlagene Start ein verlorener Block.
+            g_autofree char* text =
+                g_strdup_printf(_("%s could not be started"), PYTHON);
+            failure = text;
+        }
+        if (error) g_error_free(error);
+        return false;
+    }
+
+    answer = out ? out : "";
+    failure = err ? err : "";
+    g_free(out);
+    g_free(err);
+
+    if (!g_spawn_check_wait_status(status, &error)) {
+        if (failure.empty() && error && error->message)
+            failure = error->message;
+        if (error) g_error_free(error);
+        return false;
+    }
+    return true;
+}
+
+/** Ein Feld der Antwort als Namensliste, oder nichts.
+ *
+ * Zwei Formen, ein Leser: `settings.py dock` antwortet mit
+ * {"pins": ["firefox", ...]}, `settings.py home` mit
+ * {"icons": [{"name": "firefox", "col": 0, "row": 0}, ...]} - eine
+ * Zeichenkette hier, ein Objekt dort. Beide Male sind es NAMEN, und
+ * zwei Leser dafuer waeren zwei Stellen, an denen dieselbe Liste
+ * verschieden gelesen wird.
+ *
+ * Jede Ebene wird EINZELN geprueft. Ein json_object_get_array_member()
+ * auf ein fehlendes Feld ist in json-glib kein Fehler, den man
+ * abfragt - es gibt nullptr zurueck, und der naechste Zugriff darauf
+ * ist ein Absturz. Der Starter darf an einer Einstellungsdatei nicht
+ * sterben.
+ */
+std::optional<std::vector<std::string>> namenAus(const std::string& text,
+                                                 const char* feld) {
+    if (text.empty())
+        return std::nullopt;
+
+    JsonParser* parser = json_parser_new();
+    GError* error = nullptr;
+    if (!json_parser_load_from_data(parser, text.c_str(),
+                                    static_cast<gssize>(text.size()), &error)) {
+        // Kein JSON heisst: der Befehl ist abgestuerzt oder hat etwas
+        // ganz anderes geschrieben. Beides ist "nicht geantwortet".
+        if (error) g_error_free(error);
+        g_object_unref(parser);
+        return std::nullopt;
+    }
+
+    std::optional<std::vector<std::string>> found;
+    JsonNode* root = json_parser_get_root(parser);
+
+    if (root && JSON_NODE_HOLDS_OBJECT(root)) {
+        JsonObject* top = json_node_get_object(root);
+        if (json_object_has_member(top, feld)) {
+            JsonNode* node = json_object_get_member(top, feld);
+            if (node && JSON_NODE_HOLDS_ARRAY(node)) {
+                JsonArray* liste = json_node_get_array(node);
+                std::vector<std::string> names;
+                const guint anzahl = liste ? json_array_get_length(liste) : 0;
+                for (guint i = 0; i < anzahl; i++) {
+                    JsonNode* eintrag = json_array_get_element(liste, i);
+                    if (!eintrag) continue;
+                    if (JSON_NODE_HOLDS_VALUE(eintrag)) {
+                        const char* name = json_node_get_string(eintrag);
+                        if (name) names.push_back(name);
+                    } else if (JSON_NODE_HOLDS_OBJECT(eintrag)) {
+                        JsonObject* objekt = json_node_get_object(eintrag);
+                        if (objekt && json_object_has_member(objekt, "name")) {
+                            const char* name =
+                                json_object_get_string_member(objekt, "name");
+                            if (name) names.push_back(name);
+                        }
+                    }
+                }
+                // Auch die LEERE Liste ist eine Antwort - siehe die
+                // Begruendung des Rueckgabetyps im Header.
+                found = names;
+            }
+        }
+    }
+
+    g_object_unref(parser);
+    return found;
+}
+
+/** Eine Aenderung absetzen. Leer zurueck heisst: geschrieben.
+ *
+ * Die Vorgabe, gegen die der Nutzer entschieden hat (dock_baseline,
+ * home.baseline), schreibt settings.py SELBST mit - wer sie von hier
+ * aus mitschickte, ueberschriebe genau die Liste, an der spaeter
+ * haengt, ob eine neu ausgelieferte Anwendung erscheinen darf
+ * (src/settings.py, BAR_BASELINE, fuehrt den ganzen Fall aus).
+ */
+std::vector<std::string> aendere(const std::string& script,
+                                 const std::string& bereich,
+                                 const std::string& richtung,
+                                 const std::string& desktopId) {
+    const std::string name = AppDiscovery::pinName(desktopId);
+    if (name.empty())
+        return {_("the entry carries no identifier")};
+
+    std::string answer;
+    std::string failure;
+    if (!callSettings(script, {bereich, richtung, name}, answer, failure))
+        return {failure.empty() ? _("settings.py did not answer") : failure};
+    return {};
+}
+
+} // namespace
+
+std::string AppDiscovery::pinName(const std::string& desktopId) {
+    static const std::string suffix = ".desktop";
+    if (desktopId.size() > suffix.size() &&
+        desktopId.compare(desktopId.size() - suffix.size(),
+                          suffix.size(), suffix) == 0) {
+        return desktopId.substr(0, desktopId.size() - suffix.size());
+    }
+    return desktopId;
+}
+
+std::optional<std::vector<std::string>> AppDiscovery::dockPins(
+        const std::string& script) {
+    std::string answer;
+    std::string failure;
+    if (!callSettings(script, {"dock"}, answer, failure))
+        return std::nullopt;
+    return namenAus(answer, "pins");
+}
+
+std::optional<std::vector<std::string>> AppDiscovery::homeNames(
+        const std::string& script) {
+    std::string answer;
+    std::string failure;
+    if (!callSettings(script, {"home"}, answer, failure))
+        return std::nullopt;
+    return namenAus(answer, "icons");
+}
+
+std::vector<std::string> AppDiscovery::pinToDock(const std::string& script,
+                                                 const std::string& desktopId) {
+    return aendere(script, "dock", "add", desktopId);
+}
+
+std::vector<std::string> AppDiscovery::unpinFromDock(
+        const std::string& script, const std::string& desktopId) {
+    return aendere(script, "dock", "remove", desktopId);
+}
+
+std::vector<std::string> AppDiscovery::addToHome(const std::string& script,
+                                                 const std::string& desktopId) {
+    return aendere(script, "home", "add", desktopId);
+}
+
+std::vector<std::string> AppDiscovery::removeFromHome(
+        const std::string& script, const std::string& desktopId) {
+    return aendere(script, "home", "remove", desktopId);
+}
+
