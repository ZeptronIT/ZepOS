+#ifndef GETTEXT_PACKAGE
+#define GETTEXT_PACKAGE "zepos-desktop"
+#endif
+#ifndef ZEPOS_LOCALEDIR
+#define ZEPOS_LOCALEDIR "/usr/share/locale"
+#endif
+
+// Der Aufruf, der im Quelltext steht.
+//
+// GENAU DIESE SCHREIBWEISE, `_("...")`, und keine andere: po/desktop/
