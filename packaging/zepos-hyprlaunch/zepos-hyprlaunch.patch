+#pragma once
+
+#include <clocale>
+#include <libintl.h>
+
+// DIE ZWEI ANGABEN HABEN EINEN RUECKFALL, UND DAS IST GEMESSEN
+//     Gesetzt werden sie von CMakeLists.txt
+//     (target_compile_definitions am Ziel hyprlaunch-ui). Ein Kopf, der
