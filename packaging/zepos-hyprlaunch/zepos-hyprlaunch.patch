+//     Weil dieses Programm dort schon meldet: loadStyleSheet() oben
+//     schreibt zwei Meldungen genau hierhin, mit demselben Vorsatz
+//     "hyprlaunch-ui: ", und begruendet es an seiner Stelle ("sonst ist
+//     ein ungestylter Starter ein Zustand ohne Erklaerung"). Ein
+//     dritter Kanal fuer dieselbe Sorte Auskunft waere ein dritter Ort
+//     zum Nachsehen.
+//
+//     Was das NICHT ist: eine Meldung auf dem Schirm. Der Mensch, der
+//     gerade geklickt hat, sieht sie nicht - sie landet im Protokoll
+//     von Hyprland, wo der steht, der den Fehler sucht. Das ist der
+//     kleinste Schritt, der die vier Meldungen von TOT auf LEBENDIG
+//     bringt, und er ist bewusst nicht mehr: ein Hinweisfenster im
+//     Starter ist eine Entscheidung ueber die Oberflaeche und gehoert
+//     in einen eigenen Auftrag.
+//
+// WARUM SIE DAMIT IN DEN KATALOG DUERFEN
+//     Weil sie jetzt erscheinen koennen. Ein toter Text, der uebersetzt
+//     wird, sieht in jeder spaeteren Zaehlung aus wie gepflegte Arbeit
+//     und ist keine.
+static void klageMelden(const std::vector<std::string>& klagen) {
+    for (const std::string& klage : klagen)
+        g_printerr("hyprlaunch-ui: %s\n", klage.c_str());
+}
+
+void LauncherRenderer::refreshLists() {
+    const std::string& script = m_config.settingsScript;
+    const auto pins = AppDiscovery::dockPins(script);
+    const auto home = AppDiscovery::homeNames(script);
+    // BEIDE oder KEINE. Antwortet nur eine der zwei Fragen, ist der
+    // Zustand halb bekannt - und ein Menue, das den einen Punkt zeigt
+    // und den anderen weglaesst, sieht aus wie eine Entscheidung, ist
+    // aber ein Fehlschlag.
+    m_listsKnown = pins.has_value() && home.has_value();
+    m_pins = pins ? *pins : std::vector<std::string>{};
+    m_home = home ? *home : std::vector<std::string>{};
+}
+
+std::vector<MenuEntry> LauncherRenderer::entryMenu(const AppEntry& entry) {
+    // Die Hilfsskripte haben keinen Anwendungseintrag, also gibt es
+    // nichts anzuheften und nichts abzulegen - der Fuss und das Home
+    // loesen Namen ueber GioUnix.DesktopAppInfo auf, und ein
+    // Shell-Skript ist keiner. LEER heisst hier: es klappt gar kein
+    // Menue auf. Ein Menue mit einem Punkt, der nichts tun kann, waere
+    // schlechter als keines.
+    if (m_mode != LauncherMode::Apps || entry.id.empty())
+        return {};
+
+    // Bei JEDEM Rechtsklick frisch gelesen und nicht einmal beim
+    // Aufgehen: die Listen koennen sich waehrend das Fenster offensteht
+    // aendern - im Fuss, auf dem Home, im Einstellungsfenster, in einem
+    // zweiten Starter. Ein Menue, das "Zum Dock hinzufuegen" anbietet,
+    // waehrend das Symbol schon unten steht, ist genau die Sorte Punkt,
+    // die nichts tut. GEMESSEN: 36 und 34 ms (siehe AppDiscovery.cpp).
+    refreshLists();
+
+    // Hat settings.py nicht geantwortet, wird NICHTS angeboten. Ein
+    // Punkt zeigte dann in eine geratene Richtung - "Zum Dock
+    // hinzufuegen" fuer etwas, das schon dort steht -, und das ist
+    // schlimmer als ein Rechtsklick, der nichts aufklappt.
+    if (!m_listsKnown)
+        return {};
+
+    const std::string name = AppDiscovery::pinName(entry.id);
+    const bool pinned =
+        std::find(m_pins.begin(), m_pins.end(), name) != m_pins.end();
+    const bool aufDemHome =
+        std::find(m_home.begin(), m_home.end(), name) != m_home.end();
+
+    // ZWEI ZIELE, JE EIN PUNKT - UND NIE EIN TOTER
+    //
+    //     Bestellt war am 20.08.2026 "Zum Dock hinzufuegen" und am
+    //     21.08.2026 dazu, woertlich: "auch im ags launcher bzw
+    //     hyprlauncher kann ich nicht mit rechtsklick zu home
+    //     hinzufügen". Beide Ziele stehen deshalb hier, und beide in
+    //     der Richtung, die gerade etwas bewirkt.
+    //
+    //     Was aber soll ein Rechtsklick auf eine Anwendung anbieten,
+    //     die BEREITS dort liegt? Drei Antworten waren moeglich: den
+    //     Punkt trotzdem zeigen (er taete nichts), ihn ausblenden (ein
+    //     Rechtsklick, der mal wirkt und mal nicht), oder die
+    //     Gegenrichtung anbieten.
+    //
+    //     Die dritte ist die einzige, die immer etwas sagt, und sie ist
+    //     nicht erfunden: der Fuss und das Home tragen dieselben vier
+    //     Punkte unter denselben Namen (ags-dock.template, homePunkt();
+    //     ags-home.template, dockPunkt()) und schreiben sie ueber
+    //     denselben Befehl. settings.py deckt sie ab: `add` auf einen
+    //     Namen, der schon dasteht, endet mit 0 und schreibt nicht.
+    //
+    //     DIE REIHENFOLGE ist die des Fusses: erst der Fuss, dann das
+    //     Home. Ein Menue, dessen Punkte je nach Fenster die Plaetze
+    //     tauschen, ist eines, in dem man zielen muss.
+    //     DIE VIER BESCHRIFTUNGEN KOMMEN SEIT DEM 02.09.2026 AUS DEM
+    //     KATALOG, und das ist die Fortsetzung genau desselben
+    //     Gedankens: der Fuss und das Home tragen dieselben vier
+    //     Punkte, und sie holen sie mit _("Add to dock") aus
+    //     po/desktop/de.po. Diese Stelle schrieb sie ein zweites Mal
+    //     daneben - derselbe Satz an zwei Orten, von denen einer
+    //     irgendwann abweicht. Es sind KEINE neuen Katalogeintraege:
+    //     alle vier stehen dort seit dem Fuss (Zeilen 600 bis 613), und
+    //     damit sagen die drei Menues jetzt garantiert dasselbe.
+    const std::string script = m_config.settingsScript;
+    const std::string id = entry.id;
+    std::vector<MenuEntry> entries;
+
+    if (pinned) {
+        entries.push_back({m_config.unpinIcon, _("Remove from dock"),
+            [script, id]() { klageMelden(AppDiscovery::unpinFromDock(script, id)); }});
+    } else {
+        entries.push_back({m_config.pinIcon, _("Add to dock"),
+            [script, id]() { klageMelden(AppDiscovery::pinToDock(script, id)); }});
+    }
+
+    // BEIDE RICHTUNGEN MIT DEMSELBEN ZEICHEN, und das ist eine Regel
+    // und keine Sparsamkeit: das Zeichen nennt das ZIEL, der Text die
+    // Richtung. Zusammen stehen die zwei nie. Der Fuss fuehrt dieselbe
+    // Regel unter HOME_ICON, und sie ist dort begruendet: ein zweites
+    // Minus neben "Vom Dock entfernen" waeren zwei gleiche Zeichen mit
+    // zwei Wirkungen in EINEM Menue.
+    if (aufDemHome) {
+        entries.push_back({m_config.homeIcon, _("Remove from Home"),
+            [script, id]() { klageMelden(AppDiscovery::removeFromHome(script, id)); }});
+    } else {
+        entries.push_back({m_config.homeIcon, _("Add to Home"),
+            [script, id]() { klageMelden(AppDiscovery::addToHome(script, id)); }});
+    }
+
+    return entries;
+}
+
+void LauncherRenderer::showMenu(GtkWidget* anchor, double x, double y,
+                                const std::vector<MenuEntry>& entries) {
+    if (entries.empty() || !anchor)
+        return;
+
+    // Steht noch eines, geht es zuerst zu. Zwei Popover mit je einem
+    // Griff (xdg_popup.grab) sind zwei Fenster, die beide glauben, die
+    // Eingabe zu haben.
+    if (m_menu)
+        gtk_popover_popdown(GTK_POPOVER(m_menu));
+
+    GtkWidget* list = gtk_box_new(GTK_ORIENTATION_VERTICAL, m_config.space(2));
+    gtk_widget_add_css_class(list, "launcher-menu");
+
+    GtkWidget* menu = gtk_popover_new();
+    gtk_popover_set_has_arrow(GTK_POPOVER(menu), FALSE);
+
+    // OHNE GRIFF - 03.09.2026, und das ist der Unterschied zum Fuss.
+    //
+    //     GEMELDET, mehrfach und zuletzt woertlich: "doch rechtklick
+    //     kommt popover dock hinzufuegen home hinzufuegen usw. aber
+    //     danach passiert nichts mehr". Das Menue steht also; der Klick
+    //     kommt am Knopf nicht an.
+    //
+    //     WAS GEMESSEN IST: die Schreibseite ist heil. Loest ein Lauf
+    //     den Menuepunkt aus (tests/render/test_launcher_menue.py,
+    //     `waehle:`), dann laeuft settings.py und die Anheftung steht
+    //     danach in der Datei - auch zwei Sekunden nach dem Aufklappen,
+    //     die Zeile stirbt also nicht dazwischen. Was dieser Messstand
+    //     NICHT nachstellen kann, ist der Weg des Zeigers zu einem
+    //     xdg_popup: dafuer braeuchte er ein Werkzeug, das im
+    //     verschachtelten Compositor wirklich klickt (ydotool o.ae.),
+    //     und das liegt auf dieser Maschine nicht.
+    //
+    //     DER UNTERSCHIED ZUM FUSS, dessen Menue beim Nutzer geht:
+    //     dessen Flaeche haelt Astal.Keymode.ON_DEMAND, diese hier
+    //     GTK_LAYER_SHELL_KEYBOARD_MODE_EXCLUSIVE. Ein autohide-Popover
+    //     nimmt einen xdg_popup.grab; auf einer Flaeche, die die
+    //     Tastatur ausschliesslich haelt, ist das die eine Stelle, an
+    //     der sich die beiden Menues unterscheiden.
+    //
+    //     Ohne autohide nimmt GTK keinen Griff. Der Popup ist dann eine
+    //     gewoehnliche Flaeche, und seine Eingaben gehen den normalen
+    //     Weg. Zugemacht wird er dafuer von Hand - und das war er auch
+    //     vorher schon an jeder Stelle, die zaehlt: bei der Auswahl
+    //     (der Rueckruf ruft popdown), bei Escape (onKeyPress), beim
+    //     naechsten Rechtsklick (oben in dieser Funktion) und beim
+    //     Verschwinden des Starters (hide).
+    //
+    //     WAS DAMIT WEGFAELLT: der Klick DANEBEN schliesst das Menue
+    //     nicht mehr von selbst. Escape tut es, die Auswahl tut es, und
+    //     der Starter selbst geht bei Fokusverlust zu. Das ist der
+    //     Preis, und er ist kleiner als ein Menue, das man anklicken
+    //     kann und das nichts tut.
+    gtk_popover_set_autohide(GTK_POPOVER(menu), FALSE);
+    gtk_widget_add_css_class(menu, "launcher-menu-popover");
+    gtk_popover_set_child(GTK_POPOVER(menu), list);
+    gtk_widget_set_parent(menu, anchor);
+
+    // AM ZEIGER UND NICHT IN DER ZEILENMITTE. Eine Trefferzeile ist so
+    // breit wie das Fenster; ein Menue in ihrer Mitte staende
+    // irgendwo. GTK dreht selbst nach oben, wenn unten kein Platz ist.
+    const GdkRectangle at{static_cast<int>(x), static_cast<int>(y), 1, 1};
+    gtk_popover_set_pointing_to(GTK_POPOVER(menu), &at);
+    gtk_popover_set_position(GTK_POPOVER(menu), GTK_POS_BOTTOM);
+
+    for (size_t i = 0; i < entries.size(); i++) {
+        const MenuEntry& item = entries[i];
+
+        GtkWidget* line = gtk_button_new();
+        gtk_widget_set_can_focus(line, FALSE);
+        gtk_widget_add_css_class(line, "launcher-menu-item");
+
+        GtkWidget* box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL,
+                                     m_config.space(8));
+
+        GtkWidget* icon = gtk_label_new(item.icon.c_str());
+        gtk_widget_add_css_class(icon, "launcher-menu-icon");
+
+        GtkWidget* text = gtk_label_new(item.text.c_str());
+        gtk_label_set_xalign(GTK_LABEL(text), 0);
+        gtk_widget_set_hexpand(text, TRUE);
+        gtk_widget_add_css_class(text, "launcher-menu-label");
+
+        gtk_box_append(GTK_BOX(box), icon);
+        gtk_box_append(GTK_BOX(box), text);
+        gtk_button_set_child(GTK_BUTTON(line), box);
+
+        // ERST ZU, DANN TUN, DANN DAS FENSTER ZU.
+        //
+        // Andersherum stuende das Menue noch, waehrend der Starter
+        // schon zugeht - und ein Menue ueber allen Fenstern ist genau
+        // das, was hier nicht entstehen soll. Der Fuss schreibt
+        // dieselbe Reihenfolge auf.
+        //
+        // Und das FENSTER geht auch zu: ein Starter, der nach dem
+        // Anheften offen stehenbliebe, verlangte einen zweiten
+        // Handgriff fuer etwas, das fertig ist. Derselbe Abschluss, den
+        // jeder Linksklick nimmt.
+        struct ActData { LauncherRenderer* self; GtkWidget* menu; std::function<void()> act; };
+        auto* actData = new ActData{this, menu, item.act};
+        g_signal_connect_data(line, "clicked",
+            G_CALLBACK(+[](GtkButton*, gpointer data) {
+                auto* ad = static_cast<ActData*>(data);
+                gtk_popover_popdown(GTK_POPOVER(ad->menu));
+                if (ad->act) ad->act();
+                ad->self->hide();
+            }), actData,
+            +[](gpointer data, GClosure*) {
+                delete static_cast<ActData*>(data);
+            }, G_CONNECT_DEFAULT);
+
+        gtk_box_append(GTK_BOX(list), line);
+    }
+
+    // ABGENOMMEN IM LEERLAUF UND NICHT IM RUECKRUF
+    //     "closed" laeuft MITTEN im Abbau des Popovers; GTK reicht
+    //     danach noch den Tastaturfokus zurueck. Wer in diesem
+    //     Augenblick den Widgetbaum anfasst, nimmt genau dem Widget den
+    //     Boden weg, nach dem GTK gerade fragt. GEMESSEN im Fuss am
+    //     20.08.2026 und dort wortgleich geloest.
+    g_signal_connect(menu, "closed",
+        G_CALLBACK(+[](GtkPopover* popover, gpointer data) {
+            auto* self = static_cast<LauncherRenderer*>(data);
+            self->m_menu = nullptr;
+            g_idle_add_full(G_PRIORITY_DEFAULT_IDLE,
+                +[](gpointer widget) -> gboolean {
+                    GtkWidget* menu = static_cast<GtkWidget*>(widget);
+                    if (gtk_widget_get_parent(menu))
+                        gtk_widget_unparent(menu);
+                    return G_SOURCE_REMOVE;
+                }, popover, nullptr);
+        }), this);
+
+    m_menu = menu;
+    gtk_popover_popup(GTK_POPOVER(menu));
+}
