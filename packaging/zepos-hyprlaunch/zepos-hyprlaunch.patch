+//
+// EINMAL, GANZ VORN IN main(), UND VOR gtk_init()
+//     setlocale() gehoert vor die erste Zeichenkette, die uebersetzt
+//     wird, und in einem GTK-Programm ist das die erste, die ein Widget
+//     bekommt. Danach aufgerufen liefe der Aufbau des Fensters noch in
+//     der C-Sprachumgebung, und die Beschriftungen kaemen englisch -
+//     eine schon gezeichnete Beschriftung folgt einem spaeteren
+//     Katalogwechsel NICHT. Diese Messung steht ausgefuehrt im Kopf von
+//     src/templates/ags-i18n.template; sie gilt hier wortgleich, weil
+//     es dasselbe gettext und dieselbe Sorte Widget ist.
+//
+// "" UND KEIN FESTER NAME
+//     Der leere Name heisst "nimm, was in der Umgebung steht" - also
+//     LANG, das systemd aus /etc/locale.conf an die Sitzung reicht.
+//     Ein fester Name waere eine ERZWUNGENE Anzeigesprache, und
+//     tests/src/test_locale.py weist genau die im ganzen Baum zurueck.
+//
+// WARUM setlocale UND NICHT NUR bindtextdomain
+//     Weil bindtextdomain nur SAGT, wo der Katalog liegt, und nicht,
+//     welchen davon dieser Prozess nehmen soll. Ohne setlocale laeuft
+//     ein C-Programm in der Sprachumgebung "C", und fuer die gibt es
+//     keinen Katalog - dgettext gaebe dann den msgid zurueck, also
+//     Englisch, auf einer durchgehend deutschen Installation.
+inline void spracheAnwenden() {
+    std::setlocale(LC_ALL, "");
+    bindtextdomain(GETTEXT_PACKAGE, ZEPOS_LOCALEDIR);
+    // Auf UTF-8 festgelegt, und nicht der Sprachumgebung ueberlassen.
+    //
+    // WAS GEMESSEN IST (02.09.2026, gegen das gebaute .mo):
+    //     LANG=de_DE.UTF-8  ->  "Zum Dock hinzufügen", Umlaut heil
+    //     LANG=en_US.UTF-8  ->  "Add to dock", also der msgid
+    //     LANG=C            ->  der msgid
+    //     LANG=de_DE        ->  der msgid; diese Sprachumgebung ist auf
+    //                           der Maschine nicht erzeugt, und dann
+    //                           tut setlocale STILL nichts (dieselbe
+    //                           Messung steht im Kopf von
+    //                           src/region.py)
+    //
+    // WAS DIESE ZEILE DESHALB IST: eine Zusicherung und keine Reparatur
+    // eines gemessenen Fehlers. gettext wandelt den Text sonst in den
+    // Zeichensatz der Sprachumgebung um, GTK4 nimmt aber
+    // ausschliesslich UTF-8, und ein Umlaut in einem anderen
+    // Zeichensatz waere ein Byte, das GTK verwirft. Auf einer
+    // Sprachumgebung ohne .UTF-8 im Namen waere genau das der Fall -
+    // vorfuehren liess es sich hier nicht, weil diese Maschine keine
+    // solche erzeugt hat.
+    bind_textdomain_codeset(GETTEXT_PACKAGE, "UTF-8");
+}
