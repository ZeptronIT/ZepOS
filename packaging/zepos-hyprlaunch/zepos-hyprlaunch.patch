+// ============================================================================
+// Die Anheftungen des Docks (21.08.2026)
+// ============================================================================
+//
+// WARUM DIESES PROGRAMM UEBERHAUPT IN DIE EINSTELLUNGEN SCHREIBT
+//     Weil der Nutzer es bestellt hat: "was das menue angeht bei
+//     rechtsklick will ich das wir das am besten auslagern auf das
+//     aktuelle". Ein Rechtsklick auf eine Trefferzeile heftet die
+//     Anwendung an den Fuss. Der Fuss liest dieselbe Liste (Aufgabe 45,
+//     973d9d3), also gibt es nichts zu verabreden - nur denselben
+//     Befehl zu rufen.
+//
+// WARUM g_spawn_sync UND NICHT popen WIE BEIM RECHNER
+//     evaluateCalculator() weiter oben braucht eine SHELL, weil es eine
+//     Pipeline absetzt (`echo ... | bc`). Hier gibt es keine Pipeline,
+//     und eine Shell waere ein Zitierproblem, das man nicht haben muss:
+//     die Namen kommen aus fremden .desktop-Dateien, und ein
+//     Anfuehrungszeichen darin waere in einer Kommandozeile eine
+//     Luecke. g_spawn_sync nimmt ein argv-Feld - da gibt es nichts zu
+//     zitieren, weil nichts geparst wird.
+//
+//     Der zweite Grund ist der Rueckgabewert. Der Fuss muss in
+//     ags-dock.template `; exit 0` anhaengen, weil execAsync bei jedem
+//     Wert ungleich 0 verwirft und dabei genau die Klage wegwirft, die
+//     die Bruecke auf STDOUT gelegt hat. g_spawn_sync reicht STDOUT,
+//     STDERR und den Wert getrennt heraus - der Umweg entfaellt.
+//
+// WARUM SYNCHRON, UND WAS DAS KOSTET
+//     GEMESSEN am 21.08.2026, fuenf Laeufe von `zepos-settings-gui
+//     --json get` auf dieser Maschine:
+//
+//         41, 49, 42, 39, 42 ms   Median 42 ms, 46231 Bytes Antwort
+//
+//     42 ms zwischen Rechtsklick und Menue sind unterhalb dessen, was
+//     als Warten gelesen wird. Ein asynchroner Weg haette dafuer ein
+//     Menue gebraucht, das sich nach dem Aufklappen noch aendert - also
+//     einen Punkt, der erst "Zum Dock hinzufuegen" heisst und dann
+//     etwas anderes. Das ist schlechter als 42 ms.
+
+namespace {
+
+// Der Befehl und die Schluessel. WORTGLEICH zu ags-dock.template -
+// aendert sich der Aufruf, aendert er sich fuer beide, und dann findet
+// ihn `grep zepos-settings-gui` in genau drei Dateien.
+constexpr const char* SETTINGS_COMMAND = "zepos-settings-gui";
+constexpr const char* JSON_FLAG        = "--json";
+constexpr const char* BAR_PAGE         = "leiste";
+constexpr const char* PIN_KEY          = "bar.dock_pins";
+
+/** Ein Aufruf der Bruecke. false heisst: sie ist gar nicht gelaufen.
+ *
+ * NICHT dasselbe wie "sie hat abgelehnt". Die Bruecke endet mit 1, WENN
+ * sie eine Aenderung ablehnt, und legt ihre Begruendung dabei auf
+ * STDOUT. Der Rueckgabewert wird hier deshalb NICHT geprueft -
+ * unterschieden wird an `ok` im Dokument, genau wie im Fuss. Geprueft
+ * wird nur, ob der Prozess ueberhaupt gestartet ist; ein fehlendes
+ * zepos-settings-gui ist etwas anderes als ein abgelehnter Wunsch.
+ */
+bool callBridge(const std::vector<std::string>& args,
+                std::string& answer, std::string& failure) {
+    std::vector<char*> argv;
+    argv.push_back(const_cast<char*>(SETTINGS_COMMAND));
+    argv.push_back(const_cast<char*>(JSON_FLAG));
+    for (const std::string& arg : args)
+        argv.push_back(const_cast<char*>(arg.c_str()));
+    argv.push_back(nullptr);
+
+    gchar* out = nullptr;
+    gchar* err = nullptr;
+    gint status = 0;
+    GError* error = nullptr;
+
+    const gboolean started = g_spawn_sync(
+        nullptr, argv.data(), nullptr,
+        static_cast<GSpawnFlags>(G_SPAWN_SEARCH_PATH),
+        nullptr, nullptr, &out, &err, &status, &error);
+
+    if (!started) {
+        failure = error && error->message
+                  ? std::string(error->message)
+                  : std::string(SETTINGS_COMMAND) + " liess sich nicht starten";
+        if (error) g_error_free(error);
+        return false;
+    }
+
+    answer = out ? out : "";
+    // STDERR nur, falls STDOUT nichts hergibt - dann ist es das
+    // einzige, was der Befehl hinterlassen hat.
+    failure = err ? err : "";
+    g_free(out);
+    g_free(err);
+    (void)status;
+    return true;
+}
+
+/** Das Feld `effective` des Bedienelements bar.dock_pins, oder nichts.
+ *
+ * Jede Ebene wird EINZELN geprueft. Ein json_object_get_array_member()
+ * auf ein fehlendes Feld ist in json-glib kein Fehler, den man
+ * abfragt - es gibt nullptr zurueck, und der naechste Zugriff darauf
+ * ist ein Absturz. Der Starter darf an einer Einstellungsdatei nicht
+ * sterben.
+ */
+std::optional<std::vector<std::string>> pinsFromAnswer(const std::string& text) {
+    if (text.empty())
+        return std::nullopt;
+
+    JsonParser* parser = json_parser_new();
+    GError* error = nullptr;
+    if (!json_parser_load_from_data(parser, text.c_str(),
+                                    static_cast<gssize>(text.size()), &error)) {
+        // Kein JSON heisst: der Befehl ist abgestuerzt oder hat etwas
+        // ganz anderes geschrieben. Beides ist "nicht geantwortet".
+        if (error) g_error_free(error);
+        g_object_unref(parser);
+        return std::nullopt;
+    }
+
+    std::optional<std::vector<std::string>> found;
+    JsonNode* root = json_parser_get_root(parser);
+
+    if (root && JSON_NODE_HOLDS_OBJECT(root)) {
+        JsonObject* top = json_node_get_object(root);
+        if (json_object_has_member(top, "pages")) {
+            JsonArray* pages = json_object_get_array_member(top, "pages");
+            const guint pageCount = pages ? json_array_get_length(pages) : 0;
+
+            for (guint p = 0; p < pageCount && !found; p++) {
+                JsonObject* page = json_array_get_object_element(pages, p);
+                if (!page || !json_object_has_member(page, "name"))
+                    continue;
+                const char* pageName = json_object_get_string_member(page, "name");
+                if (!pageName || std::string(pageName) != BAR_PAGE)
+                    continue;
+                if (!json_object_has_member(page, "controls"))
+                    continue;
+
+                JsonArray* controls = json_object_get_array_member(page, "controls");
+                const guint controlCount =
+                    controls ? json_array_get_length(controls) : 0;
+
+                for (guint c = 0; c < controlCount && !found; c++) {
+                    JsonObject* control = json_array_get_object_element(controls, c);
+                    if (!control || !json_object_has_member(control, "key"))
+                        continue;
+                    const char* key = json_object_get_string_member(control, "key");
+                    if (!key || std::string(key) != PIN_KEY)
+                        continue;
+                    if (!json_object_has_member(control, "effective"))
+                        continue;
+
+                    JsonNode* node = json_object_get_member(control, "effective");
+                    if (!node || !JSON_NODE_HOLDS_ARRAY(node))
+                        continue;
+
+                    JsonArray* effective = json_node_get_array(node);
+                    std::vector<std::string> names;
+                    const guint nameCount =
+                        effective ? json_array_get_length(effective) : 0;
+                    for (guint n = 0; n < nameCount; n++) {
+                        const char* name = json_array_get_string_element(effective, n);
+                        if (name) names.push_back(name);
+                    }
+                    // Auch die LEERE Liste ist eine Antwort - siehe die
+                    // Begruendung des Rueckgabetyps im Header.
+                    found = names;
+                }
+            }
+        }
+    }
+
+    g_object_unref(parser);
+    return found;
+}
+
+/** Hat die Bruecke die Aenderung angenommen? Klagen als Nebenausgabe. */
+bool acceptedFromAnswer(const std::string& text,
+                        std::vector<std::string>& problems) {
+    JsonParser* parser = json_parser_new();
+    GError* error = nullptr;
+    if (!json_parser_load_from_data(parser, text.c_str(),
+                                    static_cast<gssize>(text.size()), &error)) {
+        if (error) g_error_free(error);
+        g_object_unref(parser);
+        problems.push_back(text.empty()
+            ? std::string(SETTINGS_COMMAND) + " hat nicht geantwortet"
+            : text);
+        return false;
+    }
+
+    bool accepted = false;
+    JsonNode* root = json_parser_get_root(parser);
+    if (root && JSON_NODE_HOLDS_OBJECT(root)) {
+        JsonObject* top = json_node_get_object(root);
+        if (json_object_has_member(top, "ok"))
+            accepted = json_object_get_boolean_member(top, "ok");
+        if (json_object_has_member(top, "problems")) {
+            JsonArray* list = json_object_get_array_member(top, "problems");
+            const guint count = list ? json_array_get_length(list) : 0;
+            for (guint i = 0; i < count; i++) {
+                const char* problem = json_array_get_string_element(list, i);
+                if (problem) problems.push_back(problem);
+            }
+        }
+    }
+    g_object_unref(parser);
+
+    // Abgelehnt und stumm: dann ist die Antwort selbst die Auskunft.
+    if (!accepted && problems.empty())
+        problems.push_back(text);
+    return accepted;
+}
+
+/** Das Dokument fuer `--json set`, von json-glib gesetzt.
+ *
+ * NICHT von Hand zusammengeklebt. Ein Anwendungsname aus einer fremden
+ * .desktop-Datei darf jedes Zeichen tragen, das UTF-8 hergibt, und ein
+ * `"` darin machte aus dem Dokument Bruch - den die Bruecke dann
+ * ablehnte, mit einer Klage ueber etwas, das niemand geschrieben hat.
+ */
+std::string pinsDocument(const std::vector<std::string>& names) {
+    JsonBuilder* builder = json_builder_new();
+    json_builder_begin_object(builder);
+    json_builder_set_member_name(builder, PIN_KEY);
+    json_builder_begin_array(builder);
+    for (const std::string& name : names)
+        json_builder_add_string_value(builder, name.c_str());
+    json_builder_end_array(builder);
+    json_builder_end_object(builder);
+
+    JsonGenerator* generator = json_generator_new();
+    json_generator_set_root(generator, json_builder_get_root(builder));
+    gchar* text = json_generator_to_data(generator, nullptr);
+    std::string document = text ? text : "";
+
+    g_free(text);
+    g_object_unref(generator);
+    g_object_unref(builder);
+    return document;
+}
+
+/** Eine neue Liste schreiben. Leer zurueck heisst: geschrieben.
+ *
+ * dock_baseline wird NICHT mitgeschickt - die Bruecke schreibt es
+ * selbst. Wer es von hier aus mitschickte, ueberschriebe die Vorgabe,
+ * gegen die der Nutzer sich einmal entschieden hat (settings.py,
+ * BAR_BASELINE, fuehrt den ganzen Fall aus).
+ */
+std::vector<std::string> writePins(const std::vector<std::string>& names) {
+    std::string answer;
+    std::string failure;
+    if (!callBridge({"set", pinsDocument(names)}, answer, failure))
+        return {failure};
+
+    std::vector<std::string> problems;
+    if (acceptedFromAnswer(answer, problems))
+        return {};
+    if (problems.empty())
+        problems.push_back(failure.empty() ? "abgelehnt, ohne Grund" : failure);
+    return problems;
+}
+
+} // namespace
+
+std::string AppDiscovery::pinName(const std::string& desktopId) {
+    static const std::string suffix = ".desktop";
+    if (desktopId.size() > suffix.size() &&
+        desktopId.compare(desktopId.size() - suffix.size(),
+                          suffix.size(), suffix) == 0) {
+        return desktopId.substr(0, desktopId.size() - suffix.size());
+    }
+    return desktopId;
+}
+
+std::optional<std::vector<std::string>> AppDiscovery::dockPins() {
+    std::string answer;
+    std::string failure;
+    if (!callBridge({"get"}, answer, failure))
+        return std::nullopt;
+    return pinsFromAnswer(answer);
+}
+
+std::vector<std::string> AppDiscovery::pinToDock(const std::string& desktopId) {
+    const std::string name = pinName(desktopId);
+    if (name.empty())
+        return {"der Eintrag traegt keine Kennung"};
+
+    const auto current = dockPins();
+    if (!current) {
+        // NICHTS SCHREIBEN. Eine Liste, die auf einem
+        // fehlgeschlagenen Lesevorgang aufbaut, waere die
+        // Auslieferung - und der Nutzer verloere jede Anheftung, die er
+        // je gemacht hat. Dieselbe Regel wie im Fuss.
+        return {std::string(SETTINGS_COMMAND) +
+                " hat die Anheftungen nicht hergegeben; es wurde nichts geschrieben"};
+    }
+
+    std::vector<std::string> names = *current;
+    if (std::find(names.begin(), names.end(), name) != names.end())
+        return {};   // steht schon da - kein Fehler und nichts zu tun
+
+    names.push_back(name);
+    return writePins(names);
+}
+
+std::vector<std::string> AppDiscovery::unpinFromDock(const std::string& desktopId) {
+    const std::string name = pinName(desktopId);
+    const auto current = dockPins();
+    if (!current) {
+        return {std::string(SETTINGS_COMMAND) +
+                " hat die Anheftungen nicht hergegeben; es wurde nichts geschrieben"};
+    }
+
+    std::vector<std::string> names = *current;
+    const auto gone = std::remove(names.begin(), names.end(), name);
+    if (gone == names.end())
+        return {};   // stand gar nicht da
+    names.erase(gone, names.end());
+    return writePins(names);
+}
+
 } // namespace hyprlaunch
