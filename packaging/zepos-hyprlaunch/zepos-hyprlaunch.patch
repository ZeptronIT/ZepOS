+    const auto pins = AppDiscovery::dockPins();
+    m_pinsKnown = pins.has_value();
+    m_pins = pins ? *pins : std::vector<std::string>{};
+}
+
+std::vector<MenuEntry> LauncherRenderer::entryMenu(const AppEntry& entry) {
+    // Die Hilfsskripte haben keinen Anwendungseintrag, also gibt es
+    // nichts anzuheften - der Fuss loest Namen ueber
+    // GioUnix.DesktopAppInfo auf, und ein Shell-Skript ist keiner.
+    // LEER heisst hier: es klappt gar kein Menue auf. Ein Menue mit
+    // einem Punkt, der nichts tun kann, waere schlechter als keines.
+    if (m_mode != LauncherMode::Apps || entry.id.empty())
+        return {};
+
+    // Bei JEDEM Rechtsklick frisch gelesen und nicht einmal beim
+    // Aufgehen: die Liste kann sich waehrend das Fenster offensteht
+    // aendern - im Fuss, im Einstellungsfenster, in einem zweiten
+    // Starter. Ein Menue, das "Zum Dock hinzufuegen" anbietet, waehrend
+    // das Symbol schon unten steht, ist genau die Sorte Punkt, die
+    // nichts tut. GEMESSEN: 42 ms (siehe AppDiscovery.cpp).
+    refreshPins();
+
+    // Hat die Bruecke nicht geantwortet, wird NICHTS angeboten. Der
+    // Punkt haenge sonst an einem Schreibvorgang, der ohne gelesene
+    // Liste gar nicht stattfinden darf (AppDiscovery::pinToDock
+    // fuehrt es aus) - er waere ein Punkt, der zuverlaessig scheitert.
+    if (!m_pinsKnown)
+        return {};
+
+    const std::string name = AppDiscovery::pinName(entry.id);
+    const bool pinned =
+        std::find(m_pins.begin(), m_pins.end(), name) != m_pins.end();
+
+    // ZWEI ZUSTAENDE, EIN PUNKT - UND NIE EIN TOTER
+    //
+    //     Bestellt war "Zum Dock hinzufuegen". Was aber soll ein
+    //     Rechtsklick auf eine Anwendung anbieten, die BEREITS
+    //     angeheftet ist? Drei Antworten waren moeglich: den Punkt
+    //     trotzdem zeigen (er taete nichts), gar kein Menue zeigen (ein
+    //     Rechtsklick, der mal wirkt und mal nicht), oder die
+    //     Gegenrichtung anbieten.
+    //
+    //     Die dritte ist die einzige, die immer etwas sagt, und sie ist
+    //     nicht erfunden: der Fuss traegt denselben Punkt unter
+    //     demselben Namen (_("Remove from dock"), ags-dock.template,
+    //     pinMenue()) und schreibt ihn ueber denselben Befehl.
+    if (pinned) {
+        std::string id = entry.id;
+        return {{m_config.unpinIcon, "Vom Dock entfernen",
+                 [id]() { AppDiscovery::unpinFromDock(id); }}};
+    }
+
+    std::string id = entry.id;
+    return {{m_config.pinIcon, "Zum Dock hinzufuegen",
+             [id]() { AppDiscovery::pinToDock(id); }}};
+}
+
+void LauncherRenderer::showMenu(GtkWidget* anchor, double x, double y,
+                                const std::vector<MenuEntry>& entries) {
+    if (entries.empty() || !anchor)
+        return;
+
+    // Steht noch eines, geht es zuerst zu. Zwei Popover mit je einem
+    // Griff (xdg_popup.grab) sind zwei Fenster, die beide glauben, die
+    // Eingabe zu haben.
+    if (m_menu)
+        gtk_popover_popdown(GTK_POPOVER(m_menu));
+
+    GtkWidget* list = gtk_box_new(GTK_ORIENTATION_VERTICAL, m_config.space(2));
+    gtk_widget_add_css_class(list, "launcher-menu");
+
+    GtkWidget* menu = gtk_popover_new();
+    gtk_popover_set_has_arrow(GTK_POPOVER(menu), FALSE);
+    gtk_widget_add_css_class(menu, "launcher-menu-popover");
+    gtk_popover_set_child(GTK_POPOVER(menu), list);
+    gtk_widget_set_parent(menu, anchor);
+
+    // AM ZEIGER UND NICHT IN DER ZEILENMITTE. Eine Trefferzeile ist so
+    // breit wie das Fenster; ein Menue in ihrer Mitte staende
+    // irgendwo. GTK dreht selbst nach oben, wenn unten kein Platz ist.
+    const GdkRectangle at{static_cast<int>(x), static_cast<int>(y), 1, 1};
+    gtk_popover_set_pointing_to(GTK_POPOVER(menu), &at);
+    gtk_popover_set_position(GTK_POPOVER(menu), GTK_POS_BOTTOM);
+
+    for (size_t i = 0; i < entries.size(); i++) {
+        const MenuEntry& item = entries[i];
+
+        GtkWidget* line = gtk_button_new();
+        gtk_widget_set_can_focus(line, FALSE);
+        gtk_widget_add_css_class(line, "launcher-menu-item");
+
+        GtkWidget* box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL,
+                                     m_config.space(8));
+
+        GtkWidget* icon = gtk_label_new(item.icon.c_str());
+        gtk_widget_add_css_class(icon, "launcher-menu-icon");
+
+        GtkWidget* text = gtk_label_new(item.text.c_str());
+        gtk_label_set_xalign(GTK_LABEL(text), 0);
+        gtk_widget_set_hexpand(text, TRUE);
+        gtk_widget_add_css_class(text, "launcher-menu-label");
+
+        gtk_box_append(GTK_BOX(box), icon);
+        gtk_box_append(GTK_BOX(box), text);
+        gtk_button_set_child(GTK_BUTTON(line), box);
+
+        // ERST ZU, DANN TUN, DANN DAS FENSTER ZU.
+        //
+        // Andersherum stuende das Menue noch, waehrend der Starter
+        // schon zugeht - und ein Menue ueber allen Fenstern ist genau
+        // das, was hier nicht entstehen soll. Der Fuss schreibt
+        // dieselbe Reihenfolge auf.
+        //
+        // Und das FENSTER geht auch zu: ein Starter, der nach dem
+        // Anheften offen stehenbliebe, verlangte einen zweiten
+        // Handgriff fuer etwas, das fertig ist. Derselbe Abschluss, den
+        // jeder Linksklick nimmt.
+        struct ActData { LauncherRenderer* self; GtkWidget* menu; std::function<void()> act; };
+        auto* actData = new ActData{this, menu, item.act};
+        g_signal_connect_data(line, "clicked",
+            G_CALLBACK(+[](GtkButton*, gpointer data) {
+                auto* ad = static_cast<ActData*>(data);
+                gtk_popover_popdown(GTK_POPOVER(ad->menu));
+                if (ad->act) ad->act();
+                ad->self->hide();
+            }), actData,
+            +[](gpointer data, GClosure*) {
+                delete static_cast<ActData*>(data);
+            }, G_CONNECT_DEFAULT);
+
+        gtk_box_append(GTK_BOX(list), line);
+    }
+
+    // ABGENOMMEN IM LEERLAUF UND NICHT IM RUECKRUF
+    //     "closed" laeuft MITTEN im Abbau des Popovers; GTK reicht
+    //     danach noch den Tastaturfokus zurueck. Wer in diesem
+    //     Augenblick den Widgetbaum anfasst, nimmt genau dem Widget den
+    //     Boden weg, nach dem GTK gerade fragt. GEMESSEN im Fuss am
+    //     20.08.2026 und dort wortgleich geloest.
+    g_signal_connect(menu, "closed",
+        G_CALLBACK(+[](GtkPopover* popover, gpointer data) {
+            auto* self = static_cast<LauncherRenderer*>(data);
+            self->m_menu = nullptr;
+            g_idle_add_full(G_PRIORITY_DEFAULT_IDLE,
+                +[](gpointer widget) -> gboolean {
+                    GtkWidget* menu = static_cast<GtkWidget*>(widget);
+                    if (gtk_widget_get_parent(menu))
+                        gtk_widget_unparent(menu);
+                    return G_SOURCE_REMOVE;
+                }, popover, nullptr);
+        }), this);
+
+    m_menu = menu;
+    gtk_popover_popup(GTK_POPOVER(menu));
+}
