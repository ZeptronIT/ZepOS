# Maintainer: ZeptronIT <https://github.com/ZeptronIT/ZepOS>
#
# hyprclipx - der Zwischenablage-Verlauf auf SUPER+SHIFT+V (Spec §7.1).
#
# WAS AM 11.08.2026 GEAENDERT WURDE UND AM 19.08.2026 WIEDER RUECKGAENGIG
# GEMACHT WURDE: DIE QUELLE LAG KURZ HIER
#     packaging/zepos-hyprlaunch/PKGBUILD hat die Begruendung in voller
#     Laenge; sie gilt fuer diesen Baum genauso. Vom 11.08. bis zum
#     19.08.2026 lag die Quelle unter plugins/hyprclipx/ in diesem Baum,
#     Tarball und Bau kamen aus dem ARBEITSBAUM. Die
#     Sicherheitspruefung vor der Veroeffentlichung
#     (.superpowers/sdd/2026-08-18-ags-schale-und-breitenleiter/
#     sicherheitsanalyse.md, Abschnitt 6) hat benannt, warum das falsch
#     war: azzuriel/hyprclipx traegt KEINE Lizenzdatei und keinen
#     Copyright-Vermerk - "license": null -, Code ohne Lizenz ist
#     urheberrechtlich "alle Rechte vorbehalten", und Leon Marzolls
#     Erlaubnis vom 11.08.2026 (plugins/LICENSE) deckt, dass ZepOS diese
#     Quellen bauen und veraendern darf, nicht aber, dass ZepOS eine KOPIE
#     des fremden Baums selbst weiterverbreitet.
#
#     Der Nutzer hat am 19.08.2026 entschieden: die Quellen werden nicht
#     mitveroeffentlicht. Dieses Rezept holt sie beim Bauen direkt aus dem
#     Repository des Urhebers, festgenagelt auf den Commit, den
#     plugins/LICENSE als uebernommenen Stand nennt - NICHT auf `main`,
#     aus demselben Reproduzierbarkeitsgrund wie beim Starter.
#
#     Was daran offen bleibt: dasselbe Verfuegbarkeitsrisiko wie vor dem
#     11.08.2026. Verschwindet azzuriel/hyprclipx, laesst sich dieses
#     Paket nicht mehr bauen.
#
# WAS AN DER UEBERNOMMENEN QUELLE GEAENDERT WIRD, UND WOMIT
#     168 Zeilen CSS aus dem Objekt heraus in
#     src/styles/hyprclipx-style.template; die Fenstermasse aus
#     `static constexpr` in eine erzeugte Datei; die angenommene
#     Zeilenhoehe von 28 Pixeln durch eine gemessene ersetzt, weil eine
#     Annahme ueber die Zeilenhoehe falsch wird, sobald die Schrift dem
#     Regler folgt.
#
#     Diese Aenderungen liegen nicht mehr als bearbeitete Dateien in
#     diesem Baum, aus demselben Grund wie beim Starter: sie liegen als
#     zepos-hyprclipx.patch neben diesem Rezept, angewendet in prepare().
#     Die einzelnen Messungen stehen in den Kopfzeilen des Patches selbst
#     und in den Kommentaren, die er in die betroffenen Dateien schreibt.
#
# DIE LIZENZ
#     BSD-3-Clause, und der Urhebervermerk kommt als Datei mit -
#     plugins/LICENSE, dort steht auch, warum er dort zum ersten Mal
#     ausgeschrieben ist. package() legt sie direkt aus diesem Baum ab,
#     nicht aus dem heruntergeladenen Tarball - der traegt keine
#     LICENSE-Datei, weil upstream keine hat.
#
# WARUM ZWEI DATEIEN
#     Dieselbe Teilung wie beim Starter, aus demselben Grund und mit
#     derselben Folge: das Plugin enthaelt kein GTK und startet das
#     Fenster als eigenen Prozess mit
#
#         execlp("hyprclipx-ui", "hyprclipx-ui", arg, nullptr)   Globals.cpp
#
#     also muss /usr/bin/hyprclipx-ui existieren, sonst ist die Taste
#     tot.
#
# WAS DIESES PAKET SEIT DEM 12.08.2026 AUSLIEFERT: DEN SAMMLER
#     Hier stand bis dahin, warum es ihn NICHT ausliefern kann, und der
#     Abschnitt endete mit "sie ist am 11.08.2026 weiterhin offen: das
#     Plugin laedt, sein Fenster oeffnet, und der Sammler dahinter
#     laeuft nicht". Das ist erledigt, und zwar an allen vier Stellen,
#     an denen es offen war.
#
#     DIE QUELLE  Upstreams helpers/ liegt im heruntergeladenen Tarball
#         unter den Namen clipman-daemon.py und get-caret-position.py.
#         prepare() benennt sie zuerst um - collector.py und
#         caret-position.py -, bevor der Patch greift; derselbe Vermerk
#         wie beim C++ daneben steht in plugins/LICENSE.
#
#     DER PFAD  Globals.cpp suchte fest verdrahtet unter
#         $HOME/.local/bin, wo ein pacman-Paket nichts besitzen darf
#         (der Kopf von src/paths.py hat das Argument). Jetzt liegen
#         beide unter /usr/lib/hyprclipx/, gelegt von CMake, und der
#         Pfad steht in ~/.config/hyprclipx/config.
#
#     DER START  hyprland-universal-config.template startete
#         `wl-paste --watch cliphist store` und hielt das fuer den
#         Sammler dieses Plugins. Es ist ein anderer: cliphist macht
#         keinen Unix-Socket auf, und das Fenster fragt
#         /tmp/clipman.sock. Beide Zeilen stehen jetzt da, weil es
#         zwei Verlaeufe sind - cliphist fuellt den auf SUPER+ALT+V.
#
#     DER RUECKFALL  src/plugins.py sah nur nach dem OBJEKT, und das
#         Objekt war da. Es sieht jetzt auch nach dem Sammler; fehlt
#         er, wird der zepos-plugin-missing-Block geschrieben und
#         SUPER+SHIFT+V geht auf cliphist-menu.sh. Ein Verlauf mit
#         fremdem Aussehen schlaegt einen leeren im eigenen.
#
#     clipman-client.py kommt NICHT mit, und das ist kein Versehen:
#     GEMESSEN am 12.08.2026 hatte das Feld, das darauf zeigte, zwei
#     Zuweisungen und null Leser - die C++-Haelfte spricht den Socket
#     in ClipboardManager::sendCommand() selbst an. prepare() loescht es
#     zusammen mit clipman.service, das dieses Paket ebenfalls nicht
#     ausliefert - es gibt keinen systemd-Nutzerdienst, exec-once startet
#     den Sammler.
_zepos_repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"

# Der Stand, den plugins/LICENSE als uebernommen nennt.
_commit=1eed6ee90a1c3e48ec76510377f8b05f27a4e650

pkgname=zepos-hyprclipx
pkgver="$(<"$_zepos_repo/VERSION")"
pkgrel=1
pkgdesc="Der Zwischenablage-Verlauf von ZepOS: ein GTK4-Layer-Shell-Fenster und sein Hyprland-Plugin"
arch=('x86_64')
url="https://github.com/azzuriel/hyprclipx"
# Gemessen am 11.08.2026: der Quellbaum traegt KEINE Lizenzdatei und
# keinen Copyright-Vermerk, die GitHub-API meldet "license": null. Hier
# stand trotzdem BSD-3-Clause - vermutlich mitgewandert von den Plugins
# des Hyprland-Projekts, die wirklich so lizenziert sind.
#
# 'custom' beschreibt die Lage, statt eine Lizenz zu behaupten: Leon
# Marzoll hat am 11.08.2026 erklaert, dass ZepOS die Quellen verwenden
# und veraendern darf. Eine Erlaubnis gilt dem, dem sie erteilt wurde -
# was ein NUTZER von ZepOS mit diesem Code darf, steht damit nirgends.
# plugins/LICENSE haelt das fest und nennt das eine, was die Luecke
# schliesst: eine Lizenzdatei im Repositorium des Urhebers.
license=('custom')

# Das ABI-Kuerzel, das zepos-hyprland veroeffentlicht, aus der Datei
# gelesen, die jenes Paket installiert. packaging/zepos-hyprzones/
# PKGBUILD hat die Gruende vollstaendig.
_abi_file="/usr/lib/hyprland/plugin-abi"
_abi="$(cat "$_abi_file" 2>/dev/null || true)"
: "${_abi:=zepos.hyprland.absent}"

# python, wl-clipboard und sqlite kommen seit dem 12.08.2026 dazu, weil
# das Paket seit dem den Sammler mitliefert:
#
#   python          collector.py und caret-position.py sind Python 3
#   wl-clipboard    der Sammler liest mit `wl-paste` und schreibt beim
#                   Einfuegen mit `wl-copy` zurueck. Ohne die beiden
#                   sammelt er nichts und der Verlauf bleibt leer -
#                   also genau der Zustand, gegen den er da ist.
#
# sqlite steht NICHT dabei: das sqlite3-Modul ist Teil von python
# selbst, und `pacman -Qi python` fuehrt sqlite als dessen Abhaengigkeit.
# Sie hier zu wiederholen hiesse, eine fremde Abhaengigkeitskette
# nachzubauen, die sich unabhaengig von uns aendert.
depends=('zepos-hyprland>=0.56.1' 'zepos-hyprland<0.57.0'
         "hyprland-plugin-abi=$_abi"
         'gtk4' 'gtk4-layer-shell' 'pango' 'cairo' 'glib2' 'glibc'
         'libgcc' 'libstdc++'
         'python' 'wl-clipboard'
         # WER DEN TASTENDRUCK AUSFUEHRT, UND WARUM ER HIER STEHEN MUSS
         #
         #     ClipboardRenderer::pasteItem() legt den Eintrag mit
         #     wl-copy in die Zwischenablage und drueckt DANACH Strg+V -
         #     mit wtype unter Wayland, mit xdotool fuer XWayland-
         #     Fenster. Bis zum 01.09.2026 nannte dieses Rezept nur
         #     wl-clipboard. Auf einer frischen Installation ohne wtype
         #     landete der Eintrag also in der Zwischenablage, und dann
         #     geschah NICHTS: exec() hat keinen Rueckgabeweg, das
         #     fehlende Programm meldet sich nirgends. Die Haelfte, die
         #     das Fenster nach aussen bewirkt, hing an einem Paket, das
         #     niemand angefordert hatte.
         'wtype' 'xdotool'
         'ttf-fira-code' 'ttf-jetbrains-mono-nerd')
makedepends=('cmake' 'ninja' 'zepos-hyprland')

optdepends=('zepos-config: erzeugt config und style.css, ohne die das Fenster ungestylt bleibt')

# Zwei Quellen: der unveraenderte Baum des Urhebers, auf den Commit
# festgenagelt, den plugins/LICENSE als uebernommen nennt - und ZepOS'
# eigenes Diff darauf, das neben diesem Rezept liegt. NICHT `main`: ein
# Bau, der von einem beweglichen Zweig holt, ist nicht reproduzierbar.
source=("hyprclipx-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        "zepos-hyprclipx.patch")
sha256sums=('6017d78e8999129132e466591f52dca9b2040fd8a1d253e39f18907144733e6f'
            'aa4e2950bf47390942682e05bad8d66266523d5c0a91541ec9efbdbe2f7b2a07')

_src="hyprclipx-$_commit"
_plugin_dir="usr/lib/hyprland/plugins"

prepare() {
    cd "$srcdir/$_src"

    # Die Umbenennung, BEVOR der Patch greift - er aendert nur noch
    # Dateiinhalte, keine Dateinamen (siehe zepos-hyprclipx.patch).
    test -f helpers/clipman-daemon.py || {
        echo "helpers/clipman-daemon.py fehlt im heruntergeladenen Baum;" >&2
        echo "upstream hat seine Helfer umbenannt oder verschoben" >&2
        return 1
    }
    test -f helpers/get-caret-position.py || {
        echo "helpers/get-caret-position.py fehlt im heruntergeladenen" >&2
        echo "Baum; upstream hat seine Helfer umbenannt oder verschoben" >&2
        return 1
    }
    mv helpers/clipman-daemon.py helpers/collector.py
    mv helpers/get-caret-position.py helpers/caret-position.py
    rm -f helpers/clipman-client.py helpers/clipman.service

    patch -p1 < "$srcdir/zepos-hyprclipx.patch"
}

build() {
    cd "$srcdir/$_src"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_RPATH=ON
    cmake --build build --config Release
}

package() {
    cd "$srcdir/$_src"
    DESTDIR="$pkgdir" cmake --install build

    test -f "$pkgdir/$_plugin_dir/hyprclipx.so" || {
        echo "das Plugin-Objekt liegt nicht unter /$_plugin_dir/hyprclipx.so;" >&2
        echo "src/plugins.py wuerde dieses Plugin wortlos fallen lassen" >&2
        return 1
    }

    local ui="$pkgdir/usr/bin/hyprclipx-ui"
    test -x "$ui" || {
        echo "hyprclipx-ui liegt nicht in /usr/bin; das execlp des" >&2
        echo "Plugins faende nichts und SUPER+SHIFT+V waere eine tote Taste" >&2
        return 1
    }

    # DIE DRITTE UND VIERTE DATEI, SEIT DEM 12.08.2026
    #
    # Der Sammler ist die Haelfte, ohne die das Fenster leer aufgeht -
    # der Kopf dieses Rezepts fuehrt aus, warum er bis dahin fehlte.
    # Geprueft, weil sein Versagen NICHT auffaellt: es gibt keine
    # Fehlermeldung, keine Zeile im Protokoll, nur eine leere Liste,
    # die aussieht wie "du hast nichts kopiert".
    #
    # Der Pfad ist derselbe, den src/plugins.py prueft, um zu
    # entscheiden, ob hyprclipx ueberhaupt geladen wird. Legte dieses
    # Rezept ihn woandershin, gaebe es ein Paket, das alles mitbringt
    # und dessen Plugin trotzdem auf jeder Maschine als fehlend gilt.
    local collector="$pkgdir/usr/lib/hyprclipx/collector.py"
    test -x "$collector" || {
        echo "der Sammler liegt nicht unter /usr/lib/hyprclipx/collector.py." >&2
        echo "src/plugins.py wuerde hyprclipx daraufhin gar nicht laden," >&2
        echo "und SUPER+SHIFT+V fiele auf cliphist-menu.sh zurueck." >&2
        return 1
    }
    test -x "$pkgdir/usr/lib/hyprclipx/caret-position.py" || {
        echo "der Schreibmarken-Helfer fehlt. Die zweite von drei" >&2
        echo "Strategien faellt dann lautlos aus - popen() auf eine" >&2
        echo "Datei, die es nicht gibt, meldet nichts -, und der" >&2
        echo "Verlauf geht am Mauszeiger auf statt an der Schreibmarke." >&2
        return 1
    }

    # Und beide muessen uebersetzbar sein. Ein Syntaxfehler im Sammler
    # ist ein Prozess, der beim Anmelden sofort stirbt, und die Sitzung
    # sagt darueber nichts: er startet aus einem exec-once mit
    # umgelenkter Ausgabe.
    python -m py_compile "$collector" \
        "$pkgdir/usr/lib/hyprclipx/caret-position.py" || {
        echo "eine der beiden Python-Haelften laesst sich nicht" >&2
        echo "uebersetzen - sie wuerde beim Anmelden wortlos sterben" >&2
        return 1
    }
    # py_compile legt __pycache__ neben die Datei; das gehoert nicht ins
    # Paket. Ein .pyc in /usr/lib waere eine Datei, die pacman besitzt
    # und die beim naechsten Python-Wechsel still veraltet.
    rm -rf "$pkgdir/usr/lib/hyprclipx/__pycache__"

    # Zwei Werkzeuge fuer zwei Fragen - die Begruendung steht wortgleich
    # in packaging/zepos-lock/PKGBUILD und in
    # packaging/zepos-hyprlaunch/PKGBUILD (bis zu seiner Loeschung mit
    # dem Programm auch in packaging/zepos-logout/PKGBUILD - Aufgabe 26,
    # 19.08.2026).
    #
    # GEMESSEN am 11.08.2026 an genau diesem Objekt, lokal gebaut:
    #     objdump -p hyprclipx-ui | grep NEEDED | grep gtk
    #       NEEDED  libgtk-4.so.1
    #       NEEDED  libgtk4-layer-shell.so.0
    #     ldd hyprclipx-ui | grep -c libgtk-3   ->  0
    local needed
    needed="$(readelf -d "$ui")"

    grep -q "libgtk-4" <<<"$needed" || {
        echo "hyprclipx-ui ist nicht gegen GTK4 gelinkt." >&2
        return 1
    }
    grep -q "gtk4-layer-shell" <<<"$needed" || {
        echo "hyprclipx-ui wurde ohne gtk4-layer-shell gebaut." >&2
        echo "Das Fenster setzt sich an die Schreibmarke des zuletzt" >&2
        echo "fokussierten Fensters; ohne Layer-Shell platziert der" >&2
        echo "Compositor es irgendwohin." >&2
        return 1
    }

    local loaded
    loaded="$(ldd "$ui")"
    if grep -q "libgtk-3" <<<"$loaded"; then
        echo "hyprclipx-ui laedt libgtk-3:" >&2
        grep "libgtk-3" <<<"$loaded" >&2
        return 1
    fi

    if readelf -d "$pkgdir/$_plugin_dir/hyprclipx.so" | grep -q "libgtk"; then
        echo "das Plugin-Objekt linkt gegen GTK. Es wird IN den" >&2
        echo "Compositor geladen; die Teilung in Plugin und" >&2
        echo "Fensterprozess ist genau dafuer da." >&2
        return 1
    fi

    [[ -f "$_abi_file" && "$(<"$_abi_file")" == "$_abi" ]] || {
        echo "das ABI des Compositors ist nicht das, das dieser Bau" >&2
        echo "angemeldet hat:" >&2
        echo "  angemeldet: $_abi" >&2
        echo "  installiert: $(cat "$_abi_file" 2>/dev/null || echo '<kein zepos-hyprland>')" >&2
        return 1
    }

    # plugins/LICENSE liegt in diesem Baum, nicht im heruntergeladenen
    # Tarball - der traegt keine LICENSE-Datei, weil upstream keine
    # hat (siehe oben).
    install -Dm644 "$_zepos_repo/plugins/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
