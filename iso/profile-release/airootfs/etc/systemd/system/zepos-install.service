# The installer, which is what this medium boots into.
#
# WHY A SERVICE AND NOT AN AUTOLOGIN
#     The smoke image logs a user in on tty1 and lets ~/.bash_profile
#     start its run. That is right for a harness and wrong here: an
#     autologin is a shell somebody is handed without being asked who
#     they are, and on an image that must carry no credentials it would
#     be the only one. So nothing logs in on this medium. getty@tty1 is
#     masked next to this file, /etc/shadow is the one the filesystem
#     package ships - root has no usable password - and systemd starts
#     the installer directly on tty1.
#
# WHY PAMName=login
#     The graphical session needs a seat, and a seat comes from
#     systemd-logind, and logind only knows about sessions that were
#     registered through PAM. Without this line cage has no seat to take
#     the DRM device from, no XDG_RUNTIME_DIR to put its socket in, and
#     the medium falls all the way through to the text interface on a
#     machine whose graphics are perfectly fine.
#
#     systemd runs the account and session phases of the PAM stack, never
#     the authentication phase, so this asks nobody for a password and
#     grants nothing that ExecStart did not already have. It is what
#     turns a system service into a session on seat0.
[Unit]
Description=ZepOS installieren
Documentation=file:///usr/local/bin/zepos-live-session

After=systemd-user-sessions.service systemd-logind.service zepos-live-prepare.service
Wants=zepos-live-prepare.service

# Two programs on one virtual terminal is an unreadable screen. The getty
# is masked as well, so this is belt and braces - and the belt is what
# keeps working if somebody unmasks the getty to debug something.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
# Waits for the rest of the boot to settle before taking the screen, so
# the installer does not come up underneath the last few service
# messages. The same thing getty does, for the same reason.
Type=idle
ExecStart=/usr/local/bin/zepos-live-session

# The language the installer speaks before it has asked which language
# to speak.
#
# Measured on the first boot of this medium: the graphical surface came
# up in German - installer.gui.pages.PageState defaults to it - and the
# text surface asked "Select language" in English, because
# installer/bin/zepos-install derives that first catalogue from the
# environment and the image's /etc/locale.conf says C.UTF-8. One medium
# answering the same question in two languages depending on which
# surface started is not a choice anybody made.
#
# LC_MESSAGES and not LANG: installer.core.i18n selects a gettext
# catalogue by name and needs no locale from the C library, while
# LC_CTYPE must stay the C.UTF-8 the image ships - an unsupported
# LC_CTYPE means glibc falls back to "C" and the text interface prints
# question marks where the umlauts should be.
#
# The locale itself is generated by zepos-live-prepare, which runs
# first. Not because gettext needs it, but because GTK calls setlocale()
# and prints "Locale not supported by C library" straight onto the
# screen when it fails.
Environment=LC_MESSAGES=de_DE.UTF-8

TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-force
StandardOutput=tty
PAMName=login
WorkingDirectory=/root

# The session script loops on its own - the installer ending is not the
# medium ending. This is for the case the script itself dies, where
# coming back is strictly better than a black screen; systemd's own rate
# limit stops it turning into a flicker.
Restart=on-failure
RestartSec=2

UtmpIdentifier=tty1
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
